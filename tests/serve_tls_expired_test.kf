import kofcloud.cli.Commands
import kofcloud.cli.Deploy
import kofcloud.cli.Doctor
import kofcloud.util.Hosts
import kofcloud.util.Limits
import testkit.Support

// F9 s3 — o aviso de PEM vencido. `openssl x509 -checkend` sai 1 tanto para
// "expira em 30 dias" quanto para "ja venceu", e o serve dizia o primeiro
// nos dois casos: o operador achava que tinha um mes e servia HTTPS com
// cert morto.

test "serve-tls: veredito separa expirando de vencido (puras)", "serve-tls-expired-unit" {
    need(tlsCertVerdict(0, parseCertEndDate("Jun  1 12:00:00 2027 GMT")) == "ok", "falhou")
    need(tlsCertVerdict(1, parseCertEndDate("Jun  1 12:00:00 2027 GMT")) == "expiring", "falhou")
    need(tlsCertVerdict(1, parseCertEndDate("Jun  1 12:00:00 2020 GMT")) == "expired", "falhou")
    need(certExpiredAt(civilDaysMs(2020, 1, 1), civilDaysMs(2025, 1, 1)) == true, "falhou")
    need(certExpiredAt(civilDaysMs(2030, 1, 1), civilDaysMs(2025, 1, 1)) == false, "falhou")
    need(certExpiredAt(0L, civilDaysMs(2025, 1, 1)) == false, "falhou")
    need(tlsCertVerdict(1, 0L) == "expiring", "falhou")
    // Data do formato C do openssl -> meia-noite UTC.
    need(parseCertEndDate("Jun  1 12:00:00 2027 GMT") == civilDaysMs(2027, 6, 1), "falhou")
    need(parseCertEndDate("2027-06-01 12:00:00Z") == civilDaysMs(2027, 6, 1), "falhou")
    need(parseCertDate("Dec 31 23:59:59 1999 GMT") == civilDaysMs(1999, 12, 31), "falhou")
    need(parseCertDate("Dec 31 23:59:59 1969 GMT") == 0L, "falhou")
    need(parseCertDate("lixo") == 0L, "falhou")
    need(parseCertDate("Xyz 1 00:00:00 2027 GMT") == 0L, "falhou")
}

test "serve-tls: PEM real lido pelo openssl (formato do -enddate) e veredito", "serve-tls-expired-e2e" {
    var dir = "/tmp/kofcloud-expired-" + crypto.randomHex(4)
    Directory(dir).createDirectories()
    var key = dir + "/k.pem"
    var cert = dir + "/c.pem"
    var gen = process.run("sh", "-c", "mkdir -p " + dir + " && openssl req -x509 -newkey rsa:2048 -keyout " + key + " -out " + cert + " -days 1 -nodes -subj /CN=example.com 2>/dev/null")
    need(gen.exitCode == 0, "falhou")
    var endMs = tlsCertEndDate(cert)
    need(endMs > 0L, "falhou")
    // O cert de 1 dia esta dentro da janela de 30 dias: checkend sai 1 e o
    // veredito e "expiring" (nao "vencido") — a data real decide.
    var check = process.run("openssl", "x509", "-in", cert, "-noout", "-checkend", tlsCheckendWindowSec())
    need(tlsCertVerdict(check.exitCode, endMs) == "expiring", "falhou")
    // O proprio relogio contra a data lida: ainda nao venceu.
    need(certExpiredAt(endMs, time.now()) == false, "falhou")
    // A data lida e FUTURA e coerente com o arquivo (janela de 60 dias).
    need(endMs < time.now() + 60L * 86400000L, "falhou")
}

test "serve-tls: PEM vencido e FALHA no doctor, no domain verify e no service status", "serve-tls-expired-visible" {
    // Mesma regra do serve (acima), nos outros tres comandos que julgam um
    // PEM: "aviso" so para quem esta na janela dos 30 dias; vencido e
    // FALHA (navegador recusa o handshake).
    var past = civilDaysMs(2020, 1, 1)
    var future = civilDaysMs(2030, 1, 1)
    var san = "X509v3 Subject Alternative Name:\n    DNS:www.example.com, DNS:*.loja.example\n"
    // domain verify
    var expiredLine = domainCertLineWith("/c.pem", "www.example.com", true, 0, san, "", true, past)
    need(expiredLine.startsWith("FALHA tls"), "falhou")
    need(expiredLine.indexOf("JA VENCIDO") >= 0, "falhou")
    need(domainCertLineWith("/c.pem", "www.example.com", true, 0, san, "", true, future).startsWith("ok   tls"), "falhou")
    need(domainCertLineWith("/c.pem", "www.example.com", true, 0, san, "", false, future).indexOf("VENCIDO") < 0, "falhou")
    // doctor
    var doctorLine = doctorTlsLineWith("/c.pem", true, 0, 1, san, "", listOf("www.example.com"), past)
    need(doctorLine.startsWith("FALHA tls"), "falhou")
    need(doctorLine.indexOf("JA VENCIDO") >= 0, "falhou")
    need(doctorTlsLineWith("/c.pem", true, 0, 1, san, "", listOf("www.example.com"), future).indexOf("30 dias") >= 0, "falhou")
    need(doctorTlsLineWith("/c.pem", true, 0, 0, san, "", listOf("www.example.com"), future).startsWith("ok"), "falhou")
    // A forma antiga (sem data) preserva o comportamento para os chamadores.
    need(domainCertLine("/c.pem", "www.example.com", true, 0, san, "", true).indexOf("30 dias") >= 0, "falhou")
}
