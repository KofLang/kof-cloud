import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.model.Webhook
import kofcloud.store.Store
import kofcloud.util.Limits
import kofcloud.util.Text
import testkit.Support

// F18 s4 — push do uso para o webhook de billing: o contador de uso existia
// (noteUsage/usageFor) e o ciclo puxado (export), mas o desenho pedia um
// "webhook de uso (requests/bytes por conta) para billing externo" — o
// operador recebe a JANELA no MESMO receptor dos incidentes, assinada, sem
// gerenciar uma segunda URL/segredo. Sem webhook ou sem uso = no-op.

String usagePushPath(String name) {
    return "/tmp/kofcloud-upush-" + name + "-" + crypto.randomHex(4) + ".json"
}

test "uso-push: payload da janela e vocabulario do export (sem credencial)", "usage-push-unit" {
    // O payload carrega os mesmos contadores do GET /v1/usage + periodEnd do
    // export; event distingue o tipo para o receptor rotear.
    var p = usageWindowPayload("3", "131", "242", 1700000000000)
    need(p.indexOf("\"event\":\"usage.window\"") >= 0, "falhou")
    need(p.indexOf("\"requests\":\"3\"") >= 0, "falhou")
    need(p.indexOf("\"bytesIn\":\"131\"") >= 0, "falhou")
    need(p.indexOf("\"bytesOut\":\"242\"") >= 0, "falhou")
    need(p.indexOf("\"periodEnd\":\"1700000000000\"") >= 0, "falhou")
    need(p.indexOf("kfs_") < 0 && p.indexOf("kfc_") < 0, "falhou")
}

test "uso-push: push so com webhook e uso; janela fecha apos sucesso", "usage-push-unit" {
    var registry = Registry(usagePushPath("nop"))
    var mel = registry.createAccount("mel", "mel@e.com", "segredo")
    // Sem webhook: no-op (0), e o contador NAO zera (sem receptor, nao ha
    // a quem faturar; a janela segue acumulando).
    registry.noteUsage(mel.id, 100, 200)
    need(registry.pushUsage(mel.id) == 0, "falhou")
    need(registry.usageFor(mel.id).requests == "1", "falhou")
    // Com webhook mas sem uso: no-op (mas o webhook esta configurado).
    var ana = registry.createAccount("ana", "ana@e.com", "segredo")
    registry.setWebhook(ana.id, "http://127.0.0.1:1/nao-escuta", "segredo-de-16-chars")
    need(registry.pushUsage(ana.id) == 0, "falhou")
    // Webhook apontando para porta morta: a entrega falha (best-effort, nao
    // lanca), mas a janela FOI snapshotada — o consumidor deduplica por
    // periodEnd, entao um push repetido sem falha entrega a mesma janela uma
    // vez so (nunca re-fatura e nunca perde: o proximo push le a nova janela).
    registry.noteUsage(ana.id, 5, 6)
    need(registry.pushUsage(ana.id) == 1, "falhou")
    need(registry.usageFor(ana.id).requests == "0", "falhou")
    // Conta CONGELADA: o freeze suspende os servicos (nada novo roteia, logo
    // nada novo acumula — a recusa acontece antes do relay), mas a janela
    // pendente de ANTES do freeze continua sendo pushada: o webhook e o canal
    // do proprio operador e o freeze entrega o incidente pelo MESMO receptor
    // (cortar o push calaria o operador do proprio freeze). Conta e webhook
    // vivem no mesmo Registry — sem remocao de conta, sem orfao.
    var setErrMel = "ok"
    try {
        setErrMel = registry.setWebhook(mel.id, "http://127.0.0.1:1/nao-escuta", "segredo-de-16-chars")
    } catch (String e) {
        setErrMel = "THROW: " + e
    }
    need(setErrMel == "ok", "falhou")
    // Servico real para o freeze ter o que suspender (a recusa de rota e o
    // que impede uso NOVO; a janela pendente continua sendo pushada).
    var melDevice = registry.registerDevice(mel, "nb", "pk")
    registry.publishService(mel, melDevice.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    var froze = registry.freezeAccount(mel.id)
    need(froze.ok, "falhou")
    need(registry.pushUsageAll() > 0, "falhou")
    need(registry.usageFor(mel.id).requests == "0", "falhou")
    // Cruzamento export manual x pusher (a mesma fonte, usageSnapshot):
    // o export le-e-zera a janela; o push seguinte so leva o DELTA — nunca
    // re-fatura o que o export ja fechou, e o push nao apaga nada que o
    // export deixou (a janela vem do mesmo mapa).
    var exported = registry.usageSnapshot(mel.id)
    need(exported.requests == "0", "falhou")
    registry.noteUsage(mel.id, 10, 20)
    registry.noteUsage(mel.id, 30, 40)
    var delta = registry.usageSnapshot(mel.id)
    need(delta.requests == "2", "falhou")
    need(registry.usageFor(mel.id).requests == "0", "falhou")
}

test "uso-push: limits do passo com recuo seguro", "usage-push-unit" {
    need(usagePushMsFrom(0) == 60000, "falhou")
    need(usagePushMsFrom(-1) == 60000, "falhou")
    need(usagePushMsFrom(5000) == 5000, "falhou")
    need(limitUsagePushMs() == 60000, "falhou")
}


// Receptor real: lista simples capturada pela closure, o padrao que o resto
// da suite usa (arrays `new String[1]` capturados quebram o verificador).
String pushRecvUrl(Int port) {
    return "http://127.0.0.1:" + intToString(port) + "/billing"
}

test "uso-push: e2e — o receptor de billing recebe a janela assinada", "usage-push-e2e" {
    var recvPort = 19760
    var bodies = listOf<String>()
    var sigs = listOf<String>()
    var app = web.app()
    app.post("/billing") {
        bodies.add(body())
        var sig = header("x-kofcloud-signature")
        if (sig == null) {
            sig = "(nenhuma)"
        }
        sigs.add(sig)
        return "ok"
    }
    var server = spawn { app.listen(recvPort) }
    need(waitForPort(recvPort, 60), "falhou")

    var registry = Registry(usagePushPath("e2e"))
    var mel = registry.createAccount("mel", "mel@e.com", "segredo")
    var secret = "segredo-de-teste-123456"
    // setWebhook LANCA em erro (URL interna, DNS, segredo curto) e devolve
    // "ok" no sucesso — capturado para o teste dizer o motivo exato.
    var setErr = "ok"
    try {
        setErr = registry.setWebhook(mel.id, pushRecvUrl(recvPort), secret)
    } catch (String e) {
        setErr = "THROW: " + e
    }
    need(setErr == "ok", "falhou")
    registry.noteUsage(mel.id, 100, 200)
    registry.noteUsage(mel.id, 50, 60)
    var pushed: Int = registry.pushUsage(mel.id)
    need(pushed == 2, "falhou")
    var received: Int = bodies.size
    need(received == 1, "falhou")
    var payload: String = bodies.get(0)
    var signature: String = sigs.get(0)
    need(payload.indexOf("\"requests\":\"2\"") >= 0, "falhou")
    var expected: String = webhookSignatureHeader(secret, payload)
    need(signature == expected, "falhou")
}
