import kofcloud.cli.Commands
import kofcloud.cli.Usage
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.model.Device
import kofcloud.model.Service
import kofcloud.store.Store
import kofcloud.util.Text
import testkit.Support

// Saida --json das listagens (CI/automacao): mesma serializacao do fio, e o
// device carrega o eixo de presenca derivado do /v1/presence.

test "json: listagens puras (fio identico, presenca unica, vazio e [])", "json-unit" {
    var svc = Service("s1", "a1", "d1", "site", "127.0.0.1", 8080, "http", "site.mel.kofcloud.io", "PUBLIC", "ONLINE", 1L, "", "", "")
    var one = serviceListJsonFor(listOf(svc))
    need(one == "[" + serviceJson(svc) + "]", "falhou")
    need(serviceListJsonFor(listOf<Service>()) == "[]", "falhou")

    var dev = Device("d1", "a1", "notebook", "ACTIVE", "pk", 0L, 1L)
    var online = deviceListJsonFor(listOf(dev), "[\"d1\"]", "")
    need(online.indexOf("\"tunnel\":\"ONLINE\"") >= 0, "falhou")
    need(online.indexOf("\"id\":\"d1\"") >= 0, "falhou")
    need(online.indexOf("\"deviceId\":\"d1\"") >= 0, "falhou")
    var offline = deviceListJsonFor(listOf(dev), "[]", "")
    need(offline.indexOf("\"tunnel\":\"OFFLINE\"") >= 0, "falhou")
    var unknown = deviceListJsonFor(listOf(dev), "", "KCF004")
    need(unknown.indexOf("\"tunnel\":\"desconhecido (KCF004)\"") >= 0, "falhou")
    need(deviceListJsonFor(listOf<Device>(), "", "") == "[]", "falhou")

    // `presenceOf` e fonte unica: a linha de texto concorda com o --json.
    need(presenceOf("d1", "[\"d1\"]", "") == "ONLINE", "falhou")
    need(deviceListLine(dev, "[\"d1\"]", "").endsWith("tunel: ONLINE"), "falhou")

    // Help anuncia --json nas tres listagens.
    var help = usageText()
    need(help.indexOf("device list [--json]") >= 0, "falhou")
    need(help.indexOf("service list [--json]") >= 0, "falhou")
    need(help.indexOf("domain list [--json]") >= 0, "falhou")

    // JSON do `domain list`: mesma lista do fio que a linha de texto imprime.
    var custom = DomainEntry("loja.exemplo.com", "custom", "site", "PENDING")
    var domOut = domainListJsonFor(listOf(custom))
    need(domOut.indexOf("\"hostname\":\"loja.exemplo.com\"") >= 0, "falhou")
    need(domOut.indexOf("\"kind\":\"custom\"") >= 0, "falhou")
    need(domOut.indexOf("\"service\":\"site\"") >= 0, "falhou")
    need(domOut.indexOf("\"status\":\"PENDING\"") >= 0, "falhou")
    need(domainListJsonFor(listOf<DomainEntry>()) == "[]", "falhou")
    need(domainListLine(custom).indexOf("PENDING") >= 0, "falhou")
}

test "json: e2e — service list --json imprime lista valida", "json-e2e" {
    var port = 19986
    var registry = Registry("/tmp/kofcloud-json-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, port, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(port, 60), "falhou")
    var created = httpPostJson(port, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var dev = httpPostJson(port, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", token)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(dev)), "deviceId")
    // Conta sem servico: o fio devolve [] e o formato puro reproduz isso.
    var empty = fetchServices("http://127.0.0.1:" + intToString(port), token)
    need(empty.size == 0, "falhou")
    need(serviceListJsonFor(empty) == "[]", "falhou")
    // Publica um servico e a lista JSON vem com o mesmo corpo do fio.
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    need(statusOf(httpPostJson(port, "/v1/services", pubBody, token)) == 200, "falhou")
    var services = fetchServices("http://127.0.0.1:" + intToString(port), token)
    var out = serviceListJsonFor(services)
    need(out.startsWith("[") && out.endsWith("]"), "falhou")
    need(out.indexOf("\"name\":\"site\"") >= 0, "falhou")

    // `domain list --json`: o fio mistura wildcard + service + custom; a
    // pura serializa a mesma lista que o texto imprime, sem inventar.
    var domains = json.decode<List<DomainEntry>>(requireOk(http.get("http://127.0.0.1:" + intToString(port) + "/v1/domains", authHeader(token))))
    need(domains.size >= 2, "falhou")
    var domJson = domainListJsonFor(domains)
    need(domJson.startsWith("[") && domJson.endsWith("]"), "falhou")
    need(domJson.indexOf("\"kind\":\"service\"") >= 0, "falhou")
}
