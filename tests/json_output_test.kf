import kofcloud.cli.Commands
import kofcloud.cli.Usage
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.model.Device
import kofcloud.model.Service
import kofcloud.store.Store
import kofcloud.util.Text
import testkit.Support

// Saida --json das listagens (CI/automacao): mesma serializacao do fio, e o
// device carrega o eixo de presenca derivado do /v1/presence.

test "json: listagens puras (fio identico, presenca unica, vazio e [])", "json-unit" {
    var svc = Service("s1", "a1", "d1", "site", "127.0.0.1", 8080, "http", "site.mel.kofcloud.io", "PUBLIC", "ONLINE", 1L, "", "")
    var one = serviceListJsonFor(listOf(svc))
    assert(one == "[" + serviceJson(svc) + "]", "servico: mesma serializacao do fio: " + one)
    assert(serviceListJsonFor(listOf<Service>()) == "[]", "vazio = [] (nunca texto)")

    var dev = Device("d1", "a1", "notebook", "ACTIVE", "pk", 0L, 1L)
    var online = deviceListJsonFor(listOf(dev), "[\"d1\"]", "")
    assert(online.indexOf("\"tunnel\":\"ONLINE\"") >= 0, "presenca ONLINE do fio: " + online)
    assert(online.indexOf("\"id\":\"d1\"") >= 0, "id presente")
    assert(online.indexOf("\"deviceId\":\"d1\"") >= 0, "deviceId (conveniencia do fio)")
    var offline = deviceListJsonFor(listOf(dev), "[]", "")
    assert(offline.indexOf("\"tunnel\":\"OFFLINE\"") >= 0, "ausente do fio = OFFLINE")
    var unknown = deviceListJsonFor(listOf(dev), "", "KCF004")
    assert(unknown.indexOf("\"tunnel\":\"desconhecido (KCF004)\"") >= 0, "falha = desconhecido, nunca OFFLINE inventado")
    assert(deviceListJsonFor(listOf<Device>(), "", "") == "[]", "devices vazio = []")

    // `presenceOf` e fonte unica: a linha de texto concorda com o --json.
    assert(presenceOf("d1", "[\"d1\"]", "") == "ONLINE", "presenceOf ONLINE")
    assert(deviceListLine(dev, "[\"d1\"]", "").endsWith("tunel: ONLINE"), "linha de texto usa a mesma fonte")

    // Help anuncia --json nas duas listagens.
    var help = usageText()
    assert(help.indexOf("device list [--json]") >= 0, "help device list")
    assert(help.indexOf("service list [--json]") >= 0, "help service list")
}

test "json: e2e — service list --json imprime lista valida", "json-e2e" {
    var port = 19986
    var registry = Registry("/tmp/kofcloud-json-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, port, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(port, 60), "control no ar")
    var created = httpPostJson(port, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var dev = httpPostJson(port, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", token)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(dev)), "deviceId")
    // Conta sem servico: o fio devolve [] e o formato puro reproduz isso.
    var empty = fetchServices("http://127.0.0.1:" + intToString(port), token)
    assert(empty.size == 0, "sem servicos")
    assert(serviceListJsonFor(empty) == "[]", "e2e: sem servico = []")
    // Publica um servico e a lista JSON vem com o mesmo corpo do fio.
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    assert(statusOf(httpPostJson(port, "/v1/services", pubBody, token)) == 200, "publicado")
    var services = fetchServices("http://127.0.0.1:" + intToString(port), token)
    var out = serviceListJsonFor(services)
    assert(out.startsWith("[") && out.endsWith("]"), "array JSON: " + out)
    assert(out.indexOf("\"name\":\"site\"") >= 0, "servico no array")
}
