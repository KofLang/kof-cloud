import kofcloud.control.Registry
import kofcloud.edge.EdgeState
import kofcloud.edge.Events
import kofcloud.edge.Tunnel
import kofcloud.protocol.Session
import kofcloud.util.Limits
import testkit.Support

// Limites por dispositivo: dispositivos ativos por conta, servicos por
// dispositivo e streams simultaneos por tunel (Fase 4).

String limitTestPath(String name) {
    return "/tmp/kofcloud-limits-" + name + "-" + crypto.randomHex(4) + ".json"
}

test "registry: limite de dispositivos ativos por conta" {
    // Recuo seguro dos tetos (fontes puras `deviceLimitFrom`/
    // `serviceLimitFrom`): zero/negativo recaem no default — com o valor
    // cru, `0` congelava TODO cadastro novo (`count >= 0` sempre verdade),
    // em TODA conta, silencioso.
    need(deviceLimitFrom(0) == 5, "falhou")
    need(deviceLimitFrom(-2) == 5, "falhou")
    need(deviceLimitFrom(3) == 3, "falhou")
    need(limitDevices() == 5, "falhou")
    need(serviceLimitFrom(0) == 10, "falhou")
    need(serviceLimitFrom(-1) == 10, "falhou")
    need(serviceLimitFrom(2) == 2, "falhou")
    need(limitServices() == 10, "falhou")
    var registry = Registry(limitTestPath("devices"))
    registry.setLimits(2, 10)
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    registry.registerDevice(account, "d1", "pk1")
    registry.registerDevice(account, "d2", "pk2")
    var blocked = false
    var reason = ""
    try {
        registry.registerDevice(account, "d3", "pk3")
    } catch (String e) {
        blocked = true
        reason = e
    }
    need(blocked, "falhou")
    need(reason.indexOf("KCF080") >= 0, "falhou")
    need(registry.activeDeviceCount(account.id) == 2, "falhou")
}

test "registry: re-registrar o mesmo dispositivo e idempotente (nao consome vaga)" {
    var registry = Registry(limitTestPath("idem"))
    registry.setLimits(1, 10)
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var first = registry.registerDevice(account, "nb", "pk")
    var again = registry.registerDevice(account, "nb", "pk")
    need(first.id == again.id, "falhou")
    need(registry.activeDeviceCount(account.id) == 1, "falhou")
}

test "registry: revogar dispositivo libera vaga" {
    var registry = Registry(limitTestPath("revoke"))
    registry.setLimits(2, 10)
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var d1 = registry.registerDevice(account, "d1", "pk1")
    registry.registerDevice(account, "d2", "pk2")
    need(registry.revokeDevice(account.id, d1.id) == true, "falhou")
    var created = registry.registerDevice(account, "d3", "pk3")
    need(created.name == "d3", "falhou")
}

test "registry: limite de servicos por dispositivo" {
    var registry = Registry(limitTestPath("services"))
    registry.setLimits(10, 2)
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    registry.publishService(account, device.id, "api", "127.0.0.1", 3000, "http", "PUBLIC", "", "")
    var blocked = false
    var reason = ""
    try {
        registry.publishService(account, device.id, "files", "127.0.0.1", 9000, "http", "PUBLIC", "", "")
    } catch (String e) {
        blocked = true
        reason = e
    }
    need(blocked, "falhou")
    need(reason.indexOf("KCF081") >= 0, "falhou")
    need(registry.servicesForDevice(device.id).size == 2, "falhou")
}

test "registry: limite de servicos e por dispositivo, nao por conta" {
    var registry = Registry(limitTestPath("perdevice"))
    registry.setLimits(10, 1)
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var d1 = registry.registerDevice(account, "d1", "pk1")
    var d2 = registry.registerDevice(account, "d2", "pk2")
    registry.publishService(account, d1.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    var other = registry.publishService(account, d2.id, "api", "127.0.0.1", 3000, "http", "PUBLIC", "", "")
    need(other.name == "api", "falhou")
}

test "session: limite de streams simultaneos e libera ao fechar", "streams-limit" {
    var session = TunnelSession("s1", "d1", "a1", "")
    session.setMaxStreams(2)
    var a = session.openStream()
    var b = session.openStream()
    var c = session.openStream()
    need(a.length > 0, "falhou")
    need(b.length > 0, "falhou")
    need(c == "", "falhou")
    need(session.atCapacity(), "falhou")
    session.closeStream(a)
    need(session.atCapacity() == false, "falhou")
    need(session.openStream().length > 0, "falhou")

    // Recuo seguro do teto (fonte pura `streamLimitFrom`): zero/negativo
    // recai no default 128 — com o valor cru, `0` recusaria TODO OPEN
    // (atCapacity com 0 >= 0) e nenhum relay passaria, no Edge (429) nem
    // no Agent (RESET LIMIT_EXCEEDED).
    need(streamLimitFrom(0) == 128, "falhou")
    need(streamLimitFrom(-3) == 128, "falhou")
    need(streamLimitFrom(10) == 10, "falhou")
    need(streamLimitFrom(1) == 1, "falhou")
    need(limitStreams() == 128, "falhou")

    // O construtor da sessao delega na fonte: as 128 vagas do default abrem
    // e a seguinte recusa.
    var defaults = TunnelSession("sx", "dx", "ax", "")
    var cap = limitStreams()
    var opened = 0
    while (opened < cap) {
        if (defaults.openStream().length == 0) {
            break
        }
        opened = opened + 1
    }
    need(opened == cap, "falhou")
    need(defaults.openStream().length == 0, "falhou")
}

test "rate limit: a janela em ms vira SEGUNDOS para o stdlib", "ratelimit-unit" {
    // O bug real que esta trava protege: `security.rateLimit` recebe a janela
    // em SEGUNDOS (medido com o CLI 0.6.3: janela 1 libera em ~1 s; janela
    // 1000 segue barrada apos 1,3 s). O Edge passava `httpWindowMs` direto,
    // entao os 60 s default viravam 60.000 s de bloqueio por hostname — e
    // 101 requisicoes bastavam para causar isso.
    need(httpWindowSeconds(60000) == 60, "falhou")
    need(httpWindowSeconds(1000) == 1, "falhou")
    need(httpWindowSeconds(1500) == 2, "falhou")
    need(httpWindowSeconds(1) == 1, "falhou")
    // Zerada/negativa recai no default do Retry-After (janela <= 0 no
    // stdlib devolve false e bloquearia tudo para sempre).
    need(httpWindowSeconds(0) == limitHttpRetryAfterSec(), "falhou")
    need(httpWindowSeconds(-5) == limitHttpRetryAfterSec(), "falhou")
    // O recuo anunciado acompanha a conversao: nunca menor que a espera real.
    var state = EdgeState(Registry("/tmp/kofcloud-rlunit-" + crypto.randomHex(4) + ".json"))
    state.setHttpLimits(3, 60000)
    need(state.httpRetryAfterSec() == 61, "falhou")
    state.setHttpLimits(3, 1500)
    need(state.httpRetryAfterSec() == 3, "falhou")

    // Prova fim a fim do comportamento (nao so da conversao): cota 1 numa
    // janela de 1 s realmente libera depois de ~1 s. Sem a conversao este
    // teste ficaria barrado por ~16 minutos.
    var key = "kofcloud-rlunit-probe-" + crypto.randomHex(4)
    need(security.rateLimit(key, 1, httpWindowSeconds(1000)) == true, "falhou")
    need(security.rateLimit(key, 1, httpWindowSeconds(1000)) == false, "falhou")
    time.sleep(1200)
    need(security.rateLimit(key, 1, httpWindowSeconds(1000)) == true, "falhou")

    // Evidencia do perigo que o recuo evita: cota ZERO no stdlib recusa o
    // primeiro pedido — e todos os seguintes (a borda inteira em 429 para
    // sempre se a config de `httpRequests` fosse passada crua).
    var zeroKey = "kofcloud-rlunit-zero-" + crypto.randomHex(4)
    need(security.rateLimit(zeroKey, 0, 1) == false, "falhou")

    // Recuo seguro do teto (fonte pura `httpRequestLimitFrom`): zero/negativo
    // recaem no default 100, positivo passa.
    need(httpRequestLimitFrom(0) == 100, "falhou")
    need(httpRequestLimitFrom(-1) == 100, "falhou")
    need(httpRequestLimitFrom(10) == 10, "falhou")
    need(httpRequestLimitFrom(1) == 1, "falhou")
    need(limitHttpRequests() == 100, "falhou")

    // O construtor do EdgeState delega na fonte: o hostname de sonda esgota
    // as 100 requisicoes do default e a seguinte e barrada.
    var defaultState = EdgeState(Registry("/tmp/kofcloud-rlunit-edge-" + crypto.randomHex(4) + ".json"))
    var probeHost = "probe-" + crypto.randomHex(4) + ".example"
    var served = 0
    while (served < limitHttpRequests()) {
        if (defaultState.checkHttpLimit(probeHost) == false) {
            break
        }
        served = served + 1
    }
    need(served == limitHttpRequests(), "falhou")
    need(defaultState.checkHttpLimit(probeHost) == false, "falhou")
}

test "limits: passo da varredura periodica de credenciais com recuo seguro", "limits-expiry-sweep" {
    // Fonte unica do laco do serve (`Commands.credentialExpirySweeper`): o
    // comando passa `limitExpirySweepMs()` e o laco so dorme nesse valor.
    // Recuo em fonte pura (familia `idleSweepMsFrom`): 0/negativo recaem no
    // default porque `time.sleep(0)` giraria sem parar (busy-loop).
    need(expirySweepMsFrom(0) == 60000, "falhou")
    need(expirySweepMsFrom(-1) == 60000, "falhou")
    need(expirySweepMsFrom(250) == 250, "falhou")
    need(limitExpirySweepMs() == 60000, "falhou")
}

test "limits: passo do pusher de SERVICES com recuo seguro", "limits-push" {
    // Fonte unica do laco do Edge (`tunnelServicesPusher`): o push so dorme
    // nesse valor. Recuo em fonte pura (mesma familia do expiry-sweep):
    // 0/negativo virariam busy-loop serializando a lista de cada device a
    // cada iteracao — volta ao default 2000 ms.
    need(servicesPushMsFrom(0) == 2000, "falhou")
    need(servicesPushMsFrom(-1) == 2000, "falhou")
    need(servicesPushMsFrom(500) == 500, "falhou")
    need(limitServicesPushMs() == 2000, "falhou")
}

test "limits: os planos citam as puras de passo/prazo pelo nome", "limits-docs" {
    // Trava de honestidade docs×codigo (padrao `sendChunkBytesFrom` no
    // frames_test): as puras de passo de laco e prazo existem e estao
    // travadas aqui, mas quem afina a config precisa ENCONTRAR a fonte.
    // O 18-implemented lista a familia na linha de limites; os trechos do
    // 16-plan (pusher de SERVICES, webhook) citam a pura no contexto.
    var planRaw = File("docs/16-plan.md").readText()
    var shippedRaw = File("docs/18-implemented.md").readText()
    var plan = ""
    var shipped = ""
    if (planRaw != null) {
        plan = planRaw
    }
    if (shippedRaw != null) {
        shipped = shippedRaw
    }
    if (plan.length > 0 && shipped.length > 0) {
        need(shipped.indexOf("servicesPushMsFrom") >= 0 && shipped.indexOf("webhookTimeoutSecFrom") >= 0, "falhou")
        need(shipped.indexOf("backoffBaseLimitFrom") >= 0 && shipped.indexOf("deployWatchMsFrom") >= 0, "falhou")
        need(shipped.indexOf("usagePushMsFrom") >= 0, "falhou")
        need(plan.indexOf("servicesPushMsFrom") >= 0, "falhou")
        need(plan.indexOf("webhookTimeoutSecFrom") >= 0, "falhou")
        need(plan.indexOf("backoffBaseLimitFrom") >= 0 && plan.indexOf("backoffMaxLimitFrom") >= 0, "falhou")
        need(shipped.indexOf("tokenExpiryWarnMsFrom") >= 0, "falhou")
    }
}

test "limits: a familia de passos e prazos mora em Limits.kf", "limits-family" {
    // Trava de fonte: os PASSOS de laco e os PRAZOS tem uma casa so
    // (`util/Limits.kf`), ao lado dos tetos de capacidade. Antes o passo do
    // `deploy --watch` vivia em `cli/Deploy.kf` — a mesma familia partida em
    // dois arquivos, e uma afinacao de config podia divergir em silencio.
    var limitsRaw = File("src/kofcloud/util/Limits.kf").readText()
    var limits = ""
    if (limitsRaw != null) {
        limits = limitsRaw
    }
    need(limits.length > 0, "falhou")
    var family = listOf<String>()
    family.add("expirySweepMsFrom")
    family.add("servicesPushMsFrom")
    family.add("deployWatchMsFrom")
    family.add("refreshPollMsFrom")
    family.add("webhookTimeoutSecFrom")
    family.add("backoffBaseLimitFrom")
    family.add("backoffMaxLimitFrom")
    family.add("usagePushMsFrom")
    family.add("tokenExpiryWarnMsFrom")
    var i = 0
    while (i < family.length) {
        need(limits.indexOf("Int " + family[i] + "(") >= 0 || limits.indexOf("Long " + family[i] + "(") >= 0, "falhou")
        i = i + 1
    }
    // E o passo do watch nao pode voltar para a CLI.
    var deployRaw = File("src/kofcloud/cli/Deploy.kf").readText()
    var deploy = ""
    if (deployRaw != null) {
        deploy = deployRaw
    }
    need(deploy.indexOf("Int deployWatchMsFrom(") < 0, "falhou")
    need(deploy.indexOf("limitDeployWatchMs()") >= 0, "falhou")
}
