import kofcloud.agent.Agent
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.edge.EdgeState
import kofcloud.edge.HttpFront
import kofcloud.edge.Tunnel
import kofcloud.model.Audit
import kofcloud.model.Device
import kofcloud.store.Store
import testkit.Support
import kofcloud.util.Limits

// Abuse prevention slice 2: suspensao operacional + trilha de auditoria.
// Suspender NAO remove: o servico sai da rota (opaco, como PRIVATE) e o
// dispositivo tem o tunel recusado (DEVICE_SUSPENDED, fatal — sem reconexao
// sozinho). Health do Agent e status da API nao dessuspendem; so unsuspend
// libera. Auditoria: anel de 100 eventos, so metadados, filtrada por conta.

Bool auditHas(List<String> actions, String action) {
    for (var a in actions) {
        if (a == action) {
            return true
        }
    }
    return false
}

List<String> auditActions(List<AuditEvent> events) {
    var out = listOf<String>()
    for (var event in events) {
        out.add(event.action)
    }
    return out
}

test "suspensao: servico sai da rota e volta; health nao dessuspende", "abuse" {
    var registry = Registry("/tmp/kofcloud-abuse-" + crypto.randomHex(4) + ".json")
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var ana = registry.createAccount("ana", "a@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    need(registry.resolveRoute(service.hostname) != null, "falhou")

    need(registry.suspendService(ana.id, service.id) == false, "falhou")
    need(registry.resolveRoute(service.hostname) != null, "falhou")
    need(registry.suspendService(mel.id, "inexistente") == false, "falhou")

    need(registry.suspendService(mel.id, service.id) == true, "falhou")
    var suspended = registry.serviceById(service.id)
    need(suspended != null, "falhou")
    if (suspended != null) {
        need(suspended.status == "SUSPENDED", "falhou")
    }
    need(registry.resolveRoute(service.hostname) == null, "falhou")

    // Health do Agent NAO dessuspende.
    need(registry.setServiceStatusByName(device.id, "site", "ONLINE") == true, "falhou")
    var still = registry.serviceById(service.id)
    if (still != null) {
        need(still.status == "SUSPENDED", "falhou")
    }
    need(registry.resolveRoute(service.hostname) == null, "falhou")

    // Status via API tambem nao dessuspende.
    need(registry.reportServiceStatus(mel.id, service.id, "ONLINE") == "", "falhou")
    var still2 = registry.serviceById(service.id)
    if (still2 != null) {
        need(still2.status == "SUSPENDED", "falhou")
    }

    need(registry.unsuspendService(ana.id, service.id) == false, "falhou")
    need(registry.unsuspendService(mel.id, service.id) == true, "falhou")
    var back = registry.serviceById(service.id)
    if (back != null) {
        need(back.status != "SUSPENDED", "falhou")
    }
    need(registry.resolveRoute(service.hostname) != null, "falhou")

    // Auditoria registrou o ciclo sem segredo.
    var actions = auditActions(registry.auditForAccount(mel.id))
    need(auditHas(actions, "service.published"), "falhou")
    need(auditHas(actions, "service.suspended"), "falhou")
    need(auditHas(actions, "service.unsuspended"), "falhou")
    var anaActions = auditActions(registry.auditForAccount(ana.id))
    need(auditHas(anaActions, "service.suspended") == false, "falhou")

    // Fonte unica: o anel respeita `limitAuditEvents()` (default 100
    // travado; mutacao quebra). Recuo sem recuo silencioso: cap
    // nao-positivo recai no default em vez de desligar a trilha.
    need(limitAuditEvents() == 100, "falhou")
    need(auditEventLimitFrom(0) == 100, "falhou")
    need(auditEventLimitFrom(-2) == 100, "falhou")
    need(auditEventLimitFrom(50) == 50, "falhou")
}

test "suspensao: dispositivo recusado no tunel, nada removido", "abuse-device" {
    var registry = Registry("/tmp/kofcloud-abused-" + crypto.randomHex(4) + ".json")
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    need(registry.suspendDevice(mel.id, device.id) == true, "falhou")
    var suspended = registry.deviceById(device.id)
    need(suspended != null, "falhou")
    if (suspended != null) {
        need(suspended.status == "SUSPENDED", "falhou")
    }
    // Nada removido: servicos continuam (voltam quando liberar).
    need(registry.devicesForAccount(mel.id).size == 1, "falhou")

    need(registry.unsuspendDevice(mel.id, device.id) == true, "falhou")
    var back = registry.deviceById(device.id)
    if (back != null) {
        need(back.status == "ACTIVE", "falhou")
    }

    // Revogar apos suspender funciona (caminho de remocao intacto).
    need(registry.suspendDevice(mel.id, device.id) == true, "falhou")
    need(registry.revokeDevice(mel.id, device.id) == true, "falhou")
    var gone = registry.deviceById(device.id)
    if (gone != null) {
        need(gone.status == "REVOKED", "falhou")
    }
    // deviceIsActive/deviceIsSuspended delegam nos construtores (fonte unica
    // dos literais): ativo recem-registrado, inativo suspenso.
    var fresh = registry.registerDevice(mel, "nb2", "pk2")
    need(deviceIsActive(fresh) == true, "falhou")
    need(deviceIsSuspended(fresh) == false, "falhou")
    need(deviceIsActive(Device("x", mel.id, "y", "pk", deviceSuspended(), 0, 0)) == false, "falhou")
    need(deviceIsSuspended(Device("x", mel.id, "y", "pk", deviceSuspended(), 0, 0)) == true, "falhou")
    need(deviceIsSuspended(Device("x", mel.id, "y", "pk", deviceActive(), 0, 0)) == false, "falhou")
    need(deviceIsActive(Device("x", mel.id, "y", "pk", deviceRevoked(), 0, 0)) == false, "falhou")
    need(deviceIsSuspended(Device("x", mel.id, "y", "pk", deviceRevoked(), 0, 0)) == false, "falhou")
}

test "suspensao: Edge recusa tunel suspenso e esconde rota; audit via HTTP", "abuse-e2e" {
    var localSvc = 19581
    var controlPort = 19582
    var tunnelPort = 19583
    var httpPort = 19584

    var app = web.app()
    app.get("/") { return "svc-abuse" }
    var server = spawn { app.listen(localSvc) }
    need(waitForPort(localSvc, 60), "falhou")

    var registry = Registry("/tmp/kofcloud-abusee-" + crypto.randomHex(4) + ".json")
    var edgeState = EdgeState(registry)
    var edgeStop = "/tmp/kofcloud-abusee-edge-" + crypto.randomHex(4) + ".txt"
    var agentStop = "/tmp/kofcloud-abusee-agent-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    File(agentStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, "", edgeStop) }
    var httpTask = spawn { serveHttp(edgeState, httpPort, limitMaxBodyBytes(), edgeStop) }
    need(waitForPort(controlPort, 60), "falhou")
    need(waitForPort(tunnelPort, 60), "falhou")
    need(waitForPort(httpPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var account = json.decode<Map<String, String>>(bodyOf(created))
    var accountToken = mapField(account, "token")
    var accountId = mapField(account, "accountId")
    var anaCreated = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"ana\",\"email\":\"a@e.com\",\"password\":\"segredo\"}", "")
    var anaToken = mapField(json.decode<Map<String, String>>(bodyOf(anaCreated)), "token")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pubkey\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"" + intToString(localSvc) + "\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    var published = httpPostJson(controlPort, "/v1/services", pubBody, accountToken)
    need(statusOf(published) == 200, "falhou")
    var serviceId = mapField(json.decode<Map<String, String>>(bodyOf(published)), "id")

    // Conta alheia recebe o mesmo 404 opaco.
    var anaSuspend = httpPostJson(controlPort, "/v1/services/suspend", "{\"serviceId\":\"" + serviceId + "\"}", anaToken)
    need(statusOf(anaSuspend) == 404, "falhou")

    var config = AgentConfig("http://127.0.0.1:" + intToString(controlPort), deviceId, accountId, accountToken, "", agentStop, "127.0.0.1", tunnelPort, 100)
    var agentTask = spawn { runAgent(config, true) }
    var online = false
    var attempts = 100
    while (attempts > 0 && online == false) {
        online = edgeState.isOnline(deviceId)
        if (online == false) {
            time.sleep(50)
            attempts = attempts - 1
        }
    }
    need(online, "falhou")
    need(statusOf(httpGetRaw(httpPort, "/", "site.mel.kofcloud.io")) == 200, "falhou")

    // Suspende o servico: some da rota (404 opaco), tunel continua.
    var suspended = httpPostJson(controlPort, "/v1/services/suspend", "{\"serviceId\":\"" + serviceId + "\"}", accountToken)
    need(statusOf(suspended) == 200, "falhou")
    need(statusOf(httpGetRaw(httpPort, "/", "site.mel.kofcloud.io")) == 404, "falhou")
    need(edgeState.isOnline(deviceId), "falhou")

    // Libera o servico: a rota volta sem precisar reconectar.
    var unsuspended = httpPostJson(controlPort, "/v1/services/unsuspend", "{\"serviceId\":\"" + serviceId + "\"}", accountToken)
    need(statusOf(unsuspended) == 200, "falhou")
    need(bodyOf(httpGetRaw(httpPort, "/", "site.mel.kofcloud.io")) == "svc-abuse", "falhou")

    // Suspende o dispositivo (servico ativo): o proximo request derruba a
    // sessao (enforcement imediato no Edge) e o tunel nao volta (HELLO
    // recusado com fatal).
    var devSuspended = httpPostJson(controlPort, "/v1/devices/suspend", "{\"deviceId\":\"" + deviceId + "\"}", accountToken)
    need(statusOf(devSuspended) == 200, "falhou")
    var enforced = httpGetRaw(httpPort, "/", "site.mel.kofcloud.io")
    need(statusOf(enforced) == 503, "falhou")
    need(edgeState.isOnline(deviceId) == false, "falhou")

    var exposition = observability.metrics()
    need(metricValue(exposition, "kofcloud_control_services_suspended_total") >= 1, "falhou")
    need(metricValue(exposition, "kofcloud_control_devices_suspended_total") >= 1, "falhou")

    // Auditoria via HTTP: so os proprios eventos, sem segredo.
    var auditRaw = httpGetRaw(controlPort, "/v1/audit", "127.0.0.1")
    need(statusOf(auditRaw) == 401, "falhou")
    var anaAudit = httpPostJson(controlPort, "/v1/devices/suspend", "{\"deviceId\":\"" + deviceId + "\"}", anaToken)
    need(statusOf(anaAudit) == 404, "falhou")

    writeTextTo(agentStop, "stop")
    time.sleep(1500)
    writeTextTo(edgeStop, "stop")
    time.sleep(1000)
    File(agentStop).delete()
    File(edgeStop).delete()
}

Int metricValue(String exposition, String name) {
    for (var line in exposition.split("\n")) {
        var trimmed = line.trim()
        if (trimmed.startsWith(name + " ")) {
            return parseIntSafe(trimmed.substring(name.length + 1).trim(), -1)
        }
    }
    return -1
}

test "suspensao: REVOKED e terminal — unsuspend/suspend nao ressuscitam", "abuse-revoked-terminal" {
    // Medido: `unsuspendDevice` gravava ACTIVE incondicionalmente. Revogar e
    // a acao de contencao de uma maquina comprometida (remove servicos e
    // credenciais; o Agent trata DEVICE_REVOKED como fatal), e um `device
    // unsuspend` de rotina desfazia tudo sem re-registro nem nova chave.
    var registry = Registry("/tmp/kofcloud-abterm-" + crypto.randomHex(4) + ".json")
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    need(registry.revokeDevice(mel.id, device.id) == true, "falhou")

    var revokedBefore = registry.deviceById(device.id)
    need(revokedBefore != null, "falhou")
    if (revokedBefore != null) {
        need(deviceIsRevoked(revokedBefore.status), "falhou")
    }

    // Nenhuma transicao tira de REVOKED.
    need(registry.unsuspendDevice(mel.id, device.id) == false, "falhou")
    need(registry.suspendDevice(mel.id, device.id) == false, "falhou")
    var after = registry.deviceById(device.id)
    need(after != null, "falhou")
    if (after != null) {
        need(after.status == "REVOKED", "falhou")
    }
    // Sem auditoria falsa de unsuspend/suspend (nada aconteceu).
    var events = registry.auditForAccount(mel.id)
    var unsuspends = 0
    for (var event in events) {
        if (event.action == "device.unsuspended") {
            unsuspends = unsuspends + 1
        }
    }
    need(unsuspends == 0, "falhou")

    // A fonte unica do predicado: so o proprio literal REVOKED responde true.
    need(deviceIsRevoked("REVOKED"), "falhou")
    need(deviceIsRevoked("ACTIVE") == false, "falhou")
    need(deviceIsRevoked("SUSPENDED") == false, "falhou")
}

test "suspensao: HTTP recusa suspend/unsuspend de device revogado com 409", "abuse-revoked-http" {
    var controlPort = 19760
    var registry = Registry("/tmp/kofcloud-abterm-http-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var device = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", token)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(device)), "deviceId")
    var revoked = httpPostJson(controlPort, "/v1/devices/revoke", "{\"deviceId\":\"" + deviceId + "\"}", token)
    need(statusOf(revoked) == 200, "falhou")

    var target = "{\"deviceId\":\"" + deviceId + "\"}"
    var unsuspend = httpPostJson(controlPort, "/v1/devices/unsuspend", target, token)
    need(statusOf(unsuspend) == 409, "falhou")
    need(bodyOf(unsuspend).indexOf("KCF023") >= 0, "falhou")
    var suspend = httpPostJson(controlPort, "/v1/devices/suspend", target, token)
    need(statusOf(suspend) == 409, "falhou")
    need(bodyOf(suspend).indexOf("KCF023") >= 0, "falhou")

    // Inexistente continua 404 opaco (sem regressao).
    var ghost = httpPostJson(controlPort, "/v1/devices/unsuspend", "{\"deviceId\":\"fantasma\"}", token)
    need(statusOf(ghost) == 404, "falhou")

    var after = registry.deviceById(deviceId)
    need(after != null, "falhou")
    if (after != null) {
        need(after.status == "REVOKED", "falhou")
    }
}
