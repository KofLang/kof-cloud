
import kofcloud.cli.Commands
import kofcloud.cli.Local
import kofcloud.model.Exposure
import kofcloud.model.Service
import kofcloud.store.Store
import kofcloud.util.Hosts
import kofcloud.util.Text

test "hostname: monta e valida" {
    assert(serviceHostname("site", "mel") == "site.mel.kofcloud.io", "hostname")
    assert(accountZone("mel") == "mel.kofcloud.io", "zona")
}

test "handle: aceita apenas rotulo DNS valido" {
    assert(validHandle("mel") == true, "valido")
    assert(validHandle("ab") == false, "curto demais")
    assert(validHandle("Mel") == false, "maiuscula")
    assert(validHandle("-mel") == false, "hifen no inicio")
    assert(validHandle("mel-") == false, "hifen no fim")
    assert(validHandle("me l") == false, "espaco")
    assert(validHandle("mel_1") == false, "underscore")
}

test "host only: remove a porta e normaliza (DNS nao distingue caixa)", "host-normalize" {
    assert(hostOnly("site.mel.kofcloud.io:8080") == "site.mel.kofcloud.io", "com porta")
    assert(hostOnly("site.mel.kofcloud.io") == "site.mel.kofcloud.io", "sem porta")
    // DNS e case-insensitive (RFC 1035 §2.3.1) e o Edge compara contra o
    // hostname minusculo gerado no publish. Normalizar aqui cobre o
    // roteamento E a chave do rate limit: sem isso cada variacao de caixa
    // virava bucket proprio (101 pedidos + troca de caixa = evasao do 429).
    assert(hostOnly("Site.Mel.KofCloud.IO") == "site.mel.kofcloud.io", "caixa")
    assert(hostOnly("  API.MEL.KOFCLOUD.IO:8080  ") == "api.mel.kofcloud.io", "caixa + porta + espacos")
    // Ponto final marca FQDN absoluto — mesmo nome, cliente honesto (curl/dig).
    assert(hostOnly("site.mel.kofcloud.io.") == "site.mel.kofcloud.io", "FQDN com ponto")
    assert(hostOnly("SITE.MEL.KOFCLOUD.IO.:8080") == "site.mel.kofcloud.io", "tudo junto")
}

test "address: so loopback publica (anti-SSRF)", "hosts-loopback" {
    // Lista fechada: o Agent conecta nesse endereco a cada request —
    // qualquer outro valor o transformaria em escaneador da rede local.
    assert(validLocalAddress("127.0.0.1") == true, "loopback IPv4")
    assert(validLocalAddress("localhost") == true, "localhost")
    assert(validLocalAddress("::1") == true, "loopback IPv6")
    assert(validLocalAddress("0.0.0.0") == false, "todas as interfaces recusa")
    assert(validLocalAddress("10.0.0.5") == false, "rede privada recusa")
    assert(validLocalAddress("169.254.169.254") == false, "metadata cloud recusa")
    assert(validLocalAddress("example.com") == false, "hostname externo recusa")
    assert(validLocalAddress("") == false, "vazio recusa (default e antes)")
    assert(validLocalAddress("127.0.0.2") == false, "quase-loopback recusa")
    // defaultLocalAddress e a fonte unica do default (API, manifesto e CLI):
    // tem que estar dentro da lista fechada anti-SSRF.
    assert(validLocalAddress(defaultLocalAddress()) == true, "default e loopback valido")
}

test "host: extrai o servico do hostname da conta" {
    assert(serviceFromHost("site.mel.kofcloud.io", "mel") == "site", "servico")
    assert(serviceFromHost("api.mel.kofcloud.io", "mel") == "api", "api")
    assert(serviceFromHost("mel.kofcloud.io", "mel") == "", "sem servico")
    assert(serviceFromHost("site.outra.kofcloud.io", "mel") == "", "outra conta")
    assert(serviceFromHost("a.b.mel.kofcloud.io", "mel") == "", "dois rotulos")
}

test "exposicao: PRIVATE nao e roteavel" {
    assert(exposureIsRoutable(Exposure.PUBLIC) == true, "public")
    assert(exposureIsRoutable(Exposure.AUTHENTICATED) == true, "authenticated")
    assert(exposureIsRoutable(Exposure.PRIVATE) == false, "private")
    assert(exposureName(exposureFrom("PRIVATE")) == "PRIVATE", "round trip")
    assert(exposureName(exposureFrom("qualquer")) == "PUBLIC", "default public")
    // exposureRequiresAuth recebe a string do modelo (Service.exposure
    // viaja como string) — fonte unica do literal AUTHENTICATED para os
    // pontos que so tem a string (HttpFront: gate 401 + dropCredential).
    assert(exposureRequiresAuth("AUTHENTICATED") == true, "autenticado exige")
    assert(exposureRequiresAuth("PUBLIC") == false, "publico nao exige")
    assert(exposureRequiresAuth("PRIVATE") == false, "privado nao exige")
    // exposureIsKnown e a fonte unica do vocabulario para os 3 pontos que
    // validam entrada crua (API, manifesto, CLI): delegam no predicado em
    // vez de repetir os 3 literais (um typo num deles passaria nos outros).
    assert(exposureIsKnown("PUBLIC") == true, "public conhecido")
    assert(exposureIsKnown("AUTHENTICATED") == true, "autenticado conhecido")
    assert(exposureIsKnown("PRIVATE") == true, "privado conhecido")
    assert(exposureIsKnown("PUBLIK") == false, "typo recusado")
    assert(exposureIsKnown("") == false, "vazio recusado")
    // protocolIsSupported e a fonte unica do protocolo do tunel (so http):
    // API e manifesto delegam (KCF046) em vez de repetir o literal.
    assert(protocolIsSupported("http") == true, "http suportado")
    assert(protocolIsSupported("tcp") == false, "tcp recusado")
    assert(protocolIsSupported("HTTP") == false, "maiusculo recusado")
    assert(protocolIsSupported("") == false, "vazio recusado")
    // Defaults single-source: os 3 pontos (API, manifesto, CLI) defaultam
    // pelo construtor; os asserts travam o valor e a consistencia interna
    // (default sempre passa na propria validacao).
    assert(defaultExposure() == "PUBLIC", "default exposure")
    assert(exposureIsKnown(defaultExposure()) == true, "default exposure valido")
    assert(defaultProtocol() == "http", "default protocol")
    assert(protocolIsSupported(defaultProtocol()) == true, "default protocol valido")
}

test "status: OFFLINE nao roteia, ONLINE e UNKNOWN roteiam", "status-routable" {
    assert(statusIsRoutable("ONLINE") == true, "online")
    assert(statusIsRoutable("UNKNOWN") == true, "unknown ainda tenta")
    assert(statusIsRoutable("DEGRADED") == true, "degraded")
    assert(statusIsRoutable("OFFLINE") == false, "offline")
    // Os predicados delegam nos construtores (fonte unica do literal):
    // statusDegraded() tinha zero chamadores antes disso.
    assert(statusIsRoutable(statusDegraded()) == true, "helper degradado roteia")
    assert(statusIsRoutable(statusOnline()) == true, "helper online roteia")
    assert(statusIsSuspended(statusSuspended()) == true, "helper suspenso casa")
}

test "text: parseIntSafe aceita digito e recusa lixo" {
    assert(parseIntSafe("8080", 0) == 8080, "numero")
    assert(parseIntSafe("", 7) == 7, "vazio usa default")
    assert(parseIntSafe("80a", 7) == 7, "lixo usa default")
    assert(parseIntSafe("-5", 0) == -5, "negativo")
    // parsePortSafe/parseIntBounded sao as unicas portas/contagens de entrada
    // (auditoria de wrap, Fase 14 slice 2q/2r/2s + 2t): parseIntSafe em texto
    // de usuario/CLI/API/rede e wrap — se voce esta adicionando um, pare:
    // use o parser com teto. (Contadores internos sao outra familia: ve
    // Session.pending/EdgeState.serviceConns, escritos pelo proprio codigo.)
    assert(parsePortSafe("4294968080", 0) == 0, "porta com wrap nao vira 784")
    assert(parsePortSafe("4294967296", 0) == 0, "porta 2^32 nao vira 0")
    assert(parseIntBounded("4294967396", -1, 2147483647) == -1, "contagem com wrap falha")
    assert(parseIntBounded("4294967396", -1, 100) == -1, "teto pequeno falha primeiro")
    assert(parseIntBounded("100", -1, 2147483647) == 100, "normal passa")
}

test "text: bodyContainsId casa id exato entre aspas" {
    var body = "[\"abc-123\",\"def-456\"]"
    assert(bodyContainsId(body, "abc-123") == true, "id presente")
    assert(bodyContainsId(body, "abc-12") == false, "prefixo nao casa")
    assert(bodyContainsId(body, "zzz") == false, "ausente")
    assert(bodyContainsId(body, "") == false, "vazio nunca casa")
    assert(bodyContainsId("[]", "abc-123") == false, "lista vazia")
}

test "text: bearerValue extrai o token do Authorization" {
    // Fonte unica do parsing (control plane + Edge delegam): Bearer com
    // qualquer caixa, valor cru sem esquema, vazio e padding.
    assert(bearerValue("Bearer abc123") == "abc123", "bearer minusculo")
    assert(bearerValue("BEARER abc123") == "abc123", "bearer maiusculo")
    assert(bearerValue("bearer abc123") == "abc123", "bearer exato")
    assert(bearerValue("abc123") == "abc123", "cru passa direto")
    assert(bearerValue("") == "", "vazio vira vazio")
    assert(bearerValue("Bearer   abc123  ") == "abc123", "padding aparado")
    assert(bearerValue("Bearer ") == "", "so esquema vira vazio")
}

test "text: identificadores U da matriz sao unicos", "u-matrix" {
    // Trava do docs/15-tests.md: cada numero U identifica exatamente uma
    // linha da matriz (e o indice que liga cobertura a fase). Precedente:
    // a linha do framing nasceu U51 igual a do login-error e so um olho
    // humano pegou — duplicado quebra a invariante em silencio. Precedentes
    // de trava em doc versionado: security-policy e postmortem-template.
    // Caminho relativo ao repo: o runner usa a raiz como cwd.
    var matrix = readTextOr("docs/15-tests.md", "")
    assert(matrix.length > 0, "matriz existe e nao e vazia")
    // Cada "| Unn |" conta uma linha; U com 3 digitos nao aparece hoje, e
    // "| U1 |" nao casa "| U10 |" porque exige os espacos dos dois lados.
    var i = 1
    while (i <= 99) {
        var marker = "| U" + intToString(i) + " |"
        var first = matrix.indexOf(marker, 0)
        if (first >= 0) {
            assert(matrix.indexOf(marker, first + 1) < 0, "U" + intToString(i) + " duplicado na matriz")
        }
        i = i + 1
    }
    assert(matrix.indexOf("| U54 |") >= 0, "U54 (framing) presente")
    assert(matrix.indexOf("| U51 |") >= 0, "U51 (login-error) presente")
}

test "text: tailLines devolve as ultimas linhas", "logs-tail" {
    var log = "l1\nl2\nl3\n"
    assert(tailLines(log, 2) == "l2\nl3\n", "duas ultimas")
    assert(tailLines(log, 5) == log, "mais que o total devolve tudo")
    assert(tailLines(log, 0) == log, "zero devolve tudo")
    assert(tailLines(log, -1) == log, "negativo devolve tudo")
    assert(tailLines("so-uma\n", 1) == "so-uma\n", "linha unica")
    assert(tailLines("", 3) == "", "vazio devolve vazio")
    // Sem trailing newline: a parcial conta como linha.
    assert(tailLines("a\nb", 1) == "b\n", "parcial conta")
    // `--tail` lia com parseIntSafe (32 bits): 4294967396 virava 100 e era
    // aceito em silencio — o usuario pedia bilhoes e recebia cem linhas.
    assert(parseIntBounded("100", -1, 2147483647) == 100, "tail normal")
    assert(parseIntBounded(" 100 ", -1, 2147483647) == 100, "tail com espacos")
    assert(parseIntBounded("4294967396", -1, 2147483647) == -1, "acima de 2^32 nao vira 100")
    assert(parseIntBounded("4294967296", -1, 2147483647) == -1, "2^32 nao vira 0")
    assert(parseIntBounded("2147483648", -1, 2147483647) == -1, "acima do teto de Int")
    assert(parseIntBounded("2147483647", -1, 2147483647) == 2147483647, "teto cabe")
    assert(parseIntBounded("0", -1, 2147483647) == -1 && parseIntBounded("-3", -1, 2147483647) == -1, "zero e negativo")
    assert(parseIntBounded("12x", -1, 2147483647) == -1 && parseIntBounded("", -1, 2147483647) == -1, "lixo e vazio")
}

test "text: trimLogHead corta o inicio em linhas inteiras", "logs-cap" {
    var log = "l1-antiga\nl2\nl3-recente\n"
    // Teto folgado: nada muda.
    assert(trimLogHead(log, 1000) == log, "dentro do teto intacto")
    // Teto zero/desligado: nada muda.
    assert(trimLogHead(log, 0) == log, "teto zero desliga")
    // Teto curto: corta l1, mantem o fim em linhas inteiras.
    var trimmed = trimLogHead(log, 12)
    assert(trimmed.indexOf("l1-antiga") < 0, "inicio velho sai")
    assert(trimmed.indexOf("l3-recente") >= 0, "recente fica")
    assert(trimmed.endsWith("\n"), "termina em linha inteira")
    assert(trimmed.length <= 12 + "l2\n".length, "perde no maximo uma linha parcial")
    // Sem newline no trecho util: devolve o fim cru.
    var flat = trimLogHead("abcdefghij", 4)
    assert(flat == "ghij", "sem newline corta cru")
}

test "text: tokenInventoryLine resume credenciais sem vazar valor", "token-status" {
    // Pura, sem rede nem HOME (precedente: doctorTunnelLine): o status
    // chama com o que a API ja devolve (id curto + expiracao opcional).
    var empty = listOf<ServiceTokenEntry>()
    assert(tokenInventoryLine(empty) == "", "sem credenciais, sem linha")
    var plain = listOf<ServiceTokenEntry>()
    plain.add(ServiceTokenEntry("svc", "a1b2c3d4", "1700000000000", null))
    var one = tokenInventoryLine(plain)
    assert(one.indexOf("1 emitida(s)") >= 0, "conta uma")
    assert(one.indexOf("a1b2c3d4") < 0, "nao vaza nem o id curto")
    assert(one.indexOf("expiracao") < 0, "sem TTL, sem aviso")
    var mixed = listOf<ServiceTokenEntry>()
    mixed.add(ServiceTokenEntry("svc", "a1b2c3d4", "1700000000000", null))
    mixed.add(ServiceTokenEntry("svc", "e5f6a7b8", "1700000000000", "1730000000000"))
    var two = tokenInventoryLine(mixed)
    assert(two.indexOf("2 emitida(s)") >= 0, "conta duas")
    assert(two.indexOf("1 com expiracao") >= 0, "aponta que ha prazo")
    assert(two.indexOf("token-list") >= 0, "orienta o proximo passo")
}

test "text: validatePublishLocal barra exposure/address ruins sem rede", "publish-local" {
    // Pura, sem rede nem HOME (precedente: doctorTunnelLine): o cmdPublish
    // chama antes de qualquer fetch; aqui cobrimos a decisao direto.
    assert(validatePublishLocal("site", 8080, "PUBLIC", "127.0.0.1") == "", "caso valido passa")
    assert(validatePublishLocal("site", 8080, "PRIVATE", "localhost") == "", "localhost passa")
    assert(validatePublishLocal("", 8080, "PUBLIC", "127.0.0.1").indexOf("uso:") >= 0, "sem nome pede uso")
    assert(validatePublishLocal("site", 0, "PUBLIC", "127.0.0.1").indexOf("uso:") >= 0, "sem porta pede uso")
    assert(validatePublishLocal("site", 99999, "PUBLIC", "127.0.0.1").indexOf("1-65535") >= 0, "teto de porta no CLI")
    assert(validatePublishLocal("site", 8080, "PUBLIK", "127.0.0.1").indexOf("exposure invalida") >= 0, "typo nao vira PUBLIC")
    assert(validatePublishLocal("site", 8080, "PUBLIC", "10.0.0.5").indexOf("address invalido") >= 0, "externo barra (SSRF)")
    assert(validatePublishLocal("site", 8080, "PUBLIC", "169.254.169.254").indexOf("127.0.0.1") >= 0, "metadata barra com dica")
    // Trim como o parseManifest: padding passa aparado; so-espacos falha
    // como ausente no nome (fail-fast local). Exposure/address so-espacos
    // falham NO VALIDADOR PURO (ele nao defaulta — o default vive no
    // chamador); no fluxo real o cmdPublish apara + defaulta antes
    // (igual ao parse do manifesto), entao esse caminho nao dispara.
    assert(validatePublishLocal("  site  ", 8080, " PUBLIC ", " localhost ") == "", "padding passa aparado")
    assert(validatePublishLocal("   ", 8080, "PUBLIC", "127.0.0.1").indexOf("uso:") >= 0, "nome so-espacos pede uso")
    assert(validatePublishLocal("site", 8080, "   ", "127.0.0.1").indexOf("exposure invalida") >= 0, "exposure so-espacos falha no puro")
    assert(validatePublishLocal("site", 8080, "PUBLIC", "   ").indexOf("address invalido") >= 0, "address so-espacos falha no puro")
}

test "text: validTtlHours aceita vazio e positivos", "ttl-local" {
    // Pura, sem rede nem HOME: o cmdServiceToken chama antes de buscar
    // servicos (fail-fast local, mesma regra do KCF062 na API). Trim como o
    // parseManifest: padding passa aparado; so-espacos = ausente (sem TTL).
    assert(validTtlHours("") == true, "ausente = sem expiracao")
    assert(validTtlHours("24") == true, "horas ok")
    assert(validTtlHours("1") == true, "minimo ok")
    assert(validTtlHours("  24  ") == true, "padding passa aparado")
    assert(validTtlHours("   ") == true, "so-espacos = sem expiracao")
    assert(validTtlHours("0") == false, "zero recusa")
    assert(validTtlHours("  0  ") == false, "zero com padding recusa")
    assert(validTtlHours("-5") == false, "negativo recusa")
    assert(validTtlHours("lixo") == false, "texto recusa")
    assert(validTtlHours("  lixo  ") == false, "texto com padding recusa")
    // 4294967396 virava 100 horas com parseIntSafe (wrap de 32 bits).
    assert(validTtlHours("4294967396") == false, "ttl acima de 2^32 recusa")
    assert(validTtlHours("4294967296") == false, "ttl 2^32 nao vira 0")
}

test "text: validateServePorts barra porta fora da faixa", "serve-ports" {
    // Pura, sem rede nem HOME: o cmdServe chama antes de abrir qualquer
    // listener (fail-fast, sem bind parcial). Os defaults vêm da fonte
    // unica (Hosts): mudar la muda aqui sem caçar literal.
    assert(defaultControlPort() == 8080, "control default travado")
    assert(defaultTunnelPort() == 7000, "tunel default travado")
    assert(defaultHttpPort() == 8081, "http default travado")
    assert(validateServePorts(defaultControlPort(), defaultTunnelPort(), defaultHttpPort()) == "", "defaults passam")
    assert(validateServePorts(1, 1, 1).length == 0, "minimo passa")
    assert(validateServePorts(65535, 65535, 65535).length == 0, "maximo passa")
    assert(validateServePorts(0, defaultTunnelPort(), defaultHttpPort()).indexOf("control-port") >= 0, "zero barra no control")
    assert(validateServePorts(defaultControlPort(), 70000, defaultHttpPort()).indexOf("tunnel-port") >= 0, "teto barra no tunel")
    assert(validateServePorts(defaultControlPort(), defaultTunnelPort(), -1).indexOf("http-port") >= 0, "negativa barra no http")
    assert(defaultControlUrl() == "http://127.0.0.1:" + intToString(defaultControlPort()), "controlUrl usa o default")
    // Porta lida sem estouro de Int: 4294968080 fazia wrap para 784 e era
    // aceita em silencio; 4294967296 virava 0.
    assert(parsePortSafe("8080", 0) == 8080, "porta normal")
    assert(parsePortSafe(" 8080 ", 0) == 8080, "espacos")
    assert(parsePortSafe("1", 0) == 1 && parsePortSafe("65535", 0) == 65535, "faixa")
    assert(parsePortSafe("4294968080", -1) == -1, "acima de 2^32 nao faz wrap")
    assert(parsePortSafe("4294967296", -1) == -1, "2^32 exato nao vira 0")
    assert(parsePortSafe("65536", -1) == -1, "acima do teto")
    assert(parsePortSafe("0", -1) == -1 && parsePortSafe("-1", -1) == -1, "zero e negativo")
    assert(parsePortSafe("8080x", -1) == -1 && parsePortSafe("", -1) == -1, "lixo e vazio")
    // Flag do serve: ausente usa o default; presente e invalida vira -1 e a
    // validacao recusa (nunca cai no default em silencio).
    assert(portFlagValue("", defaultControlPort()) == defaultControlPort(), "ausente = default")
    assert(portFlagValue("   ", defaultControlPort()) == defaultControlPort(), "so espacos = default")
    assert(portFlagValue("4294968080", defaultControlPort()) == -1, "flag estourada = -1")
    assert(validateServePorts(portFlagValue("4294968080", defaultControlPort()), defaultTunnelPort(), defaultHttpPort()).indexOf("control-port") >= 0, "flag estourada barra")
}

test "text: flag sem valor nao vira default silencioso", "flag-missing" {
    // Pura, sem rede nem HOME: `flagValue` sozinho nao distingue "ausente"
    // de "presente sem valor" — flagMissingValue fecha o buraco para as
    // flags cujo default mentiria sobre a intencao (ex.: --ttl solto
    // viraria "sem expiracao").
    assert(flagMissingValue(listOf<String>(), "--ttl") == false, "ausente nao e erro")
    assert(flagMissingValue(listOf("--ttl"), "--ttl") == true, "flag sozinha no fim")
    assert(flagMissingValue(listOf("--ttl", "--check"), "--ttl") == true, "flag seguida de flag")
    assert(flagMissingValue(listOf("--ttl", "24"), "--ttl") == false, "flag com valor ok")
    assert(flagMissingValue(listOf("site", "--port"), "--port") == true, "port sem valor")
    assert(flagMissingValue(listOf("--port", "8080"), "--other") == false, "outra flag nao casa")
    assert(flagMissingValue(listOf("api.example.com", "--service"), "--service") == true, "service solto barra")
    assert(flagMissingValue(listOf("--tail"), "--tail") == true, "tail solto barra")
}

test "text: flagDuplicated barra repeticao silenciosa", "flag-dup" {
    // Pura, sem rede nem HOME: `flagValue` leria a primeira ocorrencia e
    // ignoraria a segunda — ambiguidade que vira surpresa (o operador acha
    // que vale a ultima). Fail-fast antes de qualquer efeito.
    assert(flagDuplicated(listOf<String>(), "--port") == false, "ausente ok")
    assert(flagDuplicated(listOf("--port", "8080"), "--port") == false, "unica ok")
    assert(flagDuplicated(listOf("--port", "80", "--port", "8080"), "--port") == true, "duplicada barra")
    assert(flagDuplicated(listOf("--port", "80", "--port"), "--port") == true, "duplicada sem valor tambem")
    assert(flagDuplicated(listOf("--port", "8080"), "--ttl") == false, "outra flag nao casa")
    assert(flagDuplicated(listOf("--ttl", "24", "--ttl", "48"), "--ttl") == true, "ttl duplicado barra")
    assert(flagDuplicated(listOf("--tail", "10", "--tail", "20"), "--tail") == true, "tail duplicado barra")
    assert(flagDuplicated(listOf("--service", "a", "--service", "b"), "--service") == true, "service duplicado barra")
}

test "text: extraPositional barra posicional sobrando", "extra-positional" {
    // Pura, sem rede nem HOME: first/secondPositional leriam os N primeiros
    // em silencio e o resto sumiria — typo que vira acao errada sem aviso.
    // Valores de flag nao contam como posicionais (lista fechada em
    // extraPositional, igual as flags que flagValue entende).
    assert(extraPositional(listOf<String>(), 1) == false, "vazio ok")
    assert(extraPositional(listOf("site"), 1) == false, "exato ok")
    assert(extraPositional(listOf("site", "lixo"), 1) == true, "segundo posicional barra")
    assert(extraPositional(listOf("site", "--port", "8080"), 1) == false, "valor de flag nao conta")
    assert(extraPositional(listOf("site", "--port", "8080", "lixo"), 1) == true, "extra apos flag barra")
    assert(extraPositional(listOf("site", "kfs_x", "lixo"), 2) == true, "terceiro posicional barra")
    assert(extraPositional(listOf("site", "kfs_x"), 2) == false, "dois exatos ok")
    assert(extraPositional(listOf("site", "--ttl", "24"), 1) == false, "ttl com valor nao conta")
}

test "text: comandos sem posicional rejeitam sobra", "extra-zero" {
    // logout/connect/disconnect/status/doctor/deploy/down nao tem
    // posicionais: qualquer token solto e erro, nao no-op silencioso.
    assert(extraPositional(listOf("qualquer"), 0) == true, "um solto barra")
    assert(extraPositional(listOf<String>(), 0) == false, "vazio ok")
    assert(extraPositional(listOf("--file", "k.json"), 0) == false, "so flag com valor ok")
    assert(extraPositional(listOf("x", "--file", "k.json"), 0) == true, "posicional com flag barra")
}

test "text: domainListLine mostra status so do custom", "domain-list-line" {
    // Pura, sem rede (precedente: tokenInventoryLine): wildcard/service nao
    // tem ciclo PENDING/VERIFIED; custom mostra para o operador saber se
    // falta o DNS.
    assert(domainListLine(DomainEntry("mel.kofcloud.io", "wildcard", "", "")) == "wildcard  mel.kofcloud.io", "wildcard sem status")
    assert(domainListLine(DomainEntry("site.mel.kofcloud.io", "service", "site", "")) == "service  site.mel.kofcloud.io", "service sem status")
    assert(domainListLine(DomainEntry("api.example.com", "custom", "site", "PENDING")) == "custom  api.example.com  PENDING", "custom PENDING")
    assert(domainListLine(DomainEntry("api.example.com", "custom", "site", "VERIFIED")) == "custom  api.example.com  VERIFIED", "custom VERIFIED")
}

test "text: customDomainsFor filtra customs do servico", "custom-domains-for" {    // Pura, sem rede (precedente: domainListLine): o `service status`
    // lista so os customs vinculados aquele servico — wildcard/service e
    // customs de outro nome ficam de fora.
    var domains = listOf<DomainEntry>()
    domains.add(DomainEntry("mel.kofcloud.io", "wildcard", "", ""))
    domains.add(DomainEntry("site.mel.kofcloud.io", "service", "site", ""))
    domains.add(DomainEntry("api.example.com", "custom", "site", "PENDING"))
    domains.add(DomainEntry("loja.example.com", "custom", "loja", "VERIFIED"))
    var only = customDomainsFor(domains, "site")
    assert(only.size == 1, "so o custom do servico")
    assert(only.get(0).hostname == "api.example.com", "o custom certo")
    assert(domainListLine(only.get(0)).indexOf("PENDING") >= 0, "linha reutiliza domainListLine")
    assert(customDomainsFor(domains, "loja").size == 1, "outro servico ve o seu")
    assert(customDomainsFor(domains, "novo").size == 0, "sem custom: vazio")
    assert(customDomainsFor(listOf<DomainEntry>(), "site").size == 0, "lista vazia: vazio")
}

test "text: notFoundLine trava mensagens da CLI", "not-found-line" {
    // Puras, sem rede (precedente: domainListLine): fonte unica das 11
    // mensagens "nao encontrado" (7 servico + 4 dispositivo) — se o texto
    // mudar, muda num lugar so e este teste acusa.
    assert(serviceNotFoundLine("site") == "servico nao encontrado: site", "servico exato")
    assert(deviceNotFoundLine("dev1") == "dispositivo nao encontrado: dev1", "dispositivo exato")
    // Guarda de sessao: ~20 pontos bare + 9 com dica convergem na forma com
    // dica — o operador sem sessao recebe a mesma orientacao em todo comando.
    assert(notLoggedInLine() == "nao logado — rode: kof cloud login <handle> --password <senha>", "forma com dica")
    assert(notLoggedInLine().indexOf("kof cloud login") >= 0, "dica acionavel")
    // Linhas de uso duplicadas em dois guardas do mesmo comando (fonte
    // unica): cada helper abaixo cobre 2 call sites (flag + args).
    assert(usoServiceTokenLine() == "uso: kof cloud service token <nome> [--ttl <horas>]", "uso token")
    assert(usoServeLine().indexOf("kof cloud serve") >= 0, "uso serve")
    assert(usoLogsLine() == "uso: kof cloud logs [--tail <linhas>]", "uso logs")
    assert(usoDomainAddLine() == "uso: kof cloud domain add <hostname> --service <nome>", "uso domain add")
}

test "text: matchServiceName apara antes de comparar", "service-name-match" {
    // Pura, sem rede nem HOME (precedente: customDomainsFor): unpublish/
    // status/token/token-revoke resolvem por ela; padding resolve, so-espacos
    // nao casa com nada (o chamador barra vazio como uso antes).
    var services = listOf<Service>()
    services.add(Service("id1", "acc", "dev", "site", "127.0.0.1", 8080, "http", "site.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 1000, "", ""))
    services.add(Service("id2", "acc", "dev", "loja", "127.0.0.1", 3000, "http", "loja.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 1000, "", ""))
    assert(matchServiceName(services, "site") == "id1", "exato resolve")
    assert(matchServiceName(services, "  site  ") == "id1", "padding resolve")
    assert(matchServiceName(services, "loja") == "id2", "segundo resolve")
    assert(matchServiceName(services, "   ") == "", "so-espacos nao casa")
    assert(matchServiceName(services, "outro") == "", "inexistente vazio")
    assert(matchServiceName(listOf<Service>(), "site") == "", "lista vazia: vazio")
}

test "text: resolveLoginInputs apara sem tocar na senha", "login-trim" {
    // Pura, sem rede nem HOME (precedente: matchServiceName): o cmdLogin
    // delega antes dos defaults/guardas; handle/--control/--device com
    // padding entram limpos, --device so-espacos vira vazio (o chamador
    // cai no default "default"), e a senha passa intacta (credencial).
    var padded = resolveLoginInputs("  mel  ", "  http://127.0.0.1:8080  ", "  notebook  ")
    assert(padded.handle == "mel", "handle aparado")
    assert(padded.control == "http://127.0.0.1:8080", "control aparado")
    assert(padded.device == "notebook", "device aparado")
    var blank = resolveLoginInputs("mel", "http://127.0.0.1:8080", "   ")
    assert(blank.device == "", "device so-espacos vira vazio (default no chamador)")
    var clean = resolveLoginInputs("mel", "http://127.0.0.1:8080", "notebook")
    assert(clean.handle == "mel", "limpo passa direto")
    assert(clean.control == "http://127.0.0.1:8080", "control limpo passa direto")
    assert(clean.device == "notebook", "device limpo passa direto")
}

test "text: resolveWafMode so aceita detectar|enforce", "serve-waf" {
    // Pura, sem rede nem HOME (precedente: resolveStatePath): --waf
    // ausente/vazio/so-espacos = detectar; padding apara; lixo vira "?"
    // (o cmdServe barra com uso, sem default mentiroso). O fio ate o
    // EdgeState (setWafEnforce) e o e2e `waf-flag` provam o efeito.
    assert(resolveWafMode("") == "detectar", "ausente cai no detectar")
    assert(resolveWafMode("   ") == "detectar", "so-espacos cai no detectar")
    assert(resolveWafMode("  enforce  ") == "enforce", "padding apara")
    assert(resolveWafMode("detectar") == "detectar", "detectar passa")
    assert(resolveWafMode("enforce") == "enforce", "enforce passa")
    assert(resolveWafMode("ENFORCE") == "?", "caixa importa (fail-closed no parse)")
    assert(resolveWafMode("block") == "?", "lixo vira interrogação")
    // Guardas do cmdServe (precedente: serve-state): --waf solto ou
    // repetido barra antes de qualquer listener, igual as portas.
    assert(flagMissingValue(listOf("--waf"), "--waf") == true, "waf solto barra")
    assert(flagMissingValue(listOf("--waf", "--state"), "--waf") == true, "waf seguido de flag barra")
    assert(flagMissingValue(listOf("--waf", "enforce"), "--waf") == false, "waf com valor ok")
    assert(flagDuplicated(listOf("--waf", "a", "--waf", "b"), "--waf") == true, "waf repetido barra")
}

test "text: resolveTlsPair exige o par cert+key", "serve-tls" {
    // Pura, sem rede nem HOME (precedente: resolveWafMode): ausente = ""
    // (HTTP, comportamento atual); metade sozinha = erro (nao default
    // silencioso); padding apara; o par volta colado por "\n".
    assert(resolveTlsPair("", "") == "", "ausente = sem TLS")
    assert(resolveTlsPair("   ", "") == "", "so-espacos = sem TLS")
    assert(resolveTlsPair("/c.pem", "") == "tls exige --tls-cert e --tls-key juntos (par ausente)", "key sozinha barra")
    assert(resolveTlsPair("", "/k.pem") == "tls exige --tls-cert e --tls-key juntos (par ausente)", "cert sozinho barra")
    assert(resolveTlsPair("  /c.pem  ", "  /k.pem  ") == "/c.pem\n/k.pem", "par apara e cola")
    assert(controlScheme("") == "http", "sem TLS anuncia http")
    assert(controlScheme("/c.pem\n/k.pem") == "https", "com TLS anuncia https")
    // Guardas do cmdServe (precedente: serve-state): --tls-cert/--tls-key
    // soltas ou repetidas barram antes de qualquer listener.
    assert(flagMissingValue(listOf("--tls-cert"), "--tls-cert") == true, "cert solto barra")
    assert(flagMissingValue(listOf("--tls-cert", "c.pem"), "--tls-cert") == false, "cert com valor ok")
    assert(flagMissingValue(listOf("--tls-key"), "--tls-key") == true, "key solta barra")
    assert(flagDuplicated(listOf("--tls-key", "a", "--tls-key", "b"), "--tls-key") == true, "key repetida barra")
    // Aviso de expiracao (Fase 9 slice 3 parcial): pura sobre o exitCode
    // do `openssl x509 -checkend` (0 = valido alem do prazo). Decisao
    // separada do IO para testar sem openssl e sem disco.
    assert(tlsCertExpiringSoon(0) == false, "valido alem do prazo: sem aviso")
    assert(tlsCertExpiringSoon(1) == true, "expira dentro: avisa")
    // Janela do `-checkend` em fonte unica (30 dias = 2592000 s): os 5 pontos
    // que consultam o openssl (serve, domain status/verify, scan, doctor) e os
    // testes que geram PEM real passam por aqui — mudar o prazo muda todos
    // juntos. Valor travado + mutacao quebra.
    assert(tlsCheckendWindowSec() == "2592000", "janela de 30 dias travada")
    assert(parseIntSafe(tlsCheckendWindowSec(), 0) == 30 * 24 * 60 * 60, "30 dias em segundos")
}

test "text: resolveStatePath apara e cai no default", "serve-state" {
    // Pura (precedente: resolveLoginInputs): --state ausente/vazio/
    // so-espacos = default; padding apara; caminho limpo passa direto.
    var def = kofcloudHome() + "/control-state.json"
    assert(resolveStatePath("") == def, "ausente cai no default")
    assert(resolveStatePath("   ") == def, "so-espacos cai no default")
    assert(resolveStatePath("  /tmp/estado.json  ") == "/tmp/estado.json", "padding apara")
    assert(resolveStatePath("/tmp/estado.json") == "/tmp/estado.json", "limpo passa direto")
    // Guardas do cmdServe (precedente: flag-missing/flag-dup): --state
    // solto ou repetido barra antes de qualquer listener, igual as portas.
    assert(flagMissingValue(listOf("--state"), "--state") == true, "state solto barra")
    assert(flagMissingValue(listOf("--state", "--control-port"), "--state") == true, "state seguido de flag barra")
    assert(flagMissingValue(listOf("--state", "/tmp/x.json"), "--state") == false, "state com valor ok")
    assert(flagDuplicated(listOf("--state", "a", "--state", "b"), "--state") == true, "state repetido barra")
    assert(flagDuplicated(listOf("--state", "a"), "--state") == false, "state unico ok")
}

test "text: sbom cobre os 48 fontes com hash verificavel", "audit-sbom" {
    // Puras (precedente: serve-tls): lista curada em fonte unica (trava
    // quebra se adicionarem modulo — mesmo padrao do errors-hint-all),
    // linha no formato sha256sum, UNREADABLE honesto em vez de hash falso.
    var modules = sbomModules()
    assert(modules.size == 48, "48 fontes: " + intToString(modules.size))
    assert(modules.get(0) == "src/kofcloud/agent/Agent.kf", "primeiro modulo")
    assert(modules.get(modules.size - 1) == "src/Main.kf", "ultimo modulo")
    assert(sbomLine("a/b.kf", "") == "UNREADABLE  a/b.kf", "ilegivel nao vira hash")
    var line = sbomLine("a/b.kf", "conteudo")
    assert(line == crypto.sha256("conteudo") + "  a/b.kf", "formato sha256sum")
    assert(line.indexOf("  a/b.kf") >= 0, "caminho na linha")
    var text = sbomText(listOf("a/b.kf", "c/d.kf"), listOf("x", ""))
    assert(text.indexOf(crypto.sha256("x") + "  a/b.kf") >= 0, "primeira linha com hash")
    assert(text.indexOf("UNREADABLE  c/d.kf") >= 0, "segunda linha honesta")
    // O hash e verificavel por fora: mesmo algoritmo do Tokens (sha256).
    var probe = File("src/kofcloud/model/Exposure.kf").readText()
    assert(probe != null && probe.length > 0, "fonte real legivel")
    if (probe != null) {
        assert(sbomLine("src/kofcloud/model/Exposure.kf", probe).startsWith(crypto.sha256(probe)), "hash do disco")
    }
}
