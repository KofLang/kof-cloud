
import kofcloud.cli.Commands
import kofcloud.cli.Local
import kofcloud.model.Exposure
import kofcloud.model.Service
import kofcloud.store.Store
import kofcloud.util.Hosts
import kofcloud.util.Limits
import kofcloud.util.Text
import testkit.Support

test "hostname: monta e valida" {
    need(serviceHostname("site", "mel") == "site.mel.kofcloud.io", "falhou")
    need(accountZone("mel") == "mel.kofcloud.io", "falhou")
}

test "handle: aceita apenas rotulo DNS valido" {
    need(validHandle("mel") == true, "falhou")
    need(validHandle("ab") == false, "falhou")
    need(validHandle("Mel") == false, "falhou")
    need(validHandle("-mel") == false, "falhou")
    need(validHandle("mel-") == false, "falhou")
    need(validHandle("me l") == false, "falhou")
    need(validHandle("mel_1") == false, "falhou")
}

test "host only: remove a porta e normaliza (DNS nao distingue caixa)", "host-normalize" {
    need(hostOnly("site.mel.kofcloud.io:8080") == "site.mel.kofcloud.io", "falhou")
    need(hostOnly("site.mel.kofcloud.io") == "site.mel.kofcloud.io", "falhou")
    // DNS e case-insensitive (RFC 1035 §2.3.1) e o Edge compara contra o
    // hostname minusculo gerado no publish. Normalizar aqui cobre o
    // roteamento E a chave do rate limit: sem isso cada variacao de caixa
    // virava bucket proprio (101 pedidos + troca de caixa = evasao do 429).
    need(hostOnly("Site.Mel.KofCloud.IO") == "site.mel.kofcloud.io", "falhou")
    need(hostOnly("  API.MEL.KOFCLOUD.IO:8080  ") == "api.mel.kofcloud.io", "falhou")
    // Ponto final marca FQDN absoluto — mesmo nome, cliente honesto (curl/dig).
    need(hostOnly("site.mel.kofcloud.io.") == "site.mel.kofcloud.io", "falhou")
    need(hostOnly("SITE.MEL.KOFCLOUD.IO.:8080") == "site.mel.kofcloud.io", "falhou")
}

test "address: so loopback publica (anti-SSRF)", "hosts-loopback" {
    // Lista fechada: o Agent conecta nesse endereco a cada request —
    // qualquer outro valor o transformaria em escaneador da rede local.
    need(validLocalAddress("127.0.0.1") == true, "falhou")
    need(validLocalAddress("localhost") == true, "falhou")
    need(validLocalAddress("::1") == true, "falhou")
    need(validLocalAddress("0.0.0.0") == false, "falhou")
    need(validLocalAddress("10.0.0.5") == false, "falhou")
    need(validLocalAddress("169.254.169.254") == false, "falhou")
    need(validLocalAddress("example.com") == false, "falhou")
    need(validLocalAddress("") == false, "falhou")
    need(validLocalAddress("127.0.0.2") == false, "falhou")
    // defaultLocalAddress e a fonte unica do default (API, manifesto e CLI):
    // tem que estar dentro da lista fechada anti-SSRF.
    need(validLocalAddress(defaultLocalAddress()) == true, "falhou")
}

test "host: extrai o servico do hostname da conta" {
    need(serviceFromHost("site.mel.kofcloud.io", "mel") == "site", "falhou")
    need(serviceFromHost("api.mel.kofcloud.io", "mel") == "api", "falhou")
    need(serviceFromHost("mel.kofcloud.io", "mel") == "", "falhou")
    need(serviceFromHost("site.outra.kofcloud.io", "mel") == "", "falhou")
    need(serviceFromHost("a.b.mel.kofcloud.io", "mel") == "", "falhou")
}

test "exposicao: PRIVATE nao e roteavel" {
    need(exposureIsRoutable(Exposure.PUBLIC) == true, "falhou")
    need(exposureIsRoutable(Exposure.AUTHENTICATED) == true, "falhou")
    need(exposureIsRoutable(Exposure.PRIVATE) == false, "falhou")
    need(exposureName(exposureFrom("PRIVATE")) == "PRIVATE", "falhou")
    need(exposureName(exposureFrom("qualquer")) == "PUBLIC", "falhou")
    // exposureRequiresAuth recebe a string do modelo (Service.exposure
    // viaja como string) — fonte unica do literal AUTHENTICATED para os
    // pontos que so tem a string (HttpFront: gate 401 + dropCredential).
    need(exposureRequiresAuth("AUTHENTICATED") == true, "falhou")
    need(exposureRequiresAuth("PUBLIC") == false, "falhou")
    need(exposureRequiresAuth("PRIVATE") == false, "falhou")
    // exposureIsKnown e a fonte unica do vocabulario para os 3 pontos que
    // validam entrada crua (API, manifesto, CLI): delegam no predicado em
    // vez de repetir os 3 literais (um typo num deles passaria nos outros).
    need(exposureIsKnown("PUBLIC") == true, "falhou")
    need(exposureIsKnown("AUTHENTICATED") == true, "falhou")
    need(exposureIsKnown("PRIVATE") == true, "falhou")
    need(exposureIsKnown("PUBLIK") == false, "falhou")
    need(exposureIsKnown("") == false, "falhou")
    // protocolIsSupported e a fonte unica do protocolo do tunel (so http):
    // API e manifesto delegam (KCF046) em vez de repetir o literal.
    need(protocolIsSupported("http") == true, "falhou")
    need(protocolIsSupported("tcp") == false, "falhou")
    need(protocolIsSupported("HTTP") == false, "falhou")
    need(protocolIsSupported("") == false, "falhou")
    // Defaults single-source: os 3 pontos (API, manifesto, CLI) defaultam
    // pelo construtor; os asserts travam o valor e a consistencia interna
    // (default sempre passa na propria validacao).
    need(defaultExposure() == "PUBLIC", "falhou")
    need(exposureIsKnown(defaultExposure()) == true, "falhou")
    need(defaultProtocol() == "http", "falhou")
    need(protocolIsSupported(defaultProtocol()) == true, "falhou")
}

test "status: OFFLINE nao roteia, ONLINE e UNKNOWN roteiam", "status-routable" {
    need(statusIsRoutable("ONLINE") == true, "falhou")
    need(statusIsRoutable("UNKNOWN") == true, "falhou")
    need(statusIsRoutable("DEGRADED") == true, "falhou")
    need(statusIsRoutable("OFFLINE") == false, "falhou")
    // Os predicados delegam nos construtores (fonte unica do literal):
    // statusDegraded() tinha zero chamadores antes disso.
    need(statusIsRoutable(statusDegraded()) == true, "falhou")
    need(statusIsRoutable(statusOnline()) == true, "falhou")
    need(statusIsSuspended(statusSuspended()) == true, "falhou")
}

test "text: parseIntSafe aceita digito e recusa lixo" {
    need(parseIntSafe("8080", 0) == 8080, "falhou")
    need(parseIntSafe("", 7) == 7, "falhou")
    need(parseIntSafe("80a", 7) == 7, "falhou")
    need(parseIntSafe("-5", 0) == -5, "falhou")
    // parsePortSafe/parseIntBounded sao as unicas portas/contagens de entrada
    // (auditoria de wrap, Fase 14 slice 2q/2r/2s + 2t): parseIntSafe em texto
    // de usuario/CLI/API/rede e wrap — se voce esta adicionando um, pare:
    // use o parser com teto. (Contadores internos sao outra familia: ve
    // Session.pending/EdgeState.serviceConns, escritos pelo proprio codigo.)
    need(parsePortSafe("4294968080", 0) == 0, "falhou")
    need(parsePortSafe("4294967296", 0) == 0, "falhou")
    need(parseIntBounded("4294967396", -1, 2147483647) == -1, "falhou")
    need(parseIntBounded("4294967396", -1, 100) == -1, "falhou")
    need(parseIntBounded("100", -1, 2147483647) == 100, "falhou")
}

test "text: bodyContainsId casa id exato entre aspas" {
    var body = "[\"abc-123\",\"def-456\"]"
    need(bodyContainsId(body, "abc-123") == true, "falhou")
    need(bodyContainsId(body, "abc-12") == false, "falhou")
    need(bodyContainsId(body, "zzz") == false, "falhou")
    need(bodyContainsId(body, "") == false, "falhou")
    need(bodyContainsId("[]", "abc-123") == false, "falhou")
}

test "text: bearerValue extrai o token do Authorization" {
    // Fonte unica do parsing (control plane + Edge delegam): Bearer com
    // qualquer caixa, valor cru sem esquema, vazio e padding.
    need(bearerValue("Bearer abc123") == "abc123", "falhou")
    need(bearerValue("BEARER abc123") == "abc123", "falhou")
    need(bearerValue("bearer abc123") == "abc123", "falhou")
    need(bearerValue("abc123") == "abc123", "falhou")
    need(bearerValue("") == "", "falhou")
    need(bearerValue("Bearer   abc123  ") == "abc123", "falhou")
    need(bearerValue("Bearer ") == "", "falhou")
}

test "text: identificadores U da matriz sao unicos", "u-matrix" {
    // Trava do docs/15-tests.md: cada numero U identifica exatamente uma
    // linha da matriz (e o indice que liga cobertura a fase). Precedente:
    // a linha do framing nasceu U51 igual a do login-error e so um olho
    // humano pegou — duplicado quebra a invariante em silencio. Precedentes
    // de trava em doc versionado: security-policy e postmortem-template.
    // Caminho relativo ao repo: o runner usa a raiz como cwd.
    var matrix = readTextOr("docs/15-tests.md", "")
    need(matrix.length > 0, "falhou")
    // Cada "| Unn |" conta uma linha; U com 3 digitos nao aparece hoje, e
    // "| U1 |" nao casa "| U10 |" porque exige os espacos dos dois lados.
    var i = 1
    while (i <= 99) {
        var marker = "| U" + intToString(i) + " |"
        var first = matrix.indexOf(marker, 0)
        if (first >= 0) {
            need(matrix.indexOf(marker, first + 1) < 0, "falhou")
        }
        i = i + 1
    }
    need(matrix.indexOf("| U54 |") >= 0, "falhou")
    need(matrix.indexOf("| U51 |") >= 0, "falhou")
}

// Conta as declaracoes `test "` que COMECAM uma linha (o runner so aceita
// declaracao no inicio da linha; contar ocorrencias soltas pegaria o texto
// deste comentario e o do teste que usa o helper). Mesmo precedente de leitura
// de doc versionado do u-matrix/security-policy.
Int countTestDeclarations(String path) {
    var body = readTextOr(path, "")
    var count = 0
    for (var line in body.split("\n")) {
        if (line.startsWith("test \"")) {
            count = count + 1
        }
    }
    return count
}

// Celulas de uma linha de tabela markdown. NAO usa `split("|")`: o `split`
// do stdlib trata o argumento como REGEX e `|` e alternancia vazia (divide
// por caractere — medido). Indexacao manual, mesma licao do separador `;`
// em Registry.expiryProbes.
List<String> tableCells(String line) {
    var out = listOf<String>()
    var start = 0
    var bar = line.indexOf("|")
    while (bar >= 0) {
        out.add(line.substring(start, bar).trim())
        start = bar + 1
        bar = line.indexOf("|", start)
    }
    if (start < line.length) {
        out.add(line.substring(start).trim())
    }
    return out
}

test "text: contagem por suite no STATUS bate com os arquivos", "status-counts" {
    // Trava do docs/STATUS.md: a tabela "Suite | Arquivo | Testes" e o retrato
    // honesto do que existe; numero defasado ali e mentira silenciosa (medido:
    // protocol estava 11 com 12 no arquivo, metrics 9 com 10 — a soma da
    // tabela dava 307 contra 309 reais). Cada linha com UM arquivo tem de
    // bater com a contagem real de `test "` daquele arquivo.
    var status = readTextOr("docs/STATUS.md", "")
    need(status.length > 0, "falhou")
    var checked = 0
    var sumReal = 0
    for (var line in status.split("\n")) {
        if (line.startsWith("|") == false || line.startsWith("| `tests/")) {
            continue
        }
        var cells = tableCells(line)
        if (cells.length < 4) {
            continue
        }
        var fileCell = cells[2]
        if (fileCell.indexOf("`tests/") != 0) {
            continue
        }
        var closing = fileCell.indexOf("`", 1)
        if (closing < 0) {
            continue
        }
        var path = fileCell.substring(1, closing)
        // Linhas com mais de um arquivo (ex.: "+13 asserts" de dois suites)
        // nao tem contagem unica: ficam fora da trava por desenho.
        if (fileCell.indexOf("`tests/", closing) >= 0) {
            continue
        }
        var declared = parseIntBounded(cells[cells.length - 1], -1, 100000)
        if (declared <= 0) {
            continue
        }
        var real = countTestDeclarations(path)
        need(real == declared, "falhou")
        checked = checked + 1
        sumReal = sumReal + real
    }
    // Sanidade da propria trava: se o formato da tabela mudar e nada casar,
    // ela nao pode passar em silencio.
    need(checked >= 40, "falhou")
    // Total e contadores de suites em PROSA, derivados ao vivo — nunca
    // hardcoded. A mesma mentira silenciosa que a tabela punia existia fora
    // dela: README e STATUS diziam "56 suites" com a suite real em 57 (drift
    // silencioso do contador, medido neste run). `suites` = linhas
    // reconhecidas acima (uma por arquivo de teste); o total = soma dos
    // testes REAIS dos arquivos listados (nunca o numero declarado na tabela).
    // Sanidade: uma linha em prosa fora do formato esperado nao pode passar.
    var suites = checked
    var totalIdx = status.indexOf("Total: ")
    need(totalIdx >= 0, "falhou")
    var testesIdx = status.indexOf(" testes", totalIdx)
    need(testesIdx > totalIdx + 7, "falhou")
    var declaredTotal = parseIntBounded(status.substring(totalIdx + 7, testesIdx), -1, 1000000)
    need(declaredTotal == sumReal, "falhou")
    var suiteMark = "# " + intToString(suites) + " suites"
    need(status.indexOf(suiteMark) >= 0, "falhou")
    var readme = readTextOr("README.md", "")
    var readmeMark = "(" + intToString(suites) + " suites)"
    need(readme.indexOf(readmeMark) >= 0, "falhou")
    // O resumo final da CLI ("57 passed, 0 failed") conta SUITES — o mesmo
    // contador reconhecido acima; a frase do run total no STATUS viaja junto.
    var runMark = "`" + intToString(suites) + " passed, 0 failed`"
    need(status.indexOf(runMark) >= 0, "falhou")
    need(suites > 50, "falhou")
}

test "text: tailLines devolve as ultimas linhas", "logs-tail" {
    var log = "l1\nl2\nl3\n"
    need(tailLines(log, 2) == "l2\nl3\n", "falhou")
    need(tailLines(log, 5) == log, "falhou")
    need(tailLines(log, 0) == log, "falhou")
    need(tailLines(log, -1) == log, "falhou")
    need(tailLines("so-uma\n", 1) == "so-uma\n", "falhou")
    need(tailLines("", 3) == "", "falhou")
    // Sem trailing newline: a parcial conta como linha.
    need(tailLines("a\nb", 1) == "b\n", "falhou")
    // `--tail` lia com parseIntSafe (32 bits): 4294967396 virava 100 e era
    // aceito em silencio — o usuario pedia bilhoes e recebia cem linhas.
    need(parseIntBounded("100", -1, 2147483647) == 100, "falhou")
    need(parseIntBounded(" 100 ", -1, 2147483647) == 100, "falhou")
    need(parseIntBounded("4294967396", -1, 2147483647) == -1, "falhou")
    need(parseIntBounded("4294967296", -1, 2147483647) == -1, "falhou")
    need(parseIntBounded("2147483648", -1, 2147483647) == -1, "falhou")
    need(parseIntBounded("2147483647", -1, 2147483647) == 2147483647, "falhou")
    need(parseIntBounded("0", -1, 2147483647) == -1 && parseIntBounded("-3", -1, 2147483647) == -1, "falhou")
    need(parseIntBounded("12x", -1, 2147483647) == -1 && parseIntBounded("", -1, 2147483647) == -1, "falhou")
}

test "text: trimLogHead corta o inicio em linhas inteiras", "logs-cap" {
    var log = "l1-antiga\nl2\nl3-recente\n"
    // Teto folgado: nada muda.
    need(trimLogHead(log, 1000) == log, "falhou")
    // Teto zero/desligado: nada muda.
    need(trimLogHead(log, 0) == log, "falhou")
    // Teto curto: corta l1, mantem o fim em linhas inteiras.
    var trimmed = trimLogHead(log, 12)
    need(trimmed.indexOf("l1-antiga") < 0, "falhou")
    need(trimmed.indexOf("l3-recente") >= 0, "falhou")
    need(trimmed.endsWith("\n"), "falhou")
    need(trimmed.length <= 12 + "l2\n".length, "falhou")
    // Fonte unica do teto (os dois logs — agent.log e runtime — e o test do
    // help passam pela mesma funcao). Recuo em fonte pura: com 0/negativo o
    // trimLogHead devolve o texto SEM cortar (maxBytes <= 0 = sem teto) e os
    // DOIS logs crescem sem limite — disco cheio e o Agent morre numa
    // escrita. Zero nunca foi "sem log" (a saida continua no stdout).
    need(logBytesFrom(0) == 262144, "falhou")
    need(logBytesFrom(-1) == 262144, "falhou")
    need(logBytesFrom(100000) == 100000, "falhou")
    need(limitLogBytes() == 262144, "falhou")
    // Sem newline no trecho util: devolve o fim cru.
    var flat = trimLogHead("abcdefghij", 4)
    need(flat == "ghij", "falhou")
}

test "text: tokenInventoryLine resume credenciais sem vazar valor", "token-status" {
    // Pura, sem rede nem HOME (precedente: doctorTunnelLine): o status
    // chama com o que a API ja devolve (id curto + expiracao opcional) e o
    // relogio do chamador. As perto do fim sao contadas com o MESMO
    // predicado do aviso por entrada do `token-list`.
    var now = 1000000000000L
    var agora = longToString(now)
    var empty = listOf<ServiceTokenEntry>()
    need(tokenInventoryLine(empty, agora) == "", "falhou")
    var plain = listOf<ServiceTokenEntry>()
    plain.add(ServiceTokenEntry("svc", "a1b2c3d4", "1700000000000", null))
    var one = tokenInventoryLine(plain, agora)
    need(one.indexOf("1 emitida(s)") >= 0, "falhou")
    need(one.indexOf("a1b2c3d4") < 0, "falhou")
    need(one.indexOf("expiracao") < 0, "falhou")
    var mixed = listOf<ServiceTokenEntry>()
    mixed.add(ServiceTokenEntry("svc", "a1b2c3d4", "1700000000000", null))
    mixed.add(ServiceTokenEntry("svc", "e5f6a7b8", "1700000000000", "1730000000000"))
    var two = tokenInventoryLine(mixed, agora)
    need(two.indexOf("2 emitida(s)") >= 0, "falhou")
    need(two.indexOf("1 com expiracao") >= 0, "falhou")
    need(two.indexOf("token-list") >= 0, "falhou")
    // Perto do fim: contagem com o mesmo predicado/janela do `token-list`.
    var longe = longToString(now + limitTokenExpiryWarnMs() + 86400000L)
    var calmo = listOf<ServiceTokenEntry>()
    calmo.add(ServiceTokenEntry("svc", "e5f6a7b8", "1700000000000", longe))
    var semAviso = tokenInventoryLine(calmo, agora)
    need(semAviso.indexOf("com expiracao") >= 0, "falhou")
    need(semAviso.indexOf("AVISO") < 0, "falhou")
    var perto = longToString(now + limitTokenExpiryWarnMs() - 1000L)
    var alerta = listOf<ServiceTokenEntry>()
    alerta.add(ServiceTokenEntry("svc", "e5f6a7b8", "1700000000000", perto))
    var comAviso = tokenInventoryLine(alerta, agora)
    need(comAviso.indexOf("AVISO") >= 0, "falhou")
    need(comAviso.indexOf("1 expira(m)") >= 0, "falhou")
    need(comAviso.indexOf("service rotate") >= 0, "falhou")
    var vencida = listOf<ServiceTokenEntry>()
    vencida.add(ServiceTokenEntry("svc", "e5f6a7b8", "1700000000000", longToString(now - 1L)))
    need(tokenInventoryLine(vencida, agora).indexOf("AVISO") < 0, "falhou")
    var duas = listOf<ServiceTokenEntry>()
    duas.add(ServiceTokenEntry("svc", "e5f6a7b8", "1700000000000", perto))
    duas.add(ServiceTokenEntry("svc", "c9d8e7f6", "1700000000000", longe))
    var mistas = tokenInventoryLine(duas, agora)
    need(mistas.indexOf("2 com expiracao") >= 0, "falhou")
    need(mistas.indexOf("1 expira(m)") >= 0, "falhou")
}

test "text: validatePublishLocal barra exposure/address ruins sem rede", "publish-local" {
    // Pura, sem rede nem HOME (precedente: doctorTunnelLine): o cmdPublish
    // chama antes de qualquer fetch; aqui cobrimos a decisao direto.
    need(validatePublishLocal("site", 8080, "PUBLIC", "127.0.0.1") == "", "falhou")
    need(validatePublishLocal("site", 8080, "PRIVATE", "localhost") == "", "falhou")
    need(validatePublishLocal("", 8080, "PUBLIC", "127.0.0.1").indexOf("uso:") >= 0, "falhou")
    need(validatePublishLocal("site", 0, "PUBLIC", "127.0.0.1").indexOf("uso:") >= 0, "falhou")
    need(validatePublishLocal("site", 99999, "PUBLIC", "127.0.0.1").indexOf("1-65535") >= 0, "falhou")
    need(validatePublishLocal("site", 8080, "PUBLIK", "127.0.0.1").indexOf("exposure invalida") >= 0, "falhou")
    need(validatePublishLocal("site", 8080, "PUBLIC", "10.0.0.5").indexOf("address invalido") >= 0, "falhou")
    need(validatePublishLocal("site", 8080, "PUBLIC", "169.254.169.254").indexOf("127.0.0.1") >= 0, "falhou")
    // Trim como o parseManifest: padding passa aparado; so-espacos falha
    // como ausente no nome (fail-fast local). Exposure/address so-espacos
    // falham NO VALIDADOR PURO (ele nao defaulta — o default vive no
    // chamador); no fluxo real o cmdPublish apara + defaulta antes
    // (igual ao parse do manifesto), entao esse caminho nao dispara.
    need(validatePublishLocal("  site  ", 8080, " PUBLIC ", " localhost ") == "", "falhou")
    need(validatePublishLocal("   ", 8080, "PUBLIC", "127.0.0.1").indexOf("uso:") >= 0, "falhou")
    need(validatePublishLocal("site", 8080, "   ", "127.0.0.1").indexOf("exposure invalida") >= 0, "falhou")
    need(validatePublishLocal("site", 8080, "PUBLIC", "   ").indexOf("address invalido") >= 0, "falhou")
}

test "text: validTtlHours aceita vazio e positivos", "ttl-local" {
    // Pura, sem rede nem HOME: o cmdServiceToken chama antes de buscar
    // servicos (fail-fast local, mesma regra do KCF062 na API). Trim como o
    // parseManifest: padding passa aparado; so-espacos = ausente (sem TTL).
    need(validTtlHours("") == true, "falhou")
    need(validTtlHours("24") == true, "falhou")
    need(validTtlHours("1") == true, "falhou")
    need(validTtlHours("  24  ") == true, "falhou")
    need(validTtlHours("   ") == true, "falhou")
    need(validTtlHours("0") == false, "falhou")
    need(validTtlHours("  0  ") == false, "falhou")
    need(validTtlHours("-5") == false, "falhou")
    need(validTtlHours("lixo") == false, "falhou")
    need(validTtlHours("  lixo  ") == false, "falhou")
    // 4294967396 virava 100 horas com parseIntSafe (wrap de 32 bits).
    need(validTtlHours("4294967396") == false, "falhou")
    need(validTtlHours("4294967296") == false, "falhou")
}

test "text: validateServePorts barra porta fora da faixa", "serve-ports" {
    // Pura, sem rede nem HOME: o cmdServe chama antes de abrir qualquer
    // listener (fail-fast, sem bind parcial). Os defaults vêm da fonte
    // unica (Hosts): mudar la muda aqui sem caçar literal.
    need(defaultControlPort() == 8080, "falhou")
    need(defaultTunnelPort() == 7000, "falhou")
    need(defaultHttpPort() == 8081, "falhou")
    need(validateServePorts(defaultControlPort(), defaultTunnelPort(), defaultHttpPort()) == "", "falhou")
    need(validateServePorts(1, 1, 1).length == 0, "falhou")
    need(validateServePorts(65535, 65535, 65535).length == 0, "falhou")
    need(validateServePorts(0, defaultTunnelPort(), defaultHttpPort()).indexOf("control-port") >= 0, "falhou")
    need(validateServePorts(defaultControlPort(), 70000, defaultHttpPort()).indexOf("tunnel-port") >= 0, "falhou")
    need(validateServePorts(defaultControlPort(), defaultTunnelPort(), -1).indexOf("http-port") >= 0, "falhou")
    need(defaultControlUrl() == "http://127.0.0.1:" + intToString(defaultControlPort()), "falhou")
    // Porta lida sem estouro de Int: 4294968080 fazia wrap para 784 e era
    // aceita em silencio; 4294967296 virava 0.
    need(parsePortSafe("8080", 0) == 8080, "falhou")
    need(parsePortSafe(" 8080 ", 0) == 8080, "falhou")
    need(parsePortSafe("1", 0) == 1 && parsePortSafe("65535", 0) == 65535, "falhou")
    need(parsePortSafe("4294968080", -1) == -1, "falhou")
    need(parsePortSafe("4294967296", -1) == -1, "falhou")
    need(parsePortSafe("65536", -1) == -1, "falhou")
    need(parsePortSafe("0", -1) == -1 && parsePortSafe("-1", -1) == -1, "falhou")
    need(parsePortSafe("8080x", -1) == -1 && parsePortSafe("", -1) == -1, "falhou")
    // Flag do serve: ausente usa o default; presente e invalida vira -1 e a
    // validacao recusa (nunca cai no default em silencio).
    need(portFlagValue("", defaultControlPort()) == defaultControlPort(), "falhou")
    need(portFlagValue("   ", defaultControlPort()) == defaultControlPort(), "falhou")
    need(portFlagValue("4294968080", defaultControlPort()) == -1, "falhou")
    need(validateServePorts(portFlagValue("4294968080", defaultControlPort()), defaultTunnelPort(), defaultHttpPort()).indexOf("control-port") >= 0, "falhou")
}

test "text: flag sem valor nao vira default silencioso", "flag-missing" {
    // Pura, sem rede nem HOME: `flagValue` sozinho nao distingue "ausente"
    // de "presente sem valor" — flagMissingValue fecha o buraco para as
    // flags cujo default mentiria sobre a intencao (ex.: --ttl solto
    // viraria "sem expiracao").
    need(flagMissingValue(listOf<String>(), "--ttl") == false, "falhou")
    need(flagMissingValue(listOf("--ttl"), "--ttl") == true, "falhou")
    need(flagMissingValue(listOf("--ttl", "--check"), "--ttl") == true, "falhou")
    need(flagMissingValue(listOf("--ttl", "24"), "--ttl") == false, "falhou")
    need(flagMissingValue(listOf("site", "--port"), "--port") == true, "falhou")
    need(flagMissingValue(listOf("--port", "8080"), "--other") == false, "falhou")
    need(flagMissingValue(listOf("api.example.com", "--service"), "--service") == true, "falhou")
    need(flagMissingValue(listOf("--tail"), "--tail") == true, "falhou")
}

test "text: flagDuplicated barra repeticao silenciosa", "flag-dup" {
    // Pura, sem rede nem HOME: `flagValue` leria a primeira ocorrencia e
    // ignoraria a segunda — ambiguidade que vira surpresa (o operador acha
    // que vale a ultima). Fail-fast antes de qualquer efeito.
    need(flagDuplicated(listOf<String>(), "--port") == false, "falhou")
    need(flagDuplicated(listOf("--port", "8080"), "--port") == false, "falhou")
    need(flagDuplicated(listOf("--port", "80", "--port", "8080"), "--port") == true, "falhou")
    need(flagDuplicated(listOf("--port", "80", "--port"), "--port") == true, "falhou")
    need(flagDuplicated(listOf("--port", "8080"), "--ttl") == false, "falhou")
    need(flagDuplicated(listOf("--ttl", "24", "--ttl", "48"), "--ttl") == true, "falhou")
    need(flagDuplicated(listOf("--tail", "10", "--tail", "20"), "--tail") == true, "falhou")
    need(flagDuplicated(listOf("--service", "a", "--service", "b"), "--service") == true, "falhou")
    // Booleanas repetidas tambem barram: `hasFlag` leria a primeira em
    // silencio (medido: `down --prune --prune` rodava normal). Cobrem as
    // guardas de deploy/down/incidents/migrate/logs/serve (precedente:
    // --all/--prune do rotate e --sbom/--verify do audit).
    need(flagDuplicated(listOf("--check", "--check"), "--check") == true, "falhou")
    need(flagDuplicated(listOf("--plan", "--plan"), "--plan") == true, "falhou")
    need(flagDuplicated(listOf("--prune"), "--prune") == false, "falhou")
    need(flagDuplicated(listOf("--prune", "--prune"), "--prune") == true, "falhou")
    need(flagDuplicated(listOf("--all", "--all"), "--all") == true, "falhou")
    need(flagDuplicated(listOf("--dry-run", "--dry-run"), "--dry-run") == true, "falhou")
    need(flagDuplicated(listOf("--runtime", "--runtime"), "--runtime") == true, "falhou")
    need(flagDuplicated(listOf("--panel", "--panel"), "--panel") == true, "falhou")
    need(flagDuplicated(listOf("--status-page", "--status-page"), "--status-page") == true, "falhou")
}

test "text: extraPositional barra posicional sobrando", "extra-positional" {
    // Pura, sem rede nem HOME: first/secondPositional leriam os N primeiros
    // em silencio e o resto sumiria — typo que vira acao errada sem aviso.
    // Valores de flag nao contam como posicionais (lista fechada em
    // extraPositional, igual as flags que flagValue entende).
    need(extraPositional(listOf<String>(), 1) == false, "falhou")
    need(extraPositional(listOf("site"), 1) == false, "falhou")
    need(extraPositional(listOf("site", "lixo"), 1) == true, "falhou")
    need(extraPositional(listOf("site", "--port", "8080"), 1) == false, "falhou")
    need(extraPositional(listOf("site", "--port", "8080", "lixo"), 1) == true, "falhou")
    need(extraPositional(listOf("site", "kfs_x", "lixo"), 2) == true, "falhou")
    need(extraPositional(listOf("site", "kfs_x"), 2) == false, "falhou")
    need(extraPositional(listOf("site", "--ttl", "24"), 1) == false, "falhou")
    // Extratores firstPositional/secondPositional agora compartilham a mesma
    // fonte unica (positionalArgs): a flag pode vir antes do argumento sem que
    // o VALOR da flag seja confundido com o argumento (defeito real medido).
    need(firstPositional(listOf("--port", "8080", "site")) == "site", "falhou")
    need(firstPositional(listOf("site", "--port", "8080")) == "site", "falhou")
    need(firstPositional(listOf("--password", "segredo", "mel")) == "mel", "falhou")
    need(firstPositional(listOf("--ttl", "24", "--all")) == "", "falhou")
    need(firstPositional(listOf<String>()) == "", "falhou")
    // secondPositional pula o valor de flags intermediarias e preserva a ordem.
    need(secondPositional(listOf("set", "--secret", "s", "https://hook.com")) == "https://hook.com", "falhou")
    need(secondPositional(listOf("set", "https://hook.com", "--secret", "s")) == "https://hook.com", "falhou")
    need(secondPositional(listOf("site", "kfs_x")) == "kfs_x", "falhou")
    need(secondPositional(listOf("so-um")) == "", "falhou")
    need(secondPositional(listOf("--service", "s")) == "", "falhou")
    // positionalArgs expoe a lista pura.
    var pos = positionalArgs(listOf("--control", "http://c", "mel", "--device", "nb"))
    need(pos.size == 1 && pos.get(0) == "mel", "falhou")
}

test "text: comandos sem posicional rejeitam sobra", "extra-zero" {
    // logout/connect/disconnect/status/doctor/deploy/down nao tem
    // posicionais: qualquer token solto e erro, nao no-op silencioso.
    need(extraPositional(listOf("qualquer"), 0) == true, "falhou")
    need(extraPositional(listOf<String>(), 0) == false, "falhou")
    need(extraPositional(listOf("--file", "k.json"), 0) == false, "falhou")
    need(extraPositional(listOf("x", "--file", "k.json"), 0) == true, "falhou")
}

test "text: domainListLine mostra status so do custom", "domain-list-line" {
    // Pura, sem rede (precedente: tokenInventoryLine): wildcard/service nao
    // tem ciclo PENDING/VERIFIED; custom mostra para o operador saber se
    // falta o DNS.
    need(domainListLine(DomainEntry("mel.kofcloud.io", "wildcard", "", "")) == "wildcard  mel.kofcloud.io", "falhou")
    need(domainListLine(DomainEntry("site.mel.kofcloud.io", "service", "site", "")) == "service  site.mel.kofcloud.io", "falhou")
    need(domainListLine(DomainEntry("api.example.com", "custom", "site", "PENDING")) == "custom  api.example.com  PENDING", "falhou")
    need(domainListLine(DomainEntry("api.example.com", "custom", "site", "VERIFIED")) == "custom  api.example.com  VERIFIED", "falhou")
}

test "text: customDomainsFor filtra customs do servico", "custom-domains-for" {    // Pura, sem rede (precedente: domainListLine): o `service status`
    // lista so os customs vinculados aquele servico — wildcard/service e
    // customs de outro nome ficam de fora.
    var domains = listOf<DomainEntry>()
    domains.add(DomainEntry("mel.kofcloud.io", "wildcard", "", ""))
    domains.add(DomainEntry("site.mel.kofcloud.io", "service", "site", ""))
    domains.add(DomainEntry("api.example.com", "custom", "site", "PENDING"))
    domains.add(DomainEntry("loja.example.com", "custom", "loja", "VERIFIED"))
    var only = customDomainsFor(domains, "site")
    need(only.size == 1, "falhou")
    need(only.get(0).hostname == "api.example.com", "falhou")
    need(domainListLine(only.get(0)).indexOf("PENDING") >= 0, "falhou")
    need(customDomainsFor(domains, "loja").size == 1, "falhou")
    need(customDomainsFor(domains, "novo").size == 0, "falhou")
    need(customDomainsFor(listOf<DomainEntry>(), "site").size == 0, "falhou")
}

test "text: notFoundLine trava mensagens da CLI", "not-found-line" {
    // Puras, sem rede (precedente: domainListLine): fonte unica das 11
    // mensagens "nao encontrado" (7 servico + 4 dispositivo) — se o texto
    // mudar, muda num lugar so e este teste acusa.
    need(serviceNotFoundLine("site") == "servico nao encontrado: site", "falhou")
    need(deviceNotFoundLine("dev1") == "dispositivo nao encontrado: dev1", "falhou")
    // Guarda de sessao: ~20 pontos bare + 9 com dica convergem na forma com
    // dica — o operador sem sessao recebe a mesma orientacao em todo comando.
    need(notLoggedInLine() == "nao logado — rode: kof cloud login <handle> --password <senha>", "falhou")
    need(notLoggedInLine().indexOf("kof cloud login") >= 0, "falhou")
    // Linhas de uso duplicadas em dois guardas do mesmo comando (fonte
    // unica): cada helper abaixo cobre 2 call sites (flag + args).
    need(usoServiceTokenLine() == "uso: kof cloud service token <nome> [--ttl <horas>]", "falhou")
    // Uso do dispatch (grupo sem subcomando): precisa listar TODOS os subs
    // que o runXxx despacha — antes `service` omitia tokens|rotate|rotation
    // e `token` omitia prune (medido: o comando existia, o help anunciava,
    // o uso mentia). Puras, sem rede.
    need(usoServiceDispatchLine() == "uso: kof cloud service list|status|suspend|unsuspend|token <nome>|token-list <nome>|token-revoke <nome> <kfs_...|id>|tokens|rotate|rotation", "falhou")
    need(usoTokenDispatchLine() == "uso: kof cloud token list|revoke|rotate|rotation|prune", "falhou")
    // Os outros 3 dispatch (device/domain/daemon) ja listavam tudo — agora
    // tambem em fonte unica (mesmo padrao, sem refatorar formato).
    need(usoDeviceDispatchLine() == "uso: kof cloud device list|revoke|suspend|unsuspend <nome|id>", "falhou")
    need(usoDomainDispatchLine() == "uso: kof cloud domain list|add|verify|remove", "falhou")
    need(usoDaemonDispatchLine() == "uso: kof cloud daemon install|status|uninstall", "falhou")
    need(usoServeLine().indexOf("kof cloud serve") >= 0, "falhou")
    need(usoLogsLine() == "uso: kof cloud logs [--tail <linhas>] [--runtime|--edge]", "falhou")
    need(usoDomainAddLine() == "uso: kof cloud domain add <hostname> --service <nome> [--dns-webhook <url> | --dns-cmd <cmd>] [--dry-run]", "falhou")
}

test "text: matchServiceName apara antes de comparar", "service-name-match" {
    // Pura, sem rede nem HOME (precedente: customDomainsFor): unpublish/
    // status/token/token-revoke resolvem por ela; padding resolve, so-espacos
    // nao casa com nada (o chamador barra vazio como uso antes).
    var services = listOf<Service>()
    services.add(Service("id1", "acc", "dev", "site", "127.0.0.1", 8080, "http", "site.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 1000, "", "", ""))
    services.add(Service("id2", "acc", "dev", "loja", "127.0.0.1", 3000, "http", "loja.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 1000, "", "", ""))
    need(matchServiceName(services, "site") == "id1", "falhou")
    need(matchServiceName(services, "  site  ") == "id1", "falhou")
    need(matchServiceName(services, "loja") == "id2", "falhou")
    need(matchServiceName(services, "   ") == "", "falhou")
    need(matchServiceName(services, "outro") == "", "falhou")
    need(matchServiceName(listOf<Service>(), "site") == "", "falhou")
    // Homonimo entre devices: antes o matcher devolvia o PRIMEIRO que casava
    // (a ordem da lista decidia o device) e o comando agia no errado sem
    // avisar. Agora resolveServiceName marca ambiguo e matchServiceName
    // devolve "" (nunca escolhe).
    var devA = Service("idA", "acc", "devA", "dup", "127.0.0.1", 8080, "http", "dup.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 1000, "", "", "")
    var devB = Service("idB", "acc", "devB", "dup", "127.0.0.1", 9090, "http", "dup.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 1000, "", "", "")
    var amb = resolveServiceName(listOf<Service>(devA, devB), "dup")
    need(amb.ambiguous, "falhou")
    need(amb.uniqueId == "", "falhou")
    need(amb.deviceIds.size == 2, "falhou")
    need(amb.deviceIds.contains("devA") && amb.deviceIds.contains("devB"), "falhou")
    need(matchServiceName(listOf<Service>(devA, devB), "dup") == "", "falhou")
    // Ordem da lista nao muda o veredito (era o defeito).
    need(resolveServiceName(listOf<Service>(devB, devA), "dup").ambiguous, "falhou")
    var single = resolveServiceName(listOf<Service>(devA), "dup")
    need(single.uniqueId == "idA" && single.ambiguous == false, "falhou")
    var none = resolveServiceName(listOf<Service>(devA), "outro")
    need(none.uniqueId == "" && none.ambiguous == false, "falhou")
    var line = serviceAmbiguousLine("dup", listOf<String>("devA", "devB"))
    need(line.indexOf("dup") >= 0, "falhou")
    need(line.indexOf("2 dispositivos") >= 0, "falhou")
    need(line.indexOf("devA") >= 0 && line.indexOf("devB") >= 0, "falhou")
}

test "text: resolveLoginInputs apara sem tocar na senha", "login-trim" {
    // Pura, sem rede nem HOME (precedente: matchServiceName): o cmdLogin
    // delega antes dos defaults/guardas; handle/--control/--device com
    // padding entram limpos, --device so-espacos vira vazio (o chamador
    // cai no default "default"), e a senha passa intacta (credencial).
    var padded = resolveLoginInputs("  mel  ", "  http://127.0.0.1:8080  ", "  notebook  ")
    need(padded.handle == "mel", "falhou")
    need(padded.control == "http://127.0.0.1:8080", "falhou")
    need(padded.device == "notebook", "falhou")
    var blank = resolveLoginInputs("mel", "http://127.0.0.1:8080", "   ")
    need(blank.device == "", "falhou")
    var clean = resolveLoginInputs("mel", "http://127.0.0.1:8080", "notebook")
    need(clean.handle == "mel", "falhou")
    need(clean.control == "http://127.0.0.1:8080", "falhou")
    need(clean.device == "notebook", "falhou")
}

test "text: resolveWafMode so aceita detectar|enforce", "serve-waf" {
    // Pura, sem rede nem HOME (precedente: resolveStatePath): --waf
    // ausente/vazio/so-espacos = detectar; padding apara; lixo vira "?"
    // (o cmdServe barra com uso, sem default mentiroso). O fio ate o
    // EdgeState (setWafEnforce) e o e2e `waf-flag` provam o efeito.
    need(resolveWafMode("") == "detectar", "falhou")
    need(resolveWafMode("   ") == "detectar", "falhou")
    need(resolveWafMode("  enforce  ") == "enforce", "falhou")
    need(resolveWafMode("detectar") == "detectar", "falhou")
    need(resolveWafMode("enforce") == "enforce", "falhou")
    need(resolveWafMode("ENFORCE") == "?", "falhou")
    need(resolveWafMode("block") == "?", "falhou")
    // Guardas do cmdServe (precedente: serve-state): --waf solto ou
    // repetido barra antes de qualquer listener, igual as portas.
    need(flagMissingValue(listOf("--waf"), "--waf") == true, "falhou")
    need(flagMissingValue(listOf("--waf", "--state"), "--waf") == true, "falhou")
    need(flagMissingValue(listOf("--waf", "enforce"), "--waf") == false, "falhou")
    need(flagDuplicated(listOf("--waf", "a", "--waf", "b"), "--waf") == true, "falhou")
}

test "text: resolveTlsPair exige o par cert+key", "serve-tls" {
    // Pura, sem rede nem HOME (precedente: resolveWafMode): ausente = ""
    // (HTTP, comportamento atual); metade sozinha = erro (nao default
    // silencioso); padding apara; o par volta colado por "\n".
    need(resolveTlsPair("", "") == "", "falhou")
    need(resolveTlsPair("   ", "") == "", "falhou")
    need(resolveTlsPair("/c.pem", "") == "tls exige --tls-cert e --tls-key juntos (par ausente)", "falhou")
    need(resolveTlsPair("", "/k.pem") == "tls exige --tls-cert e --tls-key juntos (par ausente)", "falhou")
    need(resolveTlsPair("  /c.pem  ", "  /k.pem  ") == "/c.pem\n/k.pem", "falhou")
    need(controlScheme("") == "http", "falhou")
    need(controlScheme("/c.pem\n/k.pem") == "https", "falhou")
    // Guardas do cmdServe (precedente: serve-state): --tls-cert/--tls-key
    // soltas ou repetidas barram antes de qualquer listener.
    need(flagMissingValue(listOf("--tls-cert"), "--tls-cert") == true, "falhou")
    need(flagMissingValue(listOf("--tls-cert", "c.pem"), "--tls-cert") == false, "falhou")
    need(flagMissingValue(listOf("--tls-key"), "--tls-key") == true, "falhou")
    need(flagDuplicated(listOf("--tls-key", "a", "--tls-key", "b"), "--tls-key") == true, "falhou")
    // Aviso de expiracao (Fase 9 slice 3 parcial): pura sobre o exitCode
    // do `openssl x509 -checkend` (0 = valido alem do prazo). Decisao
    // separada do IO para testar sem openssl e sem disco.
    need(tlsCertExpiringSoon(0) == false, "falhou")
    need(tlsCertExpiringSoon(1) == true, "falhou")
    // Janela do `-checkend` em fonte unica (30 dias = 2592000 s): os 5 pontos
    // que consultam o openssl (serve, domain status/verify, scan, doctor) e os
    // testes que geram PEM real passam por aqui — mudar o prazo muda todos
    // juntos. Valor travado + mutacao quebra.
    need(tlsCheckendWindowSec() == "2592000", "falhou")
    need(parseIntSafe(tlsCheckendWindowSec(), 0) == 30 * 24 * 60 * 60, "falhou")
}

test "text: resolveStatePath apara e cai no default", "serve-state" {
    // Pura (precedente: resolveLoginInputs): --state ausente/vazio/
    // so-espacos = default; padding apara; caminho limpo passa direto.
    var def = kofcloudHome() + "/control-state.json"
    need(resolveStatePath("") == def, "falhou")
    need(resolveStatePath("   ") == def, "falhou")
    need(resolveStatePath("  /tmp/estado.json  ") == "/tmp/estado.json", "falhou")
    need(resolveStatePath("/tmp/estado.json") == "/tmp/estado.json", "falhou")
    // Guardas do cmdServe (precedente: flag-missing/flag-dup): --state
    // solto ou repetido barra antes de qualquer listener, igual as portas.
    need(flagMissingValue(listOf("--state"), "--state") == true, "falhou")
    need(flagMissingValue(listOf("--state", "--control-port"), "--state") == true, "falhou")
    need(flagMissingValue(listOf("--state", "/tmp/x.json"), "--state") == false, "falhou")
    need(flagDuplicated(listOf("--state", "a", "--state", "b"), "--state") == true, "falhou")
    need(flagDuplicated(listOf("--state", "a"), "--state") == false, "falhou")
}

test "text: sbom cobre os 49 fontes com hash verificavel", "audit-sbom" {
    // Puras (precedente: serve-tls): lista curada em fonte unica (trava
    // quebra se adicionarem modulo — mesmo padrao do errors-hint-all),
    // linha no formato sha256sum, UNREADABLE honesto em vez de hash falso.
    var modules = sbomModules()
    need(modules.size == 49, "falhou")
    need(modules.get(0) == "src/kofcloud/agent/Agent.kf", "falhou")
    need(modules.get(modules.size - 1) == "src/Main.kf", "falhou")
    need(sbomLine("a/b.kf", "") == "UNREADABLE  a/b.kf", "falhou")
    var line = sbomLine("a/b.kf", "conteudo")
    need(line == crypto.sha256("conteudo") + "  a/b.kf", "falhou")
    need(line.indexOf("  a/b.kf") >= 0, "falhou")
    var text = sbomText(listOf("a/b.kf", "c/d.kf"), listOf("x", ""))
    need(text.indexOf(crypto.sha256("x") + "  a/b.kf") >= 0, "falhou")
    need(text.indexOf("UNREADABLE  c/d.kf") >= 0, "falhou")
    // O hash e verificavel por fora: mesmo algoritmo do Tokens (sha256).
    var probe = File("src/kofcloud/model/Exposure.kf").readText()
    need(probe != null && probe.length > 0, "falhou")
    if (probe != null) {
        need(sbomLine("src/kofcloud/model/Exposure.kf", probe).startsWith(crypto.sha256(probe)), "falhou")
    }
}

test "text: limitacoes distinguem chunked de pedido e de resposta", "limits-docs" {
    // Trava do drift medido: docs/17-limitations.md dizia "chunked: nao
    // decodificado" sem dizer o lado — e a resposta E decodificada desde a
    // Fase 10 slice 2g (decodeChunked, prova em framing_test). Afirmacao so
    // do lado do pedido continua honesta; a do lado da resposta nao.
    var limits = readTextOr("docs/17-limitations.md", "")
    need(limits.length > 0, "falhou")
    var bullet = ""
    for (var line in limits.split("\n")) {
        if (line.startsWith("* `Transfer-Encoding` / chunked **no pedido**")) {
            bullet = line
        }
    }
    need(bullet.length > 0, "falhou")
    need(bullet.indexOf("**não decodificado**") < 0, "falhou")
    need(limits.indexOf("decodeChunked") >= 0, "falhou")
    need(limits.indexOf("`framing-chunked-unit`") >= 0, "falhou")
    var apis = readTextOr("docs/13-kof-apis.md", "")
    need(apis.indexOf("utils/decodeChunked") >= 0, "falhou")
    need(apis.indexOf("o que fica fora é o **streaming**") >= 0, "falhou")
}

test "text: breakdowns por tag da matriz U batem com os arquivos", "u-counts" {
    // Trava da coluna de suite do docs/15-tests.md (irma do status-counts,
    // que so trava o TOTAL por suite): quando a linha declara
    // "(N: `tag` ×n + ...)", o total N tem de bater com os `test "` reais
    // do arquivo e cada ×n com as ocorrencias de `, "tag"` nele. Os drifts
    // eram silenciosos (medido neste run: freeze-unit ×13 com 14 no
    // arquivo, rotate-all ×2 com 1, svcdevice-unit ×3 com 4, e o breakdown
    // do rotate omitindo uma tag — 5 contados contra 6 reais). Linhas sem
    // grupo "(N:" — total so ("(13 testes)"), subconjunto ("(1 teste:
    // tag)") e lista de tags — ficam fora por desenho: o total delas ja e
    // travado no status-counts. A soma do breakdown so e exigida quando
    // TODAS as pecas sao "tag ×n" (pecas nuas como `tag` sem × ou prosa
    // impossibilitam a soma); omitir uma tag contavel quebra pela soma.
    var matrix = readTextOr("docs/15-tests.md", "")
    need(matrix.length > 0, "falhou")
    var rows = 0
    var tagChecks = 0
    for (var line in matrix.split("\n")) {
        if (line.startsWith("| U") == false) {
            continue
        }
        var cells = tableCells(line)
        if (cells.length < 4) {
            continue
        }
        var suite = cells[3]
        var at = suite.indexOf("`tests/")
        if (at < 0) {
            continue
        }
        var nameStart = at + 7
        var nameEnd = suite.indexOf(".kf`", nameStart)
        if (nameEnd < 0) {
            continue
        }
        var path = suite.substring(nameStart, nameEnd + 3)
        // O grupo de contagem tem de vir logo apos a citacao e ser "(N:" —
        // "(13 testes)" e "(1 teste: tag)" nao sao breakdown; "(1xx..." em
        // prosa de cobertura tambem nao (digitos seguidos de letra).
        var cursor = suite.indexOf("(", nameEnd)
        if (cursor < 0) {
            continue
        }
        var digits = ""
        var j = cursor + 1
        while (j < suite.length && suite.charAt(j) >= 48 && suite.charAt(j) <= 57) {
            digits = digits + suite.charAt(j)
            j = j + 1
        }
        if (digits.length == 0 || j >= suite.length || suite.charAt(j) != 58) {
            continue
        }
        var close = suite.indexOf(")", j)
        if (close < 0) {
            continue
        }
        var src = readTextOr("tests/" + path, "")
        need(src.length > 0, "falhou")
        var declaredTotal = parseIntBounded(digits, -1, 100000)
        var realTotal = countTestDeclarations("tests/" + path)
        need(realTotal == declaredTotal, "falhou")
        rows = rows + 1
        var allCounted = true
        var sum = 0
        // O `split` do stdlib (Kof 0.8) trata o argumento como LITERAL —
        // `split("|")` divide em "|" e `split("+")` em "+" (medido: o
        // escape `\+` virou parte do separador e a peca inteira deixou de
        // ser dividida). Mesma licao do tableCells acima.
        var pieces = suite.substring(j + 1, close).split("+")
        for (var piece in pieces) {
            // Peca = tag entre crases + "×n" FORA delas
            // ("`freeze-unit` ×14"); peca sem crase (prosa) ou tag sem ×
            // ("`rotate`" nu) impossibilitam a soma: ficam fora (a soma so
            // vale quando todas as pecas sao contaveis).
            var t = piece.trim()
            if (t.startsWith("`") == false) {
                allCounted = false
                continue
            }
            var closingTick = t.indexOf("`", 1)
            if (closingTick < 0) {
                allCounted = false
                continue
            }
            var tag = t.substring(1, closingTick)
            var rest = t.substring(closingTick + 1).trim()
            if (rest.indexOf("×") < 0) {
                allCounted = false
                continue
            }
            // O numero esta no FIM da peca ("×14"; o espaco vem ANTES do ×,
            // nunca entre × e o numero). Caminhe do fim enquanto houver
            // digito ASCII e corte na borda: substring nunca cai dentro do
            // × multibyte — as duas semanticas de indexacao (caractere e
            // byte) dao o mesmo corte.
            var dEnd = rest.length
            var dStart = dEnd
            while (dStart > 0 && rest.charAt(dStart - 1) >= 48 && rest.charAt(dStart - 1) <= 57) {
                dStart = dStart - 1
            }
            if (dStart == dEnd) {
                allCounted = false
                continue
            }
            var n = parseIntBounded(rest.substring(dStart), -1, 100000)
            need(n >= 0, "falhou")
            var real = src.split(", \"" + tag + "\"").length - 1
            need(real == n, "falhou")
            sum = sum + n
            tagChecks = tagChecks + 1
        }
        if (allCounted) {
            need(sum == declaredTotal, "falhou")
        }
    }
    // Sanidade da propria trava: se o formato da coluna mudar e nada casar,
    // ela nao pode passar em silencio (mesma regra do status-counts). Pisos
    // proporcionais ao que a matriz tem hoje (26 breakdowns, 24 ×N).
    need(rows >= 20, "falhou")
    need(tagChecks >= 20, "falhou")
}

test "text: provas citadas no plano batem com os arquivos", "prova-counts" {
    // Irma da status-counts/u-counts para a PROSA do plano: cada
    // "Prova: tests/x.kf (N)" do 16-plan e um numero que ninguem conferia
    // — a mesma doenca que apodreceu os breakdowns da matriz (run do
    // u-counts achou 4 drifts, todos com o total do arquivo intacto).
    // Formas travadas: total puro "(N)" ou "(N:", total com substantivo
    // exato "(N testes...)" — "(3 servicos..." NAO e contagem de testes —
    // e peca "`tag` ×N" (mesma tecnica de contagem de tag do u-counts:
    // ocorrencias de `, "tag"`). Fora da trava POR DESENHO: parentese que
    // nao comeca em digito tem escopo de tag ("`daemon-os` ×4..." e peca
    // travada; "`doctor-tls`, 3 testes a mais" e delta historico), lista de
    // tags sem ×N e substantivo que nao e "testes".
    var plan = readTextOr("docs/16-plan.md", "")
    need(plan.length > 0, "falhou")
    var pos = 0
    var citations = 0
    var totalChecks = 0
    var pieceChecks = 0
    while (true) {
        var at = plan.indexOf("tests/", pos)
        if (at < 0) {
            break
        }
        var end = at + 6
        while (end < plan.length && plan.charAt(end) != 96 && plan.charAt(end) != 32 && plan.charAt(end) != 10) {
            end = end + 1
        }
        var name = plan.substring(at + 6, end)
        need(name.endsWith(".kf"), "falhou")
        need(name.indexOf("/") < 0, "falhou")
        var src = readTextOr("tests/" + name, "")
        need(src.length > 0, "falhou")
        citations = citations + 1
        pos = end + 1
        // O parentese opcional vem apos a crase de fechamento (e espacos).
        var j = end + 1
        while (j < plan.length && (plan.charAt(j) == 32 || plan.charAt(j) == 10 || plan.charAt(j) == 9)) {
            j = j + 1
        }
        if (j >= plan.length || plan.charAt(j) != 40) {
            continue
        }
        // Fecha com profundidade — a prosa tem paren aninhado real
        // (`if(!STATE.pronto)`) — e teto de tamanho.
        var depth = 0
        var close = -1
        var k = j
        while (k < plan.length && k < j + 400) {
            var c = plan.charAt(k)
            if (c == 40) {
                depth = depth + 1
            } else if (c == 41) {
                depth = depth - 1
                if (depth == 0) {
                    close = k
                    break
                }
            }
            k = k + 1
        }
        if (close < 0) {
            continue
        }
        var inner = plan.substring(j + 1, close)
        // Total: parente que COMECA em digito. "(N)" seco, "(N:" e
        // "(N testes..." (substantivo exato) sao contagem do arquivo.
        if (inner.length > 0 && inner.charAt(0) >= 48 && inner.charAt(0) <= 57) {
            var dEnd = 0
            while (dEnd < inner.length && inner.charAt(dEnd) >= 48 && inner.charAt(dEnd) <= 57) {
                dEnd = dEnd + 1
            }
            var rest = inner.substring(dEnd)
            var isTotal = rest.length == 0 || rest.startsWith(":") || rest.startsWith(" testes")
            if (isTotal) {
                var n = parseIntBounded(inner.substring(0, dEnd), -1, 1000000)
                var real = countTestDeclarations("tests/" + name)
                need(real == n, "falhou")
                totalChecks = totalChecks + 1
            }
        }
        // Pecas "`tag` ×N". split("×") remove o separador inteiro — nada de
        // indexar dentro do multibyte (mesma regra do u-counts).
        var parts = inner.split("×")
        var i2 = 1
        while (i2 < parts.length) {
            var prev = parts[i2 - 1]
            var cur = parts[i2]
            if (prev.length >= 2 && prev.charAt(prev.length - 1) == 32 && prev.charAt(prev.length - 2) == 96) {
                var tEnd = prev.length - 2
                var tStart = tEnd
                while (tStart > 0) {
                    var c3 = prev.charAt(tStart - 1)
                    if ((c3 >= 97 && c3 <= 122) || (c3 >= 48 && c3 <= 57) || c3 == 45) {
                        tStart = tStart - 1
                    } else {
                        break
                    }
                }
                if (tStart > 0 && prev.charAt(tStart - 1) == 96 && tEnd > tStart) {
                    var tag = prev.substring(tStart, tEnd)
                    var dEnd2 = 0
                    while (dEnd2 < cur.length && cur.charAt(dEnd2) >= 48 && cur.charAt(dEnd2) <= 57) {
                        dEnd2 = dEnd2 + 1
                    }
                    if (dEnd2 > 0) {
                        var n2 = parseIntBounded(cur.substring(0, dEnd2), -1, 100000)
                        var real2 = src.split(", \"" + tag + "\"").length - 1
                        need(real2 == n2, "falhou")
                        pieceChecks = pieceChecks + 1
                    }
                }
            }
            i2 = i2 + 1
        }
    }
    // Sanidade da propria trava: se o formato da prosa mudar e nada casar,
    // ela nao pode passar em silencio. Pisos proporcionais ao que o plano
    // tem hoje (104 citacoes, 33 totais, 4 pecas ×N).
    need(citations >= 90, "falhou")
    need(totalChecks >= 28, "falhou")
    need(pieceChecks >= 4, "falhou")
}

test "text: toda lacuna Lnn dos dois docs existe nos dois", "lacunas-docs" {
    // Duas listas dizem a MESMA coisa: a tabela do 17-limitations (L1–L15,
    // L18) e as seções `### Lnn` do 13-kof-apis (L1–L20). A L18 (caixa/
    // caractere/ternário/assert, medidos na trava dos controles) entrou só
    // no 17 — e a lacuna que já mordeu o código é a que mais precisa estar
    // no doc de APIs. Por isso a paridade é bidirecional, não "um contém o
    // outro".
    var limits = readTextOr("docs/17-limitations.md", "")
    var apis = readTextOr("docs/13-kof-apis.md", "")
    need(limits.length > 0 && apis.length > 0, "falhou")
    var inLimits = listOf<String>()
    for (var i = 1; i <= 25; i++) {
        var id = "L" + intToString(i)
        if (limits.indexOf("| " + id + " |") >= 0) {
            inLimits.add(id)
        }
    }
    var inApis = listOf<String>()
    for (var i = 1; i <= 25; i++) {
        var id = "L" + intToString(i)
        if (apis.indexOf("### " + id + " — ") >= 0) {
            inApis.add(id)
        }
    }
    // Sanidade: formato mudou e nada casou = falha, nunca verde por vazio.
    if (inLimits.size < 15) {
        throw "17-limitations com poucas lacunas: " + intToString(inLimits.size)
    }
    if (inApis.size < 15) {
        throw "13-kof-apis com poucas lacunas: " + intToString(inApis.size)
    }
    for (var id in inLimits) {
        if (inApis.contains(id) == false) {
            throw "lacuna no 17-limitations sem seção no 13-kof-apis: " + id
        }
    }
    for (var id in inApis) {
        if (inLimits.contains(id) == false) {
            throw "lacuna no 13-kof-apis fora da tabela do 17-limitations: " + id
        }
    }
    // A L18 é o caso concreto que motivou a trava: o contorno citado nos
    // dois docs é o mesmo (lista fechada + helper de rótulo).
    need(limits.indexOf("protocolWireLiterals") >= 0, "falhou")
    need(apis.indexOf("protocolWireLiterals") >= 0, "falhou")
}

test "http: TLS verificado so cede o loopback do control (Kof 0.8)", "http-tls-policy" {
    // O http.* do Kof 0.8 verifica TLS por padrao; o control plane em
    // loopback usa PEM autoassinado (F9) e recusaria a si mesmo. O opt-out
    // e por processo e a decisao e pura: so URL de control em loopback.
    need(applyHttpTlsPolicy("http://127.0.0.1:8080") == true, "127.0.0.1: opt-out")
    need(applyHttpTlsPolicy("https://127.0.0.1:8443") == true, "https loopback: opt-out")
    need(applyHttpTlsPolicy("http://localhost:8080") == true, "localhost: opt-out")
    need(applyHttpTlsPolicy("http://[::1]:8080") == true, "::1: opt-out")
    need(applyHttpTlsPolicy("https://cloud.example.com") == false, "control remoto: verificado")
    need(applyHttpTlsPolicy("http://10.0.0.5:8080") == false, "nao-loopback: verificado")
    need(applyHttpTlsPolicy("") == false, "vazio: verificado")
}

// A Hint cita o PREFIXO de uma credencial (`kfs_...`) como nome de argumento
// ou como "copie o kfs_ completo" — nunca um VALOR. Um valor de `kfs_`/`kfc_`
// tem dezenas de caracteres depois do prefixo; a Hint tem so `...`, `<` ou
// espaco/fim logo apos. Pura: a trava `hint-coverage` usa esta regra.
Bool hasCredentialValue(String hint) {
    var prefixes = listOf("kfs_", "kfc_")
    for (var prefix in prefixes) {
        var at = hint.indexOf(prefix)
        while (at >= 0) {
            var after = at + prefix.length
            if (after < hint.length) {
                var c = hint.charAt(after) as Int
                var okAfter = c == 46 || c == 60 || c == 62 || c == 32 || c == 41
                if (okAfter == false) {
                    return true
                }
            }
            at = hint.indexOf(prefix, after)
        }
    }
    return false
}

test "dica: erro do control plane tem acao humana por familia (KofCloud)", "hint-coverage" {
    // A Hint passa a ser o caminho do operador: cada codigo que o control
    // plane/Edge devolve nas rotas /v1 precisa dizer o que fazer. A trava
    // cobre TODOS os construtores do Errors.kf (fonte unica): um codigo
    // novo sem Hint quebra aqui, em vez de aparecer como erro cru na CLI.
    var src = readTextOr("src/kofcloud/model/Errors.kf", "")
    var codes = listOf<String>()
    var rest = src
    var at = rest.indexOf("return \"KCF")
    while (at >= 0) {
        var start = at + 8
        var end = rest.indexOf("\"", start)
        var code = rest.substring(start, end)
        if (code.indexOf(":") > 0) {
            code = code.substring(0, code.indexOf(":"))
        }
        if (codes.contains(code) == false) {
            codes.add(code)
        }
        rest = rest.substring(end)
        at = rest.indexOf("return \"KCF")
    }
    need(codes.size >= 40, "falhou")
    var missing = listOf<String>()
    for (var code in codes) {
        if (errHint(code + ": x").length == 0) {
            missing.add(code)
        }
    }
    if (missing.size > 0) {
        throw "codigos sem Hint: " + joinStrings(missing, ",")
    }
    // A dica nunca carrega um VALOR de credencial nem conteudo do cliente:
    // so o prefixo "kfs_..." como nome de ARGUMENTO e permitido (o `service
    // token revoke <nome> <kfs_...>`).
    for (var code in codes) {
        var hint = errHint(code + ": x")
        if (hasCredentialValue(hint)) {
            throw "hint com valor de credencial: " + code
        }
        if (hint.indexOf("password:") >= 0) {
            throw "hint ecoa senha: " + code
        }
    }
}

test "dica: regra de valor de credencial e estrita (pura)", "hint-coverage" {
    need(hasCredentialValue("copie o kfs_ab12cd34 completo") == true, "falhou")
    need(hasCredentialValue("token kfc_deadbeef0123") == true, "falhou")
    need(hasCredentialValue("use: service token revoke <nome> <kfs_...>") == false, "falhou")
    need(hasCredentialValue("o kfs_ completo do token-list") == false, "falhou")
    need(hasCredentialValue("prefixo kfs_") == false, "falhou")
    need(hasCredentialValue("sem credencial") == false, "falhou")
    need(hasCredentialValue("kfc_)") == false, "falhou")
}
