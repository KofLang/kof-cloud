// Fase 6 (slice 1) — dominio proprio: registro PENDING com instrucao CNAME,
// verificacao por DNS contra os destinos esperados do Edge, rota ativa so
// depois de VERIFIED. Sem TLS/SNI neste slice (documentado em 12-tls.md).

String domainErrOf(String response) {
    return mapField(json.decode<Map<String, String>>(bodyOf(response)), "error")
}

Bool domainCodeIs(String body, String code) {
    return body.indexOf(code) >= 0
}

// Sobe conta + device + servico PUBLIC e devolve "token|deviceId|serviceId".
String domainFixture(Int controlPort, String path) {
    var registry = Registry(path)
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")
    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    need(statusOf(created) == 200, "falhou")
    var accountToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var device = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(device)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    var published = httpPostJson(controlPort, "/v1/services", pubBody, accountToken)
    need(statusOf(published) == 200, "falhou")
    var serviceId = mapField(json.decode<Map<String, String>>(bodyOf(published)), "id")
    return accountToken + "|" + deviceId + "|" + serviceId
}

// Content-Length do cabecalho cru (0 quando ausente/ilegivel). Fragmento
// honesto de HTTP: o corpo destes POSTs sempre vem declarado pelo
// http.post do Kof, e o que a leitura espera e o que chegou pelo fio.
Int webhookContentLengthOf(String header) {
    var lines = header.split("\r\n")
    var i = 0
    while (i < lines.length) {
        var line = lines[i]
        var colon = line.indexOf(":")
        if (colon > 0 && line.substring(0, colon).trim().toLowerCase() == "content-length") {
            return parseIntSafe(line.substring(colon + 1).trim(), 0)
        }
        i = i + 1
    }
    return 0
}

// Le o pedido HTTP inteiro do receptor TCP cru: continua recebendo ate o
// corpo declarado chegar (segmentacao TCP e real, mesmo em loopback) ou o
// teto honesto de 64 leituras (um pedido desses e minusculo; teto nunca
// alcancado no feliz). Fecha sem pedido (sonda do waitForPort) devolve o
// que deu — "" entra no teste como conexao vazia e nao conta.
String readWebhookRequest(Conn conn) {
    var raw = ""
    var reads = 0
    var done = false
    while (reads < 64 && done == false) {
        reads = reads + 1
        var got = ""
        try {
            var bytes = conn.receive(8192)
            if (bytes.length > 0) {
                got = bytesToString(bytes)
            }
        } catch (String e) {
            done = true
        }
        if (got.length > 0) {
            raw = raw + got
        }
        var split = raw.indexOf("\r\n\r\n")
        if (split >= 0 && raw.length - split - 4 >= webhookContentLengthOf(raw.substring(0, split))) {
            done = true
        }
    }
    return raw
}

test "dominio: validacao de hostname externo", "domains" {
    need(validCustomHostname("api.example.com") == true, "falhou")
    need(validCustomHostname("www.loja.com.br") == true, "falhou")
    need(validCustomHostname("a.b.c.example.org") == true, "falhou")
    need(validCustomHostname("UPPER.EXAMPLE.COM") == true, "falhou")
    need(validCustomHostname("") == false, "falhou")
    need(validCustomHostname("localhost") == false, "falhou")
    need(validCustomHostname("127.0.0.1") == false, "falhou")
    need(validCustomHostname("1.2.3.4") == false, "falhou")
    need(validCustomHostname("api.example") == true, "falhou")
    need(validCustomHostname("api.e") == false, "falhou")
    need(validCustomHostname("api.example.c0m") == false, "falhou")
    need(validCustomHostname("site.mel.kofcloud.io") == false, "falhou")
    need(validCustomHostname("mel.kofcloud.io") == false, "falhou")
    // O APEX da plataforma tambem e zona reservada: o sufixo tem o ponto na
    // frente, entao "kofcloud.io" nao casava e passava como dominio externo —
    // uma conta podia registrar o proprio dominio da plataforma e, com a
    // borda entre os destinos esperados, disputa-lo (medido).
    need(validCustomHostname("kofcloud.io") == false, "falhou")
    need(validCustomHostname("KofCloud.IO") == false, "falhou")
    need(validCustomHostname("mykofcloud.io") == true, "falhou")
    need(validCustomHostname("api_example.com") == false, "falhou")
    need(validCustomHostname("api.example.com.") == false, "falhou")
    need(validCustomHostname("api..example.com") == false, "falhou")
    need(validCustomHostname("api.exa mple.com") == false, "falhou")
    need(validCustomHostname("-api.example.com") == false, "falhou")
    // kofcloudDomainSuffix delega em kofcloudDomain (fonte unica do dominio):
    // o sufixo reservado e sempre "." + dominio, nunca um segundo literal.
    need(kofcloudDomainSuffix() == "." + kofcloudDomain(), "falhou")
    need(kofcloudDomainSuffix() == ".kofcloud.io", "falhou")
}

test "dominio: registro e idempotencia no registry", "domains-reg" {
    var registry = Registry("/tmp/kofcloud-domreg-" + crypto.randomHex(4) + ".json")
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var ana = registry.createAccount("ana", "a@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")

    var first = registry.registerCustomDomain(mel.id, "API.Example.com", service.id)
    need(first.hostname == "api.example.com", "falhou")
    need(first.status == "PENDING", "falhou")

    var again = registry.registerCustomDomain(mel.id, "api.example.com", service.id)
    need(again.hostname == "api.example.com", "falhou")

    var badHost = ""
    try {
        registry.registerCustomDomain(mel.id, "site.mel.kofcloud.io", service.id)
    } catch (String e) {
        badHost = e
    }
    need(domainCodeIs(badHost, "KCF120"), "falhou")

    var badService = ""
    try {
        registry.registerCustomDomain(mel.id, "outro.example.com", "inexistente")
    } catch (String e) {
        badService = e
    }
    need(domainCodeIs(badService, "KCF041"), "falhou")

    var anaDevice = registry.registerDevice(ana, "nb", "pk")
    var anaService = registry.publishService(ana, anaDevice.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    var notYours = ""
    try {
        registry.registerCustomDomain(ana.id, "alheio.example.com", service.id)
    } catch (String e) {
        notYours = e
    }
    need(domainCodeIs(notYours, "KCF042"), "falhou")

    var taken = ""
    try {
        registry.registerCustomDomain(ana.id, "api.example.com", anaService.id)
    } catch (String e) {
        taken = e
    }
    need(domainCodeIs(taken, "KCF121"), "falhou")

    need(registry.removeCustomDomain(ana.id, "api.example.com") == false, "falhou")
    need(registry.customByHostname("api.example.com") != null, "falhou")
    need(registry.removeCustomDomain(mel.id, "api.example.com") == true, "falhou")
    need(registry.customByHostname("api.example.com") == null, "falhou")
}

test "dominio: DNS fora do Edge recusa a verificacao (KCF164)", "domains-verify" {
    var registry = Registry("/tmp/kofcloud-domext-" + crypto.randomHex(4) + ".json")
    registry.setEdgeHosts(listOf("203.0.113.10"))
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    registry.registerCustomDomain(mel.id, "api.example.com", service.id)

    // Chega ao Edge E a um IP de terceiro (registro antigo/CDN): antes virava
    // VERIFIED e parte dos clientes saia da plataforma (medido por sonda).
    var mixed = listOf<String>()
    mixed.add("203.0.113.10")
    mixed.add("198.51.100.7")
    need(registry.verifyCustomDomainWith(mel.id, "api.example.com", mixed) == "KCF164: hostname resolves outside this Edge", "falhou")
    var still = registry.customByHostname("api.example.com")
    need(still != null, "falhou")
    if (still != null) {
        need(still.status == "PENDING", "falhou")
    }

    // So o Edge (em qualquer ordem, repetido): verifica.
    var only = listOf<String>()
    only.add("198.51.100.7")
    only.add("203.0.113.10")
    need(registry.verifyCustomDomainWith(mel.id, "api.example.com", only) == "KCF164: hostname resolves outside this Edge", "falhou")
    var good = listOf<String>()
    good.add("203.0.113.10")
    good.add("203.0.113.10")
    need(registry.verifyCustomDomainWith(mel.id, "api.example.com", good) == "", "falhou")
    var done = registry.customByHostname("api.example.com")
    if (done != null) {
        need(done.status == "VERIFIED", "falhou")
    }

    // CNAME-only (sem endereco proprio na resposta): o resolver pode devolver
    // o nome do destino ou um host por nome — nada disso recusa.
    var other = registry.createAccount("ana", "a@e.com", "segredo")
    var otherDevice = registry.registerDevice(other, "nb", "pk")
    var otherService = registry.publishService(other, otherDevice.id, "blog", "127.0.0.1", 8081, "http", "PUBLIC", "", "")
    registry.registerCustomDomain(other.id, "blog.example.org", otherService.id)
    var cnameText = listOf<String>()
    cnameText.add("203.0.113.10")
    cnameText.add("site.mel.kofcloud.io")
    cnameText.add("edge-by-name.example.net")
    need(registry.verifyCustomDomainWith(other.id, "blog.example.org", cnameText) == "", "falhou")
}

test "dominio: IPv4 literal e host que nao e endereco", "domains-verify" {
    need(isIPv4Literal("203.0.113.10"), "falhou")
    need(isIPv4Literal("0.0.0.0") == true, "falhou")
    need(isIPv4Literal("255.255.255.255"), "falhou")
    need(isIPv4Literal("256.1.1.1") == false, "falhou")
    need(isIPv4Literal("1.2.3") == false, "falhou")
    need(isIPv4Literal("1.2.3.4.5") == false, "falhou")
    need(isIPv4Literal("1.2.3.4.com") == false, "falhou")
    need(isIPv4Literal("01.2.3.4") == false, "falhou")
    need(isIPv4Literal("1..3.4") == false, "falhou")
    need(isIPv4Literal("-1.2.3.4") == false, "falhou")
    need(isIPv4Literal("site.mel.kofcloud.io") == false, "falhou")
    need(validIPv4Octet("0"), "falhou")
    need(validIPv4Octet("00") == false, "falhou")

    var expected = listOf<String>()
    expected.add("203.0.113.10")
    expected.add("*.edge.example.net")
    var third = listOf<String>()
    third.add("198.51.100.7")
    need(domainResolvesOnlyToEdge(third, expected) == false, "falhou")
    var names = listOf<String>()
    names.add("site.mel.kofcloud.io")
    names.add("203.0.113.10")
    need(domainResolvesOnlyToEdge(names, expected), "falhou")
    need(customTargetIsExpected("edge1.edge.example.net", expected), "falhou")
    need(errHint(errDomainResolvesElsewhere()).indexOf("domain verify") >= 0, "falhou")
}

test "dominio: AAAA de terceiro recusa e IPv6 do Edge verifica (KCF164)", "domains-verify" {
    var registry = Registry("/tmp/kofcloud-domaaaa-" + crypto.randomHex(4) + ".json")
    registry.setEdgeHosts(listOf("203.0.113.10"))
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    registry.registerCustomDomain(mel.id, "api.example.com", service.id)

    // AAAA de terceiro ao lado do A do Edge: o cliente que seguir o AAAA
    // sai da plataforma — recusa (KCF164) e o registro fica PENDING.
    var mixed = listOf<String>()
    mixed.add("203.0.113.10")
    mixed.add("2001:db8::7")
    need(registry.verifyCustomDomainWith(mel.id, "api.example.com", mixed) == "KCF164: hostname resolves outside this Edge", "falhou")
    var pending = registry.customByHostname("api.example.com")
    need(pending != null, "falhou")
    if (pending != null) {
        need(pending.status == "PENDING", "falhou")
    }

    // IPv4 mapeado: mesmo host do Edge declarado em IPv4 — verifica.
    var mapped = listOf<String>()
    mapped.add("::ffff:203.0.113.10")
    need(registry.verifyCustomDomainWith(mel.id, "api.example.com", mapped) == "", "falhou")
    var verified = registry.customByHostname("api.example.com")
    if (verified != null) {
        need(verified.status == "VERIFIED", "falhou")
    }

    // Edge declarado em IPv6: o mesmo endereco escrito de outra forma
    // (comprimido vs expandido) e o mesmo destino — verifica.
    var registry6 = Registry("/tmp/kofcloud-domaaaa6-" + crypto.randomHex(4) + ".json")
    registry6.setEdgeHosts(listOf("2001:db8::10"))
    var ana = registry6.createAccount("ana", "a@e.com", "segredo")
    var device6 = registry6.registerDevice(ana, "nb", "pk")
    var service6 = registry6.publishService(ana, device6.id, "blog", "127.0.0.1", 8081, "http", "PUBLIC", "", "")
    registry6.registerCustomDomain(ana.id, "blog.example.org", service6.id)
    var expanded = listOf<String>()
    expanded.add("2001:db8:0:0:0:0:0:10")
    need(registry6.verifyCustomDomainWith(ana.id, "blog.example.org", expanded) == "", "falhou")
    // Edge anunciado em IPv4 e IPv6 ao mesmo tempo: o IPv6 de terceiro
    // continua recusando mesmo com o IPv4 do Edge na resposta.
    registry6.setEdgeHosts(listOf("203.0.113.10", "2001:db8::10"))
    var other6 = listOf<String>()
    other6.add("203.0.113.10")
    other6.add("2001:db8::11")
    need(registry6.verifyCustomDomainWith(ana.id, "blog.example.org", other6) == "KCF164: hostname resolves outside this Edge", "falhou")
}

test "dominio: literais IPv6 e comparacao numerica", "domains-verify" {
    need(isIPv6Literal("2001:db8::10"), "falhou")
    need(isIPv6Literal("2001:db8:0:0:0:0:0:10"), "falhou")
    need(isIPv6Literal("::1"), "falhou")
    need(isIPv6Literal("::"), "falhou")
    need(isIPv6Literal("2001:db8::"), "falhou")
    need(isIPv6Literal("1:2:3:4:5:6:1.2.3.4"), "falhou")
    need(isIPv6Literal("1:2:3:4:5:6:7") == false, "falhou")
    need(isIPv6Literal("1:2:3:4:5:6:7:8:9") == false, "falhou")
    need(isIPv6Literal("1::2::3") == false, "falhou")
    need(isIPv6Literal("2001:db8:::1") == false, "falhou")
    need(isIPv6Literal("2001:db8::10%eth0") == false, "falhou")
    need(isIPv6Literal("203.0.113.10") == false, "falhou")
    need(isIPv6Literal("site.mel.kofcloud.io") == false, "falhou")
    need(isIPv6Literal("2001:db8::10000") == false, "falhou")
    need(isIPv6Literal("2001:db8::10g") == false, "falhou")

    // Grupos numericos: 0x2001=8193, 0x0db8=3512, 0x0010=16.
    var groups = ipv6Groups("2001:db8::10")
    need(groups.size == 8, "falhou")
    need(groups.get(0) == 8193, "falhou")
    need(groups.get(1) == 3512, "falhou")
    need(groups.get(7) == 16, "falhou")
    need(ipv6SameGroups(ipv6Groups("2001:db8:0:0:0:0:0:10"), groups), "falhou")

    // O IPv4 mapeado traz o mesmo host do IPv4 puro.
    var mapped = ipv4MappedOctets("::ffff:203.0.113.10")
    need(mapped.size == 4, "falhou")
    need(mapped.get(0) == 203, "falhou")
    need(mapped.get(3) == 10, "falhou")
    need(ipv4MappedOctets("2001:db8::10").size == 0, "falhou")

    var expected = listOf<String>()
    expected.add("2001:db8::10")
    expected.add("203.0.113.10")
    var third = listOf<String>()
    third.add("2001:db8::7")
    need(domainResolvesOnlyToEdge(third, expected) == false, "falhou")
    var own = listOf<String>()
    own.add("2001:db8:0:0:0:0:0:10")
    need(domainResolvesOnlyToEdge(own, expected), "falhou")
    var mappedList = listOf<String>()
    mappedList.add("::ffff:203.0.113.10")
    need(domainResolvesOnlyToEdge(mappedList, expected), "falhou")
    var broken = listOf<String>()
    broken.add("2001:db8::10%eth0")
    need(domainResolvesOnlyToEdge(broken, expected) == false, "falhou")
}

test "dominio: verificacao contra destinos esperados (sem rede)", "domains-verify" {
    var registry = Registry("/tmp/kofcloud-domver-" + crypto.randomHex(4) + ".json")
    registry.setEdgeHosts(listOf("203.0.113.10", "edge-by-name.example.net"))
    need(registry.edgeHosts.size == 2, "falhou")
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    registry.registerCustomDomain(mel.id, "api.example.com", service.id)

    need(registry.verifyCustomDomainWith(mel.id, "api.example.com", listOf("198.51.100.7")) == "KCF124: hostname does not resolve to this Edge", "falhou")
    var pending = registry.customByHostname("api.example.com")
    need(pending != null, "falhou")
    if (pending != null) {
        need(pending.status == "PENDING", "falhou")
    }
    need(registry.verifyCustomDomainWith(mel.id, "nope.example.com", listOf("203.0.113.10")) == "KCF122: domain not found", "falhou")
    // Chega ao Edge E a outro IP: nao aprova (KCF164 — ver teste abaixo);
    // so o Edge sozinho (com repeticao) aprova.
    need(registry.verifyCustomDomainWith(mel.id, "api.example.com", listOf("198.51.100.7", "203.0.113.10")) == "KCF164: hostname resolves outside this Edge", "falhou")
    var both = listOf<String>()
    both.add("203.0.113.10")
    both.add("203.0.113.10")
    need(registry.verifyCustomDomainWith(mel.id, "api.example.com", both) == "", "falhou")
    var verified = registry.customByHostname("api.example.com")
    need(verified != null, "falhou")
    if (verified != null) {
        need(verified.status == "VERIFIED", "falhou")
    }
    need(registry.resolveRoute("api.example.com") != null, "falhou")

    need(registry.resolveRoute("api.example.com") != null, "falhou")
    need(registry.verifyCustomDomainWith("outra-conta", "api.example.com", listOf("203.0.113.10")) == "KCF122: domain not found", "falhou")
    need(registry.resolveRoute("api.example.com") != null, "falhou")

    registry.registerCustomDomain(mel.id, "nxd-12345.invalid", service.id)
    need(domainCodeIs(registry.verifyCustomDomain(mel.id, "nxd-12345.invalid"), "KCF124"), "falhou")
}

test "dominio: rota so ativa depois de VERIFIED; poda acompanha o servico", "domains-route" {
    var registry = Registry("/tmp/kofcloud-domrt-" + crypto.randomHex(4) + ".json")
    registry.setEdgeHosts(listOf("203.0.113.10"))
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    registry.registerCustomDomain(mel.id, "api.example.com", service.id)
    need(registry.resolveRoute("api.example.com") == null, "falhou")

    registry.verifyCustomDomainWith(mel.id, "api.example.com", listOf("203.0.113.10"))
    var routed = registry.resolveRoute("api.example.com")
    need(routed != null && routed.id == service.id, "falhou")

    registry.setServiceStatus(service.id, "OFFLINE")
    // Igual ao hostname nativo: a rota persiste no registry e quem corta o
    // trafego e o Edge front (503 KCF103) — ver hosts_test/statusIsRoutable.
    need(registry.resolveRoute("api.example.com") != null, "falhou")
    registry.setServiceStatus(service.id, "ONLINE")

    need(registry.removeCustomDomain(mel.id, "api.example.com") == true, "falhou")
    need(registry.resolveRoute("api.example.com") == null, "falhou")

    registry.registerCustomDomain(mel.id, "api.example.com", service.id)
    registry.verifyCustomDomainWith(mel.id, "api.example.com", listOf("203.0.113.10"))
    need(registry.resolveRoute("api.example.com") != null, "falhou")
    need(registry.revokeDevice(mel.id, device.id) == true, "falhou")
    need(registry.customByHostname("api.example.com") == null, "falhou")
    need(registry.resolveRoute("api.example.com") == null, "falhou")

    var reloaded = Registry("/tmp/kofcloud-domrt-reload-" + crypto.randomHex(4) + ".json")
    var mel2 = reloaded.createAccount("mel", "m@e.com", "segredo")
    var dev2 = reloaded.registerDevice(mel2, "nb", "pk")
    var svc2 = reloaded.publishService(mel2, dev2.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    reloaded.registerCustomDomain(mel2.id, "loja.example.com", svc2.id)
    need(reloaded.customByHostname("loja.example.com") != null, "falhou")
}

test "dominio: control plane registra, lista, verifica e remove", "domains-api" {
    var controlPort = 19530
    var joined = domainFixture(controlPort, "/tmp/kofcloud-domapi-" + crypto.randomHex(4) + ".json")
    var firstBar = joined.indexOf("|")
    var accountToken = joined.substring(0, firstBar)
    var rest = joined.substring(firstBar + 1)
    var serviceId = rest.substring(rest.indexOf("|") + 1)

    var badHost = httpPostJson(controlPort, "/v1/domains", "{\"hostname\":\"site.mel.kofcloud.io\",\"service\":\"site\"}", accountToken)
    need(statusOf(badHost) == 400, "falhou")
    need(domainCodeIs(domainErrOf(badHost), "KCF120"), "falhou")

    // Apex da plataforma: o mesmo 400 KCF120 da zona reservada. Antes passava
    // pela validacao (so `.kofcloud.io` casava) e a conta registrava o
    // proprio dominio da plataforma.
    var apex = httpPostJson(controlPort, "/v1/domains", "{\"hostname\":\"kofcloud.io\",\"service\":\"site\"}", accountToken)
    need(statusOf(apex) == 400, "falhou")
    need(domainCodeIs(domainErrOf(apex), "KCF120"), "falhou")

    var badService = httpPostJson(controlPort, "/v1/domains", "{\"hostname\":\"api.example.com\",\"service\":\"naosite\"}", accountToken)
    need(statusOf(badService) == 404, "falhou")
    need(domainCodeIs(domainErrOf(badService), "KCF122"), "falhou")

    var created = httpPostJson(controlPort, "/v1/domains", "{\"hostname\":\"api.example.com\",\"service\":\"site\"}", accountToken)
    need(statusOf(created) == 200, "falhou")
    var createdBody = json.decode<Map<String, String>>(bodyOf(created))
    need(mapField(createdBody, "status") == "PENDING", "falhou")
    need(mapField(createdBody, "instruction").indexOf("site.mel.kofcloud.io") >= 0, "falhou")

    var listed = httpGetRaw(controlPort, "/v1/domains", "127.0.0.1")
    need(statusOf(listed) == 401, "falhou")

    // Lista autenticada: wildcard + servico + custom PENDING; suspende o
    // servico e a lista continua mostrando (visibilidade nao e roteamento:
    // resolveRoute ja barra SUSPENDED); conta alheia nao ve nada da dona.
    var authed = httpGetToken(controlPort, "/v1/domains", accountToken)
    need(statusOf(authed) == 200, "falhou")
    var authedBody = bodyOf(authed)
    need(authedBody.indexOf("\"kind\":\"wildcard\"") >= 0, "falhou")
    need(authedBody.indexOf("\"kind\":\"service\"") >= 0, "falhou")
    need(authedBody.indexOf("\"kind\":\"custom\"") >= 0, "falhou")
    need(authedBody.indexOf("\"status\":\"PENDING\"") >= 0, "falhou")
    need(authedBody.indexOf("api.example.com") >= 0, "falhou")
    // O que a CLI decodifica: DomainEntry com status nos customs (o
    // domainListLine mostra PENDING/VERIFIED; wildcard/service sem status).
    var entries = json.decode<List<DomainEntry>>(authedBody)
    var customSeen = false
    for (var entry in entries) {
        if (entry.kind == "custom") {
            customSeen = true
            need(entry.hostname == "api.example.com", "falhou")
            need(entry.status == "PENDING", "falhou")
            need(entry.service == "site", "falhou")
            need(domainListLine(entry).indexOf("PENDING") >= 0, "falhou")
            need(customDomainsFor(entries, "site").size == 1, "falhou")
            need(customDomainsFor(entries, "outro").size == 0, "falhou")
        } else {
            need(entry.status == "", "falhou")
        }
    }
    need(customSeen, "falhou")
    var suspended = httpPostJson(controlPort, "/v1/services/suspend", "{\"serviceId\":\"" + serviceId + "\"}", accountToken)
    need(statusOf(suspended) == 200, "falhou")
    var relisted = bodyOf(httpGetToken(controlPort, "/v1/domains", accountToken))
    need(relisted.indexOf("\"kind\":\"service\"") >= 0, "falhou")
    need(relisted.indexOf("site.mel.kofcloud.io") >= 0, "falhou")
    var unsuspended = httpPostJson(controlPort, "/v1/services/unsuspend", "{\"serviceId\":\"" + serviceId + "\"}", accountToken)
    need(statusOf(unsuspended) == 200, "falhou")

    var again = httpPostJson(controlPort, "/v1/domains", "{\"hostname\":\"api.example.com\",\"service\":\"site\"}", accountToken)
    need(statusOf(again) == 200, "falhou")

    var anaCreated = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"ana\",\"email\":\"a@e.com\",\"password\":\"segredo\"}", "")
    var anaToken = mapField(json.decode<Map<String, String>>(bodyOf(anaCreated)), "token")
    var anaListed = bodyOf(httpGetToken(controlPort, "/v1/domains", anaToken))
    need(anaListed.indexOf("api.example.com") < 0, "falhou")
    need(anaListed.indexOf("site.mel.kofcloud.io") < 0, "falhou")
    var anaAttempt = httpPostJson(controlPort, "/v1/domains/verify", "{\"hostname\":\"api.example.com\"}", anaToken)
    need(statusOf(anaAttempt) == 404, "falhou")
    need(domainCodeIs(domainErrOf(anaAttempt), "KCF122"), "falhou")

    var removed = httpPostJson(controlPort, "/v1/domains/remove", "{\"hostname\":\"api.example.com\"}", anaToken)
    need(statusOf(removed) == 404, "falhou")

    var gone = httpPostJson(controlPort, "/v1/domains/remove", "{\"hostname\":\"api.example.com\"}", accountToken)
    need(statusOf(gone) == 200, "falhou")
    var goneAgain = httpPostJson(controlPort, "/v1/domains/remove", "{\"hostname\":\"api.example.com\"}", accountToken)
    need(statusOf(goneAgain) == 404, "falhou")
}

test "dominio: Edge serve o hostname proprio apos VERIFIED (tunel real)", "domains-e2e" {
    var localSvc = 19531
    var controlPort = 19532
    var tunnelPort = 19533
    var httpPort = 19534

    var app = web.app()
    app.get("/") { return "svc-custom" }
    var server = spawn { app.listen(localSvc) }
    need(waitForPort(localSvc, 60), "falhou")

    var path = "/tmp/kofcloud-dome2e-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    registry.setEdgeHosts(listOf("127.0.0.1"))
    var edgeState = EdgeState(registry)
    var edgeStop = "/tmp/kofcloud-dome2e-edge-" + crypto.randomHex(4) + ".txt"
    var agentStop = "/tmp/kofcloud-dome2e-agent-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    File(agentStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, "", edgeStop) }
    var httpTask = spawn { serveHttp(edgeState, httpPort, limitMaxBodyBytes(), edgeStop) }
    need(waitForPort(controlPort, 60), "falhou")
    need(waitForPort(tunnelPort, 60), "falhou")
    need(waitForPort(httpPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var account = json.decode<Map<String, String>>(bodyOf(created))
    var accountToken = mapField(account, "token")
    var accountId = mapField(account, "accountId")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pubkey\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"" + intToString(localSvc) + "\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    var published = httpPostJson(controlPort, "/v1/services", pubBody, accountToken)
    need(statusOf(published) == 200, "falhou")
    var serviceId = mapField(json.decode<Map<String, String>>(bodyOf(published)), "id")

    var registered = httpPostJson(controlPort, "/v1/domains", "{\"hostname\":\"shop.example.com\",\"service\":\"site\"}", accountToken)
    need(statusOf(registered) == 200, "falhou")
    // O que a CLI decodifica: DomainStatus completo nas duas pontas.
    var registeredStatus = json.decode<DomainStatus>(bodyOf(registered))
    need(registeredStatus.hostname == "shop.example.com", "falhou")
    need(registeredStatus.status == "PENDING", "falhou")
    need(registeredStatus.instruction.indexOf("site.mel.kofcloud.io") >= 0, "falhou")
    need(registeredStatus.verifiedAt == "", "falhou")

    need(registry.verifyCustomDomainWith(accountId, "shop.example.com", listOf("127.0.0.1")) == "", "falhou")

    var config = AgentConfig("http://127.0.0.1:" + intToString(controlPort), deviceId, accountId, accountToken, "", agentStop, "127.0.0.1", tunnelPort, 100)
    var agentTask = spawn { runAgent(config, true) }
    var online = false
    var attempts = 100
    while (attempts > 0 && online == false) {
        online = edgeState.isOnline(deviceId)
        if (online == false) {
            time.sleep(50)
            attempts = attempts - 1
        }
    }
    need(online, "falhou")

    var viaCustom = httpGetRaw(httpPort, "/", "shop.example.com")
    need(statusOf(viaCustom) == 200, "falhou")
    need(bodyOf(viaCustom) == "svc-custom", "falhou")
    var viaNative = httpGetRaw(httpPort, "/", "site.mel.kofcloud.io")
    need(bodyOf(viaNative) == "svc-custom", "falhou")

    writeTextTo(agentStop, "stop")
    time.sleep(1500)
    need(edgeState.isOnline(deviceId) == false, "falhou")
    writeTextTo(edgeStop, "stop")
    time.sleep(1000)
    File(agentStop).delete()
    File(edgeStop).delete()
}

test "dominio: Hint orienta o operador sem vazar nada", "domains-hint" {
    need(errHint("KCF120: invalid custom hostname").indexOf("kofcloud.io") >= 0, "falhou")
    need(errHint("KCF122: domain not found").indexOf("domain list") >= 0, "falhou")
    need(errHint("KCF124: hostname does not resolve to this Edge").indexOf("CNAME") >= 0, "falhou")
}

test "dominio: domainHttpStatus mapeia familia -> HTTP (trava pura)", "domains-status" {
    // Fonte unica do mapeamento que o domainError usa na borda: formato
    // 400, conflito 409, resto 404 opaco. Mudar um ramo sem atualizar a
    // trava quebra aqui de proposito (precedente: errors-publish-status).
    need(domainHttpStatus(errInvalidCustomHostname()) == 400, "falhou")
    need(domainHttpStatus(errDomainTaken()) == 409, "falhou")
    need(domainHttpStatus(errDomainNotFound()) == 404, "falhou")
    need(domainHttpStatus(errServiceNotYours()) == 404, "falhou")
    need(domainHttpStatus("KCF999: algo estranho") == 404, "falhou")
    // verifyDomainError responde o HTTP certo E o corpo certo: 404 reescreve
    // para KCF122 opaco (nunca vaza o detalhe), 409 repassa a falha (KCF124).
    var verifyGone = verifyDomainError(errDomainNotFound())
    need(verifyGone.code == 404, "falhou")
    need(verifyGone.body.indexOf("KCF122") >= 0, "falhou")
    var verifyDns = verifyDomainError(errDomainUnreachable())
    need(verifyDns.code == 409, "falhou")
    need(verifyDns.body.indexOf("KCF124") >= 0, "falhou")
}

test "dominio: serializadores puros sem rede", "domains-serial" {
    // customTargetFor + domainInstruction + domainJson/domainListJson, sem
    // rede nem HOME (precedente: token-serial). Monta conta/device/servico
    // no registry local e confere o que a API devolveria.
    var registry = Registry("/tmp/kofcloud-domserial-" + crypto.randomHex(4) + ".json")
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    var domain = registry.registerCustomDomain(mel.id, "api.example.com", service.id)
    // domainIsVerified delega no construtor (fonte unica do literal):
    // recem-registrado e PENDING, VERIFIED apos verify. O terceiro assert
    // amarra a delegacao: PENDING construido via domainPending() nunca passa
    // (se o predicado voltasse a comparar literal cru divergente, quebra).
    need(domainIsVerified(domain) == false, "falhou")
    need(domainIsVerified(CustomDomain("x.example.com", mel.id, service.id, domainVerified(), "", 1000)) == true, "falhou")
    need(domainIsVerified(CustomDomain("y.example.com", mel.id, service.id, domainPending(), "", 1000)) == false, "falhou")
    // Alvo: hostname nativo do servico; sem servico, vazio (sem throw).
    need(customTargetFor(domain, registry) == service.hostname, "falhou")
    var orphan = CustomDomain("solto.example.com", mel.id, "inexistente", domainPending(), "", 1000)
    need(customTargetFor(orphan, registry) == "", "falhou")
    // Instrucao CNAME aponta o externo para o nativo.
    var instruction = domainInstruction(domain, registry)
    need(instruction == "CNAME api.example.com -> " + service.hostname, "falhou")
    // JSON carrega hostname/status/alvo; lista envolve em colchetes.
    var oneJson = domainJson(domain, service.hostname)
    var oneBody = json.decode<Map<String, String>>(oneJson)
    need(mapField(oneBody, "hostname") == "api.example.com", "falhou")
    need(mapField(oneBody, "status") == "PENDING", "falhou")
    need(mapField(oneBody, "target") == service.hostname, "falhou")
    var items = listOf<CustomDomain>()
    items.add(domain)
    var listJson = domainListJson(items, registry)
    need(listJson.startsWith("[") && listJson.endsWith("]"), "falhou")
    need(listJson.indexOf("api.example.com") >= 0, "falhou")
    need(domainListJson(listOf<CustomDomain>(), registry) == "[]", "falhou")
    // Contrato (documentado em 06-control-protocol.md): ambos os handlers
    // emitem o DomainStatus completo (hostname+status+instruction+
    // verifiedAt) que a CLI decodifica — decode tipado com campo ausente
    // falha (JSN004). Chamados diretos: handlers puros (sem web.app).
    var token = registry.login("mel", "segredo")
    var registration = handleRegisterDomain(registry, token, "{\"hostname\":\"loja.example.com\",\"service\":\"site\"}")
    need(registration.code == 200, "falhou")
    var registered = json.decode<DomainStatus>(registration.body)
    need(registered.status == "PENDING", "falhou")
    need(registered.instruction.indexOf(service.hostname) >= 0, "falhou")
    need(registered.verifiedAt == "", "falhou")
    // verify sem DNS cai em KCF124 (409): o contrato de campos aparece no
    // caminho feliz do teste domains-verify; aqui o codigo basta.
    var verifyAttempt = handleVerifyDomain(registry, token, "{\"hostname\":\"loja.example.com\"}")
    need(verifyAttempt.code == 409, "falhou")
    need(verifyAttempt.body.indexOf("KCF124") >= 0, "falhou")
    // Caminho feliz sem rede: verifyCustomDomainWith injeta o DNS
    // (handleVerifyDomain sempre re-resolve via net.resolve real, entao o
    // feliz pelo handler exigiria rede — ver domains-verify). O registro
    // VERIFIED carrega verifiedAt; o handler emite os 4 campos (o feliz
    // pelo handler e coberto pelo e2e real abaixo).
    registry.setEdgeHosts(listOf("203.0.113.10"))
    need(registry.verifyCustomDomainWith(mel.id, "loja.example.com", listOf("203.0.113.10")) == "", "falhou")
    var verified = registry.customByHostname("loja.example.com")
    need(verified != null, "falhou")
    if (verified != null) {
        need(verified.status == "VERIFIED", "falhou")
        need(verified.verifiedAt.length > 0, "falhou")
        need(domainJson(verified, service.hostname).indexOf("VERIFIED") >= 0, "falhou")
    }
    // Webhook DNS generico (F18 s1): payload de fonte unica carrega os 4
    // campos e NUNCA o token; headers de fonte unica so levam Authorization
    // quando ha token (vazio ou so-espacos = receptor local sem auth).
    var whPayload = dnsWebhookPayload("api.example.com", "site", "edge.example.com")
    var whBody = json.decode<Map<String, String>>(whPayload)
    need(mapField(whBody, "action") == "create_cname", "falhou")
    need(mapField(whBody, "hostname") == "api.example.com", "falhou")
    need(mapField(whBody, "service") == "site", "falhou")
    need(mapField(whBody, "target") == "edge.example.com", "falhou")
    need(whPayload.indexOf("Bearer") < 0, "falhou")
    need(dnsWebhookHeaders("") == "Content-Type: application/json", "falhou")
    need(dnsWebhookHeaders("   ") == "Content-Type: application/json", "falhou")
    need(dnsWebhookHeaders("tk") == "Content-Type: application/json\nAuthorization: Bearer tk", "falhou")
}

test "dominio: webhook DNS entrega o pedido de criacao (receptor local)", "domains-dnswebhook" {
    // F18 s1: o receptor do operador recebe o POST com o payload de fonte
    // unica. Sem token, SEM Authorization; com token (via headers de fonte
    // unica — a CLI le o env que o teste nao pode setar), Bearer no fio.
    // Receptor fora = erro curto que a CLI converte em AVISO (o dominio
    // segue PENDING; nunca throw).
    var hookPort = 19990
    var received = listOf<String>()
    // Receptor TCP cru (mesmo padrao do fixture mudo do webhook): le o
    // pedido inteiro em bytes e responde 200 na mao. A sonda do waitForPort
    // conecta e fecha sem mandar nada — nao e pedido, nao conta, nao
    // responde. A leitura acumula ate o corpo declarado (teto honesto de 64
    // leituras contra segmentacao infinita).
    var hook = net.listen(hookPort)
    var listenerTask = spawn {
        var open = true
        while (open && received.size < 3) {
            try {
                var c = hook.accept()
                var raw = readWebhookRequest(c)
                if (raw.indexOf("\r\n\r\n") >= 0) {
                    received.add(raw)
                    c.send(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok"))
                }
                c.close()
            } catch (String e) {
                open = false
            }
        }
    }
    need(waitForPort(hookPort, 60), "falhou")

    var noToken = dnsWebhookDeliver("http://127.0.0.1:" + intToString(hookPort) + "/hook", dnsWebhookPayload("api.example.com", "site", "127.0.0.1"), dnsWebhookHeaders(""))
    need(noToken == "", "falhou")
    var withToken = dnsWebhookDeliver("http://127.0.0.1:" + intToString(hookPort) + "/hook", dnsWebhookPayload("loja.example.com", "site", "127.0.0.1"), dnsWebhookHeaders("segredo-teste-123"))
    need(withToken == "", "falhou")
    var withCustom = dnsWebhookDeliver("http://127.0.0.1:" + intToString(hookPort) + "/hook", dnsWebhookPayload("outra.example.com", "site", "127.0.0.1"), "Content-Type: application/json\nX-Probe: 1")
    need(withCustom == "", "falhou")
    var attempts = 60
    while (attempts > 0 && received.size < 3) {
        time.sleep(250)
        attempts = attempts - 1
    }
    need(received.size == 3, "falhou")
    if (received.size == 3) {
        var first = json.decode<Map<String, String>>(received.get(0).substring(received.get(0).indexOf("\r\n\r\n") + 4))
        need(mapField(first, "action") == "create_cname", "falhou")
        need(mapField(first, "hostname") == "api.example.com", "falhou")
        need(mapField(first, "service") == "site", "falhou")
        need(mapField(first, "target") == "127.0.0.1", "falhou")
        need(received.get(0).indexOf("Authorization") < 0, "falhou")
        need(received.get(0).indexOf("Bearer") < 0, "falhou")
        var second = received.get(1)
        need(second.indexOf("Authorization: Bearer segredo-teste-123") >= 0, "falhou")
        need(second.indexOf("\"hostname\":\"loja.example.com\"") >= 0, "falhou")
        need(received.get(2).indexOf("X-Probe: 1") >= 0, "falhou")
    }
    var refused = dnsWebhookDeliver("http://127.0.0.1:19999/hook", dnsWebhookPayload("x.example.com", "site", "127.0.0.1"), dnsWebhookHeaders(""))
    need(refused.length > 0, "falhou")
}

test "dominio: webhook DNS tem modo --dry-run honesto (puro + comando)", "domains-dnsdryrun" {
    // Regra da Fase 18: todo conector tem modo --dry-run. O texto mostra
    // EXATAMENTE o que seria enviado (mesmos headers de fonte unica) com o
    // valor do token NUNCA visivel — so a mascara; sem token, a ausencia e
    // nomeada. Sem url, a previa aponta o caminho manual em vez de inventar
    // POST vazio.
    var payload = dnsWebhookPayload("api.example.com", "site", "edge.example.io")
    var semToken = dnsWebhookPreview("http://127.0.0.1:19990/hook", payload, dnsWebhookHeaders(""), false)
    need(semToken.indexOf("dry-run: nada foi enviado e o dominio nao foi registrado") >= 0, "falhou")
    need(semToken.indexOf("POST http://127.0.0.1:19990/hook") >= 0, "falhou")
    need(semToken.indexOf("\"action\":\"create_cname\"") >= 0, "falhou")
    need(semToken.indexOf("\"target\":\"edge.example.io\"") >= 0, "falhou")
    need(semToken.indexOf("headers: Content-Type: application/json") >= 0, "falhou")
    need(semToken.indexOf("Authorization: Bearer") < 0, "falhou")
    need(semToken.indexOf("KOF_KOFCLOUD_DNS_WEBHOOK_TOKEN ausente") >= 0, "falhou")

    var comToken = dnsWebhookPreview("http://127.0.0.1:19990/hook", payload, dnsWebhookHeaders("segredo-vivo-456"), true)
    need(comToken.indexOf("Authorization: Bearer *** (KOF_KOFCLOUD_DNS_WEBHOOK_TOKEN)") >= 0, "falhou")
    need(comToken.indexOf("segredo-vivo-456") < 0, "falhou")
    need(comToken.indexOf("\"action\":\"create_cname\"") >= 0, "falhou")

    var semUrl = dnsWebhookPreview("", payload, dnsWebhookHeaders(""), false)
    need(semUrl.indexOf("sem --dns-webhook") >= 0, "falhou")
    need(semUrl.indexOf("POST") < 0, "falhou")

    // Comando com --dry-run: exit 0 SEM rede (receptor fora nao trava) e
    // SEM registrar dominio — se o caminho do dry-run tocasse o control
    // plane da sessao, o POST a /v1/domains falharia ou registraria.
    var priorSession = readTextOr(sessionPath(), "")
    saveSession(LocalSession("", "mel", "kfc_dryrun_probe", "http://127.0.0.1:1"))
    var rc = 99
    try {
        rc = cmdDomainAdd(listOf("api.example.com", "--service", "site", "--dns-webhook", "http://127.0.0.1:19999/hook", "--dry-run"))
    } finally {
        if (priorSession.length == 0) {
            File(sessionPath()).delete()
        } else {
            writeTextTo(sessionPath(), priorSession)
        }
    }
    need(rc == 0, "falhou")
    // Duplicada barra antes de qualquer efeito (mesmo padrao das booleanas).
    var dup = 99
    try {
        saveSession(LocalSession("", "mel", "kfc_dryrun_probe", "http://127.0.0.1:1"))
        dup = cmdDomainAdd(listOf("api.example.com", "--service", "site", "--dns-webhook", "http://127.0.0.1:19999/hook", "--dry-run", "--dry-run"))
    } finally {
        if (priorSession.length == 0) {
            File(sessionPath()).delete()
        } else {
            writeTextTo(sessionPath(), priorSession)
        }
    }
    need(dup == 1, "falhou")
}

test "dominio: certificado cobre hostname (puro, SAN/CN/curinga)", "domains-cert" {
    // Fase 6/9: `domain verify --tls-cert` recusa o PEM que nao cobre o
    // hostname ANTES de tocar a rede. Tudo puro sobre a saida do openssl.
    // Curinga segue RFC 6125: um rotulo so, nao o dominio base.
    need(certNameCovers("example.com", "example.com") == true, "falhou")
    need(certNameCovers("EXAMPLE.COM", " example.com ") == true, "falhou")
    need(certNameCovers("*.example.com", "api.example.com") == true, "falhou")
    need(certNameCovers("*.example.com", "example.com") == false, "falhou")
    need(certNameCovers("*.example.com", "a.api.example.com") == false, "falhou")
    need(certNameCovers("api.example.com", "www.example.com") == false, "falhou")
    need(certNameCovers("", "example.com") == false, "falhou")
    need(certNameCovers("api.example.com", "") == false, "falhou")

    // Saida real do `openssl x509 -noout -ext subjectAltName` (OpenSSL 3).
    var san = "X509v3 Subject Alternative Name: \n    DNS:example.com, DNS:www.example.com\n"
    var names = certSanNames(san)
    need(names.size == 2, "falhou")
    need(names.contains("example.com") && names.contains("www.example.com"), "falhou")
    need(certSanNames("No extensions in certificate").size == 0, "falhou")
    need(certSanNames("X509v3 Subject Alternative Name: \n    IP Address:10.0.0.1, email:a@b.c\n").size == 0, "falhou")
    need(certSanNames("DNS:*.example.com, DNS:*.example.com").size == 1, "falhou")
    need(certSanNames("X509v3 Subject Alternative Name: \n    DNS:*.Example.COM\n").get(0) == "*.example.com", "falhou")

    // CN nos dois formatos do openssl; vazio quando nao ha CN.
    need(certCommonName("subject=CN = example.com") == "example.com", "falhou")
    need(certCommonName("subject=/CN=legacy.example") == "legacy.example", "falhou")
    need(certCommonName("subject=O = Loja, CN = loja.example, C = BR") == "loja.example", "falhou")
    need(certCommonName("subject=O = Sem Nome") == "", "falhou")

    // Veredito: SAN manda; sem SAN cai no CN; openssl ausente nao inventa recusa.
    need(certHostVerdict("www.example.com", true, 0, san, "") == "", "falhou")
    need(certHostVerdict("outro.example.com", true, 0, san, "subject=CN = outro.example.com") != "", "falhou")
    need(certHostVerdict("legacy.example", true, 0, "No extensions in certificate", "subject=CN = legacy.example") == "", "falhou")
    need(certHostVerdict("nada.example", true, 1, "", "").indexOf("PEM valido") >= 0, "falhou")
    need(certHostVerdict("nada.example", false, 1, "", "").indexOf("nao encontrado") >= 0, "falhou")
    need(certHostVerdict("nada.example", true, -1, "", "") == "", "falhou")
    need(certHostVerdict("nada.example", true, 0, "No extensions in certificate", "subject=O = x").indexOf("sem SAN DNS nem CN") >= 0, "falhou")

    // Linha do comando: vazia sem PEM, FALHA bloqueia, aviso nao bloqueia.
    need(domainCertLine("", "www.example.com", true, 0, san, "", false) == "", "falhou")
    need(domainCertLine("/c.pem", "www.example.com", true, 0, san, "", false).startsWith("ok   tls"), "falhou")
    need(domainCertLine("/c.pem", "outro.example.com", true, 0, san, "", false).startsWith("FALHA tls"), "falhou")
    need(domainCertLine("/c.pem", "outro.example.com", true, 0, san, "", false).indexOf("outro.example.com") >= 0, "falhou")
    need(domainCertLine("/c.pem", "www.example.com", true, 0, san, "", true).indexOf("30 dias") >= 0, "falhou")
    need(domainCertLine("/c.pem", "www.example.com", true, -1, "", "", false).startsWith("aviso tls"), "falhou")
    // O conteudo do PEM nunca entra na linha: so o caminho e os nomes.
    need(domainCertLine("/c.pem", "www.example.com", true, 1, "", "", false).indexOf("BEGIN") < 0, "falhou")
    // Uso: a flag aparece no help e na mensagem de uso (regressao do help).
    need(usageText().indexOf("domain verify <hostname> [--tls-cert <pem>]") >= 0, "falhou")
    need(usoDomainVerifyLine().indexOf("--tls-cert") >= 0, "falhou")
    // Guardas fail-fast do cmdDomainVerify (puras, sem HOME nem rede).
    need(flagMissingValue(listOf("--tls-cert"), "--tls-cert") == true, "falhou")
    need(flagDuplicated(listOf("--tls-cert", "a", "--tls-cert", "b"), "--tls-cert") == true, "falhou")
}

test "dominio: domain verify --tls-cert com PEM real (openssl)", "domains-cert" {
    // Integracao real: o mesmo julgamento da linha, agora sobre a saida de
    // verdade do openssl. Pula quando openssl nao existe (precedente:
    // doctor-tls), sem transformar ausencia de ferramenta em falha.
    var dir = "/tmp/kofcloud-dom-cert-" + crypto.randomHex(4)
    var key = dir + "/k.pem"
    var cert = dir + "/c.pem"
    var bad = dir + "/bad.pem"
    var gen = process.run("sh", "-c", "mkdir -p " + dir + " && openssl req -x509 -newkey rsa:2048 -keyout " + key + " -out " + cert + " -days 365 -nodes -subj /CN=example.com -addext subjectAltName=DNS:example.com,DNS:*.loja.example 2>/dev/null && printf garbage > " + bad)
    if (gen.exitCode != 0) {
        need(true, "falhou")
        return
    }
    var san = process.run("openssl", "x509", "-in", cert, "-noout", "-ext", "subjectAltName").stdout
    var subject = process.run("openssl", "x509", "-in", cert, "-noout", "-subject").stdout
    need(certHostVerdict("example.com", true, 0, san, subject) == "", "falhou")
    need(certHostVerdict("api.loja.example", true, 0, san, subject) == "", "falhou")
    need(certHostVerdict("loja.example", true, 0, san, subject) != "", "falhou")
    need(certHostVerdict("outro.example", true, 0, san, subject) != "", "falhou")
    // A linha do comando sobre a saida real: ok quando cobre, FALHA quando nao.
    need(domainCertLine(cert, "example.com", true, 0, san, subject, false).startsWith("ok   tls"), "falhou")
    need(domainCertLine(cert, "outro.example", true, 0, san, subject, false).startsWith("FALHA tls"), "falhou")
    // O orquestrador (mesmo IO do comando) concorda com as duas pontas.
    need(domainTlsBlocks(cert, "example.com") == false, "falhou")
    need(domainTlsBlocks(cert, "outro.example") == true, "falhou")
    need(domainTlsBlocks(dir + "/nao-existe.pem", "example.com") == true, "falhou")
    // PEM real invalido: o openssl de verdade recusa (parse != 0).
    var parseBad = process.run("openssl", "x509", "-in", bad, "-noout").exitCode
    need(parseBad != 0, "falhou")
    need(certHostVerdict("example.com", true, parseBad, "", "").indexOf("PEM valido") >= 0, "falhou")
}

test "dominio: nome de servico ambiguo recusa em vez de escolher o primeiro", "domains-ambiguous" {
    // Medido: `handleRegisterDomain` usava `serviceByName`, que devolve o
    // PRIMEIRO match. Num estado legado (anterior ao KCF139) com o mesmo nome
    // em dois devices, `domain add --service site` vinculava o dominio ao
    // servico que a ordem da lista decidisse — o CNAME/rota apontaria para a
    // maquina errada em silencio. Agora recusa com 409 KCF140.
    var controlPort = 19555
    var path = "/tmp/kofcloud-domamb-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var d1 = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pk1\"}", token)
    var d2 = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"servidor\",\"publicKey\":\"pk2\"}", token)
    var dev1 = mapField(json.decode<Map<String, String>>(bodyOf(d1)), "deviceId")
    var dev2 = mapField(json.decode<Map<String, String>>(bodyOf(d2)), "deviceId")
    var pub1 = "{\"deviceId\":\"" + dev1 + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    need(statusOf(httpPostJson(controlPort, "/v1/services", pub1, token)) == 200, "falhou")

    // Homonimo injetado direto (estado anterior ao KCF139).
    var mel = registry.accountByHandle("mel")
    need(mel != null, "falhou")
    if (mel != null) {
        registry.services.add(Service("legacy-1", mel.id, dev2, "site", "127.0.0.1", 8081, "http", "site.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0L, "", "", ""))
        need(registry.servicesByName(mel.id, "site").size == 2, "falhou")
    }

    var ambiguous = httpPostJson(controlPort, "/v1/domains", "{\"hostname\":\"api.example.com\",\"service\":\"site\"}", token)
    need(statusOf(ambiguous) == 409, "falhou")
    need(domainCodeIs(domainErrOf(ambiguous), "KCF140"), "falhou")
    // Nada foi registrado.
    need(registry.customByHostname("api.example.com") == null, "falhou")
}
