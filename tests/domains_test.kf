// Fase 6 (slice 1) — dominio proprio: registro PENDING com instrucao CNAME,
// verificacao por DNS contra os destinos esperados do Edge, rota ativa so
// depois de VERIFIED. Sem TLS/SNI neste slice (documentado em 12-tls.md).

String domainErrOf(String response) {
    return mapField(json.decode<Map<String, String>>(bodyOf(response)), "error")
}

Bool domainCodeIs(String body, String code) {
    return body.indexOf(code) >= 0
}

// Sobe conta + device + servico PUBLIC e devolve "token|deviceId|serviceId".
String domainFixture(Int controlPort, String path) {
    var registry = Registry(path)
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control plane no ar")
    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    assert(statusOf(created) == 200, "conta criada")
    var accountToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var device = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(device)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    var published = httpPostJson(controlPort, "/v1/services", pubBody, accountToken)
    assert(statusOf(published) == 200, "servico publicado")
    var serviceId = mapField(json.decode<Map<String, String>>(bodyOf(published)), "id")
    return accountToken + "|" + deviceId + "|" + serviceId
}

test "dominio: validacao de hostname externo", "domains" {
    assert(validCustomHostname("api.example.com") == true, "dominio simples")
    assert(validCustomHostname("www.loja.com.br") == true, "multi-nivel")
    assert(validCustomHostname("a.b.c.example.org") == true, "subdominios")
    assert(validCustomHostname("UPPER.EXAMPLE.COM") == true, "maiuscula aceita (normaliza)")
    assert(validCustomHostname("") == false, "vazio")
    assert(validCustomHostname("localhost") == false, "sem TLD")
    assert(validCustomHostname("127.0.0.1") == false, "IP literal")
    assert(validCustomHostname("1.2.3.4") == false, "IP literal generico")
    assert(validCustomHostname("api.example") == true, "TLD longo de uma palavra e sintaticamente valido")
    assert(validCustomHostname("api.e") == false, "TLD de 1 letra")
    assert(validCustomHostname("api.example.c0m") == false, "digito no TLD")
    assert(validCustomHostname("site.mel.kofcloud.io") == false, "espaco kofcloud reservado")
    assert(validCustomHostname("mel.kofcloud.io") == false, "zona da conta reservada")
    assert(validCustomHostname("api_example.com") == false, "underscore")
    assert(validCustomHostname("api.example.com.") == false, "ponto final")
    assert(validCustomHostname("api..example.com") == false, "ponto duplo")
    assert(validCustomHostname("api.exa mple.com") == false, "espaco")
    assert(validCustomHostname("-api.example.com") == false, "hifen na ponta")
    // kofcloudDomainSuffix delega em kofcloudDomain (fonte unica do dominio):
    // o sufixo reservado e sempre "." + dominio, nunca um segundo literal.
    assert(kofcloudDomainSuffix() == "." + kofcloudDomain(), "sufixo deriva do dominio")
    assert(kofcloudDomainSuffix() == ".kofcloud.io", "sufixo travado")
}

test "dominio: registro e idempotencia no registry", "domains-reg" {
    var registry = Registry("/tmp/kofcloud-domreg-" + crypto.randomHex(4) + ".json")
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var ana = registry.createAccount("ana", "a@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")

    var first = registry.registerCustomDomain(mel.id, "API.Example.com", service.id)
    assert(first.hostname == "api.example.com", "normaliza minusculas")
    assert(first.status == "PENDING", "comeca pendente")

    var again = registry.registerCustomDomain(mel.id, "api.example.com", service.id)
    assert(again.hostname == "api.example.com", "idempotente: mesmo par")

    var badHost = ""
    try {
        registry.registerCustomDomain(mel.id, "site.mel.kofcloud.io", service.id)
    } catch (String e) {
        badHost = e
    }
    assert(domainCodeIs(badHost, "KCF120"), "KCF120 hostname reservado")

    var badService = ""
    try {
        registry.registerCustomDomain(mel.id, "outro.example.com", "inexistente")
    } catch (String e) {
        badService = e
    }
    assert(domainCodeIs(badService, "KCF041"), "KCF041 servico inexistente")

    var anaDevice = registry.registerDevice(ana, "nb", "pk")
    var anaService = registry.publishService(ana, anaDevice.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    var notYours = ""
    try {
        registry.registerCustomDomain(ana.id, "alheio.example.com", service.id)
    } catch (String e) {
        notYours = e
    }
    assert(domainCodeIs(notYours, "KCF042"), "KCF042 servico alheio")

    var taken = ""
    try {
        registry.registerCustomDomain(ana.id, "api.example.com", anaService.id)
    } catch (String e) {
        taken = e
    }
    assert(domainCodeIs(taken, "KCF121"), "KCF121 ja registrado")

    assert(registry.removeCustomDomain(ana.id, "api.example.com") == false, "alheio nao remove")
    assert(registry.customByHostname("api.example.com") != null, "registro intacto")
    assert(registry.removeCustomDomain(mel.id, "api.example.com") == true, "dona remove")
    assert(registry.customByHostname("api.example.com") == null, "sumiu")
}

test "dominio: verificacao contra destinos esperados (sem rede)", "domains-verify" {
    var registry = Registry("/tmp/kofcloud-domver-" + crypto.randomHex(4) + ".json")
    registry.setEdgeHosts(listOf("203.0.113.10", "edge-by-name.example.net"))
    assert(registry.edgeHosts.size == 2, "dois destinos")
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    registry.registerCustomDomain(mel.id, "api.example.com", service.id)

    assert(registry.verifyCustomDomainWith(mel.id, "api.example.com", listOf("198.51.100.7")) == "KCF124: hostname does not resolve to this Edge", "outro IP recusa")
    var pending = registry.customByHostname("api.example.com")
    assert(pending != null, "registro existe")
    if (pending != null) {
        assert(pending.status == "PENDING", "continua pendente")
    }
    assert(registry.verifyCustomDomainWith(mel.id, "nope.example.com", listOf("203.0.113.10")) == "KCF122: domain not found", "desconhecido -> KCF122")
    assert(registry.verifyCustomDomainWith(mel.id, "api.example.com", listOf("198.51.100.7", "203.0.113.10")) == "", "algum coincide aprova")
    var verified = registry.customByHostname("api.example.com")
    assert(verified != null, "registro existe")
    if (verified != null) {
        assert(verified.status == "VERIFIED", "vira VERIFIED")
    }
    assert(registry.resolveRoute("api.example.com") != null, "rota ativa apos verificar")

    assert(registry.resolveRoute("api.example.com") != null, "rota antes")
    assert(registry.verifyCustomDomainWith("outra-conta", "api.example.com", listOf("203.0.113.10")) == "KCF122: domain not found", "outra conta nao verifica")
    assert(registry.resolveRoute("api.example.com") != null, "rota intacta")

    registry.registerCustomDomain(mel.id, "nxd-12345.invalid", service.id)
    assert(domainCodeIs(registry.verifyCustomDomain(mel.id, "nxd-12345.invalid"), "KCF124"), "NXDOMAIN vira KCF124 (sem distinguir)")
}

test "dominio: rota so ativa depois de VERIFIED; poda acompanha o servico", "domains-route" {
    var registry = Registry("/tmp/kofcloud-domrt-" + crypto.randomHex(4) + ".json")
    registry.setEdgeHosts(listOf("203.0.113.10"))
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    registry.registerCustomDomain(mel.id, "api.example.com", service.id)
    assert(registry.resolveRoute("api.example.com") == null, "PENDING nao roteia")

    registry.verifyCustomDomainWith(mel.id, "api.example.com", listOf("203.0.113.10"))
    var routed = registry.resolveRoute("api.example.com")
    assert(routed != null && routed.id == service.id, "VERIFIED roteia o servico")

    registry.setServiceStatus(service.id, "OFFLINE")
    // Igual ao hostname nativo: a rota persiste no registry e quem corta o
    // trafego e o Edge front (503 KCF103) — ver hosts_test/statusIsRoutable.
    assert(registry.resolveRoute("api.example.com") != null, "OFFLINE mantem a rota (Edge responde 503)")
    registry.setServiceStatus(service.id, "ONLINE")

    assert(registry.removeCustomDomain(mel.id, "api.example.com") == true, "remove")
    assert(registry.resolveRoute("api.example.com") == null, "rota cai junto")

    registry.registerCustomDomain(mel.id, "api.example.com", service.id)
    registry.verifyCustomDomainWith(mel.id, "api.example.com", listOf("203.0.113.10"))
    assert(registry.resolveRoute("api.example.com") != null, "re-registra e verifica")
    assert(registry.revokeDevice(mel.id, device.id) == true, "revoga o dispositivo")
    assert(registry.customByHostname("api.example.com") == null, "poda acompanha a revogacao")
    assert(registry.resolveRoute("api.example.com") == null, "sem rota orfa")

    var reloaded = Registry("/tmp/kofcloud-domrt-reload-" + crypto.randomHex(4) + ".json")
    var mel2 = reloaded.createAccount("mel", "m@e.com", "segredo")
    var dev2 = reloaded.registerDevice(mel2, "nb", "pk")
    var svc2 = reloaded.publishService(mel2, dev2.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    reloaded.registerCustomDomain(mel2.id, "loja.example.com", svc2.id)
    assert(reloaded.customByHostname("loja.example.com") != null, "PENDING persiste")
}

test "dominio: control plane registra, lista, verifica e remove", "domains-api" {
    var controlPort = 19530
    var joined = domainFixture(controlPort, "/tmp/kofcloud-domapi-" + crypto.randomHex(4) + ".json")
    var firstBar = joined.indexOf("|")
    var accountToken = joined.substring(0, firstBar)
    var rest = joined.substring(firstBar + 1)
    var serviceId = rest.substring(rest.indexOf("|") + 1)

    var badHost = httpPostJson(controlPort, "/v1/domains", "{\"hostname\":\"site.mel.kofcloud.io\",\"service\":\"site\"}", accountToken)
    assert(statusOf(badHost) == 400, "reservado -> 400")
    assert(domainCodeIs(domainErrOf(badHost), "KCF120"), "KCF120")

    var badService = httpPostJson(controlPort, "/v1/domains", "{\"hostname\":\"api.example.com\",\"service\":\"naosite\"}", accountToken)
    assert(statusOf(badService) == 404, "servico inexistente -> 404")
    assert(domainCodeIs(domainErrOf(badService), "KCF122"), "KCF122 opaco")

    var created = httpPostJson(controlPort, "/v1/domains", "{\"hostname\":\"api.example.com\",\"service\":\"site\"}", accountToken)
    assert(statusOf(created) == 200, "registra")
    var createdBody = json.decode<Map<String, String>>(bodyOf(created))
    assert(mapField(createdBody, "status") == "PENDING", "pendente")
    assert(mapField(createdBody, "instruction").indexOf("site.mel.kofcloud.io") >= 0, "instrucao CNAME aponta o servico")

    var listed = httpGetRaw(controlPort, "/v1/domains", "127.0.0.1")
    assert(statusOf(listed) == 401, "listagem exige token")

    // Lista autenticada: wildcard + servico + custom PENDING; suspende o
    // servico e a lista continua mostrando (visibilidade nao e roteamento:
    // resolveRoute ja barra SUSPENDED); conta alheia nao ve nada da dona.
    var authed = httpGetToken(controlPort, "/v1/domains", accountToken)
    assert(statusOf(authed) == 200, "listagem com token")
    var authedBody = bodyOf(authed)
    assert(authedBody.indexOf("\"kind\":\"wildcard\"") >= 0, "wildcard listada")
    assert(authedBody.indexOf("\"kind\":\"service\"") >= 0, "servico listado")
    assert(authedBody.indexOf("\"kind\":\"custom\"") >= 0, "custom listado")
    assert(authedBody.indexOf("\"status\":\"PENDING\"") >= 0, "custom PENDING visivel")
    assert(authedBody.indexOf("api.example.com") >= 0, "hostname proprio visivel")
    // O que a CLI decodifica: DomainEntry com status nos customs (o
    // domainListLine mostra PENDING/VERIFIED; wildcard/service sem status).
    var entries = json.decode<List<DomainEntry>>(authedBody)
    var customSeen = false
    for (var entry in entries) {
        if (entry.kind == "custom") {
            customSeen = true
            assert(entry.hostname == "api.example.com", "custom certo")
            assert(entry.status == "PENDING", "custom com status")
            assert(entry.service == "site", "custom carrega o servico vinculado")
            assert(domainListLine(entry).indexOf("PENDING") >= 0, "linha mostra PENDING")
            assert(customDomainsFor(entries, "site").size == 1, "service status acharia este custom")
            assert(customDomainsFor(entries, "outro").size == 0, "outro servico nao pega")
        } else {
            assert(entry.status == "", "wildcard/service sem status")
        }
    }
    assert(customSeen, "custom na lista tipada")
    var suspended = httpPostJson(controlPort, "/v1/services/suspend", "{\"serviceId\":\"" + serviceId + "\"}", accountToken)
    assert(statusOf(suspended) == 200, "suspende o servico")
    var relisted = bodyOf(httpGetToken(controlPort, "/v1/domains", accountToken))
    assert(relisted.indexOf("\"kind\":\"service\"") >= 0, "suspenso continua listado")
    assert(relisted.indexOf("site.mel.kofcloud.io") >= 0, "hostname suspenso visivel")
    var unsuspended = httpPostJson(controlPort, "/v1/services/unsuspend", "{\"serviceId\":\"" + serviceId + "\"}", accountToken)
    assert(statusOf(unsuspended) == 200, "reverte o suspend")

    var again = httpPostJson(controlPort, "/v1/domains", "{\"hostname\":\"api.example.com\",\"service\":\"site\"}", accountToken)
    assert(statusOf(again) == 200, "re-registro idempotente")

    var anaCreated = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"ana\",\"email\":\"a@e.com\",\"password\":\"segredo\"}", "")
    var anaToken = mapField(json.decode<Map<String, String>>(bodyOf(anaCreated)), "token")
    var anaListed = bodyOf(httpGetToken(controlPort, "/v1/domains", anaToken))
    assert(anaListed.indexOf("api.example.com") < 0, "alheio nao ve o custom da dona")
    assert(anaListed.indexOf("site.mel.kofcloud.io") < 0, "alheio nao ve o servico da dona")
    var anaAttempt = httpPostJson(controlPort, "/v1/domains/verify", "{\"hostname\":\"api.example.com\"}", anaToken)
    assert(statusOf(anaAttempt) == 404, "outra conta nao verifica")
    assert(domainCodeIs(domainErrOf(anaAttempt), "KCF122"), "KCF122 opaco")

    var removed = httpPostJson(controlPort, "/v1/domains/remove", "{\"hostname\":\"api.example.com\"}", anaToken)
    assert(statusOf(removed) == 404, "outra conta nao remove")

    var gone = httpPostJson(controlPort, "/v1/domains/remove", "{\"hostname\":\"api.example.com\"}", accountToken)
    assert(statusOf(gone) == 200, "dona remove")
    var goneAgain = httpPostJson(controlPort, "/v1/domains/remove", "{\"hostname\":\"api.example.com\"}", accountToken)
    assert(statusOf(goneAgain) == 404, "remover de novo -> 404")
}

test "dominio: Edge serve o hostname proprio apos VERIFIED (tunel real)", "domains-e2e" {
    var localSvc = 19531
    var controlPort = 19532
    var tunnelPort = 19533
    var httpPort = 19534

    var app = web.app()
    app.get("/") { return "svc-custom" }
    var server = spawn { app.listen(localSvc) }
    assert(waitForPort(localSvc, 60), "servico local no ar")

    var path = "/tmp/kofcloud-dome2e-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    registry.setEdgeHosts(listOf("127.0.0.1"))
    var edgeState = EdgeState(registry)
    var edgeStop = "/tmp/kofcloud-dome2e-edge-" + crypto.randomHex(4) + ".txt"
    var agentStop = "/tmp/kofcloud-dome2e-agent-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    File(agentStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, "", edgeStop) }
    var httpTask = spawn { serveHttp(edgeState, httpPort, limitMaxBodyBytes(), edgeStop) }
    assert(waitForPort(controlPort, 60), "control no ar")
    assert(waitForPort(tunnelPort, 60), "tunel no ar")
    assert(waitForPort(httpPort, 60), "http no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var account = json.decode<Map<String, String>>(bodyOf(created))
    var accountToken = mapField(account, "token")
    var accountId = mapField(account, "accountId")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pubkey\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"" + intToString(localSvc) + "\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    var published = httpPostJson(controlPort, "/v1/services", pubBody, accountToken)
    assert(statusOf(published) == 200, "PUBLIC publicado")
    var serviceId = mapField(json.decode<Map<String, String>>(bodyOf(published)), "id")

    var registered = httpPostJson(controlPort, "/v1/domains", "{\"hostname\":\"shop.example.com\",\"service\":\"site\"}", accountToken)
    assert(statusOf(registered) == 200, "dominio registrado")
    // O que a CLI decodifica: DomainStatus completo nas duas pontas.
    var registeredStatus = json.decode<DomainStatus>(bodyOf(registered))
    assert(registeredStatus.hostname == "shop.example.com", "register hostname")
    assert(registeredStatus.status == "PENDING", "register PENDING")
    assert(registeredStatus.instruction.indexOf("site.mel.kofcloud.io") >= 0, "register instruction")
    assert(registeredStatus.verifiedAt == "", "register sem verifiedAt")

    assert(registry.verifyCustomDomainWith(accountId, "shop.example.com", listOf("127.0.0.1")) == "", "verificacao contra 127.0.0.1")

    var config = AgentConfig("http://127.0.0.1:" + intToString(controlPort), deviceId, accountId, accountToken, "", agentStop, "127.0.0.1", tunnelPort, 100)
    var agentTask = spawn { runAgent(config, true) }
    var online = false
    var attempts = 100
    while (attempts > 0 && online == false) {
        online = edgeState.isOnline(deviceId)
        if (online == false) {
            time.sleep(50)
            attempts = attempts - 1
        }
    }
    assert(online, "agent registrado no edge")

    var viaCustom = httpGetRaw(httpPort, "/", "shop.example.com")
    assert(statusOf(viaCustom) == 200, "hostname proprio roteia")
    assert(bodyOf(viaCustom) == "svc-custom", "corpo veio do servico local")
    var viaNative = httpGetRaw(httpPort, "/", "site.mel.kofcloud.io")
    assert(bodyOf(viaNative) == "svc-custom", "hostname nativo continua")

    writeTextTo(agentStop, "stop")
    time.sleep(1500)
    assert(edgeState.isOnline(deviceId) == false, "agente encerrou a sessao")
    writeTextTo(edgeStop, "stop")
    time.sleep(1000)
    File(agentStop).delete()
    File(edgeStop).delete()
}

test "dominio: Hint orienta o operador sem vazar nada", "domains-hint" {
    assert(errHint("KCF120: invalid custom hostname").indexOf("kofcloud.io") >= 0, "KCF120 orienta o formato")
    assert(errHint("KCF122: domain not found").indexOf("domain list") >= 0, "KCF122 aponta a lista")
    assert(errHint("KCF124: hostname does not resolve to this Edge").indexOf("CNAME") >= 0, "KCF124 sugere o CNAME")
}

test "dominio: domainHttpStatus mapeia familia -> HTTP (trava pura)", "domains-status" {
    // Fonte unica do mapeamento que o domainError usa na borda: formato
    // 400, conflito 409, resto 404 opaco. Mudar um ramo sem atualizar a
    // trava quebra aqui de proposito (precedente: errors-publish-status).
    assert(domainHttpStatus(errInvalidCustomHostname()) == 400, "KCF120 -> 400")
    assert(domainHttpStatus(errDomainTaken()) == 409, "KCF121 -> 409")
    assert(domainHttpStatus(errDomainNotFound()) == 404, "KCF122 -> 404 opaco")
    assert(domainHttpStatus(errServiceNotYours()) == 404, "KCF042 -> 404 opaco")
    assert(domainHttpStatus("KCF999: algo estranho") == 404, "desconhecido -> 404 opaco")
    // verifyDomainError responde o HTTP certo E o corpo certo: 404 reescreve
    // para KCF122 opaco (nunca vaza o detalhe), 409 repassa a falha (KCF124).
    var verifyGone = verifyDomainError(errDomainNotFound())
    assert(verifyGone.code == 404, "verify: KCF122 -> 404")
    assert(verifyGone.body.indexOf("KCF122") >= 0, "verify: 404 carrega KCF122 opaco")
    var verifyDns = verifyDomainError(errDomainUnreachable())
    assert(verifyDns.code == 409, "verify: KCF124 -> 409")
    assert(verifyDns.body.indexOf("KCF124") >= 0, "verify: 409 repassa KCF124")
}

test "dominio: serializadores puros sem rede", "domains-serial" {
    // customTargetFor + domainInstruction + domainJson/domainListJson, sem
    // rede nem HOME (precedente: token-serial). Monta conta/device/servico
    // no registry local e confere o que a API devolveria.
    var registry = Registry("/tmp/kofcloud-domserial-" + crypto.randomHex(4) + ".json")
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    var domain = registry.registerCustomDomain(mel.id, "api.example.com", service.id)
    // domainIsVerified delega no construtor (fonte unica do literal):
    // recem-registrado e PENDING, VERIFIED apos verify. O terceiro assert
    // amarra a delegacao: PENDING construido via domainPending() nunca passa
    // (se o predicado voltasse a comparar literal cru divergente, quebra).
    assert(domainIsVerified(domain) == false, "recem-registrado nao e verificado")
    assert(domainIsVerified(CustomDomain("x.example.com", mel.id, service.id, domainVerified(), "", 1000)) == true, "VERIFIED passa")
    assert(domainIsVerified(CustomDomain("y.example.com", mel.id, service.id, domainPending(), "", 1000)) == false, "PENDING construido nao passa")
    // Alvo: hostname nativo do servico; sem servico, vazio (sem throw).
    assert(customTargetFor(domain, registry) == service.hostname, "alvo e o hostname nativo")
    var orphan = CustomDomain("solto.example.com", mel.id, "inexistente", domainPending(), "", 1000)
    assert(customTargetFor(orphan, registry) == "", "sem servico, sem alvo")
    // Instrucao CNAME aponta o externo para o nativo.
    var instruction = domainInstruction(domain, registry)
    assert(instruction == "CNAME api.example.com -> " + service.hostname, "instrucao CNAME exata")
    // JSON carrega hostname/status/alvo; lista envolve em colchetes.
    var oneJson = domainJson(domain, service.hostname)
    var oneBody = json.decode<Map<String, String>>(oneJson)
    assert(mapField(oneBody, "hostname") == "api.example.com", "hostname no JSON")
    assert(mapField(oneBody, "status") == "PENDING", "PENDING no JSON")
    assert(mapField(oneBody, "target") == service.hostname, "alvo no JSON")
    var items = listOf<CustomDomain>()
    items.add(domain)
    var listJson = domainListJson(items, registry)
    assert(listJson.startsWith("[") && listJson.endsWith("]"), "lista entre colchetes")
    assert(listJson.indexOf("api.example.com") >= 0, "lista carrega o hostname")
    assert(domainListJson(listOf<CustomDomain>(), registry) == "[]", "vazia vira []")
    // Contrato (documentado em 06-control-protocol.md): ambos os handlers
    // emitem o DomainStatus completo (hostname+status+instruction+
    // verifiedAt) que a CLI decodifica — decode tipado com campo ausente
    // falha (JSN004). Chamados diretos: handlers puros (sem web.app).
    var token = registry.login("mel", "segredo")
    var registration = handleRegisterDomain(registry, token, "{\"hostname\":\"loja.example.com\",\"service\":\"site\"}")
    assert(registration.code == 200, "register 200")
    var registered = json.decode<DomainStatus>(registration.body)
    assert(registered.status == "PENDING", "register PENDING")
    assert(registered.instruction.indexOf(service.hostname) >= 0, "register carrega instruction")
    assert(registered.verifiedAt == "", "register sem verifiedAt")
    // verify sem DNS cai em KCF124 (409): o contrato de campos aparece no
    // caminho feliz do teste domains-verify; aqui o codigo basta.
    var verifyAttempt = handleVerifyDomain(registry, token, "{\"hostname\":\"loja.example.com\"}")
    assert(verifyAttempt.code == 409, "sem DNS: 409")
    assert(verifyAttempt.body.indexOf("KCF124") >= 0, "sem DNS: KCF124")
    // Caminho feliz sem rede: verifyCustomDomainWith injeta o DNS
    // (handleVerifyDomain sempre re-resolve via net.resolve real, entao o
    // feliz pelo handler exigiria rede — ver domains-verify). O registro
    // VERIFIED carrega verifiedAt; o handler emite os 4 campos (o feliz
    // pelo handler e coberto pelo e2e real abaixo).
    registry.setEdgeHosts(listOf("203.0.113.10"))
    assert(registry.verifyCustomDomainWith(mel.id, "loja.example.com", listOf("203.0.113.10")) == "", "DNS injetado aprova")
    var verified = registry.customByHostname("loja.example.com")
    assert(verified != null, "registro existe")
    if (verified != null) {
        assert(verified.status == "VERIFIED", "vira VERIFIED")
        assert(verified.verifiedAt.length > 0, "VERIFIED carrega verifiedAt")
        assert(domainJson(verified, service.hostname).indexOf("VERIFIED") >= 0, "inventario reflete VERIFIED")
    }
}

test "dominio: certificado cobre hostname (puro, SAN/CN/curinga)", "domains-cert" {
    // Fase 6/9: `domain verify --tls-cert` recusa o PEM que nao cobre o
    // hostname ANTES de tocar a rede. Tudo puro sobre a saida do openssl.
    // Curinga segue RFC 6125: um rotulo so, nao o dominio base.
    assert(certNameCovers("example.com", "example.com") == true, "igual cobre")
    assert(certNameCovers("EXAMPLE.COM", " example.com ") == true, "caixa e padding tolerados")
    assert(certNameCovers("*.example.com", "api.example.com") == true, "curinga cobre um rotulo")
    assert(certNameCovers("*.example.com", "example.com") == false, "curinga nao cobre o dominio base")
    assert(certNameCovers("*.example.com", "a.api.example.com") == false, "curinga nao cobre dois rotulos")
    assert(certNameCovers("api.example.com", "www.example.com") == false, "nome exato nao cobre outro")
    assert(certNameCovers("", "example.com") == false, "nome vazio nao cobre")
    assert(certNameCovers("api.example.com", "") == false, "hostname vazio nao cobre")

    // Saida real do `openssl x509 -noout -ext subjectAltName` (OpenSSL 3).
    var san = "X509v3 Subject Alternative Name: \n    DNS:example.com, DNS:www.example.com\n"
    var names = certSanNames(san)
    assert(names.size == 2, "dois nomes DNS")
    assert(names.contains("example.com") && names.contains("www.example.com"), "nomes aparados")
    assert(certSanNames("No extensions in certificate").size == 0, "sem extensao = lista vazia")
    assert(certSanNames("X509v3 Subject Alternative Name: \n    IP Address:10.0.0.1, email:a@b.c\n").size == 0, "IP/email ficam fora")
    assert(certSanNames("DNS:*.example.com, DNS:*.example.com").size == 1, "duplicata conta uma vez")
    assert(certSanNames("X509v3 Subject Alternative Name: \n    DNS:*.Example.COM\n").get(0) == "*.example.com", "san normaliza caixa")

    // CN nos dois formatos do openssl; vazio quando nao ha CN.
    assert(certCommonName("subject=CN = example.com") == "example.com", "formato OpenSSL 3")
    assert(certCommonName("subject=/CN=legacy.example") == "legacy.example", "formato OpenSSL 1.x")
    assert(certCommonName("subject=O = Loja, CN = loja.example, C = BR") == "loja.example", "CN no meio da linha")
    assert(certCommonName("subject=O = Sem Nome") == "", "sem CN = vazio")

    // Veredito: SAN manda; sem SAN cai no CN; openssl ausente nao inventa recusa.
    assert(certHostVerdict("www.example.com", true, 0, san, "") == "", "SAN cobre = sem motivo")
    assert(certHostVerdict("outro.example.com", true, 0, san, "subject=CN = outro.example.com") != "", "SAN presente ignora CN")
    assert(certHostVerdict("legacy.example", true, 0, "No extensions in certificate", "subject=CN = legacy.example") == "", "sem SAN usa CN")
    assert(certHostVerdict("nada.example", true, 1, "", "").indexOf("PEM valido") >= 0, "PEM invalido explica")
    assert(certHostVerdict("nada.example", false, 1, "", "").indexOf("nao encontrado") >= 0, "ausente explica")
    assert(certHostVerdict("nada.example", true, -1, "", "") == "", "openssl ausente = sem veredito")
    assert(certHostVerdict("nada.example", true, 0, "No extensions in certificate", "subject=O = x").indexOf("sem SAN DNS nem CN") >= 0, "sem nomes explica")

    // Linha do comando: vazia sem PEM, FALHA bloqueia, aviso nao bloqueia.
    assert(domainCertLine("", "www.example.com", true, 0, san, "", false) == "", "sem PEM = sem linha")
    assert(domainCertLine("/c.pem", "www.example.com", true, 0, san, "", false).startsWith("ok   tls"), "cobrindo = ok")
    assert(domainCertLine("/c.pem", "outro.example.com", true, 0, san, "", false).startsWith("FALHA tls"), "nao cobrindo = FALHA")
    assert(domainCertLine("/c.pem", "outro.example.com", true, 0, san, "", false).indexOf("outro.example.com") >= 0, "FALHA nomeia o hostname")
    assert(domainCertLine("/c.pem", "www.example.com", true, 0, san, "", true).indexOf("30 dias") >= 0, "expirando vira aviso na linha ok")
    assert(domainCertLine("/c.pem", "www.example.com", true, -1, "", "", false).startsWith("aviso tls"), "openssl ausente nao bloqueia")
    // O conteudo do PEM nunca entra na linha: so o caminho e os nomes.
    assert(domainCertLine("/c.pem", "www.example.com", true, 1, "", "", false).indexOf("BEGIN") < 0, "sem conteudo do PEM")
    // Uso: a flag aparece no help e na mensagem de uso (regressao do help).
    assert(usageText().indexOf("domain verify <hostname> [--tls-cert <pem>]") >= 0, "help anuncia --tls-cert")
    assert(usoDomainVerifyLine().indexOf("--tls-cert") >= 0, "uso anuncia --tls-cert")
    // Guardas fail-fast do cmdDomainVerify (puras, sem HOME nem rede).
    assert(flagMissingValue(listOf("--tls-cert"), "--tls-cert") == true, "cert solto barra")
    assert(flagDuplicated(listOf("--tls-cert", "a", "--tls-cert", "b"), "--tls-cert") == true, "cert repetido barra")
}

test "dominio: domain verify --tls-cert com PEM real (openssl)", "domains-cert" {
    // Integracao real: o mesmo julgamento da linha, agora sobre a saida de
    // verdade do openssl. Pula quando openssl nao existe (precedente:
    // doctor-tls), sem transformar ausencia de ferramenta em falha.
    var dir = "/tmp/kofcloud-dom-cert-" + crypto.randomHex(4)
    var key = dir + "/k.pem"
    var cert = dir + "/c.pem"
    var bad = dir + "/bad.pem"
    var gen = process.run("sh", "-c", "mkdir -p " + dir + " && openssl req -x509 -newkey rsa:2048 -keyout " + key + " -out " + cert + " -days 365 -nodes -subj /CN=example.com -addext subjectAltName=DNS:example.com,DNS:*.loja.example 2>/dev/null && printf garbage > " + bad)
    if (gen.exitCode != 0) {
        assert(true, "openssl ausente: pulando integracao")
        return
    }
    var san = process.run("openssl", "x509", "-in", cert, "-noout", "-ext", "subjectAltName").stdout
    var subject = process.run("openssl", "x509", "-in", cert, "-noout", "-subject").stdout
    assert(certHostVerdict("example.com", true, 0, san, subject) == "", "SAN exato aprova")
    assert(certHostVerdict("api.loja.example", true, 0, san, subject) == "", "curinga do PEM aprova um rotulo")
    assert(certHostVerdict("loja.example", true, 0, san, subject) != "", "curinga nao aprova o dominio base")
    assert(certHostVerdict("outro.example", true, 0, san, subject) != "", "hostname fora do PEM reprova")
    // A linha do comando sobre a saida real: ok quando cobre, FALHA quando nao.
    assert(domainCertLine(cert, "example.com", true, 0, san, subject, false).startsWith("ok   tls"), "linha ok com PEM real")
    assert(domainCertLine(cert, "outro.example", true, 0, san, subject, false).startsWith("FALHA tls"), "linha FALHA com PEM real")
    // O orquestrador (mesmo IO do comando) concorda com as duas pontas.
    assert(domainTlsBlocks(cert, "example.com") == false, "orquestrador aprova o que cobre")
    assert(domainTlsBlocks(cert, "outro.example") == true, "orquestrador reprova o que nao cobre")
    assert(domainTlsBlocks(dir + "/nao-existe.pem", "example.com") == true, "arquivo ausente reprova")
    // PEM real invalido: o openssl de verdade recusa (parse != 0).
    var parseBad = process.run("openssl", "x509", "-in", bad, "-noout").exitCode
    assert(parseBad != 0, "garbage nao parseia")
    assert(certHostVerdict("example.com", true, parseBad, "", "").indexOf("PEM valido") >= 0, "garbage reprova com motivo")
}

test "dominio: nome de servico ambiguo recusa em vez de escolher o primeiro", "domains-ambiguous" {
    // Medido: `handleRegisterDomain` usava `serviceByName`, que devolve o
    // PRIMEIRO match. Num estado legado (anterior ao KCF139) com o mesmo nome
    // em dois devices, `domain add --service site` vinculava o dominio ao
    // servico que a ordem da lista decidisse — o CNAME/rota apontaria para a
    // maquina errada em silencio. Agora recusa com 409 KCF140.
    var controlPort = 19555
    var path = "/tmp/kofcloud-domamb-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var d1 = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pk1\"}", token)
    var d2 = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"servidor\",\"publicKey\":\"pk2\"}", token)
    var dev1 = mapField(json.decode<Map<String, String>>(bodyOf(d1)), "deviceId")
    var dev2 = mapField(json.decode<Map<String, String>>(bodyOf(d2)), "deviceId")
    var pub1 = "{\"deviceId\":\"" + dev1 + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    assert(statusOf(httpPostJson(controlPort, "/v1/services", pub1, token)) == 200, "site no notebook")

    // Homonimo injetado direto (estado anterior ao KCF139).
    var mel = registry.accountByHandle("mel")
    assert(mel != null, "conta existe")
    if (mel != null) {
        registry.services.add(Service("legacy-1", mel.id, dev2, "site", "127.0.0.1", 8081, "http", "site.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0L, "", ""))
        assert(registry.servicesByName(mel.id, "site").size == 2, "dois homonimos no estado")
    }

    var ambiguous = httpPostJson(controlPort, "/v1/domains", "{\"hostname\":\"api.example.com\",\"service\":\"site\"}", token)
    assert(statusOf(ambiguous) == 409, "ambiguo -> 409: " + intToString(statusOf(ambiguous)))
    assert(domainCodeIs(domainErrOf(ambiguous), "KCF140"), "KCF140 no corpo")
    // Nada foi registrado.
    assert(registry.customByHostname("api.example.com") == null, "dominio nao criado")
}
