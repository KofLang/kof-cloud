import kofcloud.cli.Commands
import kofcloud.cli.Usage
import kofcloud.store.Store
import kofcloud.util.Text

// Trava do relatório de controles (Fase 19 slice 4 — meta SOC2-tipo-II):
// docs/CONTROLS.md mapeia cada controle 1:1 com o mecanismo e a prova. O doc
// apodrece como qualquer outro quando o código muda — aqui ele é lido do
// disco e conferido contra a árvore.

String controlsDoc() {
    return readTextOr("docs/CONTROLS.md", "")
}

// Citações `tests/<arquivo>.kf` do doc: só o nome do arquivo (a trava exige
// que ele exista em tests/). Puro.
List<String> controlsCitedSuites(String doc) {
    var out = listOf<String>()
    var rest = doc
    var mark = "`tests/"
    var at = rest.indexOf(mark)
    while (at >= 0) {
        var start = at + 1
        var end = rest.indexOf("`", start)
        if (end < 0) {
            break
        }
        var name = rest.substring(start, end)
        // Placeholder do próprio doc (`tests/<arquivo>.kf`, na seção de como
        // verificar) não é citação de suíte real.
        if (name.endsWith(".kf") && name.indexOf("<") < 0 && out.contains(name) == false) {
            out.add(name)
        }
        rest = rest.substring(end + 1)
        at = rest.indexOf(mark)
    }
    return out
}

// Seções de controle (`## CC…` / `## A…`) — a lista canônica que a trava
// exige presente. Ordem fixa para o doc não perder um controle em silêncio.
List<String> controlSections() {
    return listOf("## CC6.1 ", "## CC6.2 ", "## CC6.3 ", "## A1.2 ", "## A1.3 ", "## CC7.3 ", "## CC7.2 ", "## CC8.1 ")
}

test "controles: o relatório cita só suítes que existem", "docs-controls" {
    var doc = controlsDoc()
    assert(doc.length > 0, "docs/CONTROLS.md existe")
    var cited = controlsCitedSuites(doc)
    if (cited.size < 12) {
        assert(false, "o mapa cita as provas (>=12 suites): " + intToString(cited.size))
    }
    for (var name in cited) {
        // `readTextOr` resolve a partir da raiz do repo (o mesmo caminho que
        // o resto da suite usa); `File.exists` do stdlib nao aceita caminho
        // relativo aqui (medido: toda suite "faltava").
        if (readTextOr("tests/" + name, "MISSING").length == 0) {
            assert(false, "suíte citada existe: " + name)
        }
    }
}

test "controles: toda seção declara o limite (NÃO cobre)", "docs-controls" {
    var doc = controlsDoc()
    // Cada seção de controle começa em `## ` e vai até o próximo `## `.
    var sections = doc.split("\n## ")
    var found = 0
    for (var sec in sections) {
        if (sec.startsWith("CC") == false && sec.startsWith("A1") == false) {
            continue
        }
        found = found + 1
        assert(sec.indexOf("**Não cobre:**") >= 0, "seção sem o limite (Não cobre): " + sec.substring(0, 20))
    }
    assert(found == controlSections().size, "seções de controle: " + intToString(found) + " (esperado " + intToString(controlSections().size) + ")")
    for (var head in controlSections()) {
        assert(doc.indexOf("\n" + head) >= 0 || doc.startsWith(head.substring(3)), "controle presente: " + head)
    }
}


// A crase é o contrato: mecanismo é um identificador declarado no `src/`
// (classe/record/type/const, função, método, construtor), comando do help
// ou palavra do próprio texto. Ficam de fora arquivos/paths (`a/b.kf`, `a/b`),
// chaves e headers com ponto (`security.rateLimit`, `X-KofCloud-Token`),
// nomes de teste com hífen (`chain-unit`), flags (`--x`), trechos com `()` e
// literais de wire. Nada vira mecanismo por "parecer" um nome: ou o código
// declara, ou o help despacha.
// Literal de wire: `KCFnnn` ou valor exato da lista curta do protocolo
// (docs/07-tunnel-protocol.md). Lista, não regra de caixa: `toUpperCase`,
// `charAt` e `strings.isUpperCase` não se comportam como esperado no JVM
// deste toolchain (medido).
Bool isWireLiteral(String tok) {
    if (tok.startsWith("KCF")) {
        return true
    }
    return protocolWireLiterals().contains(tok)
}

List<String> protocolWireLiterals() {
    return listOf("AUTHENTICATED", "SUSPENDED", "ONLINE", "OFFLINE", "DEVICE_REVOKED",
        "REVOKED", "EXPIRED", "HELLO", "WELCOME", "OPENED", "RESET", "GOAWAY", "PING", "PONG")
}

List<String> controlsSymbols(String doc) {
    return controlsSymbolsWith(doc, sbomModules())
}

List<String> controlsSymbolsWith(String doc, List<String> modules) {
    var out = listOf<String>()
    var start = doc.indexOf("## CC6.1")
    if (start < 0) {
        return out
    }
    var rest = doc.substring(start)
    var at = rest.indexOf("`")
    while (at >= 0) {
        var end = rest.indexOf("`", at + 1)
        if (end < 0) {
            break
        }
        var tok = rest.substring(at + 1, end).trim()
        rest = rest.substring(end + 1)
        at = rest.indexOf("`")
        if (tok.length < 4) {
            continue
        }
        if (tok.indexOf(" ") >= 0 || tok.indexOf("##") >= 0 || tok.indexOf("**") >= 0) {
            continue
        }
        if (tok.indexOf("/") >= 0 || tok.indexOf(".") >= 0 || tok.indexOf("-") >= 0
            || tok.indexOf("(") >= 0 || tok.startsWith("--")) {
            continue
        }
        // `chain` é o nome do arquivo de prova; `kofdeps` é a metadata do
        // manifesto — lugares, não mecanismos.
        if (isWireLiteral(tok) || tok == "chain" || tok == "kofdeps") {
            continue
        }
        if (symbolDeclared(tok, modules) == false && usageText().indexOf("  " + tok) < 0) {
            continue
        }
        if (out.contains(tok)) {
            continue
        }
        out.add(tok)
    }
    return out
}

// Símbolo DECLARADO em algum fonte do `src/`: classe/record/type/const de
// modelo (`class Service`, `const X`), função top-level ou método
// (`[Mods] Tipo nome(`) e construtor de objeto (`Service(`). Comentário ou
// nome de flag com a mesma palavra não conta.
Bool symbolDeclared(String sym, List<String> modules) {
    var marker = " " + sym + "("
    for (var path in modules) {
        var body = readTextOr(path, "")
        if (body.indexOf("class " + sym) >= 0 || body.indexOf("record " + sym) >= 0
            || body.indexOf("type " + sym) >= 0 || body.indexOf("const " + sym) >= 0) {
            return true
        }
        if (body.indexOf(marker) >= 0) {
            return true
        }
    }
    return false
}

// `assert` puro só imprime "assertion failed"; este leva o rótulo junto
// (mesma forma do `assertTrue` de `kof.test`, que não é importável aqui).
Void assertWith(Bool cond, String label) {
    if (!cond) {
        throw "assertion failed: " + label
    }
}

// Símbolo presente em algum fonte (declaração, chamada ou import). A lista
// vem de `sbomModules()` (curada e travada pelo `audit-sbom`), então a
// varredura nunca "passa em vazio": módulo fora do SBOM quebra lá antes.
Bool symbolInSources(String sym, List<String> modules) {
    for (var path in modules) {
        var body = readTextOr(path, "")
        if (body.indexOf(sym) >= 0) {
            return true
        }
    }
    return false
}

test "controles: cada identificador em crase resolve para o código", "docs-controls" {
    var doc = controlsDoc()
    var modules = sbomModules()
    var symbols = controlsSymbolsWith(doc, modules)
    // Sanidade da extração (mesma regra do u-counts): formato mudou e nada
    // casou = falha de propósito, não verde. Falhas usam `assertWith`, que
    // leva a mensagem junto (`assert` puro só imprime "assertion failed").
    var tag = " (" + intToString(symbols.size) + " identificadores)"
    assertWith(symbols.size >= 12, "o mapa cita mecanismos" + tag)
    // Uma de cada classe da regra: classe, função com `_`, comando do help.
    assertWith(symbols.contains("EdgeState"), "extrai classe" + tag)
    assertWith(symbols.contains("serviceMaxBodyCap"), "extrai função com _" + tag)
    assertWith(symbols.contains("doctor"), "extrai comando do help" + tag)
    assertWith(symbolDeclared("doctor", modules) == false, "comando do help não é declarado em src/ (o filtro de help importa)")
    // Os filtros não podem engolir o mapa inteiro pelo caminho errado.
    assertWith(isWireLiteral("AUTHENTICATED") && isWireLiteral("KCF111"), "literal de wire e código de erro ficam fora")
    assertWith(isWireLiteral("EdgeState") == false, "regra de wire não come identificador")
    assertWith(symbolDeclared("worm", modules) == false, "palavra de comentário não é mecanismo")
    assertWith(symbolInSources("zz-not-a-symbol-zz", modules) == false, "sonda: a varredura percorre o src")
    // A regra de extração exige declaração no `src/`, então hoje a presença é
    // redundante; o laço fica como rede para quem afrouxar a regra (aceitar
    // nome por parecença) — aí um nome inexistente no mapa quebra aqui.
    var missing = ""
    for (var sym in symbols) {
        if (symbolInSources(sym, modules) == false) {
            missing = missing + " " + sym
        }
    }
    assertWith(missing.length == 0, "mecanismos citados existem no src/:" + missing + tag)
    // Comandos da plataforma citados no mapa: cada um aparece no help (a
    // fonte viva do que o binário despacha).
    var help = usageText()
    for (var cmd in listOf("scan", "state-backup")) {
        assertWith(doc.indexOf("kof cloud " + cmd) >= 0, "mapa cita o comando: kof cloud " + cmd)
        assertWith(help.indexOf("  " + cmd) >= 0, "comando existe no help: kof cloud " + cmd)
    }
}

test "controles: cada seção cita mecanismo real do repositório", "docs-controls" {
    var doc = controlsDoc()
    // Os mecanismos centrais que o mapa usa como âncora precisam existir no
    // código — renomear o módulo quebra aqui antes de o doc mentir.
    var anchors = listOf(
        "src/kofcloud/model/Audit.kf",
        "src/kofcloud/control/Registry.kf",
        "src/kofcloud/edge/EdgeState.kf",
        "src/kofcloud/cli/Deploy.kf",
        "src/kofcloud/model/Webhook.kf",
        "src/kofcloud/control/StatusPage.kf",
        "src/kofcloud/util/Text.kf"
    )
    for (var path in anchors) {
        assert(readTextOr(path, "").length > 0, "mecanismo citado existe: " + path)
    }
    // Honestidade: os limites declarados no mapa têm de espelhar os do
    // 17-limitations (WORM não imutável, um nó, sem MFA).
    assert(doc.indexOf("não é WORM real") >= 0, "admite WORM não imutável")
    assert(doc.indexOf("ponto único de falha") >= 0, "admite nó único")
    assert(doc.indexOf("não há MFA") >= 0, "admite ausência de MFA")
    var lim = readTextOr("docs/17-limitations.md", "")
    assert(lim.indexOf("imutável") >= 0, "17-limitations fala da imutabilidade")
}
