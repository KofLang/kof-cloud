import kofcloud.store.Store
import kofcloud.util.Text

// Trava do relatório de controles (Fase 19 slice 4 — meta SOC2-tipo-II):
// docs/CONTROLS.md mapeia cada controle 1:1 com o mecanismo e a prova. O doc
// apodrece como qualquer outro quando o código muda — aqui ele é lido do
// disco e conferido contra a árvore.

String controlsDoc() {
    return readTextOr("docs/CONTROLS.md", "")
}

// Citações `tests/<arquivo>.kf` do doc: só o nome do arquivo (a trava exige
// que ele exista em tests/). Puro.
List<String> controlsCitedSuites(String doc) {
    var out = listOf<String>()
    var rest = doc
    var mark = "`tests/"
    var at = rest.indexOf(mark)
    while (at >= 0) {
        var start = at + 1
        var end = rest.indexOf("`", start)
        if (end < 0) {
            break
        }
        var name = rest.substring(start, end)
        // Placeholder do próprio doc (`tests/<arquivo>.kf`, na seção de como
        // verificar) não é citação de suíte real.
        if (name.endsWith(".kf") && name.indexOf("<") < 0 && out.contains(name) == false) {
            out.add(name)
        }
        rest = rest.substring(end + 1)
        at = rest.indexOf(mark)
    }
    return out
}

// Seções de controle (`## CC…` / `## A…`) — a lista canônica que a trava
// exige presente. Ordem fixa para o doc não perder um controle em silêncio.
List<String> controlSections() {
    return listOf("## CC6.1 ", "## CC6.2 ", "## CC6.3 ", "## A1.2 ", "## A1.3 ", "## CC7.3 ", "## CC7.2 ", "## CC8.1 ")
}

test "controles: o relatório cita só suítes que existem", "docs-controls" {
    var doc = controlsDoc()
    assert(doc.length > 0, "docs/CONTROLS.md existe")
    var cited = controlsCitedSuites(doc)
    if (cited.size < 12) {
        assert(false, "o mapa cita as provas (>=12 suites): " + intToString(cited.size))
    }
    for (var name in cited) {
        // `readTextOr` resolve a partir da raiz do repo (o mesmo caminho que
        // o resto da suite usa); `File.exists` do stdlib nao aceita caminho
        // relativo aqui (medido: toda suite "faltava").
        if (readTextOr("tests/" + name, "MISSING").length == 0) {
            assert(false, "suíte citada existe: " + name)
        }
    }
}

test "controles: toda seção declara o limite (NÃO cobre)", "docs-controls" {
    var doc = controlsDoc()
    // Cada seção de controle começa em `## ` e vai até o próximo `## `.
    var sections = doc.split("\n## ")
    var found = 0
    for (var sec in sections) {
        if (sec.startsWith("CC") == false && sec.startsWith("A1") == false) {
            continue
        }
        found = found + 1
        assert(sec.indexOf("**Não cobre:**") >= 0, "seção sem o limite (Não cobre): " + sec.substring(0, 20))
    }
    assert(found == controlSections().size, "seções de controle: " + intToString(found) + " (esperado " + intToString(controlSections().size) + ")")
    for (var head in controlSections()) {
        assert(doc.indexOf("\n" + head) >= 0 || doc.startsWith(head.substring(3)), "controle presente: " + head)
    }
}

test "controles: cada seção cita mecanismo real do repositório", "docs-controls" {
    var doc = controlsDoc()
    // Os mecanismos centrais que o mapa usa como âncora precisam existir no
    // código — renomear o módulo quebra aqui antes de o doc mentir.
    var anchors = listOf(
        "src/kofcloud/model/Audit.kf",
        "src/kofcloud/control/Registry.kf",
        "src/kofcloud/edge/EdgeState.kf",
        "src/kofcloud/cli/Deploy.kf",
        "src/kofcloud/model/Webhook.kf",
        "src/kofcloud/control/StatusPage.kf",
        "src/kofcloud/util/Text.kf"
    )
    for (var path in anchors) {
        assert(readTextOr(path, "").length > 0, "mecanismo citado existe: " + path)
    }
    // Honestidade: os limites declarados no mapa têm de espelhar os do
    // 17-limitations (WORM não imutável, um nó, sem MFA).
    assert(doc.indexOf("não é WORM real") >= 0, "admite WORM não imutável")
    assert(doc.indexOf("ponto único de falha") >= 0, "admite nó único")
    assert(doc.indexOf("não há MFA") >= 0, "admite ausência de MFA")
    var lim = readTextOr("docs/17-limitations.md", "")
    assert(lim.indexOf("imutável") >= 0, "17-limitations fala da imutabilidade")
}
