import kofcloud.cli.Commands
import kofcloud.cli.Local
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.model.Device
import kofcloud.model.Service
import kofcloud.store.Store
import testkit.Support

// Origem do serviço no `service list` / `service status`.
//
// A conta pode ter vários dispositivos (limite default 5) e cada um serve os
// próprios serviços. A lista mostrava nome/hostname/exposição/status e nada
// sobre ONDE o serviço roda — responder "este site está no notebook ou no
// servidor?" exigia cruzar `device list` com o `deviceId` de cada serviço.

Device deviceFixture(String id, String name) {
    return Device(id, "acc", name, "pk", "ACTIVE", 0L, 0L)
}

Service serviceFixture(String name, String deviceId) {
    return Service("s-" + name, "acc", deviceId, name, "127.0.0.1", 8080, "http",
                   name + ".mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0L, "", "")
}

test "service list: rotulo do dispositivo resolve nome, cai no id e nunca some", "svcdevice-unit" {
    var devices = listOf(deviceFixture("dev-1", "notebook"), deviceFixture("dev-2", "servidor"))

    assert(deviceLabelFor(devices, "dev-1") == "notebook", "resolve nome")
    assert(deviceLabelFor(devices, "dev-2") == "servidor", "outro device")
    assert(deviceLabelFor(devices, "dev-apagado") == "dev-apagado", "device removido cai no id")
    assert(deviceLabelFor(listOf<Device>(), "dev-1") == "dev-1", "sem lista, id")
    assert(deviceLabelFor(devices, "") == "?", "sem deviceId nao vira vazio")

    var line = serviceListLine(serviceFixture("site", "dev-2"), devices)
    assert(line.indexOf("site") == 0, "comeca pelo nome")
    assert(line.indexOf("site.mel.kofcloud.io") >= 0, "hostname")
    assert(line.indexOf("PUBLIC") >= 0, "exposicao")
    assert(line.indexOf("device: servidor") >= 0, "diz onde roda")
}

test "service list: fim a fim mostra o device certo para cada servico", "svcdevice" {
    var controlPort = 20143
    var registry = Registry("/tmp/kofcloud-svcd-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control no ar")
    var url = "http://127.0.0.1:" + intToString(controlPort)

    var token = loginOrCreate(url, "mel", "segredo")
    var first = registerDevice(url, token, "notebook", "pk1")
    var second = registerDevice(url, token, "servidor", "pk2")

    var siteBody = "{\"deviceId\":\"" + first + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    var apiBody = "{\"deviceId\":\"" + second + "\",\"name\":\"api\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"3000\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    requireOk(http.post(url + "/v1/services", siteBody, jsonHeader(token)))
    requireOk(http.post(url + "/v1/services", apiBody, jsonHeader(token)))

    var devices = fetchDevices(url, token)
    assert(devices.size == 2, "dois dispositivos")
    var services = fetchServices(url, token)
    var siteLine = ""
    var apiLine = ""
    for (var service in services) {
        var line = serviceListLine(service, devices)
        if (service.name == "site") {
            siteLine = line
        }
        if (service.name == "api") {
            apiLine = line
        }
    }
    assert(siteLine.indexOf("device: notebook") >= 0, "site no notebook: " + siteLine)
    assert(apiLine.indexOf("device: servidor") >= 0, "api no servidor: " + apiLine)
    assert(siteLine.indexOf("servidor") < 0, "nao troca os devices")
}

test "status: lista de servicos usa a mesma linha do service list", "svcdevice-unit" {
    // `kof cloud status` imprimia nome/hostname/status sem o device — a
    // inconsistencia com o `service list` fazia o mesmo servico aparecer de
    // duas formas, uma sem dizer onde roda. Agora os dois usam
    // `serviceListLine` (mesma fonte da linha).
    var devices = listOf(deviceFixture("dev-1", "notebook"), deviceFixture("dev-2", "servidor"))
    var line = serviceListLine(serviceFixture("site", "dev-1"), devices)
    // A linha do status vem com dois espacos de recuo (prefixo "  "), mas o
    // conteudo e identico ao do service list.
    assert(("  " + line).indexOf("site") >= 0, "nome")
    assert(("  " + line).indexOf("https://site.mel.kofcloud.io") >= 0, "hostname")
    assert(("  " + line).indexOf("device: notebook") >= 0, "device incluido")
    // Sem a lista de devices, o rotulo cai no id (nunca some).
    var fallback = serviceListLine(serviceFixture("site", "dev-9"), listOf<Device>())
    assert(fallback.indexOf("device: dev-9") >= 0, "id no rotulo")
}

test "status/token: nome homonimo em estado legado recusa em vez de escolher", "svcdevice" {
    // A API barra homonimos novos (KCF139), mas um estado legado pode ter o
    // mesmo nome em 2 devices. `cmdServiceStatus` e `cmdServiceToken` faziam
    // busca propria e imprimiam/emiliam para o PRIMEIRO em silencio — o token
    // emitido daria acesso ao servico do OUTRO dispositivo. Agora usam o
    // mesmo `resolveServiceName` dos comandos de rotate/revoke: recusam
    // nomeando os devices.
    var controlPort = 20193
    var registry = Registry("/tmp/kofcloud-svcd-legacy-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control no ar")
    var url = "http://127.0.0.1:" + intToString(controlPort)

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var first = registerDevice(url, token, "notebook", "pk1")
    var second = registerDevice(url, token, "servidor", "pk2")
    requireOk(http.post(url + "/v1/services", "{\"deviceId\":\"" + first + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}", jsonHeader(token)))
    // Homonimo injetado direto (simula estado anterior ao KCF139).
    var mel = registry.accountByHandle("mel")
    var accountId = ""
    if (mel != null) {
        accountId = mel.id
    }
    registry.services.add(Service("legacy-1", accountId, second, "site", "127.0.0.1", 8081, "http", "site.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0L, "", ""))

    var services = fetchServices(url, token)
    var match = resolveServiceName(services, "site")
    assert(match.ambiguous, "homonimo detectado")
    assert(match.deviceIds.size == 2, "dois devices na lista")

    var prior = readTextOr(sessionPath(), "")
    saveSession(LocalSession("", "mel", token, url))
    var statusCode = cmdServiceStatus(listOf("site"))
    var tokenCode = cmdServiceToken(listOf("site"))
    if (prior.length == 0) {
        File(sessionPath()).delete()
    } else {
        writeTextTo(sessionPath(), prior)
    }
    assert(statusCode == 1, "status recusa homonimo")
    assert(tokenCode == 1, "token recusa homonimo")
}

test "service status: tunel do device e aviso de contradicao (puros)", "svcdevice-unit" {
    // O `Status:` do servico e o ultimo health reportado pelo Agent — uma
    // foto que pode estar velha. Sem a presenca real, um servico aparecia
    // ONLINE com o tunel caido: o site fora do ar e o operador lendo ONLINE.
    var presence = "[\"dev-1\"]"

    var online = serviceTunnelLine("dev-1", presence, "")
    assert(online.indexOf("ONLINE") >= 0, "device na presenca = ONLINE")
    assert(online.indexOf("device no ar") >= 0, "diz o que significa")

    var offline = serviceTunnelLine("dev-2", presence, "")
    assert(offline.indexOf("OFFLINE") >= 0, "device ausente = OFFLINE")
    assert(offline.indexOf("kof cloud connect") >= 0, "diz o proximo passo")

    // Falha na consulta nunca vira OFFLINE inventado.
    var unknown = serviceTunnelLine("dev-1", "", "falha de rede")
    assert(unknown.indexOf("desconhecido") >= 0, "erro = desconhecido")
    assert(unknown.indexOf("OFFLINE") < 0, "nao afirma offline")
    assert(unknown.indexOf("ONLINE") < 0, "nao afirma online")

    // Id vazio nunca casa por engano (bodyContainsId("") = false).
    assert(serviceTunnelLine("", "[\"\"]", "").indexOf("OFFLINE") >= 0, "id vazio nao casa")

    // Contradicao: health ONLINE + tunel OFFLINE = aviso explicito.
    var note = serviceReachabilityNote("ONLINE", false, true)
    assert(note.indexOf("Aviso") >= 0, "avisa a contradicao")
    assert(note.indexOf("fora do ar") >= 0, "diz o impacto")
    // Sem contradicao nao ha aviso.
    assert(serviceReachabilityNote("ONLINE", true, true) == "", "tunel vivo: sem aviso")
    assert(serviceReachabilityNote("ONLINE", false, false) == "", "presenca desconhecida: sem aviso")
    assert(serviceReachabilityNote("OFFLINE", false, true) == "", "ja diz OFFLINE: sem aviso")
    assert(serviceReachabilityNote("DEGRADED", false, true) == "", "degradado nao promete rota")
}

test "service status: cmdServiceStatus deriva o tunel da presenca (trava de fonte)", "svcdevice-unit" {
    // Sem captura de stdout, a unica forma de impedir a regressao (mostrar
    // so o health do Agent) e ler a fonte: o bloco precisa consultar
    // /v1/presence e delegar em `serviceTunnelLine`.
    var raw = File("src/kofcloud/cli/Commands.kf").readText()
    var text = ""
    if (raw != null) {
        text = raw
    }
    if (text.length == 0) {
        return
    }
    var start = text.indexOf("Int cmdServiceStatus(")
    var end = text.indexOf("Int cmdServiceSuspend(", start)
    if (end < 0) {
        end = text.length
    }
    var body = text.substring(start, end)
    assert(body.indexOf("/v1/presence") >= 0, "consulta a presenca real")
    assert(body.indexOf("serviceTunnelLine(") >= 0, "delega na funcao pura")
    assert(body.indexOf("serviceReachabilityNote(") >= 0, "avisa a contradicao")
}
