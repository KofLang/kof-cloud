import kofcloud.agent.Agent
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.edge.EdgeState
import kofcloud.edge.HttpFront
import kofcloud.edge.Tunnel
import kofcloud.model.Errors
import kofcloud.store.Store
import kofcloud.util.Text
import testkit.Support

// WAF slice 3 (Fase 10): allowlist de metodos/paths por servico.
// Declarada no publish; vazia = sem restricao (fail-closed so para quem
// declarou). Negacao no Edge: 403 KCF111 antes do relay.

test "allowlist: normaliza e valida metodos", "wafallow-unit" {
    need(normalizeAllowMethods("GET,POST", httpVerbs()) == "GET,POST", "falhou")
    need(normalizeAllowMethods(" GET , POST ", httpVerbs()) == "GET,POST", "falhou")
    need(normalizeAllowMethods("GET,GET", httpVerbs()) == "GET", "falhou")
    need(normalizeAllowMethods("get", httpVerbs()) == "", "falhou")
    need(normalizeAllowMethods("GET,,POST", httpVerbs()) == "", "falhou")
    need(normalizeAllowMethods("TRACE", httpVerbs()) == "", "falhou")
    need(normalizeAllowMethods("", httpVerbs()) == "", "falhou")
    need(errInvalidAllowMethod().indexOf("KCF113") >= 0, "falhou")
    need(errHint(errInvalidAllowMethod()).length > 0, "falhou")
}

test "allowlist: normaliza e valida paths", "wafallow-unit" {
    need(normalizeAllowPaths("/api/*,/health") == "/api/*,/health", "falhou")
    need(normalizeAllowPaths(" /api/* ") == "/api/*", "falhou")
    need(normalizeAllowPaths("/api/*,/api/*") == "/api/*", "falhou")
    need(normalizeAllowPaths("api/*") == "", "falhou")
    need(normalizeAllowPaths("/a b") == "", "falhou")
    need(normalizeAllowPaths("") == "", "falhou")
    need(errInvalidAllowPath().indexOf("KCF114") >= 0, "falhou")
    need(errHint(errInvalidAllowPath()).length > 0, "falhou")
}

test "allowlist: splitList reconstroi a lista salva", "wafallow-unit" {
    need(splitList("").size == 0, "falhou")
    need(splitList("GET,POST").size == 2, "falhou")
    need(splitList("GET").get(0) == "GET", "falhou")
}

test "allowlist: servico declarado barra metodo/path fora da lista (403 KCF111)", "wafallow" {
    var localSvc = 19841
    var controlPort = 19842
    var tunnelPort = 19843
    var httpPort = 19844

    var app = web.app()
    app.get("/api/users") { return "users" }
    app.get("/health") { return "ok" }
    var server = spawn { app.listen(localSvc) }
    need(waitForPort(localSvc, 60), "falhou")

    var registry = Registry("/tmp/kofcloud-allow-" + crypto.randomHex(4) + ".json")
    var edgeState = EdgeState(registry)
    var edgeStop = "/tmp/kofcloud-allow-edge-" + crypto.randomHex(4) + ".txt"
    var agentStop = "/tmp/kofcloud-allow-agent-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    File(agentStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, "", edgeStop) }
    var httpTask = spawn { serveHttp(edgeState, httpPort, 16777216, edgeStop) }
    need(waitForPort(controlPort, 60), "falhou")
    need(waitForPort(tunnelPort, 60), "falhou")
    need(waitForPort(httpPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var account = json.decode<Map<String, String>>(bodyOf(created))
    var accountToken = mapField(account, "token")
    var accountId = mapField(account, "accountId")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pubkey\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")

    // Politica malformada nao publica (400 com codigo estavel).
    var badBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"bad\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"" + intToString(localSvc) + "\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\",\"allowMethods\":\"get\"}"
    var bad = httpPostJson(controlPort, "/v1/services", badBody, accountToken)
    need(statusOf(bad) == 400, "falhou")
    need(bodyOf(bad).indexOf("KCF113") >= 0, "falhou")

    // Servico com allowlist.
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"api\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"" + intToString(localSvc) + "\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\",\"allowMethods\":\"GET\",\"allowPaths\":\"/api/*,/health\"}"
    var published = httpPostJson(controlPort, "/v1/services", pubBody, accountToken)
    need(statusOf(published) == 200, "falhou")
    need(bodyOf(published).indexOf("\"allowMethods\":\"GET\"") >= 0, "falhou")

    var config = AgentConfig("http://127.0.0.1:" + intToString(controlPort), deviceId, accountId, accountToken, "", agentStop, "127.0.0.1", tunnelPort, 100)
    var agentTask = spawn { runAgent(config, true) }
    var online = false
    var attempts = 100
    while (attempts > 0 && online == false) {
        online = edgeState.isOnline(deviceId)
        if (online == false) {
            time.sleep(50)
            attempts = attempts - 1
        }
    }
    need(online, "falhou")

    var host = "api.mel.kofcloud.io"
    var ok = httpGetRaw(httpPort, "/api/users", host)
    need(statusOf(ok) == 200, "falhou")
    need(bodyOf(ok) == "users", "falhou")
    need(statusOf(httpGetRaw(httpPort, "/health", host)) == 200, "falhou")

    // Traversal NAO fura a allowlist: `/api/../admin` casava o prefixo
    // `/api/*` mas o servico local normaliza para `/admin`. Agora 403.
    var traversal = httpGetRaw(httpPort, "/api/../admin", host)
    need(statusOf(traversal) == 403, "falhou")
    need(bodyOf(traversal).indexOf("KCF111") >= 0, "falhou")
    var traversalEnc = httpGetRaw(httpPort, "/api/..%2fadmin", host)
    need(statusOf(traversalEnc) == 403, "falhou")

    var wrongPath = httpGetRaw(httpPort, "/admin", host)
    need(statusOf(wrongPath) == 403, "falhou")
    need(bodyOf(wrongPath).indexOf("KCF111") >= 0, "falhou")
    need(responseHeader(wrongPath, "X-KofCloud-WAF") == "blocked", "falhou")

    var wrongMethod = httpPostRaw(httpPort, "/api/users", host, listOf<String>(), "{}")
    need(statusOf(wrongMethod) == 403, "falhou")
    need(bodyOf(wrongMethod).indexOf("KCF111") >= 0, "falhou")

    // Servico sem politica continua livre (fail-closed so para quem declarou).
    var freeBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"livre\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"" + intToString(localSvc) + "\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    need(statusOf(httpPostJson(controlPort, "/v1/services", freeBody, accountToken)) == 200, "falhou")
    need(statusOf(httpGetRaw(httpPort, "/admin", "livre.mel.kofcloud.io")) != 403, "falhou")

    // Parada limpa.
    writeTextTo(agentStop, "stop")
    time.sleep(1500)
    writeTextTo(edgeStop, "stop")
    time.sleep(1000)
    File(agentStop).delete()
    File(edgeStop).delete()
}

test "allowlist: path ambiguo nao casa o prefixo (traversal nao fura)", "wafallow-unit" {
    // Medido: a allowlist casava por PREFIXO cru, entao `/api/../admin`
    // casava `/api/*` — e o servico local normaliza para `/admin`, fora da
    // lista. A allowlist e fail-closed, entao nao pode decidir sobre um
    // caminho cujo destino depende de normalizacao.
    var paths = listOf("/api/*")
    var noMethods = listOf<String>()

    need(wafAllowCheck("GET", "/api/users", noMethods, paths) == true, "falhou")
    need(wafAllowCheck("GET", "/api/", noMethods, paths) == true, "falhou")
    need(wafAllowCheck("GET", "/api/users/123", noMethods, paths) == true, "falhou")
    need(wafAllowCheck("GET", "/api2/x", noMethods, paths) == false, "falhou")

    // Traversal cru e encoded, nos dois formatos de barra.
    need(wafAllowCheck("GET", "/api/../admin", noMethods, paths) == false, "falhou")
    need(wafAllowCheck("GET", "/api/..%2fadmin", noMethods, paths) == false, "falhou")
    need(wafAllowCheck("GET", "/api/%2e%2e/admin", noMethods, paths) == false, "falhou")
    need(wafAllowCheck("GET", "/api/..%5cadmin", noMethods, paths) == false, "falhou")
    need(wafAllowCheck("GET", "/api/..\\admin", noMethods, paths) == false, "falhou")
    need(wafAllowCheck("GET", "/api/./users", noMethods, paths) == false, "falhou")
    need(wafAllowCheck("GET", "//api/users", noMethods, paths) == false, "falhou")

    // Servico SEM allowlist continua livre (o guarda so vale para quem
    // declarou — fail-closed nao pode virar bloqueio universal).
    need(wafAllowCheck("GET", "/api/../admin", noMethods, listOf<String>()) == true, "falhou")
    // Metodo sozinho (sem allowPaths) nao ganha a regra de path.
    need(wafAllowCheck("GET", "/qualquer/../x", listOf("GET"), listOf<String>()) == true, "falhou")

    // O predicado e a fonte unica: segmentos normais nao sao ambiguos.
    need(pathHasAmbiguousSegment("/api/users") == false, "falhou")
    need(pathHasAmbiguousSegment("/api/v1.2/x") == false, "falhou")
    need(pathHasAmbiguousSegment("/api/..") == true, "falhou")
    need(pathHasAmbiguousSegment("/.well-known/security.txt") == false, "falhou")
}
