import kofcloud.agent.Agent
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.edge.EdgeState
import kofcloud.edge.HttpFront
import kofcloud.edge.Http
import kofcloud.edge.Tunnel
import kofcloud.model.Errors
import kofcloud.store.Store
import kofcloud.util.Limits
import testkit.Support

// WAF slice 2 (Fase 10): teto de corpo de requisicao por servico.
// O Edge recusa ANTES do relay (nao consome stream, nao toca no Agent) quando
// o Content-Length declarado passa de `kofcloud.limits.httpBodyBytes`.

test "waf corpo: limite default do config e positivo", "wafbody-unit" {
    assert(limitHttpBodyBytes() > 0, "teto positivo")
    assert(errBodyTooLarge().indexOf("KCF110") >= 0, "codigo KCF110")
    assert(errHint(errBodyTooLarge()).length > 0, "tem Hint")
}

test "waf corpo: Content-Length acima do teto e 413 KCF110 antes do relay", "wafbody" {
    var localSvc = 19661
    var controlPort = 19662
    var tunnelPort = 19663
    var httpPort = 19664
    var bodyCap = 64

    var app = web.app()
    app.get("/") { return "svc-waf" }
    app.post("/echo") { return "echo:" + body() }
    var server = spawn { app.listen(localSvc) }
    assert(waitForPort(localSvc, 60), "servico local no ar")

    var registry = Registry("/tmp/kofcloud-waf-" + crypto.randomHex(4) + ".json")
    var edgeState = EdgeState(registry)
    edgeState.setBodyLimit(bodyCap)
    var edgeStop = "/tmp/kofcloud-waf-edge-" + crypto.randomHex(4) + ".txt"
    var agentStop = "/tmp/kofcloud-waf-agent-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    File(agentStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, "", edgeStop) }
    var httpTask = spawn { serveHttp(edgeState, httpPort, 16777216, edgeStop) }
    assert(waitForPort(controlPort, 60), "control no ar")
    assert(waitForPort(tunnelPort, 60), "tunel no ar")
    assert(waitForPort(httpPort, 60), "http no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var account = json.decode<Map<String, String>>(bodyOf(created))
    var accountToken = mapField(account, "token")
    var accountId = mapField(account, "accountId")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pubkey\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"" + intToString(localSvc) + "\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    assert(statusOf(httpPostJson(controlPort, "/v1/services", pubBody, accountToken)) == 200, "PUBLIC publicado")

    var config = AgentConfig("http://127.0.0.1:" + intToString(controlPort), deviceId, accountId, accountToken, "", agentStop, "127.0.0.1", tunnelPort, 100)
    var agentTask = spawn { runAgent(config, true) }
    var online = false
    var attempts = 100
    while (attempts > 0 && online == false) {
        online = edgeState.isOnline(deviceId)
        if (online == false) {
            time.sleep(50)
            attempts = attempts - 1
        }
    }
    assert(online, "agent online")

    var host = "site.mel.kofcloud.io"
    assert(bodyOf(httpGetRaw(httpPort, "/", host)) == "svc-waf", "GET segue funcionando")

    // Corpo acima do teto: 413 no Edge, com codigo estavel.
    var bigBody = ""
    var i = 0
    while (i < bodyCap + 10) {
        bigBody = bigBody + "x"
        i = i + 1
    }
    var tooBig = httpPostRaw(httpPort, "/echo", host, listOf<String>(), bigBody)
    assert(statusOf(tooBig) == 413, "acima do teto -> 413")
    assert(bodyOf(tooBig).indexOf("KCF110") >= 0, "KCF110 no corpo")

    // Metrica com motivo proprio (sem dado do cliente).
    assert(metricValue(observability.metrics(), "kofcloud_edge_http_denied_total_body_too_large") >= 1, "recusa contada")

    // Logo no limite (nao acima): passa pelo Edge e chega no servico.
    var atLimit = ""
    i = 0
    while (i < bodyCap) {
        atLimit = atLimit + "y"
        i = i + 1
    }
    var exact = httpPostRaw(httpPort, "/echo", host, listOf<String>(), atLimit)
    assert(statusOf(exact) == 200, "no limite -> 200")
    assert(bodyOf(exact).indexOf("echo:") >= 0, "chegou no servico local")

    // Header grande sem corpo nao e afetado pelo teto de corpo.
    var largeHeader = "X-Padding: "
    i = 0
    while (i < bodyCap * 2) {
        largeHeader = largeHeader + "p"
        i = i + 1
    }
    var withHeader = httpPostRaw(httpPort, "/echo", host, listOf(largeHeader), "ok")
    assert(statusOf(withHeader) == 200, "header grande com corpo pequeno -> 200")

    // Parada limpa.
    writeTextTo(agentStop, "stop")
    time.sleep(1500)
    writeTextTo(edgeStop, "stop")
    time.sleep(1000)
    File(agentStop).delete()
    File(edgeStop).delete()
}

Int metricValue(String exposition, String name) {
    for (var line in exposition.split("\n")) {
        var trimmed = line.trim()
        if (trimmed.startsWith(name + " ")) {
            return parseIntSafe(trimmed.substring(name.length + 1).trim(), -1)
        }
    }
    return -1
}
