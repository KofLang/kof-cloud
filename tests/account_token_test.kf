import kofcloud.cli.Commands
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.identity.Tokens
import kofcloud.model.Errors
import kofcloud.store.Store
import testkit.Support

// Credencial da conta (kfc_) com ciclo de vida (Fase 19 s3, parte que faltava).
//
// O kfc_ e o token mais poderoso do sistema: autoriza publicar, revogar
// dispositivo, congelar conta. Ate aqui ele nao tinha ciclo de vida — `logout`
// apagava so o arquivo local e o valor seguia valido no servidor para sempre.
// O desenho espelha o do kfs_ (que ja provou o padrao): hash em repouso, TTL
// opcional, inventario sem valores, revogacao por id curto, rotacao com
// overlap.

String accountTokenPath(String name) {
    return "/tmp/kofcloud-atok-" + name + "-" + crypto.randomHex(4) + ".json"
}

test "credencial de conta: TTL, expiracao e poda preguicosa", "atok-unit" {
    var registry = Registry(accountTokenPath("ttl"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")

    // Sem TTL: vale para sempre (comportamento historico preservado).
    var forever = registry.issueToken(account.id)
    assert(registry.accountByToken(forever) != null, "sem TTL vale")
    assert(registry.accountTokensFor(account.id).size == 1, "listada")

    // Com TTL: vale agora.
    var shortLived = registry.issueToken(account.id, 1)
    assert(registry.accountByToken(shortLived) != null, "TTL futuro vale")
    assert(registry.accountTokensFor(account.id).size == 2, "duas validas")

    // Expiracao: o registro vencido nao autoriza nem aparece.
    var expired = TokenEntry(account.id, tokenHash("kfc_vencido"), time.now() - 10000, time.now() - 1)
    registry.tokens.add(expired)
    assert(registry.accountByToken("kfc_vencido") == null, "vencido nao autoriza")
    assert(registry.accountTokensFor(account.id).size == 2, "vencido nao e listado")
    // A validacao podou o vencido do estado (nao acumula lixo).
    assert(registry.tokens.size == 2, "vencido podado na validacao")

    // Estado antigo (sem o campo expiresAt) continua valido: o campo e
    // nulavel justamente para isso (JSN004 medido).
    var legacy = TokenEntry(account.id, tokenHash("kfc_antigo"), time.now(), null)
    registry.tokens.add(legacy)
    assert(registry.accountByToken("kfc_antigo") != null, "credencial legada vale")
    assert(registry.accountTokenExpired(legacy, time.now()) == false, "sem campo = sem expiracao")

    // TTL longo nao pode estourar: `ttlHours * 3600000` em Int (32 bits)
    // estourava acima de 596 h e `--ttl 720` (30 dias) virava um instante no
    // PASSADO — a credencial nascia vencida. Medido com o CLI 0.6.3:
    // 720 * 3600000 = -1702967296 em Int; em Long = 2592000000.
    var now = time.now()
    assert(tokenExpiryAt(now, 0) == 0, "sem TTL = 0")
    assert(tokenExpiryAt(now, -3) == 0, "TTL negativo = 0")
    assert(tokenExpiryAt(now, 1) == now + 3600000, "1 h em ms")
    assert(tokenExpiryAt(now, 720) == now + 2592000000, "720 h (30 dias) em ms")
    assert(tokenExpiryAt(now, 720) > now, "TTL longo continua no futuro")
    // Fonte unica: os dois caminhos (kfc_/kfs_) delegam na mesma funcao.
    assert(registry.accountTokenExpiry(now, 720) == tokenExpiryAt(now, 720), "kfc_ delega")
    assert(registry.serviceTokenExpiry(now, 720) == tokenExpiryAt(now, 720), "kfs_ delega")
    var longLived = registry.issueToken(account.id, 720)
    assert(registry.accountByToken(longLived) != null, "kfc_ de 30 dias nasce valido")
}

test "credencial de conta: aviso de expiracao proxima so para valida na janela", "atok-unit" {
    // Pura, sem rede nem HOME (precedente: logoutDisposition): o inventario
    // marca a credencial que vence em menos de
    // `kofcloud.limits.tokenExpiryWarnMs` (7 dias) — o kfc_ autoriza tudo e
    // o operador sem aviso descobre a perda quando a sessao morre. Fonte
    // unica: a mesma decisao alimenta o fio (`expiring`) e o CLI (AVISO).
    var registry = Registry(accountTokenPath("warn"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var window = limitTokenExpiryWarnMs()
    var now = time.now()
    assert(registry.nearAccountTokenExpiry(TokenEntry(account.id, "h1", now, null), now) == false, "sem TTL nunca avisa")
    assert(registry.nearAccountTokenExpiry(TokenEntry(account.id, "h2", now, 0L), now) == false, "expira 0 nunca avisa")
    assert(registry.nearAccountTokenExpiry(TokenEntry(account.id, "h3", now, now + window - 1), now), "dentro da janela avisa")
    assert(registry.nearAccountTokenExpiry(TokenEntry(account.id, "h4", now, now + window), now), "na borda avisa")
    assert(registry.nearAccountTokenExpiry(TokenEntry(account.id, "h5", now, now + window + 1), now) == false, "fora da janela nao avisa")
    // Vencida nao avisa: ela ja saiu do inventario — o aviso e para "ainda
    // da tempo". Delega no MESMO predicado da expiracao (fonte unica); se a
    // dedup um dia divergir, este assert quebra antes do operador ver lixo.
    assert(registry.accountTokenExpired(TokenEntry(account.id, "h6", now, now - 1), now), "pre-condicao: vencida expira")
    assert(registry.nearAccountTokenExpiry(TokenEntry(account.id, "h6", now, now - 1), now) == false, "vencida nao avisa")
    // Janela em fonte unica com recuo seguro (mesma familia de Limits):
    // zerada/negativa recai no default — janela zerada nunca avisaria.
    assert(window == tokenExpiryWarnMsFrom(0), "default = recuo de 0")
    assert(tokenExpiryWarnMsFrom(-5) == window, "negativo recai no default")
    assert(tokenExpiryWarnMsFrom(123) == 123, "valor configurado vale")
    // A linha do CLI: sem campo/sem TTL/vencida/fora = silencio; dentro =
    // orientacao acionavel com a mesma janela do fio.
    assert(tokenAccountWarningLine("", "0") == "", "sem campo: silencio")
    assert(tokenAccountWarningLine("0", "0") == "", "sem TTL: silencio")
    assert(tokenAccountWarningLine(longToString(now - 1), longToString(now)) == "", "vencida: silencio")
    assert(tokenAccountWarningLine(longToString(now + window + 1000), longToString(now)) == "", "fora: silencio")
    var inside = tokenAccountWarningLine(longToString(now + 3600000), longToString(now))
    assert(inside.indexOf("token rotate") >= 0, "dentro: orienta o rotate")
    assert(inside.indexOf(intToString((window / 3600000L) as Int) + "h") >= 0, "dentro: janela em horas legiveis")
}

test "credencial de conta: revogar por valor e por id curto, escopo por conta", "atok-unit" {
    var registry = Registry(accountTokenPath("revoke"))
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var ana = registry.createAccount("ana", "a@e.com", "segredo")
    var melToken = registry.issueToken(mel.id)
    var anaToken = registry.issueToken(ana.id)

    // Id curto do inventario revoga (unico na conta).
    var shortId = shortTokenId(tokenHash(melToken))
    assert(registry.revokeAccountTokenResult(mel.id, shortId) == "revoked", "id curto revoga")
    assert(registry.accountByToken(melToken) == null, "valor revogado nao autoriza")

    // A credencial da outra conta nao e tocada por um revoke de mel.
    assert(registry.accountByToken(anaToken) != null, "credencial de ana intacta")
    // E mel nao consegue revogar a credencial de ana nem pelo valor.
    assert(registry.revokeAccountTokenResult(mel.id, anaToken) == "", "alheia nao encontrada")
    assert(registry.accountByToken(anaToken) != null, "ana continua valida")

    // Inexistente: "" (o handler responde 404 KCF064 opaco).
    assert(registry.revokeAccountTokenResult(mel.id, "kfc_naoexiste") == "", "inexistente")
    assert(errAccountTokenNotFound().indexOf("KCF064") >= 0, "codigo KCF064")
    assert(errHint(errAccountTokenNotFound()).length > 0, "tem Hint")
}

test "credencial de conta: id curto ambiguo pede o valor completo", "atok-unit" {
    var registry = Registry(accountTokenPath("ambig"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    // Duas credenciais com o MESMO hash so para forcar a ambiguidade do
    // prefixo (o hash e o que o inventario expoe).
    var hash = tokenHash("kfc_repetido")
    registry.tokens.add(TokenEntry(account.id, hash, time.now(), null))
    registry.tokens.add(TokenEntry(account.id, hash, time.now(), null))
    var shortId = shortTokenId(hash)
    assert(registry.revokeAccountTokenResult(account.id, shortId) == "ambiguous", "ambiguo")
    assert(registry.tokens.size == 2, "nada revogado no ambiguo")
    // O valor completo resolve a ambiguidade (revoga as duas ocorrencias).
    assert(registry.revokeAccountTokenResult(account.id, "kfc_repetido") == "revoked", "valor completo")
    assert(registry.tokens.size == 0, "ambas sairam")
}

test "credencial de conta: rotacao com overlap nao derruba a antiga antes do TTL", "atok-unit" {
    var registry = Registry(accountTokenPath("rotate"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var old = registry.issueToken(account.id)

    // Rotacao com TTL: a nova vale, a antiga (sem expiracao) NAO e revogada
    // em silencio — fica pendente.
    var result = registry.rotateAccountTokens(account.id, 24)
    assert(result.token.length > 0, "token novo emitido")
    assert(result.revoked == 0, "nada revogado antes do prazo")
    assert(result.pending == 1, "a antiga ainda vale")
    assert(registry.accountByToken(old) != null, "antiga continua valendo (overlap)")
    assert(registry.accountByToken(result.token) != null, "nova vale")
    assert(registry.pendingAccountRotationCount(account.id) == 2, "duas validas")

    // Depois do prazo, a proxima rotacao revoga as vencidas.
    var expiredOld = TokenEntry(account.id, tokenHash("kfc_velho"), time.now() - 10000, time.now() - 1)
    registry.tokens.add(expiredOld)
    var second = registry.rotateAccountTokens(account.id, 24)
    assert(second.revoked == 1, "vencida revogada na rotacao seguinte")
    assert(registry.accountByToken("kfc_velho") == null, "vencida nao autoriza")
    assert(registry.accountByToken(second.token) != null, "nova da segunda rotacao vale")
}

test "credencial de conta: HTTP lista sem valores, revoga e rotaciona", "atok" {
    var controlPort = 20011
    var registry = Registry(accountTokenPath("http"))
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 20012)
    var controlTask = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var account = json.decode<Map<String, String>>(bodyOf(created))
    var token = mapField(account, "token")
    assert(token.startsWith("kfc_"), "token da conta")

    // Inventario: id curto + emissao, NUNCA o valor.
    var listed = httpGetToken(controlPort, "/v1/tokens", token)
    assert(statusOf(listed) == 200, "lista 200")
    assert(bodyOf(listed).indexOf("kfc_") < 0, "inventario nao vaza o valor")
    assert(bodyOf(listed).indexOf("\"id\"") >= 0, "tem id curto")

    // Sem token: 401.
    assert(statusOf(httpGetToken(controlPort, "/v1/tokens", "")) == 401, "401 sem token")

    // Rotacao: devolve a nova UMA vez e mantem a antiga valida (overlap).
    var rotated = httpPostJson(controlPort, "/v1/tokens/rotate", "{\"ttlHours\":\"24\"}", token)
    assert(statusOf(rotated) == 200, "rotate 200")
    var fresh = mapField(json.decode<Map<String, String>>(bodyOf(rotated)), "token")
    assert(fresh.startsWith("kfc_"), "nova credencial")
    assert(fresh != token, "valor diferente")
    assert(statusOf(httpGetToken(controlPort, "/v1/tokens", token)) == 200, "antiga ainda vale")
    assert(statusOf(httpGetToken(controlPort, "/v1/tokens", fresh)) == 200, "nova vale")

    // TTL invalido: 400 KCF062.
    var badTtl = httpPostJson(controlPort, "/v1/tokens/rotate", "{\"ttlHours\":\"0\"}", fresh)
    assert(statusOf(badTtl) == 400, "ttl zero recusado")
    assert(bodyOf(badTtl).indexOf("KCF062") >= 0, "KCF062")

    // Revogar a antiga pelo id curto: 200; ela deixa de autorizar.
    var oldId = shortTokenId(tokenHash(token))
    var revoked = httpPostJson(controlPort, "/v1/tokens/revoke", "{\"token\":\"" + oldId + "\"}", fresh)
    assert(statusOf(revoked) == 200, "revoke 200")
    assert(statusOf(httpGetToken(controlPort, "/v1/tokens", token)) == 401, "antiga nao autoriza mais")
    assert(statusOf(httpGetToken(controlPort, "/v1/tokens", fresh)) == 200, "nova segue valida")

    // Revogar inexistente: 404 KCF064 opaco.
    var missing = httpPostJson(controlPort, "/v1/tokens/revoke", "{\"token\":\"kfc_naoexiste\"}", fresh)
    assert(statusOf(missing) == 404, "404 opaco")
    assert(bodyOf(missing).indexOf("KCF064") >= 0, "KCF064")

    // Rotation status: so a nova vale.
    var status = httpPostJson(controlPort, "/v1/tokens/rotation", "{}", fresh)
    assert(statusOf(status) == 200, "rotation 200")
    assert(bodyOf(status).indexOf("\"pending\":\"1\"") >= 0, "uma credencial valida")

    // Aviso de expiracao proxima no FIO: a nova (TTL 24 h) cai dentro da
    // janela (7 d) e o inventario traz o campo ADITIVO `expiring`; a sem TTL
    // (rotate sem prazo) nao traz. Campo parte do corpo sem o valor — o kfc_
    // nunca viaja (regra de privacidade do audit/worm, travada em
    // worm-privacy); cliente antigo que le id/createdAt/expiresAt continua
    // decodificando.
    var rotatedForever = httpPostJson(controlPort, "/v1/tokens/rotate", "{}", fresh)
    assert(statusOf(rotatedForever) == 200, "rotate sem ttl 200")
    var forever = mapField(json.decode<Map<String, String>>(bodyOf(rotatedForever)), "token")
    assert(fresh != forever, "valor diferente")
    var listed2 = httpGetToken(controlPort, "/v1/tokens", fresh)
    assert(statusOf(listed2) == 200, "lista as duas")
    var freshId = shortTokenId(tokenHash(fresh))
    var freshAt = bodyOf(listed2).indexOf(freshId)
    assert(freshAt >= 0, "nova no inventario")
    // O id e o ULTIMO campo do objeto (a serializacao ordena createdAt/
    // expiresAt/expiring antes): ande para tras ate o "{" da entrada — a
    // lista e plana (objetos sem aninhamento), entao o primeiro "}" depois
    // do "{" e o fim da entrada certa.
    var freshStart = freshAt
    while (freshStart > 0 && bodyOf(listed2).charAt(freshStart) != 123) {
        freshStart = freshStart - 1
    }
    assert(freshStart < freshAt, "inicio do objeto da nova achado")
    var freshEnd = bodyOf(listed2).indexOf("}", freshStart)
    assert(freshEnd > freshAt, "objeto da nova fecha")
    var freshChunk = bodyOf(listed2).substring(freshStart, freshEnd + 1)
    assert(freshChunk.indexOf("\"expiring\":\"true\"") >= 0, "nova (TTL 24h) marcada expiring")
    assert(freshChunk.indexOf("kfc_") < 0, "fatia da nova nao vaza valor")
    var foreverId = shortTokenId(tokenHash(forever))
    var foreverAt = bodyOf(listed2).indexOf(foreverId)
    assert(foreverAt >= 0, "sem-ttl no inventario")
    var foreverStart = foreverAt
    while (foreverStart > 0 && bodyOf(listed2).charAt(foreverStart) != 123) {
        foreverStart = foreverStart - 1
    }
    var foreverEnd = bodyOf(listed2).indexOf("}", foreverStart)
    var foreverChunk = bodyOf(listed2).substring(foreverStart, foreverEnd + 1)
    assert(foreverChunk.indexOf("expiring") < 0, "sem TTL nao e marcada")

    // Auto-revogacao do `logout` POR ULTIMO (a sessao morre aqui): revogar
    // o proprio token da sessao pelo valor completo — e o que o logout faz
    // antes de apagar os arquivos locais (fresh deixa de autorizar).
    var selfRevoked = httpPostJson(controlPort, "/v1/tokens/revoke", "{\"token\":\"" + fresh + "\"}", fresh)
    assert(statusOf(selfRevoked) == 200, "auto-revoke 200")
    assert(statusOf(httpGetToken(controlPort, "/v1/tokens", fresh)) == 401, "credencial da sessao morreu")
}

test "credencial de conta: logoutDisposition trava as quatro saidas", "atok-unit" {
    // O logout tenta auto-revogar antes de apagar o local (antes era
    // so-local e o kfc_ seguia valido para sempre). As quatro saidas:
    // sem sessao ("local"), confirmado ("revoked"), KCF004 = ja vencida/
    // revogada ("dead" — nada vivo, nao e falha), outra falha de rede
    // ("warn" — a credencial sobreviveu e o operador precisa saber).
    assert(logoutDisposition(false, false, "") == "local", "sem sessao: local")
    assert(logoutDisposition(true, true, "") == "revoked", "confirmado: revoked")
    assert(logoutDisposition(true, false, "KCF004: missing or invalid account token") == "dead", "KCF004: dead")
    assert(logoutDisposition(true, false, "conexao recusada") == "warn", "rede: warn")
    // O body de 401 do control plane passa pelo requireOk como texto de erro;
    // qualquer texto com KCF004 conta como "credencial ja morta".
    assert(logoutDisposition(true, false, "KCF004") == "dead", "KCF004 curto: dead")

    // Cruzamento logout × sessão vencida (o aviso `expiring` avisou, o
    // operador demorou): no FIO, um token vencido não autoriza o endpoint
    // (401 errUnauthorized = KCF004), então o disposition cai em "dead" —
    // nunca "warn", que mentiria "ela segue valida". Handlers diretos sobre
    // o Registry real (sem rede): o caminho do revoke é o mesmo do fio.
    var registry = Registry(accountTokenPath("logout-expired"))
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    registry.tokens.add(TokenEntry(mel.id, tokenHash("kfc_venceu-ontem"), time.now() - 90000, time.now() - 60000))
    var expiredAuth = handleRevokeAccountToken(registry, "Bearer kfc_venceu-ontem", "{\"token\":\"kfc_venceu-ontem\"}")
    assert(expiredAuth.code == 401, "vencida não autoriza o revoke")
    assert(expiredAuth.body.indexOf("KCF004") >= 0, "401 com KCF004: " + expiredAuth.body)
    assert(logoutDisposition(true, false, expiredAuth.body) == "dead", "vencida: dead, não warn")
    var prunedExpired = handlePruneAccountTokens(registry, "Bearer kfc_venceu-ontem")
    assert(prunedExpired.code == 401, "vencida não autoriza o prune")
    assert(prunedExpired.body.indexOf("KCF004") >= 0, "prune: mesmo 401 KCF004")
}

test "credencial de conta: prune preserva a da sessao e revoga as antigas", "atok-unit" {
    // Cada `login` emite um token novo e nunca revoga o anterior. Sem TTL
    // por default, o inventario cresce a cada entrada e um token vazado de
    // um login antigo vale para sempre. `prune` fecha isso sem trancar o
    // operador fora: a credencial usada no comando sobrevive.
    var registry = Registry(accountTokenPath("prune"))
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var ana = registry.createAccount("ana", "a@e.com", "segredo")

    var t1 = registry.issueToken(mel.id)
    var t2 = registry.issueToken(mel.id)
    var t3 = registry.issueToken(mel.id)
    var anaToken = registry.issueToken(ana.id)
    assert(registry.accountTokensFor(mel.id).size == 3, "tres credenciais acumuladas")

    var removed = registry.pruneAccountTokensExcept(mel.id, t3)
    assert(removed == 2, "duas revogadas")
    assert(registry.accountTokensFor(mel.id).size == 1, "so a da sessao vale")
    assert(registry.accountByToken(t3) != null, "a atual continua valendo")
    assert(registry.accountByToken(t1) == null, "antiga 1 caiu")
    assert(registry.accountByToken(t2) == null, "antiga 2 caiu")
    // Credencial de outra conta nunca e tocada.
    assert(registry.accountByToken(anaToken) != null, "ana intacta")

    // Token vazio nao e "prune tudo" silencioso: nao ha sessao a preservar.
    assert(registry.pruneAccountTokensExcept(mel.id, "") == 0, "sem token nao poda")
    assert(registry.accountTokensFor(mel.id).size == 1, "nada mudou")

    // Nada a podar: zero, sem efeito.
    assert(registry.pruneAccountTokensExcept(mel.id, t3) == 0, "idempotente")

    // Cruzamento prune (kfc_) x credencial de servico (kfs_): a poda so
    // toca o inventario da conta (this.tokens) — as kfs_ validas de servicos
    // AUTHENTICATED sobrevivem, senao um `token prune` de rotina fecharia o
    // acesso publico a TODOS os servicos da conta.
    var device = registry.registerDevice(mel, "nb", "pk")
    var svc = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED", "", "")
    var kfs = registry.issueServiceToken(mel.id, svc.id)
    assert(registry.serviceByServiceToken(kfs) != null, "kfs_ autentica antes do prune")
    assert(registry.pruneAccountTokensExcept(mel.id, t3) == 0, "prune nao podou nada novo")
    assert(registry.serviceByServiceToken(kfs) != null, "kfs_ sobrevive ao prune da conta")
    assert(registry.tokensWithoutExpiry(mel.id).size == 1, "higiene de kfs_ intacta")
    assert(registry.accountByToken(t3) != null, "a sessao da conta segue valendo")
}

test "credencial de conta: HTTP prune revoga as antigas e mantem a sessao", "atok" {
    var controlPort = 20113
    var registry = Registry(accountTokenPath("prune-http"))
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 20114)
    var controlTask = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var first = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    // Dois logins a mais: cada um emite credencial nova.
    var second = mapField(json.decode<Map<String, String>>(bodyOf(httpPostJson(controlPort, "/v1/login", "{\"handle\":\"mel\",\"password\":\"segredo\"}", ""))), "token")
    var third = mapField(json.decode<Map<String, String>>(bodyOf(httpPostJson(controlPort, "/v1/login", "{\"handle\":\"mel\",\"password\":\"segredo\"}", ""))), "token")

    var listed = bodyOf(httpGetToken(controlPort, "/v1/tokens", third))
    assert(listed.indexOf("\"id\"") >= 0, "inventario acessivel com a credencial atual")

    // Sem token: 401.
    assert(statusOf(httpPostJson(controlPort, "/v1/tokens/prune", "{}", "")) == 401, "401 sem token")

    var pruned = httpPostJson(controlPort, "/v1/tokens/prune", "{}", third)
    assert(statusOf(pruned) == 200, "prune 200")
    assert(bodyOf(pruned).indexOf("\"revoked\":\"2\"") >= 0, "duas revogadas")
    assert(statusOf(httpGetToken(controlPort, "/v1/tokens", third)) == 200, "a da sessao segue valida")
    assert(statusOf(httpGetToken(controlPort, "/v1/tokens", first)) == 401, "a primeira caiu")
    assert(statusOf(httpGetToken(controlPort, "/v1/tokens", second)) == 401, "a segunda caiu")

    // De novo: nada a fazer.
    var again = httpPostJson(controlPort, "/v1/tokens/prune", "{}", third)
    assert(statusOf(again) == 200, "idempotente")
    assert(bodyOf(again).indexOf("\"revoked\":\"0\"") >= 0, "zero revogadas")
}

test "credencial de conta: o status mostra o aviso do mesmo sinal do fio", "atok-unit" {
    // Pura, sem rede nem HOME (precedente: doctorAccountTokenLine): o
    // `status` le o MESMO sinal `expiring` do fio que o `token list` (AVISO
    // por entrada), o doctor (camada da credencial) e o painel (4a camada
    // do Diagnostico) — era o comando de rotina que ficava cego, e quem so
    // roda `status` descobria a perda da sessao nos 401. Nao re-deriva com
    // relogio proprio: sem TTL ou fora do fio nao ha sinal, e aviso sem
    // sinal seria inventado. "" = nada a avisar (inclui busca falhada e
    // corpo ilegivel, que o countTokenExpiring devolve -1).
    var window = limitTokenExpiryWarnMs()
    var hours = intToString((window / 3600000L) as Int)
    assert(statusCredentialWarning("") == "", "corpo vazio: silencio")
    assert(statusCredentialWarning("lixo {") == "", "ilegivel: silencio")
    assert(statusCredentialWarning("[]") == "", "vazia: silencio")
    assert(statusCredentialWarning("[{\"id\":\"a1\",\"createdAt\":\"1\"},{\"id\":\"b2\",\"createdAt\":\"1\",\"expiresAt\":\"9\"}]") == "", "sem expiring: silencio")
    // TTL longo fora da janela no corpo sem o sinal: o status segue o FIO
    // (campo aditivo), nao o epoch — re-derivar aqui divergiria do doctor.
    assert(statusCredentialWarning("[{\"id\":\"a1\",\"createdAt\":\"1\",\"expiresAt\":\"2524608000000\"}]") == "", "longa sem sinal: silencio")
    var warn = statusCredentialWarning("[{\"id\":\"a1\",\"createdAt\":\"1\",\"expiresAt\":\"2\",\"expiring\":\"true\"}]")
    assert(warn.indexOf("1 credencial") >= 0, "uma expirando: conta: " + warn)
    assert(warn.indexOf("token rotate") >= 0, "uma expirando: orienta o rotate: " + warn)
    assert(warn.indexOf(hours + "h") >= 0, "janela derivada da fonte unica: " + warn)
    assert(warn.indexOf("kfc_") < 0, "aviso nunca vaza valor")
    var two = statusCredentialWarning("[{\"id\":\"a\",\"createdAt\":\"1\",\"expiring\":\"true\"},{\"id\":\"b\",\"createdAt\":\"1\",\"expiring\":\"true\"}]")
    assert(two.indexOf("2 credencial") >= 0, "conta as duas: " + two)
    var mixed = statusCredentialWarning("[{\"id\":\"a\",\"createdAt\":\"1\"},{\"id\":\"b\",\"createdAt\":\"1\",\"expiresAt\":\"2\",\"expiring\":\"true\"}]")
    assert(mixed.indexOf("1 credencial") >= 0, "conta so a expirando: " + mixed)

    // Trava de fonte: o cmdStatus busca /v1/tokens e delega na funcao (sem
    // captura de stdout no runner). Best-effort: a chamada vive em try e a
    // impressao so sai quando ha aviso.
    var raw = File("src/kofcloud/cli/Commands.kf").readText()
    var text = ""
    if (raw != null) {
        text = raw
    }
    var start = text.indexOf("Int cmdStatus(")
    var end = text.indexOf("Int cmdDeviceList(", start)
    if (end < 0) {
        end = text.length
    }
    var body = text.substring(start, end)
    assert(body.indexOf("/v1/tokens") >= 0, "status busca o inventario")
    assert(body.indexOf("statusCredentialWarning(tokensRaw)") >= 0, "status delega na funcao pura")
    assert(body.indexOf("credWarn.length > 0") >= 0, "status so imprime quando ha aviso")
}

test "credencial de conta: aviso do status contra o fio real", "atok" {
    // Fio real (precedente: doctor-cred e2e): rotaciona com TTL curto para
    // a nova entrada cair na janela e o corpo de /v1/tokens carregar o
    // sinal — e sobre ESSE corpo que o `status` decide o aviso.
    var controlPort = 20177
    var registry = Registry(accountTokenPath("status"))
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 20178)
    var controlTask = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control plane no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var accountToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var before = bodyOf(httpGetToken(controlPort, "/v1/tokens", accountToken))
    assert(statusCredentialWarning(before) == "", "sem TTL: status calmo")

    var rotated = httpPostJson(controlPort, "/v1/tokens/rotate", "{\"ttlHours\":\"24\"}", accountToken)
    assert(statusOf(rotated) == 200, "rotate 200")
    var fresh = mapField(json.decode<Map<String, String>>(bodyOf(rotated)), "token")
    // Apos o rotate (TTL 24h < janela de 7 dias) o inventario da conta
    // carrega o sinal na entrada nova — qualquer credencial valida da
    // conta le o mesmo aviso (o sinal e por conta, como no doctor).
    var listedOld = bodyOf(httpGetToken(controlPort, "/v1/tokens", accountToken))
    var listedNew = bodyOf(httpGetToken(controlPort, "/v1/tokens", fresh))
    assert(statusCredentialWarning(listedOld).indexOf("1 credencial") >= 0, "antiga ve o aviso da conta")
    var warn = statusCredentialWarning(listedNew)
    assert(warn.indexOf("1 credencial") >= 0, "nova ve o aviso: " + warn)
    assert(warn.indexOf("token rotate") >= 0, "orienta o rotate")
    assert(warn.indexOf("kfc_") < 0, "aviso nao vaza valor")
}
