import kofcloud.cli.Commands
import kofcloud.cli.Local
import kofcloud.store.Store
import testkit.Support

import kofcloud.control.Registry
import kofcloud.model.Account
import kofcloud.model.Device
import kofcloud.model.Service
import kofcloud.store.Store

String tempStatePath(String name) {
    return "/tmp/kofcloud-test-" + name + "-" + crypto.randomHex(4) + ".json"
}

test "registry: cria conta e recusa handle duplicado" {
    var registry = Registry(tempStatePath("account"))
    var account = registry.createAccount("mel", "mel@example.com", "segredo")
    assert(account.handle == "mel", "handle")
    assert(registry.accountByHandle("mel") != null, "encontrada")
    var duplicated = false
    try {
        registry.createAccount("mel", "outro@example.com", "x")
    } catch (String e) {
        duplicated = true
    }
    assert(duplicated, "handle duplicado recusado")
}

test "registry: token autentica a conta" {
    var registry = Registry(tempStatePath("token"))
    var account = registry.createAccount("mel", "mel@example.com", "segredo")
    var token = registry.issueToken(account.id)
    var resolved = registry.accountByToken(token)
    assert(resolved != null, "token resolve")
    if (resolved != null) {
        assert(resolved.id == account.id, "conta certa")
    }
    assert(registry.accountByToken("kfc_invalido") == null, "token invalido recusado")
}

test "registry: login exige a senha correta" {
    var registry = Registry(tempStatePath("login"))
    registry.createAccount("mel", "mel@example.com", "segredo")
    var token = registry.login("mel", "segredo")
    assert(token.startsWith("kfc_"), "token emitido")
    var rejected = false
    try {
        registry.login("mel", "errada")
    } catch (String e) {
        rejected = true
    }
    assert(rejected, "senha errada recusada")
}

test "registry: registra dispositivo e publica servico com hostname" {
    var registry = Registry(tempStatePath("publish"))
    var account = registry.createAccount("mel", "mel@example.com", "segredo")
    var device = registry.registerDevice(account, "notebook", "pubkey")
    assert(device.status == "ACTIVE", "ativo")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    assert(service.hostname == "site.mel.kofcloud.io", "hostname")
    assert(service.exposure == "PUBLIC", "exposicao")
    assert(service.status == "UNKNOWN", "status inicial")
}

test "registry: PRIVATE nao aparece como rota publica" {
    var registry = Registry(tempStatePath("private"))
    var account = registry.createAccount("mel", "mel@example.com", "segredo")
    var device = registry.registerDevice(account, "notebook", "pubkey")
    var service = registry.publishService(account, device.id, "db", "127.0.0.1", 5432, "http", "PRIVATE", "", "")
    assert(registry.resolveRoute(service.hostname) == null, "sem rota")
    assert(registry.serviceById(service.id) != null, "mas o servico existe")
}

test "registry: revogar dispositivo remove os servicos dele" {
    var registry = Registry(tempStatePath("revoke"))
    var account = registry.createAccount("mel", "mel@example.com", "segredo")
    var device = registry.registerDevice(account, "notebook", "pubkey")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    assert(registry.resolveRoute(service.hostname) != null, "rota antes")
    assert(registry.revokeDevice(account.id, device.id) == true, "revogado")
    var after = registry.deviceById(device.id)
    assert(after != null, "device ainda existe")
    if (after != null) {
        assert(after.status == "REVOKED", "status revogado")
    }
    assert(registry.resolveRoute(service.hostname) == null, "rota removida")
}

test "registry: estado persiste em disco e recarrega" {
    var path = tempStatePath("persist")
    var registry = Registry(path)
    var account = registry.createAccount("mel", "mel@example.com", "segredo")
    registry.registerDevice(account, "notebook", "pubkey")
    var reloaded = Registry(path)
    assert(reloaded.accountByHandle("mel") != null, "conta recarregada")
    assert(reloaded.devicesForAccount(account.id).size == 1, "dispositivo recarregado")
}

test "registry: republicar no mesmo device atualiza a configuracao mutavel", "republish" {
    // Medido: `publishService` devolvia o existente SEM aplicar nada. O
    // `deploy` com porta/exposure/allowlist mudada imprimia "publicado" e o
    // servico seguia com a config velha, enquanto `--plan` prometia
    // "~ vai atualizar". Agora a configuracao mutavel e reescrita.
    var registry = Registry(tempStatePath("republish"))
    var account = registry.createAccount("mel", "mel@example.com", "segredo")
    var device = registry.registerDevice(account, "notebook", "pubkey")
    var first = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")

    var updated = registry.publishService(account, device.id, "site", "127.0.0.1", 9090, "http", "AUTHENTICATED", "GET", "/api/*")
    assert(updated.id == first.id, "mesma identidade (id preservado)")
    assert(updated.hostname == first.hostname, "hostname preservado")
    assert(updated.createdAt == first.createdAt, "createdAt preservado")
    assert(updated.localPort == 9090, "porta atualizada")
    assert(updated.exposure == "AUTHENTICATED", "exposure atualizada")
    assert(updated.allowMethods == "GET", "allowlist atualizada")
    assert(updated.allowPaths == "/api/*", "allowPaths atualizado")

    // O estado em memoria reflete a atualizacao (nao so o retorno).
    var live = registry.serviceById(first.id)
    assert(live != null, "servico existe")
    if (live != null) {
        assert(live.localPort == 9090, "estado atualizado")
    }
    // E persiste: recarregar do disco ve a config nova.
    var reloaded = Registry(registry.path)
    var persisted = reloaded.serviceById(first.id)
    assert(persisted != null, "persistido")
    if (persisted != null) {
        assert(persisted.localPort == 9090, "porta persistida")
        assert(persisted.exposure == "AUTHENTICATED", "exposure persistida")
    }
}

test "registry: republicar preserva status e nao ressuscita suspenso", "republish-status" {
    // Republicar nao e acao de saude: o status que o Agent reportou (ou a
    // suspensao que o operador aplicou) nao pode ser zerado por um deploy.
    var registry = Registry(tempStatePath("republish-status"))
    var account = registry.createAccount("mel", "mel@example.com", "segredo")
    var device = registry.registerDevice(account, "notebook", "pubkey")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    registry.setServiceStatus(service.id, "ONLINE")

    var updated = registry.publishService(account, device.id, "site", "127.0.0.1", 9090, "http", "PUBLIC", "", "")
    assert(updated.status == "ONLINE", "status preservado na republicacao")

    // Suspenso continua suspenso (o deploy nao dessuspende).
    registry.suspendService(account.id, service.id)
    var afterSuspend = registry.publishService(account, device.id, "site", "127.0.0.1", 7070, "http", "PUBLIC", "", "")
    assert(afterSuspend.status == "SUSPENDED", "suspensao preservada")
    assert(afterSuspend.localPort == 7070, "config ainda atualiza")

    // Cruzamento republicar × kfs_ (deploy --watch republica em lote a cada
    // mudanca do manifesto): o publish atualiza a CONFIG do servico e nunca
    // toca no inventario de credenciais — as kfs_ validas (inclusive em
    // overlap de rotacao) sobrevivem a N republicacoes. Limpar credencial e
    // decisao de rotate/revoke, nunca de publish.
    var kfs1 = registry.issueServiceToken(account.id, service.id)
    var kfs2 = registry.issueServiceToken(account.id, service.id, 24)
    assert(registry.pendingRotationCount(service.id) == 2, "duas credenciais vivas (overlap)")
    registry.publishService(account, device.id, "site", "127.0.0.1", 6060, "http", "AUTHENTICATED", "", "")
    registry.publishService(account, device.id, "site", "127.0.0.1", 6060, "http", "AUTHENTICATED", "", "")
    assert(registry.serviceByServiceToken(kfs1) != null, "antiga (sem TTL) sobrevive ao republish")
    assert(registry.serviceByServiceToken(kfs2) != null, "nova (com TTL) sobrevive ao republish")
    assert(registry.pendingRotationCount(service.id) == 2, "overlap intacto apos republish")
}

test "registry: republicar sem mudanca nao reescreve (idempotente)", "republish-same" {
    // Mesma config: nada muda, nada e auditado como atualizacao. A
    // idempotencia do deploy depende disso (republicar o manifesto inteiro
    // nao pode inflar a trilha nem a metrica a cada rodada).
    var registry = Registry(tempStatePath("republish-same"))
    var account = registry.createAccount("mel", "mel@example.com", "segredo")
    var device = registry.registerDevice(account, "notebook", "pubkey")
    var first = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    var before = registry.auditCountSince(account.id, "service.updated", 0)
    var again = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    assert(again.id == first.id, "mesmo servico")
    assert(registry.auditCountSince(account.id, "service.updated", 0) == before, "sem auditoria de update")
    assert(serviceConfigEquals(first, again), "config identica")
}

test "registry: publicar em device revogado recusa; suspenso aceita", "publish-device-state" {
    // Medido: publicar num device REVOGADO criava o servico (200) — mas o
    // device nunca mais abre tunel (HELLO recusado com DEVICE_REVOKED,
    // fatal) e `device revoke` ja removeu os servicos dele. A rota nasceria
    // morta com o CLI dizendo "publicado". SUSPENSO e diferente: reversivel,
    // o servico volta no `unsuspend` — publicar ali e legitimo.
    var registry = Registry(tempStatePath("publish-device-state"))
    var account = registry.createAccount("mel", "mel@example.com", "segredo")
    var device = registry.registerDevice(account, "notebook", "pubkey")
    registry.revokeDevice(account.id, device.id)

    var refused = false
    var code = ""
    try {
        registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    } catch (String e) {
        refused = true
        code = e
    }
    assert(refused, "device revogado recusa o publish")
    assert(code.indexOf("KCF023") >= 0, "codigo KCF023: " + code)
    assert(registry.servicesForAccount(account.id).size == 0, "nada foi criado")

    // Suspenso: aceita (reversivel).
    var registry2 = Registry(tempStatePath("publish-suspended"))
    var account2 = registry2.createAccount("ana", "ana@example.com", "segredo")
    var device2 = registry2.registerDevice(account2, "pc", "pubkey")
    registry2.suspendDevice(account2.id, device2.id)
    var service = registry2.publishService(account2, device2.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    assert(service.name == "site", "suspenso aceita o publish")
    assert(registry2.servicesForAccount(account2.id).size == 1, "servico criado")
}

test "registry: re-registrar nome revogado cria device NOVO (id e chave novos)", "reregister" {
    // Medido: `deviceByName` casava qualquer status, entao re-registrar o
    // nome de um device REVOGADO devolvia o PROPRIO device revogado — mesmo
    // id, ainda REVOKED, sem chave nova. Como revogar e terminal, o
    // `doctor` manda "registre de novo" e esse caminho nao existia: o
    // operador nunca recuperava a maquina.
    var registry = Registry(tempStatePath("reregister"))
    var account = registry.createAccount("mel", "mel@example.com", "segredo")
    var first = registry.registerDevice(account, "notebook", "pk-antiga")
    assert(registry.revokeDevice(account.id, first.id), "revoga o primeiro")

    var second = registry.registerDevice(account, "notebook", "pk-nova")
    assert(second.id != first.id, "id NOVO (o revogado nao volta)")
    assert(second.status == "ACTIVE", "nasce ativo")
    assert(second.publicKey == "pk-nova", "chave nova registrada")

    // O revogado continua revogado e fora do caminho.
    var firstAfter = registry.deviceById(first.id)
    assert(firstAfter != null, "revogado ainda existe para auditoria")
    if (firstAfter != null) {
        assert(firstAfter.status == "REVOKED", "segue REVOKED")
    }

    // Re-registrar de novo (sem revogar o novo) dedupa no VIVO, nao no morto:
    // cada login com o mesmo nome nao cria mais um device.
    var third = registry.registerDevice(account, "notebook", "pk-outra")
    assert(third.id == second.id, "dedup no device vivo")
    assert(registry.devicesForAccount(account.id).size == 2, "so revogado + vivo")
    // O ativo aparece uma vez; o nome resolve para o vivo.
    var active = registry.activeDeviceByName(account.id, "notebook")
    assert(active != null, "existe ativo com o nome")
    if (active != null) {
        assert(active.id == second.id, "activeDeviceByName acha o vivo")
    }
    assert(registry.activeDeviceCount(account.id) == 1, "revogado nao conta no teto")
}

test "registry: nome com caixa diferente nao resolve, mas o aviso nomeia o existente", "service-case-hint" {
    // O nome de servico e chave EXATA (manifesto, rota, hostname): "Site" nao
    // resolve "site" — e adivinhar mudaria a chave em silencio. O que faltava
    // era o diagnostico: "nao encontrado" sozinho fazia o operador conferir
    // o `service list` e achar que o nome estava certo.
    var live = listOf<Service>()
    live.add(Service("id-a", "acc", "devA", "site", "127.0.0.1", 8080, "http", "site.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0, "", "", ""))
    live.add(Service("id-b", "acc", "devA", "api-v2", "127.0.0.1", 9000, "http", "api-v2.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0, "", "", ""))
    // Exato continua resolvendo (sem mudanca de semantica).
    assert(matchServiceName(live, "site") == "id-a", "exato resolve")
    assert(matchServiceName(live, "Site") == "", "caixa diferente NAO resolve")
    assert(serviceCaseHint(live, "Site").indexOf("site") >= 0, "o aviso nomeia o existente")
    assert(serviceCaseHint(live, " Site ").indexOf("site") >= 0, "aplica trim")
    assert(serviceCaseHint(live, "API-V2").indexOf("api-v2") >= 0, "maiusculas no nome tambem casam")
    assert(serviceCaseHint(live, "outro") == "", "sem candidato, sem aviso")
    assert(serviceCaseHint(live, "") == "", "vazio sem aviso")
    assert(serviceCaseHint(listOf<Service>(), "Site") == "", "conta vazia sem aviso")
    // Comparacao propria (a caixa e lacuna medida do runtime — L20): so ASCII.
    assert(sameLettersIgnoringCase("Site", "sITE"), "mesmas letras")
    assert(sameLettersIgnoringCase("site", "site") == true, "exato nao confunde")
    assert(sameLettersIgnoringCase("site", "sity") == false, "letra diferente")
    assert(sameLettersIgnoringCase("site", "sites") == false, "tamanho diferente")
    assert(loweredChar(65) == 97, "A vira a")
    assert(loweredChar(97) == 97, "a fica a")
    assert(loweredChar(45) == 45, "hifen intacto")
}

test "status: dominios proprios que apontam para os servicos desta maquina", "status-domains" {
    // Puro (recebe as duas listas do fio). O `status` listava servicos sem
    // dizer quais hostnames externos levam a eles.
    var services = listOf<Service>()
    services.add(Service("id-site", "acc", "devA", "site", "127.0.0.1", 8080, "http", "site.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0, "", "", ""))
    services.add(Service("id-api", "acc", "devA", "api", "127.0.0.1", 9000, "http", "api.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0, "", "", ""))
    var domains = listOf<DomainEntry>()
    domains.add(DomainEntry("www.example.com", "custom", "site", "VERIFIED"))
    domains.add(DomainEntry("painel.example.com", "custom", "api", "PENDING"))
    domains.add(DomainEntry("alheio.example.com", "custom", "outra-maquina", "VERIFIED"))
    domains.add(DomainEntry("sem-servico.example.com", "custom", "", "VERIFIED"))
    domains.add(DomainEntry("api.mel.kofcloud.io", "service", "api", ""))
    var pointing = domainsPointingToServices(domains, services)
    assert(pointing.size == 2, "so os dois da maquina: " + intToString(pointing.size))
    var www = statusDomainLine(domains.get(0), services)
    assert(www.indexOf("site <-") >= 0, "nomeia o servico alvo: " + www)
    assert(www.indexOf("www.example.com") >= 0, "mostra o hostname")
    assert(www.indexOf("VERIFIED") >= 0, "mostra o status do DNS")
    var painel = statusDomainLine(domains.get(1), services)
    assert(painel.indexOf("api <-") >= 0 && painel.indexOf("PENDING") >= 0, "PENDING visivel: " + painel)
    // Maquina sem servicos: nada aponta.
    assert(domainsPointingToServices(domains, listOf<Service>()).size == 0, "sem servicos: vazio")
    assert(domainsPointingToServices(listOf<DomainEntry>(), services).size == 0, "sem dominios: vazio")
}

test "status: e2e — o comando mostra o dominio que leva ao servico publicado", "status-domains-e2e" {
    var statePath = "/tmp/kofcloud-status-dom-" + crypto.randomHex(4) + ".json"
    var registry = Registry(statePath)
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    registry.registerDevice(account, "nb", "pk")
    var deviceId = registry.devicesForAccount(account.id).get(0).id
    registry.publishService(account, deviceId, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    var port = 19751
    var control = ControlPlane(registry, port, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(port, 60), "control no ar")
    var url = "http://127.0.0.1:" + intToString(port)
    var token = loginOrCreate(url, "mel", "segredo")
    var addBody = "{\"service\":\"site\",\"hostname\":\"www.example.com\"}"
    assert(statusOf(httpPostJson(port, "/v1/domains", addBody, token)) == 200, "dominio registrado")
    // A lista do fio, decodificada como o status faz.
    var domainsRaw = httpGetToken(port, "/v1/domains", token)
    var domains = json.decode<List<DomainEntry>>(bodyOf(domainsRaw))
    var services = json.decode<List<Service>>(bodyOf(httpGetToken(port, "/v1/services", token)))
    var pointing = domainsPointingToServices(domains, services)
    assert(pointing.size == 1, "um dominio aponta: " + intToString(pointing.size))
    var line = statusDomainLine(pointing.get(0), services)
    assert(line.indexOf("site <-") >= 0, "linha nomeia o servico: " + line)
    assert(line.indexOf("www.example.com") >= 0, "linha mostra o hostname")
}

test "device: nome com caixa errada ganha aviso (irmao do servico)", "device-case-hint" {
    var devices = listOf<Device>()
    devices.add(Device("id-nb", "acc", "notebook", "pk", "ACTIVE", 0, 0))
    devices.add(Device("id-pc", "acc", "desktop", "pk", "ACTIVE", 0, 0))
    assert(deviceCaseHint(devices, "Notebook").indexOf("notebook") >= 0, "nomeia o existente")
    assert(deviceCaseHint(devices, " Notebook ").indexOf("notebook") >= 0, "trim")
    assert(deviceCaseHint(devices, "DESKTOP").indexOf("desktop") >= 0, "maiuscula tambem")
    assert(deviceCaseHint(devices, "notbook") == "", "sem candidato, sem aviso")
    assert(deviceCaseHint(devices, "") == "", "vazio sem aviso")
    assert(deviceCaseHint(listOf<Device>(), "Notebook") == "", "sem devices, sem aviso")
    assert(deviceCaseHint(devices, "id-nb") == "", "id nao vira sugestao de nome")
}
