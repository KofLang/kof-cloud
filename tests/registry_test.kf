
import kofcloud.control.Registry
import kofcloud.model.Account
import kofcloud.model.Device
import kofcloud.model.Service
import kofcloud.store.Store

String tempStatePath(String name) {
    return "/tmp/kofcloud-test-" + name + "-" + crypto.randomHex(4) + ".json"
}

test "registry: cria conta e recusa handle duplicado" {
    var registry = Registry(tempStatePath("account"))
    var account = registry.createAccount("mel", "mel@example.com", "segredo")
    assert(account.handle == "mel", "handle")
    assert(registry.accountByHandle("mel") != null, "encontrada")
    var duplicated = false
    try {
        registry.createAccount("mel", "outro@example.com", "x")
    } catch (String e) {
        duplicated = true
    }
    assert(duplicated, "handle duplicado recusado")
}

test "registry: token autentica a conta" {
    var registry = Registry(tempStatePath("token"))
    var account = registry.createAccount("mel", "mel@example.com", "segredo")
    var token = registry.issueToken(account.id)
    var resolved = registry.accountByToken(token)
    assert(resolved != null, "token resolve")
    if (resolved != null) {
        assert(resolved.id == account.id, "conta certa")
    }
    assert(registry.accountByToken("kfc_invalido") == null, "token invalido recusado")
}

test "registry: login exige a senha correta" {
    var registry = Registry(tempStatePath("login"))
    registry.createAccount("mel", "mel@example.com", "segredo")
    var token = registry.login("mel", "segredo")
    assert(token.startsWith("kfc_"), "token emitido")
    var rejected = false
    try {
        registry.login("mel", "errada")
    } catch (String e) {
        rejected = true
    }
    assert(rejected, "senha errada recusada")
}

test "registry: registra dispositivo e publica servico com hostname" {
    var registry = Registry(tempStatePath("publish"))
    var account = registry.createAccount("mel", "mel@example.com", "segredo")
    var device = registry.registerDevice(account, "notebook", "pubkey")
    assert(device.status == "ACTIVE", "ativo")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    assert(service.hostname == "site.mel.kofcloud.io", "hostname")
    assert(service.exposure == "PUBLIC", "exposicao")
    assert(service.status == "UNKNOWN", "status inicial")
}

test "registry: PRIVATE nao aparece como rota publica" {
    var registry = Registry(tempStatePath("private"))
    var account = registry.createAccount("mel", "mel@example.com", "segredo")
    var device = registry.registerDevice(account, "notebook", "pubkey")
    var service = registry.publishService(account, device.id, "db", "127.0.0.1", 5432, "http", "PRIVATE", "", "")
    assert(registry.resolveRoute(service.hostname) == null, "sem rota")
    assert(registry.serviceById(service.id) != null, "mas o servico existe")
}

test "registry: revogar dispositivo remove os servicos dele" {
    var registry = Registry(tempStatePath("revoke"))
    var account = registry.createAccount("mel", "mel@example.com", "segredo")
    var device = registry.registerDevice(account, "notebook", "pubkey")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    assert(registry.resolveRoute(service.hostname) != null, "rota antes")
    assert(registry.revokeDevice(account.id, device.id) == true, "revogado")
    var after = registry.deviceById(device.id)
    assert(after != null, "device ainda existe")
    if (after != null) {
        assert(after.status == "REVOKED", "status revogado")
    }
    assert(registry.resolveRoute(service.hostname) == null, "rota removida")
}

test "registry: estado persiste em disco e recarrega" {
    var path = tempStatePath("persist")
    var registry = Registry(path)
    var account = registry.createAccount("mel", "mel@example.com", "segredo")
    registry.registerDevice(account, "notebook", "pubkey")
    var reloaded = Registry(path)
    assert(reloaded.accountByHandle("mel") != null, "conta recarregada")
    assert(reloaded.devicesForAccount(account.id).size == 1, "dispositivo recarregado")
}

test "registry: republicar no mesmo device atualiza a configuracao mutavel", "republish" {
    // Medido: `publishService` devolvia o existente SEM aplicar nada. O
    // `deploy` com porta/exposure/allowlist mudada imprimia "publicado" e o
    // servico seguia com a config velha, enquanto `--plan` prometia
    // "~ vai atualizar". Agora a configuracao mutavel e reescrita.
    var registry = Registry(tempStatePath("republish"))
    var account = registry.createAccount("mel", "mel@example.com", "segredo")
    var device = registry.registerDevice(account, "notebook", "pubkey")
    var first = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")

    var updated = registry.publishService(account, device.id, "site", "127.0.0.1", 9090, "http", "AUTHENTICATED", "GET", "/api/*")
    assert(updated.id == first.id, "mesma identidade (id preservado)")
    assert(updated.hostname == first.hostname, "hostname preservado")
    assert(updated.createdAt == first.createdAt, "createdAt preservado")
    assert(updated.localPort == 9090, "porta atualizada")
    assert(updated.exposure == "AUTHENTICATED", "exposure atualizada")
    assert(updated.allowMethods == "GET", "allowlist atualizada")
    assert(updated.allowPaths == "/api/*", "allowPaths atualizado")

    // O estado em memoria reflete a atualizacao (nao so o retorno).
    var live = registry.serviceById(first.id)
    assert(live != null, "servico existe")
    if (live != null) {
        assert(live.localPort == 9090, "estado atualizado")
    }
    // E persiste: recarregar do disco ve a config nova.
    var reloaded = Registry(registry.path)
    var persisted = reloaded.serviceById(first.id)
    assert(persisted != null, "persistido")
    if (persisted != null) {
        assert(persisted.localPort == 9090, "porta persistida")
        assert(persisted.exposure == "AUTHENTICATED", "exposure persistida")
    }
}

test "registry: republicar preserva status e nao ressuscita suspenso", "republish-status" {
    // Republicar nao e acao de saude: o status que o Agent reportou (ou a
    // suspensao que o operador aplicou) nao pode ser zerado por um deploy.
    var registry = Registry(tempStatePath("republish-status"))
    var account = registry.createAccount("mel", "mel@example.com", "segredo")
    var device = registry.registerDevice(account, "notebook", "pubkey")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    registry.setServiceStatus(service.id, "ONLINE")

    var updated = registry.publishService(account, device.id, "site", "127.0.0.1", 9090, "http", "PUBLIC", "", "")
    assert(updated.status == "ONLINE", "status preservado na republicacao")

    // Suspenso continua suspenso (o deploy nao dessuspende).
    registry.suspendService(account.id, service.id)
    var afterSuspend = registry.publishService(account, device.id, "site", "127.0.0.1", 7070, "http", "PUBLIC", "", "")
    assert(afterSuspend.status == "SUSPENDED", "suspensao preservada")
    assert(afterSuspend.localPort == 7070, "config ainda atualiza")
}

test "registry: republicar sem mudanca nao reescreve (idempotente)", "republish-same" {
    // Mesma config: nada muda, nada e auditado como atualizacao. A
    // idempotencia do deploy depende disso (republicar o manifesto inteiro
    // nao pode inflar a trilha nem a metrica a cada rodada).
    var registry = Registry(tempStatePath("republish-same"))
    var account = registry.createAccount("mel", "mel@example.com", "segredo")
    var device = registry.registerDevice(account, "notebook", "pubkey")
    var first = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    var before = registry.auditCountSince(account.id, "service.updated", 0)
    var again = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    assert(again.id == first.id, "mesmo servico")
    assert(registry.auditCountSince(account.id, "service.updated", 0) == before, "sem auditoria de update")
    assert(serviceConfigEquals(first, again), "config identica")
}
