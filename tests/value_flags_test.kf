import kofcloud.cli.Commands
import kofcloud.cli.Deploy
import kofcloud.cli.Local
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.protocol.Bytes
import kofcloud.store.Store
import testkit.Support

// `extraPositional` e o valor das flags.
//
// Ele pulava o token seguinte so de uma lista literal de flags. Toda flag
// fora dela fazia o VALOR contar como posicional: `incidents --resolve <id>`
// e `webhook set <url> --secret <s>` barrassem sempre com o erro de uso, e a
// flag nunca funcionava (medido: exit 1 antes de qualquer rede).
//
// A lista agora e `valueFlags()` — fonte unica — e o teste trava que toda
// flag lida com `flagValue` esta nela.

// Flags com valor lidas pela CLI. A lista e DERIVADA das fontes reais
// (`flagValue`/`flagValues` em src/kofcloud/cli/*.kf), nao escrita a mao:
// era uma lista literal aqui e por isso `--allow-method`/`--allow-path`
// passaram despercebidos — o `publish --allow-method GET` barrava sempre
// ("argumento a mais") porque o valor contava como posicional.
List<String> flagsReadWithFlagValue() {
    var found = listOf<String>()
    var files = listOf("src/kofcloud/cli/Commands.kf", "src/kofcloud/cli/Deploy.kf", "src/kofcloud/cli/Doctor.kf", "src/kofcloud/cli/Daemon.kf")
    for (var file in files) {
        var raw = File(file).readText()
        var text = ""
        if (raw != null) {
            text = raw
        }
        if (text.length == 0) {
            continue
        }
        for (var opening in listOf("flagValue(args, \"", "flagValues(args, \"")) {
            var cursor = text.indexOf(opening)
            while (cursor >= 0) {
                var start = cursor + opening.length
                var end = text.indexOf("\"", start)
                if (end > start) {
                    var flag = text.substring(start, end)
                    if (found.contains(flag) == false) {
                        found.add(flag)
                    }
                }
                cursor = text.indexOf(opening, end)
            }
        }
    }
    return found
}

test "flags: toda flag com valor esta na lista e o valor nao conta como posicional", "valueflags-unit" {
    var known = valueFlags()
    for (var flag in flagsReadWithFlagValue()) {
        assert(known.contains(flag), "flag com valor ausente da fonte unica: " + flag)
        // O valor da flag nunca vira posicional (com qualquer flag).
        assert(extraPositional(listOf(flag, "valor"), 0) == false, "valor de " + flag + " virou posicional")
        assert(extraPositional(listOf(flag, "valor"), 1) == false, "um posicional permitido")
        // O valor da flag tambem nao e capturado por first/secondPositional:
        // a flag antes do argumento nao corrompe o argumento (defeito real medido).
        assert(firstPositional(listOf(flag, "valor", "alvo")) == "alvo", "primeiro posicional apos " + flag)
        assert(secondPositional(listOf("um", flag, "valor", "dois")) == "dois", "segundo posicional apos " + flag)
    }
    assert(known.size == 23, "23 flags com valor: " + intToString(known.size))
    assert(flagsReadWithFlagValue().size >= 20, "lista derivada das fontes: " + intToString(flagsReadWithFlagValue().size))

    // Posicional de verdade continua barrando (a regra nao ficou frouxa).
    assert(extraPositional(listOf("solto"), 0) == true, "posicional solto barra")
    assert(extraPositional(listOf("--resolve", "id", "solto"), 0) == true, "posicional depois da flag barra")
    assert(extraPositional(listOf<String>(), 0) == false, "nada, nada")
}

test "flags: incidents --resolve chega ao control plane (antes barrava no uso)", "valueflags" {
    var port = 20103
    var registry = Registry("/tmp/kofcloud-vf-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, port, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(port, 60), "control no ar")
    var url = "http://127.0.0.1:" + intToString(port)
    var token = loginOrCreate(url, "mel", "segredo")
    // A sessao vive no HOME do processo, que e compartilhado entre suites:
    // guardar o que havia e restaurar no fim evita deixar um "usuario
    // logado" para os testes seguintes (o doctor_test espera sem sessao).
    var priorSession = readTextOr(sessionPath(), "")
    saveSession(LocalSession("", "mel", token, url))

    // Id inexistente: a CLI passa do uso e o control plane responde 404
    // KCF125 (nao mais "uso: kof cloud incidents ...").
    var code = cmdIncidents(listOf("--resolve", "incidente-que-nao-existe"))
    assert(code == 1, "id inexistente falha no control plane, nao no parse (exit " + intToString(code) + ")")

    // --all sozinho tambem nao e posicional.
    assert(extraPositional(listOf("--all"), 0) == false, "--all nao e posicional")

    if (priorSession.length == 0) {
        File(sessionPath()).delete()
    } else {
        writeTextTo(sessionPath(), priorSession)
    }
}

// Percorre os fontes de comando (`Int cmd*`) e devolve `<cmd>:<flag>` para
// cada `hasFlag(args, ...)` sem `flagDuplicated(args, ...)` na mesma funcao.
// Garante que nenhuma booleana passe despercebida agora nem no futuro.
List<String> booleanFlagsWithoutDupGuard() {
    var missing = listOf<String>()
    var files = listOf("src/kofcloud/cli/Commands.kf", "src/kofcloud/cli/Deploy.kf", "src/kofcloud/cli/Doctor.kf", "src/kofcloud/cli/Daemon.kf")
    for (var file in files) {
        var raw = File(file).readText()
        var text = ""
        if (raw != null) {
            text = raw
        }
        var cursor = text.indexOf("\nInt cmd")
        while (cursor >= 0) {
            var next = text.indexOf("\nInt cmd", cursor + 8)
            var block = ""
            if (next >= 0) {
                block = text.substring(cursor + 1, next)
            } else {
                block = text.substring(cursor + 1)
            }
            var paren = block.indexOf("(")
            var cmdName = "cmd"
            if (paren > 4) {
                cmdName = block.substring(4, paren)
            }
            var scan = block.indexOf("hasFlag(args, \"")
            while (scan >= 0) {
                var start = scan + 15
                var end = block.indexOf("\"", start)
                if (end > start) {
                    var flag = block.substring(start, end)
                    var needle = "flagDuplicated(args, \"" + flag + "\")"
                    if (block.indexOf(needle) < 0) {
                        missing.add(cmdName + ":" + flag)
                    }
                }
                scan = block.indexOf("hasFlag(args, \"", end)
            }
            cursor = next
        }
    }
    return missing
}

Int countHasFlagInCli() {
    var total = 0
    var files = listOf("src/kofcloud/cli/Commands.kf", "src/kofcloud/cli/Deploy.kf", "src/kofcloud/cli/Doctor.kf", "src/kofcloud/cli/Daemon.kf")
    for (var file in files) {
        var raw = File(file).readText()
        var text = ""
        if (raw != null) {
            text = raw
        }
        var cursor = text.indexOf("hasFlag(args, \"")
        while (cursor >= 0) {
            total = total + 1
            cursor = text.indexOf("hasFlag(args, \"", cursor + 15)
        }
    }
    return total
}

test "flags: booleana repetida barra antes de qualquer efeito", "boolean-dup" {
    // 1) Trava derivada dos fontes: toda `hasFlag(args, ...)` tem
    // `flagDuplicated(args, ...)` no mesmo comando.
    var missing = booleanFlagsWithoutDupGuard()
    assert(missing.size == 0, "booleana sem flagDuplicated: " + intToString(missing.size))
    var total = countHasFlagInCli()
    assert(total >= 12, "pelo menos 12 leituras de hasFlag nos comandos: " + intToString(total))

    // 2) Comandos locais sem sessao nem rede: unico passa, repetida barra.
    assert(cmdLogs(listOf("--runtime")) == 0, "--runtime unico passa")
    assert(cmdLogs(listOf("--runtime", "--runtime")) == 1, "--runtime repetido barra")
    assert(cmdServe(listOf("--panel", "--panel")) == 1, "--panel repetido barra")
    assert(cmdServe(listOf("--status-page", "--status-page")) == 1, "--status-page repetido barra")

    // 3) Comandos com control plane (incidents --all, deploy --plan/--check,
    // down --prune): sem a guarda, cada repeticao devolveria 0 normalmente.
    var port = 20104
    var localPort = 20105
    var dbPath = "/tmp/kofcloud-bf-" + crypto.randomHex(4) + ".json"
    var registry = Registry(dbPath)
    var control = ControlPlane(registry, port, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(port, 60), "control no ar")

    var listener = net.listen(localPort)
    var svc = spawn {
        var open = true
        while (open) {
            try {
                var peer = listener.accept()
                var worker = spawn {
                    peer.receive(4096)
                    peer.send(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok"))
                    peer.close()
                }
            } catch (String e) {
                open = false
            }
        }
    }
    assert(waitForPort(localPort, 60), "servico local no ar")

    var url = "http://127.0.0.1:" + intToString(port)
    var token = loginOrCreate(url, "mel", "segredo")
    var devResp = httpPostJson(port, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", token)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(devResp)), "deviceId")
    var mf = "/tmp/kofcloud-bf-mf-" + crypto.randomHex(4) + ".json"
    writeTextTo(mf, "{\"services\":[{\"name\":\"site\",\"port\":" + intToString(localPort) + "}]}")

    var priorSession = readTextOr(sessionPath(), "")
    var priorIdentity = readTextOr(identityPath(), "")
    saveSession(LocalSession("", "mel", token, url))
    saveIdentity(LocalIdentity(deviceId, "", "mel", "nb", "", "pk"))

    assert(cmdIncidents(listOf("--all")) == 0, "--all unico passa")
    assert(cmdIncidents(listOf("--all", "--all")) == 1, "--all duplicado barra")
    assert(cmdDeploy(listOf("--file", mf, "--plan")) == 0, "--plan unico passa")
    assert(cmdDeploy(listOf("--file", mf, "--plan", "--plan")) == 1, "--plan duplicado barra")
    assert(cmdDeploy(listOf("--file", mf, "--check")) == 0, "--check unico passa")
    assert(cmdDeploy(listOf("--file", mf, "--check", "--check")) == 1, "--check duplicado barra")
    assert(cmdDown(listOf("--file", mf, "--prune")) == 0, "--prune unico passa")
    assert(cmdDown(listOf("--file", mf, "--prune", "--prune")) == 1, "--prune duplicado barra")

    if (priorSession.length == 0) {
        File(sessionPath()).delete()
    } else {
        writeTextTo(sessionPath(), priorSession)
    }
    if (priorIdentity.length == 0) {
        File(identityPath()).delete()
    } else {
        writeTextTo(identityPath(), priorIdentity)
    }
    listener.close()
    File(mf).delete()
}

// Comandos que delegam a guarda de posicional a um helper (o `cmd*` e so um
// alias). `cmdFreeze`/`cmdUnfreeze` chamam `runContainment`, que tem a guarda.
List<String> commandsDelegatingArityGuard() {
    return listOf("cmdFreeze", "cmdUnfreeze")
}

test "flags: todo comando da CLI barra posicional sobrando (trava de fonte)", "valueflags-unit" {
    // Medido: `device revoke notebook lixo` revogava `notebook` em silencio
    // (e revoke remove servicos e credenciais do device); `logs lixo` lia o
    // log e ignorava o token; `serve lixo` subia a plataforma; `webhook show
    // lixo` executava o show. Typo virava acao — as vezes destrutiva.
    //
    // Sem captura de stdout, a trava e na fonte: cada `Int cmdXxx(` precisa
    // chamar `extraPositional(` no proprio corpo (ou delegar a um helper que
    // chama). Um comando novo sem guarda quebra aqui.
    var raw = File("src/kofcloud/cli/Commands.kf").readText()
    var text = ""
    if (raw != null) {
        text = raw
    }
    if (text.length == 0) {
        return
    }
    var delegating = commandsDelegatingArityGuard()
    var checked = 0
    var cursor = text.indexOf("Int cmd")
    while (cursor >= 0) {
        var nameEnd = text.indexOf("(", cursor)
        var name = text.substring(cursor + 4, nameEnd)
        // Corpo do comando: ate o proximo `Int cmd` (ou fim).
        var next = text.indexOf("Int cmd", nameEnd)
        var bodyEnd = text.length
        if (next >= 0) {
            bodyEnd = next
        }
        var body = text.substring(nameEnd, bodyEnd)
        if (delegating.contains(name) == false) {
            assert(body.indexOf("extraPositional(") >= 0, "comando sem guarda de posicional: " + name)
            checked = checked + 1
        }
        cursor = next
    }
    assert(checked >= 30, "comandos conferidos: " + intToString(checked))
    // O helper dos freeze tem a guarda (senao a delegacao seria mentira).
    var helperStart = text.indexOf("Int runContainment(")
    assert(helperStart >= 0, "runContainment existe")
    var helperBody = text.substring(helperStart, text.indexOf("Int cmdIncidents(", helperStart))
    assert(helperBody.indexOf("extraPositional(") >= 0, "runContainment tem a guarda")
}
