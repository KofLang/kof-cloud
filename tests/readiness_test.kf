import kofcloud.cli.Commands
import kofcloud.cli.Doctor
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.store.Store
import testkit.Support

// F16 s3 — readiness do control plane. O `/v1/health` respondia `200 ok`
// mesmo com o arquivo de estado existente e ilegivel: o processo subia
// VAZIO e o balanceador/status page davam verde sobre perda de dados.
// A sonda e PURA (loadStatus -> codigo+corpo) e o `serve` recusa subir com
// estado ilegivel (fail-closed); o arquivo nunca e tocado.

test "readiness: sonda pura (corrupt 503, absent/ok 200)", "readiness-unit" {
    var corrupt = readinessFor("corrupt")
    need(corrupt.code == 503, "falhou")
    need(corrupt.body.indexOf("\"ok\":\"false\"") >= 0, "falhou")
    need(corrupt.body.indexOf("\"ready\":\"false\"") >= 0, "falhou")
    need(corrupt.body.indexOf("\"state\":\"corrupt\"") >= 0, "falhou")

    var absent = readinessFor("absent")
    need(absent.code == 200, "falhou")
    need(absent.body.indexOf("\"ready\":\"true\"") >= 0, "falhou")
    need(absent.body.indexOf("\"state\":\"absent\"") >= 0, "falhou")

    var ok = readinessFor("ok")
    need(ok.code == 200, "falhou")
    need(ok.body.indexOf("\"ready\":\"true\"") >= 0, "falhou")
    need(ok.body.indexOf("\"state\":\"ok\"") >= 0, "falhou")

    // Nenhum corpo carrega credencial nem conta (mesma regra do /v1/health).
    var all = corrupt.body + absent.body + ok.body
    need(all.indexOf("kfc_") < 0, "falhou")
    need(all.indexOf("kfs_") < 0, "falhou")

    // Recusa do serve: pura, cita o arquivo e garante que nada foi tocado.
    var refusal = serveCorruptRefusal("/tmp/estado.json")
    need(refusal.indexOf("recusado") >= 0, "falhou")
    need(refusal.indexOf("/tmp/estado.json") >= 0, "falhou")
    need(refusal.indexOf("NAO foi tocado") >= 0, "falhou")
    need(refusal.indexOf("state-backup") >= 0, "falhou")
}

test "readiness: e2e — corrupt responde 503 e o serve recusa subir", "readiness-e2e" {
    // O `loadStatus` e o veredito da CARGA (construtor), nao do estado atual:
    // para exercitar o 503 o arquivo precisa nascer ilegivel ANTES.
    var port = 18084
    var path = "/tmp/kofcloud-ready-" + crypto.randomHex(4) + ".json"
    writeTextTo(path, "{ isto nao e estado }")
    var registry = Registry(path)
    need(registry.loadStatus == "corrupt", "falhou")

    var control = ControlPlane(registry, port, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(port, 60), "falhou")

    var broken = httpGetRaw(port, "/v1/health", "127.0.0.1")
    need(statusOf(broken) == 503, "falhou")
    need(bodyOf(broken).indexOf("\"state\":\"corrupt\"") >= 0, "falhou")
    need(bodyOf(broken).indexOf("\"ready\":\"false\"") >= 0, "falhou")

    // Fail-closed na partida: o mesmo arquivo ilegivel faz o `serve` recusar
    // (exit 1) e o arquivo continua intacto.
    var code = cmdServe(listOf("--state", path, "--control-port", "18085", "--tunnel-port", "18086", "--http-port", "18087"))
    need(code == 1, "falhou")
    var still = readTextOr(path, "")
    need(still.indexOf("isto nao e estado") >= 0, "falhou")
}

test "readiness: estado divergente no disco desvia do ready (503 drifted)", "readiness-drift" {
    // F16 s3-cont: outro processo escrevendo o MESMO --state faz o proximo
    // save() deste sobrescrever o que la estava. O health precisa dizer
    // "nao-pronto" (degrau para fora da rota) — e o doctor precisa dizer
    // que NAO e corrupcao (a acao e parar o outro, nao restaurar backup).
    var port = 18091
    var path = "/tmp/kofcloud-drift-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    need(registry.stateChangedOnDisk() == false, "falhou")
    registry.createAccount("mel", "m@e.com", "segredo")
    var stable = readTextOr(path, "")
    need(stable.length > 0, "falhou")
    var loaded = Registry(path)
    need(loaded.stateChangedOnDisk() == false, "falhou")
    // Outro processo (ou o operador) escreve o mesma arquivo.
    writeTextTo(path, stable + " ")
    need(loaded.stateChangedOnDisk(), "falhou")
    var drifted = readinessForWith(loaded.loadStatus, loaded.stateChangedOnDisk())
    need(drifted.code == 503, "falhou")
    need(drifted.body.indexOf("\"state\":\"drifted\"") >= 0, "falhou")
    need(drifted.body.indexOf("\"ready\":\"false\"") >= 0, "falhou")
    need(drifted.body.indexOf("kfc_") < 0, "falhou")
    // Corrupcao tem precedencia sobre divergencia.
    var corruptWins = readinessForWith("corrupt", true)
    need(corruptWins.body.indexOf("\"state\":\"corrupt\"") >= 0, "falhou")
    // Health limpo nao muda.
    need(readinessForWith("ok", false).code == 200, "falhou")
    // Doctor: divergencia NAO manda fazer backup nem restaurar.
    var driftLine = doctorControlLine("http://127.0.0.1:" + intToString(port), "{\"state\":\"drifted\"}", "HTTP 503 from http://127.0.0.1/v1/health")
    need(driftLine.startsWith("FALHA"), "falhou")
    need(driftLine.indexOf("outro processo") >= 0, "falhou")
    need(driftLine.indexOf("NAO faca backup") >= 0, "falhou")
    need(driftLine.indexOf("ilegivel") < 0, "falhou")
    var corruptLine = doctorControlLine("http://127.0.0.1:1", "{\"state\":\"corrupt\"}", "HTTP 503 from x/v1/health")
    need(corruptLine.indexOf("ilegivel") >= 0, "falhou")
}

test "readiness: e2e — escritor concorrente derruba o ready do processo vivo", "readiness-drift-e2e" {
    var port = 18092
    var path = "/tmp/kofcloud-drift-e2e-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    registry.createAccount("mel", "m@e.com", "segredo")
    var control = ControlPlane(registry, port, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(port, 60), "falhou")
    // Outro processo com o mesmo --state grava ANTES de a sonda perguntar.
    writeTextTo(path, readTextOr(path, "") + " ")
    var driftedRaw = httpGetRaw(port, "/v1/health", "127.0.0.1")
    var drifted = statusOf(driftedRaw)
    need(drifted == 503, "falhou")
    need(bodyOf(driftedRaw).indexOf("\"state\":\"drifted\"") >= 0, "falhou")
}
