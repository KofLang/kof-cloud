import kofcloud.agent.Agent
import kofcloud.control.ControlPlane
import kofcloud.control.Metrics
import kofcloud.control.Registry
import kofcloud.edge.EdgeState
import kofcloud.edge.HttpFront
import kofcloud.edge.Metrics
import kofcloud.edge.Tunnel
import kofcloud.store.Store
import testkit.Support
import kofcloud.util.Limits

// Observabilidade minima do Edge (Fase 8 parcial): contadores, gauges e
// latencia via `observability.*`, sem cardinalidade por cliente — so
// metadados operacionais agregados. Nada de conteudo, credencial, chave,
// hostname ou corpo passa para as metricas.

Int metricValue(String exposition, String name) {
    for (var line in exposition.split("\n")) {
        var trimmed = line.trim()
        if (trimmed.startsWith(name + " ")) {
            return parseIntSafe(trimmed.substring(name.length + 1).trim(), -1)
        }
    }
    return -1
}

Bool metricHas(String exposition, String name) {
    return metricValue(exposition, name) >= 0
}

test "metricas: nomes e saidas no formato Prometheus", "metrics" {
    noteTunnelAccepted(1)
    noteHttpFinished("ok", "", 120, 450, 9)
    noteHttpFinished("denied", "KCF100", 100, 60, 2)
    var exposition = observability.metrics()
    assert(metricHas(exposition, "kofcloud_edge_tunnel_accepted_total"), "tuneis aceitos")
    assert(metricHas(exposition, "kofcloud_edge_http_requests_total"), "requisicoes")
    assert(metricHas(exposition, "kofcloud_edge_http_denied_total"), "negadas")
    assert(metricHas(exposition, "kofcloud_edge_http_denied_total_no_route"), "negada por motivo")
    // Mapeamento KCF→sufixo travado: cada negada do front tem seu contador;
    // KCF106 (streams) cai no fallback _other (sem sufixo proprio, por desenho).
    noteHttpFinished("denied", "KCF101", 10, 20, 1)
    assert(metricHas(observability.metrics(), "kofcloud_edge_http_denied_total_auth_required"), "auth")
    noteHttpFinished("denied", "KCF102", 10, 20, 1)
    assert(metricHas(observability.metrics(), "kofcloud_edge_http_denied_total_device_offline"), "offline")
    noteHttpFinished("denied", "KCF103", 10, 20, 1)
    assert(metricHas(observability.metrics(), "kofcloud_edge_http_denied_total_service_down"), "down")
    noteHttpFinished("denied", "KCF107", 10, 20, 1)
    assert(metricHas(observability.metrics(), "kofcloud_edge_http_denied_total_rate_limited"), "rate")
    noteHttpFinished("denied", "KCF108", 10, 20, 1)
    assert(metricHas(observability.metrics(), "kofcloud_edge_http_denied_total_service_overloaded"), "sobrecarga")
    noteHttpFinished("denied", "KCF109", 10, 20, 1)
    assert(metricHas(observability.metrics(), "kofcloud_edge_http_denied_total_waf_denied"), "waf")
    noteHttpFinished("denied", "KCF111", 10, 20, 1)
    assert(metricHas(observability.metrics(), "kofcloud_edge_http_denied_total_waf_allow_denied"), "allowlist")
    noteHttpFinished("denied", "KCF106", 10, 20, 1)
    assert(metricHas(observability.metrics(), "kofcloud_edge_http_denied_total_other"), "streams cai no fallback")
    // Os vizinhos da mesma familia tinham sufixo e KCF116 caia no _other:
    // "cabeçalho grande demais" ficava indistinguivel de qualquer negada
    // sem motivo mapeado. A invariante abaixo trava o conjunto inteiro.
    noteHttpFinished("denied", "KCF116", 10, 20, 1)
    assert(metricHas(observability.metrics(), "kofcloud_edge_http_denied_total_headers_too_large"), "cabecalho grande")
    noteHttpFinished("denied", "KCF118", 10, 20, 1)
    assert(metricHas(observability.metrics(), "kofcloud_edge_http_denied_total_invalid_framing"), "enquadramento")
    noteHttpFinished("denied", "KCF119", 10, 20, 1)
    assert(metricHas(observability.metrics(), "kofcloud_edge_http_denied_total_invalid_host"), "host ambiguo")
    noteHttpFinished("denied", "KCF132", 10, 20, 1)
    assert(metricHas(observability.metrics(), "kofcloud_edge_http_denied_total_invalid_request_line"), "linha de requisicao")
    noteHttpFinished("denied", "KCF133", 10, 20, 1)
    assert(metricHas(observability.metrics(), "kofcloud_edge_http_denied_total_invalid_header_line"), "linha de header")
    noteHttpFinished("denied", "KCF110", 10, 20, 1)
    assert(metricHas(observability.metrics(), "kofcloud_edge_http_denied_total_body_too_large"), "corpo grande")
    assert(metricHas(exposition, "kofcloud_edge_http_request_bytes_total"), "bytes de pedido")
    assert(metricHas(exposition, "kofcloud_edge_http_response_bytes_total"), "bytes de resposta")
    assert(metricValue(exposition, "kofcloud_edge_tunnel_sessions_open") == 1, "gauge de sessoes")
}

test "metricas: falhas de upstream contam por sufixo proprio", "metrics-upstream" {
    // Cada falha de relay com causa conhecida tem sufixo; antes KCF105 (vazio)
    // caia no contador generico e nao dava para separar "servico devolveu
    // nada" de "stream resetado".
    noteHttpFinished("upstream_error", "KCF112", 10, 0, 1)
    assert(metricHas(observability.metrics(), "kofcloud_edge_http_upstream_errors_total_timeout"), "timeout")
    noteHttpFinished("upstream_error", "KCF115", 10, 0, 1)
    assert(metricHas(observability.metrics(), "kofcloud_edge_http_upstream_errors_total_response_too_large"), "resposta grande")
    noteHttpFinished("upstream_error", "KCF131", 10, 0, 1)
    assert(metricHas(observability.metrics(), "kofcloud_edge_http_upstream_errors_total_invalid_response"), "resposta invalida")
    noteHttpFinished("upstream_error", "KCF105", 10, 0, 1)
    assert(metricHas(observability.metrics(), "kofcloud_edge_http_upstream_errors_total_empty_response"), "resposta vazia")
}

test "metricas: recusas de tunel contam por motivo", "metrics-tunnel" {
    // Contadores zerados podem nao aparecer no export: -1 = "ainda zero".
    var rawBefore = metricValue(observability.metrics(), "kofcloud_edge_tunnel_refused_total")
    var before = rawBefore
    if (before < 0) {
        before = 0
    }
    noteTunnelRefused("DEVICE_REVOKED")
    var exposition = observability.metrics()
    var after = metricValue(exposition, "kofcloud_edge_tunnel_refused_total")
    assert(after == before + 1, "recusa contada")
    assert(metricHas(exposition, "kofcloud_edge_tunnel_refused_total_revoked_device"), "motivo contado")
    // Mapeamento motivo→sufixo travado: cada motivo do refuseTunnel tem
    // seu contador; AUTH_FAILED cai no fallback _auth (sem sufixo proprio).
    noteTunnelRefused("VERSION_UNSUPPORTED")
    assert(metricHas(observability.metrics(), "kofcloud_edge_tunnel_refused_total_version"), "versao")
    noteTunnelRefused("DEVICE_UNKNOWN")
    assert(metricHas(observability.metrics(), "kofcloud_edge_tunnel_refused_total_unknown_device"), "desconhecido")
    noteTunnelRefused("DEVICE_SUSPENDED")
    assert(metricHas(observability.metrics(), "kofcloud_edge_tunnel_refused_total_suspended_device"), "suspenso")
    noteTunnelRefused("LINE_OVERFLOW")
    assert(metricHas(observability.metrics(), "kofcloud_edge_tunnel_refused_total_line_overflow"), "overflow")
    noteTunnelRefused("IDLE_TIMEOUT")
    assert(metricHas(observability.metrics(), "kofcloud_edge_tunnel_refused_total_idle_timeout"), "idle")
    noteTunnelRefused("AUTH_FAILED")
    assert(metricHas(observability.metrics(), "kofcloud_edge_tunnel_refused_total_auth"), "auth cai no fallback")
    noteTunnelClosed(0)
    assert(metricValue(observability.metrics(), "kofcloud_edge_tunnel_sessions_open") == 0, "gauge zera ao fechar")
}

test "metricas: latencia cai em faixa e a faixa conta", "metrics-latency" {
    // Pura: a classificacao vem da lista unica `latencyBucketLimitsMs`,
    // entao os rotulos sao derivados (nunca digitados). Bordas inclusivas.
    assert(latencyBucketLimitsMs().get(0) == 50, "primeira faixa = 50 ms")
    assert(latencyBucketSuffix(0) == "_le_50", "zero na primeira faixa")
    assert(latencyBucketSuffix(50) == "_le_50", "borda inclusiva em 50")
    assert(latencyBucketSuffix(51) == "_le_100", "acima de 50 cai na proxima")
    assert(latencyBucketSuffix(250) == "_le_250", "borda inclusiva em 250")
    assert(latencyBucketSuffix(999) == "_le_1000", "perto do teto de 1 s")
    assert(latencyBucketSuffix(2000) == "_le_2000", "borda inclusiva no ultimo limite")
    assert(latencyBucketSuffix(2001) == "_gt_2000", "acima do ultimo limite")
    assert(latencyBucketSuffix(-5) == "_le_50", "relogio ajustado nao some da contagem")

    // E2E na mesma funcao do produto: uma requisicao lenta (>= 60 ms) tem
    // que aparecer na faixa certa e a soma das faixas nao pode encolher.
    var before = metricValue(observability.metrics(), "kofcloud_edge_http_request_latency_ms_le_100")
    if (before < 0) {
        before = 0
    }
    noteHttpFinished("ok", "", 10, 20, 75)
    var exposition = observability.metrics()
    assert(metricValue(exposition, "kofcloud_edge_http_request_latency_ms_le_100") == before + 1, "75 ms conta em le_100")
    // O histograma continua sendo alimentado pela mesma chamada (sum+count).
    assert(metricHas(exposition, "kofcloud_edge_http_request_latency_ms_count"), "histograma segue contando")
}

test "metricas: Edge real conta ok/negada e bytes fim a fim", "metrics-e2e" {
    var localSvc = 19541
    var controlPort = 19542
    var tunnelPort = 19543
    var httpPort = 19544

    var app = web.app()
    app.get("/") { return "svc-metrics" }
    var server = spawn { app.listen(localSvc) }
    assert(waitForPort(localSvc, 60), "servico local no ar")

    var registry = Registry("/tmp/kofcloud-met-" + crypto.randomHex(4) + ".json")
    var edgeState = EdgeState(registry)
    var edgeStop = "/tmp/kofcloud-met-edge-" + crypto.randomHex(4) + ".txt"
    var agentStop = "/tmp/kofcloud-met-agent-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    File(agentStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, "", edgeStop) }
    var httpTask = spawn { serveHttp(edgeState, httpPort, limitMaxBodyBytes(), edgeStop) }
    assert(waitForPort(controlPort, 60), "control no ar")
    assert(waitForPort(tunnelPort, 60), "tunel no ar")
    assert(waitForPort(httpPort, 60), "http no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var account = json.decode<Map<String, String>>(bodyOf(created))
    var accountToken = mapField(account, "token")
    var accountId = mapField(account, "accountId")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pubkey\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"" + intToString(localSvc) + "\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    assert(statusOf(httpPostJson(controlPort, "/v1/services", pubBody, accountToken)) == 200, "PUBLIC publicado")

    var requestsBefore = metricValue(observability.metrics(), "kofcloud_edge_http_requests_total")
    var deniedBefore = metricValue(observability.metrics(), "kofcloud_edge_http_denied_total")

    // sem tunel: negada conta como denied/device_offline
    var offline = httpGetRaw(httpPort, "/", "site.mel.kofcloud.io")
    assert(statusOf(offline) == 503, "offline -> 503")

    var config = AgentConfig("http://127.0.0.1:" + intToString(controlPort), deviceId, accountId, accountToken, "", agentStop, "127.0.0.1", tunnelPort, 100)
    var agentTask = spawn { runAgent(config, true) }
    var online = false
    var attempts = 100
    while (attempts > 0 && online == false) {
        online = edgeState.isOnline(deviceId)
        if (online == false) {
            time.sleep(50)
            attempts = attempts - 1
        }
    }
    assert(online, "agent registrado no edge")

    var ok = httpGetRaw(httpPort, "/", "site.mel.kofcloud.io")
    assert(statusOf(ok) == 200, "roteia com tunel")
    assert(bodyOf(ok) == "svc-metrics", "corpo do servico")

    var unknown = httpGetRaw(httpPort, "/", "naoexiste.mel.kofcloud.io")
    assert(statusOf(unknown) == 404, "desconhecido -> 404")

    var exposition = observability.metrics()
    assert(metricValue(exposition, "kofcloud_edge_http_requests_total") == requestsBefore + 3, "tres requisicoes contadas")
    assert(metricValue(exposition, "kofcloud_edge_http_denied_total") == deniedBefore + 2, "duas negadas contadas")
    assert(metricHas(exposition, "kofcloud_edge_http_denied_total_device_offline"), "offline por motivo")
    assert(metricHas(exposition, "kofcloud_edge_http_denied_total_no_route"), "sem rota por motivo")
    assert(metricHas(exposition, "kofcloud_edge_http_request_latency_ms_count"), "latencia amostrada")
    assert(metricValue(exposition, "kofcloud_edge_http_request_bytes_total") >= 0, "bytes somados")
    assert(metricValue(observability.metrics(), "kofcloud_edge_tunnel_accepted_total") >= 1, "tunel contado")

    writeTextTo(agentStop, "stop")
    time.sleep(1500)
    assert(edgeState.isOnline(deviceId) == false, "agente encerrou a sessao")
    writeTextTo(edgeStop, "stop")
    time.sleep(1000)
    File(agentStop).delete()
    File(edgeStop).delete()
}

test "metricas: exposicao nunca carrega dado de cliente", "metrics-privacy" {
    noteHttpFinished("denied", "KCF101", 80, 50, 1)
    var exposition = observability.metrics()
    assert(exposition.indexOf("kfc_") < 0, "sem token de conta")
    assert(exposition.indexOf("kfs_") < 0, "sem token de servico")
    assert(exposition.indexOf("kofcloud.io") < 0, "sem hostname")
    assert(exposition.indexOf("Authorization") < 0, "sem header")
    assert(metricHas(exposition, "kofcloud_edge_http_denied_total_auth_required"), "motivo agregado sim")
}

test "metricas: GET /metrics expos sem auth e contadores do control plane", "metrics-endpoint" {
    var controlPort = 19545
    var registry = Registry("/tmp/kofcloud-metep-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control plane no ar")

    // Sem autenticacao, igual ao /v1/health: so agregados.
    var exposition = httpGetRaw(controlPort, "/v1/metrics", "127.0.0.1")
    assert(statusOf(exposition) == 200, "/metrics 200 sem token")
    assert(bodyOf(exposition).indexOf("kofcloud_control_") < 0 || metricHas(bodyOf(exposition), "kofcloud_control_accounts_created_total"), "export Prometheus")

    var accountsBefore = metricValue(bodyOf(exposition), "kofcloud_control_accounts_created_total")
    if (accountsBefore < 0) {
        accountsBefore = 0
    }

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    assert(statusOf(created) == 200, "conta criada")
    var account = json.decode<Map<String, String>>(bodyOf(created))
    var accountToken = mapField(account, "token")

    var logged = httpPostJson(controlPort, "/v1/login", "{\"handle\":\"mel\",\"password\":\"segredo\"}", "")
    assert(statusOf(logged) == 200, "login ok")

    var device = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", accountToken)
    assert(statusOf(device) == 200, "device registrado")
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(device)), "deviceId")

    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    var published = httpPostJson(controlPort, "/v1/services", pubBody, accountToken)
    assert(statusOf(published) == 200, "servico publicado")
    var serviceId = mapField(json.decode<Map<String, String>>(bodyOf(published)), "id")

    var minted = httpPostJson(controlPort, "/v1/services/token", "{\"serviceId\":\"" + serviceId + "\"}", accountToken)
    assert(statusOf(minted) == 200, "token emitido")

    var domReg = httpPostJson(controlPort, "/v1/domains", "{\"hostname\":\"api.example.com\",\"service\":\"site\"}", accountToken)
    assert(statusOf(domReg) == 200, "dominio registrado")

    var removed = httpPostJson(controlPort, "/v1/services/remove", "{\"serviceId\":\"" + serviceId + "\"}", accountToken)
    assert(statusOf(removed) == 200, "servico removido")

    var revoked = httpPostJson(controlPort, "/v1/devices/revoke", "{\"deviceId\":\"" + deviceId + "\"}", accountToken)
    assert(statusOf(revoked) == 200, "device revogado")

    var domDel = httpPostJson(controlPort, "/v1/domains/remove", "{\"hostname\":\"api.example.com\"}", accountToken)
    assert(statusOf(domDel) == 404, "dominio caiu com o servico (poda)")

    var after = bodyOf(httpGetRaw(controlPort, "/v1/metrics", "127.0.0.1"))
    assert(metricValue(after, "kofcloud_control_accounts_created_total") == accountsBefore + 1, "conta contada")
    assert(metricHas(after, "kofcloud_control_logins_total"), "login contado")
    assert(metricHas(after, "kofcloud_control_devices_registered_total"), "device contado")
    assert(metricHas(after, "kofcloud_control_devices_revoked_total"), "revogacao contada")
    assert(metricHas(after, "kofcloud_control_services_published_total"), "publicacao contada")
    assert(metricHas(after, "kofcloud_control_services_removed_total"), "remocao contada")
    assert(metricHas(after, "kofcloud_control_service_tokens_issued_total"), "token contado")
    assert(metricHas(after, "kofcloud_control_domains_registered_total"), "dominio contado")
    assert(after.indexOf("mel@") < 0, "sem email")
    assert(after.indexOf("api.example.com") < 0, "sem hostname")
}

test "metricas: contadores do control plane tambem valem sem HTTP", "metrics-registry" {
    var registry = Registry("/tmp/kofcloud-metreg-" + crypto.randomHex(4) + ".json")
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    registry.issueServiceToken(mel.id, service.id)
    registry.registerCustomDomain(mel.id, "loja.example.com", service.id)
    registry.verifyCustomDomainWith(mel.id, "loja.example.com", listOf("10.0.0.1"))
    assert(registry.removeService(mel.id, service.id) == true, "servico removido")
    var exposition = observability.metrics()
    assert(metricHas(exposition, "kofcloud_control_services_published_total"), "publicacao sem HTTP conta")
    assert(metricHas(exposition, "kofcloud_control_domains_verified_total") || metricHas(exposition, "kofcloud_control_domains_registered_total"), "dominio sem HTTP conta")
}

test "metricas: tamanho da resposta cai em faixa (KiB) e conta", "metrics-size" {
    // Pura: rotulos derivados da lista unica responseSizeBucketLimitsKb().
    assert(responseSizeBucketSuffix(0) == "_kb_le_1", "zero na menor faixa")
    assert(responseSizeBucketSuffix(1024) == "_kb_le_1", "1 KiB inclusivo")
    assert(responseSizeBucketSuffix(1025) == "_kb_le_4", "acima de 1 KiB")
    assert(responseSizeBucketSuffix(16384) == "_kb_le_16", "16 KiB inclusivo")
    assert(responseSizeBucketSuffix(1048576) == "_kb_le_1024", "1 MiB inclusivo")
    assert(responseSizeBucketSuffix(1048577) == "_kb_gt_1024", "acima de 1 MiB")
    var limits = responseSizeBucketLimitsKb()
    assert(limits.size >= 3, "faixas suficientes")
    assert(limits.get(limits.size - 1) == 1024, "ultima faixa = 1 MiB")

    // Contagem real pela funcao do produto.
    var before = metricValue(observability.metrics(), "kofcloud_edge_http_response_bytes_total_size_kb_le_16")
    if (before < 0) {
        before = 0
    }
    noteHttpFinished("ok", "", 10, 16384, 5)
    var exposition = observability.metrics()
    assert(metricValue(exposition, "kofcloud_edge_http_response_bytes_total_size_kb_le_16") == before + 1, "16 KiB conta na faixa")

    // Resposta zero nao entra na faixa (nao e relay): com uma resposta real
    // de 1 KiB antes e outra depois, a le_1 nao pode subir duas vezes.
    noteHttpFinished("ok", "", 10, 1024, 5)
    var oneKb = metricValue(observability.metrics(), "kofcloud_edge_http_response_bytes_total_size_kb_le_1")
    if (oneKb < 0) {
        oneKb = 0
    }
    noteResponseSize(0)
    assert(metricValue(observability.metrics(), "kofcloud_edge_http_response_bytes_total_size_kb_le_1") == oneKb, "zero nao conta")
}

test "metricas: todo KCF passado ao noteHttpFinished tem sufixo (invariante de fonte)", "metrics-invariant" {
    // Le as proprias fontes: cada KCF que o front passa a noteHttpFinished
    // precisa de um ramo em Metrics.kf — senao cai no _other e o operador
    // nao distingue a causa. Ideia surgida do KCF116 sem sufixo.
    var frontRaw = File("src/kofcloud/edge/HttpFront.kf").readText()
    var metricsRaw = File("src/kofcloud/edge/Metrics.kf").readText()
    var httpFront = ""
    var metrics = ""
    if (frontRaw != null) {
        httpFront = frontRaw
    }
    if (metricsRaw != null) {
        metrics = metricsRaw
    }
    if (httpFront.length == 0 || metrics.length == 0) {
        return
    }
    var body = metrics.substring(metrics.indexOf("void noteHttpFinished"), metrics.indexOf("// Streams abertos no relay"))
    // Denominadores explicitos: KCF106 e por desenho sem sufixo (fallback
    // _other documentado); os demais precisam estar mapeados.
    var exempt = listOf("KCF106")
    var missing = listOf<String>()
    for (var code in listOf("KCF100", "KCF101", "KCF102", "KCF103", "KCF105", "KCF107", "KCF108", "KCF109", "KCF110", "KCF111", "KCF112", "KCF115", "KCF116", "KCF118", "KCF119", "KCF131", "KCF132", "KCF133")) {
        if (httpFront.indexOf("\"" + code + "\"") < 0) {
            continue
        }
        if (body.indexOf("\"" + code + "\"") < 0) {
            missing.add(code)
        }
    }
    var detail = ""
    for (var code in missing) {
        detail = detail + " " + code
    }
    assert(missing.size == 0, "emitidos sem sufixo em Metrics.kf:" + detail)
    for (var code in exempt) {
        assert(body.indexOf("\"" + code + "\"") < 0, code + " nao deveria ter ramo proprio")
    }
}
