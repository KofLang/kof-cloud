import kofcloud.agent.Agent
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.edge.EdgeState
import kofcloud.edge.HttpFront
import kofcloud.edge.Tunnel
import kofcloud.cli.Commands
import kofcloud.cli.Usage
import kofcloud.store.Store
import kofcloud.util.Limits
import kofcloud.util.Text
import testkit.Support

// Uso por conta (F18 s4 — billing externo): o Edge acumula requests/bytes
// dos pedidos ROTEADOS no Registry (a conta vem do servico, nunca do
// cliente); GET /v1/usage e `kof cloud usage` leem o total da propria
// conta. Recusas de plataforma nao sao uso. Persistido no estado.

String usagePath(String name) {
    return "/tmp/kofcloud-usage-" + name + "-" + crypto.randomHex(4) + ".json"
}

test "usage: contadores por conta e escopo do dono", "usage-unit" {
    // Caminho fixo na variavel: usagePath e impura (randomHex por chamada) —
    // chamar de novo para o reload abriria OUTRO arquivo (medido: reload
    // via status=absent).
    var unitPath = usagePath("unit")
    var registry = Registry(unitPath)
    var mel = registry.createAccount("mel", "mel@e.com", "segredo")
    var ana = registry.createAccount("ana", "ana@e.com", "segredo")
    // Sem entrada: zeros honestos (a CLI imprime "sem uso", nunca inventa).
    var zero = registry.usageFor(mel.id)
    need(zero.requests == "0" && zero.bytesIn == "0" && zero.bytesOut == "0", "falhou")
    // Acumula: 3 pedidos, bytes somados.
    registry.noteUsage(mel.id, 100, 200)
    registry.noteUsage(mel.id, 30, 40)
    registry.noteUsage(mel.id, 1, 2)
    var melUsage = registry.usageFor(mel.id)
    need(melUsage.requests == "3", "falhou")
    need(melUsage.bytesIn == "131", "falhou")
    need(melUsage.bytesOut == "242", "falhou")
    // Escopo: ana ve zeros (conta alheia nao existe para o fio).
    var anaUsage = registry.usageFor(ana.id)
    need(anaUsage.requests == "0", "falhou")
    // Conta vazia no id: no-op (defesa do chamador).
    registry.noteUsage("", 999, 999)
    var emptyUse = registry.usageFor("")
    need(emptyUse.requests == "0", "falhou")
    // Persistencia: o noteUsage nao grava disco por request (seria I/O por
    // request); o uso vai junto no proximo save() de mutacao — aqui a
    // gravacao e explicita e o estado recarregado ve os mesmos numeros.
    registry.save()
    var reloaded = Registry(unitPath)
    var again = reloaded.usageFor(mel.id)
    need(reloaded.loadStatus == "ok", "falhou")
    need(again.requests == "3", "falhou")
    need(again.bytesIn == "131", "falhou")
}

test "usage: e2e — relay real acumula no dono; recusa nao conta; outra conta nao ve", "usage-e2e" {
    var localSvc = 20294
    var controlPort = 20295
    var tunnelPort = 20296
    var httpPort = 20297

    var app = web.app()
    app.get("/") { return "svc-usage" }
    var server = spawn { app.listen(localSvc) }
    need(waitForPort(localSvc, 60), "falhou")

    var registry = Registry(usagePath("e2e"))
    var edgeState = EdgeState(registry)
    var edgeStop = "/tmp/kofcloud-usage-edge-" + crypto.randomHex(4) + ".txt"
    var agentStop = "/tmp/kofcloud-usage-agent-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    File(agentStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, "", edgeStop) }
    var httpTask = spawn { serveHttp(edgeState, httpPort, limitMaxBodyBytes(), edgeStop) }
    need(waitForPort(controlPort, 60), "falhou")
    need(waitForPort(tunnelPort, 60), "falhou")
    need(waitForPort(httpPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var account = json.decode<Map<String, String>>(bodyOf(created))
    var token = mapField(account, "token")
    var accountId = mapField(account, "accountId")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pubkey\"}", token)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"" + intToString(localSvc) + "\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    need(statusOf(httpPostJson(controlPort, "/v1/services", pubBody, token)) == 200, "falhou")

    // Outra conta no mesmo control plane (escopo do fio).
    var created2 = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"ana\",\"email\":\"a@e.com\",\"password\":\"segredo\"}", "")
    var anaToken = mapField(json.decode<Map<String, String>>(bodyOf(created2)), "token")

    // Antes do connect: recusa 404 (KCF100) — nao pode contar como uso.
    // Servico publicado mas sem tunel: o Edge responde 503 KCF102 (device
    // offline) — e recusa de plataforma, sem uso a precificar.
    need(statusOf(httpGetRaw(httpPort, "/", "site.mel.kofcloud.io")) == 503, "falhou")
    var before = httpGetToken(controlPort, "/v1/usage", token)
    need(mapField(json.decode<Map<String, String>>(bodyOf(before)), "requests") == "0", "falhou")

    // Agent conecta e o relay roteia: 3 pedidos ok acumulam no dono.
    var config = AgentConfig("http://127.0.0.1:" + intToString(controlPort), deviceId, accountId, token, "", agentStop, "127.0.0.1", tunnelPort, 500)
    var agentTask = spawn { runAgent(config, true) }
    var online = false
    var attempts = 100
    while (attempts > 0 && online == false) {
        online = edgeState.isOnline(deviceId)
        if (online == false) {
            time.sleep(50)
            attempts = attempts - 1
        }
    }
    need(online, "falhou")
    var i = 0
    while (i < 3) {
        need(statusOf(httpGetRaw(httpPort, "/", "site.mel.kofcloud.io")) == 200, "falhou")
        i = i + 1
    }
    var after = httpGetToken(controlPort, "/v1/usage", token)
    var usage = json.decode<Map<String, String>>(bodyOf(after))
    need(mapField(usage, "requests") == "3", "falhou")
    need(parseIntBounded(mapField(usage, "bytesOut"), 0, 2147483647) > 0, "falhou")

    // Escopo: ana nunca ve o uso de mel; sem token e 401.
    var anaView = httpGetToken(controlPort, "/v1/usage", anaToken)
    need(mapField(json.decode<Map<String, String>>(bodyOf(anaView)), "requests") == "0", "falhou")
    need(statusOf(httpGetToken(controlPort, "/v1/usage", "")) == 401, "falhou")

    // CLI: `usage` formata o mesmo fio (aqui pelo caminho puro do comando
    // com sessao real gravada? Nao — o cmdUsage le a sessao do HOME; o fio
    // ja foi provado acima e o formato e trivial. A trava do help cobre o
    // anuncio.)

    writeTextTo(agentStop, "stop")
    time.sleep(1200)
    writeTextTo(edgeStop, "stop")
    time.sleep(800)
    File(agentStop).delete()
    File(edgeStop).delete()
}

test "usage: help anuncia o comando", "usage-help" {
    var help = usageText()
    need(help.indexOf("usage [--export]") >= 0, "falhou")
    need(help.indexOf("billing externo") >= 0, "falhou")
}

test "usage: snapshot fecha a janela (le e zera) e o Edge continua contando", "usage-unit" {
    var unitPath = usagePath("snapshot")
    var registry = Registry(unitPath)
    var mel = registry.createAccount("mel", "mel@e.com", "segredo")
    registry.noteUsage(mel.id, 100, 200)
    registry.noteUsage(mel.id, 50, 60)
    // Ponto de persistencia: qualquer mutacao salva o estado (aqui
    // explicito) — sem ele o reload nao teria a janela para comparar e o
    // teste abaixo nao discriminaria nada.
    registry.save()
    // Snapshot: devolve o acumulado da janela e zera o contador.
    var window1 = registry.usageSnapshot(mel.id)
    need(window1.requests == "2", "falhou")
    need(window1.bytesIn == "150" && window1.bytesOut == "260", "falhou")
    // Zerado: o proximo snapshot e zeros (idempotente — export repetido
    // nao re-fatura).
    var window2 = registry.usageSnapshot(mel.id)
    need(window2.requests == "0", "falhou")
    // O Edge continua contando em cima do zero: nova janela comeca limpa.
    registry.noteUsage(mel.id, 10, 20)
    var window3 = registry.usageSnapshot(mel.id)
    need(window3.requests == "1" && window3.bytesIn == "10", "falhou")
    // Sem entrada nunca e erro: snapshot de conta sem uso devolve zeros (e
    // NAO grava: carimbar disco em conta-parada seria I/O por export vazio;
    // o reload abaixo continua vendo zeros porque nada mudou no disco).
    var empty = registry.usageSnapshot("sem-conta")
    need(empty.requests == "0" && empty.bytesIn == "0", "falhou")
    // O reset do export PERSISTE NA HORA (padrao do setWebhook): reload do
    // disco ve a janela fechada — antes o reset era so em memoria e um
    // restart antes da proxima mutacao recarregava a janela (re-faturamento).
    var afterExport = Registry(unitPath)
    need(afterExport.loadStatus == "ok", "falhou")
    var closed = afterExport.usageFor(mel.id)
    need(closed.requests == "0" && closed.bytesIn == "0" && closed.bytesOut == "0", "falhou")
    // Conta sem uso no reload: zeros (o snapshot de zeros nao gravou nada —
    // sem mutacao, sem disco).
    var emptyReload = afterExport.usageFor("sem-conta")
    need(emptyReload.requests == "0", "falhou")
}

test "usage: export fecha a janela pelo fio com rastro de auditoria", "usage-e2e" {
    var localSvc = 20298
    var controlPort = 20299
    var tunnelPort = 20300
    var httpPort = 20301

    var app = web.app()
    app.get("/") { return "svc-usage" }
    var server = spawn { app.listen(localSvc) }
    need(waitForPort(localSvc, 60), "falhou")

    var registry = Registry(usagePath("export"))
    var edgeState = EdgeState(registry)
    var edgeStop = "/tmp/kofcloud-exp-edge-" + crypto.randomHex(4) + ".txt"
    var agentStop = "/tmp/kofcloud-exp-agent-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    File(agentStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, "", edgeStop) }
    var httpTask = spawn { serveHttp(edgeState, httpPort, limitMaxBodyBytes(), edgeStop) }
    need(waitForPort(controlPort, 60), "falhou")
    need(waitForPort(tunnelPort, 60), "falhou")
    need(waitForPort(httpPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var account = json.decode<Map<String, String>>(bodyOf(created))
    var token = mapField(account, "token")
    var accountId = mapField(account, "accountId")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pubkey\"}", token)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"" + intToString(localSvc) + "\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    need(statusOf(httpPostJson(controlPort, "/v1/services", pubBody, token)) == 200, "falhou")
    var config = AgentConfig("http://127.0.0.1:" + intToString(controlPort), deviceId, accountId, token, "", agentStop, "127.0.0.1", tunnelPort, 500)
    var agentTask = spawn { runAgent(config, true) }
    var online = false
    var attempts = 100
    while (attempts > 0 && online == false) {
        online = edgeState.isOnline(deviceId)
        if (online == false) {
            time.sleep(50)
            attempts = attempts - 1
        }
    }
    need(online, "falhou")
    var i = 0
    while (i < 2) {
        need(statusOf(httpGetRaw(httpPort, "/", "site.mel.kofcloud.io")) == 200, "falhou")
        i = i + 1
    }

    // Export (POST): devolve a janela com periodEnd e ZERA o fio.
    var exp = httpPostJson(controlPort, "/v1/usage/export", "{}", token)
    need(statusOf(exp) == 200, "falhou")
    var window = json.decode<Map<String, String>>(bodyOf(exp))
    need(mapField(window, "requests") == "2", "falhou")
    need(mapField(window, "periodEnd").length > 0, "falhou")
    var after = httpGetToken(controlPort, "/v1/usage", token)
    need(mapField(json.decode<Map<String, String>>(bodyOf(after)), "requests") == "0", "falhou")

    // Rastro de auditoria do fechamento de janela (same vocabulary do CLI).
    var audit = httpGetToken(controlPort, "/v1/audit", token)
    need(bodyOf(audit).indexOf("usage.export") >= 0, "falhou")

    // Export repetido: zeros (idempotente — nunca re-fatura a mesma janela).
    var exp2 = httpPostJson(controlPort, "/v1/usage/export", "{}", token)
    need(mapField(json.decode<Map<String, String>>(bodyOf(exp2)), "requests") == "0", "falhou")
    // Sem token: 401.
    need(statusOf(httpPostJson(controlPort, "/v1/usage/export", "{}", "")) == 401, "falhou")

    writeTextTo(agentStop, "stop")
    time.sleep(1200)
    writeTextTo(edgeStop, "stop")
    time.sleep(800)
    File(agentStop).delete()
    File(edgeStop).delete()
}

test "usage: help anuncia --export e a janela", "usage-help" {
    var help = usageText()
    need(help.indexOf("usage [--export]") >= 0, "falhou")
    need(help.indexOf("fecha a janela") >= 0, "falhou")
}
