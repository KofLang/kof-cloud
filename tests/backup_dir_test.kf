import kofcloud.cli.Commands
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.store.Store
import kofcloud.util.Limits
import testkit.Support

// F16 s1 — backup automatico do estado no `serve --backup-dir`. O estado
// em arquivo e o ponto unico de falha do MVP (17-limitations): atrasar a
// assistencia (backup + retencao) por causa do banco deixava o operador sem
// nada depois de uma subida que tirou o control plane do ar. Fatia sem
// banco: a copia do estado ESTAVEL na partida, com poda por teto.

String backupTmp(String name) {
    return "/tmp/kofcloud-bk-" + name + "-" + crypto.randomHex(4)
}

test "backup: poda remove os mais antigos e ignora nome de outro estado", "backup-unit" {
    // Puro sobre nomes. Timestamp zero-padded: ordem lexicografica = temporal.
    var names = listOf(
        "control-state-0000000000000100.json",
        "control-state-0000000000000300.json",
        "control-state-0000000000000200.json",
        "control-state-old-0000000000000001.json",
        "outro.txt",
        "control-state-notdigits.json"
    )
    var prune = stateBackupsToPrune(names, "/var/lib/control-state.json", 2)
    need(prune.size == 1, "falhou")
    need(prune.get(0) == "control-state-0000000000000100.json", "falhou")
    need(stateBackupsToPrune(names, "/var/lib/control-state.json", 5).size == 0, "falhou")
    need(stateBackupsToPrune(names, "/var/lib/control-state.json", 0).size == 3, "falhou")
    // Prefixo terminado por "-": o estado `control-state-old` nunca casa os
    // backups de `control-state` (os nomes de `old` ficam para os dele).
    need(stateBackupsToPrune(names, "/var/lib/control-state-old.json", 0).size == 1, "falhou")
    need(stateBackupName("/var/lib/control-state.json", 1234L) == "control-state-0000000000001234.json", "falhou")
    need(longStamp(99999999999999999L) == "99999999999999999", "falhou")
    // Recuo seguro dos limites: zero/negativo recai no default (sem poda =
    // o problema que o teto resolve; idade 0 copiaria toda subida).
    need(stateBackupsFrom(0) == 5, "falhou")
    need(limitStateBackups() == stateBackupsFrom(config.int("kofcloud.limits.stateBackups", 5)), "falhou")
    need(backupStateMsFrom(-1) == 30000L, "falhou")
    need(limitBackupStateMs() == 30000L, "falhou")
}

test "backup: linha do banner e honesta nos tres estados", "backup-unit" {
    need(stateBackupLine("absent", "/x/estado.json", "/b", "").indexOf("sem estado") >= 0, "falhou")
    need(stateBackupLine("corrupt", "/x/estado.json", "/b", "").indexOf("ilegivel") >= 0, "falhou")
    need(stateBackupLine("ok", "/x/estado.json", "/b", "!falha de escrita").indexOf("AVISO") >= 0, "falhou")
    need(stateBackupLine("ok", "/x/estado.json", "/b", "!falha de escrita").indexOf("segue") >= 0, "falhou")
    need(stateBackupLine("ok", "/x/estado.json", "/b", "/b/control-state-1.json").indexOf("/b/control-state-1.json") >= 0, "falhou")
}

test "backup: subida copia o estado estavel, poda no teto e recusa estado novo", "backup-e2e" {
    var dir = backupTmp("e2e")
    Directory(dir).createDirectories()
    var statePath = dir + "/control-state.json"
    var registry = Registry(statePath)
    need(registry.loadStatus == "absent", "falhou")
    // Sem estado: nada a copiar (nao inventa backup vazio).
    need(registry.backupOnBoot(dir + "/bk", 0L, 2) == "", "falhou")

    registry.createAccount("mel", "m@e.com", "segredo")
    // Estado novo demais (escrita recente): idade minima barra a copia.
    need(registry.backupOnBoot(dir + "/bk", 3600000L, 2) == "", "falhou")
    // Idade 0: copia o conteudo ESTAVEL (o que estava em disco na subida,
    // antes de qualquer mutacao do processo) para o nome canonico.
    // Deriva o estado ate o disco (precedente do backupStateFile da CLI).
    writeTextTo(statePath, readTextOr(statePath, "") + " ")
    var first = registry.backupOnBoot(dir + "/bk", 0L, 2)
    need(fileExists(first), "falhou")
    need(readTextOr(first, "").length > 0, "falhou")
    registry.createAccount("ana", "a@e.com", "segredo")
    var second = registry.backupOnBoot(dir + "/bk", 0L, 2)
    registry.createAccount("bia", "b@e.com", "segredo")
    var third = registry.backupOnBoot(dir + "/bk", 0L, 2)
    need(fileExists(second) && fileExists(third), "falhou")
    // O mais antigo sai no teto 2 — ou, se os stamps colidiram no mesmo ms,
    // o mesmo arquivo foi reescrito: nunca mais de 2 arquivos.
    var count = 0
    for (var name in File(dir + "/bk").list()) {
        count = count + 1
    }
    need(count <= 2, "falhou")
    need(readTextOr(third, "") == readTextOr(statePath, ""), "falhou")
}

