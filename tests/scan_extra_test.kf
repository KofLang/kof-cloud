import kofcloud.cli.Commands
import kofcloud.cli.Deploy
import kofcloud.cli.Local
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.cli.Usage
import kofcloud.util.Text
import testkit.Support

// Fase 19 slice 2 (complemento) — o scan passa a olhar tambem o ambiente e
// o PEM do operador, nao so o manifesto.

test "scan: ambiente sensivel e detectado sem vazar valor", "scan-env-unit" {
    var pairs = listOf(
        "KOFCLOUD_TOKEN=abc123",
        "KOF_KOFCLOUD_DNS_WEBHOOK_TOKEN=tok_dns",
        "GITHUB_TOKEN=ghp_xxx",
        "PATH=/usr/bin",
        "MINHA_VAR=tem kfs_embutido",
        "VAZIA="
    )
    var findings = scanEnvSecrets(pairs)
    need(findings.size == 4, "falhou")
    var joined = ""
    for (var finding in findings) {
        joined = joined + finding + "\n"
    }
    need(joined.indexOf("KOFCLOUD_TOKEN") >= 0, "falhou")
    need(joined.indexOf("KOF_KOFCLOUD_DNS_WEBHOOK_TOKEN") >= 0, "falhou")
    need(joined.indexOf("GITHUB_TOKEN") >= 0, "falhou")
    need(joined.indexOf("MINHA_VAR") >= 0, "falhou")
    // Nunca o valor.
    need(joined.indexOf("abc123") < 0, "falhou")
    need(joined.indexOf("ghp_xxx") < 0, "falhou")
    need(joined.indexOf("PATH") < 0, "falhou")
    need(joined.indexOf("VAZIA") < 0, "falhou")
}

test "scan: lista de nomes sensiveis e curada e estavel", "scan-env-unit" {
    var names = sensitiveEnvNames()
    need(names.contains("KOFCLOUD_TOKEN"), "falhou")
    need(names.contains("KOFCLOUD_TUNNEL_SECRET"), "falhou")
    need(names.contains("KOF_KOFCLOUD_DNS_WEBHOOK_TOKEN"), "falhou")
    need(names.contains("AWS_SECRET_ACCESS_KEY"), "falhou")
    need(names.contains("DATABASE_URL"), "falhou")
    need(names.size >= 10, "falhou")
    // Sem duplicata.
    var seen = listOf<String>()
    for (var name in names) {
        need(seen.contains(name) == false, "falhou")
        seen.add(name)
    }
}

test "scan: PEM expirado/expirando e detectado com openssl", "scan-tls" {
    var dir = "/tmp/kofcloud-scan-" + crypto.randomHex(4)
    Directory(dir).createDirectories()
    var certPath = dir + "/cert.pem"
    var keyPath = dir + "/key.pem"
    // Certificado valido por 1 dia: expira em menos de 30 -> achado.
    var gen = process.run("openssl", "req", "-x509", "-newkey", "rsa:2048", "-keyout", keyPath, "-out", certPath, "-days", "1", "-nodes", "-subj", "/CN=localhost")
    need(gen.exitCode == 0, "falhou")
    var check = process.run("openssl", "x509", "-in", certPath, "-noout", "-checkend", tlsCheckendWindowSec())
    need(tlsCertExpiringSoon(check.exitCode), "falhou")
    // Valido por 365 dias: nao expira em 30.
    var longPath = dir + "/long.pem"
    var longKey = dir + "/long.key"
    var gen2 = process.run("openssl", "req", "-x509", "-newkey", "rsa:2048", "-keyout", longKey, "-out", longPath, "-days", "365", "-nodes", "-subj", "/CN=localhost")
    need(gen2.exitCode == 0, "falhou")
    var check2 = process.run("openssl", "x509", "-in", longPath, "-noout", "-checkend", tlsCheckendWindowSec())
    need(tlsCertExpiringSoon(check2.exitCode) == false, "falhou")
}

test "scan: usage documenta --tls-cert", "scan-usage" {
    var help = usageText()
    need(help.indexOf("scan [--file") >= 0, "falhou")
    need(help.indexOf("--tls-cert") >= 0, "falhou")
}
test "scan: credencial .kfs commitada no repo e achado (e2e com git real)", "scan-kfs" {
    // Medido: o `rotate --all` grava `<nome>.kfs` com o valor em claro; se o
    // operador rodar o comando dentro de um repo (ou copiar os arquivos para
    // um), o `git add .` commita o segredo — e o scan, que roda no CI a cada
    // push, nao olhava `.kfs` nenhum. Agora lista via `git ls-files` no
    // diretorio do manifesto; git ausente/fora de repo = sem checagem.
    var repo = "/tmp/kofcloud-scan-repo-" + crypto.randomHex(4)
    Directory(repo).createDirectories()
    var setup = process.run("git", "-C", repo, "init", "-q")
    need(setup.exitCode == 0, "falhou")
    writeTextTo(repo + "/kofcloud.json", "{\"services\":[{\"name\":\"site\",\"port\":8080}]}")
    writeTextTo(repo + "/site.kfs", "kfs_NUNCA-imprima-isto-0123456789abcdef")

    // O scan roda com o caminho ABSOLUTO do manifesto: `git -C <dir>` acha o
    // repo a partir do diretorio do manifesto.
    var withLeak = cmdScan(listOf("--file", repo + "/kofcloud.json"))
    need(withLeak == 1, "falhou")

    // A linha de achado: nome do arquivo, dica de rotacao pelo stem, sem valor.
    var finding = scanKfsFinding("site.kfs")
    need(finding.indexOf("site.kfs") >= 0, "falhou")
    need(finding.indexOf("kfs_") < 0, "falhou")
    need(finding.indexOf("rotate site --ttl 24") >= 0, "falhou")

    // Limpo: sem .kfs rastreado, scan segue os passos de sempre.
    var cleanDir = "/tmp/kofcloud-scan-clean-" + crypto.randomHex(4)
    Directory(cleanDir).createDirectories()
    process.run("git", "-C", cleanDir, "init", "-q")
    writeTextTo(cleanDir + "/kofcloud.json", "{\"services\":[{\"name\":\"site\",\"port\":8080}]}")
    need(cmdScan(listOf("--file", cleanDir + "/kofcloud.json")) == 0, "falhou")
}

test "scan: dependencias — pin aberto e pin antigo com data (puras + e2e offline)", "scan-deps" {
    // F19 s2: a parte de dependencias do scan, offline por desenho (resolver
    // `kofdeps` exige rede; o CI isolado nao tem). O scan aponta o que da
    // para saber sem rede: pin aberto (build nao reproduzivel) e pin antigo
    // quando a linha traz a data do pin no comentario.
    // Datas: epoch de 2025-06-01 e de 2020-01-01 (conferidas em `civilDaysMs`).
    var now = parseIsoDateMs("2025-06-01") + 1000L
    if (!(now > 0L)) { assert(false, "E1") }
    // Toml no formato do kof.toml do proprio repo nao tem dependencia: secao
    // e chave do projeto nao viram pin (o repo nao tem lock).
    var project = scanDependencyPins("kof.toml", "[project]\nname = \"kof-cloud\"\n\n[sources]\napp = \"src\"\ntest = \"tests\"\n", now, 365)
    if (!(project.size == 0)) { assert(false, "E2") }
    // package.json: pin aberto e pin exato sao distinguidos pelo valor.
    var pkg = scanDependencyPins("package.json", "{\n  \"name\": \"site\",\n  \"dependencies\": {\n    \"left-pad\": \"^1.3.0\",\n    \"express\": \"4.18.2\"\n  }\n}\n", now, 365)
    if (!(pkg.size == 1)) { assert(false, "E3") }
    if (!(pkg.get(0).indexOf("left-pad") >= 0)) { assert(false, "E4") }
    if (!(pkg.get(0).indexOf("^1.3.0") >= 0)) { assert(false, "E5") }
    if (!(pkg.get(0).indexOf("express") < 0)) { assert(false, "E6") }
    // Pin exato com data velha no comentario vira achado; com data recente nao.
    var oldPin = scanDependencyPins("kof.toml", "[deps]\nlucia = \"1.2.3\"  # pinned 2020-01-01\nnovo = \"2.0.0\"  # pinned 2025-05-01\n", now, 365)
    if (!(oldPin.size == 1)) { assert(false, "E7") }
    if (!(oldPin.get(0).indexOf("lucia") >= 0)) { assert(false, "E8") }
    if (!(oldPin.get(0).indexOf("dias") >= 0)) { assert(false, "E9") }
    // Sem data no comentario: o scan nao inventa idade.
    if (!(scanDependencyPins("kof.toml", "[deps]\nmoda = \"3.1.0\"\n", now, 365).size == 0)) { assert(false, "E10") }
    // go.mod: versao exata passa, `indirect` fica fora.
    var gomod = scanDependencyPins("go.mod", "module exemplo\n\ngo 1.22\n\nrequire (\n\tgithub.com/x/y v1.2.3\n\tgithub.com/a/b v0.0.0-20200101000000-deadbeef // indirect\n)\n", now, 365)
    need(gomod.size == 0, "falhou")
    // requirements: `==` e pin exato; sem versao e pin aberto.
    var req = scanDependencyPins("requirements.txt", "flask==3.0.0\nrequests\n", now, 365)
    if (!(req.size == 1)) { assert(false, "E11") }
    if (!(req.get(0).indexOf("requests") >= 0)) { assert(false, "E12") }
    // Faixas: `1.x`, `*`, `latest`, `~` — todos abertos.
    if (!(isLoosePin("1.x") && isLoosePin("*") && isLoosePin("latest") && isLoosePin("~2.0") && isLoosePin(">=1.0"))) { assert(false, "E13") }
    if (!(isLoosePin("1.2.3") == false && isLoosePin("v1.2.3") == false)) { assert(false, "E14") }
    // Data: ISO estrita; invalida nao vira idade.
    if (!(parseIsoDateMs("2023-05-01") == civilDaysMs(2023, 5, 1))) { assert(false, "E15") }
    if (!(parseIsoDateMs("2023-13-01") == 0L)) { assert(false, "E16") }
    if (!(parseIsoDateMs("2023-05-32") == 0L)) { assert(false, "E17") }
    if (!(parseIsoDateMs("sem data") == 0L)) { assert(false, "E18") }
    if (!(parseIsoDateMs("1969-12-31") == 0L)) { assert(false, "E19") }
    if (!(limitDepPinMaxAgeDays() == 365)) { assert(false, "E20") }
    if (!(depPinMaxAgeDaysFrom(0) == 365)) { assert(false, "E21") }

    // e2e: cmdScan le os manifestos de dependencia do diretorio do manifesto.
    var dir = "/tmp/kofcloud-scan-deps-" + crypto.randomHex(4)
    Directory(dir).createDirectories()
    writeTextTo(dir + "/kofcloud.json", "{\"services\":[{\"name\":\"site\",\"port\":8080}]}")
    if (!(cmdScan(listOf("--file", dir + "/kofcloud.json")) == 0)) { assert(false, "E22") }
    writeTextTo(dir + "/package.json", "{\n  \"name\": \"site\",\n  \"dependencies\": {\n    \"esquerda\": \"latest\"\n  }\n}\n")
    if (!(cmdScan(listOf("--file", dir + "/kofcloud.json")) == 1)) { assert(false, "E23") }
    if (!(dependencyManifestNames().size == 6)) { assert(false, "E24") }
}

test "scan: e2e — nome com caixa errada no comando rejeita e aponta o certo", "service-case-e2e" {
    // O caminho real: `unpublish Site` contra um `site` publicado. Exit 1
    // (nada e removido — semantica exata) e o aviso de caixa no stdout.
    var dir = "/tmp/kofcloud-case-" + crypto.randomHex(4)
    Directory(dir).createDirectories()
    var statePath = dir + "/control-state.json"
    var registry = Registry(statePath)
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    registry.registerDevice(account, "nb", "pk")
    var deviceId = registry.devicesForAccount(account.id).get(0).id
    registry.publishService(account, deviceId, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    var port = 19741
    var control = ControlPlane(registry, port, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(port, 60), "falhou")
    var url = "http://127.0.0.1:" + intToString(port)
    var token = loginOrCreate(url, "mel", "segredo")
    var priorSession = readTextOr(sessionPath(), "")
    saveSession(LocalSession("", "mel", token, url))
    need(cmdUnpublish(listOf("Site")) == 1, "falhou")
    need(cmdServiceSuspend(listOf("SITE")) == 1, "falhou")
    need(registry.servicesForAccount(account.id).size == 1, "falhou")
    if (priorSession.length == 0) {
        File(sessionPath()).delete()
    } else {
        writeTextTo(sessionPath(), priorSession)
    }
}

test "scan: --summary resume o achado em uma linha (exit 1 mantido)", "scan-summary" {
    // CI legivel: o detalhe pode ser longo; a linha que o build le e o total.
    // Nunca esconde o EXIT CODE — so o texto.
    var dir = "/tmp/kofcloud-scan-summary-" + crypto.randomHex(4)
    Directory(dir).createDirectories()
    writeTextTo(dir + "/kofcloud.json", "{\"services\":[{\"name\":\"site\",\"port\":8080,\"password\":\"x\"}]}")
    need(cmdScan(listOf("--file", dir + "/kofcloud.json", "--summary")) == 1, "falhou")
    need(cmdScan(listOf("--file", dir + "/kofcloud.json")) == 1, "falhou")
    var clean = "/tmp/kofcloud-scan-summary-clean-" + crypto.randomHex(4)
    Directory(clean).createDirectories()
    writeTextTo(clean + "/kofcloud.json", "{\"services\":[{\"name\":\"site\",\"port\":8080}]}")
    need(cmdScan(listOf("--file", clean + "/kofcloud.json", "--summary")) == 0, "falhou")
    need(cmdScan(listOf("--file", clean + "/kofcloud.json", "--summary", "--summary")) == 1, "falhou")
}
