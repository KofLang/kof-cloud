import kofcloud.cli.Deploy
import kofcloud.cli.Local
import kofcloud.cli.Usage
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.util.Limits
import kofcloud.util.Text
import testkit.Support

// deploy --watch (F13 s3, parcial sem auto-update): o manifesto local e a
// fonte — o laco re-le o arquivo a cada passo e aplica a MESMA semantica do
// deploy (build -> artifact -> publish idempotente) quando o TEXTO muda.
// Provas puras da decisao (watchDecision) e do apply (watchApplyOnce contra
// control plane real) + travas do uso/help.

String watchManifestPath(String tag) {
    return "/tmp/kofcloud-watch-" + tag + "-" + crypto.randomHex(4) + ".json"
}

test "watch: decisao pura — stop, vazio, igual e mudou", "deploy-watch" {
    var stop = watchManifestPath("stop-sentinel")
    File(stop).delete()
    // Sem sentinela e manifesto igual ao visto: nada a fazer.
    var d = watchDecision(stop, "{\"services\":[]}", "{\"services\":[]}")
    need(d.apply == false && d.stop == false, "falhou")
    // Manifesto mudou: aplica.
    d = watchDecision(stop, "{\"services\":[{\"name\":\"a\",\"port\":1}]}", "{\"services\":[]}")
    need(d.apply && d.stop == false, "falhou")
    // Arquivo esvaziado (editor gravando pela metade): NAO aplica — o
    // parse aplicaria lixo e a remocao nunca e automatica. Tambem nao
    // encerra: o ciclo seguinte rele.
    d = watchDecision(stop, "", "{\"services\":[{\"name\":\"a\",\"port\":1}]}")
    need(d.apply == false && d.stop == false, "falhou")
    // Sentinela presente: para, mesmo com mudanca pendente.
    writeTextTo(stop, "stop")
    d = watchDecision(stop, "{\"services\":[], {", "{\"services\":[]}")
    need(d.stop, "falhou")
    File(stop).delete()
    // Sentinela vazia no caminho (defesa em profundidade): sem sentinela
    // configurada o watch nunca para sozinho.
    d = watchDecision("", "x", "y")
    need(d.apply, "falhou")
}

test "watch: limits do passo com recuo seguro", "deploy-watch" {
    need(deployWatchMsFrom(0) == 2000, "falhou")
    need(deployWatchMsFrom(-1) == 2000, "falhou")
    need(deployWatchMsFrom(500) == 500, "falhou")
    need(limitDeployWatchMs() == 2000, "falhou")
    // A pura mora em `util/Limits.kf` junto dos outros passos de laco (import
    // `kofcloud.util.Limits`): sem ela la, este assert nem compila.
    need(limitDeployWatchMs() == deployWatchMsFrom(0), "falhou")
}

test "watch: uso/help documentam --watch e a combinacao proibida", "deploy-watch" {
    // Precedente deploy-usage (daemon_test): flag nova sem trava apodrece
    // README e help em silencio.
    var help = usageText()
    need(help.indexOf("[--watch]") >= 0, "falhou")
    need(help.indexOf("nunca remove") >= 0, "falhou")
    need(usageText().indexOf("--watch observa") >= 0, "falhou")
}

test "watch: e2e — edita o manifesto e o watch publica; removedor nunca roda sozinho", "deploy-watch" {
    var localSvc = 20290
    var controlPort = 20291
    var tunnelPort = 20292
    var httpPort = 20293

    var app = web.app()
    app.get("/") { return "svc-watch" }
    var server = spawn { app.listen(localSvc) }
    need(waitForPort(localSvc, 60), "falhou")

    var registry = Registry("/tmp/kofcloud-watch-reg-" + crypto.randomHex(4) + ".json")
    var edgeState = EdgeState(registry)
    var edgeStop = "/tmp/kofcloud-watch-edge-" + crypto.randomHex(4) + ".txt"
    var agentStop = "/tmp/kofcloud-watch-agent-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    File(agentStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, "", edgeStop) }
    var httpTask = spawn { serveHttp(edgeState, httpPort, limitMaxBodyBytes(), edgeStop) }
    need(waitForPort(controlPort, 60), "falhou")
    need(waitForPort(tunnelPort, 60), "falhou")
    need(waitForPort(httpPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var account = json.decode<Map<String, String>>(bodyOf(created))
    var accountToken = mapField(account, "token")
    var accountId = mapField(account, "accountId")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pubkey\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")

    // O watch nao precisa do Agent para publicar — mas o e2e sobe o tunel
    // para provar a rota inteira (o que o operador percebe: o site no ar).
    var config = AgentConfig("http://127.0.0.1:" + intToString(controlPort), deviceId, accountId, accountToken, "", agentStop, "127.0.0.1", tunnelPort, 500)
    var agentTask = spawn { runAgent(config, true) }
    var online = false
    var attempts = 100
    while (attempts > 0 && online == false) {
        online = edgeState.isOnline(deviceId)
        if (online == false) {
            time.sleep(50)
            attempts = attempts - 1
        }
    }
    need(online, "falhou")

    // Ciclo 1: watchApplyOnce com manifesto de 1 servico (rota saida via tunel).
    var manifest = watchManifestPath("m1")
    var body1 = "{\"services\":[{\"name\":\"site\",\"port\":" + intToString(localSvc) + "}]}"
    writeTextTo(manifest, body1)
    var f1 = watchApplyOnce("http://127.0.0.1:" + intToString(controlPort), accountToken, deviceId, body1)
    need(f1 == 0, "falhou")
    var served = false
    var waits = 60
    while (waits > 0 && served == false) {
        var probe = httpGetRaw(httpPort, "/", "site.mel.kofcloud.io")
        if (statusOf(probe) == 200 && bodyOf(probe) == "svc-watch") {
            served = true
        } else {
            time.sleep(250)
            waits = waits - 1
        }
    }
    need(served, "falhou")

    // Ciclo 2: MESMO texto = idempotente (nada muda, nada quebra).
    var f2 = watchApplyOnce("http://127.0.0.1:" + intToString(controlPort), accountToken, deviceId, body1)
    need(f2 == 0, "falhou")

    // Ciclo 3: manifest EDITADO (nova porta não; novo servico) — publica o
    // segundo SEM remover o primeiro (o watch nunca remove).
    var body2 = "{\"services\":[{\"name\":\"site\",\"port\":" + intToString(localSvc) + "},{\"name\":\"api\",\"port\":" + intToString(localSvc) + "}]}"
    var f3 = watchApplyOnce("http://127.0.0.1:" + intToString(controlPort), accountToken, deviceId, body2)
    need(f3 == 0, "falhou")
    var services = registry.servicesForAccount(accountId)
    var names = listOf<String>()
    for (var svc in services) {
        names.add(svc.name)
    }
    need(names.contains("site") && names.contains("api"), "falhou")
    need(names.size == 2, "falhou")

    // Manifesto esvaziado: watchDecision ja recusa aplicar (teste puro);
    // aqui prova o apply direto tambem recusa texto vazio.
    var f4 = watchApplyOnce("http://127.0.0.1:" + intToString(controlPort), accountToken, deviceId, "")
    need(f4 == 0, "falhou")

    // Cruzamento watch × freeze: o watch re-publica em lote a cada mudanca
    // do manifesto — republicar um serviço CONGELADO (SUSPENDED) nao pode
    // ressuscita-lo. O freeze mata as kfs_ e suspende; o apply seguinte
    // republica a mesma config e o servico segue fora da rota.
    var site = registry.serviceByName(accountId, "site")
    need(site != null, "falhou")
    if (site != null) {
        need(registry.freezeService(accountId, site.id).ok, "falhou")
    }
    var f5 = watchApplyOnce("http://127.0.0.1:" + intToString(controlPort), accountToken, deviceId, body2)
    need(f5 == 0, "falhou")
    if (site != null) {
        var kept = registry.serviceById(site.id)
        need(kept != null, "falhou")
        if (kept != null) {
            need(kept.status == "SUSPENDED", "falhou")
            need(registry.resolveRoute(kept.hostname) == null, "falhou")
        }
    }

    writeTextTo(agentStop, "stop")
    time.sleep(1200)
    writeTextTo(edgeStop, "stop")
    time.sleep(800)
    File(agentStop).delete()
    File(edgeStop).delete()
}
