import kofcloud.cli.Commands
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.model.Audit
import kofcloud.store.Store
import kofcloud.util.Limits
import testkit.Support

// Fase 19 slice 4 (parcial) — trilha de auditoria com hash encadeado.
// Nao e WORM de verdade (o arquivo pode ser reescrito), mas qualquer
// adulteracao ou remocao no meio da cadeia fica DETECTAVEL.

String chainPath(String name) {
    return "/tmp/kofcloud-chain-" + name + "-" + crypto.randomHex(4) + ".json"
}

test "cadeia: eventos encadeiam e a cadeia integra verifica", "chain-unit" {
    var registry = Registry(chainPath("ok"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    registry.registerDevice(account, "nb", "pk")
    var events = registry.auditForAccount(account.id)
    assert(events.size >= 2, "dois eventos")
    assert(auditChainError(events) == "", "cadeia integra")
    // O primeiro evento tem prevHash vazio; o segundo aponta para o primeiro.
    assert(events.get(0).prevHash == "", "raiz sem anterior")
    if (events.size >= 2) {
        assert(events.get(1).prevHash == events.get(0).hash, "encadeado")
    }
}

test "cadeia: adulterar um campo quebra no indice certo", "chain-unit" {
    var registry = Registry(chainPath("tamper"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    registry.registerDevice(account, "nb", "pk")
    var events = registry.auditForAccount(account.id)
    assert(events.size >= 2, "dois eventos")
    // Adultera o TARGET do primeiro evento (mantendo o hash antigo).
    var tampered = listOf<AuditEvent>()
    var i = 0
    for (var event in events) {
        if (i == 0) {
            tampered.add(AuditEvent(event.at, event.actor, event.action, "conta-alheia", event.prevHash, event.hash))
        } else {
            tampered.add(event)
        }
        i = i + 1
    }
    assert(auditChainError(tampered) == "0", "quebra no primeiro")
}

test "cadeia: remover um evento do meio quebra no seguinte", "chain-unit" {
    var registry = Registry(chainPath("remove"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    registry.registerDevice(account, "nb", "pk")
    registry.publishService(account, registry.devicesForAccount(account.id).get(0).id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    var events = registry.auditForAccount(account.id)
    assert(events.size >= 3, "tres eventos")
    // Remove o do meio: o prevHash do seguinte nao fecha mais.
    var withoutMiddle = listOf<AuditEvent>()
    withoutMiddle.add(events.get(0))
    var i = 2
    while (i < events.size) {
        withoutMiddle.add(events.get(i))
        i = i + 1
    }
    assert(auditChainError(withoutMiddle) == "1", "quebra no indice 1")
}

test "cadeia: hash e deterministico e sensivel a cada campo", "chain-unit" {
    var base = auditEventHash("", "1", "account:mel", "account.login", "acc-1")
    assert(base == auditEventHash("", "1", "account:mel", "account.login", "acc-1"), "deterministico")
    assert(base != auditEventHash("", "2", "account:mel", "account.login", "acc-1"), "at muda")
    assert(base != auditEventHash("", "1", "account:ana", "account.login", "acc-1"), "actor muda")
    assert(base != auditEventHash("", "1", "account:mel", "account.logout", "acc-1"), "action muda")
    assert(base != auditEventHash("", "1", "account:mel", "account.login", "acc-2"), "target muda")
    assert(base != auditEventHash("x", "1", "account:mel", "account.login", "acc-1"), "prev muda")
    assert(base.length == 64, "sha256 hex")
}

test "cadeia: HTTP /v1/audit/verify reporta integra e adulterada", "chain" {
    var controlPort = 19911
    var registry = Registry(chainPath("http"))
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", token)

    var ok = httpGetToken(controlPort, "/v1/audit/verify", token)
    assert(statusOf(ok) == 200, "verify 200")
    assert(bodyOf(ok).indexOf("\"ok\":\"true\"") >= 0, "integra")

    // A listagem traz os hashes (o terceiro pode verificar por conta propria).
    var listed = httpGetToken(controlPort, "/v1/audit", token)
    assert(bodyOf(listed).indexOf("\"hash\"") >= 0, "hash exposto")
    assert(bodyOf(listed).indexOf("\"prevHash\"") >= 0, "prevHash exposto")

    // Adultera o estado em disco e recarrega: a verificacao acusa.
    var mel = registry.accountByHandle("mel")
    var melId = ""
    if (mel != null) {
        melId = mel.id
    }
    var events = registry.auditForAccount(melId)
    var tampered = listOf<AuditEvent>()
    var i = 0
    for (var event in events) {
        if (i == 0) {
            tampered.add(AuditEvent(event.at, event.actor, "account.hacked", event.target, event.prevHash, event.hash))
        } else {
            tampered.add(event)
        }
        i = i + 1
    }
    registry.audit = tampered
    var broken = httpGetToken(controlPort, "/v1/audit/verify", token)
    assert(bodyOf(broken).indexOf("\"ok\":\"false\"") >= 0, "adulterada detectada")
    assert(bodyOf(broken).indexOf("\"brokenAt\":\"0\"") >= 0, "indice do primeiro")
}
test "cadeia: eventos de contas intercaladas NAO quebram a verificacao", "chain-unit" {
    // O anel e global e cada evento encadeia com o anterior do anel; a lista
    // verificada e POR CONTA. Antes, comparar com a posicao na lista fazia
    // duas contas ativas reportarem cadeia quebrada sem adulteracao.
    var registry = Registry(chainPath("multi"))
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var ana = registry.createAccount("ana", "a@e.com", "segredo")
    registry.registerDevice(mel, "nb-mel", "pk")
    registry.registerDevice(ana, "nb-ana", "pk")
    registry.registerDevice(mel, "nb-mel2", "pk2")

    // A cadeia GLOBAL continua integra.
    assert(auditChainError(registry.audit) == "", "anel global integro")
    // E cada conta, isoladamente, tambem — mesmo com eventos intercalados.
    var melEvents = registry.auditForAccount(mel.id)
    var anaEvents = registry.auditForAccount(ana.id)
    assert(melEvents.size >= 3, "mel com eventos: " + intToString(melEvents.size))
    assert(anaEvents.size >= 2, "ana com eventos: " + intToString(anaEvents.size))
    assert(auditChainError(melEvents) == "", "cadeia de mel integra")
    assert(auditChainError(anaEvents) == "", "cadeia de ana integra")

    // auditEventAccount separa `<conta>` e `<conta>/<recurso>`.
    assert(auditEventAccount(melEvents.get(0)) == mel.id, "conta pura")
}

test "cadeia: com duas contas, adulterar ainda e detectado", "chain-unit" {
    // A correcao nao pode enfraquecer a deteccao: adulterar um evento de uma
    // conta continua quebrando a cadeia DELA, sem afetar a da outra.
    var registry = Registry(chainPath("multi-tamper"))
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var ana = registry.createAccount("ana", "a@e.com", "segredo")
    registry.registerDevice(mel, "nb-mel", "pk")
    registry.registerDevice(ana, "nb-ana", "pk")
    registry.registerDevice(mel, "nb-mel2", "pk2")

    // Adultera a acao do primeiro evento de mel (sem recalcular o hash).
    var tampered = listOf<AuditEvent>()
    var done = false
    for (var event in registry.audit) {
        if (done == false && auditEventAccount(event) == mel.id) {
            tampered.add(AuditEvent(event.at, event.actor, "account.hacked", event.target, event.prevHash, event.hash))
            done = true
        } else {
            tampered.add(event)
        }
    }
    var melTampered = listOf<AuditEvent>()
    for (var event in tampered) {
        if (auditEventAccount(event) == mel.id) {
            melTampered.add(event)
        }
    }
    assert(auditChainError(melTampered) == "0", "adulteracao de mel detectada no primeiro")
    // A cadeia da outra conta segue integra.
    var anaEvents = listOf<AuditEvent>()
    for (var event in tampered) {
        if (auditEventAccount(event) == ana.id) {
            anaEvents.add(event)
        }
    }
    assert(auditChainError(anaEvents) == "", "ana segue integra")
}

test "cadeia: HTTP verify fica integra com duas contas ativas", "chain" {
    var controlPort = 19912
    var registry = Registry(chainPath("http-multi"))
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control no ar")

    var melCreated = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var melToken = mapField(json.decode<Map<String, String>>(bodyOf(melCreated)), "token")
    var anaCreated = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"ana\",\"email\":\"a@e.com\",\"password\":\"segredo\"}", "")
    var anaToken = mapField(json.decode<Map<String, String>>(bodyOf(anaCreated)), "token")
    httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", melToken)
    httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", anaToken)

    var melVerify = httpGetToken(controlPort, "/v1/audit/verify", melToken)
    assert(bodyOf(melVerify).indexOf("\"ok\":\"true\"") >= 0, "mel integra: " + bodyOf(melVerify))
    var anaVerify = httpGetToken(controlPort, "/v1/audit/verify", anaToken)
    assert(bodyOf(anaVerify).indexOf("\"ok\":\"true\"") >= 0, "ana integra: " + bodyOf(anaVerify))
}

test "filtro de audit: --action e --tail na CLI (puros)", "chain-filter" {
    // Medido: `kof cloud audit` despejava ate 100 eventos sem filtro —
    // achar "quando o device foi revogado" era varredura visual. O filtro
    // vive na CLI (sem API nova): acao casa exato (vocabulario do fio, sem
    // lowercase escondendo typo) e tail corta os mais RECENTES (a ordem do
    // anel e antigo -> novo).
    var events = listOf(
        AuditEntry("1", "account:mel", "account.created", "acc-1", "", "h1"),
        AuditEntry("2", "account:mel", "device.registered", "acc-1/dev-1", "", "h2"),
        AuditEntry("3", "account:mel", "service.published", "acc-1/svc-1", "", "h3"),
        AuditEntry("4", "account:mel", "device.revoked", "acc-1/dev-1", "", "h4")
    )

    // Filtro de acao: exato, sem lowercase.
    var revoked = auditFilterAction(events, "device.revoked")
    assert(revoked.size == 1, "uma revocacao")
    assert(revoked.get(0).at == "4", "o evento certo")
    assert(auditFilterAction(events, "device.Revoked").size == 0, "casing nao perdoa typo")
    assert(auditFilterAction(events, "device.").size == 0, "prefixo nao casa (acao e exata)")
    assert(auditFilterAction(events, "nao.existe").size == 0, "acao inexistente: vazio")

    // Tail: os mais recentes.
    var tail2 = auditTail(events, 2)
    assert(tail2.size == 2, "duas no tail")
    assert(tail2.get(0).at == "3", "mais recente velho")
    assert(tail2.get(1).at == "4", "o mais recente")
    assert(auditTail(events, 0).size == 4, "tail 0 = tudo")
    assert(auditTail(events, -1).size == 4, "negativo = tudo")
    assert(auditTail(events, 99).size == 4, "acima do tamanho = tudo")

    // Combinacao: filtra acao DEPOIS tail (ordem real do cmdAudit).
    var combined = auditTail(auditFilterAction(events, "device.registered"), 5)
    assert(combined.size == 1, "acao + tail")
    assert(combined.get(0).at == "2", "o evento certo")

    // Linha inclui o ator (antes "quem fez?" exigia a API crua).
    var line = auditLine(events.get(3))
    assert(line.indexOf("device.revoked") >= 0, "acao na linha")
    assert(line.indexOf("account:mel") >= 0, "ator na linha")
    assert(line.indexOf("acc-1/dev-1") >= 0, "alvo na linha")
}

test "filtro de audit: cmdAudit liga as flags nas funcoes puras (trava de fonte)", "chain-filter" {
    // Os testes puros cobrem as funcoes; esta trava impede a regressao que
    // realmente importa: o `cmdAudit` deixar de APLICAR os filtros (o
    // operador pediria --action e receberia o dump inteiro, em silencio).
    var raw = File("src/kofcloud/cli/Commands.kf").readText()
    var text = ""
    if (raw != null) {
        text = raw
    }
    if (text.length == 0) {
        return
    }
    var start = text.indexOf("Int cmdAudit(")
    var end = text.indexOf("// ---- helpers de control plane ----", start)
    if (end < 0) {
        end = text.length
    }
    var body = text.substring(start, end)
    assert(body.indexOf("auditFilterAction(") >= 0, "cmdAudit aplica o filtro de acao")
    assert(body.indexOf("auditTail(") >= 0, "cmdAudit aplica o tail")
    assert(body.indexOf("auditLine(") >= 0, "cmdAudit imprime a linha com ator")
    assert(body.indexOf("flagMissingValue(args, \"--action\")") >= 0, "--action solta barra")
    assert(body.indexOf("flagDuplicated(args, \"--action\")") >= 0, "--action repetida barra")
}

test "cadeia: vocabulario de acoes vive em Audit.kf (fonte unica)", "chain-unit" {
    // O vocabulario e fechado e cresce por adicao nos construtores de
    // `model/Audit.kf`; um literal cru no chamador escapa da fonte e do
    // filtro exato do CLI (`audit --action` nao perdoa typo — medido:
    // `service.token_issued` vivia cru no Registry, o unico sem construtor).
    var audit = readTextOr("src/kofcloud/model/Audit.kf", "")
    assert(audit.length > 0, "Audit.kf existe")
    var parts = audit.split("service.token_issued")
    assert(parts.length == 2, "literal so no construtor do Audit.kf")
    assert(auditServiceTokenIssued() == "service.token_issued", "construtor devolve o vocabulario do fio")
    var registry = readTextOr("src/kofcloud/control/Registry.kf", "")
    assert(registry.length > 0, "Registry.kf existe")
    assert(registry.indexOf("service.token_issued") < 0, "Registry nao tem literal cru de acao")
    assert(registry.indexOf("auditServiceTokenIssued()") >= 0, "emissao delega no construtor")
}

test "worm: serializacao pura do evento (fio e arquivo na mesma fonte)", "worm-unit" {    // A fonte unica e `auditEventJson`: /v1/audit e o espelho em arquivo
    // imprimem a MESMA linha — divergencia entre os dois formatos quebra
    // o terceiro verificador, entao a serializacao nao pode existir em dois
    // lugares (mutacao na pura quebra aqui E na listagem HTTP).
    var line = auditEventJson(AuditEvent("1700000000000", "account:mel", "device.registered", "acc-1/dev-1", "", "abc123"))
    assert(line.indexOf("\"at\":\"1700000000000\"") >= 0, "at")
    assert(line.indexOf("\"actor\":\"account:mel\"") >= 0, "ator")
    assert(line.indexOf("\"action\":\"device.registered\"") >= 0, "acao")
    assert(line.indexOf("\"target\":\"acc-1/dev-1\"") >= 0, "alvo")
    assert(line.indexOf("\"prevHash\":\"\"") >= 0, "prevHash (vazio vai)")
    assert(line.indexOf("\"hash\":\"abc123\"") >= 0, "hash")
    assert(line.indexOf("senha") < 0 && line.indexOf("password") < 0, "sem dado de cliente: so os 6 campos")
}

test "worm: espelho append-only sobrevive a poda do anel", "worm-unit" {
    var state = chainPath("worm-unit")
    var registry = Registry(state)
    var wormPath = state + ".worm.jsonl"
    // 101 contas = 101 eventos no espelho; o anel (cap 100 da fonte unica)
    // poda o mais antigo. O espelho NAO tem cap — e esse o ponto.
    var i = 0
    while (i < 101) {
        registry.createAccount("user" + intToString(i), "user" + intToString(i) + "@e.com", "segredo")
        i = i + 1
    }
    assert(registry.audit.size == 100, "anel podado em 100: " + intToString(registry.audit.size))
    var raw = readTextOr(wormPath, "FALTA")
    assert(raw.indexOf("FALTA") < 0, "espelho existe")
    var lines = raw.split("\n")
    var nonEmpty = 0
    for (var line in lines) {
        if (line.length > 0) {
            nonEmpty = nonEmpty + 1
        }
    }
    assert(nonEmpty == 101, "espelho com todas as linhas: " + intToString(nonEmpty))
    // Rescrita inteira do estado (save normal de qualquer mutacao) NAO toca
    // o espelho: o control-state.json e reescrito, o .worm.jsonl so cresce.
    var before = readTextOr(wormPath, "")
    registry.save()
    assert(readTextOr(wormPath, "") == before, "save nao rescreve o espelho")
}

test "worm: HTTP cria eventos no espelho; adulterar o espelho nao afeta a API", "worm" {
    var controlPort = 19913
    var state = chainPath("worm-http")
    var registry = Registry(state)
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", token)

    var raw = readTextOr(state + ".worm.jsonl", "")
    assert(raw.indexOf("account.created") >= 0, "evento da conta no espelho")
    assert(raw.indexOf("device.registered") >= 0, "evento do device no espelho")
    // A linha do espelho e JSON da fonte unica, com hash (o terceiro pode
    // verificar a trilha do arquivo sem acesso a API). A primeira linha e a
    // raiz da cadeia: prevHash vazio.
    var firstLine = raw.substring(0, raw.indexOf("\n"))
    var decoded = json.decode<Map<String, String>>(firstLine)
    assert(mapField(decoded, "action") == "account.created", "primeira linha e o primeiro evento")
    assert(mapField(decoded, "hash").length == 64, "hash sha256 na linha")
    assert(mapField(decoded, "prevHash") == "", "raiz sem anterior")

    // O espelho e trilha REDUNDANTE: adultera-lo nao afeta a API (o anel
    // em memoria e a fonte), nem e sobrescrito no proximo evento — o proximo
    // append cresce a partir do que esta no disco.
    writeTextTo(state + ".worm.jsonl", "{\"hackeado\":true}\n")
    var listed = httpGetToken(controlPort, "/v1/audit", token)
    assert(statusOf(listed) == 200, "listagem intacta")
    assert(bodyOf(listed).indexOf("account.created") >= 0, "anel e a fonte, nao o espelho")
    var mel = registry.accountByHandle("mel")
    if (mel != null) {
        registry.registerDevice(mel, "nb2", "pk2")
    }
    assert(readTextOr(state + ".worm.jsonl", "").indexOf("hackeado") >= 0, "append preserva o que ha no disco")
    assert(readTextOr(state + ".worm.jsonl", "").indexOf("device.registered") >= 0, "novo evento entra")
}

test "worm: verify do espelho tolera raiz desconhecida mas pega adulteracao", "worm-unit" {
    // Construo uma trilha de sufixo: a primeira ocorrencia da conta aponta
    // para um hash anterior ao espelho (deploy antigo) — NAO e cadeia
    // quebrada. A partir da segunda ocorrencia, a igualdade e exigida.
    var h1 = auditEventHash("hash-fora-do-espelho", "1", "account:mel", "account.created", "acc-1")
    var h2 = auditEventHash(h1, "2", "account:mel", "device.registered", "acc-1/dev-1")
    var h3 = auditEventHash(h2, "3", "account:mel", "device.revoked", "acc-1/dev-1")
    var suffix = listOf(
        AuditEvent("1", "account:mel", "account.created", "acc-1", "hash-fora-do-espelho", h1),
        AuditEvent("2", "account:mel", "device.registered", "acc-1/dev-1", h1, h2),
        AuditEvent("3", "account:mel", "device.revoked", "acc-1/dev-1", h2, h3)
    )
    assert(auditWormChainError(suffix) == "", "sufixo com raiz desconhecida integra")
    // Adulterar o ALVO da segunda ocorrencia: hash nao bate mais.
    var tampered = listOf(
        suffix.get(0),
        AuditEvent("2", "account:mel", "device.hacked", "acc-1/dev-1", h1, h2),
        suffix.get(2)
    )
    assert(auditWormChainError(tampered) == "1", "adulteracao no indice 1")
    // Remover o do meio: o prevHash do seguinte nao fecha.
    var withoutMiddle = listOf(suffix.get(0), suffix.get(2))
    assert(auditWormChainError(withoutMiddle) == "1", "remocao no indice 1")
    // Duas contas intercaladas: cada uma com raiz desconhecida propria.
    var hA1 = auditEventHash("fora", "1", "account:mel", "account.created", "acc-1")
    var hA2 = auditEventHash(hA1, "2", "account:mel", "device.registered", "acc-1/dev-1")
    var hB1 = auditEventHash("fora", "1", "account:ana", "account.created", "acc-2")
    var intercalated = listOf(
        AuditEvent("1", "account:mel", "account.created", "acc-1", "fora", hA1),
        AuditEvent("1", "account:ana", "account.created", "acc-2", "fora", hB1),
        AuditEvent("2", "account:mel", "device.registered", "acc-1/dev-1", hA1, hA2)
    )
    assert(auditWormChainError(intercalated) == "", "raiz desconhecida por conta")
}

test "worm: auditWormVerify decodifica JSONL e acusa linha ilegivel", "worm-unit" {
    var valid1 = auditEventJson(AuditEvent("1", "account:mel", "account.created", "acc-1", "", auditEventHash("", "1", "account:mel", "account.created", "acc-1")))
    var h1 = auditEventHash("", "1", "account:mel", "account.created", "acc-1")
    var h2 = auditEventHash(h1, "2", "account:mel", "device.registered", "acc-1/dev-1")
    var valid2 = auditEventJson(AuditEvent("2", "account:mel", "device.registered", "acc-1/dev-1", h1, h2))
    var ok = auditWormVerify(valid1 + "\n" + valid2 + "\n")
    assert(ok.parseable == true, "parseavel")
    assert(ok.brokenAt == "", "integra")
    assert(ok.events == 2, "dois eventos")
    assert(auditWormVerify("").parseable == true, "arquivo vazio = integra")
    assert(auditWormVerify("").brokenAt == "", "vazio integra")
    assert(auditWormVerify("").events == 0, "vazio zero eventos")
    // Linha com lixo (escrita trunca/adultera): parseable=false, brokenAt=parse.
    var broken = auditWormVerify(valid1 + "\n{lixo\n")
    assert(broken.parseable == false, "linha ilegivel")
    assert(broken.brokenAt == "parse", "indice de parse: " + broken.brokenAt)
    // Linha valida mas com hash adulterado: brokenAt numerico.
    var hacked = auditEventJson(AuditEvent("1", "account:mel", "account.created", "acc-1", "", "hash-falso"))
    var tampered = auditWormVerify(valid1 + "\n" + hacked + "\n")
    assert(tampered.parseable == true, "linha decodifica")
    assert(tampered.brokenAt == "1", "hash falso no indice 1")
}

test "worm: Registry.wormVerify le o arquivo real", "worm-unit" {
    var state = chainPath("worm-verify")
    var registry = Registry(state)
    var result = registry.wormVerify()
    assert(result.parseable == true, "arquivo ausente = parseavel")
    assert(result.brokenAt == "", "arquivo ausente = integra")
    assert(result.events == 0, "arquivo ausente = zero")
    registry.createAccount("mel", "m@e.com", "segredo")
    var result2 = registry.wormVerify()
    assert(result2.parseable == true, "com evento: parseavel")
    assert(result2.brokenAt == "", "com evento: integra")
    assert(result2.events == 1, "um evento: " + intToString(result2.events))
    // Linha truncada no meio (escrita trunca): parseable=false.
    var good = readTextOr(state + ".worm.jsonl", "")
    writeTextTo(state + ".worm.jsonl", good + "{\"at\":\"1\"," )
    var broken = registry.wormVerify()
    assert(broken.parseable == false, "linha ilegivel detectada")
    assert(broken.brokenAt == "parse", "indice de parse")
}

test "worm: HTTP /v1/audit/verify espelha o estado do arquivo", "worm" {
    var controlPort = 19914
    var state = chainPath("worm-verify-http")
    var registry = Registry(state)
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", token)

    var ok = httpGetToken(controlPort, "/v1/audit/verify", token)
    assert(statusOf(ok) == 200, "verify 200")
    assert(bodyOf(ok).indexOf("\"ok\":\"true\"") >= 0, "anel integra")
    assert(bodyOf(ok).indexOf("\"mirrorOk\":\"true\"") >= 0, "espelho integra: " + bodyOf(ok))
    assert(bodyOf(ok).indexOf("\"mirrorBrokenAt\":\"\"") >= 0, "sem quebra no espelho")

    // Espelho com hash falso na linha 2 (a raiz e tolerada, a segunda nao):
    // mirrorOk=false com mirrorBrokenAt=1 — cliente antigo sem os campos
    // continua decodificando {ok, brokenAt, events}.
    var mel = registry.accountByHandle("mel")
    var melId = ""
    if (mel != null) {
        melId = mel.id
    }
    var events = registry.auditForAccount(melId)
    var h2 = auditEventHash(events.get(0).hash, "2", "account:mel", "device.registered", "acc-1/dev-1")
    var hackedSecond = AuditEvent(events.get(1).at, events.get(1).actor, "device.hacked", events.get(1).target, events.get(0).hash, h2)
    writeTextTo(state + ".worm.jsonl", auditEventJson(events.get(0)) + "\n" + auditEventJson(hackedSecond) + "\n")
    var brokenVerify = httpGetToken(controlPort, "/v1/audit/verify", token)
    assert(bodyOf(brokenVerify).indexOf("\"mirrorOk\":\"false\"") >= 0, "espelho adulterado: " + bodyOf(brokenVerify))
    assert(bodyOf(brokenVerify).indexOf("\"mirrorBrokenAt\":\"1\"") >= 0, "quebra no indice 1")
    assert(bodyOf(brokenVerify).indexOf("\"ok\":\"true\"") >= 0, "anel segue integra (campos aditivos)")
}

test "worm: podador do espelho mantem linhas inteiras e o evento novo", "worm-unit" {
    assert(wormMirrorBytesFrom(0) == 8388608, "zero recai no default (8 MiB)")
    assert(wormMirrorBytesFrom(-5) == 8388608, "negativo recai no default")
    assert(wormMirrorBytesFrom(12345) == 12345, "valor positivo passa direto")
    // Sob o teto: byte a byte o append cru.
    assert(wormMirrorNext("a\n", "b", 1000) == "a\nb\n", "sob teto intacto")
    var h1 = auditEventHash("", "1", "account:mel", "account.created", "acc-1")
    var h2 = auditEventHash(h1, "2", "account:mel", "device.registered", "acc-1/dev-1")
    var h3 = auditEventHash(h2, "3", "account:mel", "device.revoked", "acc-1/dev-1")
    var e1 = auditEventJson(AuditEvent("1", "account:mel", "account.created", "acc-1", "", h1))
    var e2 = auditEventJson(AuditEvent("2", "account:mel", "device.registered", "acc-1/dev-1", h1, h2))
    var e3 = auditEventJson(AuditEvent("3", "account:mel", "device.revoked", "acc-1/dev-1", h2, h3))
    // Teto que so guarda as duas ultimas linhas: a cabeca (e1) sai inteira,
    // sem partir linha no meio.
    var cap = e2.length + e3.length + 2
    var trimmed = wormMirrorNext(e1 + "\n" + e2 + "\n", e3, cap)
    assert(trimmed == e2 + "\n" + e3 + "\n", "poda a cabeca em linha inteira")
    var verified = auditWormVerify(trimmed)
    assert(verified.parseable == true, "podado parseavel")
    assert(verified.brokenAt == "", "podado integra (raiz desconhecida tolerada)")
    assert(verified.events == 2, "dois eventos no podado: " + intToString(verified.events))
    // Teto menor que uma linha: o evento novo nunca e descartado.
    var newestOnly = wormMirrorNext(e1 + "\n" + e2 + "\n", e3, 10)
    assert(newestOnly == e3 + "\n", "so o mais novo sobrevive")
}

test "worm: Registry poda o espelho pelo teto e o anel fica intacto", "worm" {
    var state = chainPath("worm-cap")
    var registry = Registry(state)
    registry.createAccount("mel", "m@e.com", "segredo")
    registry.createAccount("ana", "a@e.com", "segredo")
    registry.createAccount("bia", "b@e.com", "segredo")
    var full = readTextOr(state + ".worm.jsonl", "")
    var expected = auditEventJson(registry.audit.get(0)) + "\n" + auditEventJson(registry.audit.get(1)) + "\n" + auditEventJson(registry.audit.get(2)) + "\n"
    assert(full == expected, "append sob teto identico ao cru")
    // Teto que so comporta a linha mais nova: o proximo append poda a cabeca.
    var newest = auditEventJson(registry.audit.get(2))
    registry.setWormCapBytes(newest.length + 10)
    registry.createAccount("dan", "d@e.com", "segredo")
    var trimmed = readTextOr(state + ".worm.jsonl", "")
    assert(trimmed == auditEventJson(registry.audit.get(3)) + "\n", "espelho podado mantem so o mais novo")
    assert(registry.audit.size == 4, "anel intacto: " + intToString(registry.audit.size))
    var verified = registry.wormVerify()
    assert(verified.parseable == true, "podado parseavel")
    assert(verified.brokenAt == "", "podado integra (raiz desconhecida)")
    assert(verified.events == 1, "um evento no espelho: " + intToString(verified.events))
}

test "worm: o espelho nunca carrega segredo (sem kfs_/kfc_/password no jsonl)", "worm-privacy" {
    // Medido: o espelho WORM (`<estado>.worm.jsonl`) cresce para sempre e o
    // `audit --sbom`/`scan` do CI podem acabar lendo o diretorio do estado.
    // Se algum dia um `kfs_`/`kfc_`/password escapasse para o evento, o
    // segredo ficaria preservado em claro num arquivo append-only — o
    // contrario do proposito (o anel guarda so metadados). Trava que le a
    // SERIE de eventos reais e proibe padrao de segredo em qualquer campo.
    var registry = Registry(chainPath("wormpriv"))
    var account = registry.createAccount("mel", "mel@e.com", "segredo-123")
    var token = registry.issueToken(account.id)
    var device = registry.registerDevice(account, "nb", "pk")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    // Emissao real de kfs_: o valor em claro existe aqui, mas nao pode
    // vazar para o espelho.
    var kfs = registry.issueServiceToken(account.id, service.id)
    assert(kfs.startsWith("kfs_"), "kfs emitido")
    // E uma revocacao com o valor completo (o pior caso de vazamento).
    assert(registry.revokeServiceToken(account.id, service.id, kfs), "kfs revogado")

    var mirrorPath = registry.path + ".worm.jsonl"
    var mirror = readTextOr(mirrorPath, "")
    assert(mirror.length > 0, "espelho existe e tem eventos")
    assert(mirror.indexOf("kfs_") < 0, "sem kfs_ no espelho")
    assert(mirror.indexOf("kfc_") < 0, "sem kfc_ no espelho")
    assert(mirror.indexOf("segredo-123") < 0, "sem senha no espelho")
    assert(mirror.indexOf(kfs) < 0, "sem o valor do kfs no espelho")
    assert(mirror.indexOf(token) < 0, "sem o valor do kfc no espelho")

    // E o FIO tem de carregar a MESMA garantia: /v1/audit imprime a mesma
    // serializacao do espelho (fonte unica `auditEventJson`, travada em
    // worm-unit), entao limpar so o arquivo seria metade da historia — o
    // operador consulta o anel pela API, nao pelo disco. Prova no fio de
    // verdade: control plane com este mesmo estado, emissao e revogacao
    // reais no anel, e nenhum padrao de segredo na resposta.
    var wirePort = 19915
    var control = ControlPlane(registry, wirePort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(wirePort, 60), "control no ar")
    var wire = httpGetToken(wirePort, "/v1/audit", token)
    assert(statusOf(wire) == 200, "fio lista eventos")
    var wireBody = bodyOf(wire)
    assert(wireBody.indexOf("service.token_issued") >= 0, "fio tem o evento da emissao")
    assert(wireBody.indexOf("kfs_") < 0, "sem kfs_ no fio")
    assert(wireBody.indexOf("kfc_") < 0, "sem kfc_ no fio")
    assert(wireBody.indexOf("segredo-123") < 0, "sem senha no fio")
    assert(wireBody.indexOf(kfs) < 0, "sem o valor do kfs no fio")
    assert(wireBody.indexOf(token) < 0, "sem o valor do kfc no fio")

}
