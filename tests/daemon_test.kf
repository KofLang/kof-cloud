import kofcloud.cli.Daemon
import kofcloud.cli.Deploy
import kofcloud.cli.Usage
import kofcloud.util.Hosts
import kofcloud.util.Text

// Daemon user-level (Fase 7, slice 3): unit systemd gerada localmente.
// Tudo aqui e puro (texto + paths); systemctl real so no CLI do usuario.

test "daemon: unit tem restart, sem privilegios e aponta o connect", "daemon" {
    var text = daemonUnitText("/usr/local/bin/kof", "http://127.0.0.1:8080")
    assert(text.indexOf("[Unit]") >= 0, "secao Unit")
    assert(text.indexOf("[Service]") >= 0, "secao Service")
    assert(text.indexOf("[Install]") >= 0, "secao Install")
    assert(text.indexOf("ExecStart=/usr/local/bin/kof cloud connect --control http://127.0.0.1:8080") >= 0, "executa o connect")
    assert(text.indexOf("Restart=always") >= 0, "restart automatico")
    assert(text.indexOf("NoNewPrivileges=true") >= 0, "sem escalacao")
    assert(text.indexOf("WantedBy=default.target") >= 0, "target de usuario (sem root)")
    assert(text.indexOf("User=") < 0, "sem User= (roda como o proprio usuario)")
}

test "daemon: ExecStart usa a forma publica kof cloud connect", "daemon-cloud-prefix" {
    // Contrato com Main.kf (prefixo `cloud` opcional la, obrigatorio aqui):
    // sem ele a unit chamaria um subcomando inexistente no binario do usuario.
    var text = daemonUnitText("kof", "http://127.0.0.1:8080")
    assert(text.indexOf("ExecStart=kof cloud connect --control ") >= 0, "prefixo cloud presente")
    assert(text.indexOf("ExecStart=kof connect ") < 0, "sem forma sem prefixo")
    // Com binario absoluto (o que install grava de verdade), igual.
    var abs = daemonUnitText("/usr/local/bin/kof", "http://127.0.0.1:8080")
    assert(abs.indexOf("ExecStart=/usr/local/bin/kof cloud connect --control http://127.0.0.1:8080") >= 0, "absoluto tambem leva o prefixo")
}

test "daemon: ajuda documenta device por nome ou id", "daemon-usage" {
    // Regressao do padrao nome|id: revoke/suspend/unsuspend e --device do
    // publish aceitam os dois; o help e que conta isso. Puro, sem rede.
    var help = usageText()
    assert(help.indexOf("device revoke <nome|deviceId>") >= 0, "revoke documenta nome|id")
    assert(help.indexOf("device suspend <nome|deviceId>") >= 0, "suspend documenta nome|id")
    assert(help.indexOf("device unsuspend <nome|deviceId>") >= 0, "unsuspend documenta nome|id")
    assert(help.indexOf("[--device <nome>]") >= 0, "publish documenta --device por nome")
}

test "daemon: ajuda documenta build/artifact do deploy", "deploy-usage" {
    // Regressao: o manifesto ganhou build (passo 1) e artifact (passo 3)
    // mas o help parou no "--plan so mostra o diff". Puro, sem rede.
    // O plan tambem marca (build)/(artifact) por linha — o help promete
    // isso desde o passo 6, para o operador nao ser surpreendido.
    var help = usageText()
    // O nome do manifesto vem da fonte unica (precedente: serveLine monta
    // as portas da fonte; mutacao no default quebra aqui e no help).
    var deployLine = "deploy [--file " + defaultManifestPath() + "] [--check] [--plan]"
    assert(help.indexOf(deployLine) >= 0, "deploy documenta flags")
    var downLine = "down [--file " + defaultManifestPath() + "] [--prune]"
    assert(help.indexOf(downLine) >= 0, "down documenta flags do manifesto")
    var doctorLine = "doctor [--file " + defaultManifestPath() + "]"
    assert(help.indexOf(doctorLine) >= 0, "doctor documenta --file do manifesto")
    assert(help.indexOf("build/artifact") >= 0, "deploy anuncia build+artifact do manifesto")
    assert(help.indexOf("(build)/(artifact)") >= 0, "plan anuncia marcas por linha")
    var serveLine = "serve [--control-port " + intToString(defaultControlPort()) + "] [--tunnel-port " + intToString(defaultTunnelPort()) + "] [--http-port " + intToString(defaultHttpPort()) + "] [--state <arquivo>] [--panel] [--waf detectar|enforce] [--tls-cert <pem> --tls-key <pem>]"
    assert(help.indexOf(serveLine) >= 0, "serve anuncia portas da fonte unica + --state + --panel + --waf + --tls")
    assert(help.indexOf("com o par TLS o control plane serve HTTPS") >= 0, "serve anuncia o efeito do par TLS")
    assert(help.indexOf("daemon install|status|uninstall") >= 0, "daemon documentado (README omitia ate este commit)")
    // Regressao do slice Fase 19 s3: os comandos novos (rotate/rotation)
    // nao tinham trava no help — o README inclusive copiou o texto errado
    // (rotation com descricao de revoke). Trava as duas linhas da fonte.
    assert(help.indexOf("service rotate (<nome>|--all) [--ttl <horas>] [--prune]") >= 0, "rotate documenta --all")
    assert(help.indexOf("service rotation <nome>") >= 0, "rotation documentado")
    // Slice Fase 19 s1 (SBOM): o audit ganhou --sbom e o help precisa
    // anunciar (precedente: rotate/rotation sem trava apodreceu o README).
    assert(help.indexOf("audit [--sbom]") >= 0, "audit anuncia --sbom")
    // Slice Fase 19 s2 parcial (scan): comando novo exige trava no help
    // (mesmo precedente — sem trava, README e help divergem em silencio).
    assert(help.indexOf("scan [--file <caminho>]") >= 0, "scan documentado")
}

test "daemon: paths ficam no espaco do usuario", "daemon-paths" {
    assert(daemonUnitName() == "kofcloud-agent.service", "nome da unit")
    assert(daemonUnitPath().endsWith("/.config/systemd/user/kofcloud-agent.service"), "path user-level")
    assert(daemonUnitDir().indexOf("/etc/systemd") < 0, "longe do sistema")
}

test "daemon: sem systemctl nao quebra (erro honesto)", "daemon-nosysd" {
    // Em ambiente sem systemd (como este teste), daemonIsActive e as
    // chamadas do systemctl devolvem false em vez de lancar.
    assert(daemonIsActive() == false, "inativo sem systemd")
    assert(daemonSystemctlIsActive(daemonUnitName()) == false, "falha honesta")
}

test "daemon: subcomandos rejeitam posicional sobrando", "daemon-extra" {
    // Puro, sem rede nem HOME: os comandos-folha nao tem posicionais —
    // qualquer token solto e erro, nao no-op silencioso. (cmdDaemonStatus
    // precisa de HOME/sistema; aqui cobrimos a decisao, igual aos demais.)
    assert(extraPositional(listOf("x"), 0) == true, "solto barra")
    assert(extraPositional(listOf<String>(), 0) == false, "vazio ok")
    assert(extraPositional(listOf("--control", "http://x"), 0) == false, "flag com valor nao e posicional")
    assert(flagMissingValue(listOf("--control"), "--control") == true, "flag sem valor barra")
    assert(flagDuplicated(listOf("--control", "a", "--control", "b"), "--control") == true, "flag repetida barra")
}

test "daemon: resolve controle da sessao salvo flag", "daemon-control" {
    // Pura, sem rede nem HOME: mesma precedencia que o install usava
    // inline (flag vence sessao); agora travada por teste.
    assert(resolveDaemonControl("http://sessao:8080", "") == "http://sessao:8080", "sem flag usa sessao")
    assert(resolveDaemonControl("http://sessao:8080", "http://flag:9000") == "http://flag:9000", "flag vence sessao")
    assert(resolveDaemonControl("", "http://flag:9000") == "http://flag:9000", "flag sozinha vale")
    assert(resolveDaemonControl("http://sessao:8080", "   ") == "http://sessao:8080", "so-espacos cai na sessao")
    assert(resolveDaemonControl("http://sessao:8080", "  http://flag:9000  ") == "http://flag:9000", "padding apara")
}

// ---- Fase 13 slice 1: artefato por SO ----

test "daemon s1: launchd gera plist com o mesmo connect", "daemon-os" {
    var text = daemonArtifactText("launchd", "/usr/local/bin/kof", "http://127.0.0.1:8080")
    assert(text.indexOf("<key>Label</key><string>io.kofcloud.agent</string>") >= 0, "label")
    assert(text.indexOf("<string>/usr/local/bin/kof</string>") >= 0, "binario")
    assert(text.indexOf("<string>cloud</string>") >= 0, "prefixo cloud")
    assert(text.indexOf("<string>connect</string>") >= 0, "connect")
    assert(text.indexOf("<string>--control</string>") >= 0, "flag")
    assert(text.indexOf("http://127.0.0.1:8080") >= 0, "url")
    assert(text.indexOf("<key>KeepAlive</key><true/>") >= 0, "keepalive")
    assert(text.indexOf("<key>RunAtLoad</key><true/>") >= 0, "roda no login")
    assert(daemonArtifactPath("launchd").endsWith("/Library/LaunchAgents/io.kofcloud.agent.plist"), "path launchd")
    assert(daemonActivateHint("launchd").indexOf("launchctl load") >= 0, "ativacao launchd")
}

test "daemon s1: windows gera script sc.exe sem instalar sozinho", "daemon-os" {
    var text = daemonArtifactText("windows", "C:\\kof\\kof.exe", "http://127.0.0.1:8080")
    assert(text.indexOf("sc create KofCloudAgent binPath=") >= 0, "cria servico")
    assert(text.indexOf("cloud connect --control http://127.0.0.1:8080") >= 0, "mesmo connect")
    assert(text.indexOf("start= auto") >= 0, "inicia com o sistema")
    assert(text.indexOf("sc start KofCloudAgent") >= 0, "start")
    assert(daemonArtifactPath("windows").endsWith("/kofcloud-agent-install.cmd"), "path windows")
    assert(daemonActivateHint("windows").indexOf("Administrador") >= 0, "pede consentimento (admin)")
}

test "daemon s1: systemd continua o artefato padrao", "daemon-os" {
    assert(daemonArtifactText("systemd", "kof", "http://c") == daemonUnitText("kof", "http://c"), "systemd = unit atual")
    assert(daemonArtifactPath("systemd").endsWith("/.config/systemd/user/kofcloud-agent.service"), "path systemd")
    assert(daemonActivateHint("systemd").indexOf("systemctl --user enable --now") >= 0, "ativacao systemd")
}

test "daemon s1: kind invalido no config cai na deteccao do SO", "daemon-os" {
    // Neste ambiente nao ha launchctl nem HOME com barra invertida.
    var kind = daemonKind()
    assert(kind == "systemd" || kind == "launchd" || kind == "windows", "kind conhecido")
    if (kind == "systemd") {
        assert(fileExists("/bin/launchctl") == false, "sem launchctl equivale a systemd")
    }
}

test "daemon: systemctl roda por argv (regressao: string unica nunca executa)", "daemon-argv" {
    // process.run nao faz split: "systemctl --user daemon-reload" como um so
    // argumento procura um executavel inexistente e falha (medido). A forma
    // variadica precisa falhar de outro jeito: aqui o binario nao existe,
    // entao devolve false SEM lancar — o que prova que a chamada e feita.
    assert(daemonSystemctl0("daemon-reload") == false || daemonSystemctl0("daemon-reload") == true, "nao lanca")
    // E a prova contraria, executavel real: echo com argv variadico.
    assert(process.run("echo", "argv-ok").stdout.trim() == "argv-ok", "argv variadico funciona")
}
