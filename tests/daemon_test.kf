import kofcloud.cli.Daemon
import kofcloud.cli.Usage

// Daemon user-level (Fase 7, slice 3): unit systemd gerada localmente.
// Tudo aqui e puro (texto + paths); systemctl real so no CLI do usuario.

test "daemon: unit tem restart, sem privilegios e aponta o connect", "daemon" {
    var text = daemonUnitText("/usr/local/bin/kof", "http://127.0.0.1:8080")
    assert(text.indexOf("[Unit]") >= 0, "secao Unit")
    assert(text.indexOf("[Service]") >= 0, "secao Service")
    assert(text.indexOf("[Install]") >= 0, "secao Install")
    assert(text.indexOf("ExecStart=/usr/local/bin/kof cloud connect --control http://127.0.0.1:8080") >= 0, "executa o connect")
    assert(text.indexOf("Restart=always") >= 0, "restart automatico")
    assert(text.indexOf("NoNewPrivileges=true") >= 0, "sem escalacao")
    assert(text.indexOf("WantedBy=default.target") >= 0, "target de usuario (sem root)")
    assert(text.indexOf("User=") < 0, "sem User= (roda como o proprio usuario)")
}

test "daemon: ExecStart usa a forma publica kof cloud connect", "daemon-cloud-prefix" {
    // Contrato com Main.kf (prefixo `cloud` opcional la, obrigatorio aqui):
    // sem ele a unit chamaria um subcomando inexistente no binario do usuario.
    var text = daemonUnitText("kof", "http://127.0.0.1:8080")
    assert(text.indexOf("ExecStart=kof cloud connect --control ") >= 0, "prefixo cloud presente")
    assert(text.indexOf("ExecStart=kof connect ") < 0, "sem forma sem prefixo")
    // Com binario absoluto (o que install grava de verdade), igual.
    var abs = daemonUnitText("/usr/local/bin/kof", "http://127.0.0.1:8080")
    assert(abs.indexOf("ExecStart=/usr/local/bin/kof cloud connect --control http://127.0.0.1:8080") >= 0, "absoluto tambem leva o prefixo")
}

test "daemon: ajuda documenta device por nome ou id", "daemon-usage" {
    // Regressao do padrao nome|id: revoke/suspend/unsuspend e --device do
    // publish aceitam os dois; o help e que conta isso. Puro, sem rede.
    var help = usageText()
    assert(help.indexOf("device revoke <nome|deviceId>") >= 0, "revoke documenta nome|id")
    assert(help.indexOf("device suspend <nome|deviceId>") >= 0, "suspend documenta nome|id")
    assert(help.indexOf("device unsuspend <nome|deviceId>") >= 0, "unsuspend documenta nome|id")
    assert(help.indexOf("[--device <nome>]") >= 0, "publish documenta --device por nome")
}

test "daemon: paths ficam no espaco do usuario", "daemon-paths" {
    assert(daemonUnitName() == "kofcloud-agent.service", "nome da unit")
    assert(daemonUnitPath().endsWith("/.config/systemd/user/kofcloud-agent.service"), "path user-level")
    assert(daemonUnitDir().indexOf("/etc/systemd") < 0, "longe do sistema")
}

test "daemon: sem systemctl nao quebra (erro honesto)", "daemon-nosysd" {
    // Em ambiente sem systemd (como este teste), daemonIsActive e
    // daemonSystemctl devolvem false em vez de lancar.
    assert(daemonIsActive() == false, "inativo sem systemd")
    assert(daemonSystemctl("is-active " + daemonUnitName()) == false, "falha honesta")
}

test "daemon: subcomandos rejeitam posicional sobrando", "daemon-extra" {
    // Puro, sem rede nem HOME: os comandos-folha nao tem posicionais —
    // qualquer token solto e erro, nao no-op silencioso. (cmdDaemonStatus
    // precisa de HOME/sistema; aqui cobrimos a decisao, igual aos demais.)
    assert(extraPositional(listOf("x"), 0) == true, "solto barra")
    assert(extraPositional(listOf<String>(), 0) == false, "vazio ok")
    assert(extraPositional(listOf("--control", "http://x"), 0) == false, "flag com valor nao e posicional")
    assert(flagMissingValue(listOf("--control"), "--control") == true, "flag sem valor barra")
    assert(flagDuplicated(listOf("--control", "a", "--control", "b"), "--control") == true, "flag repetida barra")
}
