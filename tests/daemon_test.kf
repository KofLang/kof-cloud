import kofcloud.cli.Daemon
import kofcloud.cli.Deploy
import kofcloud.cli.Usage
import kofcloud.store.Store
import kofcloud.util.Hosts
import kofcloud.util.Text
import testkit.Support

// Daemon user-level (Fase 7, slice 3): unit systemd gerada localmente.
// Tudo aqui e puro (texto + paths); systemctl real so no CLI do usuario.

test "daemon: unit tem restart, sem privilegios e aponta o connect", "daemon" {
    var text = daemonUnitText("/usr/local/bin/kof", "http://127.0.0.1:8080")
    need(text.indexOf("[Unit]") >= 0, "falhou")
    need(text.indexOf("[Service]") >= 0, "falhou")
    need(text.indexOf("[Install]") >= 0, "falhou")
    need(text.indexOf("ExecStart=/usr/local/bin/kof cloud connect --control http://127.0.0.1:8080") >= 0, "falhou")
    need(text.indexOf("Restart=always") >= 0, "falhou")
    need(text.indexOf("NoNewPrivileges=true") >= 0, "falhou")
    need(text.indexOf("WantedBy=default.target") >= 0, "falhou")
    need(text.indexOf("User=") < 0, "falhou")
}

test "daemon: ExecStart usa a forma publica kof cloud connect", "daemon-cloud-prefix" {
    // Contrato com Main.kf (prefixo `cloud` opcional la, obrigatorio aqui):
    // sem ele a unit chamaria um subcomando inexistente no binario do usuario.
    var text = daemonUnitText("kof", "http://127.0.0.1:8080")
    need(text.indexOf("ExecStart=kof cloud connect --control ") >= 0, "falhou")
    need(text.indexOf("ExecStart=kof connect ") < 0, "falhou")
    // Com binario absoluto (o que install grava de verdade), igual.
    var abs = daemonUnitText("/usr/local/bin/kof", "http://127.0.0.1:8080")
    need(abs.indexOf("ExecStart=/usr/local/bin/kof cloud connect --control http://127.0.0.1:8080") >= 0, "falhou")
}

test "daemon: ajuda documenta device por nome ou id", "daemon-usage" {
    // Regressao do padrao nome|id: revoke/suspend/unsuspend e --device do
    // publish aceitam os dois; o help e que conta isso. Puro, sem rede.
    var help = usageText()
    need(help.indexOf("device revoke <nome|deviceId> [--yes]") >= 0, "falhou")
    need(help.indexOf("device suspend <nome|deviceId>") >= 0, "falhou")
    need(help.indexOf("device unsuspend <nome|deviceId>") >= 0, "falhou")
    need(help.indexOf("[--device <nome>]") >= 0, "falhou")
}

test "daemon: ajuda documenta build/artifact do deploy", "deploy-usage" {
    // Regressao: o manifesto ganhou build (passo 1) e artifact (passo 3)
    // mas o help parou no "--plan so mostra o diff". Puro, sem rede.
    // O plan tambem marca (build)/(artifact) por linha — o help promete
    // isso desde o passo 6, para o operador nao ser surpreendido.
    var help = usageText()
    // O nome do manifesto vem da fonte unica (precedente: serveLine monta
    // as portas da fonte; mutacao no default quebra aqui e no help).
    var deployLine = "deploy [--file " + defaultManifestPath() + "] [--check] [--plan]"
    need(help.indexOf(deployLine) >= 0, "falhou")
    var downLine = "down [--file " + defaultManifestPath() + "] [--prune] [--yes]"
    need(help.indexOf(downLine) >= 0, "falhou")
    // Rota do `usage-parity`: o `--yes` tambem tem de estar na referencia
    // do README (a varredura generica trava so o primeiro token `down`).
    var readmeDown = readTextOr("README.md", "")
    need(readmeDown.indexOf("down [--file kofcloud.json] [--prune] [--yes]") >= 0, "falhou")
    var doctorLine = "doctor [--file " + defaultManifestPath() + "]"
    need(help.indexOf(doctorLine) >= 0, "falhou")
    need(help.indexOf("build/artifact") >= 0, "falhou")
    need(help.indexOf("(build)/(artifact)") >= 0, "falhou")
    var serveLine = "serve [--control-port " + intToString(defaultControlPort()) + "] [--tunnel-port " + intToString(defaultTunnelPort()) + "] [--http-port " + intToString(defaultHttpPort()) + "] [--state <arquivo>] [--backup-dir <dir>] [--panel] [--status-page] [--waf detectar|enforce] [--tls-cert <pem> --tls-key <pem> | --tls-cert-cmd <cmd> --tls-key-cmd <cmd>] [--tunnel-secret-file <arq> | --tunnel-secret-cmd <cmd>]"
    need(help.indexOf(serveLine) >= 0, "falhou")
    need(help.indexOf("com o par TLS o control plane serve HTTPS") >= 0, "falhou")
    need(help.indexOf("daemon install|status|uninstall") >= 0, "falhou")
    // Regressao do slice Fase 19 s3: os comandos novos (rotate/rotation)
    // nao tinham trava no help — o README inclusive copiou o texto errado
    // (rotation com descricao de revoke). Trava as duas linhas da fonte.
    need(help.indexOf("service rotate (<nome>|--all) [--ttl <horas>] [--prune]") >= 0, "falhou")
    need(help.indexOf("service rotation <nome>") >= 0, "falhou")
    // Slice Fase 19 s1 (SBOM): o audit ganhou --sbom e o help precisa
    // anunciar (precedente: rotate/rotation sem trava apodreceu o README).
    need(help.indexOf("audit [--sbom]") >= 0, "falhou")
    // Slice Fase 19 s2 parcial (scan): comando novo exige trava no help
    // (mesmo precedente — sem trava, README e help divergem em silencio).
    need(help.indexOf("scan [--file <caminho>]") >= 0, "falhou")
    // Slice Fase 17 s2 (freeze, lane): dispatcher/help/README existem mas
    // sem trava — mesmo precedente dos acima. Trava as duas linhas.
    need(help.indexOf("freeze service|device <nome|id>") >= 0, "falhou")
    need(help.indexOf("unfreeze service|device <nome|id>") >= 0, "falhou")
    // Alvo `account` (F17 s2 parcial): o help precisa anunciar as duas formas
    // sem id, senao o operador nao descobre a contencao da conta inteira.
    // Credencial da conta (F19 s3): comando novo exige trava no help.
    // Linha inteira com `|prune`: o assert de prefixo passaria mesmo sem o
    // prune — o mesmo drift que o uso do dispatch tinha (comando existe,
    // ajuda mente por omissao).
    need(help.indexOf("token list|revoke <id|kfc_...>|rotate [--ttl <horas>]|rotation|prune") >= 0, "falhou")
    need(help.indexOf("freeze account") >= 0, "falhou")
    need(help.indexOf("unfreeze account") >= 0, "falhou")
}

test "daemon: ajuda reconciliada com os comandos reais", "usage-parity" {
    // Auditoria README x help x realidade: o help parou no systemd do
    // slice user-level (a Fase 13 s1 trocou por artefato por SO), e o
    // README arrastava `audit`/`logs` de epocas anteriores e nunca ganhou
    // `service tokens`. O help e a interface que o binario mostra; o
    // README o espelha. Puro, sem rede.
    var help = usageText()
    need(help.indexOf("daemon install|status|uninstall   (artefato por SO") >= 0, "falhou")
    need(help.indexOf("systemd --user, sem root") < 0, "falhou")
    need(help.indexOf("service tokens   (credenciais validas SEM expiracao na conta)") >= 0, "falhou")
    need(help.indexOf("audit [--sbom] [--verify] [--action <acao>] [--tail <n>]") >= 0, "falhou")
    need(help.indexOf("logs [--tail <linhas>] [--runtime|--edge]") >= 0, "falhou")
    need(help.indexOf("scan [--file <caminho>] [--tls-cert <pem>]") >= 0, "falhou")
    // A lane do --watch (F13 s3) atualizou o help e deixou os dois
    // documentos do operador para tras (mesmo padrao do drift acima):
    // o README tem --watch no paragrafo de testes mas nao nas duas linhas
    // de comando, e o passo do flows §3.2 nao sabia da flag. Precedente
    // da trava cruzada em arquivo: status-counts le o README do disco.
    var readme = readTextOr("README.md", "")
    need(readme.indexOf("[--watch]   # publica (+ verifica; --plan so mostra; --watch observa") >= 0, "falhou")
    need(readme.indexOf("[--watch]  (roda build + publica + verifica; --plan so mostra o diff; --watch observa") >= 0, "falhou")
    var flows = readTextOr("docs/09-flows.md", "")
    need(flows.indexOf("kof cloud deploy [--file kofcloud.json] [--check] [--plan] [--watch]") >= 0, "falhou")
    // Exemplo de pipeline CI (F18 s3): o README aponta o arquivo do disco
    // e o teste do deploy o trava contra o help — aqui só garantimos que
    // o caminho continuou existindo na árvore combinada.
    need(readTextOr("docs/examples/ci-pipeline.yml", "").length > 0, "falhou")
    need(readTextOr("docs/examples/action.yml", "").length > 0, "falhou")
    // O push de uso (F18 s4) landou com `usage_push_test.kf`, mas a tabela
    // do 18-implemented ainda dizia "o export push segue pendente" — o
    // drift de prosa que esta execucao fechou. O OTel continua fora; a
    // frase e lida pelo caminho que sobra, entao volta-la para "pendente"
    // (ou apagar o push) quebra aqui.
    var implemented = readTextOr("docs/18-implemented.md", "")
    need(implemented.indexOf("o push por webhook (evento `usage.window`") >= 0, "falhou")
    need(implemented.indexOf("o export push (webhook/OTel) segue pendente") < 0, "falhou")
    // A lane do `usage --export` (F18 s4 ciclo de billing) atualizou o help
    // (`usage [--export]`, com a janela) e deixou a linha do README no texto
    // antigo sem a flag — mesmo padrao dos drifts acima. A varredura generica
    // abaixo so trava o primeiro token (`usage`), entao o drift de FLAG passa
    // pela rede: aqui a trava e da linha inteira, flag incluida.
    need(readme.indexOf("usage [--export]   (uso da conta: requests e bytes roteados pelo Edge; --export fecha a janela") >= 0, "falhou")
    // A lane do `domain list --json` (F6 paridade com service/device) atualizou
    // o help (`domain list [--json]`) — mesmo padrao do drift de flag acima:
    // a varredura generica trava so o primeiro token (`domain`), entao sem o
    // assert de linha inteira o README ficaria stale sem a flag. README + help
    // viajam juntos; a prova do json vive em `json_output_test.kf`.
    need(help.indexOf("domain list [--json]   (--json = saida estavel para CI)") >= 0, "falhou")
    need(readme.indexOf("domain list [--json]") >= 0, "falhou")
    // O README tambem arrastou o `domain add` so com o webhook: `--dns-cmd`
    // (F18 s1) existia no help, nos testes e na prosa, mas sumia da
    // referencia do usuario. Linha inteira (precedente do token/prune):
    // assert de prefixo passaria sem a fonte de DNS nova.
    need(readme.indexOf("domain add <hostname> --service <nome> [--dns-webhook <url> | --dns-cmd <cmd>] [--dry-run]") >= 0, "falhou")
    // Varredura generica help -> README: todo comando do help tem de ter
    // linha propria na referencia do README. Precedente real: a lane do
    // `usage` (F18 s4) atualizou o help e o paragrafo de suites e esqueceu
    // a tabela de comandos. Subcomando profundo fica por conta dos asserts
    // por linha acima — aqui a rede pega a classe inteira (comando inteiro
    // fora da referencia). Puro, sem rede.
    var cursor = 0
    var checked = 0
    while (cursor < help.length) {
        var nl = help.indexOf("\n", cursor)
        var lineEnd = help.length
        if (nl >= 0) {
            lineEnd = nl
        }
        var line = help.substring(cursor, lineEnd)
        if (line.length > 2 && line.charAt(0) as Int == 32 && line.charAt(1) as Int == 32) {
            // Primeiro token depois do indent (para em espaco, <, [ ou (
            // por codigo de char — precedente do parseEdgeHosts).
            var end = 2
            var scanning = true
            while (scanning && end < line.length) {
                var c = line.charAt(end) as Int
                if (c == 32 || c == 60 || c == 91 || c == 40) {
                    scanning = false
                } else {
                    end = end + 1
                }
            }
            var cmd = line.substring(2, end)
            // Primeira palavra so: "device list" e "freeze account" dividem
            // a palavra-raiz com irmãos que a tabela combina em uma linha.
            var sp = cmd.indexOf(" ")
            if (sp > 0) {
                cmd = cmd.substring(0, sp)
            }
            if (cmd.length > 0) {
                var found = readme.indexOf("\n" + cmd + " ") >= 0 || readme.indexOf("\n" + cmd + "\n") >= 0
                if (readme.indexOf(cmd + " ") == 0) {
                    found = true
                }
                need(found, "falhou")
                checked = checked + 1
            }
        }
        if (nl < 0) {
            cursor = help.length
        } else {
            cursor = nl + 1
        }
    }
    need(checked >= 30, "falhou")
}

test "daemon: paths ficam no espaco do usuario", "daemon-paths" {
    need(daemonUnitName() == "kofcloud-agent.service", "falhou")
    need(daemonUnitPath().endsWith("/.config/systemd/user/kofcloud-agent.service"), "falhou")
    need(daemonUnitDir().indexOf("/etc/systemd") < 0, "falhou")
}

test "daemon: sem systemctl nao quebra (erro honesto)", "daemon-nosysd" {
    // Em ambiente sem systemd (como este teste), daemonIsActive e as
    // chamadas do systemctl devolvem false em vez de lancar.
    need(daemonIsActive() == false, "falhou")
    need(daemonSystemctlIsActive(daemonUnitName()) == false, "falhou")
}

test "daemon: subcomandos rejeitam posicional sobrando", "daemon-extra" {
    // Puro, sem rede nem HOME: os comandos-folha nao tem posicionais —
    // qualquer token solto e erro, nao no-op silencioso. (cmdDaemonStatus
    // precisa de HOME/sistema; aqui cobrimos a decisao, igual aos demais.)
    need(extraPositional(listOf("x"), 0) == true, "falhou")
    need(extraPositional(listOf<String>(), 0) == false, "falhou")
    need(extraPositional(listOf("--control", "http://x"), 0) == false, "falhou")
    need(flagMissingValue(listOf("--control"), "--control") == true, "falhou")
    need(flagDuplicated(listOf("--control", "a", "--control", "b"), "--control") == true, "falhou")
}

test "daemon: resolve controle da sessao salvo flag", "daemon-control" {
    // Pura, sem rede nem HOME: mesma precedencia que o install usava
    // inline (flag vence sessao); agora travada por teste.
    need(resolveDaemonControl("http://sessao:8080", "") == "http://sessao:8080", "falhou")
    need(resolveDaemonControl("http://sessao:8080", "http://flag:9000") == "http://flag:9000", "falhou")
    need(resolveDaemonControl("", "http://flag:9000") == "http://flag:9000", "falhou")
    need(resolveDaemonControl("http://sessao:8080", "   ") == "http://sessao:8080", "falhou")
    need(resolveDaemonControl("http://sessao:8080", "  http://flag:9000  ") == "http://flag:9000", "falhou")
}

// ---- Fase 13 slice 1: artefato por SO ----

test "daemon s1: launchd gera plist com o mesmo connect", "daemon-os" {
    var text = daemonArtifactText("launchd", "/usr/local/bin/kof", "http://127.0.0.1:8080")
    need(text.indexOf("<key>Label</key><string>io.kofcloud.agent</string>") >= 0, "falhou")
    need(text.indexOf("<string>/usr/local/bin/kof</string>") >= 0, "falhou")
    need(text.indexOf("<string>cloud</string>") >= 0, "falhou")
    need(text.indexOf("<string>connect</string>") >= 0, "falhou")
    need(text.indexOf("<string>--control</string>") >= 0, "falhou")
    need(text.indexOf("http://127.0.0.1:8080") >= 0, "falhou")
    need(text.indexOf("<key>KeepAlive</key><true/>") >= 0, "falhou")
    need(text.indexOf("<key>RunAtLoad</key><true/>") >= 0, "falhou")
    need(daemonArtifactPath("launchd").endsWith("/Library/LaunchAgents/io.kofcloud.agent.plist"), "falhou")
    need(daemonActivateHint("launchd").indexOf("launchctl load") >= 0, "falhou")
}

test "daemon s1: windows gera script sc.exe sem instalar sozinho", "daemon-os" {
    var text = daemonArtifactText("windows", "C:\\kof\\kof.exe", "http://127.0.0.1:8080")
    need(text.indexOf("sc create KofCloudAgent binPath=") >= 0, "falhou")
    need(text.indexOf("cloud connect --control http://127.0.0.1:8080") >= 0, "falhou")
    need(text.indexOf("start= auto") >= 0, "falhou")
    need(text.indexOf("sc start KofCloudAgent") >= 0, "falhou")
    need(daemonArtifactPath("windows").endsWith("/kofcloud-agent-install.cmd"), "falhou")
    need(daemonActivateHint("windows").indexOf("Administrador") >= 0, "falhou")
}

test "daemon s1: systemd continua o artefato padrao", "daemon-os" {
    need(daemonArtifactText("systemd", "kof", "http://c") == daemonUnitText("kof", "http://c"), "falhou")
    need(daemonArtifactPath("systemd").endsWith("/.config/systemd/user/kofcloud-agent.service"), "falhou")
    need(daemonActivateHint("systemd").indexOf("systemctl --user enable --now") >= 0, "falhou")
}

test "daemon s1: kind invalido no config cai na deteccao do SO", "daemon-os" {
    // Neste ambiente nao ha launchctl nem HOME com barra invertida.
    var kind = daemonKind()
    need(kind == "systemd" || kind == "launchd" || kind == "windows", "falhou")
    if (kind == "systemd") {
        need(fileExists("/bin/launchctl") == false, "falhou")
    }
}

test "daemon: systemctl roda por argv (regressao: string unica nunca executa)", "daemon-argv" {
    // process.run nao faz split: "systemctl --user daemon-reload" como um so
    // argumento procura um executavel inexistente e falha (medido). A forma
    // variadica precisa falhar de outro jeito: aqui o binario nao existe,
    // entao devolve false SEM lancar — o que prova que a chamada e feita.
    need(daemonSystemctl0("daemon-reload") == false || daemonSystemctl0("daemon-reload") == true, "falhou")
    // E a prova contraria, executavel real: echo com argv variadico.
    need(process.run("echo", "argv-ok").stdout.trim() == "argv-ok", "falhou")
}
