import kofcloud.agent.Agent
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.edge.EdgeState
import kofcloud.edge.Http
import kofcloud.edge.HttpFront
import kofcloud.edge.Tunnel
import kofcloud.model.Errors
import kofcloud.util.Limits
import kofcloud.util.Text
import testkit.Support

// Enquadramento do corpo no Edge (RFC 9112 §6).
//
// O `Content-Length` e a fronteira do corpo que o Edge repassa ao servico
// local. Duas falhas medidas com o CLI 0.6.3:
//  * `999999999999` era lido com parseIntSafe e virava NEGATIVO (corpo
//    descartado em silencio); `4294967306` fazia wrap para 10 e o Edge
//    repassava 30 bytes com um header mentiroso — request smuggling.
//  * `Content-Length` duplicado divergente e `Transfer-Encoding` passavam
//    adiante (o servico local recebia uma fronteira que nao era a do Edge).
// Agora o valor e Long, e enquadramento ambiguo e recusado com 400 KCF118
// antes de rotear; bytes alem do declarado ficam fora do corpo relayado.

test "framing: Content-Length unico em Long, duplicado/TE invalidos", "framing-unit" {
    // Ausente = sem corpo.
    var none = parseContentLength(listOf<String>())
    need(none.invalid == false && none.value == 0L, "falhou")
    // Valor simples e espaco em volta.
    var plain = parseContentLength(listOf<String>("Host: x", "Content-Length: 42"))
    need(plain.invalid == false && plain.value == 42L, "falhou")
    var spaced = parseContentLength(listOf<String>("content-length:   7  "))
    need(spaced.invalid == false && spaced.value == 7L, "falhou")
    // Dois iguais sao aceitos (o RFC permite); divergentes sao smuggling.
    var equalDup = parseContentLength(listOf<String>("Content-Length: 7", "content-length: 7"))
    need(equalDup.invalid == false && equalDup.value == 7L, "falhou")
    var divergent = parseContentLength(listOf<String>("Content-Length: 3", "Content-Length: 4"))
    need(divergent.invalid, "falhou")
    // Nao numerico, vazio, sinal, hex, espaco interno.
    need(parseContentLength(listOf<String>("Content-Length: abc")).invalid, "falhou")
    need(parseContentLength(listOf<String>("Content-Length:")).invalid, "falhou")
    need(parseContentLength(listOf<String>("Content-Length: -5")).invalid, "falhou")
    need(parseContentLength(listOf<String>("Content-Length: +5")).invalid, "falhou")
    need(parseContentLength(listOf<String>("Content-Length: 0x10")).invalid, "falhou")
    need(parseContentLength(listOf<String>("Content-Length: 5 5")).invalid, "falhou")
    // Nome fora da forma canonica: o Edge nao reconheceria, alguns servidores
    // locais reconhecem — divergencia de fronteira.
    need(parseContentLength(listOf<String>("Content-Length : 5")).invalid, "falhou")
    need(parseContentLength(listOf<String>("Content-Length")).invalid, "falhou")
    // Chunked nao e decodificado pelo Edge: o header inteiro e recusado.
    need(parseContentLength(listOf<String>("Transfer-Encoding: chunked")).invalid, "falhou")
    need(parseContentLength(listOf<String>("Transfer-Encoding: identity", "Content-Length: 4")).invalid, "falhou")
    // Acima de 2^31 continua valido como Long (nada de wrap/negativo).
    var huge = parseContentLength(listOf<String>("Content-Length: 4294967306"))
    need(huge.invalid == false && huge.value == 4294967306L, "falhou")
    var giant = parseContentLength(listOf<String>("Content-Length: 999999999999"))
    need(giant.invalid == false && giant.value == 999999999999L, "falhou")
    need(giant.value > (limitMaxBodyBytes() as Long), "falhou")
    // Codigo e Hint existem (R6).
    need(errInvalidContentLength().indexOf("KCF118") >= 0, "falhou")
    need(errHint(errInvalidContentLength()).indexOf("Content-Length") >= 0, "falhou")
}


test "framing: Host unico, nao vazio e sem caractere invalido", "framing-host-unit" {
    // Um Host normal passa.
    need(hostIsUnambiguous(listOf<String>("Host: site.mel.kofcloud.io")), "falhou")
    need(hostIsUnambiguous(listOf<String>("host: Site.Mel.KofCloud.IO:443", "X-Outro: 1")), "falhou")
    // Ausente, vazio, duplicado (mesmo igual) e caractere de controle: ambiguos.
    need(hostIsUnambiguous(listOf<String>()) == false, "falhou")
    need(hostIsUnambiguous(listOf<String>("Host:")) == false, "falhou")
    need(hostIsUnambiguous(listOf<String>("Host:   ")) == false, "falhou")
    need(hostIsUnambiguous(listOf<String>("Host: a.kofcloud.io", "Host: b.kofcloud.io")) == false, "falhou")
    need(hostIsUnambiguous(listOf<String>("Host: a.kofcloud.io", "host: a.kofcloud.io")) == false, "falhou")
    // Espaco dentro do valor quebraria a linha ao reconstruir o pedido.
    need(hostIsUnambiguous(listOf<String>("Host: a b.kofcloud.io")) == false, "falhou")
    need(hostIsUnambiguous(listOf<String>("Host: a.kofcloud.io\rX-Injected: 1")) == false, "falhou")
    // Header parecido nao conta como Host.
    need(hostIsUnambiguous(listOf<String>("X-Host: a", "X-Host: b")) == false, "falhou")
    need(hostIsUnambiguous(listOf<String>("Host: a.kofcloud.io", "X-Host: b")) == true, "falhou")
    // Codigo e Hint (R6).
    need(errInvalidHost().indexOf("KCF119") >= 0, "falhou")
    need(errHint(errInvalidHost()).indexOf("Host") >= 0, "falhou")
}


test "framing: hop-by-hop e tokens do Connection nao atravessam o Edge", "framing-hop-unit" {
    // Hop-by-hop padrao: valem para a conexao cliente-Edge, nunca para a
    // conexao Edge-servico local. `proxy-authorization` e o caso caro: e
    // credencial de proxy e era repassada em claro ao servico.
    need(headerIsForwarded("Keep-Alive: timeout=5", listOf<String>(), false) == false, "falhou")
    need(headerIsForwarded("Proxy-Authorization: Basic x", listOf<String>(), false) == false, "falhou")
    need(headerIsForwarded("Proxy-Authenticate: Basic", listOf<String>(), false) == false, "falhou")
    need(headerIsForwarded("Upgrade: websocket", listOf<String>(), false) == false, "falhou")
    need(headerIsForwarded("TE: trailers", listOf<String>(), false) == false, "falhou")
    need(headerIsForwarded("Trailer: X-Sum", listOf<String>(), false) == false, "falhou")
    need(headerIsForwarded("Connection: keep-alive", listOf<String>(), false) == false, "falhou")
    need(headerIsForwarded("Transfer-Encoding: chunked", listOf<String>(), false) == false, "falhou")
    // Tokens nomeados no Connection sao hop-by-hop por declaracao.
    var tokens = connectionTokens(listOf<String>("Connection: close, X-Private", "Connection: TE"))
    need(tokens.contains("x-private") && tokens.contains("close") && tokens.contains("te"), "falhou")
    need(headerIsForwarded("X-Private: v", tokens, false) == false, "falhou")
    // `X-Forwarded-For` do cliente e descartado (o Edge escreve o seu).
    need(headerIsForwarded("X-Forwarded-For: 1.2.3.4", listOf<String>(), false) == false, "falhou")
    // End-to-end continua passando.
    need(headerIsForwarded("Host: site.mel.kofcloud.io", listOf<String>(), false), "falhou")
    need(headerIsForwarded("Content-Type: application/json", listOf<String>(), false), "falhou")
    need(headerIsForwarded("Cookie: a=1", listOf<String>(), false), "falhou")
    // Credenciais so caem em servico AUTHENTICATED (o Edge ja as consumiu).
    need(headerIsForwarded("Authorization: Bearer x", listOf<String>(), false), "falhou")
    need(headerIsForwarded("Authorization: Bearer x", listOf<String>(), true) == false, "falhou")
    need(headerIsForwarded("X-KofCloud-Token: kfc_x", listOf<String>(), true) == false, "falhou")
    // Reconstrucao real: o pedido que chega ao servico nao tem nenhum deles.
    var raw = bytesFromString("POST / HTTP/1.1\r\nHost: site.mel.kofcloud.io\r\nKeep-Alive: timeout=5\r\nUpgrade: websocket\r\nProxy-Authorization: Basic c2VjcmV0\r\nTE: trailers\r\nConnection: keep-alive, X-Private\r\nX-Private: v\r\nX-Forwarded-For: 1.2.3.4\r\nContent-Length: 2\r\n\r\nok")
    var out = bytesToString(serializeRequest(parseRequest(raw), "edge", false))
    need(out.indexOf("Keep-Alive") < 0 && out.indexOf("Upgrade") < 0, "falhou")
    need(out.indexOf("Proxy-Authorization") < 0 && out.indexOf("TE:") < 0, "falhou")
    need(out.indexOf("X-Private") < 0 && out.indexOf("1.2.3.4") < 0, "falhou")
    need(out.indexOf("Host: site.mel.kofcloud.io") >= 0, "falhou")
    need(out.indexOf("X-Forwarded-For: edge") >= 0, "falhou")
    need(out.endsWith("ok"), "falhou")
}


test "framing: resposta do upstream perde hop-by-hop e anuncia close", "framing-resp-unit" {
    // Upstream que anuncia keep-alive, hop-by-hop e um token nomeado: o
    // cliente veria "reuse esta conexao" para um socket que o Edge fecha.
    var upstream = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nConnection: keep-alive, X-Trace\r\nKeep-Alive: timeout=5\r\nX-Trace: abc\r\nProxy-Authenticate: Basic\r\nContent-Length: 2\r\n\r\nok"
    var out = bytesToString(sanitizeResponse(bytesFromString(upstream)))
    need(statusOf(out) == 200, "falhou")
    need(out.indexOf("Keep-Alive") < 0, "falhou")
    need(out.indexOf("X-Trace") < 0, "falhou")
    need(out.indexOf("Proxy-Authenticate") < 0, "falhou")
    need(out.indexOf("Connection: close") >= 0, "falhou")
    need(out.indexOf("Content-Type: text/plain") >= 0, "falhou")
    need(out.endsWith("\r\n\r\nok"), "falhou")
    // Sem `\r\n\r\n` (resposta crua) nada e inventado.
    var raw = "nao e http"
    need(bytesToString(sanitizeResponse(bytesFromString(raw))) == raw, "falhou")
    // Resposta que ja esta correta nao muda de significado.
    var clean = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 2\r\n\r\nok"
    var cleanOut = bytesToString(sanitizeResponse(bytesFromString(clean)))
    need(cleanOut.indexOf("Connection: close") >= 0, "falhou")
    need(bodyOf(cleanOut) == "ok", "falhou")
}


test "framing: resposta chunked do upstream e decodificada", "framing-chunked-unit" {
    // Transfer-Encoding e hop-by-hop: sai. Sem decodificar, o cliente
    // recebia o ENQUADRAMENTO como corpo ("5\r\nhello\r\n0") — medido.
    var one = decodeChunked(bytesFromString("5\r\nhello\r\n0\r\n\r\n"))
    need(one.valid && bytesToString(one.body) == "hello", "falhou")
    var multi = decodeChunked(bytesFromString("2\r\nab\r\n3\r\ncde\r\n0\r\n\r\n"))
    need(multi.valid && bytesToString(multi.body) == "abcde", "falhou")
    // Extensao de chunk (`;k=v`) e ignorada; CRLF final opcional.
    var ext = decodeChunked(bytesFromString("3;nome=valor\r\nabc\r\n0\r\n\r\n"))
    need(ext.valid && bytesToString(ext.body) == "abc", "falhou")
    // Malformado: nao lanca, nao entra em laco — devolve o que deu e invalido.
    need(decodeChunked(bytesFromString("zz\r\nabc\r\n")).valid == false, "falhou")
    need(decodeChunked(bytesFromString("9\r\nabc")).valid == false, "falhou")
    need(decodeChunked(bytesFromString("")).valid == false, "falhou")
    // Hex em Long (reusa a tabela do WAF).
    need(parseHexSafe("1a", -1L) == 26L, "falhou")
    need(parseHexSafe("FF", -1L) == 255L, "falhou")
    need(parseHexSafe("x", -1L) == -1L, "falhou")
    // Resposta completa: header chunked sai, corpo decodificado, close entra.
    var upstream = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Type: text/plain\r\n\r\n5\r\nhello\r\n0\r\n\r\n"
    var out = bytesToString(sanitizeResponse(bytesFromString(upstream)))
    need(out.toLowerCase().indexOf("transfer-encoding") < 0, "falhou")
    need(out.indexOf("Connection: close") >= 0, "falhou")
    need(out.indexOf("Content-Type: text/plain") >= 0, "falhou")
    need(bodyOf(out) == "hello", "falhou")
    // Sem chunked, o corpo continua byte a byte (inclusive CRLF).
    var plain = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\na\r\nb"
    need(bodyOf(bytesToString(sanitizeResponse(bytesFromString(plain)))) == "a\r\nb", "falhou")
}


test "framing: 1xx/204/304 e HEAD nunca entregam corpo", "framing-status-unit" {
    // Codigo e regra puras.
    need(statusCodeOf("HTTP/1.1 204 No Content") == 204, "falhou")
    need(statusCodeOf("HTTP/1.0 304 Not Modified") == 304, "falhou")
    need(statusCodeOf("HTTP/1.1 200 OK") == 200, "falhou")
    need(statusCodeOf("lixo") == -1, "falhou")
    need(statusCodeOf("HTTP/1.1 20 OK") == -1, "falhou")
    need(statusAllowsBody(200, "GET"), "falhou")
    need(statusAllowsBody(404, "POST"), "falhou")
    need(statusAllowsBody(200, "HEAD") == false, "falhou")
    need(statusAllowsBody(204, "GET") == false, "falhou")
    need(statusAllowsBody(304, "GET") == false, "falhou")
    need(statusAllowsBody(100, "POST") == false, "falhou")
    // Corpo de REQUISICAO que o metodo recusa (lado simetrico): so HEAD, e
    // so quando ha bytes — GET/POST/DELETE com corpo seguem legitimos.
    need(requestHasBody("HEAD", bytesFromString("abc")), "falhou")
    need(requestHasBody("HEAD", bytesEmpty()) == false, "falhou")
    need(requestHasBody("GET", bytesFromString("abc")) == false, "falhou")
    need(requestHasBody("POST", bytesFromString("abc")) == false, "falhou")
    need(requestHasBody("DELETE", bytesFromString("x")) == false, "falhou")
    need(errHeadWithBody().indexOf("KCF136") >= 0, "falhou")
    need(errHint(errHeadWithBody()).indexOf("HEAD") >= 0, "falhou")
    // 204/1xx perdem tambem o Content-Length; 304 e HEAD mantem (descrevem
    // a representacao do GET).
    var n204 = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 204 No Content\r\nContent-Length: 5\r\n\r\nhello"), "GET"))
    need(bodyOf(n204) == "", "falhou")
    need(n204.toLowerCase().indexOf("content-length") < 0, "falhou")
    var n100 = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 100 Continue\r\nContent-Length: 0\r\n\r\nx"), "POST"))
    need(bodyOf(n100) == "" && n100.toLowerCase().indexOf("content-length") < 0, "falhou")
    var n304 = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 304 Not Modified\r\nContent-Length: 3\r\nETag: x\r\n\r\nabc"), "GET"))
    need(bodyOf(n304) == "", "falhou")
    need(n304.indexOf("Content-Length: 3") >= 0 && n304.indexOf("ETag: x") >= 0, "falhou")
    var head = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok"), "HEAD"))
    need(bodyOf(head) == "", "falhou")
    need(head.indexOf("Content-Length: 2") >= 0, "falhou")
    // Corpo do HEAD descartado e NADA alem dele: a resposta termina no
    // separador (sem 4 bytes extras do separador vindo como corpo) e o
    // texto do corpo nao aparece em lugar nenhum. Sem o corte em `bodiless`
    // o `ok` continuaria no fim do stream e o cliente leria um corpo que o
    // HEAD proibe.
    need(head.endsWith("\r\n\r\n"), "falhou")
    need(head.endsWith("\r\n\r\nok") == false, "falhou")
    need(head.indexOf("ok") < 0, "falhou")
    // Mesma regra para chunked: decodifica e descarta, sem vazar o
    // enquadramento (nem os bytes decodificados).
    var headChunked = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "HEAD"))
    need(bodyOf(headChunked) == "", "falhou")
    need(headChunked.indexOf("hello") < 0, "falhou")
    need(headChunked.toLowerCase().indexOf("transfer-encoding") < 0, "falhou")
    // GET comum segue intacto.
    var get = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok"), "GET"))
    need(bodyOf(get) == "ok", "falhou")
    // 204 chunked: decodifica e descarta (nunca vaza enquadramento).
    var chunk204 = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 204 No Content\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "GET"))
    need(bodyOf(chunk204) == "", "falhou")
    need(chunk204.toLowerCase().indexOf("transfer-encoding") < 0, "falhou")
}


test "framing: Content-Length da resposta e reconciliado com o corpo real", "framing-resp-cl-unit" {
    // Medido: CL 2 com 7 bytes entregava os 7 (lixo no fim do stream) e
    // CL 100 com 2 bytes mantinha o header mentiroso.
    var over = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nokEXTRA"), "GET"))
    need(bodyOf(over) == "ok", "falhou")
    need(responseHeader(over, "content-length") == "2", "falhou")
    var under = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: 100\r\n\r\nok"), "GET"))
    need(bodyOf(under) == "ok", "falhou")
    need(responseHeader(under, "content-length") == "2", "falhou")
    var exact = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok"), "GET"))
    need(bodyOf(exact) == "ok" && responseHeader(exact, "content-length") == "2", "falhou")
    // Sem CL o Edge nao inventa um: o close delimita (comportamento de antes).
    var noCl = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\nok"), "GET"))
    need(bodyOf(noCl) == "ok", "falhou")
    need(noCl.toLowerCase().indexOf("content-length") < 0, "falhou")
    // HEAD e 304 mantem o CL original: descreve a representacao do GET.
    var head = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: 100\r\n\r\nok"), "HEAD"))
    need(bodyOf(head) == "" && responseHeader(head, "content-length") == "100", "falhou")
    var n304 = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 304 Not Modified\r\nContent-Length: 3\r\n\r\nabc"), "GET"))
    need(bodyOf(n304) == "" && responseHeader(n304, "content-length") == "3", "falhou")
    // Chunked decodificado ganha o CL do corpo decodificado.
    var chunk = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "GET"))
    need(bodyOf(chunk) == "hello", "falhou")
    need(chunk.toLowerCase().indexOf("transfer-encoding") < 0, "falhou")
    // CL invalido do upstream nao vira corte nem header novo.
    var badCl = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: abc\r\n\r\nok"), "GET"))
    need(bodyOf(badCl) == "ok", "falhou")
}


test "framing: resposta nao-HTTP do upstream vira 502 KCF131", "framing-badresp-unit" {
    // Sem linha de status enquadravel o Edge entregava bytes crus ao cliente.
    need(responseIsParseable(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")), "falhou")
    need(responseIsParseable(bytesFromString("HTTP/1.0 404 Not Found\r\n\r\n")), "falhou")
    need(responseIsParseable(bytesFromString("GARBAGE RESPONSE\r\nX: y\r\n\r\npayload")) == false, "falhou")
    need(responseIsParseable(bytesFromString("HTTP/1.1 XX OK\r\n\r\n")) == false, "falhou")
    need(responseIsParseable(bytesFromString("HTTP/1.1 999 Nope\r\n\r\n")) == false, "falhou")
    need(responseIsParseable(bytesFromString("HTTP/1.1 20 OK\r\n\r\n")) == false, "falhou")
    need(responseIsParseable(bytesFromString("nao e http")) == false, "falhou")
    need(responseIsParseable(bytesFromString("")) == false, "falhou")
    // Codigo e Hint (R6).
    need(errInvalidUpstreamResponse().indexOf("KCF131") >= 0, "falhou")
    need(errHint(errInvalidUpstreamResponse()).indexOf("HTTP") >= 0, "falhou")
}


test "framing: linha de requisicao fora do formato vira 400 KCF132", "framing-reqline-unit" {
    // Tres partes, metodo token, path absoluto e versao HTTP/1.x.
    need(requestLineIsValid("GET / HTTP/1.1"), "falhou")
    need(requestLineIsValid("POST /api/x?y=1 HTTP/1.0"), "falhou")
    need(requestLineIsValid("DELETE / HTTP/1.1"), "falhou")
    need(requestLineIsValid("GE T / HTTP/1.1") == false, "falhou")
    need(requestLineIsValid("GET /") == false, "falhou")
    need(requestLineIsValid("HTTP/1.1 200 OK") == false, "falhou")
    need(requestLineIsValid("GET  / HTTP/1.1") == false, "falhou")
    need(requestLineIsValid("GET x HTTP/1.1") == false, "falhou")
    need(requestLineIsValid("GET / HTTP/2.0") == false, "falhou")
    need(requestLineIsValid("G\tT / HTTP/1.1") == false, "falhou")
    // Path: caractere de controle quebraria a linha ao reconstruir o pedido.
    need(requestLineIsValid("GET /a\rb HTTP/1.1") == false, "falhou")
    need(requestLineIsValid("GET /a\tb HTTP/1.1") == false, "falhou")
    need(requestLineIsValid("GET /a b HTTP/1.1") == false, "falhou")
    need(requestLineIsValid("GET http://evil.example/x HTTP/1.1") == false, "falhou")
    need(requestLineIsValid("GET /a%20b?q=1 HTTP/1.1"), "falhou")
    // Parser: linha invalida deixa método vazio (o chamador recusa); válida
    // preenche método/path/versão.
    var ok = parseRequest(bytesFromString("GET /a HTTP/1.1\r\nHost: x\r\n\r\n"))
    need(ok.method == "GET" && ok.path == "/a" && ok.version == "HTTP/1.1", "falhou")
    var bad = parseRequest(bytesFromString("GE T / HTTP/1.1\r\nHost: x\r\n\r\n"))
    need(bad.method == "", "falhou")
    var status = parseRequest(bytesFromString("HTTP/1.1 200 OK\r\n\r\n"))
    need(status.method == "", "falhou")
    var ctrlPath = parseRequest(bytesFromString("GET /a\rb HTTP/1.1\r\nHost: x\r\n\r\n"))
    need(ctrlPath.method == "", "falhou")
    // Codigo e Hint (R6).
    need(errInvalidRequestLine().indexOf("KCF132") >= 0, "falhou")
    need(errHint(errInvalidRequestLine()).indexOf("METODO") >= 0, "falhou")
}


test "framing: cabecalho malformado vira 400 KCF133", "framing-hdrline-unit" {
    need(headerLineIsValid("Host: x.kofcloud.io"), "falhou")
    need(headerLineIsValid("X-Vazio:"), "falhou")
    need(headerLineIsValid("X-Espaco:  a b  "), "falhou")
    need(headerLineIsValid("Cookie: a=1; b=2"), "falhou")
    need(headerLineIsValid("semdoispontos") == false, "falhou")
    need(headerLineIsValid(": v") == false, "falhou")
    need(headerLineIsValid("X-A b: v") == false, "falhou")
    need(headerLineIsValid("X-A\rb: v") == false, "falhou")
    need(headerLineIsValid("X-A\tb: v") == false, "falhou")
    need(headerLineIsValid("X-A: v\rw") == false, "falhou")
    need(headerLineIsValid("X-A: v\nw") == false, "falhou")
    // Lista: basta uma linha ruim para recusar o pedido inteiro.
    need(headersAreValid(listOf<String>("Host: x", "X-Ok: 1")), "falhou")
    need(headersAreValid(listOf<String>()), "falhou")
    need(headersAreValid(listOf<String>("Host: x", "lixo")) == false, "falhou")
    // Codigo e Hint (R6).
    need(errInvalidHeaderLine().indexOf("KCF133") >= 0, "falhou")
    need(errHint(errInvalidHeaderLine()).indexOf("Nome") >= 0, "falhou")
}


test "framing: 1xx intermediario e pulado ate a resposta final", "framing-interim-unit" {
    // Medido: 100 Continue + 200 OK virava um 100 com corpo vazio (o cliente
    // nunca via a resposta final).
    var one = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 2\r\n\r\nok"), "POST"))
    need(statusOf(one) == 200, "falhou")
    need(bodyOf(one) == "ok", "falhou")
    need(one.indexOf("100 Continue") < 0, "falhou")
    // Varios interinos seguidos.
    var many = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 103 Early Hints\r\nLink: </x>\r\n\r\nHTTP/1.1 201 Created\r\n\r\nhi"), "POST"))
    need(statusOf(many) == 201, "falhou")
    need(bodyOf(many) == "hi", "falhou")
    need(many.indexOf("Early Hints") < 0 && many.indexOf("100 Continue") < 0, "falhou")
    // Interino com headers nao vaza nenhum deles.
    var withHdr = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 100 Continue\r\nX-Interim: v\r\n\r\nHTTP/1.1 200 OK\r\n\r\nok"), "POST"))
    need(withHdr.indexOf("X-Interim") < 0, "falhou")
    // Resposta normal nao muda.
    var plain = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok"), "GET"))
    need(statusOf(plain) == 200 && bodyOf(plain) == "ok", "falhou")
    // Bloco 1xx sem terminador (resposta incompleta) volta como veio.
    var broken = "HTTP/1.1 100 Continue"
    need(bytesToString(sanitizeResponse(bytesFromString(broken), "POST")) == broken, "falhou")
}


test "framing: query nao interfere nas decisoes da plataforma", "framing-query-unit" {
    // Medido: /security.txt?x=1 caia no roteamento (404) porque o parser
    // mantem a query no path. A plataforma decide pelo caminho.
    need(pathWithoutQuery("/.well-known/security.txt?x=1") == "/.well-known/security.txt", "falhou")
    need(pathWithoutQuery("/a/b") == "/a/b", "falhou")
    need(pathWithoutQuery("/?") == "/", "falhou")
    need(pathWithoutQuery("/a?b?c") == "/a", "falhou")
    // O path do PEDIDO continua inteiro (a query vai ao servico local).
    var req = parseRequest(bytesFromString("GET /api/x?page=2 HTTP/1.1\r\nHost: a\r\n\r\n"))
    need(req.path == "/api/x?page=2", "falhou")
    need(pathWithoutQuery(req.path) == "/api/x", "falhou")
}

// Troca crua: manda os bytes e le ate o Edge fechar (Connection: close).
String rawExchange(Int port, String raw) {
    var conn = net.connect("127.0.0.1", port)
    conn.send(bytesFromString(raw))
    var out = ""
    var reading = true
    while (reading) {
        var chunk = conn.receive(8192)
        if (chunk.length == 0) {
            reading = false
        } else {
            out = out + bytesToString(chunk)
        }
    }
    conn.close()
    return out
}

Int metricValue(String exposition, String name) {
    for (var line in exposition.split("\n")) {
        var trimmed = line.trim()
        if (trimmed.startsWith(name + " ")) {
            return parseIntSafe(trimmed.substring(name.length + 1).trim(), -1)
        }
    }
    return -1
}

test "framing: enquadramento ambiguo vira 400 KCF118 e gigante vira 413", "framing" {
    var httpPort = 19958
    var registry = Registry("/tmp/kofcloud-framing-" + crypto.randomHex(4) + ".json")
    var edgeState = EdgeState(registry)
    var edgeStop = "/tmp/kofcloud-framing-edge-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    var httpTask = spawn { serveHttp(edgeState, httpPort, limitMaxBodyBytes(), edgeStop) }
    need(waitForPort(httpPort, 60), "falhou")

    var host = "x.kofcloud.io"
    // Duplicado divergente: 400 antes de rotear (sem rota, o desfecho
    // antigo seria 404). O corpo curto mantem o teste rapido em qualquer
    // implementacao.
    var dup = rawExchange(httpPort, "POST / HTTP/1.1\r\nHost: " + host + "\r\nContent-Length: 3\r\nContent-Length: 4\r\nConnection: close\r\n\r\nabcd")
    need(statusOf(dup) == 400, "falhou")
    need(bodyOf(dup).indexOf("KCF118") >= 0, "falhou")

    // Transfer-Encoding: o Edge nao decodifica chunked; repassar o header
    // faria o servico local esperar um corpo que nunca chega.
    var chunked = rawExchange(httpPort, "POST / HTTP/1.1\r\nHost: " + host + "\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\nabcd")
    need(statusOf(chunked) == 400, "falhou")
    need(bodyOf(chunked).indexOf("KCF118") >= 0, "falhou")

    // Valor que fazia wrap em Int (4294967306 -> 10): agora e Long e cai no
    // teto de leitura/politica (413), nunca em 404 com corpo de 10 bytes.
    var wrapped = rawExchange(httpPort, "POST / HTTP/1.1\r\nHost: " + host + "\r\nContent-Length: 4294967306\r\nConnection: close\r\n\r\n0123456789LEFTOVERLEFTOVERLEFTOVER")
    need(statusOf(wrapped) == 413, "falhou")
    need(bodyOf(wrapped).indexOf("KCF110") >= 0, "falhou")

    // Valor que virava negativo: mesmo desfecho (413), nunca corpo descartado.
    var negative = rawExchange(httpPort, "POST / HTTP/1.1\r\nHost: " + host + "\r\nContent-Length: 999999999999\r\nConnection: close\r\n\r\nabcd")
    need(statusOf(negative) == 413, "falhou")
    need(bodyOf(negative).indexOf("KCF110") >= 0, "falhou")

    // Enquadramento valido atravessa: sem rota, 404 opaco (nao 400/413).
    var plain = httpPostRaw(httpPort, "/", host, listOf<String>(), "ok")
    need(statusOf(plain) == 404, "falhou")

    // HEAD com corpo: 400 KCF136 antes de rotear. O Edge nao entrega o corpo
    // ao servico local, entao aceitar o pedido esconderia do cliente um erro
    // dele; e um servico local que lesse o corpo bloquearia esperando bytes
    // que o relay nunca manda.
    var headBody = rawExchange(httpPort, "HEAD / HTTP/1.1\r\nHost: " + host + "\r\nContent-Length: 3\r\nConnection: close\r\n\r\nabc")
    need(statusOf(headBody) == 400, "falhou")
    need(bodyOf(headBody).indexOf("KCF136") >= 0, "falhou")

    // Conta por motivo, sem ecoar o valor do header.
    var counted = false
    var waits = 100
    while (waits > 0 && counted == false) {
        if (metricValue(observability.metrics(), "kofcloud_edge_http_denied_total_invalid_framing") >= 1) {
            counted = true
        } else {
            time.sleep(50)
            waits = waits - 1
        }
    }
    need(counted, "falhou")

    // Host ambiguo: duplicado, ausente e com caractere invalido -> 400 KCF119
    // antes de rotear (sem rota, o desfecho antigo seria 404 — mas com dois
    // Host o Edge roteava pelo primeiro e repassava os dois ao servico).
    var dupHost = rawExchange(httpPort, "GET / HTTP/1.1\r\nHost: " + host + "\r\nHost: evil.example.com\r\nConnection: close\r\n\r\n")
    need(statusOf(dupHost) == 400, "falhou")
    need(bodyOf(dupHost).indexOf("KCF119") >= 0, "falhou")
    var noHost = rawExchange(httpPort, "GET / HTTP/1.1\r\nConnection: close\r\n\r\n")
    need(statusOf(noHost) == 400, "falhou")
    need(bodyOf(noHost).indexOf("KCF119") >= 0, "falhou")
    var badHost = rawExchange(httpPort, "GET / HTTP/1.1\r\nHost: " + host + "\r\nX-KofCloud-Token: a\r\nHost: " + host + "\r\nConnection: close\r\n\r\n")
    need(statusOf(badHost) == 400, "falhou")

    var hostCounted = false
    var hostWaits = 100
    while (hostWaits > 0 && hostCounted == false) {
        if (metricValue(observability.metrics(), "kofcloud_edge_http_denied_total_invalid_host") >= 1) {
            hostCounted = true
        } else {
            time.sleep(50)
            hostWaits = hostWaits - 1
        }
    }
    need(hostCounted, "falhou")

    // Linha de requisicao fora do formato: 400 KCF132 antes de rotear. Sem
    // isso "GE T / HTTP/1.1" virava metodo "GE" + path "T" e seguia adiante.
    var badLine = rawExchange(httpPort, "GE T / HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n")
    need(statusOf(badLine) == 400, "falhou")
    need(bodyOf(badLine).indexOf("KCF132") >= 0, "falhou")
    var statusLine = rawExchange(httpPort, "HTTP/1.1 200 OK\r\nHost: " + host + "\r\nConnection: close\r\n\r\n")
    need(statusOf(statusLine) == 400, "falhou")
    need(bodyOf(statusLine).indexOf("KCF132") >= 0, "falhou")
    // CR no path: sem a validacao a linha se partia ao repassar (injection).
    var crPath = rawExchange(httpPort, "GET /a\rb HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n")
    need(statusOf(crPath) == 400, "falhou")
    need(bodyOf(crPath).indexOf("KCF132") >= 0, "falhou")
    // Cabecalho com CR no nome: 400 KCF133 antes de rotear (sem isso a linha
    // se partia no servico local).
    var crHeader = rawExchange(httpPort, "GET / HTTP/1.1\r\nHost: " + host + "\r\nX-A\rb: v\r\nConnection: close\r\n\r\n")
    need(statusOf(crHeader) == 400, "falhou")
    need(bodyOf(crHeader).indexOf("KCF133") >= 0, "falhou")
    var lineNoColon = rawExchange(httpPort, "GET / HTTP/1.1\r\nHost: " + host + "\r\nsemdoispontos\r\nConnection: close\r\n\r\n")
    need(statusOf(lineNoColon) == 400, "falhou")
    need(bodyOf(lineNoColon).indexOf("KCF133") >= 0, "falhou")

    var hdrCounted = false
    var hdrWaits = 100
    while (hdrWaits > 0 && hdrCounted == false) {
        if (metricValue(observability.metrics(), "kofcloud_edge_http_denied_total_invalid_header_line") >= 1) {
            hdrCounted = true
        } else {
            time.sleep(50)
            hdrWaits = hdrWaits - 1
        }
    }
    need(hdrCounted, "falhou")

    var lineCounted = false
    var lineWaits = 100
    while (lineWaits > 0 && lineCounted == false) {
        if (metricValue(observability.metrics(), "kofcloud_edge_http_denied_total_invalid_request_line") >= 1) {
            lineCounted = true
        } else {
            time.sleep(50)
            lineWaits = lineWaits - 1
        }
    }
    need(lineCounted, "falhou")

    writeTextTo(edgeStop, "stop")
    time.sleep(1000)
    File(edgeStop).delete()
}

// Servico local que anota exatamente o corpo recebido (nao o header).
void captureLocal(Conn peer, String[] body, String[] headOut) {
    var req = ""
    var headEnd = -1
    while (headEnd < 0) {
        var chunk = peer.receive(4096)
        if (chunk.length == 0) {
            peer.close()
            return
        }
        req = req + bytesToString(chunk)
        headEnd = req.indexOf("\r\n\r\n")
    }
    var head = req.substring(0, headEnd)
    var declared = parseContentLength(splitLines(head))
    var current = req.substring(headEnd + 4)
    var want = 0
    if (declared.invalid == false) {
        want = declared.value as Int
    }
    while (current.length < want) {
        var chunk = peer.receive(4096)
        if (chunk.length == 0) {
            break
        }
        current = current + bytesToString(chunk)
    }
    // A sonda de health do Agent tambem conecta aqui; so o POST e medido.
    if (head.indexOf("POST ") == 0) {
        headOut[0] = head
        body[0] = current
    }
    // Anuncia keep-alive de proposito: o Edge fecha a conexao publica sempre,
    // entao esse header nao pode chegar ao cliente.
    var resp = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nConnection: keep-alive\r\nKeep-Alive: timeout=5\r\nContent-Length: 2\r\n\r\nok"
    // GET responde CHUNKED (o POST continua fixo, e o que os asserts medem):
    // o cliente tem que receber o corpo decodificado, nunca o enquadramento.
    if (head.indexOf("GET ") == 0) {
        resp = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n"
    }
    // PATCH responde com um 1xx INTERMEDIARIO antes da final: o cliente tem
    // que receber so a resposta final (100 Continue e um bloco de protocolo,
    // nao uma resposta).
    if (head.indexOf("PATCH ") == 0) {
        resp = "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 2\r\n\r\nok"
    }
    // HEAD responde 204 COM corpo de proposito (servidor mal comportado): o
    // Edge nao pode entregar esses bytes ao cliente.
    if (head.indexOf("HEAD ") == 0) {
        resp = "HTTP/1.1 204 No Content\r\nContent-Length: 5\r\n\r\nhello"
    }
    // PUT responde com CL MENTIROSO (declara 100, manda 2): o cliente tem que
    // receber o corpo real e um CL que nao minta (o Edge delimita por close).
    if (head.indexOf("PUT ") == 0) {
        resp = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 100\r\n\r\nok"
    }
    // DELETE responde LIXO (sem linha de status): o Edge tem que recusar com
    // 502 em vez de repassar bytes que o cliente nao consegue interpretar.
    if (head.indexOf("DELETE ") == 0) {
        resp = "GARBAGE RESPONSE\r\nX-Debug: nao-vaza\r\n\r\npayload-secreto"
    }
    peer.send(bytesFromString(resp))
    peer.close()
}

test "framing: corpo relayado tem exatamente o tamanho declarado", "framing-relay" {
    var localSvc = 19960
    var controlPort = 19961
    var tunnelPort = 19962
    var httpPort = 19963
    // Corpo real 24 bytes, declarado 10: o excedente nao pode chegar ao
    // servico local nem virar a proxima requisicao.
    var malicious = "0123456789LEFTOVERLEFTOVER"

    var received = new String[1]
    received[0] = ""
    var seenHead = new String[1]
    seenHead[0] = ""
    var localListener = net.listen(localSvc)
    var localTask = spawn {
        var serving = true
        while (serving) {
            try {
                var peer = localListener.accept()
                var worker = spawn { captureLocal(peer, received, seenHead) }
            } catch (String e) {
                serving = false
            }
        }
    }
    need(waitForPort(localSvc, 60), "falhou")

    var registry = Registry("/tmp/kofcloud-framing-relay-" + crypto.randomHex(4) + ".json")
    var edgeState = EdgeState(registry)
    var edgeStop = "/tmp/kofcloud-framing-relay-edge-" + crypto.randomHex(4) + ".txt"
    var agentStop = "/tmp/kofcloud-framing-relay-agent-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    File(agentStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, "", edgeStop) }
    var httpTask = spawn { serveHttp(edgeState, httpPort, limitMaxBodyBytes(), edgeStop) }
    need(waitForPort(controlPort, 60), "falhou")
    need(waitForPort(tunnelPort, 60), "falhou")
    need(waitForPort(httpPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var account = json.decode<Map<String, String>>(bodyOf(created))
    var accountToken = mapField(account, "token")
    var accountId = mapField(account, "accountId")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pubkey\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"" + intToString(localSvc) + "\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    need(statusOf(httpPostJson(controlPort, "/v1/services", pubBody, accountToken)) == 200, "falhou")

    var config = AgentConfig("http://127.0.0.1:" + intToString(controlPort), deviceId, accountId, accountToken, "", agentStop, "127.0.0.1", tunnelPort, 100)
    var agentTask = spawn { runAgent(config, true) }
    var online = false
    var attempts = 100
    while (attempts > 0 && online == false) {
        online = edgeState.isOnline(deviceId)
        if (online == false) {
            time.sleep(50)
            attempts = attempts - 1
        }
    }
    need(online, "falhou")

    var host = "site.mel.kofcloud.io"
    var smuggled = rawExchange(httpPort, "POST / HTTP/1.1\r\nHost: " + host + "\r\nContent-Length: 10\r\nConnection: close\r\n\r\n" + malicious)
    need(statusOf(smuggled) == 200, "falhou")
    need(received[0].length == 10, "falhou")
    need(received[0] == "0123456789", "falhou")
    need(received[0].indexOf("LEFTOVER") < 0, "falhou")
    // O Host que roteou e o unico que a aplicacao ve.
    need(seenHead[0].indexOf("Host: " + host) >= 0, "falhou")
    var hostLines = 0
    for (var line in seenHead[0].split("\n")) {
        if (line.trim().toLowerCase().startsWith("host:")) {
            hostLines = hostLines + 1
        }
    }
    need(hostLines == 1, "falhou")

    // Host injetado nem chega ao relay: 400 KCF119 antes de abrir stream.
    var injected = rawExchange(httpPort, "POST / HTTP/1.1\r\nHost: " + host + "\r\nHost: evil.example.com\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok")
    need(statusOf(injected) == 400, "falhou")
    need(bodyOf(injected).indexOf("KCF119") >= 0, "falhou")
    var afterInjected = received[0]
    time.sleep(300)
    need(received[0] == afterInjected, "falhou")
    need(received[0].indexOf("evil.example.com") < 0, "falhou")

    // Hop-by-hop e tokens do Connection: chegam ao Edge, nunca ao servico.
    var withHop = rawExchange(httpPort, "POST / HTTP/1.1\r\nHost: " + host + "\r\nKeep-Alive: timeout=5\r\nUpgrade: websocket\r\nProxy-Authorization: Basic c2VjcmV0\r\nTE: trailers\r\nConnection: keep-alive, X-Private\r\nX-Private: v\r\nContent-Length: 2\r\n\r\nok")
    need(statusOf(withHop) == 200, "falhou")
    need(seenHead[0].indexOf("Keep-Alive") < 0, "falhou")
    need(seenHead[0].indexOf("Upgrade") < 0, "falhou")
    need(seenHead[0].indexOf("Proxy-Authorization") < 0, "falhou")
    need(seenHead[0].indexOf("X-Private") < 0, "falhou")
    need(seenHead[0].indexOf("Connection: close") >= 0, "falhou")

    // Caminho legitimo continua intacto — e a resposta ao CLIENTE tambem
    // passa pela sanitizacao: o keep-alive do servico local nao sobrevive.
    var normal = httpPostRaw(httpPort, "/", host, listOf<String>(), "ok")
    need(statusOf(normal) == 200, "falhou")
    need(received[0] == "ok", "falhou")
    need(bodyOf(normal) == "ok", "falhou")
    need(responseHeader(normal, "connection") == "close", "falhou")
    need(normal.indexOf("Keep-Alive") < 0, "falhou")

    // Resposta chunked do upstream: o cliente ve o corpo decodificado e
    // nenhum Transfer-Encoding (que e hop-by-hop).
    var chunkedResp = rawExchange(httpPort, "GET / HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n")
    need(statusOf(chunkedResp) == 200, "falhou")
    need(chunkedResp.toLowerCase().indexOf("transfer-encoding") < 0, "falhou")
    need(chunkedResp.indexOf("5\r\nhello") < 0, "falhou")
    need(bodyOf(chunkedResp) == "hello world", "falhou")
    need(responseHeader(chunkedResp, "connection") == "close", "falhou")

    // 204 com corpo: o cliente nao recebe os bytes nem um Content-Length falso.
    var noContent = rawExchange(httpPort, "HEAD / HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n")
    need(statusOf(noContent) == 204, "falhou")
    need(bodyOf(noContent) == "", "falhou")
    need(noContent.toLowerCase().indexOf("content-length") < 0, "falhou")

    // CL mentiroso do upstream: corpo real entregue e header reconciliado.
    var lied = rawExchange(httpPort, "PUT / HTTP/1.1\r\nHost: " + host + "\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
    need(statusOf(lied) == 200, "falhou")
    need(bodyOf(lied) == "ok", "falhou")
    need(responseHeader(lied, "content-length") == "2", "falhou")

    // Resposta nao-HTTP: 502 KCF131, sem ecoar os bytes do upstream.
    var garbage = rawExchange(httpPort, "DELETE / HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n")
    need(statusOf(garbage) == 502, "falhou")
    need(bodyOf(garbage).indexOf("KCF131") >= 0, "falhou")
    need(garbage.indexOf("payload-secreto") < 0, "falhou")
    need(garbage.indexOf("nao-vaza") < 0, "falhou")

    // 1xx intermediario: o cliente ve o status final e o corpo final.
    var interim = rawExchange(httpPort, "PATCH / HTTP/1.1\r\nHost: " + host + "\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok")
    need(statusOf(interim) == 200, "falhou")
    need(bodyOf(interim) == "ok", "falhou")
    need(interim.indexOf("100 Continue") < 0, "falhou")
    var badCounted = false
    var badWaits = 100
    while (badWaits > 0 && badCounted == false) {
        if (metricValue(observability.metrics(), "kofcloud_edge_http_upstream_errors_total_invalid_response") >= 1) {
            badCounted = true
        } else {
            time.sleep(50)
            badWaits = badWaits - 1
        }
    }
    need(badCounted, "falhou")

    writeTextTo(agentStop, "stop")
    time.sleep(1500)
    writeTextTo(edgeStop, "stop")
    time.sleep(1000)
    localListener.close()
    File(agentStop).delete()
    File(edgeStop).delete()
}

// Leitura do pedido em muitos blocos (F14 s3, parte ocupada antes por
// `bytesConcat`): o acumulador copiava tudo o que ja chegou a cada bloco lido,
// custo quadratico no numero de blocos — 1 MiB em blocos de 8 KiB custava
// ~4,8 s de CPU por conexao (medido em bench). Agora o buffer cresce com folga
// (`bytesGrown`). O teste manda um corpo de 512 KiB em blocos de 16 KiB por
// vez com pausa curta entre eles (para o SO nao coalescer num recebimento
// so) e prova que o servico local recebe os bytes EXATOS, na ordem, com o
// tamanho do Content-Length — o buffer com folga nunca entrega a area nao
// usada. Meio MiB e de proposito: o caminho LENTO (bytesConcat) levava
// ~1,2 s nele, compatível com o timeout; o MiB inteiro levava ~4,8 s.
test "framing: pedido grande em muitos blocos chega byte-exato ao servico", "framing-accum" {
    var localSvc = 19964
    var controlPort = 19965
    var tunnelPort = 19966
    var httpPort = 19967
    var bodySize = 512 * 1024
    var blockSize = 16384

    var received = new String[1]
    received[0] = ""
    var localListener = net.listen(localSvc)
    var localTask = spawn {
        var serving = true
        while (serving) {
            try {
                var peer = localListener.accept()
                var worker = spawn { captureLocal(peer, received, new String[1]) }
            } catch (String e) {
                serving = false
            }
        }
    }
    need(waitForPort(localSvc, 60), "falhou")

    var registry = Registry("/tmp/kofcloud-framing-acc-" + crypto.randomHex(4) + ".json")
    var edgeState = EdgeState(registry)
    var edgeStop = "/tmp/kofcloud-framing-acc-edge-" + crypto.randomHex(4) + ".txt"
    var agentStop = "/tmp/kofcloud-framing-acc-agent-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    File(agentStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, "", edgeStop) }
    // Teto de leitura acima do corpo e teto de politica igual ao default
    // (1 MiB, acima dos 512 KiB): quem acumula e a LEITURA, nao uma recusa
    // de tamanho em nenhuma das duas camadas.
    var httpTask = spawn { serveHttp(edgeState, httpPort, 4 * 1024 * 1024, edgeStop) }
    edgeState.setBodyLimit(1024 * 1024)
    need(waitForPort(controlPort, 60), "falhou")
    need(waitForPort(tunnelPort, 60), "falhou")
    need(waitForPort(httpPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var account = json.decode<Map<String, String>>(bodyOf(created))
    var accountToken = mapField(account, "token")
    var accountId = mapField(account, "accountId")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pubkey\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"" + intToString(localSvc) + "\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    need(statusOf(httpPostJson(controlPort, "/v1/services", pubBody, accountToken)) == 200, "falhou")

    var config = AgentConfig("http://127.0.0.1:" + intToString(controlPort), deviceId, accountId, accountToken, "", agentStop, "127.0.0.1", tunnelPort, 100)
    var agentTask = spawn { runAgent(config, true) }
    var online = false
    var attempts = 100
    while (attempts > 0 && online == false) {
        online = edgeState.isOnline(deviceId)
        if (online == false) {
            time.sleep(50)
            attempts = attempts - 1
        }
    }
    need(online, "falhou")

    // Corpo deterministico com bytes altos (>127) de proposito: a copia e de
    // BYTES, entao nem o buffer com folga nem o caminho do relay podem
    // reinterpretar como texto.
    var body = ""
    var i = 0
    while (i < bodySize) {
        body = body + ((i % 251) as Char)
        i = i + 1
    }
    var host = "site.mel.kofcloud.io"
    var conn = net.connect("127.0.0.1", httpPort)
    conn.send(bytesFromString("POST / HTTP/1.1\r\nHost: " + host + "\r\nContent-Length: " + intToString(bodySize) + "\r\nConnection: close\r\n\r\n"))
    var at = 0
    while (at < body.length) {
        var end = at + blockSize
        if (end > body.length) {
            end = body.length
        }
        conn.send(bytesFromString(body.substring(at, end)))
        at = end
        time.sleep(2)
    }
    var response = ""
    var reading = true
    while (reading) {
        var chunk = conn.receive(8192)
        if (chunk.length == 0) {
            reading = false
        } else {
            response = response + bytesToString(chunk)
        }
    }
    conn.close()
    need(statusOf(response) == 200, "falhou")
    need(received[0].length == bodySize, "falhou")
    need(received[0] == body, "falhou")

    writeTextTo(agentStop, "stop")
    time.sleep(1500)
    writeTextTo(edgeStop, "stop")
    time.sleep(1000)
    localListener.close()
    File(agentStop).delete()
    File(edgeStop).delete()
}
