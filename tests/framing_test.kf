import kofcloud.agent.Agent
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.edge.EdgeState
import kofcloud.edge.Http
import kofcloud.edge.HttpFront
import kofcloud.edge.Tunnel
import kofcloud.model.Errors
import kofcloud.util.Limits
import kofcloud.util.Text
import testkit.Support

// Enquadramento do corpo no Edge (RFC 9112 §6).
//
// O `Content-Length` e a fronteira do corpo que o Edge repassa ao servico
// local. Duas falhas medidas com o CLI 0.6.3:
//  * `999999999999` era lido com parseIntSafe e virava NEGATIVO (corpo
//    descartado em silencio); `4294967306` fazia wrap para 10 e o Edge
//    repassava 30 bytes com um header mentiroso — request smuggling.
//  * `Content-Length` duplicado divergente e `Transfer-Encoding` passavam
//    adiante (o servico local recebia uma fronteira que nao era a do Edge).
// Agora o valor e Long, e enquadramento ambiguo e recusado com 400 KCF118
// antes de rotear; bytes alem do declarado ficam fora do corpo relayado.

test "framing: Content-Length unico em Long, duplicado/TE invalidos", "framing-unit" {
    // Ausente = sem corpo.
    var none = parseContentLength(listOf<String>())
    assert(none.invalid == false && none.value == 0L, "sem header = 0")
    // Valor simples e espaco em volta.
    var plain = parseContentLength(listOf<String>("Host: x", "Content-Length: 42"))
    assert(plain.invalid == false && plain.value == 42L, "42")
    var spaced = parseContentLength(listOf<String>("content-length:   7  "))
    assert(spaced.invalid == false && spaced.value == 7L, "espacos")
    // Dois iguais sao aceitos (o RFC permite); divergentes sao smuggling.
    var equalDup = parseContentLength(listOf<String>("Content-Length: 7", "content-length: 7"))
    assert(equalDup.invalid == false && equalDup.value == 7L, "duplicado igual")
    var divergent = parseContentLength(listOf<String>("Content-Length: 3", "Content-Length: 4"))
    assert(divergent.invalid, "duplicado divergente invalido")
    // Nao numerico, vazio, sinal, hex, espaco interno.
    assert(parseContentLength(listOf<String>("Content-Length: abc")).invalid, "nao numerico")
    assert(parseContentLength(listOf<String>("Content-Length:")).invalid, "vazio")
    assert(parseContentLength(listOf<String>("Content-Length: -5")).invalid, "negativo")
    assert(parseContentLength(listOf<String>("Content-Length: +5")).invalid, "com sinal")
    assert(parseContentLength(listOf<String>("Content-Length: 0x10")).invalid, "hex")
    assert(parseContentLength(listOf<String>("Content-Length: 5 5")).invalid, "espaco interno")
    // Nome fora da forma canonica: o Edge nao reconheceria, alguns servidores
    // locais reconhecem — divergencia de fronteira.
    assert(parseContentLength(listOf<String>("Content-Length : 5")).invalid, "espaco antes dos dois pontos")
    assert(parseContentLength(listOf<String>("Content-Length")).invalid, "header sem valor")
    // Chunked nao e decodificado pelo Edge: o header inteiro e recusado.
    assert(parseContentLength(listOf<String>("Transfer-Encoding: chunked")).invalid, "transfer-encoding")
    assert(parseContentLength(listOf<String>("Transfer-Encoding: identity", "Content-Length: 4")).invalid, "TE mesmo com CL")
    // Acima de 2^31 continua valido como Long (nada de wrap/negativo).
    var huge = parseContentLength(listOf<String>("Content-Length: 4294967306"))
    assert(huge.invalid == false && huge.value == 4294967306L, "4294967306 sem wrap")
    var giant = parseContentLength(listOf<String>("Content-Length: 999999999999"))
    assert(giant.invalid == false && giant.value == 999999999999L, "999999999999 nao vira negativo")
    assert(giant.value > (limitMaxBodyBytes() as Long), "gigante acima do teto de leitura")
    // Codigo e Hint existem (R6).
    assert(errInvalidContentLength().indexOf("KCF118") >= 0, "codigo KCF118")
    assert(errHint(errInvalidContentLength()).indexOf("Content-Length") >= 0, "Hint explica o enquadramento")
}


test "framing: Host unico, nao vazio e sem caractere invalido", "framing-host-unit" {
    // Um Host normal passa.
    assert(hostIsUnambiguous(listOf<String>("Host: site.mel.kofcloud.io")), "um Host")
    assert(hostIsUnambiguous(listOf<String>("host: Site.Mel.KofCloud.IO:443", "X-Outro: 1")), "case/porta/outros headers")
    // Ausente, vazio, duplicado (mesmo igual) e caractere de controle: ambiguos.
    assert(hostIsUnambiguous(listOf<String>()) == false, "sem Host")
    assert(hostIsUnambiguous(listOf<String>("Host:")) == false, "Host vazio")
    assert(hostIsUnambiguous(listOf<String>("Host:   ")) == false, "Host so espacos")
    assert(hostIsUnambiguous(listOf<String>("Host: a.kofcloud.io", "Host: b.kofcloud.io")) == false, "duplicado divergente")
    assert(hostIsUnambiguous(listOf<String>("Host: a.kofcloud.io", "host: a.kofcloud.io")) == false, "duplicado igual tambem")
    // Espaco dentro do valor quebraria a linha ao reconstruir o pedido.
    assert(hostIsUnambiguous(listOf<String>("Host: a b.kofcloud.io")) == false, "espaco no valor")
    assert(hostIsUnambiguous(listOf<String>("Host: a.kofcloud.io\rX-Injected: 1")) == false, "controle no valor")
    // Header parecido nao conta como Host.
    assert(hostIsUnambiguous(listOf<String>("X-Host: a", "X-Host: b")) == false, "so headers parecidos = sem Host")
    assert(hostIsUnambiguous(listOf<String>("Host: a.kofcloud.io", "X-Host: b")) == true, "Host + parecido")
    // Codigo e Hint (R6).
    assert(errInvalidHost().indexOf("KCF119") >= 0, "codigo KCF119")
    assert(errHint(errInvalidHost()).indexOf("Host") >= 0, "Hint explica o Host")
}


test "framing: hop-by-hop e tokens do Connection nao atravessam o Edge", "framing-hop-unit" {
    // Hop-by-hop padrao: valem para a conexao cliente-Edge, nunca para a
    // conexao Edge-servico local. `proxy-authorization` e o caso caro: e
    // credencial de proxy e era repassada em claro ao servico.
    assert(headerIsForwarded("Keep-Alive: timeout=5", listOf<String>(), false) == false, "keep-alive")
    assert(headerIsForwarded("Proxy-Authorization: Basic x", listOf<String>(), false) == false, "proxy-authorization")
    assert(headerIsForwarded("Proxy-Authenticate: Basic", listOf<String>(), false) == false, "proxy-authenticate")
    assert(headerIsForwarded("Upgrade: websocket", listOf<String>(), false) == false, "upgrade")
    assert(headerIsForwarded("TE: trailers", listOf<String>(), false) == false, "te")
    assert(headerIsForwarded("Trailer: X-Sum", listOf<String>(), false) == false, "trailer")
    assert(headerIsForwarded("Connection: keep-alive", listOf<String>(), false) == false, "connection")
    assert(headerIsForwarded("Transfer-Encoding: chunked", listOf<String>(), false) == false, "transfer-encoding")
    // Tokens nomeados no Connection sao hop-by-hop por declaracao.
    var tokens = connectionTokens(listOf<String>("Connection: close, X-Private", "Connection: TE"))
    assert(tokens.contains("x-private") && tokens.contains("close") && tokens.contains("te"), "tokens normalizados")
    assert(headerIsForwarded("X-Private: v", tokens, false) == false, "token nomeado nao passa")
    // `X-Forwarded-For` do cliente e descartado (o Edge escreve o seu).
    assert(headerIsForwarded("X-Forwarded-For: 1.2.3.4", listOf<String>(), false) == false, "xff do cliente")
    // End-to-end continua passando.
    assert(headerIsForwarded("Host: site.mel.kofcloud.io", listOf<String>(), false), "host")
    assert(headerIsForwarded("Content-Type: application/json", listOf<String>(), false), "content-type")
    assert(headerIsForwarded("Cookie: a=1", listOf<String>(), false), "cookie")
    // Credenciais so caem em servico AUTHENTICATED (o Edge ja as consumiu).
    assert(headerIsForwarded("Authorization: Bearer x", listOf<String>(), false), "authorization em PUBLIC passa")
    assert(headerIsForwarded("Authorization: Bearer x", listOf<String>(), true) == false, "authorization em AUTHENTICATED cai")
    assert(headerIsForwarded("X-KofCloud-Token: kfc_x", listOf<String>(), true) == false, "token administrativo cai")
    // Reconstrucao real: o pedido que chega ao servico nao tem nenhum deles.
    var raw = bytesFromString("POST / HTTP/1.1\r\nHost: site.mel.kofcloud.io\r\nKeep-Alive: timeout=5\r\nUpgrade: websocket\r\nProxy-Authorization: Basic c2VjcmV0\r\nTE: trailers\r\nConnection: keep-alive, X-Private\r\nX-Private: v\r\nX-Forwarded-For: 1.2.3.4\r\nContent-Length: 2\r\n\r\nok")
    var out = bytesToString(serializeRequest(parseRequest(raw), "edge", false))
    assert(out.indexOf("Keep-Alive") < 0 && out.indexOf("Upgrade") < 0, "sem keep-alive/upgrade")
    assert(out.indexOf("Proxy-Authorization") < 0 && out.indexOf("TE:") < 0, "sem proxy-auth/TE")
    assert(out.indexOf("X-Private") < 0 && out.indexOf("1.2.3.4") < 0, "sem token nomeado nem xff do cliente")
    assert(out.indexOf("Host: site.mel.kofcloud.io") >= 0, "Host preservado")
    assert(out.indexOf("X-Forwarded-For: edge") >= 0, "Edge assina o seu XFF")
    assert(out.endsWith("ok"), "corpo intacto")
}


test "framing: resposta do upstream perde hop-by-hop e anuncia close", "framing-resp-unit" {
    // Upstream que anuncia keep-alive, hop-by-hop e um token nomeado: o
    // cliente veria "reuse esta conexao" para um socket que o Edge fecha.
    var upstream = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nConnection: keep-alive, X-Trace\r\nKeep-Alive: timeout=5\r\nX-Trace: abc\r\nProxy-Authenticate: Basic\r\nContent-Length: 2\r\n\r\nok"
    var out = bytesToString(sanitizeResponse(bytesFromString(upstream)))
    assert(statusOf(out) == 200, "status preservado")
    assert(out.indexOf("Keep-Alive") < 0, "sem Keep-Alive")
    assert(out.indexOf("X-Trace") < 0, "sem token nomeado no Connection")
    assert(out.indexOf("Proxy-Authenticate") < 0, "sem proxy-authenticate")
    assert(out.indexOf("Connection: close") >= 0, "Edge anuncia close")
    assert(out.indexOf("Content-Type: text/plain") >= 0, "header fim-a-fim preservado")
    assert(out.endsWith("\r\n\r\nok"), "corpo intacto e cabecalho refeito")
    // Sem `\r\n\r\n` (resposta crua) nada e inventado.
    var raw = "nao e http"
    assert(bytesToString(sanitizeResponse(bytesFromString(raw))) == raw, "crua volta intacta")
    // Resposta que ja esta correta nao muda de significado.
    var clean = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 2\r\n\r\nok"
    var cleanOut = bytesToString(sanitizeResponse(bytesFromString(clean)))
    assert(cleanOut.indexOf("Connection: close") >= 0, "close entra")
    assert(bodyOf(cleanOut) == "ok", "corpo preservado")
}


test "framing: resposta chunked do upstream e decodificada", "framing-chunked-unit" {
    // Transfer-Encoding e hop-by-hop: sai. Sem decodificar, o cliente
    // recebia o ENQUADRAMENTO como corpo ("5\r\nhello\r\n0") — medido.
    var one = decodeChunked(bytesFromString("5\r\nhello\r\n0\r\n\r\n"))
    assert(one.valid && bytesToString(one.body) == "hello", "chunk unico")
    var multi = decodeChunked(bytesFromString("2\r\nab\r\n3\r\ncde\r\n0\r\n\r\n"))
    assert(multi.valid && bytesToString(multi.body) == "abcde", "varios chunks")
    // Extensao de chunk (`;k=v`) e ignorada; CRLF final opcional.
    var ext = decodeChunked(bytesFromString("3;nome=valor\r\nabc\r\n0\r\n\r\n"))
    assert(ext.valid && bytesToString(ext.body) == "abc", "extensao ignorada")
    // Malformado: nao lanca, nao entra em laco — devolve o que deu e invalido.
    assert(decodeChunked(bytesFromString("zz\r\nabc\r\n")).valid == false, "tamanho nao hex")
    assert(decodeChunked(bytesFromString("9\r\nabc")).valid == false, "corpo curto")
    assert(decodeChunked(bytesFromString("")).valid == false, "vazio")
    // Hex em Long (reusa a tabela do WAF).
    assert(parseHexSafe("1a", -1L) == 26L, "hex minusculo")
    assert(parseHexSafe("FF", -1L) == 255L, "hex maiusculo")
    assert(parseHexSafe("x", -1L) == -1L, "invalido")
    // Resposta completa: header chunked sai, corpo decodificado, close entra.
    var upstream = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Type: text/plain\r\n\r\n5\r\nhello\r\n0\r\n\r\n"
    var out = bytesToString(sanitizeResponse(bytesFromString(upstream)))
    assert(out.toLowerCase().indexOf("transfer-encoding") < 0, "sem transfer-encoding")
    assert(out.indexOf("Connection: close") >= 0, "close do Edge")
    assert(out.indexOf("Content-Type: text/plain") >= 0, "header fim-a-fim preservado")
    assert(bodyOf(out) == "hello", "corpo decodificado, sem enquadramento")
    // Sem chunked, o corpo continua byte a byte (inclusive CRLF).
    var plain = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\na\r\nb"
    assert(bodyOf(bytesToString(sanitizeResponse(bytesFromString(plain)))) == "a\r\nb", "corpo cru intacto")
}


test "framing: 1xx/204/304 e HEAD nunca entregam corpo", "framing-status-unit" {
    // Codigo e regra puras.
    assert(statusCodeOf("HTTP/1.1 204 No Content") == 204, "codigo 204")
    assert(statusCodeOf("HTTP/1.0 304 Not Modified") == 304, "codigo 304")
    assert(statusCodeOf("HTTP/1.1 200 OK") == 200, "codigo 200")
    assert(statusCodeOf("lixo") == -1, "sem status")
    assert(statusCodeOf("HTTP/1.1 20 OK") == -1, "codigo de 2 digitos")
    assert(statusAllowsBody(200, "GET"), "200 GET tem corpo")
    assert(statusAllowsBody(404, "POST"), "404 tem corpo")
    assert(statusAllowsBody(200, "HEAD") == false, "HEAD sem corpo")
    assert(statusAllowsBody(204, "GET") == false, "204 sem corpo")
    assert(statusAllowsBody(304, "GET") == false, "304 sem corpo")
    assert(statusAllowsBody(100, "POST") == false, "1xx sem corpo")
    // 204/1xx perdem tambem o Content-Length; 304 e HEAD mantem (descrevem
    // a representacao do GET).
    var n204 = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 204 No Content\r\nContent-Length: 5\r\n\r\nhello"), "GET"))
    assert(bodyOf(n204) == "", "204 sem corpo")
    assert(n204.toLowerCase().indexOf("content-length") < 0, "204 sem Content-Length")
    var n100 = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 100 Continue\r\nContent-Length: 0\r\n\r\nx"), "POST"))
    assert(bodyOf(n100) == "" && n100.toLowerCase().indexOf("content-length") < 0, "1xx sem corpo nem CL")
    var n304 = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 304 Not Modified\r\nContent-Length: 3\r\nETag: x\r\n\r\nabc"), "GET"))
    assert(bodyOf(n304) == "", "304 sem corpo")
    assert(n304.indexOf("Content-Length: 3") >= 0 && n304.indexOf("ETag: x") >= 0, "304 mantem CL e ETag")
    var head = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok"), "HEAD"))
    assert(bodyOf(head) == "", "HEAD sem corpo")
    assert(head.indexOf("Content-Length: 2") >= 0, "HEAD mantem o CL do GET")
    // GET comum segue intacto.
    var get = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok"), "GET"))
    assert(bodyOf(get) == "ok", "GET preservado")
    // 204 chunked: decodifica e descarta (nunca vaza enquadramento).
    var chunk204 = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 204 No Content\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "GET"))
    assert(bodyOf(chunk204) == "", "204 chunked sem corpo")
    assert(chunk204.toLowerCase().indexOf("transfer-encoding") < 0, "204 chunked sem TE")
}


test "framing: Content-Length da resposta e reconciliado com o corpo real", "framing-resp-cl-unit" {
    // Medido: CL 2 com 7 bytes entregava os 7 (lixo no fim do stream) e
    // CL 100 com 2 bytes mantinha o header mentiroso.
    var over = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nokEXTRA"), "GET"))
    assert(bodyOf(over) == "ok", "excedente cortado no declarado")
    assert(responseHeader(over, "content-length") == "2", "CL do excedente inalterado")
    var under = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: 100\r\n\r\nok"), "GET"))
    assert(bodyOf(under) == "ok", "corpo curto intacto")
    assert(responseHeader(under, "content-length") == "2", "CL reescrito para o real")
    var exact = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok"), "GET"))
    assert(bodyOf(exact) == "ok" && responseHeader(exact, "content-length") == "2", "CL exato nao muda")
    // Sem CL o Edge nao inventa um: o close delimita (comportamento de antes).
    var noCl = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\nok"), "GET"))
    assert(bodyOf(noCl) == "ok", "sem CL o corpo passa")
    assert(noCl.toLowerCase().indexOf("content-length") < 0, "sem CL nao ganha CL")
    // HEAD e 304 mantem o CL original: descreve a representacao do GET.
    var head = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: 100\r\n\r\nok"), "HEAD"))
    assert(bodyOf(head) == "" && responseHeader(head, "content-length") == "100", "HEAD mantem CL e perde corpo")
    var n304 = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 304 Not Modified\r\nContent-Length: 3\r\n\r\nabc"), "GET"))
    assert(bodyOf(n304) == "" && responseHeader(n304, "content-length") == "3", "304 mantem CL")
    // Chunked decodificado ganha o CL do corpo decodificado.
    var chunk = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "GET"))
    assert(bodyOf(chunk) == "hello", "chunked decodificado")
    assert(chunk.toLowerCase().indexOf("transfer-encoding") < 0, "sem TE")
    // CL invalido do upstream nao vira corte nem header novo.
    var badCl = bytesToString(sanitizeResponse(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: abc\r\n\r\nok"), "GET"))
    assert(bodyOf(badCl) == "ok", "CL invalido nao corta")
}


test "framing: resposta nao-HTTP do upstream vira 502 KCF131", "framing-badresp-unit" {
    // Sem linha de status enquadravel o Edge entregava bytes crus ao cliente.
    assert(responseIsParseable(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")), "200 valido")
    assert(responseIsParseable(bytesFromString("HTTP/1.0 404 Not Found\r\n\r\n")), "404 sem corpo valido")
    assert(responseIsParseable(bytesFromString("GARBAGE RESPONSE\r\nX: y\r\n\r\npayload")) == false, "sem HTTP/")
    assert(responseIsParseable(bytesFromString("HTTP/1.1 XX OK\r\n\r\n")) == false, "codigo nao numerico")
    assert(responseIsParseable(bytesFromString("HTTP/1.1 999 Nope\r\n\r\n")) == false, "codigo fora de 100-599")
    assert(responseIsParseable(bytesFromString("HTTP/1.1 20 OK\r\n\r\n")) == false, "codigo de 2 digitos")
    assert(responseIsParseable(bytesFromString("nao e http")) == false, "sem terminador")
    assert(responseIsParseable(bytesFromString("")) == false, "vazio")
    // Codigo e Hint (R6).
    assert(errInvalidUpstreamResponse().indexOf("KCF131") >= 0, "codigo KCF131")
    assert(errHint(errInvalidUpstreamResponse()).indexOf("HTTP") >= 0, "Hint explica")
}

// Troca crua: manda os bytes e le ate o Edge fechar (Connection: close).
String rawExchange(Int port, String raw) {
    var conn = net.connect("127.0.0.1", port)
    conn.send(bytesFromString(raw))
    var out = ""
    var reading = true
    while (reading) {
        var chunk = conn.receive(8192)
        if (chunk.length == 0) {
            reading = false
        } else {
            out = out + bytesToString(chunk)
        }
    }
    conn.close()
    return out
}

Int metricValue(String exposition, String name) {
    for (var line in exposition.split("\n")) {
        var trimmed = line.trim()
        if (trimmed.startsWith(name + " ")) {
            return parseIntSafe(trimmed.substring(name.length + 1).trim(), -1)
        }
    }
    return -1
}

test "framing: enquadramento ambiguo vira 400 KCF118 e gigante vira 413", "framing" {
    var httpPort = 19958
    var registry = Registry("/tmp/kofcloud-framing-" + crypto.randomHex(4) + ".json")
    var edgeState = EdgeState(registry)
    var edgeStop = "/tmp/kofcloud-framing-edge-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    var httpTask = spawn { serveHttp(edgeState, httpPort, limitMaxBodyBytes(), edgeStop) }
    assert(waitForPort(httpPort, 60), "http no ar")

    var host = "x.kofcloud.io"
    // Duplicado divergente: 400 antes de rotear (sem rota, o desfecho
    // antigo seria 404). O corpo curto mantem o teste rapido em qualquer
    // implementacao.
    var dup = rawExchange(httpPort, "POST / HTTP/1.1\r\nHost: " + host + "\r\nContent-Length: 3\r\nContent-Length: 4\r\nConnection: close\r\n\r\nabcd")
    assert(statusOf(dup) == 400, "CL duplicado divergente -> 400 (recebido " + intToString(statusOf(dup)) + ")")
    assert(bodyOf(dup).indexOf("KCF118") >= 0, "KCF118 no corpo")

    // Transfer-Encoding: o Edge nao decodifica chunked; repassar o header
    // faria o servico local esperar um corpo que nunca chega.
    var chunked = rawExchange(httpPort, "POST / HTTP/1.1\r\nHost: " + host + "\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\nabcd")
    assert(statusOf(chunked) == 400, "chunked -> 400")
    assert(bodyOf(chunked).indexOf("KCF118") >= 0, "KCF118 no chunked")

    // Valor que fazia wrap em Int (4294967306 -> 10): agora e Long e cai no
    // teto de leitura/politica (413), nunca em 404 com corpo de 10 bytes.
    var wrapped = rawExchange(httpPort, "POST / HTTP/1.1\r\nHost: " + host + "\r\nContent-Length: 4294967306\r\nConnection: close\r\n\r\n0123456789LEFTOVERLEFTOVERLEFTOVER")
    assert(statusOf(wrapped) == 413, "CL 4294967306 -> 413 (sem wrap); recebido " + intToString(statusOf(wrapped)))
    assert(bodyOf(wrapped).indexOf("KCF110") >= 0, "KCF110 no corpo")

    // Valor que virava negativo: mesmo desfecho (413), nunca corpo descartado.
    var negative = rawExchange(httpPort, "POST / HTTP/1.1\r\nHost: " + host + "\r\nContent-Length: 999999999999\r\nConnection: close\r\n\r\nabcd")
    assert(statusOf(negative) == 413, "CL 999999999999 -> 413 (nao negativo)")
    assert(bodyOf(negative).indexOf("KCF110") >= 0, "KCF110 no corpo do gigante")

    // Enquadramento valido atravessa: sem rota, 404 opaco (nao 400/413).
    var plain = httpPostRaw(httpPort, "/", host, listOf<String>(), "ok")
    assert(statusOf(plain) == 404, "CL valido chega ao roteamento")

    // Conta por motivo, sem ecoar o valor do header.
    var counted = false
    var waits = 100
    while (waits > 0 && counted == false) {
        if (metricValue(observability.metrics(), "kofcloud_edge_http_denied_total_invalid_framing") >= 1) {
            counted = true
        } else {
            time.sleep(50)
            waits = waits - 1
        }
    }
    assert(counted, "recusa por enquadramento contada")

    // Host ambiguo: duplicado, ausente e com caractere invalido -> 400 KCF119
    // antes de rotear (sem rota, o desfecho antigo seria 404 — mas com dois
    // Host o Edge roteava pelo primeiro e repassava os dois ao servico).
    var dupHost = rawExchange(httpPort, "GET / HTTP/1.1\r\nHost: " + host + "\r\nHost: evil.example.com\r\nConnection: close\r\n\r\n")
    assert(statusOf(dupHost) == 400, "Host duplicado -> 400; recebido " + intToString(statusOf(dupHost)))
    assert(bodyOf(dupHost).indexOf("KCF119") >= 0, "KCF119 no duplicado")
    var noHost = rawExchange(httpPort, "GET / HTTP/1.1\r\nConnection: close\r\n\r\n")
    assert(statusOf(noHost) == 400, "Host ausente -> 400")
    assert(bodyOf(noHost).indexOf("KCF119") >= 0, "KCF119 no ausente")
    var badHost = rawExchange(httpPort, "GET / HTTP/1.1\r\nHost: " + host + "\r\nX-KofCloud-Token: a\r\nHost: " + host + "\r\nConnection: close\r\n\r\n")
    assert(statusOf(badHost) == 400, "Host repetido com header no meio -> 400")

    var hostCounted = false
    var hostWaits = 100
    while (hostWaits > 0 && hostCounted == false) {
        if (metricValue(observability.metrics(), "kofcloud_edge_http_denied_total_invalid_host") >= 1) {
            hostCounted = true
        } else {
            time.sleep(50)
            hostWaits = hostWaits - 1
        }
    }
    assert(hostCounted, "recusa por Host contada")

    writeTextTo(edgeStop, "stop")
    time.sleep(1000)
    File(edgeStop).delete()
}

// Servico local que anota exatamente o corpo recebido (nao o header).
void captureLocal(Conn peer, String[] body, String[] headOut) {
    var req = ""
    var headEnd = -1
    while (headEnd < 0) {
        var chunk = peer.receive(4096)
        if (chunk.length == 0) {
            peer.close()
            return
        }
        req = req + bytesToString(chunk)
        headEnd = req.indexOf("\r\n\r\n")
    }
    var head = req.substring(0, headEnd)
    var declared = parseContentLength(splitLines(head))
    var current = req.substring(headEnd + 4)
    var want = 0
    if (declared.invalid == false) {
        want = declared.value as Int
    }
    while (current.length < want) {
        var chunk = peer.receive(4096)
        if (chunk.length == 0) {
            break
        }
        current = current + bytesToString(chunk)
    }
    // A sonda de health do Agent tambem conecta aqui; so o POST e medido.
    if (head.indexOf("POST ") == 0) {
        headOut[0] = head
        body[0] = current
    }
    // Anuncia keep-alive de proposito: o Edge fecha a conexao publica sempre,
    // entao esse header nao pode chegar ao cliente.
    var resp = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nConnection: keep-alive\r\nKeep-Alive: timeout=5\r\nContent-Length: 2\r\n\r\nok"
    // GET responde CHUNKED (o POST continua fixo, e o que os asserts medem):
    // o cliente tem que receber o corpo decodificado, nunca o enquadramento.
    if (head.indexOf("GET ") == 0) {
        resp = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n"
    }
    // HEAD responde 204 COM corpo de proposito (servidor mal comportado): o
    // Edge nao pode entregar esses bytes ao cliente.
    if (head.indexOf("HEAD ") == 0) {
        resp = "HTTP/1.1 204 No Content\r\nContent-Length: 5\r\n\r\nhello"
    }
    // PUT responde com CL MENTIROSO (declara 100, manda 2): o cliente tem que
    // receber o corpo real e um CL que nao minta (o Edge delimita por close).
    if (head.indexOf("PUT ") == 0) {
        resp = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 100\r\n\r\nok"
    }
    // DELETE responde LIXO (sem linha de status): o Edge tem que recusar com
    // 502 em vez de repassar bytes que o cliente nao consegue interpretar.
    if (head.indexOf("DELETE ") == 0) {
        resp = "GARBAGE RESPONSE\r\nX-Debug: nao-vaza\r\n\r\npayload-secreto"
    }
    peer.send(bytesFromString(resp))
    peer.close()
}

test "framing: corpo relayado tem exatamente o tamanho declarado", "framing-relay" {
    var localSvc = 19960
    var controlPort = 19961
    var tunnelPort = 19962
    var httpPort = 19963
    // Corpo real 24 bytes, declarado 10: o excedente nao pode chegar ao
    // servico local nem virar a proxima requisicao.
    var malicious = "0123456789LEFTOVERLEFTOVER"

    var received = new String[1]
    received[0] = ""
    var seenHead = new String[1]
    seenHead[0] = ""
    var localListener = net.listen(localSvc)
    var localTask = spawn {
        var serving = true
        while (serving) {
            try {
                var peer = localListener.accept()
                var worker = spawn { captureLocal(peer, received, seenHead) }
            } catch (String e) {
                serving = false
            }
        }
    }
    assert(waitForPort(localSvc, 60), "servico local no ar")

    var registry = Registry("/tmp/kofcloud-framing-relay-" + crypto.randomHex(4) + ".json")
    var edgeState = EdgeState(registry)
    var edgeStop = "/tmp/kofcloud-framing-relay-edge-" + crypto.randomHex(4) + ".txt"
    var agentStop = "/tmp/kofcloud-framing-relay-agent-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    File(agentStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, "", edgeStop) }
    var httpTask = spawn { serveHttp(edgeState, httpPort, limitMaxBodyBytes(), edgeStop) }
    assert(waitForPort(controlPort, 60), "control no ar")
    assert(waitForPort(tunnelPort, 60), "tunel no ar")
    assert(waitForPort(httpPort, 60), "http no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var account = json.decode<Map<String, String>>(bodyOf(created))
    var accountToken = mapField(account, "token")
    var accountId = mapField(account, "accountId")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pubkey\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"" + intToString(localSvc) + "\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    assert(statusOf(httpPostJson(controlPort, "/v1/services", pubBody, accountToken)) == 200, "PUBLIC publicado")

    var config = AgentConfig("http://127.0.0.1:" + intToString(controlPort), deviceId, accountId, accountToken, "", agentStop, "127.0.0.1", tunnelPort, 100)
    var agentTask = spawn { runAgent(config, true) }
    var online = false
    var attempts = 100
    while (attempts > 0 && online == false) {
        online = edgeState.isOnline(deviceId)
        if (online == false) {
            time.sleep(50)
            attempts = attempts - 1
        }
    }
    assert(online, "agent online")

    var host = "site.mel.kofcloud.io"
    var smuggled = rawExchange(httpPort, "POST / HTTP/1.1\r\nHost: " + host + "\r\nContent-Length: 10\r\nConnection: close\r\n\r\n" + malicious)
    assert(statusOf(smuggled) == 200, "pedido entregue")
    assert(received[0].length == 10, "servico local recebe 10 bytes; recebeu " + intToString(received[0].length))
    assert(received[0] == "0123456789", "sem excedente no corpo")
    assert(received[0].indexOf("LEFTOVER") < 0, "bytes alem do declarado nao chegam ao servico")
    // O Host que roteou e o unico que a aplicacao ve.
    assert(seenHead[0].indexOf("Host: " + host) >= 0, "Host roteado chega ao servico")
    var hostLines = 0
    for (var line in seenHead[0].split("\n")) {
        if (line.trim().toLowerCase().startsWith("host:")) {
            hostLines = hostLines + 1
        }
    }
    assert(hostLines == 1, "servico local ve exatamente um Host; viu " + intToString(hostLines))

    // Host injetado nem chega ao relay: 400 KCF119 antes de abrir stream.
    var injected = rawExchange(httpPort, "POST / HTTP/1.1\r\nHost: " + host + "\r\nHost: evil.example.com\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok")
    assert(statusOf(injected) == 400, "Host duplicado -> 400; recebido " + intToString(statusOf(injected)))
    assert(bodyOf(injected).indexOf("KCF119") >= 0, "KCF119 no duplicado")
    var afterInjected = received[0]
    time.sleep(300)
    assert(received[0] == afterInjected, "pedido recusado nao chega ao servico local")
    assert(received[0].indexOf("evil.example.com") < 0, "Host injetado nunca chega a aplicacao")

    // Hop-by-hop e tokens do Connection: chegam ao Edge, nunca ao servico.
    var withHop = rawExchange(httpPort, "POST / HTTP/1.1\r\nHost: " + host + "\r\nKeep-Alive: timeout=5\r\nUpgrade: websocket\r\nProxy-Authorization: Basic c2VjcmV0\r\nTE: trailers\r\nConnection: keep-alive, X-Private\r\nX-Private: v\r\nContent-Length: 2\r\n\r\nok")
    assert(statusOf(withHop) == 200, "pedido com hop-by-hop e atendido")
    assert(seenHead[0].indexOf("Keep-Alive") < 0, "sem Keep-Alive no servico")
    assert(seenHead[0].indexOf("Upgrade") < 0, "sem Upgrade no servico")
    assert(seenHead[0].indexOf("Proxy-Authorization") < 0, "sem credencial de proxy no servico")
    assert(seenHead[0].indexOf("X-Private") < 0, "sem token nomeado no servico")
    assert(seenHead[0].indexOf("Connection: close") >= 0, "Edge escreve o seu Connection")

    // Caminho legitimo continua intacto — e a resposta ao CLIENTE tambem
    // passa pela sanitizacao: o keep-alive do servico local nao sobrevive.
    var normal = httpPostRaw(httpPort, "/", host, listOf<String>(), "ok")
    assert(statusOf(normal) == 200, "corpo normal entregue")
    assert(received[0] == "ok", "corpo normal chega inteiro")
    assert(bodyOf(normal) == "ok", "corpo do cliente preservado")
    assert(responseHeader(normal, "connection") == "close", "cliente recebe close; recebeu " + responseHeader(normal, "connection"))
    assert(normal.indexOf("Keep-Alive") < 0, "keep-alive do upstream nao chega ao cliente")

    // Resposta chunked do upstream: o cliente ve o corpo decodificado e
    // nenhum Transfer-Encoding (que e hop-by-hop).
    var chunkedResp = rawExchange(httpPort, "GET / HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n")
    assert(statusOf(chunkedResp) == 200, "chunked chega como 200")
    assert(chunkedResp.toLowerCase().indexOf("transfer-encoding") < 0, "sem Transfer-Encoding")
    assert(chunkedResp.indexOf("5\r\nhello") < 0, "sem enquadramento de chunk no corpo")
    assert(bodyOf(chunkedResp) == "hello world", "corpo decodificado; recebeu '" + bodyOf(chunkedResp) + "'")
    assert(responseHeader(chunkedResp, "connection") == "close", "close do Edge")

    // 204 com corpo: o cliente nao recebe os bytes nem um Content-Length falso.
    var noContent = rawExchange(httpPort, "HEAD / HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n")
    assert(statusOf(noContent) == 204, "204 chega; recebeu " + intToString(statusOf(noContent)))
    assert(bodyOf(noContent) == "", "204 sem corpo; recebeu '" + bodyOf(noContent) + "'")
    assert(noContent.toLowerCase().indexOf("content-length") < 0, "204 sem Content-Length")

    // CL mentiroso do upstream: corpo real entregue e header reconciliado.
    var lied = rawExchange(httpPort, "PUT / HTTP/1.1\r\nHost: " + host + "\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
    assert(statusOf(lied) == 200, "put atendido")
    assert(bodyOf(lied) == "ok", "corpo real entregue; recebeu '" + bodyOf(lied) + "'")
    assert(responseHeader(lied, "content-length") == "2", "CL reconciliado com o corpo real; recebeu " + responseHeader(lied, "content-length"))

    // Resposta nao-HTTP: 502 KCF131, sem ecoar os bytes do upstream.
    var garbage = rawExchange(httpPort, "DELETE / HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n")
    assert(statusOf(garbage) == 502, "lixo do upstream -> 502; recebeu " + intToString(statusOf(garbage)))
    assert(bodyOf(garbage).indexOf("KCF131") >= 0, "KCF131 no corpo")
    assert(garbage.indexOf("payload-secreto") < 0, "bytes do upstream nao vazam")
    assert(garbage.indexOf("nao-vaza") < 0, "headers do upstream nao vazam")
    var badCounted = false
    var badWaits = 100
    while (badWaits > 0 && badCounted == false) {
        if (metricValue(observability.metrics(), "kofcloud_edge_http_upstream_errors_total_invalid_response") >= 1) {
            badCounted = true
        } else {
            time.sleep(50)
            badWaits = badWaits - 1
        }
    }
    assert(badCounted, "resposta invalida contada")

    writeTextTo(agentStop, "stop")
    time.sleep(1500)
    writeTextTo(edgeStop, "stop")
    time.sleep(1000)
    localListener.close()
    File(agentStop).delete()
    File(edgeStop).delete()
}
