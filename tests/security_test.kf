import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.edge.EdgeState
import kofcloud.edge.HttpFront
import kofcloud.edge.Http
import kofcloud.edge.Tunnel
import kofcloud.store.Store
import testkit.Support

// Fase 19 slice 1 parcial: `/.well-known/security.txt` servido pelo Edge
// sem conta, sem tunel e sem tocar em servico local.

test "security: corpo estatico sem dado operacional", "security-unit" {
    var body = securityTxtBody()
    assert(body.indexOf("Contact:") >= 0, "tem contato")
    assert(body.indexOf("Policy:") >= 0, "tem politica")
    assert(body.indexOf("kfc_") < 0, "sem token")
    assert(body.indexOf("kfs_") < 0, "sem credencial")
    assert(body.indexOf("127.0.0.1") < 0, "sem endereco")
    var raw = bytesToString(securityTxtResponse())
    assert(statusOf(raw) == 200, "200 OK")
    assert(responseHeader(raw, "content-type") == "text/plain; charset=utf-8", "content-type texto")
    assert(raw.indexOf(body) >= 0, "corpo na resposta")
}

test "security: SECURITY.md existe com as secoes e o contato canonico", "security-policy" {
    // Trava do slice: o doc de politica nao pode apodrecer (sumir secao,
    // trocar o contato e divergir do security.txt que o Edge serve).
    // Caminho relativo ao repo: o runner usa a raiz como cwd (precedente:
    // os testes gravam /tmp absoluto; aqui le o doc versionado).
    var policy = readTextOr("docs/SECURITY.md", "")
    assert(policy.length > 0, "SECURITY.md existe e nao e vazio")
    assert(policy.indexOf("## O que é suportado") >= 0, "secao suportado")
    assert(policy.indexOf("## O que NÃO é suportado") >= 0, "secao nao-suportado")
    assert(policy.indexOf("## Como reportar") >= 0, "secao reporte")
    assert(policy.indexOf("## SLA de resposta") >= 0, "secao SLA")
    assert(policy.indexOf("## Escopo") >= 0, "secao escopo")
    assert(policy.indexOf("## Contenção (kill-switch documentado)") >= 0, "secao contencao")
    // O procedimento cita so comandos que existem (se um mudar de nome,
    // a trava quebra de proposito — kill-switch desatualizado e pior que
    // nenhum, porque o operador segue passo que nao funciona).
    assert(policy.indexOf("kof cloud freeze service") >= 0, "caminho rapido freeze")
    assert(policy.indexOf("kof cloud unfreeze service") >= 0, "caminho reversao")
    assert(policy.indexOf("kof cloud service suspend") >= 0, "passo suspend")
    assert(policy.indexOf("kof cloud service token-revoke") >= 0, "passo revoke")
    assert(policy.indexOf("kof cloud device suspend") >= 0, "passo device")
    assert(policy.indexOf("kof cloud disconnect") >= 0, "passo disconnect")
    assert(policy.indexOf("kof cloud doctor") >= 0, "passo confere")
    // Contato canonico unico: o mesmo do corpo servido pelo Edge.
    assert(policy.indexOf("security@kofcloud.local") >= 0, "contato no doc")
    assert(securityTxtBody().indexOf("security@kofcloud.local") >= 0, "contato no fio")
}

test "security: Edge serve sem conta, sem tunel e sem rate limit", "security" {
    var controlPort = 19731
    var tunnelPort = 19732
    var httpPort = 19733
    var registry = Registry("/tmp/kofcloud-sec-" + crypto.randomHex(4) + ".json")
    var edgeState = EdgeState(registry)
    var edgeStop = "/tmp/kofcloud-sec-edge-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, "", edgeStop) }
    var httpTask = spawn { serveHttp(edgeState, httpPort, 16777216, edgeStop) }
    assert(waitForPort(controlPort, 60), "control no ar")
    assert(waitForPort(httpPort, 60), "edge no ar")

    // Sem conta criada, sem tunel: qualquer Host devolve o security.txt.
    var first = httpGetRaw(httpPort, "/.well-known/security.txt", "inexistente.example.com")
    assert(statusOf(first) == 200, "200 sem conta: " + statusOf(first))
    assert(bodyOf(first).indexOf("Contact:") >= 0, "corpo com contato")
    assert(responseHeader(first, "content-type") == "text/plain; charset=utf-8", "content-type texto")

    // Query nao muda a rota da plataforma: mesmo caminho + "?x=1" tambem
    // serve o security.txt (antes caia no roteamento e devolvia 404).
    var withQuery = httpGetRaw(httpPort, "/.well-known/security.txt?x=1", "inexistente.example.com")
    assert(statusOf(withQuery) == 200, "query no security.txt: " + statusOf(withQuery))
    assert(bodyOf(withQuery).indexOf("Contact:") >= 0, "corpo com contato")

    // Nao e rota roteavel: host desconhecido em outro path segue 404 opaco.
    var missing = httpGetRaw(httpPort, "/nao-existe", "inexistente.example.com")
    assert(statusOf(missing) == 404, "outro path segue opaco: " + statusOf(missing))

    // Sem rate limit: 120 pedidos seguidos passam (o limite e 100/janela
    // por hostname — se o security.txt contasse, o 101o seria 429).
    var ok = true
    var i = 0
    while (i < 120 && ok) {
        var probe = httpGetRaw(httpPort, "/.well-known/security.txt", "scanner.example.com")
        if (statusOf(probe) != 200) {
            ok = false
        }
        i = i + 1
    }
    assert(ok, "120 pedidos sem 429 (fora do rate limit)")

    // Parada limpa (precedente: waf_body): o stopFile fecha o listener
    // do Edge; sem isso o accept travado so cede no --timeout do runner.
    writeTextTo(edgeStop, "stop")
    time.sleep(1000)
    File(edgeStop).delete()
}
