import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.model.Errors
import kofcloud.model.Incident
import kofcloud.model.Service
import kofcloud.store.Store
import testkit.Support

// Fase 17 slice 2 — contencao reversivel.
// freeze suspende o alvo, revoga as credenciais vivas e abre o incidente;
// unfreeze restaura EXATAMENTE o status anterior. Configuracao nunca some.

String freezePath(String name) {
    return "/tmp/kofcloud-freeze-" + name + "-" + crypto.randomHex(4) + ".json"
}

test "contencao: freeze de servico revoga credenciais e abre incidente", "freeze-unit" {
    var registry = Registry(freezePath("svc"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED", "", "")
    var token = registry.issueServiceToken(account.id, service.id, 24)

    var result = registry.freezeService(account.id, service.id)
    assert(result.ok, "congelou")
    assert(result.revoked == 1, "uma credencial revogada")
    assert(result.incidentId.length > 0, "incidente aberto")
    assert(registry.serviceByServiceToken(token) == null, "credencial nao vale mais")
    var after = registry.serviceById(service.id)
    assert(after != null, "servico ainda existe")
    if (after != null) {
        assert(after.status == "SUSPENDED", "suspenso (nao roteia)")
        assert(after.hostname == service.hostname, "config preservada")
    }
}

test "contencao: unfreeze restaura o status anterior", "freeze-unit" {
    var registry = Registry(freezePath("restore"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    registry.setServiceStatus(service.id, "ONLINE")

    registry.freezeService(account.id, service.id)
    var during = registry.serviceById(service.id)
    assert(during != null, "existe durante")
    if (during != null) {
        assert(during.status == "SUSPENDED", "congelado")
    }
    assert(registry.unfreezeService(account.id, service.id).restored, "descongelou")
    var restored = registry.serviceById(service.id)
    assert(restored != null, "existe")
    if (restored != null) {
        assert(restored.status == "ONLINE", "voltou ao status de antes do freeze")
    }
}

test "contencao: freeze de device cobre todos os servicos dele", "freeze-unit" {
    var registry = Registry(freezePath("dev"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var other = registry.registerDevice(account, "outro", "pk2")
    var a = registry.publishService(account, device.id, "a", "127.0.0.1", 8081, "http", "AUTHENTICATED", "", "")
    var b = registry.publishService(account, device.id, "b", "127.0.0.1", 8082, "http", "AUTHENTICATED", "", "")
    var untouched = registry.publishService(account, other.id, "c", "127.0.0.1", 8083, "http", "AUTHENTICATED", "", "")
    registry.issueServiceToken(account.id, a.id, 24)
    registry.issueServiceToken(account.id, b.id, 24)
    var keep = registry.issueServiceToken(account.id, untouched.id, 24)

    var result = registry.freezeDevice(account.id, device.id)
    assert(result.ok, "congelou o device")
    assert(result.revoked == 2, "revogou as duas do device")
    var frozenDevice = registry.deviceById(device.id)
    assert(frozenDevice != null, "device existe")
    if (frozenDevice != null) {
        assert(frozenDevice.status == "SUSPENDED", "device suspenso")
    }
    assert(registry.serviceByServiceToken(keep) != null, "credencial do outro device intacta")

    assert(registry.unfreezeDevice(account.id, device.id).restored, "descongelou")
    var active = registry.deviceById(device.id)
    assert(active != null, "device existe")
    if (active != null) {
        assert(active.status == "ACTIVE", "volta ativo")
    }
}

test "contencao: freeze de conta cobre devices, servicos e kfs_ e restaura cada status", "freeze-unit" {
    var registry = Registry(freezePath("acct"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var other = registry.createAccount("ana", "ana@e.com", "segredo")
    var nb = registry.registerDevice(account, "nb", "pk")
    var desk = registry.registerDevice(account, "desk", "pk2")
    var foreign = registry.registerDevice(other, "outro", "pk3")
    var a = registry.publishService(account, nb.id, "a", "127.0.0.1", 8081, "http", "AUTHENTICATED", "", "")
    var b = registry.publishService(account, desk.id, "b", "127.0.0.1", 8082, "http", "AUTHENTICATED", "", "")
    var foreignSvc = registry.publishService(other, foreign.id, "c", "127.0.0.1", 8083, "http", "PUBLIC", "", "")
    // Estado misto: um servico ja suspenso antes do freeze deve continuar
    // suspenso depois do unfreeze (restaura o status anterior de CADA alvo).
    registry.setServiceStatus(b.id, "SUSPENDED")
    var ta = registry.issueServiceToken(account.id, a.id, 24)
    var tb = registry.issueServiceToken(account.id, b.id, 24)
    var keep = registry.issueServiceToken(other.id, foreignSvc.id, 24)

    var result = registry.freezeAccount(account.id)
    assert(result.ok, "congelou a conta")
    assert(result.revoked == 2, "revogou as 2 kfs_ da conta")
    assert(result.incidentId.length > 0, "incidente da conta aberto")
    assert(registry.serviceByServiceToken(ta) == null, "kfs_ de a revogada")
    assert(registry.serviceByServiceToken(tb) == null, "kfs_ de b revogada")
    assert(registry.serviceByServiceToken(keep) != null, "kfs_ de outra conta intacta")

    var frozenNb = registry.deviceById(nb.id)
    var frozenDesk = registry.deviceById(desk.id)
    if (frozenNb != null) {
        assert(frozenNb.status == "SUSPENDED", "device nb suspenso")
    }
    if (frozenDesk != null) {
        assert(frozenDesk.status == "SUSPENDED", "device desk suspenso")
    }
    var frozenA = registry.serviceById(a.id)
    var frozenB = registry.serviceById(b.id)
    if (frozenA != null) {
        assert(frozenA.status == "SUSPENDED", "servico a suspenso")
    }
    if (frozenB != null) {
        assert(frozenB.status == "SUSPENDED", "servico b suspenso")
    }
    var foreignDevice = registry.deviceById(foreign.id)
    if (foreignDevice != null) {
        assert(foreignDevice.status == "ACTIVE", "device de outra conta intacto")
    }
    // Nada da conta roteia enquanto congelada.
    assert(registry.resolveRoute(a.hostname) == null, "hostname de a sem rota")
    assert(registry.resolveRoute(b.hostname) == null, "hostname de b sem rota")

    assert(registry.unfreezeAccount(account.id).restored, "descongelou a conta")
    var backNb = registry.deviceById(nb.id)
    var backDesk = registry.deviceById(desk.id)
    if (backNb != null) {
        assert(backNb.status == "ACTIVE", "nb volta ACTIVE")
    }
    if (backDesk != null) {
        assert(backDesk.status == "ACTIVE", "desk volta ACTIVE")
    }
    var backA = registry.serviceById(a.id)
    var backB = registry.serviceById(b.id)
    if (backA != null) {
        assert(statusIsRoutable(backA.status), "a volta a rotear (" + backA.status + ")")
    }
    if (backB != null) {
        assert(backB.status == "SUSPENDED", "b volta ao SUSPENDED que ja tinha (" + backB.status + ")")
    }
    assert(registry.resolveRoute(a.hostname) != null, "hostname de a roteia de novo")
    // Configuracao preservada.
    if (backA != null) {
        assert(backA.hostname == a.hostname, "hostname intacto")
        assert(backA.allowMethods == a.allowMethods, "allowlist intacta")
    }
}

test "contencao: freeze de conta e idempotente na auditoria e no incidente", "freeze-unit" {
    var registry = Registry(freezePath("acctidem"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")

    var first = registry.freezeAccount(account.id)
    var second = registry.freezeAccount(account.id)
    assert(first.ok, "primeiro freeze ok")
    assert(second.ok, "segundo freeze ok (idempotente na acao)")
    // `raiseIncident` nao duplica: o segundo freeze nao abre outro e por isso
    // devolve incidentId vazio (mesmo contrato do freeze de service/device).
    assert(first.incidentId.length > 0, "primeiro abre incidente")
    assert(second.incidentId == "", "segundo nao abre incidente novo")
    var frozen = 0
    for (var incident in registry.incidentsForAccount(account.id, false)) {
        if (incident.kind == incidentFreezeAccount() && incident.resolvedAt == 0) {
            frozen = frozen + 1
        }
    }
    assert(frozen == 1, "um incidente aberto de freeze_account")
    assert(registry.unfreezeAccount(account.id).restored, "unfreeze")
    var after = registry.serviceById(service.id)
    if (after != null) {
        assert(statusIsRoutable(after.status), "servico volta a rotear")
    }
}

test "contencao: alvo alheio nao congela", "freeze-unit" {
    var registry = Registry(freezePath("owner"))
    var mel = registry.createAccount("mel", "mel@e.com", "segredo")
    var ana = registry.createAccount("ana", "ana@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    assert(registry.freezeService(ana.id, service.id).ok == false, "servico alheio recusado")
    assert(registry.freezeDevice(ana.id, device.id).ok == false, "device alheio recusado")
    assert(registry.unfreezeService(ana.id, service.id).ok == false, "unfreeze alheio recusado")
}

test "contencao: codigos KCF126/KCF127/KCF128 com Hint", "freeze-unit" {
    assert(errTargetRequired().indexOf("KCF126") >= 0, "KCF126")
    assert(errInvalidTarget().indexOf("KCF127") >= 0, "KCF127")
    assert(errTargetNotFound().indexOf("KCF128") >= 0, "KCF128")
    assert(errHint(errTargetRequired()).length > 0, "Hint 126")
    assert(errHint(errInvalidTarget()).length > 0, "Hint 127")
    assert(errHint(errTargetNotFound()).length > 0, "Hint 128")
}

test "contencao: HTTP freeze/unfreeze e incidente listado", "freeze" {
    var controlPort = 19871
    var registry = Registry(freezePath("http"))
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var accountToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"AUTHENTICATED\"}"
    var published = httpPostJson(controlPort, "/v1/services", pubBody, accountToken)
    var serviceId = mapField(json.decode<Map<String, String>>(bodyOf(published)), "id")

    var freezeBody = "{\"target\":\"service\",\"id\":\"" + serviceId + "\"}"
    var frozen = httpPostJson(controlPort, "/v1/freeze", freezeBody, accountToken)
    assert(statusOf(frozen) == 200, "freeze 200")
    var result = json.decode<Map<String, String>>(bodyOf(frozen))
    assert(mapField(result, "incidentId").length > 0, "incidente devolvido")

    var listed = httpPostJson(controlPort, "/v1/incidents", "{}", accountToken)
    assert(bodyOf(listed).indexOf("freeze_service") >= 0, "incidente de contencao na lista")

    var unfrozen = httpPostJson(controlPort, "/v1/unfreeze", freezeBody, accountToken)
    assert(statusOf(unfrozen) == 200, "unfreeze 200")

    // Validacoes.
    assert(statusOf(httpPostJson(controlPort, "/v1/freeze", "{\"target\":\"service\"}", accountToken)) == 400, "sem id 400")
    assert(statusOf(httpPostJson(controlPort, "/v1/freeze", "{\"target\":\"edge\",\"id\":\"x\"}", accountToken)) == 400, "alvo invalido 400")
    assert(statusOf(httpPostJson(controlPort, "/v1/freeze", "{\"target\":\"service\",\"id\":\"naoexiste\"}", accountToken)) == 404, "inexistente 404")

    // Alvo `account`: sem id (o token decide a conta). Congela os devices e
    // servicos do dono, abre o incidente e restaura no unfreeze.
    var acctFreeze = httpPostJson(controlPort, "/v1/freeze", "{\"target\":\"account\"}", accountToken)
    assert(statusOf(acctFreeze) == 200, "freeze account 200")
    var acctResult = json.decode<Map<String, String>>(bodyOf(acctFreeze))
    assert(mapField(acctResult, "incidentId").length > 0, "incidente da conta devolvido")
    var acctListed = httpPostJson(controlPort, "/v1/incidents", "{}", accountToken)
    assert(bodyOf(acctListed).indexOf("freeze_account") >= 0, "incidente freeze_account listado")
    var acctUnfreeze = httpPostJson(controlPort, "/v1/unfreeze", "{\"target\":\"account\"}", accountToken)
    assert(statusOf(acctUnfreeze) == 200, "unfreeze account 200")
    // Idempotente no ESTADO (nada quebra), nao na resposta: o segundo
    // unfreeze nao tem nada a reverter, entao 409 KCF141 e a verdade. Antes
    // respondia 200 e "restaurava" um status que ninguem tinha congelado.
    var again = httpPostJson(controlPort, "/v1/unfreeze", "{\"target\":\"account\"}", accountToken)
    assert(statusOf(again) == 409, "segundo unfreeze: 409 (nada a reverter)")
    assert(bodyOf(again).indexOf("KCF141") >= 0, "KCF141 no corpo")
}
test "contencao: unfreeze de alvo nao congelado nao apaga suspensao", "freeze-unit" {
    // Medido: sem marca de freeze, `unfreezeService` gravava UNKNOWN e
    // `unfreezeDevice` gravava ACTIVE — apagando uma SUSPENSAO deliberada do
    // operador — e o CLI dizia "status anterior restaurado". Nada foi
    // congelado: nao ha anterior para restaurar.
    var registry = Registry(freezePath("notfrozen"))
    var mel = registry.createAccount("mel", "mel@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")

    // Suspensao deliberada (NAO e freeze).
    assert(registry.suspendDevice(mel.id, device.id), "suspende device")
    assert(registry.suspendService(mel.id, service.id), "suspende servico")

    var svcOutcome = registry.unfreezeService(mel.id, service.id)
    assert(svcOutcome.ok, "alvo existe e e do dono")
    assert(svcOutcome.restored == false, "nada a reverter")
    var devOutcome = registry.unfreezeDevice(mel.id, device.id)
    assert(devOutcome.ok, "device existe")
    assert(devOutcome.restored == false, "nada a reverter (device)")

    // O status continua exatamente onde o operador deixou.
    var svcAfter = registry.serviceById(service.id)
    assert(svcAfter != null, "servico existe")
    if (svcAfter != null) {
        assert(svcAfter.status == "SUSPENDED", "suspensao preservada: " + svcAfter.status)
    }
    var devAfter = registry.deviceById(device.id)
    assert(devAfter != null, "device existe")
    if (devAfter != null) {
        assert(devAfter.status == "SUSPENDED", "device segue suspenso: " + devAfter.status)
    }
    // Sem auditoria falsa de unfreeze.
    var unfreezes = registry.auditCountSince(mel.id, "service.unsuspended", 0)
    assert(unfreezes == 0, "nada auditado como unfreeze")

    // Conta sem freeze em curso: idem.
    assert(registry.unfreezeAccount(mel.id).restored == false, "conta sem congelados")
    var devStill = registry.deviceById(device.id)
    if (devStill != null) {
        assert(devStill.status == "SUSPENDED", "conta nao mexeu no suspenso")
    }

    // Alvo inexistente segue sendo outra falha (ok=false -> 404).
    assert(registry.unfreezeService(mel.id, "fantasma").ok == false, "inexistente: ok=false")
    assert(registry.unfreezeDevice(mel.id, "fantasma").ok == false, "device inexistente: ok=false")
}

test "contencao: HTTP unfreeze de nao congelado e 409 (nao 200)", "freeze" {
    var controlPort = 19861
    var registry = Registry(freezePath("http-notfrozen"))
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control no ar")
    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var dev = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", token)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(dev)), "deviceId")
    var pub = httpPostJson(controlPort, "/v1/services", "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}", token)
    var serviceId = mapField(json.decode<Map<String, String>>(bodyOf(pub)), "id")

    // Suspensao deliberada e SEM freeze: unfreeze recusa em vez de "restaurar".
    assert(statusOf(httpPostJson(controlPort, "/v1/services/suspend", "{\"serviceId\":\"" + serviceId + "\"}", token)) == 200, "suspenso")
    var notFrozen = httpPostJson(controlPort, "/v1/unfreeze", "{\"target\":\"service\",\"id\":\"" + serviceId + "\"}", token)
    assert(statusOf(notFrozen) == 409, "409: " + intToString(statusOf(notFrozen)))
    assert(bodyOf(notFrozen).indexOf("KCF141") >= 0, "corpo KCF141")
    var still = registry.serviceById(serviceId)
    if (still != null) {
        assert(still.status == "SUSPENDED", "suspensao preservada")
    }

    // Freeze de verdade e depois unfreeze: 200 e restaura.
    assert(statusOf(httpPostJson(controlPort, "/v1/freeze", "{\"target\":\"service\",\"id\":\"" + serviceId + "\"}", token)) == 200, "congelou")
    assert(statusOf(httpPostJson(controlPort, "/v1/unfreeze", "{\"target\":\"service\",\"id\":\"" + serviceId + "\"}", token)) == 200, "descongelou")
    var back = registry.serviceById(serviceId)
    if (back != null) {
        assert(back.status == "SUSPENDED", "voltou ao status anterior ao freeze (suspenso): " + back.status)
    }

    // Inexistente continua 404 opaco.
    var ghost = httpPostJson(controlPort, "/v1/unfreeze", "{\"target\":\"service\",\"id\":\"fantasma\"}", token)
    assert(statusOf(ghost) == 404, "inexistente 404")
}
