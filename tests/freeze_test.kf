import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.model.Errors
import kofcloud.model.Incident
import kofcloud.model.Service
import kofcloud.store.Store
import kofcloud.util.Limits
import testkit.Support

// Fase 17 slice 2 — contencao reversivel.
// freeze suspende o alvo, revoga as credenciais vivas e abre o incidente;
// unfreeze restaura EXATAMENTE o status anterior. Configuracao nunca some.

String freezePath(String name) {
    return "/tmp/kofcloud-freeze-" + name + "-" + crypto.randomHex(4) + ".json"
}

test "contencao: freeze de servico revoga credenciais e abre incidente", "freeze-unit" {
    var registry = Registry(freezePath("svc"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED", "", "")
    var token = registry.issueServiceToken(account.id, service.id, 24)

    var result = registry.freezeService(account.id, service.id)
    need(result.ok, "falhou")
    need(result.revoked == 1, "falhou")
    need(result.incidentId.length > 0, "falhou")
    need(registry.serviceByServiceToken(token) == null, "falhou")
    var after = registry.serviceById(service.id)
    need(after != null, "falhou")
    if (after != null) {
        need(after.status == "SUSPENDED", "falhou")
        need(after.hostname == service.hostname, "falhou")
    }
}

test "contencao: unfreeze restaura o status anterior", "freeze-unit" {
    var registry = Registry(freezePath("restore"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    registry.setServiceStatus(service.id, "ONLINE")

    // Cruzamento unfreeze × credencial: o freeze revoga (morte anunciada no
    // `revoked`), mas o unfreeze devolve SÓ o status — nunca ressuscita nem
    // reemite credencial. Overlap vivo antes do freeze (uma sem TTL, outra
    // com TTL): as duas morrem no freeze e seguem mortas depois do unfreeze.
    var k1 = registry.issueServiceToken(account.id, service.id)
    var k2 = registry.issueServiceToken(account.id, service.id, 24)
    need(registry.pendingRotationCount(service.id) == 2, "falhou")

    var frozen = registry.freezeService(account.id, service.id)
    need(frozen.ok, "falhou")
    need(frozen.revoked == 2, "falhou")
    need(registry.serviceByServiceToken(k1) == null, "falhou")
    need(registry.serviceByServiceToken(k2) == null, "falhou")
    var during = registry.serviceById(service.id)
    need(during != null, "falhou")
    if (during != null) {
        need(during.status == "SUSPENDED", "falhou")
    }
    need(registry.unfreezeService(account.id, service.id).restored, "falhou")
    var restored = registry.serviceById(service.id)
    need(restored != null, "falhou")
    if (restored != null) {
        need(restored.status == "ONLINE", "falhou")
    }
    // Unfreeze devolve o status, NÃO a credencial: voltar a rotear com a
    // kfs_ antiga valendo faria o containment mentir (o `revoked` do freeze
    // disse que morreram). Reemitir é decisão de `service rotate`.
    need(registry.serviceByServiceToken(k1) == null, "falhou")
    need(registry.serviceByServiceToken(k2) == null, "falhou")
    need(registry.pendingRotationCount(service.id) == 0, "falhou")
    // Cruzamento suspensao-previa × freeze: um serviço que JA estava
    // SUSPENDED (decisão administrativa, não freeze) antes do ciclo tem o
    // SUSPENDED como "anterior" — o unfreeze devolve SUSPENDED, nunca um
    // status operacional. Reverter para ONLINE ressuscitaria a rota que o
    // operador mandou derrubar.
    var registry2 = Registry(freezePath("restore-susp"))
    var account2 = registry2.createAccount("mel", "m@e.com", "segredo")
    var device2 = registry2.registerDevice(account2, "nb2", "pk2")
    var service2 = registry2.publishService(account2, device2.id, "api", "127.0.0.1", 8081, "http", "PUBLIC", "", "")
    need(registry2.suspendService(account2.id, service2.id), "falhou")
    need(registry2.freezeService(account2.id, service2.id).ok, "falhou")
    need(registry2.unfreezeService(account2.id, service2.id).restored, "falhou")
    var back2 = registry2.serviceById(service2.id)
    need(back2 != null, "falhou")
    if (back2 != null) {
        need(back2.status == "SUSPENDED", "falhou")
        need(registry2.resolveRoute(back2.hostname) == null, "falhou")
    }
}

test "contencao: marcas de freeze sobrevivem ao restart", "freeze-unit" {
    // Medido (17-limitations): as marcas viviam so em memoria — reiniciar o
    // control plane fazia o unfreeze responder 409 KCF141 (nada a reverter)
    // em vez de restaurar o status anterior. Agora elas viajam no arquivo
    // de estado: carregar o mesmo path num registry novo mantem a
    // reversibilidade.
    var path = freezePath("restart")
    var registry = Registry(path)
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    registry.setServiceStatus(service.id, "ONLINE")
    // Device segue caminho proprio para cobrir os dois formatos de chave.
    var other = registry.registerDevice(account, "outro", "pk2")
    registry.setDeviceStatus(account.id, other.id, "DEGRADED", "")

    registry.freezeService(account.id, service.id)
    registry.freezeDevice(account.id, other.id)

    // Restart: registry novo sobre o MESMO arquivo.
    var reloaded = Registry(path)
    need(reloaded.loadStatus == "ok", "falhou")
    need(reloaded.unfreezeService(account.id, service.id).restored, "falhou")
    var restored = reloaded.serviceById(service.id)
    need(restored != null, "falhou")
    if (restored != null) {
        need(restored.status == "ONLINE", "falhou")
    }
    need(reloaded.unfreezeDevice(account.id, other.id).restored, "falhou")
    var devBack = reloaded.deviceById(other.id)
    if (devBack != null) {
        need(devBack.status == "DEGRADED", "falhou")
    }
    // E a marca sai do disco: unfreeze repetido nao restaura mais nada.
    need(reloaded.unfreezeService(account.id, service.id).restored == false, "falhou")
    need(reloaded.frozenMarks().size == 0, "falhou")

    // Estado antigo (sem a chave freezeMarks) carrega sem quebrar: decode
    // de campo de lista ausente no topo devolve lista vazia — a mesma regra
    // que trouxe `incidents`/`webhooks` sem migrar estados anteriores.
    var legacyPath = freezePath("legacy")
    writeTextTo(legacyPath, "{\"accounts\":[],\"devices\":[],\"services\":[],\"tokens\":[],\"serviceTokens\":[],\"customDomains\":[],\"audit\":[],\"incidents\":[],\"webhooks\":[]}")
    var legacy = Registry(legacyPath)
    need(legacy.loadStatus == "ok", "falhou")
    need(legacy.frozenMarks().size == 0, "falhou")
}

test "contencao: remover alvo congelado poda a marca", "freeze-unit" {
    // Medido (17-limitations): a marca de um alvo removido congelado ficava
    // orfa no arquivo para sempre. Ids (uuid) nunca se repetem, entao a
    // marca de um id que saiu nao serve para nada: remocao de servico e
    // revoke de device levam a marca embora.
    var path = freezePath("prune")
    var registry = Registry(path)
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var a = registry.publishService(account, device.id, "a", "127.0.0.1", 8081, "http", "PUBLIC", "", "")
    var b = registry.publishService(account, device.id, "b", "127.0.0.1", 8082, "http", "PUBLIC", "", "")
    registry.freezeService(account.id, a.id)
    registry.freezeService(account.id, b.id)
    registry.freezeDevice(account.id, device.id)
    need(registry.frozenMarks().size == 3, "falhou")

    // Remover um servico congelado leva a marca dele embora.
    need(registry.removeService(account.id, a.id), "falhou")
    need(registry.frozenMarks().size == 2, "falhou")

    // Revoke e terminal: a marca do device sai junto com a dos servicos
    // que o revoke remove (removeServicesOfDevice).
    need(registry.revokeDevice(account.id, device.id), "falhou")
    need(registry.frozenMarks().size == 0, "falhou")

    // A poda persiste no arquivo: reload nao ressuscita marcas.
    var reloaded = Registry(path)
    need(reloaded.frozenMarks().size == 0, "falhou")

    // Unfreeze de alvo sem marca segue a semantica honesta: servico removido
    // e 404. Device revogado existe, mas REVOKED e terminal nos dois
    // sentidos: o unfreeze recusa com KCF023 (antes dizia ok/restored).
    need(registry.unfreezeService(account.id, a.id).ok == false, "falhou")
    var refused = false
    var code = ""
    try {
        registry.unfreezeDevice(account.id, device.id)
    } catch (String e) {
        refused = true
        code = e
    }
    need(refused, "falhou")
    need(code.indexOf("KCF023") >= 0, "falhou")
}

test "contencao: credencial de device terminal poda no load", "freeze-unit" {
    // Estado sintetico do RESIDUO anterior as recusas: servico ainda existe,
    // device dele REVOKED e credencial kfs_ apontando para o par. Antes a
    // credencial autenticava para sempre um servico cuja rota nunca volta —
    // ids (uuid) nao se repetem, manter serve para nada. A poda roda na
    // carga e em toda remocao (fail-closed de higiene).
    var legacyPath = freezePath("legacy-token")
    var morta = crypto.sha256("kfs_morta")
    var viva = crypto.sha256("kfs_viva")
    var state = "{\"accounts\":[{\"id\":\"acc-x\",\"handle\":\"mel\",\"email\":\"m@e.com\",\"passwordHash\":\"h\",\"createdAt\":0}],"
    state = state + "\"devices\":["
    state = state + "{\"id\":\"d1\",\"accountId\":\"acc-x\",\"name\":\"morto\",\"publicKey\":\"pk\",\"status\":\"REVOKED\",\"lastSeenAt\":0,\"createdAt\":0},"
    state = state + "{\"id\":\"d2\",\"accountId\":\"acc-x\",\"name\":\"vivo\",\"publicKey\":\"pk2\",\"status\":\"ACTIVE\",\"lastSeenAt\":0,\"createdAt\":0}],"
    state = state + "\"services\":["
    state = state + "{\"id\":\"s1\",\"accountId\":\"acc-x\",\"deviceId\":\"d1\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":8081,\"protocol\":\"http\",\"hostname\":\"site.mel.kofcloud.io\",\"exposure\":\"PUBLIC\",\"status\":\"SUSPENDED\",\"createdAt\":0,\"allowMethods\":\"\",\"allowPaths\":\"\"},"
    state = state + "{\"id\":\"s2\",\"accountId\":\"acc-x\",\"deviceId\":\"d2\",\"name\":\"outro\",\"localAddress\":\"127.0.0.1\",\"localPort\":8082,\"protocol\":\"http\",\"hostname\":\"outro.mel.kofcloud.io\",\"exposure\":\"PUBLIC\",\"status\":\"ONLINE\",\"createdAt\":0,\"allowMethods\":\"\",\"allowPaths\":\"\"}],"
    state = state + "\"tokens\":[],"
    state = state + "\"serviceTokens\":["
    state = state + "{\"serviceId\":\"s1\",\"accountId\":\"acc-x\",\"tokenHash\":\"" + morta + "\",\"createdAt\":0,\"expiresAt\":9999999999999},"
    state = state + "{\"serviceId\":\"s2\",\"accountId\":\"acc-x\",\"tokenHash\":\"" + viva + "\",\"createdAt\":0,\"expiresAt\":9999999999999}],"
    state = state + "\"customDomains\":[],\"audit\":[],\"incidents\":[],\"webhooks\":[],\"freezeMarks\":[]}"
    writeTextTo(legacyPath, state)
    var registry = Registry(legacyPath)
    need(registry.loadStatus == "ok", "falhou")

    // A credencial do par terminal morre na carga; a do vivo vale.
    need(registry.serviceByServiceToken("kfs_morta") == null, "falhou")
    var live = registry.serviceByServiceToken("kfs_viva")
    need(live != null, "falhou")
    if (live != null) {
        need(live.id == "s2", "falhou")
    }

    // Idempotente: nova carga nao ressuscita nem abre mais nada.
    var again = Registry(legacyPath)
    need(again.loadStatus == "ok", "falhou")
    need(again.serviceByServiceToken("kfs_morta") == null, "falhou")
    need(again.serviceByServiceToken("kfs_viva") != null, "falhou")
}

test "contencao: freeze de device cobre todos os servicos dele", "freeze-unit" {
    var registry = Registry(freezePath("dev"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var other = registry.registerDevice(account, "outro", "pk2")
    var a = registry.publishService(account, device.id, "a", "127.0.0.1", 8081, "http", "AUTHENTICATED", "", "")
    var b = registry.publishService(account, device.id, "b", "127.0.0.1", 8082, "http", "AUTHENTICATED", "", "")
    var untouched = registry.publishService(account, other.id, "c", "127.0.0.1", 8083, "http", "AUTHENTICATED", "", "")
    registry.issueServiceToken(account.id, a.id, 24)
    registry.issueServiceToken(account.id, b.id, 24)
    var keep = registry.issueServiceToken(account.id, untouched.id, 24)

    var result = registry.freezeDevice(account.id, device.id)
    need(result.ok, "falhou")
    need(result.revoked == 2, "falhou")
    var frozenDevice = registry.deviceById(device.id)
    need(frozenDevice != null, "falhou")
    if (frozenDevice != null) {
        need(frozenDevice.status == "SUSPENDED", "falhou")
    }
    need(registry.serviceByServiceToken(keep) != null, "falhou")

    need(registry.unfreezeDevice(account.id, device.id).restored, "falhou")
    var active = registry.deviceById(device.id)
    need(active != null, "falhou")
    if (active != null) {
        need(active.status == "ACTIVE", "falhou")
    }
}

test "contencao: freeze de conta cobre devices, servicos e kfs_ e restaura cada status", "freeze-unit" {
    var registry = Registry(freezePath("acct"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var other = registry.createAccount("ana", "ana@e.com", "segredo")
    var nb = registry.registerDevice(account, "nb", "pk")
    var desk = registry.registerDevice(account, "desk", "pk2")
    var foreign = registry.registerDevice(other, "outro", "pk3")
    var a = registry.publishService(account, nb.id, "a", "127.0.0.1", 8081, "http", "AUTHENTICATED", "", "")
    var b = registry.publishService(account, desk.id, "b", "127.0.0.1", 8082, "http", "AUTHENTICATED", "", "")
    var foreignSvc = registry.publishService(other, foreign.id, "c", "127.0.0.1", 8083, "http", "PUBLIC", "", "")
    // Estado misto: um servico ja suspenso antes do freeze deve continuar
    // suspenso depois do unfreeze (restaura o status anterior de CADA alvo).
    registry.setServiceStatus(b.id, "SUSPENDED")
    var ta = registry.issueServiceToken(account.id, a.id, 24)
    var tb = registry.issueServiceToken(account.id, b.id, 24)
    var keep = registry.issueServiceToken(other.id, foreignSvc.id, 24)
    // Cruzamento freeze × sessao da conta: o containment revoga as kfs_ do
    // alvo mas nunca toca nas sessoes kfc_ (senao o operador se trancaria
    // para fora no meio do incidente — nem o unfreeze conseguiria rodar).
    var session = registry.issueToken(account.id)
    var otherSession = registry.issueToken(other.id)

    var result = registry.freezeAccount(account.id)
    need(result.ok, "falhou")
    need(result.revoked == 2, "falhou")
    need(result.incidentId.length > 0, "falhou")
    need(registry.serviceByServiceToken(ta) == null, "falhou")
    need(registry.serviceByServiceToken(tb) == null, "falhou")
    need(registry.serviceByServiceToken(keep) != null, "falhou")
    need(registry.accountByToken(session) != null, "falhou")
    need(registry.accountByToken(otherSession) != null, "falhou")

    var frozenNb = registry.deviceById(nb.id)
    var frozenDesk = registry.deviceById(desk.id)
    if (frozenNb != null) {
        need(frozenNb.status == "SUSPENDED", "falhou")
    }
    if (frozenDesk != null) {
        need(frozenDesk.status == "SUSPENDED", "falhou")
    }
    var frozenA = registry.serviceById(a.id)
    var frozenB = registry.serviceById(b.id)
    if (frozenA != null) {
        need(frozenA.status == "SUSPENDED", "falhou")
    }
    if (frozenB != null) {
        need(frozenB.status == "SUSPENDED", "falhou")
    }
    var foreignDevice = registry.deviceById(foreign.id)
    if (foreignDevice != null) {
        need(foreignDevice.status == "ACTIVE", "falhou")
    }
    // Nada da conta roteia enquanto congelada.
    need(registry.resolveRoute(a.hostname) == null, "falhou")
    need(registry.resolveRoute(b.hostname) == null, "falhou")

    need(registry.unfreezeAccount(account.id).restored, "falhou")
    var backNb = registry.deviceById(nb.id)
    var backDesk = registry.deviceById(desk.id)
    if (backNb != null) {
        need(backNb.status == "ACTIVE", "falhou")
    }
    if (backDesk != null) {
        need(backDesk.status == "ACTIVE", "falhou")
    }
    var backA = registry.serviceById(a.id)
    var backB = registry.serviceById(b.id)
    if (backA != null) {
        need(statusIsRoutable(backA.status), "falhou")
    }
    if (backB != null) {
        need(backB.status == "SUSPENDED", "falhou")
    }
    need(registry.resolveRoute(a.hostname) != null, "falhou")
    // Configuracao preservada.
    if (backA != null) {
        need(backA.hostname == a.hostname, "falhou")
        need(backA.allowMethods == a.allowMethods, "falhou")
    }
}

test "contencao: freeze de conta e idempotente na auditoria e no incidente", "freeze-unit" {
    var registry = Registry(freezePath("acctidem"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")

    var first = registry.freezeAccount(account.id)
    var second = registry.freezeAccount(account.id)
    need(first.ok, "falhou")
    need(second.ok, "falhou")
    // `raiseIncident` nao duplica: o segundo freeze nao abre outro e por isso
    // devolve incidentId vazio (mesmo contrato do freeze de service/device).
    need(first.incidentId.length > 0, "falhou")
    need(second.incidentId == "", "falhou")
    var frozen = 0
    for (var incident in registry.incidentsForAccount(account.id, false)) {
        if (incident.kind == incidentFreezeAccount() && incident.resolvedAt == 0) {
            frozen = frozen + 1
        }
    }
    need(frozen == 1, "falhou")
    need(registry.unfreezeAccount(account.id).restored, "falhou")
    var after = registry.serviceById(service.id)
    if (after != null) {
        need(statusIsRoutable(after.status), "falhou")
    }
}

test "contencao: alvo alheio nao congela", "freeze-unit" {
    var registry = Registry(freezePath("owner"))
    var mel = registry.createAccount("mel", "mel@e.com", "segredo")
    var ana = registry.createAccount("ana", "ana@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    need(registry.freezeService(ana.id, service.id).ok == false, "falhou")
    need(registry.freezeDevice(ana.id, device.id).ok == false, "falhou")
    need(registry.unfreezeService(ana.id, service.id).ok == false, "falhou")
}

test "contencao: codigos KCF126/KCF127/KCF128 com Hint", "freeze-unit" {
    need(errTargetRequired().indexOf("KCF126") >= 0, "falhou")
    need(errInvalidTarget().indexOf("KCF127") >= 0, "falhou")
    need(errTargetNotFound().indexOf("KCF128") >= 0, "falhou")
    need(errHint(errTargetRequired()).length > 0, "falhou")
    need(errHint(errInvalidTarget()).length > 0, "falhou")
    need(errHint(errTargetNotFound()).length > 0, "falhou")
}

test "contencao: HTTP freeze/unfreeze e incidente listado", "freeze" {
    var controlPort = 19871
    var registry = Registry(freezePath("http"))
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var accountToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"AUTHENTICATED\"}"
    var published = httpPostJson(controlPort, "/v1/services", pubBody, accountToken)
    var serviceId = mapField(json.decode<Map<String, String>>(bodyOf(published)), "id")

    var freezeBody = "{\"target\":\"service\",\"id\":\"" + serviceId + "\"}"
    var frozen = httpPostJson(controlPort, "/v1/freeze", freezeBody, accountToken)
    need(statusOf(frozen) == 200, "falhou")
    var result = json.decode<Map<String, String>>(bodyOf(frozen))
    need(mapField(result, "incidentId").length > 0, "falhou")

    var listed = httpPostJson(controlPort, "/v1/incidents", "{}", accountToken)
    need(bodyOf(listed).indexOf("freeze_service") >= 0, "falhou")

    var unfrozen = httpPostJson(controlPort, "/v1/unfreeze", freezeBody, accountToken)
    need(statusOf(unfrozen) == 200, "falhou")

    // Validacoes.
    need(statusOf(httpPostJson(controlPort, "/v1/freeze", "{\"target\":\"service\"}", accountToken)) == 400, "falhou")
    need(statusOf(httpPostJson(controlPort, "/v1/freeze", "{\"target\":\"edge\",\"id\":\"x\"}", accountToken)) == 400, "falhou")
    need(statusOf(httpPostJson(controlPort, "/v1/freeze", "{\"target\":\"service\",\"id\":\"naoexiste\"}", accountToken)) == 404, "falhou")

    // Alvo `account`: sem id (o token decide a conta). Congela os devices e
    // servicos do dono, abre o incidente e restaura no unfreeze.
    var acctFreeze = httpPostJson(controlPort, "/v1/freeze", "{\"target\":\"account\"}", accountToken)
    need(statusOf(acctFreeze) == 200, "falhou")
    var acctResult = json.decode<Map<String, String>>(bodyOf(acctFreeze))
    need(mapField(acctResult, "incidentId").length > 0, "falhou")
    var acctListed = httpPostJson(controlPort, "/v1/incidents", "{}", accountToken)
    need(bodyOf(acctListed).indexOf("freeze_account") >= 0, "falhou")
    var acctUnfreeze = httpPostJson(controlPort, "/v1/unfreeze", "{\"target\":\"account\"}", accountToken)
    need(statusOf(acctUnfreeze) == 200, "falhou")
    // Idempotente no ESTADO (nada quebra), nao na resposta: o segundo
    // unfreeze nao tem nada a reverter, entao 409 KCF141 e a verdade. Antes
    // respondia 200 e "restaurava" um status que ninguem tinha congelado.
    var again = httpPostJson(controlPort, "/v1/unfreeze", "{\"target\":\"account\"}", accountToken)
    need(statusOf(again) == 409, "falhou")
    need(bodyOf(again).indexOf("KCF141") >= 0, "falhou")
}
test "contencao: device revogado nao congela (KCF023)", "freeze-unit" {
    // Medido: REVOKED e terminal — a guarda de `setDeviceStatus` recusava o
    // `suspendDevice` silenciosamente, o freeze marcava REVOKED como "status
    // anterior" e dizia ok=true sem congelar nada. Mesma recusa do publish
    // (KCF023): revogado nao entra no ciclo freeze/unfreeze.
    var registry = Registry(freezePath("revoked"))
    var mel = registry.createAccount("mel", "mel@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    registry.revokeDevice(mel.id, device.id)

    var refused = false
    var code = ""
    try {
        registry.freezeDevice(mel.id, device.id)
    } catch (String e) {
        refused = true
        code = e
    }
    need(refused, "falhou")
    need(code.indexOf("KCF023") >= 0, "falhou")
    need(registry.frozenMarks().size == 0, "falhou")
    var after = registry.deviceById(device.id)
    need(after != null, "falhou")
    if (after != null) {
        need(after.status == "REVOKED", "falhou")
    }
    // Sem incidente nem auditoria de freeze.
    var incidents = registry.incidentsForAccount(mel.id, false)
    var froze = 0
    for (var incident in incidents) {
        if (incident.kind == "freeze_device") {
            froze = froze + 1
        }
    }
    need(froze == 0, "falhou")

    // Conta com device revogado NO MEIO: congela so os vivos, sem marca
    // morta — o unfreeze seguinte restaura so o que entrou no ciclo.
    var live = registry.registerDevice(mel, "vivo", "pk2")
    registry.freezeAccount(mel.id)
    need(registry.frozenMarks().get("device/" + device.id) == null, "falhou")
    need(registry.frozenMarks().get("device/" + live.id) != null, "falhou")
    need(registry.unfreezeAccount(mel.id).restored, "falhou")
    var deadAfter = registry.deviceById(device.id)
    if (deadAfter != null) {
        need(deadAfter.status == "REVOKED", "falhou")
    }
    var liveAfter = registry.deviceById(live.id)
    if (liveAfter != null) {
        need(liveAfter.status == "ACTIVE", "falhou")
    }
    need(registry.frozenMarks().size == 0, "falhou")
}

test "contencao: unfreeze honra a terminalidade de revogado (marca legada)", "freeze-unit" {
    // Estado sintetico do que o codigo ANTIGO gravava: freeze de device antes
    // da recusa marcava REVOKED como anterior (e, antes da poda, o freeze
    // seguido de revoke deixava marca em device que virou REVOKED). Nesse
    // estado, o unfreeze apagava a marca dizendo restored=true com o status
    // intocado — a guarda de terminalidade recusava o set em silencio.
    var legacyPath = freezePath("legacy-revoked")
    var state = "{\"accounts\":[{\"id\":\"acc-x\",\"handle\":\"mel\",\"email\":\"m@e.com\",\"passwordHash\":\"h\",\"createdAt\":0}],"
    state = state + "\"devices\":["
    state = state + "{\"id\":\"d1\",\"accountId\":\"acc-x\",\"name\":\"morto\",\"publicKey\":\"pk\",\"status\":\"REVOKED\",\"lastSeenAt\":0,\"createdAt\":0},"
    state = state + "{\"id\":\"d2\",\"accountId\":\"acc-x\",\"name\":\"vivo\",\"publicKey\":\"pk2\",\"status\":\"ACTIVE\",\"lastSeenAt\":0,\"createdAt\":0}],"
    state = state + "\"services\":[],\"tokens\":[],\"serviceTokens\":[],\"customDomains\":[],\"audit\":[],\"incidents\":[],\"webhooks\":[],"
    state = state + "\"freezeMarks\":[{\"target\":\"device/d1\",\"status\":\"ACTIVE\"},{\"target\":\"device/d2\",\"status\":\"SUSPENDED\"}]}"
    writeTextTo(legacyPath, state)
    var registry = Registry(legacyPath)
    need(registry.loadStatus == "ok", "falhou")

    // Unfreeze direto do revogado: recusa com KCF023, nada muda.
    var refused = false
    var code = ""
    try {
        registry.unfreezeDevice("acc-x", "d1")
    } catch (String e) {
        refused = true
        code = e
    }
    need(refused, "falhou")
    need(code.indexOf("KCF023") >= 0, "falhou")
    var dead = registry.deviceById("d1")
    need(dead != null, "falhou")
    if (dead != null) {
        need(dead.status == "REVOKED", "falhou")
    }
    need(registry.frozenMarks().get("device/d1") != null, "falhou")

    // Na conta: o revogado sai do ciclo sem perder a marca nem contar como
    // restaurado; o vivo restaura de verdade.
    var outcome = registry.unfreezeAccount("acc-x")
    need(outcome.ok, "falhou")
    need(outcome.restored, "falhou")
    var live = registry.deviceById("d2")
    need(live != null, "falhou")
    if (live != null) {
        need(live.status == "SUSPENDED", "falhou")
    }
    need(registry.frozenMarks().get("device/d1") != null, "falhou")
    need(registry.frozenMarks().get("device/d2") == null, "falhou")
    var deadAfter = registry.deviceById("d1")
    if (deadAfter != null) {
        need(deadAfter.status == "REVOKED", "falhou")
    }
}

test "contencao: teto das marcas poda inertes e nunca recusa containment", "freeze-unit" {
    // Estado sintetico com duas marcas inertes legadas (alvos que sairam) e
    // uma viva. O teto (`limitFreezeMarks`, default 1000, afinavel por
    // config) e higiênico: acima dele o freeze poda SO as inertes — o
    // unfreeze nelas ja responde 404/409 sem ler a marca. Com todas vivas o
    // teto cede: recusar containment por limite de marcas seria o incidente
    // mandando no remedio, e apagar marca viva perderia o status anterior.
    var capPath = freezePath("marks-cap")
    var state = "{\"accounts\":[{\"id\":\"acc-x\",\"handle\":\"mel\",\"email\":\"m@e.com\",\"passwordHash\":\"h\",\"createdAt\":0}],"
    state = state + "\"devices\":["
    state = state + "{\"id\":\"d1\",\"accountId\":\"acc-x\",\"name\":\"um\",\"publicKey\":\"pk1\",\"status\":\"ACTIVE\",\"lastSeenAt\":0,\"createdAt\":0},"
    state = state + "{\"id\":\"d2\",\"accountId\":\"acc-x\",\"name\":\"dois\",\"publicKey\":\"pk2\",\"status\":\"ACTIVE\",\"lastSeenAt\":0,\"createdAt\":0}],"
    state = state + "\"services\":[],\"tokens\":[],\"serviceTokens\":[],\"customDomains\":[],\"audit\":[],\"incidents\":[],\"webhooks\":[],"
    state = state + "\"freezeMarks\":[{\"target\":\"device/gone1\",\"status\":\"ACTIVE\"},{\"target\":\"service/gone2\",\"status\":\"ACTIVE\"},{\"target\":\"device/d2\",\"status\":\"ACTIVE\"}]}"
    writeTextTo(capPath, state)
    var registry = Registry(capPath)
    need(registry.loadStatus == "ok", "falhou")
    need(freezeMarkLimitFrom(0) == 1000, "falhou")
    need(freezeMarkLimitFrom(-7) == 1000, "falhou")
    need(freezeMarkLimitFrom(50) == 50, "falhou")
    need(limitFreezeMarks() == 1000, "falhou")

    // Classificacao de inerte: removido e servico-removido sao inertes;
    // device vivo e prefixo desconhecido ficam.
    need(registry.freezeMarkIsInert("device/gone1"), "falhou")
    need(registry.freezeMarkIsInert("service/gone2"), "falhou")
    need(registry.freezeMarkIsInert("device/d2") == false, "falhou")
    need(registry.freezeMarkIsInert("outro/alvo") == false, "falhou")

    // 3 marcas > teto 2: o freeze do alvo vivo poda as duas inertes e
    // guarda a viva — containment segue funcionando acima do teto.
    registry.setMaxFreezeMarks(2)
    var result = registry.freezeDevice("acc-x", "d2")
    need(result.ok, "falhou")
    need(registry.frozenMarks().size == 1, "falhou")
    need(registry.frozenMarks().get("device/d2") != null, "falhou")
    need(registry.frozenMarks().get("device/gone1") == null, "falhou")
    need(registry.frozenMarks().get("service/gone2") == null, "falhou")

    // Todas vivas acima do teto: nada e podado e o freeze segue ok.
    registry.setMaxFreezeMarks(1)
    var second = registry.freezeDevice("acc-x", "d1")
    need(second.ok, "falhou")
    need(registry.frozenMarks().size == 2, "falhou")

    // A poda persiste no arquivo (o proximo registry ja nasce sem o residuo).
    var reloaded = Registry(capPath)
    need(reloaded.loadStatus == "ok", "falhou")
    need(reloaded.frozenMarks().get("device/d1") != null, "falhou")
    need(reloaded.frozenMarks().get("device/d2") != null, "falhou")
    need(reloaded.frozenMarks().get("device/gone1") == null, "falhou")
}

test "contencao: HTTP freeze de device revogado e 409 (nao 200)", "freeze" {
    var controlPort = 19881
    var registry = Registry(freezePath("http-revoked"))
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")
    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var dev = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", token)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(dev)), "deviceId")
    need(statusOf(httpPostJson(controlPort, "/v1/devices/revoke", "{\"deviceId\":\"" + deviceId + "\"}", token)) == 200, "falhou")

    // Congelar o revogado: 409 KCF023, nao 200 fingindo que congelou.
    var frozen = httpPostJson(controlPort, "/v1/freeze", "{\"target\":\"device\",\"id\":\"" + deviceId + "\"}", token)
    need(statusOf(frozen) == 409, "falhou")
    need(bodyOf(frozen).indexOf("KCF023") >= 0, "falhou")

    // Descongelar o revogado: mesma recusa (terminal nos dois sentidos).
    var thawed = httpPostJson(controlPort, "/v1/unfreeze", "{\"target\":\"device\",\"id\":\"" + deviceId + "\"}", token)
    need(statusOf(thawed) == 409, "falhou")
    need(bodyOf(thawed).indexOf("KCF023") >= 0, "falhou")

    // Congelar o inexistente continua 404 opaco (nao vaza dono/recurso).
    var ghost = httpPostJson(controlPort, "/v1/freeze", "{\"target\":\"device\",\"id\":\"fantasma\"}", token)
    need(statusOf(ghost) == 404, "falhou")
}

test "contencao: unfreeze de alvo nao congelado nao apaga suspensao", "freeze-unit" {
    // Medido: sem marca de freeze, `unfreezeService` gravava UNKNOWN e
    // `unfreezeDevice` gravava ACTIVE — apagando uma SUSPENSAO deliberada do
    // operador — e o CLI dizia "status anterior restaurado". Nada foi
    // congelado: nao ha anterior para restaurar.
    var registry = Registry(freezePath("notfrozen"))
    var mel = registry.createAccount("mel", "mel@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")

    // Suspensao deliberada (NAO e freeze).
    need(registry.suspendDevice(mel.id, device.id), "falhou")
    need(registry.suspendService(mel.id, service.id), "falhou")

    var svcOutcome = registry.unfreezeService(mel.id, service.id)
    need(svcOutcome.ok, "falhou")
    need(svcOutcome.restored == false, "falhou")
    var devOutcome = registry.unfreezeDevice(mel.id, device.id)
    need(devOutcome.ok, "falhou")
    need(devOutcome.restored == false, "falhou")

    // O status continua exatamente onde o operador deixou.
    var svcAfter = registry.serviceById(service.id)
    need(svcAfter != null, "falhou")
    if (svcAfter != null) {
        need(svcAfter.status == "SUSPENDED", "falhou")
    }
    var devAfter = registry.deviceById(device.id)
    need(devAfter != null, "falhou")
    if (devAfter != null) {
        need(devAfter.status == "SUSPENDED", "falhou")
    }
    // Sem auditoria falsa de unfreeze.
    var unfreezes = registry.auditCountSince(mel.id, "service.unsuspended", 0)
    need(unfreezes == 0, "falhou")

    // Conta sem freeze em curso: idem.
    need(registry.unfreezeAccount(mel.id).restored == false, "falhou")
    var devStill = registry.deviceById(device.id)
    if (devStill != null) {
        need(devStill.status == "SUSPENDED", "falhou")
    }

    // Alvo inexistente segue sendo outra falha (ok=false -> 404).
    need(registry.unfreezeService(mel.id, "fantasma").ok == false, "falhou")
    need(registry.unfreezeDevice(mel.id, "fantasma").ok == false, "falhou")
}

test "contencao: HTTP unfreeze de nao congelado e 409 (nao 200)", "freeze" {
    var controlPort = 19861
    var registry = Registry(freezePath("http-notfrozen"))
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")
    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var dev = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", token)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(dev)), "deviceId")
    var pub = httpPostJson(controlPort, "/v1/services", "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}", token)
    var serviceId = mapField(json.decode<Map<String, String>>(bodyOf(pub)), "id")

    // Suspensao deliberada e SEM freeze: unfreeze recusa em vez de "restaurar".
    need(statusOf(httpPostJson(controlPort, "/v1/services/suspend", "{\"serviceId\":\"" + serviceId + "\"}", token)) == 200, "falhou")
    var notFrozen = httpPostJson(controlPort, "/v1/unfreeze", "{\"target\":\"service\",\"id\":\"" + serviceId + "\"}", token)
    need(statusOf(notFrozen) == 409, "falhou")
    need(bodyOf(notFrozen).indexOf("KCF141") >= 0, "falhou")
    var still = registry.serviceById(serviceId)
    if (still != null) {
        need(still.status == "SUSPENDED", "falhou")
    }

    // Freeze de verdade e depois unfreeze: 200 e restaura.
    need(statusOf(httpPostJson(controlPort, "/v1/freeze", "{\"target\":\"service\",\"id\":\"" + serviceId + "\"}", token)) == 200, "falhou")
    need(statusOf(httpPostJson(controlPort, "/v1/unfreeze", "{\"target\":\"service\",\"id\":\"" + serviceId + "\"}", token)) == 200, "falhou")
    var back = registry.serviceById(serviceId)
    if (back != null) {
        need(back.status == "SUSPENDED", "falhou")
    }

    // Inexistente continua 404 opaco.
    var ghost = httpPostJson(controlPort, "/v1/unfreeze", "{\"target\":\"service\",\"id\":\"fantasma\"}", token)
    need(statusOf(ghost) == 404, "falhou")
}
