import kofcloud.control.ControlPlane
import kofcloud.control.Panel
import kofcloud.control.Registry
import kofcloud.store.Store
import testkit.Support

// Fase 12 slice 2 — gestao completa pelo painel.
// O painel continua estatico e sem endpoint privilegiado: cada acao chama a
// MESMA rota /v1 da CLI. O teste prova (a) que o HTML expoe cada acao e a
// confirmacao das destrutivas, e (b) que as rotas que ele chama funcionam.

test "painel: rodape anuncia exatamente as rotas que a pagina usa (fonte unica)", "panel-actions-unit" {
    // O rodape era escrito a mao e estava em drift nos dois sentidos: 5
    // rotas reais nao constavam (services/remove, services/token/revoke,
    // services/tokens, services/token-hygiene e o /v1/tokens da camada de
    // credencial do diagnostico) e ele citava um fantasma /v1/domains/add
    // (adicionar dominio e POST /v1/domains; nao existe /v1/domains/add).
    // Agora o rodape e DERIVADO de panelRoutes() — a mesma lista que a trava
    // abaixo compara com o HTML. Nos dois sentidos:
    //  1. cada ocorrencia de /v1 no HTML servido consta na lista;
    //  2. cada entrada da lista aparece no HTML.
    var html = panelHtml()
    var lista = panelRoutes()
    // Direcao 1: percorre o HTML extraindo o token de rota em cada /v1
    // (letras/digitos/-//) e exige a lista como fonte.
    var pos = html.indexOf("/v1")
    var vistas = 0
    while (pos >= 0) {
        var end = pos
        while (end < html.length && isRouteChar(html.charAt(end))) {
            end = end + 1
        }
        var rota = html.substring(pos, end)
        need(lista.indexOf(rota) >= 0, "falhou")
        vistas = vistas + 1
        pos = html.indexOf("/v1", end)
    }
    need(vistas >= 21, "falhou")
    // Direcao 2: nenhuma rota inventada — cada entrada da fonte existe no HTML.
    var entradas = lista.split(", ")
    need(entradas.length == 23, "falhou")
    for (var i = 0; i < entradas.length; i++) {
        need(html.indexOf(entradas[i]) >= 0, "falhou")
    }
    // O rodape usa a fonte (nao uma copia): a string avaliada esta no rodape
    // e nenhuma copia manual de lista ficou para tras.
    need(html.indexOf("<footer>KofCloud painel v") >= 0 && html.indexOf(" — usa " + lista + "</footer>") >= 0, "falhou")
    need(html.indexOf("/v1/domains/add") < 0, "falhou")
}

Bool isRouteChar(Char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '/' || c == '-'
}

test "painel s2: HTML expoe as acoes da gestao completa", "panel-actions-unit" {
    var html = panelHtml()
    // Acoes de servico.
    need(html.indexOf("/v1/services/remove") >= 0, "falhou")
    need(html.indexOf("/v1/services/suspend") >= 0, "falhou")
    need(html.indexOf("/v1/services/unsuspend") >= 0, "falhou")
    need(html.indexOf("/v1/services/token'") >= 0, "falhou")
    need(html.indexOf("/v1/services/token/revoke") >= 0, "falhou")
    // Dominios.
    need(html.indexOf("/v1/domains/verify") >= 0, "falhou")
    need(html.indexOf("/v1/domains/remove") >= 0, "falhou")
    // Dispositivos.
    need(html.indexOf("/v1/devices/revoke") >= 0, "falhou")
    need(html.indexOf("/v1/devices/suspend") >= 0, "falhou")
    need(html.indexOf("/v1/devices/unsuspend") >= 0, "falhou")
    // Destrutivas pedem confirmacao explicita.
    need(html.indexOf("confirm(") >= 0, "falhou")
    // kfs_ aparece uma vez (na emissao), nunca numa listagem.
    need(html.indexOf("Credencial emitida") >= 0, "falhou")
    // Seguranca do slice 1 preservada: nenhum VALOR de token no HTML
    // (o rotulo "Emitir kfs_" e texto; valor teria kfs_ + 64 hex).
    need(html.indexOf("kfc_") < 0, "falhou")
    var labelsOnly = true
    var cursor = html.indexOf("kfs_")
    while (cursor >= 0) {
        var after = cursor + 4
        var hexRun = 0
        while (after + hexRun < html.length && isHexChar(html.charAt(after + hexRun))) {
            hexRun = hexRun + 1
        }
        if (hexRun >= 16) {
            labelsOnly = false
        }
        cursor = html.indexOf("kfs_", after)
    }
    need(labelsOnly, "falhou")
    need(html.indexOf("localStorage") < 0, "falhou")
    // Sair: o token colado na pagina vivia para sempre no servidor — fechar
    // a aba nao encerra nada (o logout da CLI ja auto-revogava; o painel
    // nao tinha equivalente). O botao revoga pela MESMA rota publica antes
    // de limpar a memoria; token ja morto tambem limpa; outra falha avisa
    // e NAO limpa (limpar faria o operador achar que revogou).
    need(html.indexOf("onclick=\"sair()\"") >= 0, "falhou")
    need(html.indexOf("/v1/tokens/revoke'") >= 0, "falhou")
    need(html.indexOf("KCF004") >= 0, "falhou")
    need(html.indexOf("kof cloud token revoke") >= 0, "falhou")
    need(html.indexOf("token segue valido") >= 0, "falhou")
}

test "painel: status do dominio usa o vocabulario da API (VERIFIED/PENDING)", "panel-actions-unit" {
    // Bug real: a tabela de dominios comparava com 'ACTIVE' — vocabulario
    // que a API nunca devolve (model/CustomDomain e PENDING/VERIFIED) —
    // entao TODO dominio verificado ficava amarelo de pendencia e o
    // operador nao distinguia verificado de pendente na tabela.
    var html = panelHtml()
    need(html.indexOf("'VERIFIED'") >= 0, "falhou")
    need(html.indexOf("ACTIVE") < 0, "falhou")
    // Entradas sem status (zona wildcard, hostname de servico) viram '-'
    // sem herdar cor de pendencia.
    need(html.indexOf("d.status ?") >= 0, "falhou")
    // Rebuild do select: uma chamada por carregamento + o reset do sair
    // (limpa as opcoes junto com a memoria; 3 definicao + carregar + sair).
    // Se essa contagem subir de novo sem motivo, ou o carregamento voltou
    // a duplicar trabalho, ou alguem limpa UI sem passar pelo preencher.
    var count = 0
    var cursor = html.indexOf("preencherDevices(devs)")
    while (cursor >= 0) {
        count = count + 1
        cursor = html.indexOf("preencherDevices(devs)", cursor + 1)
    }
    cursor = html.indexOf("preencherDevices([])")
    while (cursor >= 0) {
        count = count + 1
        cursor = html.indexOf("preencherDevices([])", cursor + 1)
    }
    need(count == 3, "falhou")
    // Divergencia real paga uma vez: as tres tabelas eram renderizadas por
    // codigo duplicado no carregamento inicial e no recarregar-apos-acao —
    // o vocabulario do dominio precisou ser corrigido nas DUAS copias.
    // Agora ha UMA funcao renderListas (dita o HTML das tabelas) chamada
    // nos dois caminhos: uma soma Σ dos ramos so pode ser 1.
    var umaChamada = 0
    var r = html.indexOf("renderListas(")
    while (r >= 0) {
        umaChamada = umaChamada + 1
        r = html.indexOf("renderListas(", r + 1)
    }
    need(umaChamada == 3, "falhou")
    var verificado = 0
    var v = html.indexOf("d.status === 'VERIFIED'")
    while (v >= 0) {
        verificado = verificado + 1
        v = html.indexOf("d.status === 'VERIFIED'", v + 1)
    }
    need(verificado == 1, "falhou")
}

test "painel s2: criar conta pelo painel (escopo do slice, mesma rota da CLI)", "panel-actions-unit" {
    // O escopo do slice 2 promete "criar conta ... tudo pelo painel", mas o
    // painel so tinha o campo de colar token — criar conta exigia terminal.
    // O HTML tem o formulario e chama a MESMA rota publica (POST
    // /v1/accounts) que o CLI usa; o kfc_ devolvido segue a regra do kfs_:
    // aparece UMA vez (para colar no campo acima) e nunca e gravado.
    var html = panelHtml()
    need(html.indexOf("/v1/accounts','POST'") >= 0, "falhou")
    need(html.indexOf("newhandle") >= 0 && html.indexOf("newpass") >= 0, "falhou")
    need(html.indexOf("token aparece UMA vez") >= 0, "falhou")
    // Seguranca: nenhum valor de token embutido (a pagina nao sabe nenhum
    // kfc_); a senha da conta nova nunca vai para value/HTML estatico.
    need(html.indexOf("kfc_") < 0, "falhou")
    need(html.indexOf("localStorage") < 0, "falhou")
    // Sem usuario/senha, o painel nem chama a rota.
    need(html.indexOf("informe usuario e senha") >= 0, "falhou")
}

test "painel s2: as rotas que o painel chama funcionam (publica e remove)", "panel-actions" {
    var controlPort = 19931
    var registry = Registry("/tmp/kofcloud-pa-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    control.enablePanel()
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", token)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")

    // Publicar (o que o botao "Publicar" faz).
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    var published = httpPostJson(controlPort, "/v1/services", pubBody, token)
    need(statusOf(published) == 200, "falhou")
    var serviceId = mapField(json.decode<Map<String, String>>(bodyOf(published)), "id")

    // Suspender/reativar (botoes).
    need(statusOf(httpPostJson(controlPort, "/v1/services/suspend", "{\"serviceId\":\"" + serviceId + "\"}", token)) == 200, "falhou")
    need(statusOf(httpPostJson(controlPort, "/v1/services/unsuspend", "{\"serviceId\":\"" + serviceId + "\"}", token)) == 200, "falhou")

    // Emitir credencial (o painel mostra uma vez; a listagem so traz id).
    var emitted = httpPostJson(controlPort, "/v1/services/token", "{\"serviceId\":\"" + serviceId + "\"}", token)
    need(statusOf(emitted) == 200, "falhou")
    var list = httpPostJson(controlPort, "/v1/services/tokens", "{\"serviceId\":\"" + serviceId + "\"}", token)
    need(bodyOf(list).indexOf("kfs_") < 0, "falhou")

    // Remover (botao destrutivo).
    need(statusOf(httpPostJson(controlPort, "/v1/services/remove", "{\"serviceId\":\"" + serviceId + "\"}", token)) == 200, "falhou")
    var after = httpGetToken(controlPort, "/v1/services", token)
    need(bodyOf(after).indexOf("\"name\":\"site\"") < 0, "falhou")

    // Sair (POR ULTIMO — mata a sessao): auto-revoga o proprio token da
    // aba pela MESMA rota publica que o botao chama; depois a credencial
    // nao autentica mais. E o caminho do KCF004 (token ja morto) que o
    // painel tambem trata como "sessao encerrada".
    var sair = httpPostJson(controlPort, "/v1/tokens/revoke", "{\"token\":\"" + token + "\"}", token)
    need(statusOf(sair) == 200, "falhou")
    need(statusOf(httpGetToken(controlPort, "/v1/devices", token)) == 401, "falhou")

    // E a pagina continua servida sem token.
    var page = httpGetRaw(controlPort, "/panel", "127.0.0.1")
    need(statusOf(page) == 200, "falhou")
}

test "painel s2: adicionar dominio usa o NOME do servico (contrato da API)", "panel-actions" {
    // Bug real: o botao mandava `serviceId` e a API le `service` (nome) —
    // todo "Adicionar dominio" pelo painel devolvia 404 KCF122. O teste
    // trava o contrato: o HTML manda `service:` e a rota aceita esse corpo.
    var html = panelHtml()
    need(html.indexOf("service: s") >= 0, "falhou")
    need(html.indexOf("serviceId: idPorNome(STATE.svcs, s)") < 0, "falhou")

    var controlPort = 19932
    var registry = Registry("/tmp/kofcloud-pa2-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    control.enablePanel()
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", token)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    need(statusOf(httpPostJson(controlPort, "/v1/services", pubBody, token)) == 200, "falhou")

    // Corpo exato que o painel envia agora.
    var added = httpPostJson(controlPort, "/v1/domains", "{\"hostname\":\"api.example.com\",\"service\":\"site\"}", token)
    need(statusOf(added) == 200, "falhou")
    need(bodyOf(added).indexOf("CNAME api.example.com") >= 0, "falhou")

    // O vocabulario que a tabela do painel renderiza: a listagem devolve
    // PENDING/VERIFIED (nunca ACTIVE) — a comparacao do HTML trava com ela.
    var listed = httpGetToken(controlPort, "/v1/domains", token)
    need(statusOf(listed) == 200, "falhou")
    need(bodyOf(listed).indexOf("\"status\":\"PENDING\"") >= 0, "falhou")
    need(bodyOf(listed).indexOf("ACTIVE") < 0, "falhou")
}

test "painel s2: criar conta funciona pela rota que o botao chama", "panel-actions" {
    // O botao "Criar conta" manda {handle, email, password} para POST
    // /v1/accounts e mostra o token UMA vez. O e2e prova a rota com esse
    // corpo exato, incluindo as recusas (senha curta, handle repetido).
    var controlPort = 19934
    var registry = Registry("/tmp/kofcloud-pa4-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    control.enablePanel()
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")

    // Corpo exato que o painel envia.
    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"ana\",\"email\":\"a@e.com\",\"password\":\"segredo\"}", "")
    need(statusOf(created) == 200, "falhou")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    need(token.length > 0, "falhou")

    // O token devolvido funciona de verdade (a conta existe e autentica).
    var devs = httpGetToken(controlPort, "/v1/devices", token)
    need(statusOf(devs) == 200, "falhou")

    // Senha curta: a API recusa (o painel nem deixaria chegar sem senha).
    var curta = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"bob\",\"email\":\"b@e.com\",\"password\":\"abc\"}", "")
    need(statusOf(curta) == 400, "falhou")

    // Handle repetido: recusado (sem duplicar conta).
    var repetida = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"ana\",\"email\":\"outra@e.com\",\"password\":\"segredo2\"}", "")
    need(statusOf(repetida) == 409, "falhou")

    // E a pagina servida expoe o formulario (nao so a API).
    var page = httpGetRaw(controlPort, "/panel", "127.0.0.1")
    need(bodyOf(page).indexOf("newhandle") >= 0, "falhou")
}

Bool isHexChar(Char c) {
    var v = c as Int
    var digit = v >= 48 && v <= 57
    var lower = v >= 97 && v <= 102
    var upper = v >= 65 && v <= 70
    return digit || lower || upper
}

test "painel s2: publicar exige escolher o dispositivo (nunca o primeiro)", "panel-actions-unit" {
    // Com mais de uma maquina na conta, publicar no STATE.devs[0] expunha o
    // servico na maquina errada. Agora ha um <select id="svcdev"> e o publish
    // recusa quando nada foi escolhido.
    var html = panelHtml()
    need(html.indexOf("svcdev") >= 0, "falhou")
    need(html.indexOf("STATE.devs[0]") < 0, "falhou")
    need(html.indexOf("escolha o dispositivo") >= 0, "falhou")
    need(html.indexOf("preencherDevices") >= 0, "falhou")
    // O valor escolhido e o que vai no corpo.
    need(html.indexOf("document.getElementById('svcdev').value") >= 0, "falhou")
}

test "painel s2: registrar device pelo painel (escopo do slice, mesmo contrato do login)", "panel-actions-unit" {
    // O escopo do slice 2 promete "registrar device ... tudo pelo painel",
    // mas a secao Dispositivos so suspendia/reativava/revogava — registrar
    // exigia terminal. O formulario reserva o NOME: a maquina assume o
    // dispositivo com `login --device <nome>` (dedup por nome devolve o
    // mesmo id). A chave verdadeira nasce na maquina; o corpo exige uma,
    // entao vai o marcador honesto (nunca verificado no handshake, nunca
    // exibido em painel nem CLI).
    var html = panelHtml()
    need(html.indexOf("/v1/devices','POST'") >= 0, "falhou")
    need(html.indexOf("devnew") >= 0, "falhou")
    need(html.indexOf("informe o nome do dispositivo") >= 0, "falhou")
    need(html.indexOf("login --device") >= 0, "falhou")
    need(html.indexOf("aguardando-maquina") >= 0, "falhou")
}

test "painel s2: publicar no dispositivo escolhido funciona pela rota", "panel-actions" {
    var controlPort = 19933
    var registry = Registry("/tmp/kofcloud-pa3-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    control.enablePanel()
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var d1 = mapField(json.decode<Map<String, String>>(bodyOf(httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pk1\"}", token))), "deviceId")
    var d2 = mapField(json.decode<Map<String, String>>(bodyOf(httpPostJson(controlPort, "/v1/devices", "{\"name\":\"servidor\",\"publicKey\":\"pk2\"}", token))), "deviceId")

    // O painel manda o deviceId escolhido; prova que o segundo (nao o
    // primeiro) aceita o publish e que o servico fica nele.
    var body = "{\"deviceId\":\"" + d2 + "\",\"name\":\"api\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"3000\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    var published = httpPostJson(controlPort, "/v1/services", body, token)
    need(statusOf(published) == 200, "falhou")
    need(bodyOf(published).indexOf(d2) >= 0, "falhou")

    // Sem device: a API recusa (o painel nem deixa chegar aqui).
    var semDevice = httpPostJson(controlPort, "/v1/services", "{\"deviceId\":\"\",\"name\":\"x\",\"localPort\":\"1\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}", token)
    need(statusOf(semDevice) != 200, "falhou")
}

test "painel: secao Diagnostico usa as camadas do doctor pela API (F12 s3)", "panel-actions-unit" {
    // Primeiro passo do onboarding guiado (slice 3): o diagnostico embutido
    // — as camadas do doctor que a pagina enxerga pela API publica (ciclo
    // de vida do dispositivo, tunel confirmado pelo Edge, cadeia de
    // auditoria, mais a credencial da conta), no vocabulario ok/FALHA da
    // CLI. Sem endpoint novo: as mesmas rotas publicas que o doctor
    // consulta. A credencial julga o MESMO sinal do fio que o doctor e o
    // token list (campo aditivo expiring do /v1/tokens) — nunca relogio
    // proprio, nunca o valor.
    var html = panelHtml()
    need(html.indexOf("Diagnostico") >= 0, "falhou")
    need(html.indexOf("onclick=\"diagnostico()\"") >= 0, "falhou")
    need(html.indexOf("/v1/devices'), api('/v1/presence'), api('/v1/audit/verify')") >= 0, "falhou")
    need(html.indexOf("api('/v1/audit/verify'), api('/v1/tokens')") >= 0, "falhou")
    need(html.indexOf("t.expiring === 'true'") >= 0, "falhou")
    need(html.indexOf("credencial da conta") >= 0, "falhou")
    need(html.indexOf("kof cloud doctor") >= 0, "falhou")
    // Vocabulario igual ao do doctor: FALHA com orientacao, ok confirma.
    need(html.indexOf("sem sessao no Edge") >= 0, "falhou")
    need(html.indexOf("device unsuspend") >= 0, "falhou")
    need(html.indexOf("cadeia quebrada") >= 0, "falhou")
    need(html.indexOf("espelho comprometido") >= 0, "falhou")
    need(html.indexOf("token rotate") >= 0, "falhou")
    // Seguranca/regras do painel preservadas em todo o incremento: nenhum
    // token embutido, nada persistido, vocabulario velho fora.
    need(html.indexOf("kfc_") < 0, "falhou")
    need(html.indexOf("localStorage") < 0, "falhou")
    need(html.indexOf("ACTIVE") < 0, "falhou")
}

test "painel: banner de onboarding aponta o proximo passo (F12 s3)", "panel-actions-unit" {
    // Segundo passo do onboarding guiado: a pagina aponta o proximo passo
    // da conta derivado do que ELA JA BUSCOU (devices, servicos e presenca)
    // — sem consulta nova, sem estado inventado. Sem device = passo 1
    // (registrar); device sem NENHUM no ar = maquina desconectada (connect),
    // mesmo com servico publicado; device no ar sem servico = passo 2
    // (publicar); com servico e tunel vivo o banner some.
    var html = panelHtml()
    need(html.indexOf("id=\"onboarding\"") >= 0, "falhou")
    need(html.indexOf("function onboarding(devs, svcs, online)") >= 0, "falhou")
    need(html.indexOf("Primeiro passo") >= 0 && html.indexOf("Registrar") >= 0, "falhou")
    need(html.indexOf("Maquina desconectada") >= 0, "falhou")
    need(html.indexOf("online.indexOf(d.id || d.deviceId)") >= 0, "falhou")
    need(html.indexOf("Quase la") >= 0 && html.indexOf("publique o primeiro servico") >= 0, "falhou")
    need(html.indexOf("kof cloud login --device") >= 0, "falhou")
    // O banner se atualiza junto: chamado no carregamento inicial E depois
    // de cada acao (a segunda chamada era o bug da duplicata — aqui e de
    // proposito e idempotente: innerHTML sobrescreve, nada acumula), e as
    // duas passam a lista de presenca que o mesmo carregamento ja buscou.
    need(html.indexOf("onboarding(devs, svcs, online);") >= 0, "falhou")
    need(html.indexOf("onboarding(STATE.devs, STATE.svcs, online);") >= 0, "falhou")
    need(html.indexOf("el.innerHTML = '';") >= 0, "falhou")
}

test "painel: fluxo guiado de 3 telas deriva a tela do estado real (F12 s3)", "panel-actions-unit" {
    // Terceiro passo do onboarding guiado (slice 3): as 3 telas prometidas —
    // conta, maquina, primeiro servico — costuradas num modo passo a passo
    // opt-in. A tela atual e derivada do que a pagina JA TEM (token validado
    // pelo Carregar, devices e servicos buscados): sem estado inventado, sem
    // endpoint novo, sem formulario duplicado — cada tela reusa as secoes e
    // funcoes existentes. O navegador nao instala nada: a adocao acontece na
    // maquina, honesto no texto.
    var html = panelHtml()
    need(html.indexOf("id=\"fluxo\"") >= 0, "falhou")
    need(html.indexOf("onclick=\"iniciarFluxo()\"") >= 0, "falhou")
    need(html.indexOf("Tela 1 de 3") >= 0, "falhou")
    need(html.indexOf("Tela 2 de 3") >= 0, "falhou")
    need(html.indexOf("Tela 3 de 3") >= 0, "falhou")
    need(html.indexOf("Fluxo concluido") >= 0, "falhou")
    need(html.indexOf("onclick=\"encerrarFluxo()\"") >= 0, "falhou")
    // A tela 1 so sai depois do Carregar validar o token (derivacao honesta,
    // nao cosmetica): pronto so vira true no sucesso do carregar e o sair o
    // reseta (o token da proxima sessao precisa revalidar).
    need(html.indexOf("if(!STATE.pronto)") >= 0, "falhou")
    need(html.indexOf("STATE.pronto = true;") >= 0, "falhou")
    need(html.indexOf("STATE.pronto = false;") >= 0, "falhou")
    // Tela 2 orienta a adocao na maquina (o painel nao instala nada); as
    // telas 2 e 3 embutem o diagnostico por camada e o Verificar que
    // re-renderiza o fluxo nos dois caminhos de atualizacao.
    need(html.indexOf("kof cloud login --device") >= 0, "falhou")
    need(html.indexOf("kof cloud connect") >= 0, "falhou")
    var chamadas = 0
    var c = html.indexOf("fluxoPasso();")
    while (c >= 0) {
        chamadas = chamadas + 1
        c = html.indexOf("fluxoPasso();", c + 1)
    }
    need(chamadas == 3, "falhou")
    // Seguranca/regras do painel preservadas em todo o incremento: nenhum
    // token embutido, nada persistido, vocabulario velho fora.
    need(html.indexOf("kfc_") < 0, "falhou")
    need(html.indexOf("localStorage") < 0, "falhou")
    need(html.indexOf("ACTIVE") < 0, "falhou")
}

test "painel s2: registrar device funciona pela rota e a maquina adota", "panel-actions" {
    // Corpo exato que o botao "Registrar" envia: reserva o NOME. A maquina
    // adota com `login --device <nome>` — o re-registro com a chave dela
    // devolve o MESMO id (dedup por nome entre ativos), entao o publish
    // feito pelo painel ja espera a maquina certa.
    var controlPort = 19935
    var registry = Registry("/tmp/kofcloud-pa5-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    control.enablePanel()
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")

    var reserved = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"aguardando-maquina\"}", token)
    need(statusOf(reserved) == 200, "falhou")
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(reserved)), "deviceId")
    need(deviceId.length > 0, "falhou")

    // A maquina adota: mesmo nome, chave dela — mesmo id, sem duplicar.
    var adopted = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"chave-real-da-maquina\"}", token)
    need(statusOf(adopted) == 200, "falhou")
    need(mapField(json.decode<Map<String, String>>(bodyOf(adopted)), "deviceId") == deviceId, "falhou")

    // E o publish no pre-registrado funciona (o que o painel faria depois).
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    need(statusOf(httpPostJson(controlPort, "/v1/services", pubBody, token)) == 200, "falhou")

    // A listagem mostra o dispositivo (a tabela do painel o renderiza).
    var listed = httpGetToken(controlPort, "/v1/devices", token)
    need(bodyOf(listed).indexOf(deviceId) >= 0, "falhou")

    // Nome vazio: a API recusa (o painel nem deixa chegar aqui).
    need(statusOf(httpPostJson(controlPort, "/v1/devices", "{\"name\":\"\",\"publicKey\":\"pk\"}", token)) == 400, "falhou")

    // E a pagina servida expoe o formulario (nao so a API).
    var page = httpGetRaw(controlPort, "/panel", "127.0.0.1")
    need(bodyOf(page).indexOf("devnew") >= 0, "falhou")
}

test "painel: diagnostico le as rotas que o doctor consulta (F12 s3)", "panel-actions" {
    // O diagnostico() do painel compoe /v1/devices + /v1/presence +
    // /v1/audit/verify + /v1/tokens com o token da aba. O e2e prova que as
    // quatro respondem no estado que o painel renderiza (incluindo o limite
    // honesto: conta recem-criada tem cadeia integra e tunel ausente).
    var controlPort = 19936
    var registry = Registry("/tmp/kofcloud-pa6-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    control.enablePanel()
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", token)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")

    // Cadeia de auditoria integra: a linha ok do painel (device registrado
    // pelo painel abre um evento; a criacao da conta abre outro).
    var verified = httpGetToken(controlPort, "/v1/audit/verify", token)
    need(statusOf(verified) == 200, "falhou")
    var fields = json.decode<Map<String, String>>(bodyOf(verified))
    need(mapField(fields, "ok") == "true", "falhou")
    need(mapField(fields, "events") != "0" && mapField(fields, "events") != "", "falhou")

    // Tunel ausente: a maquina nunca conectou — o painel mostra FALHA e
    // orienta o connect (igual ao doctor).
    var presence = httpGetToken(controlPort, "/v1/presence", token)
    need(statusOf(presence) == 200, "falhou")
    need(bodyOf(presence).indexOf(deviceId) < 0, "falhou")

    // Camada de dispositivo: a listagem traz o status que o painel julga.
    var listed = httpGetToken(controlPort, "/v1/devices", token)
    need(bodyOf(listed).indexOf("\"status\":\"ACTIVE\"") >= 0, "falhou")

    // Quarta camada (credencial da conta): sem TTL nenhum sinal no fio;
    // apos o rotate com TTL, o inventario marca SO a entrada nova (a da
    // sessao segue sem expiracao) e segue sem valores — o mesmo estado que
    // o painel julga para renderizar FALHA com o rotate.
    var semTtl = bodyOf(httpGetToken(controlPort, "/v1/tokens", token))
    need(semTtl.indexOf("expiring") < 0, "falhou")
    var rotated = httpPostJson(controlPort, "/v1/tokens/rotate", "{\"ttlHours\":\"24\"}", token)
    need(statusOf(rotated) == 200, "falhou")
    var fresh = mapField(json.decode<Map<String, String>>(bodyOf(rotated)), "token")
    var inventario = bodyOf(httpGetToken(controlPort, "/v1/tokens", fresh))
    need(inventario.indexOf("\"expiring\":\"true\"") >= 0, "falhou")
    need(inventario.indexOf("kfc_") < 0, "falhou")

    // E a pagina servida expoe a secao e os quatro endpoints.
    var page = httpGetRaw(controlPort, "/panel", "127.0.0.1")
    need(bodyOf(page).indexOf("id=\"diag\"") >= 0, "falhou")
    need(bodyOf(page).indexOf("/v1/audit/verify") >= 0, "falhou")
    need(bodyOf(page).indexOf("/v1/tokens") >= 0, "falhou")
}

test "painel: banner de onboarding acompanha o estado real da conta (F12 s3)", "panel-actions" {
    // O banner deriva o passo do que a pagina busca: /v1/devices,
    // /v1/services e /v1/presence. O e2e percorre os estados na ordem do
    // onboarding — conta nova (passo 1), device registrado sem tunel
    // (maquina desconectada — o connect aponta mesmo SEM servico), servico
    // publicado com tunel fora (ainda desconectada, em vez de sumir) —
    // provando que os dados que alimentam a decisao evoluem como o HTML
    // espera. A presenca e a fonte de verdade do Edge: nenhum agente
    // conecta neste teste, entao a lista nunca contem o device.
    var controlPort = 19937
    var registry = Registry("/tmp/kofcloud-pa7-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    control.enablePanel()
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")

    // Estado 1: conta nova, nada registrado — o banner aponta o passo 1.
    var devs1 = httpGetToken(controlPort, "/v1/devices", token)
    need(statusOf(devs1) == 200, "falhou")
    need(bodyOf(devs1) == "[]", "falhou")

    // Estado 2: device registrado — o banner aponta o passo 2.
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", token)
    need(statusOf(deviceResponse) == 200, "falhou")
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var svcs1 = httpGetToken(controlPort, "/v1/services", token)
    need(bodyOf(svcs1) == "[]", "falhou")
    var pres1 = httpGetToken(controlPort, "/v1/presence", token)
    need(statusOf(pres1) == 200, "falhou")
    need(bodyOf(pres1).indexOf(deviceId) < 0, "falhou")

    // Estado 3: servico publicado com o tunel fora do ar — o banner segue
    // acusando a maquina desconectada em vez de dar a conta por no ar.
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    need(statusOf(httpPostJson(controlPort, "/v1/services", pubBody, token)) == 200, "falhou")
    var svcs2 = httpGetToken(controlPort, "/v1/services", token)
    need(bodyOf(svcs2).indexOf("\"name\":\"site\"") >= 0, "falhou")
    var pres2 = httpGetToken(controlPort, "/v1/presence", token)
    need(statusOf(pres2) == 200, "falhou")
    need(bodyOf(pres2).indexOf(deviceId) < 0, "falhou")

    // E a pagina servida carrega o banner com as tres fontes de decisao.
    var page = httpGetRaw(controlPort, "/panel", "127.0.0.1")
    need(bodyOf(page).indexOf("id=\"onboarding\"") >= 0, "falhou")
    need(bodyOf(page).indexOf("function onboarding(devs, svcs, online)") >= 0, "falhou")
}

test "painel: fluxo guiado acompanha o fluxo completo no control plane (F12 s3)", "panel-actions" {
    // A prova do slice 3: o fluxo completo num control plane de teste —
    // conta (tela 1), device reservado pelo painel + adotado pela maquina
    // (tela 2), primeiro servico publicado (tela 3). Sao exatamente as
    // transicoes que a derivacao do fluxoPasso observa pela API.
    var controlPort = 19938
    var registry = Registry("/tmp/kofcloud-pa8-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    control.enablePanel()
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")

    // Tela 1 -> 2: conta criada; o token autentica (e o que o Carregar do
    // painel usa para buscar devices/servicos) e a conta nasce sem devices.
    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    need(statusOf(created) == 200, "falhou")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    need(bodyOf(httpGetToken(controlPort, "/v1/devices", token)) == "[]", "falhou")

    // Tela 2: o painel reserva o nome; a maquina adota com a chave dela
    // (mesmo id — o contrato que a tela 2 orienta) e os servicos seguem
    // vazios (falta a tela 3).
    var reserved = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"aguardando-maquina\"}", token)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(reserved)), "deviceId")
    var adopted = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"chave-real-da-maquina\"}", token)
    need(statusOf(adopted) == 200, "falhou")
    need(mapField(json.decode<Map<String, String>>(bodyOf(adopted)), "deviceId") == deviceId, "falhou")
    need(bodyOf(httpGetToken(controlPort, "/v1/services", token)) == "[]", "falhou")

    // Tela 3: primeiro servico publicado; a listagem muda e a derivacao
    // chega ao fim do fluxo.
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    need(statusOf(httpPostJson(controlPort, "/v1/services", pubBody, token)) == 200, "falhou")
    need(bodyOf(httpGetToken(controlPort, "/v1/services", token)).indexOf("\"name\":\"site\"") >= 0, "falhou")

    // Diagnostico embutido das telas: as camadas que ele confirma pela API.
    need(statusOf(httpGetToken(controlPort, "/v1/presence", token)) == 200, "falhou")
    need(statusOf(httpGetToken(controlPort, "/v1/audit/verify", token)) == 200, "falhou")

    // E a pagina servida traz o fluxo (botao + div).
    var page = httpGetRaw(controlPort, "/panel", "127.0.0.1")
    need(bodyOf(page).indexOf("id=\"fluxo\"") >= 0, "falhou")
}

test "painel: webhook gerenciavel pela pagina (mesma rota do CLI)", "panel-actions-unit" {
    // O webhook (F17 s3) era o unico recurso da conta sem formulario na
    // pagina — a F12 s2 promete "gestao completa" pelas mesmas rotas /v1 da
    // CLI, entao a secao chama POST /v1/webhook com action (igual ao
    // `webhook set/show/remove/test`). Mesmas regras do painel: mostra so a
    // URL e o prefixo do segredo (secretHint — o valor nunca volta pela
    // API), o digitado viaja no POST e sai do campo depois de configurar,
    // nada persistido. Conta sem webhook: a rota devolve 404 por desenho,
    // entao o carregamento vira "sem webhook" — nunca erro que impediria
    // as listas (carrega separado do Carregar).
    var html = panelHtml()
    need(html.indexOf("id=\"wb\"") >= 0, "falhou")
    need(html.indexOf("id=\"wburl\"") >= 0, "falhou")
    need(html.indexOf("id=\"wbsecret\"") >= 0, "falhou")
    need(html.indexOf("webhookAcao('set')") >= 0, "falhou")
    need(html.indexOf("webhookAcao('test')") >= 0, "falhou")
    need(html.indexOf("webhookAcao('remove')") >= 0, "falhou")
    need(html.indexOf("/v1/webhook") >= 0, "falhou")
    need(html.indexOf("{action: 'show'}") >= 0, "falhou")
    need(html.indexOf("webhookCarregar();") >= 0, "falhou")
    need(html.indexOf("webhookMostrar(null); }") >= 0, "falhou")
    need(html.indexOf("w.secretHint") >= 0, "falhou")
    need(html.indexOf("informe a URL e o segredo") >= 0, "falhou")
    need(html.indexOf("minimo 16") >= 0, "falhou")
    need(html.indexOf("confirm('Remover o webhook?") >= 0, "falhou")
    need(html.indexOf("wbsecret').value = ''") >= 0, "falhou")
    // Regras do painel preservadas: nenhum segredo renderizado, nada
    // gravado, vocabulario velho fora.
    need(html.indexOf("kfc_") < 0, "falhou")
    need(html.indexOf("localStorage") < 0, "falhou")
}

test "painel: webhook funciona pelas rotas que o botao chama", "panel-actions" {
    // O painel chama POST /v1/webhook (set/show/remove/test) com o token da
    // aba. O e2e prova o contrato no estado que a pagina renderiza: show sem
    // nada = 404 (o que vira "sem webhook" na secao), segredo curto = 400,
    // set guarda e devolve so o prefixo, show le, test entrega de verdade
    // num receptor (corpo + assinatura), remove volta ao 404.
    var hookPort = 19980
    var controlPort = 19981
    var received = listOf<String>()
    var receivedSig = listOf<String>()
    var hook = web.app()
    hook.post("/hook") {
        received.add(body())
        var sig = header("x-kofcloud-signature")
        if (sig == null) {
            sig = "(nenhuma)"
        }
        receivedSig.add(sig)
        return "ok"
    }
    var receiverTask = spawn { hook.listen(hookPort) }
    need(waitForPort(hookPort, 60), "falhou")

    var registry = Registry("/tmp/kofcloud-pa9-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    control.enablePanel()
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")

    var vazio = httpPostJson(controlPort, "/v1/webhook", "{\"action\":\"show\"}", token)
    need(statusOf(vazio) == 404, "falhou")
    need(bodyOf(vazio).indexOf("KCF130") >= 0, "falhou")

    var curto = httpPostJson(controlPort, "/v1/webhook", "{\"action\":\"set\",\"url\":\"http://127.0.0.1:" + intToString(hookPort) + "/hook\",\"secret\":\"curto\"}", token)
    need(statusOf(curto) == 400, "falhou")
    need(bodyOf(curto).indexOf("KCF129") >= 0, "falhou")

    var secreto = "segredo-do-painel-123"
    var configurado = httpPostJson(controlPort, "/v1/webhook", "{\"action\":\"set\",\"url\":\"http://127.0.0.1:" + intToString(hookPort) + "/hook\",\"secret\":\"" + secreto + "\"}", token)
    need(statusOf(configurado) == 200, "falhou")
    var mostrado = bodyOf(configurado)
    need(mostrado.indexOf(secreto) < 0, "falhou")
    assert(mostrado.indexOf("\"secretHint\":\"segr") >= 0, "so o prefixo")

    var lido = httpPostJson(controlPort, "/v1/webhook", "{\"action\":\"show\"}", token)
    need(statusOf(lido) == 200, "falhou")
    need(bodyOf(lido).indexOf("127.0.0.1:" + intToString(hookPort)) >= 0, "falhou")

    var teste = httpPostJson(controlPort, "/v1/webhook", "{\"action\":\"test\"}", token)
    need(statusOf(teste) == 200, "falhou")
    var attempts = 60
    while (attempts > 0 && received.size == 0) {
        time.sleep(250)
        attempts = attempts - 1
    }
    need(received.size == 1, "falhou")
    if (received.size == 1) {
        need(received.get(0).indexOf("webhook_test") >= 0, "falhou")
        need(receivedSig.get(0).indexOf("sha256=") == 0, "falhou")
    }

    var removido = httpPostJson(controlPort, "/v1/webhook", "{\"action\":\"remove\"}", token)
    need(statusOf(removido) == 200, "falhou")
    var depois = httpPostJson(controlPort, "/v1/webhook", "{\"action\":\"show\"}", token)
    need(statusOf(depois) == 404, "falhou")

    var page = httpGetRaw(controlPort, "/panel", "127.0.0.1")
    need(bodyOf(page).indexOf("id=\"wb\"") >= 0, "falhou")
    need(bodyOf(page).indexOf("/v1/webhook") >= 0, "falhou")
}

test "painel: diagnostico tem a camada de higiene de kfs_ (HTML + e2e)", "panel-hygiene" {
    // Medido: o diagnostico do painel cobria 5 camadas (credencial da conta,
    // dispositivo, tunel, auditoria, servico suspenso) mas nao a HIGIENE de
    // kfs_ — credenciais validas sem expiracao, o mesmo sinal que o
    // `service tokens` da CLI acusa via `/v1/services/token-hygiene`.
    var port = 19880
    var registry = Registry("/tmp/kofcloud-panelhig-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, port, "127.0.0.1", 0)
    control.enablePanel()
    var server = spawn { control.start() }
    need(waitForPort(port, 60), "falhou")

    // A pagina anuncia a camada (o texto da secao Diagnostico).
    var page = httpGetRaw(port, "/panel", "127.0.0.1")
    need(statusOf(page) == 200, "falhou")
    need(bodyOf(page).indexOf("higiene de kfs_") >= 0, "falhou")

    // e2e: conta com kfs_ SEM TTL — o hygiene endpoint acusa e o painel tem
    // a rota que o alimenta.
    var created = httpPostJson(port, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var dev = httpPostJson(port, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", token)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(dev)), "deviceId")
    var pub = httpPostJson(port, "/v1/services", "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}", token)
    var serviceId = mapField(json.decode<Map<String, String>>(bodyOf(pub)), "id")
    need(statusOf(httpPostJson(port, "/v1/services/token", "{\"serviceId\":\"" + serviceId + "\"}", token)) == 200, "falhou")

    var hyg = httpPostJson(port, "/v1/services/token-hygiene", "{}", token)
    need(statusOf(hyg) == 200, "falhou")
    var hygBody = json.decode<Map<String, String>>(bodyOf(hyg))
    need(mapField(hygBody, "count") == "1", "falhou")

    // Rotacionar com TTL emite a nova com prazo, mas a ANTIGA sem TTL
    // continua valida (overlap sem downtime; revogacao de credencial sem
    // expiracao nunca e silenciosa) — a higiene segue acusando a antiga,
    // que so sai com revoke explicito. Prova do comportamento real, nao de
    // um "limpa apos rotate" que violaria o desenho.
    need(statusOf(httpPostJson(port, "/v1/services/rotate", "{\"serviceId\":\"" + serviceId + "\",\"ttlHours\":\"24\"}", token)) == 200, "falhou")
    var hyg2 = httpPostJson(port, "/v1/services/token-hygiene", "{}", token)
    need(mapField(json.decode<Map<String, String>>(bodyOf(hyg2)), "count") == "1", "falhou")
}

test "painel: contencao (freeze/unfreeze) pelas rotas que o botao chama", "panel-freeze" {
    // F12 s2: o freeze (F17 s2) so existia no terminal — o painel de gestao
    // completa prometia "tudo pelo painel". A secao Contencao chama as
    // MESMAS rotas `/v1/freeze` e `/v1/unfreeze` da CLI (nenhum endpoint
    // novo privilegiado), com confirm() no freeze (destroi credenciais).
    var port = 19884
    var registry = Registry("/tmp/kofcloud-panelfrz-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, port, "127.0.0.1", 0)
    control.enablePanel()
    var server = spawn { control.start() }
    need(waitForPort(port, 60), "falhou")

    // A pagina expoe a secao e as duas rotas (a trava do rodape ja exige
    // as duas na fonte; aqui o texto do contrato).
    var page = httpGetRaw(port, "/panel", "127.0.0.1")
    need(statusOf(page) == 200, "falhou")
    need(bodyOf(page).indexOf("Contencao") >= 0, "falhou")
    need(bodyOf(page).indexOf("Congelar (contencao)") >= 0, "falhou")
    need(bodyOf(page).indexOf("Descongelar") >= 0, "falhou")

    // Cenario real: conta + device + servico AUTHENTICATED com kfs_.
    var created = httpPostJson(port, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var dev = httpPostJson(port, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", token)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(dev)), "deviceId")
    var pub = httpPostJson(port, "/v1/services", "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"AUTHENTICATED\"}", token)
    var serviceId = mapField(json.decode<Map<String, String>>(bodyOf(pub)), "id")
    need(statusOf(httpPostJson(port, "/v1/services/token", "{\"serviceId\":\"" + serviceId + "\"}", token)) == 200, "falhou")

    // freeze pela MESMA rota que o botao chama: 200 com incidente.
    var frz = httpPostJson(port, "/v1/freeze", "{\"target\":\"service\",\"id\":\"" + serviceId + "\"}", token)
    need(statusOf(frz) == 200, "falhou")
    var frzBody = json.decode<Map<String, String>>(bodyOf(frz))
    need(mapField(frzBody, "frozen") == "1", "falhou")
    var incidentId = mapField(frzBody, "incidentId")
    need(incidentId.length > 0, "falhou")
    // O freeze REVOGOU as credenciais vivas (prova do perigo que o confirm()
    // avisa): a kfs_ emitida antes nao autentica mais o Edge — aqui, o
    // inventario do servico vem vazio de credenciais validas.
    var list = httpPostJson(port, "/v1/services/tokens", "{\"serviceId\":\"" + serviceId + "\"}", token)
    need(statusOf(list) == 200, "falhou")
    need(bodyOf(list) == "[]", "falhou")
    // O servico ficou SUSPENSO (fora da rota).
    var services = httpGetToken(port, "/v1/services", token)
    need(bodyOf(services).indexOf("SUSPENDED") >= 0, "falhou")

    // unfreeze restaura o status anterior (sem tocar config) — a kfs_ nao
    // volta (o confirm() avisou; quem emite de novo e o service rotate).
    var unf = httpPostJson(port, "/v1/unfreeze", "{\"target\":\"service\",\"id\":\"" + serviceId + "\"}", token)
    need(statusOf(unf) == 200, "falhou")
    var unfBody = json.decode<Map<String, String>>(bodyOf(unf))
    need(mapField(unfBody, "restored") == "1", "falhou")
    var services2 = httpGetToken(port, "/v1/services", token)
    need(bodyOf(services2).indexOf("SUSPENDED") < 0, "falhou")

    // Idempotencia do unfreeze: segundo unfreeze e 409 (nada a reverter).
    var unf2 = httpPostJson(port, "/v1/unfreeze", "{\"target\":\"service\",\"id\":\"" + serviceId + "\"}", token)
    need(statusOf(unf2) == 409, "falhou")

    // O incidente do freeze ficou registrado na conta (mesma API do CLI).
    var incidents = httpPostJson(port, "/v1/incidents", "{}", token)
    need(bodyOf(incidents).indexOf(incidentId) >= 0, "falhou")
}

test "painel: alvo inexistente e recusado antes de chamar a API", "panel-gate" {
    // Medido na leitura do JS: os botoes de suspender/reativar/remover/
    // emitir/revogar mandavam `id: idPorNome(...)`, que e "" quando o nome
    // digitado nao bate com a lista — o control plane respondia 404/500 com
    // corpo opaco e o operador nao sabia qual campo estava errado.
    var names = listOf("site", "api")
    if (!(panelTargetName(names, "site") == "site")) { assert(false, "A1") }
    if (!(panelTargetName(names, " site ") == "site")) { assert(false, "A2") }
    if (!(panelTargetName(names, "Site") == "")) { assert(false, "A3") }
    if (!(panelTargetName(names, "") == "")) { assert(false, "A4") }
    if (!(panelTargetName(names, "nao-existe") == "")) { assert(false, "A5") }
    if (!(panelTargetName(listOf<String>(), "site") == "")) { assert(false, "A6") }
    var msg = panelTargetRefusal("nome do servico", "suspender")
    if (!(msg.indexOf("nome do servico") >= 0)) { assert(false, "A7") }
    if (!(msg.indexOf("suspender") >= 0)) { assert(false, "A8") }
    if (!(msg.indexOf("lista acima") >= 0)) { assert(false, "A9") }
    // Trava de fonte: cada acao que resolve id por nome consulta antes.
    var html = panelHtml()
    var gated = 0
    for (var needle in listOf("alvoAusente('nome do servico'", "alvoAusente('nome do dispositivo'")) {
        var cursor = html.indexOf(needle)
        while (cursor >= 0) {
            gated = gated + 1
            cursor = html.indexOf(needle, cursor + 1)
        }
    }
    // 5 chamadas de recusa: servico (suspender/reativar, emitir, remover,
    // revogar) x4 + dispositivo x1.
    if (gated < 5) { assert(false, "A10") }
    if (!(html.indexOf("function alvoAusente(") >= 0)) { assert(false, "A11") }
}
