import kofcloud.cli.Commands
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.model.Errors
import kofcloud.store.Store
import kofcloud.util.Limits
import testkit.Support

// Forca bruta de senha no login (Fase 5).
//
// O Edge limite requisições por hostname, mas o LOGIN acontece no control
// plane, que nao tinha teto nenhum: uma senha podia ser testada sem limite por
// quem alcanca o control. Agora o teto e por HANDLE na janela — a chave que
// protege a conta (o control plane nao ve o IP de origem em `web.app()`), e o
// atacante que dirige o ataque a uma conta e contido.

String loginLimitPath(String name) {
    return "/tmp/kofcloud-loginlim-" + name + "-" + crypto.randomHex(4) + ".json"
}

test "login limit: fonte unica, codigo e Hint", "loginlimit-unit" {
    need(limitLoginAttempts() > 0, "falhou")
    need(limitLoginWindowMs() > 0, "falhou")
    need(errLoginRateLimited().indexOf("KCF134") >= 0, "falhou")
    need(errHint(errLoginRateLimited()).indexOf("loginWindowMs") >= 0, "falhou")

    var registry = Registry(loginLimitPath("unit"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")

    // Dentro do teto: libera.
    var blocked = false
    var i = 0
    while (i < limitLoginAttempts()) {
        blocked = registry.loginAttemptBlocked("mel")
        i = i + 1
    }
    need(blocked == false, "falhou")

    // Uma a mais: bloqueia.
    need(registry.loginAttemptBlocked("mel") == true, "falhou")
    // Handles sao independentes.
    need(registry.loginAttemptBlocked("ana") == false, "falhou")
    // Handle e normalizado (caixa e padding nao abrem uma janela nova).
    need(registry.loginAttemptBlocked("  MEL  ") == true, "falhou")
    // Handle vazio nunca bloqueia (nao ha conta a proteger).
    need(registry.loginAttemptBlocked("") == false, "falhou")

    // Um ACERTO reseta a janela.
    registry.loginAttemptReset("mel")
    need(registry.loginAttemptBlocked("mel") == false, "falhou")
    need(blocked == false, "falhou")

    // A CLI reconhece o teto (pura): a falha limitada sobe intacta e o
    // cadastro implicito nao vira burleta nem mascara como senha invalida.
    need(loginRateLimited(errLoginRateLimited()), "falhou")
    need(loginRateLimited("KCF134: too many login attempts"), "falhou")
    need(loginRateLimited(errInvalidCredentials()) == false, "falhou")
    need(loginRateLimited(errHandleTaken()) == false, "falhou")
    need(loginRateLimited("") == false, "falhou")
}

test "login limit: senha errada repetida vira 429 KCF134; acerto limpa", "loginlimit" {
    // Teto baixo para o teste (config do processo nao muda aqui).
    var controlPort = 20171
    var registry = Registry(loginLimitPath("http"))
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    need(statusOf(created) == 200, "falhou")

    // O default e 10 tentativas: as 10 primeiras com senha errada dao 401.
    var i = 0
    var lastCode = 0
    while (i < limitLoginAttempts()) {
        var r = httpPostJson(controlPort, "/v1/login", "{\"handle\":\"mel\",\"password\":\"errada\"}", "")
        lastCode = statusOf(r)
        i = i + 1
    }
    need(lastCode == 401, "falhou")

    // A proxima e 429 antes de conferir a senha — e ATE a senha certa leva
    // 429 enquanto a janela nao zera (o ataque fica contido, nao muda com a
    // senha certa chegando no meio).
    var limited = httpPostJson(controlPort, "/v1/login", "{\"handle\":\"mel\",\"password\":\"segredo\"}", "")
    need(statusOf(limited) == 429, "falhou")
    need(bodyOf(limited).indexOf("KCF134") >= 0, "falhou")
    need(bodyOf(limited).indexOf("retryAfterSec") >= 0, "falhou")

    // Outra conta nao foi afetada.
    httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"ana\",\"email\":\"a@e.com\",\"password\":\"segredo\"}", "")
    var ana = httpPostJson(controlPort, "/v1/login", "{\"handle\":\"ana\",\"password\":\"segredo\"}", "")
    need(statusOf(ana) == 200, "falhou")

    // Reset manual (equivalente ao acerto): a conta volta a entrar.
    registry.loginAttemptReset("mel")
    var back = httpPostJson(controlPort, "/v1/login", "{\"handle\":\"mel\",\"password\":\"segredo\"}", "")
    need(statusOf(back) == 200, "falhou")
}

test "login limit: o cadastro implicito nao burla o teto do handle", "loginlimit-cli" {
    // O CLI entra pelo `loginOrCreate`: tenta entrar e, se o login FALHAR,
    // cai no cadastro implicito. Com o handle sob ataque, o login volta 429
    // KCF134 — e o fallback do cadastro RESPONDIA: ou criava a conta do
    // handle bloqueado (burlando o teto do abuse prevention) ou devolvia
    // "credencial invalida" (KCF003) para quem so precisa esperar a janela.
    var controlPort = 20172
    var registry = Registry(loginLimitPath("cli"))
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")
    var url = "http://127.0.0.1:" + intToString(controlPort)

    // Handle que EXISTE, com a janela esgotada: o erro honesto (KCF134)
    // precisa chegar ao operador, nao "senha invalida".
    httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var i = 0
    while (i <= limitLoginAttempts()) {
        registry.loginAttemptBlocked("mel")
        i = i + 1
    }
    var blocked = ""
    try {
        loginOrCreate(url, "mel", "segredo")
    } catch (String e) {
        blocked = e
    }
    need(blocked.indexOf("KCF134") >= 0, "falhou")
    need(blocked.indexOf("KCF003") < 0, "falhou")

    // Handle NOVO, com a janela esgotada: o cadastro implicito nao pode
    // criar a conta — o teto do abuse prevention vale para a CLI tambem.
    var j = 0
    while (j <= limitLoginAttempts()) {
        registry.loginAttemptBlocked("ana")
        j = j + 1
    }
    var blockedNew = ""
    try {
        loginOrCreate(url, "ana", "segredo2")
    } catch (String e) {
        blockedNew = e
    }
    need(blockedNew.indexOf("KCF134") >= 0, "falhou")
    need(registry.accountByHandle("ana") == null, "falhou")
}