import kofcloud.cli.Commands
import kofcloud.cli.Local
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.model.Errors
import kofcloud.model.Webhook
import kofcloud.store.Store
import kofcloud.protocol.Bytes
import testkit.Support

// Fase 17 slice 3 — webhook de incidentes com assinatura HMAC-SHA256.
//
// POR QUE HMAC E NAO Ed25519 (que o plano pedia): medido — o stdlib so tem a
// face Ed25519 de `crypto.sign`, e `keyExchange.privateKey("ed25519")` falha
// com SECN014 ("unknown signing algorithm ed25519"); nao ha como gerar o par.
// HMAC-SHA256 e o padrao de fato de webhooks e existe em todos os alvos.

String webhookPath(String name) {
    return "/tmp/kofcloud-wh-" + name + "-" + crypto.randomHex(4) + ".json"
}

test "webhook: URL e segredo validados (puros)", "webhook-unit" {
    assert(webhookUrlError("https://example.com/hook") == "", "https ok")
    assert(webhookUrlError("https://example.com:8443/hook") == "", "porta ok")
    assert(webhookUrlError("http://127.0.0.1:9999/hook") == "", "http loopback ok")
    assert(webhookUrlError("http://example.com/hook") != "", "http externo recusado")
    assert(webhookUrlError("ftp://example.com/hook") != "", "esquema recusado")
    assert(webhookUrlError("https://user:pass@example.com/hook") != "", "credencial na URL recusada")
    assert(webhookUrlError("https://") != "", "sem host recusado")
    assert(webhookUrlError("https://example.com:99999/x") != "", "porta invalida")
    // Estouro de Int: `parseIntSafe("4294968080")` devolve 784 (passaria como
    // porta valida); `parseIntSafe("4294967296")` devolve 0 (passaria pelo
    // guard `<= 0`... e voltaria como "sem porta"). `parsePortSafe` recusa.
    assert(webhookUrlError("https://example.com:4294968080/x") != "", "acima de 2^32 recusada")
    assert(webhookUrlError("https://example.com:4294967296/x") != "", "2^32 exato recusada")
    assert(webhookUrlError("https://example.com:0/x") != "", "porta zero recusada")
    assert(webhookUrlError("https://example.com:abc/x") != "", "porta nao numerica recusada")
    assert(webhookUrlError("https://example.com:65535/x") == "", "teto valido ainda passa")
    assert(webhookUrlError("") != "", "vazio recusado")
    assert(webhookSecretError("curto") != "", "segredo curto recusado")
    assert(webhookSecretError("0123456789abcdef") == "", "16 chars ok")
}

test "webhook: assinatura HMAC verificavel e sensivel ao payload", "webhook-unit" {
    var secret = "0123456789abcdef"
    var payload = webhookPayload("bulk_device_revokes", "CRIT", "resumo", 1700000000000)
    var header = webhookSignatureHeader(secret, payload)
    assert(header.startsWith("sha256="), "formato padrao")
    assert(header.length == 7 + 64, "hex de 32 bytes")
    // O receptor recalcula e confere em tempo constante.
    var recomputed = webhookSignatureHeader(secret, payload)
    assert(webhookSignatureValid(secret, payload, header, recomputed), "assinatura confere")
    // Payload adulterado nao confere; segredo errado tambem nao.
    var tampered = webhookSignatureHeader(secret, payload + " ")
    assert(webhookSignatureValid(secret, payload, header, tampered) == false, "payload adulterado falha")
    var wrongSecret = webhookSignatureHeader("ffffffffffffffff", payload)
    assert(webhookSignatureValid(secret, payload, header, wrongSecret) == false, "segredo errado falha")
    // Determinismo.
    assert(webhookSignature(secret, payload) == webhookSignature(secret, payload), "deterministica")
}

test "webhook: payload nao carrega dado sensivel", "webhook-unit" {
    var payload = webhookPayload("freeze_device", "WARN", "device frozen", 1)
    assert(payload.indexOf("kfc_") < 0, "sem token")
    assert(payload.indexOf("kfs_") < 0, "sem credencial de servico")
    var parsed = json.decode<Map<String, String>>(payload)
    assert(parsed.get("event") != null, "event presente")
}

test "webhook: cadastro, leitura sem segredo e remocao", "webhook-unit" {
    var registry = Registry(webhookPath("crud"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    registry.setWebhook(account.id, "https://example.com/hook", "0123456789abcdef")
    var config = registry.webhookForAccount(account.id)
    assert(config != null, "configurado")
    if (config != null) {
        assert(config.url == "https://example.com/hook", "url")
        assert(config.secret == "0123456789abcdef", "segredo guardado (para o receptor comparar)")
    }
    // Invalidos nao gravam.
    var blocked = false
    try {
        registry.setWebhook(account.id, "http://externo.com/h", "0123456789abcdef")
    } catch (String e) {
        blocked = true
    }
    assert(blocked, "url invalida recusada")
    assert(registry.removeWebhook(account.id), "removeu")
    assert(registry.removeWebhook(account.id) == false, "remover de novo falha")
}

test "webhook: incidente da conta dispara entrega assinada de verdade", "webhook" {
    var hookPort = 19901
    var controlPort = 19902

    // Receptor HTTP que guarda corpo e assinatura recebidos (web.app: quem
    // entrega e o http.post do Kof, entao o receptor precisa ser um servidor
    // real — socket cru exigiria fechar a resposta na mao).
    var received = listOf<String>()
    var receivedSig = listOf<String>()
    var hook = web.app()
    hook.post("/hook") {
        received.add(body())
        var sig = header("x-kofcloud-signature")
        if (sig == null) {
            sig = "(nenhuma)"
        }
        receivedSig.add(sig)
        return "ok"
    }
    var receiverTask = spawn { hook.listen(hookPort) }
    assert(waitForPort(hookPort, 60), "receptor no ar")

    var registry = Registry(webhookPath("e2e"))
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var mel = registry.accountByHandle("mel")
    var melId = ""
    if (mel != null) {
        melId = mel.id
    }
    var secret = "segredo-de-teste-123"
    var setBody = "{\"action\":\"set\",\"url\":\"http://127.0.0.1:" + intToString(hookPort) + "/hook\",\"secret\":\"" + secret + "\"}"
    var setResult = httpPostJson(controlPort, "/v1/webhook", setBody, token)
    assert(statusOf(setResult) == 200, "cadastrou via API")
    assert(bodyOf(setResult).indexOf(secret) < 0, "API NAO devolve o segredo")

    // Um incidente da conta abre -> entrega assinada.
    registry.raiseIncident("bulk_device_revokes", melId)
    var attempts = 60
    while (attempts > 0 && received.size == 0) {
        time.sleep(50)
        attempts = attempts - 1
    }
    assert(received.size == 1, "recebeu uma entrega")
    if (received.size == 1) {
        var payload = received.get(0)
        assert(payload.indexOf("bulk_device_revokes") >= 0, "payload tem o sinal")
        assert(payload.indexOf("kfc_") < 0, "payload sem token")
        // A assinatura bate com o segredo compartilhado.
        var expected = webhookSignatureHeader(secret, payload)
        assert(receivedSig.get(0) == expected, "assinatura verificada pelo receptor")
    }

    // Incidente GLOBAL nao entrega a webhook de conta.
    registry.raiseIncident("edge_refusals", "")
    time.sleep(400)
    assert(received.size == 1, "global nao entrega em webhook de conta")

    // `test` entrega de proposito.
    var testResult = httpPostJson(controlPort, "/v1/webhook", "{\"action\":\"test\"}", token)
    assert(statusOf(testResult) == 200, "teste ok")
    assert(bodyOf(testResult).indexOf("\"delivered\":\"200\"") >= 0, "entrega de teste")

    hook.close()
}

test "webhook: posicional sobrando e --secret defeituoso barram na CLI", "webhook-guard" {
    // Puro na decisao (locals no uso, sem tocar a rede quando a guarda
    // barra): `webhook show lixo` / `remove lixo` / `test lixo` executariam
    // a acao ignorando o argumento (medido: remove lixo apagava o webhook
    // da conta). `set` com URL repetida configura errado; `--secret` solto
    // ou repetido publica com o segredo errado ou vazio em silencio.
    var controlPort = 19903
    var registry = Registry("/tmp/kofcloud-whg-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control no ar")

    var url = "http://127.0.0.1:" + intToString(controlPort)
    var token = loginOrCreate(url, "mel", "segredo")

    var priorSession = readTextOr(sessionPath(), "")
    saveSession(LocalSession("", "mel", token, url))

    // show/remove/test com argumento sobrando barram antes da rede.
    assert(cmdWebhook(listOf("show", "lixo")) == 1, "show com sobra barra")
    assert(cmdWebhook(listOf("remove", "lixo")) == 1, "remove com sobra barra")
    assert(cmdWebhook(listOf("test", "lixo")) == 1, "test com sobra barra")
    // set exige URL unica e --secret com valor unico.
    assert(cmdWebhook(listOf("set", "https://example.com/a", "https://example.com/b", "--secret", "0123456789abcdef")) == 1, "set com duas urls barra")
    assert(cmdWebhook(listOf("set", "https://example.com/a", "--secret")) == 1, "--secret solto barra")
    assert(cmdWebhook(listOf("set", "https://example.com/a", "--secret", "s1aaaaaaaaaaaaaa", "--secret", "s2aaaaaaaaaaaaaa")) == 1, "--secret repetido barra")
    // Comandos limpos passam do uso (executam contra o control plane).
    // Cadastra primeiro para que o show encontre o registro.
    assert(cmdWebhook(listOf("set", "https://example.com/a", "--secret", "0123456789abcdef")) == 0, "set limpo passa da guarda")
    assert(cmdWebhook(listOf("show")) == 0, "show limpo passa da guarda")

    if (priorSession.length == 0) {
        File(sessionPath()).delete()
    } else {
        writeTextTo(sessionPath(), priorSession)
    }
}

test "device: posicional sobrando barra antes de revogar/suspender", "device-guard" {
    // Puro na decisao: `device revoke dev1 dev2` revogava dev1 e descartava
    // dev2 (comando destrutivo ignorando argumento). O mesmo vale para
    // suspend/unsuspend. Precedente: unpublish/status/token ja barram.
    var controlPort = 19904
    var registry = Registry("/tmp/kofcloud-dg-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control no ar")

    var url = "http://127.0.0.1:" + intToString(controlPort)
    var token = loginOrCreate(url, "mel", "segredo")
    var devId = registerDevice(url, token, "notebook", "pk")

    var priorSession = readTextOr(sessionPath(), "")
    saveSession(LocalSession("", "mel", token, url))

    // Duplo posicional barra no uso (exit 1) e NAO executa a acao: sem a
    // guarda o comando ignorava "outro" e revogava/suspendia "notebook" (exit 0).
    assert(cmdDeviceRevoke(listOf("notebook", "outro")) == 1, "revoke com sobra barra")
    var devAfter = registry.deviceById(devId)
    assert(devAfter != null, "device nao foi revogado pelo comando com sobra")
    assert(cmdDeviceSuspend(listOf("notebook", "outro")) == 1, "suspend com sobra barra")
    assert(cmdDeviceUnsuspend(listOf("notebook", "outro")) == 1, "unsuspend com sobra barra")
    // Sem sobra, o comando limpo revoga de verdade (exit 0).
    assert(cmdDeviceRevoke(listOf("notebook")) == 0, "revoke limpo executa")
    // Sem posicional continua pedindo uso.
    assert(cmdDeviceRevoke(listOf<String>()) == 1, "revoke vazio pede uso")
    assert(cmdDeviceSuspend(listOf<String>()) == 1, "suspend vazio pede uso")
    assert(cmdDeviceUnsuspend(listOf<String>()) == 1, "unsuspend vazio pede uso")

    if (priorSession.length == 0) {
        File(sessionPath()).delete()
    } else {
        writeTextTo(sessionPath(), priorSession)
    }
}
test "webhook: host interno e SSRF barrado (literal e resolvido)", "webhook-ssrf" {
    // O POST do webhook sai do processo do control plane com o header de
    // assinatura. Um webhook apontado para 169.254.169.254 (metadata de
    // nuvem) ou para a rede privada do operador deixava a conta disparar
    // requests forjados para dentro — SSRF. Antes so http:// era confinado
    // ao loopback; https:// aceitava QUALQUER host, inclusive interno.
    var internal = listOf(
        "https://169.254.169.254/latest/meta-data",
        "https://10.0.0.5/hook",
        "https://172.16.3.4/hook",
        "https://192.168.1.10/hook",
        "https://0.0.0.0/hook",
        "https://metadata.internal.local/hook",
        "https://fe80::1/hook"
    )
    for (var url in internal) {
        assert(webhookUrlError(url) != "" || webhookHostIsInternal(webhookUrlHost(url)), "interno barrado: " + url)
    }

    // LOOPBACK fica de proposito fora do guard: o receptor de dev
    // documentado e `http://127.0.0.1` (o http:// so aceita loopback), e o
    // metadata service de nuvem nao escuta em loopback — recusa-lo quebraria
    // o fluxo de teste sem fechar buraco real.
    assert(webhookHostIsInternal("127.0.0.1") == false, "loopback nao e interno (receptor de dev)")
    assert(webhookHostIsInternal("localhost") == false, "localhost idem")

    // O predicado, direto: publicos nao sao internos.
    assert(webhookHostIsInternal("example.com") == false, "publico")
    assert(webhookHostIsInternal("hooks.example.com") == false, "subdominio publico")
    assert(webhookHostIsInternal("8.8.8.8") == false, "ip publico")
    assert(webhookHostIsInternal("172.32.0.1") == false, "fora de 172.16/12")
    assert(webhookHostIsInternal("192.169.1.1") == false, "fora de 192.168/16")
    assert(webhookHostIsInternal("172.15.0.1") == false, "fora de 172.16/12 por baixo")

    // DNS: host publico que resolve para interno e barrado; falha de DNS
    // nao recusa (o IP literal continua guardado pela checagem direta).
    assert(webhookDnsError("rebind.example.com", listOf("169.254.169.254")) != "", "rebind barrado")
    assert(webhookDnsError("rebind.example.com", listOf("10.1.2.3")) != "", "privado resolvido barrado")
    assert(webhookDnsError("hooks.example.com", listOf("93.184.216.34")) == "", "publico passa")
    assert(webhookDnsError("hooks.example.com", listOf<String>()) == "", "DNS vazio nao recusa")

    // Fim a fim: set com host interno e recusado com o erro estavel e nada
    // e gravado; set com host publico (DNS externo indisponivel aqui) segue.
    var port = 19877
    var registry = Registry(webhookPath("ssrf"))
    var control = ControlPlane(registry, port, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(port, 60), "control no ar")
    var created = httpPostJson(port, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")

    var bad = httpPostJson(port, "/v1/webhook", "{\"action\":\"set\",\"url\":\"https://169.254.169.254/latest\",\"secret\":\"segredo-longo-suficiente\"}", token)
    assert(statusOf(bad) == 400, "interno -> 400: " + intToString(statusOf(bad)))
    assert(bodyOf(bad).indexOf("internal address") >= 0, "nomeia a causa")
    var mel = registry.accountByHandle("mel")
    var melId = ""
    if (mel != null) {
        melId = mel.id
    }
    assert(registry.webhookForAccount(melId) == null, "nada gravado")
}
