import kofcloud.cli.Commands
import kofcloud.cli.Usage
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.store.Store
import kofcloud.util.Limits
import kofcloud.util.Text
import testkit.Support

// F18 s5 — segredos de fonte externa (F18 s5 parcial): o `serve` le o tunnel
// secret e os PEMs de um ARQUIVO ou de um COMANDO (qualquer provedor: Vault,
// AWS SM, 1Password expõem um CLI — a plataforma fala o protocolo aberto do
// shell, nunca SDK). Lido na PARTIDA, so em memoria, nunca impresso nem
// gravado; rotacionar = reiniciar o serve (SIGHUP nao existe, L3).
//
// Prova em dois niveis: (1) as decisoes puras (qual fonte, combinacao
// invalida, leitura) e (2) o caminho real de subir o control plane com os
// PEMs vindos de COMANDOS (o mesmo enableTls que o cmdServe chama).

test "segredos: leitura da fonte externa (comando e arquivo) com falha honesta", "secret-unit" {
    // Comando simples: valor vem do stdout (sem newline final: trim).
    var fromCmd = readSecretSource("", "", "printf 'abc123'", "tunnel secret")
    need(fromCmd == "abc123", "falhou")
    // Comando que falha: erro explicito, nunca valor.
    var failed = readSecretSource("", "", "exit 7", "tunnel secret")
    need(secretSourceFailed("tunnel secret", failed), "falhou")
    need(failed.indexOf("7") >= 0, "falhou")
    // Comando que devolve vazio: erro (nunca segredo vazio silencioso).
    var empty = readSecretSource("", "", "printf ''", "tunnel secret")
    need(secretSourceFailed("tunnel secret", empty), "falhou")
    // Arquivo existente: le e apara.
    var fpath = "/tmp/kofcloud-secret-src-" + crypto.randomHex(4) + ".txt"
    writeTextTo(fpath, "do-arquivo\n")
    var fromFile = readSecretSource("", fpath, "", "tunnel secret")
    need(fromFile == "do-arquivo", "falhou")
    // Arquivo ausente: erro.
    var missing = readSecretSource("", "/tmp/nao-existe-" + crypto.randomHex(4), "", "tunnel secret")
    need(secretSourceFailed("tunnel secret", missing), "falhou")
    // Inline (env/config) e o fallback quando nao ha arquivo nem comando.
    need(readSecretSource("inline", "", "", "tunnel secret") == "inline", "falhou")
    // Comando tem precedencia sobre arquivo/inline (o operador que passou o
    // comando mandou; mas o pre-check de "uma fonte" barra isso antes).
    need(readSecretSource("inline", fpath, "printf 'prio'", "tunnel secret") == "prio", "falhou")
}

test "segredos: combinacao de fontes e validada (nunca escolha silenciosa)", "secret-unit" {
    // Zero fontes: ok (segredo vazio = tunel em claro, comportamento atual).
    need(secretSourceError("", "", "", "tunnel secret") == "", "falhou")
    // Uma fonte: ok (as tres formas).
    need(secretSourceError("v", "", "", "tunnel secret") == "", "falhou")
    need(secretSourceError("", "/p", "", "tunnel secret") == "", "falhou")
    need(secretSourceError("", "", "cmd", "tunnel secret") == "", "falhou")
    // Duas fontes: erro posicional (qualquer par).
    need(secretSourceError("v", "/p", "", "tunnel secret").indexOf("UMA fonte") >= 0, "falhou")
    need(secretSourceError("v", "", "cmd", "tunnel secret").indexOf("UMA fonte") >= 0, "falhou")
    need(secretSourceError("", "/p", "cmd", "tunnel secret").indexOf("UMA fonte") >= 0, "falhou")
    // A mensagem nomeia a origem (label), nao o valor.
    var err = secretSourceError("segredo-secreto-aqui", "/p", "", "tunnel secret")
    need(err.indexOf("segredo-secreto-aqui") < 0, "falhou")
    // Label do banner: comando/arquivo/sem-fonte; o comando NUNCA e ecoado
    // inteiro (pode carregar token na linha).
    need(secretSourceLabel("", "vault kv get -field=x secret/y").indexOf("vault") < 0, "falhou")
    need(secretSourceLabel("", "cmd").indexOf("comando") >= 0, "falhou")
    need(secretSourceLabel("/etc/seg", "").indexOf("/etc/seg") >= 0, "falhou")
    need(secretSourceLabel("", "") == "", "falhou")
}

test "segredos: help anuncia as fontes externas do serve", "secret-usage" {
    var help = usageText()
    need(help.indexOf("--tunnel-secret-file <arq>") >= 0, "falhou")
    need(help.indexOf("--tunnel-secret-cmd <cmd>") >= 0, "falhou")
    need(help.indexOf("--tls-cert-cmd <cmd> --tls-key-cmd <cmd>") >= 0, "falhou")
}

test "segredos: control plane sobe HTTPS com os PEMs vindos de COMANDOS (F18 s5)", "secret-e2e" {
    trustLocalhostTls()
    // O mesmo enableTls que o cmdServe chama, mas alimentado por um COMANDO
    // (o cmdServe faz exatamente readSecretSource(cmd) -> enableTls): prova
    // que o caminho de segredo externo sobe o control plane cifrado.
    var dir = "/tmp/kofcloud-secret-e2e-" + crypto.randomHex(4)
    Directory(dir).createDirectories()
    var certPath = dir + "/cert.pem"
    var keyPath = dir + "/key.pem"
    var gen = process.run("openssl", "req", "-x509", "-newkey", "rsa:2048", "-keyout", keyPath, "-out", certPath, "-days", "1", "-nodes", "-subj", "/CN=localhost", "-addext", "subjectAltName=IP:127.0.0.1,DNS:localhost")
    if (gen.exitCode != 0) {
        need(true, "falhou")
        return
    }
    // Le os PEMs por COMANDO (cat), nunca por readTextOr: o mesmo ponto do cmdServe.
    var certCmd = "cat " + certPath
    var keyCmd = "cat " + keyPath
    var certPem = readSecretSource("", "", certCmd, "tls cert")
    var keyPem = readSecretSource("", "", keyCmd, "tls key")
    need(secretSourceFailed("tls cert", certPem) == false, "falhou")
    need(secretSourceFailed("tls key", keyPem) == false, "falhou")
    var port = 19895
    var registry = Registry("/tmp/kofcloud-secret-reg-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, port, "127.0.0.1", 0)
    control.enableTls(certPem, keyPem)
    var server = spawn { control.start() }
    need(waitForPort(port, 60), "falhou")
    var health = http.get("https://127.0.0.1:" + intToString(port) + "/v1/health")
    need(health.indexOf("ok") >= 0, "falhou")
    // Comando que falha: o cmdServe barra antes de subir (aqui a prova e o
    // helper devolver erro, nao um PEM vazio indo para o listenSecure).
    var badCert = readSecretSource("", "", "exit 1", "tls cert")
    need(secretSourceFailed("tls cert", badCert), "falhou")
}

test "segredos: o exec do comando e um so para tunnel secret e PEMs", "secret-unit" {
    // Fatoracao medida: o tunnel secret lia via readSecretSource(cmd) e os
    // PEMs via readSecretSource("", "", cmd) — dois caminhos para o mesmo
    // exec. Agora os tres passam por runSecretSource: mesmo contrato de
    // falha ("<label>: ..."), mesmo trim do newline final.
    need(runSecretSource("printf 'a456\n'", "tunnel secret") == "a456", "falhou")
    var failed = runSecretSource("exit 3", "tls key")
    need(secretSourceFailed("tls key", failed), "falhou")
    need(secretSourceFailed("tls cert", failed) == false, "falhou")
    need(runSecretSource("printf ''", "tls cert").indexOf("saida vazia") >= 0, "falhou")
    // O valor nunca entra na mensagem de erro.
    var leak = runSecretSource("echo segredo-x; exit 1", "tls cert")
    need(leak.indexOf("segredo-x") < 0, "falhou")
}

test "segredos: falha do tunnel-secret-cmd recusa o serve antes de subir (F18 s5)", "secret-e2e" {
    // Medido no cmdServe: a linha "tunnel secret: fonte comando (...)" era
    // anunciada e o comando so rodava DENTRO do spawn do tunel — um provedor
    // caido derrubava a task e o serve seguia anunciando a borda com a porta
    // muda. Agora a fonte e lida na partida: exit 1 e nenhuma porta no ar.
    // Prova que o comando RODA e falha (nao so que nada subiu): o comando
    // grava um marcador antes de sair 9.
    var marker = "/tmp/kofcloud-secret-ran-" + crypto.randomHex(4)
    var controlPort = 19992
    var code = cmdServe(listOf("--control-port", intToString(controlPort), "--tunnel-port", "19993", "--http-port", "19994", "--tunnel-secret-cmd", "printf ran > " + marker + "; exit 9", "--state", "/tmp/kofcloud-secret-fail-" + crypto.randomHex(4) + ".json"))
    need(readTextOr(marker, "") == "ran", "falhou")
    File(marker).delete()
    need(code == 1, "falhou")
    var controlUp = false
    try {
        var probe = net.connect("127.0.0.1", controlPort)
        probe.close()
        controlUp = true
    } catch (String e) {
    }
    need(controlUp == false, "falhou")
}
