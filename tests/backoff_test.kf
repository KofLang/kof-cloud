
import kofcloud.agent.Backoff
import kofcloud.util.Limits

test "backoff: cresce com tentativas e respeita o teto" {
    var base = 500
    var maxDelay = 30000
    var d0 = backoffDelay(0, base, maxDelay)
    assert(d0 >= 0, "nao negativo")
    assert(d0 <= base + base / 5 + 2, "primeiro delay perto da base")
    var d10 = backoffDelay(10, base, maxDelay)
    assert(d10 <= maxDelay + maxDelay / 5 + 2, "limitado pelo teto")
}

test "backoff: tentativas maiores nao diminuem o teto" {
    var maxDelay = 10000
    var low = backoffDelay(3, 500, maxDelay)
    var high = backoffDelay(20, 500, maxDelay)
    assert(high >= 0, "alto nao negativo")
    assert(low <= maxDelay + maxDelay / 5 + 2, "baixo dentro do teto")
}

test "backoff: defaults coerentes" {
    assert(defaultBackoffBase() > 0, "base positiva")
    assert(defaultBackoffMax() > defaultBackoffBase(), "teto maior que base")
    // Fonte unica: os defaults delegam no Limits (valores travados + mutacao
    // quebra). Recuos sem recuo silencioso: base nao-positiva volta ao
    // default, teto abaixo da base volta a base.
    assert(defaultBackoffBase() == limitBackoffBaseMs(), "base do Limits")
    assert(defaultBackoffMax() == limitBackoffMaxMs(), "teto do Limits")
    assert(limitBackoffBaseMs() == 500, "default base 500 ms")
    assert(limitBackoffMaxMs() == 30000, "default teto 30000 ms")
    assert(backoffBaseLimitFrom(0) == 500, "base zero recai no default")
    assert(backoffBaseLimitFrom(-3) == 500, "base negativa recai no default")
    assert(backoffBaseLimitFrom(250) == 250, "base positiva passa direto")
    assert(backoffMaxLimitFrom(100, 500) == 500, "teto abaixo da base recai na base")
    assert(backoffMaxLimitFrom(500, 500) == 500, "teto igual a base fica")
    assert(backoffMaxLimitFrom(60000, 500) == 60000, "teto acima da base passa")
}
