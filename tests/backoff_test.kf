import kofcloud.agent.Agent

import kofcloud.agent.Backoff
import kofcloud.util.Limits
import kofcloud.util.Text
import testkit.Support

test "backoff: cresce com tentativas e respeita o teto" {
    var base = 500
    var maxDelay = 30000
    var d0 = backoffDelay(0, base, maxDelay)
    need(d0 >= 0, "falhou")
    need(d0 <= base + base / 5 + 2, "falhou")
    var d10 = backoffDelay(10, base, maxDelay)
    need(d10 <= maxDelay + maxDelay / 5 + 2, "falhou")
}

test "backoff: tentativas maiores nao diminuem o teto" {
    var maxDelay = 10000
    var low = backoffDelay(3, 500, maxDelay)
    var high = backoffDelay(20, 500, maxDelay)
    need(high >= 0, "falhou")
    need(low <= maxDelay + maxDelay / 5 + 2, "falhou")
}

test "backoff: defaults coerentes" {
    need(defaultBackoffBase() > 0, "falhou")
    need(defaultBackoffMax() > defaultBackoffBase(), "falhou")
    // Fonte unica: os defaults delegam no Limits (valores travados + mutacao
    // quebra). Recuos sem recuo silencioso: base nao-positiva volta ao
    // default, teto abaixo da base volta a base.
    need(defaultBackoffBase() == limitBackoffBaseMs(), "falhou")
    need(defaultBackoffMax() == limitBackoffMaxMs(), "falhou")
    need(limitBackoffBaseMs() == 500, "falhou")
    need(limitBackoffMaxMs() == 30000, "falhou")
    need(backoffBaseLimitFrom(0) == 500, "falhou")
    need(backoffBaseLimitFrom(-3) == 500, "falhou")
    need(backoffBaseLimitFrom(250) == 250, "falhou")
    need(backoffMaxLimitFrom(100, 500) == 500, "falhou")
    need(backoffMaxLimitFrom(500, 500) == 500, "falhou")
    need(backoffMaxLimitFrom(60000, 500) == 60000, "falhou")
}

test "edge drift: linha so quando ranking aponta outro Edge (puro)", "edge-drift" {
    // Pendente da F14 s2 resolvido como observacao: o refresher ja sondava e
    // ranqueava todos os Edges a cada ciclo (`fetchEdge`) e DESCARTAVA o
    // ranking. Migrar a sessao significa matar o tunel, entao a fatia
    // honesta e o sinal: o operador ve o drift no `logs --runtime` e decide.
    var cur = EdgeProbe("edge-a", 7000, 20)
    var other = EdgeProbe("edge-b", 7000, 10)

    // Drift real: ranking aponta outro Edge.
    var drift = edgeDriftLine("edge-a", 7000, other, false)
    need(drift.indexOf("edge-b:7000") >= 0, "falhou")
    need(drift.indexOf("edge-a:7000") >= 0, "falhou")
    need(drift.indexOf("reinicie o connect") >= 0, "falhou")

    // Mesmo Edge: sem linha (nao e drift).
    need(edgeDriftLine("edge-a", 7000, cur, false) == "", "falhou")

    // Override do operador: config manda, nunca e drift.
    need(edgeDriftLine("edge-a", 7000, other, true) == "", "falhou")

    // Ranking vazio (nenhum Edge respondeu): sem linha.
    var empty = EdgeProbe("", 0, -1)
    need(edgeDriftLine("edge-a", 7000, empty, false) == "", "falhou")

    // Porta diferente no mesmo host tambem e drift.
    var portDrift = edgeDriftLine("edge-a", 7000, EdgeProbe("edge-a", 7001, 5), false)
    need(portDrift.indexOf("edge-a:7001") >= 0, "falhou")

    // Trava de fonte: o refresher registra o drift pelo agenteEvent (o mesmo
    // caminho dos outros sinais, visivel no `logs --runtime`) e guarda o
    // Edge da sessao para comparar.
    var raw = File("src/kofcloud/agent/Agent.kf").readText()
    var text = ""
    if (raw != null) {
        text = raw
    }
    if (text.length == 0) {
        return
    }
    var start = text.indexOf("void agentRefresher(")
    var bodyEnd = text.length
    var body = text.substring(start, bodyEnd)
    need(body.indexOf("edgeDriftLine(") >= 0, "falhou")
    need(body.indexOf("agentEvent(\"info\", line)") >= 0, "falhou")
    need(body.indexOf("endpoint.best") >= 0, "falhou")
}

test "rede ausente: retry espera o passo offline, nunca a base (F16)", "backoff-offline" {
    // Medido pela sonda: sem rede o laco batia na base do backoff (500 ms)
    // contra uma rede que nao existe. Sem rede, espera fixa e curta; com
    // rede, o backoff exponencial de sempre.
    var offline = limitOfflineRetryMs()
    need(offline == 30000, "falhou")
    need(reconnectWaitMs(false, 0, 500, 30000, offline) == 30000, "falhou")
    need(reconnectWaitMs(false, 9, 500, 30000, offline) == 30000, "falhou")
    need(reconnectWaitMs(false, 0, 500, 30000, 0) == 30000, "falhou")
    need(reconnectWaitMs(false, 0, 500, 30000, -5) == 30000, "falhou")
    need(reconnectWaitMs(false, 0, 500, 30000, 7000) == 7000, "falhou")
    var online = reconnectWaitMs(true, 0, 500, 30000, offline)
    need(online >= 0 && online <= 620, "falhou")
    need(offlineRetryMsFrom(0) == 30000, "falhou")
    need(offlineRetryMsFrom(-1) == 30000, "falhou")
    need(offlineRetryMsFrom(2500) == 2500, "falhou")

    // Eventos: a palavra que o operador ja procura continua com rede; sem
    // rede o texto diz de quem e a falta.
    var line = reconnectLine("control unreachable", true, 750)
    need(line.indexOf("reconnecting in 750ms") >= 0, "falhou")
    need(line.indexOf("sem rede") < 0, "falhou")
    var offLine = reconnectLine("control unreachable", false, 30000)
    need(offLine.indexOf("sem rede local") >= 0, "falhou")
    need(offLine.indexOf("reconnecting in") < 0, "falhou")
    need(networkBackLine().indexOf("rede local voltou") >= 0, "falhou")

    // Sonda real: `.invalid` (RFC 6761) nunca resolve.
    need(hostReachable("kofcloud-offline-probe.invalid") == false, "falhou")
    // O host fixo da config e quem manda na sonda; sem Edge fixo, cai no
    // control plane (host impossivel tambem).
    need(agentNetworkUp("kofcloud-offline-probe.invalid", "http://127.0.0.1:1") == false, "falhou")
    // Control plane com host URL ilegivel: "nao afirma nem nega".
    need(agentNetworkUp("", "nao-e-url") == true, "falhou")
}

test "credencial recusada: o retry diz o que fazer, sem ser fatal", "backoff-authhint" {
    // Medido: uma kfc_ revogada/vencida volta 401 KCF004 do control plane e
    // o laco de reconexao tratava como rede — a maquina ficava tentando em
    // silencio e o operador via erros de backoff, nao "faca login".
    var authErr = "KCF004: unauthorized"
    if (!(isControlAuthError(authErr))) { assert(false, "H1 reconhece KCF004") }
    if (isFatal(authErr)) { assert(false, "H2 nao e refusa do Edge (login resolve)") }
    if (!(systemHint(authErr).indexOf("kof cloud login") >= 0)) { assert(false, "H3 dica nomeia o login") }
    if (!(systemHint(authErr).indexOf("recusada") >= 0)) { assert(false, "H4 dica diz o que aconteceu") }
    if (!(systemHint("connect refused").length == 0)) { assert(false, "H5 erro de rede sem dica") }
    if (isControlAuthError("edge closed during handshake")) { assert(false, "H6 nao confunde outros erros") }
    // A dica nunca carrega o valor da credencial.
    if (systemHint(authErr).indexOf("kfc_") >= 0) { assert(false, "H7 sem credencial na dica") }
    // Trava de fonte: o laco emite a dica pelo mesmo caminho dos outros eventos.
    var raw = File("src/kofcloud/agent/Agent.kf").readText()
    var text = ""
    if (raw != null) {
        text = raw
    }
    var start = text.indexOf("void runAgent(")
    var body = text.substring(start, text.length)
    if (!(body.indexOf("systemHint(e)") >= 0)) { assert(false, "H8 laco emite a dica") }
}
