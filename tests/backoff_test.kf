import kofcloud.agent.Agent

import kofcloud.agent.Backoff
import kofcloud.util.Limits
import kofcloud.util.Text

test "backoff: cresce com tentativas e respeita o teto" {
    var base = 500
    var maxDelay = 30000
    var d0 = backoffDelay(0, base, maxDelay)
    assert(d0 >= 0, "nao negativo")
    assert(d0 <= base + base / 5 + 2, "primeiro delay perto da base")
    var d10 = backoffDelay(10, base, maxDelay)
    assert(d10 <= maxDelay + maxDelay / 5 + 2, "limitado pelo teto")
}

test "backoff: tentativas maiores nao diminuem o teto" {
    var maxDelay = 10000
    var low = backoffDelay(3, 500, maxDelay)
    var high = backoffDelay(20, 500, maxDelay)
    assert(high >= 0, "alto nao negativo")
    assert(low <= maxDelay + maxDelay / 5 + 2, "baixo dentro do teto")
}

test "backoff: defaults coerentes" {
    assert(defaultBackoffBase() > 0, "base positiva")
    assert(defaultBackoffMax() > defaultBackoffBase(), "teto maior que base")
    // Fonte unica: os defaults delegam no Limits (valores travados + mutacao
    // quebra). Recuos sem recuo silencioso: base nao-positiva volta ao
    // default, teto abaixo da base volta a base.
    assert(defaultBackoffBase() == limitBackoffBaseMs(), "base do Limits")
    assert(defaultBackoffMax() == limitBackoffMaxMs(), "teto do Limits")
    assert(limitBackoffBaseMs() == 500, "default base 500 ms")
    assert(limitBackoffMaxMs() == 30000, "default teto 30000 ms")
    assert(backoffBaseLimitFrom(0) == 500, "base zero recai no default")
    assert(backoffBaseLimitFrom(-3) == 500, "base negativa recai no default")
    assert(backoffBaseLimitFrom(250) == 250, "base positiva passa direto")
    assert(backoffMaxLimitFrom(100, 500) == 500, "teto abaixo da base recai na base")
    assert(backoffMaxLimitFrom(500, 500) == 500, "teto igual a base fica")
    assert(backoffMaxLimitFrom(60000, 500) == 60000, "teto acima da base passa")
}

test "edge drift: linha so quando ranking aponta outro Edge (puro)", "edge-drift" {
    // Pendente da F14 s2 resolvido como observacao: o refresher ja sondava e
    // ranqueava todos os Edges a cada ciclo (`fetchEdge`) e DESCARTAVA o
    // ranking. Migrar a sessao significa matar o tunel, entao a fatia
    // honesta e o sinal: o operador ve o drift no `logs --runtime` e decide.
    var cur = EdgeProbe("edge-a", 7000, 20)
    var other = EdgeProbe("edge-b", 7000, 10)

    // Drift real: ranking aponta outro Edge.
    var drift = edgeDriftLine("edge-a", 7000, other, false)
    assert(drift.indexOf("edge-b:7000") >= 0, "nomeia o apontado")
    assert(drift.indexOf("edge-a:7000") >= 0, "nomeia o atual")
    assert(drift.indexOf("reinicie o connect") >= 0, "diz o proximo passo")

    // Mesmo Edge: sem linha (nao e drift).
    assert(edgeDriftLine("edge-a", 7000, cur, false) == "", "mesmo edge: sem drift")

    // Override do operador: config manda, nunca e drift.
    assert(edgeDriftLine("edge-a", 7000, other, true) == "", "override: sem drift")

    // Ranking vazio (nenhum Edge respondeu): sem linha.
    var empty = EdgeProbe("", 0, -1)
    assert(edgeDriftLine("edge-a", 7000, empty, false) == "", "ranking vazio: sem drift")

    // Porta diferente no mesmo host tambem e drift.
    var portDrift = edgeDriftLine("edge-a", 7000, EdgeProbe("edge-a", 7001, 5), false)
    assert(portDrift.indexOf("edge-a:7001") >= 0, "porta diferente e drift")

    // Trava de fonte: o refresher registra o drift pelo agenteEvent (o mesmo
    // caminho dos outros sinais, visivel no `logs --runtime`) e guarda o
    // Edge da sessao para comparar.
    var raw = File("src/kofcloud/agent/Agent.kf").readText()
    var text = ""
    if (raw != null) {
        text = raw
    }
    if (text.length == 0) {
        return
    }
    var start = text.indexOf("void agentRefresher(")
    var bodyEnd = text.length
    var body = text.substring(start, bodyEnd)
    assert(body.indexOf("edgeDriftLine(") >= 0, "refresher detecta drift")
    assert(body.indexOf("agentEvent(\"info\", line)") >= 0, "sinal vai ao runtime log")
    assert(body.indexOf("endpoint.best") >= 0, "usa o ranking do fetchEdge")
}

test "rede ausente: retry espera o passo offline, nunca a base (F16)", "backoff-offline" {
    // Medido pela sonda: sem rede o laco batia na base do backoff (500 ms)
    // contra uma rede que nao existe. Sem rede, espera fixa e curta; com
    // rede, o backoff exponencial de sempre.
    var offline = limitOfflineRetryMs()
    assert(offline == 30000, "default 30000 ms")
    assert(reconnectWaitMs(false, 0, 500, 30000, offline) == 30000, "offline: passo fixo ja na 1a volta")
    assert(reconnectWaitMs(false, 9, 500, 30000, offline) == 30000, "offline: nao cresce com tentativas")
    assert(reconnectWaitMs(false, 0, 500, 30000, 0) == 30000, "offline sem passo -> default, nunca 0")
    assert(reconnectWaitMs(false, 0, 500, 30000, -5) == 30000, "offline negativo -> default")
    assert(reconnectWaitMs(false, 0, 500, 30000, 7000) == 7000, "offline respeita a config")
    var online = reconnectWaitMs(true, 0, 500, 30000, offline)
    assert(online >= 0 && online <= 620, "online: volta ao backoff da base")
    assert(offlineRetryMsFrom(0) == 30000, "recuo: zero volta ao default")
    assert(offlineRetryMsFrom(-1) == 30000, "recuo: negativo volta ao default")
    assert(offlineRetryMsFrom(2500) == 2500, "recuo: positivo passa")

    // Eventos: a palavra que o operador ja procura continua com rede; sem
    // rede o texto diz de quem e a falta.
    var line = reconnectLine("control unreachable", true, 750)
    assert(line.indexOf("reconnecting in 750ms") >= 0, "com rede: mesma palavra")
    assert(line.indexOf("sem rede") < 0, "com rede: nao acusa a maquina")
    var offLine = reconnectLine("control unreachable", false, 30000)
    assert(offLine.indexOf("sem rede local") >= 0, "sem rede: diz a causa")
    assert(offLine.indexOf("reconnecting in") < 0, "sem rede: nao culpa o Edge")
    assert(networkBackLine().indexOf("rede local voltou") >= 0, "volta da rede avisa")

    // Sonda real: `.invalid` (RFC 6761) nunca resolve.
    assert(hostReachable("kofcloud-offline-probe.invalid") == false, "nome impossivel = sem rede")
    // O host fixo da config e quem manda na sonda; sem Edge fixo, cai no
    // control plane (host impossivel tambem).
    assert(agentNetworkUp("kofcloud-offline-probe.invalid", "http://127.0.0.1:1") == false, "Edge fixo decide")
    // Control plane com host URL ilegivel: "nao afirma nem nega".
    assert(agentNetworkUp("", "nao-e-url") == true, "sem rotulo para sondar: nao bloqueia")
}
