import kofcloud.cli.Daemon
import kofcloud.cli.Deploy
import kofcloud.cli.Doctor
import kofcloud.cli.Usage
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.store.Store
import testkit.Support

// doctor: diagnostico somente-leitura em camadas. Nao publica, nao remove,
// nao revoga, nao emite token — so le. Cada teste monta o cenario e chama
// doctorCheck (a logica pura), sem depender de HOME ou processos externos.

test "doctor: sem login pede login e para na primeira camada", "doctor" {
    // Sem sessao nao ha como autenticar: falha fechada, sem tocar na rede.
    var report = doctorCheck("")
    assert(report.ok == false, "falha sem login")
    assert(report.lines.size == 1, "para na primeira camada")
    assert(report.lines.get(0).startsWith("FALHA login local"), "aponta o login")
}

test "doctor: camada TLS distingue ausente, invalido e expirando", "doctor-tls" {
    // Sem --tls-cert nada a checar: nao inventa linha.
    assert(doctorTlsLine("", true, 0, 0) == "", "sem cert = sem linha")
    // Arquivo ausente.
    var missing = doctorTlsLine("/tmp/nao-existe.pem", false, 1, 1)
    assert(missing.startsWith("FALHA tls"), "ausente e FALHA")
    assert(missing.indexOf("nao encontrado") >= 0, "diz que falta o arquivo")
    // PEM ilegivel (openssl x509 sai != 0 sem -checkend).
    var invalid = doctorTlsLine("/tmp/x.pem", true, 1, 1)
    assert(invalid.startsWith("FALHA tls"), "invalido e FALHA")
    assert(invalid.indexOf("PEM valido") >= 0, "aponta o conteudo invalido")
    // Expirado/expirando: -checkend != 0 com PEM valido.
    var expiring = doctorTlsLine("/tmp/x.pem", true, 0, 1)
    assert(expiring.startsWith("FALHA tls"), "expirando e FALHA")
    assert(expiring.indexOf("30 dias") >= 0, "nomeia o prazo")
    assert(expiring.indexOf("renove") >= 0, "orienta a acao")
    // Valido: ok, com o caminho (e nunca o conteudo).
    var valid = doctorTlsLine("/tmp/x.pem", true, 0, 0)
    assert(valid.startsWith("ok"), "valido e ok")
    assert(valid.indexOf("/tmp/x.pem") >= 0, "mostra o caminho checado")
    // Caminho relativo tambem: a linha e pura, sem ler o disco.
    assert(doctorTlsLine("certs/a.pem", true, 0, 0).indexOf("certs/a.pem") >= 0, "caminho preservado")
}

test "doctor: --tls-cert com PEM real (openssl) vira ok/FALHA na camada TLS", "doctor-tls" {
    // Integracao real do openssl: PEM valido por 10 anos -> ok; PEM com
    // 1 dia -> FALHA de expiracao; lixo -> FALHA de formato. O teste pula
    // quando openssl nao existe (mesmo criterio do scan --tls-cert).
    var dir = "/tmp/kofcloud-doc-tls-" + crypto.randomHex(4)
    var key = dir + "/k.pem"
    var cert = dir + "/c.pem"
    var bad = dir + "/bad.pem"
    var gen = process.run("sh", "-c", "mkdir -p " + dir + " && openssl req -x509 -newkey rsa:2048 -keyout " + key + " -out " + cert + " -days 3650 -nodes -subj /CN=doctor 2>/dev/null && printf garbage > " + bad)
    if (gen.exitCode != 0) {
        assert(true, "openssl ausente: pulando integracao")
        return
    }
    var parse = process.run("openssl", "x509", "-in", cert, "-noout").exitCode
    var checkend = process.run("openssl", "x509", "-in", cert, "-noout", "-checkend", "2592000").exitCode
    var okLine = doctorTlsLine(cert, true, parse, checkend)
    assert(okLine.startsWith("ok"), "cert de 10 anos e ok: " + okLine)
    assert(okLine.indexOf("tls") >= 0, "rotula a camada tls")
    var badLine = doctorTlsLine(bad, true, process.run("openssl", "x509", "-in", bad, "-noout").exitCode, 1)
    assert(badLine.startsWith("FALHA tls"), "garbage e FALHA: " + badLine)
    // O comando completo aceita a flag e nao morre (sem login, para na 1a
    // camada): a flag e reconhecida antes de qualquer rede.
    assert(doctorTlsLine(cert, false, 0, 0).indexOf("nao encontrado") >= 0, "ausente antes de checar")
}

test "doctor: ajuda lista a camada do tunel", "doctor-usage" {
    // Regressao: o help ficou para tras quando o doctor ganhou o tunel
    // (README ja citava, Usage.kf nao). Puro, sem rede nem HOME.
    var help = usageText()
    assert(help.indexOf("doctor") >= 0, "menciona o doctor")
    assert(help.indexOf("tunel") >= 0, "menciona o tunel")
    // Fase 9 slice 3 parcial: o doctor checa o PEM quando informado.
    assert(help.indexOf("doctor [--file kofcloud.json] [--tls-cert <pem>]") >= 0, "doctor anuncia --tls-cert")
    assert(help.indexOf("tls") >= 0, "menciona a camada tls")
}

test "doctor: manifesto invalido e reportado com caminho", "doctor-manifest" {
    var bad = deployManifest("bad", "{\"services\":[{\"name\":\"x\",\"port\":1}]}")
    var parsed = parseManifest(readTextOr(bad, ""))
    assert(parsed.size == 1, "parse ok")
    // Com login ausente, o manifesto nem e lido: login vem antes.
    var report = doctorCheck(bad)
    assert(report.ok == false, "falha sem login")
}

test "doctor: camada do tunel decide sem rede nem HOME", "doctor-tunnel" {
    // Presente: corpo de /v1/presence com o id entre aspas (formato real).
    var online = doctorTunnelLine("[\"dev-1\",\"dev-2\"]", "dev-1", "")
    assert(online.startsWith("ok"), "sessao viva e ok")
    assert(online.indexOf("tunel") >= 0, "rotula a camada")
    // Ausente: mesmo corpo, outro device — FALHA que aponta o connect.
    // (Prefixo sozinho nao casa: bodyContainsId exige as aspas.)
    var offline = doctorTunnelLine("[\"dev-1\"]", "dev-10", "")
    assert(offline.startsWith("FALHA tunel"), "sem sessao e FALHA")
    assert(offline.indexOf("connect") >= 0, "orienta o proximo passo")
    // Lista vazia: offline, nao erro.
    var empty = doctorTunnelLine("[]", "dev-1", "")
    assert(empty.startsWith("FALHA tunel"), "vazio tambem e FALHA")
    // Busca falhou (rede/conta): FALHA distinta, com o motivo.
    var failed = doctorTunnelLine("", "dev-1", "KCF004: unauthorized")
    assert(failed.startsWith("FALHA tunel"), "erro de busca e FALHA")
    assert(failed.indexOf("indisponivel") >= 0, "diz que nao deu para saber")
}

test "doctor: fim a fim acusa servico fora do ar e aprova quando sobe", "doctor-e2e" {
    var controlPort = 19741
    var path = "/tmp/kofcloud-doctor-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control plane no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var accountToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pubkey\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var controlUrl = "http://127.0.0.1:" + intToString(controlPort)

    var manifest = "{\"services\":[{\"name\":\"site\",\"port\":19742}]}"
    var wanted = parseManifest(manifest)

    // Nada publicado: doctor acusa "nao publicado", sem exigir porta local.
    var missing = verifyDeploymentLike(controlUrl, accountToken, wanted)
    assert(missing.size == 1, "um problema")
    assert(missing.get(0).indexOf("nao publicado") >= 0, "diz que nao publicou")

    // Publica mas sem ninguem escutando: acusa falta de resposta local.
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"19742\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    assert(statusOf(httpPostJson(controlPort, "/v1/services", pubBody, accountToken)) == 200, "publicado")
    var down = verifyDeploymentLike(controlUrl, accountToken, wanted)
    assert(down.size == 1, "um problema")
    assert(down.get(0).indexOf("sem resposta") >= 0, "diz que nao responde")

    // Sobe um listener cru na porta: tudo ok.
    var listener = net.listen(19742)
    var serving = spawn {
        var open = true
        while (open) {
            try {
                var peer = listener.accept()
                peer.close()
            } catch (String e) {
                open = false
            }
        }
    }
    assert(waitForPort(19742, 60), "servico local no ar")
    var up = verifyDeploymentLike(controlUrl, accountToken, wanted)
    assert(up.size == 0, "tudo saudavel")
    listener.close()

    // Drift de config pelo caminho do doctor: remove e republica o mesmo
    // nome com porta diferente (publish e idempotente por nome — re-publicar
    // retorna o existente sem atualizar). O doctor acusa antes de testar
    // resposta, com a dica de re-deploy.
    var driftTarget = doctorServiceIdIn(bodyOf(httpGetToken(controlPort, "/v1/services", accountToken)), "site")
    assert(driftTarget.length > 0, "alvo existe")
    assert(statusOf(httpPostJson(controlPort, "/v1/services/remove", "{\"serviceId\":\"" + driftTarget + "\"}", accountToken)) == 200, "removido")
    var driftBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"19743\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    assert(statusOf(httpPostJson(controlPort, "/v1/services", driftBody, accountToken)) == 200, "republicado com drift")
    var drifted = verifyDeploymentLike(controlUrl, accountToken, wanted)
    assert(drifted.size == 1, "um problema de drift")
    assert(drifted.get(0).indexOf("config diferente") >= 0, "doctor acusa o drift")
    assert(drifted.get(0).indexOf("deploy") >= 0, "doctor orienta o re-deploy")
}

// Espelho da etapa 5 do doctorCheck sem precisar de HOME/sessao: o doctor
// real delega ao verifyDeployment (mesma ordem: nao publicado -> drift ->
// sem resposta); este helper trava a ordem que o doctor imprime.
List<String> verifyDeploymentLike(String controlUrl, String token, List<ManifestService> wanted) {
    return verifyDeployment(controlUrl, token, wanted)
}

// Id do servico pelo nome no JSON listado (mesma tecnica do deploy_test:
// o "id" vem antes do "name" no objeto; busca para tras a partir do nome).
String doctorServiceIdIn(String servicesBody, String name) {
    var needle = "\"name\":\"" + name + "\""
    var at = servicesBody.indexOf(needle)
    if (at < 0) {
        return ""
    }
    var idKey = "\"id\":\""
    var head = servicesBody.substring(0, at)
    var back = head.lastIndexOf(idKey)
    if (back < 0) {
        return ""
    }
    var start = back + idKey.length
    var end = head.indexOf("\"", start)
    if (end < 0) {
        return ""
    }
    return head.substring(start, end)
}

String deployManifest(String name, String body) {
    var path = "/tmp/kofcloud-doctor-" + name + "-" + crypto.randomHex(4) + ".json"
    File(path).writeText(body)
    return path
}
