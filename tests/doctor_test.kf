import kofcloud.protocol.Bytes
import kofcloud.cli.Commands
import kofcloud.cli.Daemon
import kofcloud.cli.Deploy
import kofcloud.cli.Doctor
import kofcloud.cli.Usage
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.store.Store
import kofcloud.util.Limits
import testkit.Support

// doctor: diagnostico somente-leitura em camadas. Nao publica, nao remove,
// nao revoga, nao emite token — so le. Cada teste monta o cenario e chama
// doctorCheck (a logica pura), sem depender de HOME ou processos externos.

test "doctor: sem login pede login e para na primeira camada", "doctor" {
    // Sem sessao nao ha como autenticar: falha fechada, sem tocar na rede.
    var report = doctorCheck("")
    assert(report.ok == false, "falha sem login")
    assert(report.lines.size == 1, "para na primeira camada")
    assert(report.lines.get(0).startsWith("FALHA login local"), "aponta o login")
}

test "doctor: camada TLS distingue ausente, invalido e expirando", "doctor-tls" {
    // Sem --tls-cert nada a checar: nao inventa linha.
    assert(doctorTlsLine("", true, 0, 0) == "", "sem cert = sem linha")
    // Arquivo ausente.
    var missing = doctorTlsLine("/tmp/nao-existe.pem", false, 1, 1)
    assert(missing.startsWith("FALHA tls"), "ausente e FALHA")
    assert(missing.indexOf("nao encontrado") >= 0, "diz que falta o arquivo")
    // PEM ilegivel (openssl x509 sai != 0 sem -checkend).
    var invalid = doctorTlsLine("/tmp/x.pem", true, 1, 1)
    assert(invalid.startsWith("FALHA tls"), "invalido e FALHA")
    assert(invalid.indexOf("PEM valido") >= 0, "aponta o conteudo invalido")
    // Expirado/expirando: -checkend != 0 com PEM valido.
    var expiring = doctorTlsLine("/tmp/x.pem", true, 0, 1)
    assert(expiring.startsWith("FALHA tls"), "expirando e FALHA")
    assert(expiring.indexOf("30 dias") >= 0, "nomeia o prazo")
    assert(expiring.indexOf("renove") >= 0, "orienta a acao")
    // Valido: ok, com o caminho (e nunca o conteudo).
    var valid = doctorTlsLine("/tmp/x.pem", true, 0, 0)
    assert(valid.startsWith("ok"), "valido e ok")
    assert(valid.indexOf("/tmp/x.pem") >= 0, "mostra o caminho checado")
    // Caminho relativo tambem: a linha e pura, sem ler o disco.
    assert(doctorTlsLine("certs/a.pem", true, 0, 0).indexOf("certs/a.pem") >= 0, "caminho preservado")
}

test "doctor: --tls-cert com PEM real (openssl) vira ok/FALHA na camada TLS", "doctor-tls" {
    // Integracao real do openssl: PEM valido por 10 anos -> ok; PEM com
    // 1 dia -> FALHA de expiracao; lixo -> FALHA de formato. O teste pula
    // quando openssl nao existe (mesmo criterio do scan --tls-cert).
    var dir = "/tmp/kofcloud-doc-tls-" + crypto.randomHex(4)
    var key = dir + "/k.pem"
    var cert = dir + "/c.pem"
    var bad = dir + "/bad.pem"
    var gen = process.run("sh", "-c", "mkdir -p " + dir + " && openssl req -x509 -newkey rsa:2048 -keyout " + key + " -out " + cert + " -days 3650 -nodes -subj /CN=doctor 2>/dev/null && printf garbage > " + bad)
    if (gen.exitCode != 0) {
        assert(true, "openssl ausente: pulando integracao")
        return
    }
    var parse = process.run("openssl", "x509", "-in", cert, "-noout").exitCode
    var checkend = process.run("openssl", "x509", "-in", cert, "-noout", "-checkend", tlsCheckendWindowSec()).exitCode
    var okLine = doctorTlsLine(cert, true, parse, checkend)
    assert(okLine.startsWith("ok"), "cert de 10 anos e ok: " + okLine)
    assert(okLine.indexOf("tls") >= 0, "rotula a camada tls")
    var badLine = doctorTlsLine(bad, true, process.run("openssl", "x509", "-in", bad, "-noout").exitCode, 1)
    assert(badLine.startsWith("FALHA tls"), "garbage e FALHA: " + badLine)
    // O comando completo aceita a flag e nao morre (sem login, para na 1a
    // camada): a flag e reconhecida antes de qualquer rede.
    assert(doctorTlsLine(cert, false, 0, 0).indexOf("nao encontrado") >= 0, "ausente antes de checar")
}

test "doctor: ajuda lista a camada do tunel", "doctor-usage" {
    // Regressao: o help ficou para tras quando o doctor ganhou o tunel
    // (README ja citava, Usage.kf nao). Puro, sem rede nem HOME.
    var help = usageText()
    assert(help.indexOf("doctor") >= 0, "menciona o doctor")
    assert(help.indexOf("tunel") >= 0, "menciona o tunel")
    // Fase 9 slice 3 parcial: o doctor checa o PEM quando informado.
    assert(help.indexOf("doctor [--file kofcloud.json] [--tls-cert <pem>]") >= 0, "doctor anuncia --tls-cert")
    assert(help.indexOf("tls") >= 0, "menciona a camada tls")
    // Camada da auditoria (Fase 19 s4): o help nao fica para tras de novo.
    assert(help.indexOf("auditoria") >= 0, "menciona a camada da auditoria")
}

test "doctor: manifesto invalido e reportado com caminho", "doctor-manifest" {
    var bad = deployManifest("bad", "{\"services\":[{\"name\":\"x\",\"port\":1}]}")
    var parsed = parseManifest(readTextOr(bad, ""))
    assert(parsed.size == 1, "parse ok")
    // Com login ausente, o manifesto nem e lido: login vem antes.
    var report = doctorCheck(bad)
    assert(report.ok == false, "falha sem login")
}

test "doctor: camada do tunel decide sem rede nem HOME", "doctor-tunnel" {
    // Presente: corpo de /v1/presence com o id entre aspas (formato real).
    var online = doctorTunnelLine("[\"dev-1\",\"dev-2\"]", "dev-1", "")
    assert(online.startsWith("ok"), "sessao viva e ok")
    assert(online.indexOf("tunel") >= 0, "rotula a camada")
    // Ausente: mesmo corpo, outro device — FALHA que aponta o connect.
    // (Prefixo sozinho nao casa: bodyContainsId exige as aspas.)
    var offline = doctorTunnelLine("[\"dev-1\"]", "dev-10", "")
    assert(offline.startsWith("FALHA tunel"), "sem sessao e FALHA")
    assert(offline.indexOf("connect") >= 0, "orienta o proximo passo")
    // Lista vazia: offline, nao erro.
    var empty = doctorTunnelLine("[]", "dev-1", "")
    assert(empty.startsWith("FALHA tunel"), "vazio tambem e FALHA")
    // Busca falhou (rede/conta): FALHA distinta, com o motivo.
    var failed = doctorTunnelLine("", "dev-1", "KCF004: unauthorized")
    assert(failed.startsWith("FALHA tunel"), "erro de busca e FALHA")
    assert(failed.indexOf("indisponivel") >= 0, "diz que nao deu para saber")
}

test "doctor: fim a fim acusa servico fora do ar e aprova quando sobe", "doctor-e2e" {
    var controlPort = 19741
    var path = "/tmp/kofcloud-doctor-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control plane no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var accountToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pubkey\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var controlUrl = "http://127.0.0.1:" + intToString(controlPort)

    var manifest = "{\"services\":[{\"name\":\"site\",\"port\":19742}]}"
    var wanted = parseManifest(manifest)

    // Nada publicado: doctor acusa "nao publicado", sem exigir porta local.
    var missing = verifyDeploymentLike(controlUrl, accountToken, wanted)
    assert(missing.size == 1, "um problema")
    assert(missing.get(0).indexOf("nao publicado") >= 0, "diz que nao publicou")

    // Publica mas sem ninguem escutando: acusa falta de resposta local.
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"19742\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    assert(statusOf(httpPostJson(controlPort, "/v1/services", pubBody, accountToken)) == 200, "publicado")
    var down = verifyDeploymentLike(controlUrl, accountToken, wanted)
    assert(down.size == 1, "um problema")
    assert(down.get(0).indexOf("sem resposta") >= 0, "diz que nao responde")

    // Sobe um listener cru na porta: tudo ok.
    var listener = net.listen(19742)
    var serving = spawn {
        var open = true
        while (open) {
            try {
                var peer = listener.accept()
                var worker = spawn { doctorServeOk(peer) }
            } catch (String e) {
                open = false
            }
        }
    }
    assert(waitForPort(19742, 60), "servico local no ar")
    var up = verifyDeploymentLike(controlUrl, accountToken, wanted)
    assert(up.size == 0, "tudo saudavel")
    listener.close()

    // Drift de config pelo caminho do doctor: remove e republica o mesmo
    // nome com porta diferente (publish e idempotente por nome — re-publicar
    // retorna o existente sem atualizar). O doctor acusa antes de testar
    // resposta, com a dica de re-deploy.
    var driftTarget = doctorServiceIdIn(bodyOf(httpGetToken(controlPort, "/v1/services", accountToken)), "site")
    assert(driftTarget.length > 0, "alvo existe")
    assert(statusOf(httpPostJson(controlPort, "/v1/services/remove", "{\"serviceId\":\"" + driftTarget + "\"}", accountToken)) == 200, "removido")
    var driftBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"19743\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    assert(statusOf(httpPostJson(controlPort, "/v1/services", driftBody, accountToken)) == 200, "republicado com drift")
    var drifted = verifyDeploymentLike(controlUrl, accountToken, wanted)
    assert(drifted.size == 1, "um problema de drift")
    assert(drifted.get(0).indexOf("config diferente") >= 0, "doctor acusa o drift")
    assert(drifted.get(0).indexOf("deploy") >= 0, "doctor orienta o re-deploy")
}

// Espelho da etapa 5 do doctorCheck sem precisar de HOME/sessao: o doctor
// real delega ao verifyDeployment (mesma ordem: nao publicado -> drift ->
// sem resposta); este helper trava a ordem que o doctor imprime.
List<String> verifyDeploymentLike(String controlUrl, String token, List<ManifestService> wanted) {
    return verifyDeployment(controlUrl, token, wanted)
}

// Id do servico pelo nome no JSON listado (mesma tecnica do deploy_test:
// o "id" vem antes do "name" no objeto; busca para tras a partir do nome).
String doctorServiceIdIn(String servicesBody, String name) {
    var needle = "\"name\":\"" + name + "\""
    var at = servicesBody.indexOf(needle)
    if (at < 0) {
        return ""
    }
    var idKey = "\"id\":\""
    var head = servicesBody.substring(0, at)
    var back = head.lastIndexOf(idKey)
    if (back < 0) {
        return ""
    }
    var start = back + idKey.length
    var end = head.indexOf("\"", start)
    if (end < 0) {
        return ""
    }
    return head.substring(start, end)
}

String deployManifest(String name, String body) {
    var path = "/tmp/kofcloud-doctor-" + name + "-" + crypto.randomHex(4) + ".json"
    File(path).writeText(body)
    return path
}

test "doctor: PEM valido mas de outro dominio nao cobre os servicos do manifesto", "doctor-tls" {
    // Antes a camada TLS olhava so formato e validade: um PEM valido de
    // OUTRO dominio passava e o HTTPS quebrava no handshake, em producao.
    // A regra de cobertura e a mesma do `domain verify --tls-cert`
    // (`certHostVerdict`), agora aplicada aos hostnames do manifesto.
    var sanWrong = "X509v3 Subject Alternative Name:\n    DNS:other.example\n"
    var subjectWrong = "subject=CN = other.example\n"
    var hosts = listOf("site.mel.kofcloud.io", "api.mel.kofcloud.io")

    var blocked = doctorTlsLineFor("/tmp/x.pem", true, 0, 0, sanWrong, subjectWrong, hosts)
    assert(blocked.startsWith("FALHA tls"), "cert de outro dominio e FALHA")
    assert(blocked.indexOf("site.mel.kofcloud.io") >= 0, "nomeia o host que nao cobre")

    // Curinga da conta cobre todos os servicos.
    var sanOk = "X509v3 Subject Alternative Name:\n    DNS:*.mel.kofcloud.io\n"
    var okLine = doctorTlsLineFor("/tmp/x.pem", true, 0, 0, sanOk, "", hosts)
    assert(okLine.startsWith("ok"), "curinga da conta passa")
    assert(okLine.indexOf("2 servico(s)") >= 0, "diz quantos cobriu")

    // Um host coberto e outro nao: falha, porque HTTPS cai no que falta.
    var partial = "X509v3 Subject Alternative Name:\n    DNS:site.mel.kofcloud.io\n"
    var partialLine = doctorTlsLineFor("/tmp/x.pem", true, 0, 0, partial, "", hosts)
    assert(partialLine.startsWith("FALHA tls"), "cobertura parcial e FALHA")
    assert(partialLine.indexOf("api.mel.kofcloud.io") >= 0, "aponta o que falta")

    // Sem SAN consultado (openssl ausente / chamador antigo) nao inventa
    // falha de cobertura: so valida formato, como antes.
    var noSan = doctorTlsLineFor("/tmp/x.pem", true, 0, 0, "", "", hosts)
    assert(noSan.startsWith("ok"), "sem SAN consultado nao acusa cobertura")

    // Sem manifesto nao ha host a cobrir.
    assert(tlsRequiredHosts(listOf<ManifestService>(), "mel").size == 0, "sem servico = sem host")
    assert(tlsRequiredHosts(listOf<ManifestService>(), "").size == 0, "sem handle = sem host")
}

test "doctor: manifesto vira a lista de hostnames exigidos do PEM", "doctor-tls" {
    var dir = "/tmp/kofcloud-doc-host-" + crypto.randomHex(4)
    writeTextTo(dir + "/kofcloud.json", "{\"services\": [{\"name\": \"site\", \"port\": 8080}, {\"name\": \"api\", \"port\": 3000}]}")
    var loaded = loadManifestFile(dir + "/kofcloud.json")
    assert(loaded.ok, "manifesto lido")
    var hosts = tlsRequiredHosts(loaded.services, "mel")
    assert(hosts.size == 2, "dois hosts")
    assert(hosts.contains("site.mel.kofcloud.io"), "site")
    assert(hosts.contains("api.mel.kofcloud.io"), "api")

    // Manifesto ausente: nada a exigir (a camada do manifesto acusa isso).
    assert(loadManifestFile(dir + "/nao-existe.json").ok == false, "ausente nao ok")
}

test "doctor: PEM real de outro dominio e FALHA; curinga do dominio e ok", "doctor-tls" {
    // Caminho completo (openssl real -> SAN/subject -> veredito) para os
    // hostnames do manifesto. Pula quando o openssl nao existe, mesmo
    // criterio dos outros testes de TLS.
    var dir = "/tmp/kofcloud-doc-real-" + crypto.randomHex(4)
    var wrong = dir + "/wrong.pem"
    var wild = dir + "/wild.pem"
    var gen = process.run("sh", "-c", "mkdir -p " + dir + " && openssl req -x509 -newkey rsa:2048 -keyout " + dir + "/k1.pem -out " + wrong + " -days 365 -nodes -subj /CN=other.example -addext subjectAltName=DNS:other.example 2>/dev/null && openssl req -x509 -newkey rsa:2048 -keyout " + dir + "/k2.pem -out " + wild + " -days 365 -nodes -subj /CN=kofcloud.io -addext subjectAltName=DNS:*.mel.kofcloud.io 2>/dev/null")
    var probe = process.run("openssl", "version")
    if (probe.exitCode != 0 || gen.exitCode != 0) {
        return
    }
    var hosts = listOf("site.mel.kofcloud.io")

    var wrongSan = process.run("openssl", "x509", "-in", wrong, "-noout", "-ext", "subjectAltName").stdout
    var wrongSubj = process.run("openssl", "x509", "-in", wrong, "-noout", "-subject").stdout
    var wrongLine = doctorTlsLineFor(wrong, true, 0, 0, wrongSan, wrongSubj, hosts)
    assert(wrongLine.startsWith("FALHA tls"), "PEM real de outro dominio e FALHA: " + wrongLine)

    var wildSan = process.run("openssl", "x509", "-in", wild, "-noout", "-ext", "subjectAltName").stdout
    var wildSubj = process.run("openssl", "x509", "-in", wild, "-noout", "-subject").stdout
    var wildLine = doctorTlsLineFor(wild, true, 0, 0, wildSan, wildSubj, hosts)
    assert(wildLine.startsWith("ok"), "PEM real com curinga da conta passa: " + wildLine)
}

// Responde 200 a uma requisicao e fecha (fixture de servico saudavel):
// aceitar-e-fechar passava no connect TCP antigo, mas com a sonda do Agent
// (GET com prazo) e corretamente DEGRADED.
void doctorServeOk(Conn peer) {
    peer.receive(8192)
    peer.send(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok"))
    peer.close()
}

test "doctor: camada do device distingue REVOKED de SUSPENDED de ACTIVE", "doctor-device" {
    // Medido: o doctor so conferia "registrado". Um device REVOGADO recebia
    // `ok dispositivo registrado` e, na camada do tunel, a dica
    // "rode: kof cloud connect" — que o Edge recusa com DEVICE_REVOKED
    // (fatal no Agent). A dica certa para revogado e re-registrar (REVOKED e
    // terminal); para suspenso, o unsuspend (reversivel).
    var revoked = doctorDeviceLine("REVOKED")
    assert(revoked.startsWith("FALHA dispositivo"), "revogado e FALHA")
    assert(revoked.indexOf("revogado") >= 0, "nomeia a causa")
    assert(revoked.indexOf("login --device") >= 0, "aponta o re-registro")
    assert(revoked.indexOf("connect") < 0, "nunca sugere connect (seria recusado)")

    var suspended = doctorDeviceLine("SUSPENDED")
    assert(suspended.startsWith("FALHA dispositivo"), "suspenso e FALHA")
    assert(suspended.indexOf("unsuspend") >= 0, "aponta o unsuspend")

    var active = doctorDeviceLine("ACTIVE")
    assert(active.startsWith("ok"), "ativo segue ok")

    // Trava de fonte: o doctorCheck consulta o status do device e delega na
    // linha pura (sem captura de stdout no runner).
    var raw = File("src/kofcloud/cli/Doctor.kf").readText()
    var text = ""
    if (raw != null) {
        text = raw
    }
    if (text.length == 0) {
        return
    }
    var start = text.indexOf("DoctorReport doctorCheckWith(")
    var end = text.indexOf("Int cmdDoctor(", start)
    if (end < 0) {
        end = text.length
    }
    var body = text.substring(start, end)
    assert(body.indexOf("doctorDeviceLine(") >= 0, "doctorCheck usa a linha pura")
    assert(body.indexOf("deviceStatus = device.status") >= 0, "le o ciclo de vida da lista")
    assert(body.indexOf("dispositivo registrado (\" + identity.deviceId + \")") < 0, "nao imprime ok direto")
}

test "doctor: camada da auditoria decide sem rede nem HOME", "doctor-audit" {
    // Busca falhou (control plane caiu entre as camadas): FALHA, sem mentir.
    var failed = doctorAuditLine("", "KCF004: unauthorized")
    assert(failed.startsWith("FALHA auditoria"), "erro de busca e FALHA")
    assert(failed.indexOf("indisponivel") >= 0, "diz que nao deu para saber")
    // Corpo ilegivel (nao e o JSON do verify): FALHA, nao excecao.
    var garbage = doctorAuditLine("{lixo", "")
    assert(garbage.startsWith("FALHA auditoria"), "lixo e FALHA")
    assert(garbage.indexOf("inesperada") >= 0, "aponta a resposta")
    // Tudo integro (anel + espelho) no formato real do fio.
    var healthy = doctorAuditLine("{\"ok\":\"true\",\"brokenAt\":\"\",\"events\":\"7\",\"mirrorOk\":\"true\",\"mirrorBrokenAt\":\"\",\"mirrorEvents\":\"7\"}", "")
    assert(healthy.startsWith("ok"), "integro e ok")
    assert(healthy.indexOf("auditoria integra") >= 0, "rotula a camada")
    assert(healthy.indexOf("7 eventos") >= 0, "mostra a contagem")
    // Cadeia quebrada: FALHA com o indice e a orientacao de investigar.
    var broken = doctorAuditLine("{\"ok\":\"false\",\"brokenAt\":\"3\",\"events\":\"10\",\"mirrorOk\":\"true\",\"mirrorBrokenAt\":\"\",\"mirrorEvents\":\"10\"}", "")
    assert(broken.startsWith("FALHA auditoria"), "cadeia quebrada e FALHA")
    assert(broken.indexOf("3") >= 0, "diz o indice")
    assert(broken.indexOf("investigue") >= 0, "orienta o operador")
    assert(broken.indexOf("audit --verify") >= 0, "aponta o detalhe")
    // Espelho comprometido com anel integro: FALHA propria, nao ok manchado.
    var mirrorDown = doctorAuditLine("{\"ok\":\"true\",\"brokenAt\":\"\",\"events\":\"2\",\"mirrorOk\":\"false\",\"mirrorBrokenAt\":\"1\",\"mirrorEvents\":\"2\"}", "")
    assert(mirrorDown.startsWith("FALHA auditoria"), "espelho ruim e FALHA")
    assert(mirrorDown.indexOf("espelho comprometido") >= 0, "nomeia o espelho")
    assert(mirrorDown.indexOf("1") >= 0, "diz o indice")
    // Control plane antigo (sem os campos do espelho): ok honesto, sem FALHA
    // nem mentira "integra" para o espelho.
    var legacy = doctorAuditLine("{\"ok\":\"true\",\"brokenAt\":\"\",\"events\":\"4\"}", "")
    assert(legacy.startsWith("ok"), "anel ok e ok")
    assert(legacy.indexOf("espelho nao reportado") >= 0, "diz que nao sabe do espelho")
}

test "doctor: camada da auditoria contra o endpoint real", "doctor-audit" {
    // O puro decide sobre o corpo REAL do /v1/audit/verify: integro agora,
    // FALHA depois de truncar o espelho no disco (sem tocar a API/o anel).
    var controlPort = 19964
    var path = "/tmp/kofcloud-doctor-audit-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control plane no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var accountToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    assert(statusOf(httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pubkey\"}", accountToken)) == 200, "device criado")

    var before = doctorAuditLine(bodyOf(httpGetToken(controlPort, "/v1/audit/verify", accountToken)), "")
    assert(before.startsWith("ok"), "trilha integra e ok: " + before)
    assert(before.indexOf("2 eventos") >= 0, "conta os dois eventos: " + before)

    // Trunca a segunda linha do espelho no meio: o fiel (anel) segue
    // integro, mas o espelho deixa de decodificar — verify real acusa.
    var raw = readTextOr(path + ".worm.jsonl", "")
    var firstBreak = raw.indexOf("\n")
    var second = raw.substring(firstBreak + 1, raw.length)
    var half = second.substring(0, second.length - (second.length / 2))
    writeTextTo(path + ".worm.jsonl", raw.substring(0, firstBreak + 1) + half + "\n")
    var verify = bodyOf(httpGetToken(controlPort, "/v1/audit/verify", accountToken))
    assert(verify.indexOf("\"ok\":\"true\"") >= 0, "anel segue integro")
    assert(verify.indexOf("\"mirrorOk\":\"false\"") >= 0, "espelho real quebrou")
    var after = doctorAuditLine(verify, "")
    assert(after.startsWith("FALHA auditoria"), "espelho truncado e FALHA: " + after)
    assert(after.indexOf("espelho comprometido") >= 0, "nomeia o espelho")
    assert(after.indexOf("parse") >= 0, "diz o indice de parse")
}

test "doctor: camada da credencial da conta decide sem rede nem HOME", "doctor-cred" {
    // Pura, sem rede nem HOME (precedente: doctorAuditLine): o doctor le o
    // MESMO sinal do fio que o `token list` (campo aditivo `expiring`,
    // fonte unica `nearAccountTokenExpiry` no control plane) — nunca
    // re-deriva com relogio proprio. Expira em breve e FALHA com a acao
    // (mesmo padrao do PEM a 30 dias); a janela citada vem do mesmo Limits
    // do aviso do CLI, derivada — nao copiada.
    assert(doctorAccountTokenLine("", "boom").indexOf("indisponivel") >= 0, "busca falha: indisponivel")
    assert(doctorAccountTokenLine("lixo {", "").indexOf("inesperada") >= 0, "resposta ilegivel")
    var okLine = doctorAccountTokenLine("[{\"id\":\"a1\",\"createdAt\":\"1\"},{\"id\":\"b2\",\"createdAt\":\"1\",\"expiresAt\":\"9\"}]", "")
    assert(okLine.startsWith("ok"), "sem expiring: ok: " + okLine)
    assert(okLine.indexOf("kfc_") < 0, "linha ok nao vaza valor")
    var hours = intToString((limitTokenExpiryWarnMs() / 3600000L) as Int)
    var warn = doctorAccountTokenLine("[{\"id\":\"a1\",\"createdAt\":\"1\",\"expiresAt\":\"2\",\"expiring\":\"true\"}]", "")
    assert(warn.startsWith("FALHA"), "expirando: FALHA: " + warn)
    assert(warn.indexOf("token rotate") >= 0, "orienta o rotate: " + warn)
    assert(warn.indexOf(hours + "h") >= 0, "janela derivada da fonte unica: " + warn)
    assert(warn.indexOf("kfc_") < 0, "FALHA nao vaza valor")
    var two = doctorAccountTokenLine("[{\"id\":\"a\",\"createdAt\":\"1\",\"expiring\":\"true\"},{\"id\":\"b\",\"createdAt\":\"1\",\"expiring\":\"true\"}]", "")
    assert(two.indexOf("2 credencial") >= 0, "conta as duas: " + two)
    var mixed = doctorAccountTokenLine("[{\"id\":\"a\",\"createdAt\":\"1\"},{\"id\":\"b\",\"createdAt\":\"1\",\"expiresAt\":\"2\",\"expiring\":\"true\"}]", "")
    assert(mixed.startsWith("FALHA"), "uma expirando basta: " + mixed)
    assert(mixed.indexOf("1 credencial") >= 0, "conta so a expirando: " + mixed)
    assert(doctorAccountTokenLine("[]", "").startsWith("ok"), "lista vazia nao inventa FALHA")
    var forever = doctorAccountTokenLine("[{\"id\":\"a\",\"createdAt\":\"1\",\"expiresAt\":\"2524608000000\"}]", "")
    assert(forever.startsWith("ok"), "longa fora da janela segue ok: " + forever)
}

test "doctor: camada da credencial contra o endpoint real", "doctor-cred" {
    // Fio real (precedente: doctor-audit e2e): rotaciona com TTL curto para
    // a nova credencial cair na janela e a camada acusar — sem isso, seria
    // so teste de string. A conta antiga do teste (sem TTL) segue ok.
    var controlPort = 19965
    var registry = Registry("/tmp/kofcloud-doctor-cred-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control plane no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var accountToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    assert(statusOf(httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pubkey\"}", accountToken)) == 200, "device criado")
    var longList = bodyOf(httpGetToken(controlPort, "/v1/tokens", accountToken))
    assert(countTokenExpiring(longList) == 0, "sem TTL: nenhum sinal: " + longList)
    assert(doctorAccountTokenLine(longList, "").startsWith("ok"), "sem TTL: ok")

    var rotated = httpPostJson(controlPort, "/v1/tokens/rotate", "{\"ttlHours\":\"24\"}", accountToken)
    assert(statusOf(rotated) == 200, "rotate 200")
    var fresh = mapField(json.decode<Map<String, String>>(bodyOf(rotated)), "token")
    var listed = bodyOf(httpGetToken(controlPort, "/v1/tokens", fresh))
    // O fio real carrega o sinal na entrada nova (TTL 24h < janela de 7
    // dias), mas nao na antiga (sem TTL): a camada conta exatamente uma.
    assert(countTokenExpiring(listed) == 1, "uma expirando no fio real: " + listed)
    var line = doctorAccountTokenLine(listed, "")
    assert(line.startsWith("FALHA"), "fio real com TTL curto: FALHA: " + line)
    assert(line.indexOf("1 credencial") >= 0, "conta so a nova: " + line)
}
test "doctor: aviso de kfs_ perto do fim por servico (mesma fonte do --check)", "doctor-kfs" {
    // Camada de aviso do doctor sobre a credencial de SERVICO (a camada
    // doctor-cred cobre o kfc_ da conta): mesmo contrato do `check: aviso:`
    // do deploy --check — linha AVISO, nunca FALHA nem exit 1. A linha e
    // pura e delega a decisao a kfsExpiryCheckLine (o MESMO predicado do
    // token-list/service status); o doctor so busca e imprime.
    assert(doctorWarnLine("servico", "x").startsWith("AVISO"), "formato proprio")
    assert(doctorWarnLine("servico", "x").indexOf("FALHA") < 0, "aviso nao e falha")

    var window = limitTokenExpiryWarnMs()
    var now = 1000000000000L
    var calm = listOf<ServiceTokenEntry>()
    calm.add(ServiceTokenEntry("svc", "a1b2c3d4", "1700000000000", longToString(now + window + 86400000L)))
    assert(kfsExpiryCheckLine("api", calm, longToString(now)) == "", "fora da janela: sem linha")

    var hot = listOf<ServiceTokenEntry>()
    hot.add(ServiceTokenEntry("svc", "a1b2c3d4", "1700000000000", longToString(now + window - 1000L)))
    var line = doctorWarnLine("servico", kfsExpiryCheckLine("api", hot, longToString(now)))
    assert(line.startsWith("AVISO"), "perto do fim: AVISO: " + line)
    assert(line.indexOf("api:") >= 0, "nomeia o servico: " + line)
    assert(line.indexOf("service rotate api") >= 0, "orienta a rotacao: " + line)
    assert(line.indexOf("a1b2c3d4") < 0, "nao vaza nem o id curto")

    var text = File("src/kofcloud/cli/Doctor.kf").readText()
    var raw = ""
    if (text != null) {
        raw = text
    }
    if (raw.length == 0) {
        return
    }
    var start = raw.indexOf("DoctorReport doctorCheckWith(")
    assert(start >= 0, "acha o doctorCheckWith")
    var end = raw.indexOf("Int cmdDoctor(", start)
    assert(end > start, "acha o fim do doctorCheckWith")
    var body = raw.substring(start, end)
    // Ancora de indentacao (mesma tecnica do deploy-kfswarn): o laco do
    // aviso corre INCONDICIONALMENTE no nivel do corpo (4 espacos) e a
    // linha AVISO entra antes das ok — dead-code wrap re-indenta e a
    // trava fica vermelha (lacuna real do 2af856a, agora coberta).
    assert(body.indexOf("\n    for (var warn in kfsExpiryWarningsFor(session.controlUrl, session.token, wanted, identity.deviceId, now)) {") >= 0, "doctor consulta os avisos no nivel do corpo")
    assert(body.indexOf("doctorWarnLine(\"servico\", warn)") >= 0, "doctor imprime a linha de aviso")
    assert(body.indexOf("doctorWarnLine(\"servico\", warn)") < body.indexOf("doctorOkLine(service.name"), "aviso antes das linhas ok")

    // Fio real (precedente doctor-cred e2e): AUTHENTICATED com kfs_ de 1h
    // vira AVISO; PUBLIC mesmo com token alheio na conta nao tem o que
    // vencer e silencia. Publicado NESTE device (o varredor e por device).
    var controlPort = 19985
    var registry = Registry("/tmp/kofcloud-doctor-kfs-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control plane no ar")
    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var accountToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pubkey\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var authBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"api\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"19986\",\"protocol\":\"http\",\"exposure\":\"AUTHENTICATED\"}"
    var pub = httpPostJson(controlPort, "/v1/services", authBody, accountToken)
    assert(statusOf(pub) == 200, "servico AUTHENTICATED publicado")
    var serviceId = mapField(json.decode<Map<String, String>>(bodyOf(pub)), "id")
    var controlUrl = "http://127.0.0.1:" + intToString(controlPort)
    var fioNow = longToString(time.now())
    var wanted = parseManifest("{\"services\":[{\"name\":\"api\",\"port\":19986,\"exposure\":\"AUTHENTICATED\"}]}")
    assert(kfsExpiryWarningsFor(controlUrl, accountToken, wanted, deviceId, fioNow).size == 0, "sem kfs_: sem aviso")
    var issue = httpPostJson(controlPort, "/v1/services/token", "{\"serviceId\":\"" + serviceId + "\",\"ttlHours\":\"1\"}", accountToken)
    assert(statusOf(issue) == 200, "kfs_ de 1h emitida")
    var warnings = kfsExpiryWarningsFor(controlUrl, accountToken, wanted, deviceId, fioNow)
    assert(warnings.size == 1, "um aviso no fio real: " + intToString(warnings.size))
    var wrapped = doctorWarnLine("servico", warnings.get(0))
    assert(wrapped.startsWith("AVISO"), "fio real: AVISO: " + wrapped)
    assert(wrapped.indexOf("api:") >= 0, "fio real nomeia o servico: " + wrapped)

    var pubBody2 = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"19987\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    assert(statusOf(httpPostJson(controlPort, "/v1/services", pubBody2, accountToken)) == 200, "servico PUBLIC publicado")
    var wantedPublic = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":19987}]}")
    assert(kfsExpiryWarningsFor(controlUrl, accountToken, wantedPublic, deviceId, fioNow).size == 0, "PUBLIC silencia mesmo com kfs_ na conta")
}

test "doctor: camada do control plane distingue estado ilegivel de fora do ar", "doctor-control" {
    // Medido: o health responde 503 com o estado ilegivel (F16 s3) e o
    // http.get LANCA em >=500 ("HTTP 503 from <url>") — o doctor traduzia
    // como "inacessivel ou fora do ar" e mandava o operador olhar rede
    // quando o problema era o ARQUIVO DE ESTADO.
    var corrupt = doctorControlLine("http://127.0.0.1:8080", "", "HTTP 503 from http://127.0.0.1:8080/v1/health")
    assert(corrupt.startsWith("FALHA control plane"), "503 e FALHA: " + corrupt)
    assert(corrupt.indexOf("503") >= 0, "nomeia o codigo")
    assert(corrupt.indexOf("ilegivel") >= 0, "nomeia o estado ilegivel: " + corrupt)
    assert(corrupt.indexOf("state-backup") >= 0, "aponta o backup")
    assert(corrupt.indexOf("fora do ar") < 0, "nunca diz fora do ar quando respondeu")

    // Falha de rede de verdade: "inacessivel", sem falar de estado.
    var down = doctorControlLine("http://127.0.0.1:8080", "", "kof.net: connect failed")
    assert(down.startsWith("FALHA control plane"), "rede e FALHA")
    assert(down.indexOf("inacessivel") >= 0, "rede = inacessivel")
    assert(down.indexOf("ilegivel") < 0, "rede nao inventa estado")

    // Corpo sem "ok" (control estranho/proxy): resposta inesperada, nunca verde.
    var weird = doctorControlLine("http://c", "<html>", "")
    assert(weird.indexOf("resposta inesperada") >= 0, "corpo estranho: " + weird)

    // Saudavel: ok com a URL, sem conta nem credencial.
    var good = doctorControlLine("http://127.0.0.1:8080", "{\"ok\":\"true\",\"ready\":\"true\"}", "")
    assert(good == "ok   control plane (http://127.0.0.1:8080)", "saudavel: " + good)
    assert(good.indexOf("kfc_") < 0, "sem credencial")

    // e2e: control real com estado ilegivel — a linha diz estado, nao rede.
    var port = 19988
    var path = "/tmp/kofcloud-docctl-" + crypto.randomHex(4) + ".json"
    writeTextTo(path, "{ isto nao e estado }")
    var registry = Registry(path)
    assert(registry.loadStatus == "corrupt", "estado ilegivel na partida")
    var control = ControlPlane(registry, port, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(port, 60), "control no ar")
    var body = ""
    var err = ""
    try {
        body = http.get("http://127.0.0.1:" + intToString(port) + "/v1/health")
    } catch (String e) {
        err = e
    }
    var line = doctorControlLine("http://127.0.0.1:" + intToString(port), body, err)
    assert(err.indexOf("503") >= 0, "e2e: http.get lanca 503: " + err)
    assert(line.indexOf("ilegivel") >= 0, "e2e: a camada nomeia o estado: " + line)
}
