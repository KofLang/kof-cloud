import kofcloud.agent.Agent
import kofcloud.cli.Commands
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.edge.EdgeState
import kofcloud.edge.HttpFront
import kofcloud.edge.Tunnel
import kofcloud.model.Device
import kofcloud.store.Store
import kofcloud.util.Limits
import testkit.Support

// Presença do dispositivo no `device list`.
//
// A lista mostrava só o status de cadastro (ACTIVE/REVOKED/SUSPENDED) — diz
// se o device existe, nunca se ele está CONECTADO. Para responder "este
// notebook está no ar?" o operador precisava cruzar `status` + `presence`;
// agora a linha traz a presença REAL confirmada pelo Edge, com a mesma regra
// do `status` e do `doctor`. Consulta falhou = "desconhecido", nunca um
// OFFLINE inventado.

Device deviceFixture(String id, String name, String status) {
    return Device(id, "acc-1", name, "pk", status, 0L, 0L)
}

test "device list: presenca por linha, falha nao vira OFFLINE", "devpresence-unit" {
    var online = deviceFixture("dev-111", "notebook", "ACTIVE")
    var offline = deviceFixture("dev-222", "servidor", "ACTIVE")
    var suspended = deviceFixture("dev-333", "antigo", "SUSPENDED")
    var presence = "[\"dev-111\"]"

    var l1 = deviceListLine(online, presence, "")
    need(l1.indexOf("notebook") == 0, "falhou")
    need(l1.indexOf("dev-111") >= 0, "falhou")
    need(l1.indexOf("ACTIVE") >= 0, "falhou")
    need(l1.indexOf("tunel: ONLINE") >= 0, "falhou")

    var l2 = deviceListLine(offline, presence, "")
    need(l2.indexOf("tunel: OFFLINE") >= 0, "falhou")

    // Suspenso continua com o cadastro visivel (a presenca e outro eixo).
    var l3 = deviceListLine(suspended, presence, "")
    need(l3.indexOf("SUSPENDED") >= 0, "falhou")
    need(l3.indexOf("tunel: OFFLINE") >= 0, "falhou")

    // Falha na consulta: nao inventa OFFLINE (nem ONLINE).
    var l4 = deviceListLine(online, "", "falha de rede")
    need(l4.indexOf("tunel: desconhecido") >= 0, "falhou")
    need(l4.indexOf("tunel: ONLINE") < 0, "falhou")
    need(l4.indexOf("tunel: OFFLINE") < 0, "falhou")

    // Id vazio nunca casa por engano: bodyContainsId("") devolve false, entao
    // a linha cai em OFFLINE em vez de "encontrar" o id vazio na lista.
    need(deviceListLine(deviceFixture("", "x", "ACTIVE"), "[\"\"]", "").indexOf("tunel: OFFLINE") >= 0, "falhou")
}

test "device list: fim a fim mostra ONLINE com tunel vivo e OFFLINE sem", "devpresence" {
    var controlPort = 20061
    var tunnelPort = 20062

    var registry = Registry("/tmp/kofcloud-dp-" + crypto.randomHex(4) + ".json")
    var edgeState = EdgeState(registry)
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    var controlTask = spawn { control.start() }
    var edgeStop = "/tmp/kofcloud-dp-edge-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, "", edgeStop) }
    need(waitForPort(controlPort, 60), "falhou")
    need(waitForPort(tunnelPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var account = json.decode<Map<String, String>>(bodyOf(created))
    var accountToken = mapField(account, "token")
    var accountId = mapField(account, "accountId")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pubkey\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")

    // Antes do connect: presenca vazia -> OFFLINE.
    var presenceBefore = httpGetToken(controlPort, "/v1/presence", accountToken)
    need(statusOf(presenceBefore) == 200, "falhou")
    var device = Device(deviceId, accountId, "notebook", "pubkey", "ACTIVE", 0L, 0L)
    var before = deviceListLine(device, bodyOf(presenceBefore), "")
    need(before.indexOf("tunel: OFFLINE") >= 0, "falhou")

    // Com o Agent conectado: ONLINE.
    var agentStop = "/tmp/kofcloud-dp-agent-" + crypto.randomHex(4) + ".txt"
    File(agentStop).delete()
    var config = AgentConfig("http://127.0.0.1:" + intToString(controlPort), deviceId, accountId, accountToken, "", agentStop, "127.0.0.1", tunnelPort, 100)
    var agentTask = spawn { runAgent(config, true) }
    var online = false
    var attempts = 100
    while (attempts > 0 && online == false) {
        online = edgeState.isOnline(deviceId)
        if (online == false) {
            time.sleep(50)
            attempts = attempts - 1
        }
    }
    need(online, "falhou")
    var presenceAfter = httpGetToken(controlPort, "/v1/presence", accountToken)
    var after = deviceListLine(device, bodyOf(presenceAfter), "")
    need(after.indexOf("tunel: ONLINE") >= 0, "falhou")

    writeTextTo(agentStop, "stop")
    time.sleep(1500)
    writeTextTo(edgeStop, "stop")
    time.sleep(1000)
    File(agentStop).delete()
    File(edgeStop).delete()
}

test "status: presenca do device reflete o tunel (base do estado do agente)", "devpresence" {
    // O `cmdStatus` nao tem stdout capturavel no runner; aqui provamos a
    // BASE da decisao (a presenca real no Edge muda), e o teste abaixo trava
    // que o cmdStatus delega em `agentStatusLine` em vez de olhar o stopFile.
    var controlPort = 20235
    var registry = Registry("/tmp/kofcloud-dp2-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")
    var url = "http://127.0.0.1:" + intToString(controlPort)

    var token = loginOrCreate(url, "mel", "segredo")
    var deviceId = registerDevice(url, token, "notebook", "pk")
    var priorSession = readTextOr(sessionPath(), "")
    var priorIdentity = readTextOr(identityPath(), "")
    saveSession(LocalSession("", "mel", token, url))
    saveIdentity(LocalIdentity(deviceId, "", "mel", "notebook", "priv", "pub"))
    File(stopPath()).delete()

    // Sem sessao no Edge: PARADO (mesmo sem stopFile).
    var presenceBefore = bodyOf(httpGetToken(controlPort, "/v1/presence", token))
    need(bodyContainsId(presenceBefore, deviceId) == false, "falhou")
    need(fileExists(stopPath()) == false, "falhou")

    // Com sessao viva: ATIVO.
    registry.noteEdgeOnline(deviceId, true)
    var presenceAfter = bodyOf(httpGetToken(controlPort, "/v1/presence", token))
    need(bodyContainsId(presenceAfter, deviceId), "falhou")

    if (priorSession.length == 0) {
        File(sessionPath()).delete()
    } else {
        writeTextTo(sessionPath(), priorSession)
    }
    if (priorIdentity.length == 0) {
        File(identityPath()).delete()
    } else {
        writeTextTo(identityPath(), priorIdentity)
    }
}

test "status: agentStatusLine decide pelos tres sinais", "devpresence-unit" {
    // Tunel vivo manda em tudo.
    need(agentStatusLine(true, true, false).startsWith("ATIVO"), "falhou")
    need(agentStatusLine(true, true, true).startsWith("ATIVO"), "falhou")
    // Sem presenca consultavel: desconhecido (nunca inventa).
    need(agentStatusLine(false, false, false).startsWith("desconhecido"), "falhou")
    need(agentStatusLine(false, false, true).startsWith("desconhecido"), "falhou")
    // Sem tunel e com presenca conhecida: PARADO, distinguindo a causa.
    need(agentStatusLine(false, true, true).indexOf("parada pedida") >= 0, "falhou")
    var never = agentStatusLine(false, true, false)
    need(never.startsWith("PARADO"), "falhou")
    need(never.indexOf("kof cloud connect") >= 0, "falhou")
}

test "status: cmdStatus deriva o agente de agentStatusLine (trava de fonte)", "devpresence-unit" {
    // Sem captura de stdout, a unica forma de impedir a regressao antiga
    // (decidir pelo stopFile) e ler a fonte: o bloco de status precisa
    // chamar `agentStatusLine`, e nao mais imprimir ATIVO por ausencia de
    // stopFile.
    var raw = File("src/kofcloud/cli/Commands.kf").readText()
    var text = ""
    if (raw != null) {
        text = raw
    }
    if (text.length == 0) {
        return
    }
    var start = text.indexOf("Int cmdStatus(")
    var end = text.indexOf("// ---- dispositivos ----", start)
    if (end < 0) {
        end = text.length
    }
    var body = text.substring(start, end)
    need(body.indexOf("agentStatusLine(") >= 0, "falhou")
    need(body.indexOf("Agente:       ATIVO") < 0, "falhou")
}
