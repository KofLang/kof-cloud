import testkit.Support

// Fase 17 slice 1 — deteccao e severidade.
// Incidente = sinal com nivel, aberto por detector, fechado pelo operador.
// Nunca carrega dado de cliente: so kind, severidade, escopo e resumo fixo.

String incidentsPath(String name) {
    return "/tmp/kofcloud-inc-" + name + "-" + crypto.randomHex(4) + ".json"
}

test "incidentes: severidade e resumo por sinal", "incident-unit" {
    assert(incidentSeverityFor(incidentBulkDeviceRevokes()) == "CRIT", "revoke em lote de device e CRIT")
    assert(incidentSeverityFor(incidentBulkTokenRevokes()) == "WARN", "token e WARN")
    assert(incidentSeverityFor(incidentEdgeRefusals()) == "WARN", "edge e WARN")
    assert(incidentSeverityFor("desconhecido") == "INFO", "desconhecido e INFO")
    assert(incidentSummaryFor(incidentBulkDeviceRevokes()).length > 0, "resumo presente")
    assert(severityIsKnown("CRIT"), "CRIT conhecido")
    assert(severityIsKnown("nada") == false, "desconhecida recusada")
    // Anel de incidentes na fonte unica (`util/Limits.kf`): valor travado +
    // delegacao (mudar o default no Limits muda o anel — mutacao quebra).
    assert(limitIncidents() == 100, "anel de incidentes travado em 100")
    assert(limitIncidents() == limitIncidentRing(), "anel delega na fonte")
    // Detectores em fonte unica (`util/Limits.kf`, mesma familia de
    // `limitHeartbeatMs`/`limitIdleSweepMs`): valor travado + delegacao
    // (mudar o default no Limits muda o detector — mutacao quebra).
    assert(edgeRefusalThreshold() == 10, "limiar do edge travado")
    assert(edgeRefusalThreshold() == limitEdgeRefusalThreshold(), "edge delega na fonte")
    assert(edgeRefusalWindowMs() == 60000, "janela do edge travada")
    assert(edgeRefusalWindowMs() == limitEdgeRefusalWindowMs(), "janela delega na fonte")
    assert(bulkRevokeThreshold() == 3, "limiar de lote travado")
    assert(bulkRevokeThreshold() == limitBulkRevokeThreshold(), "lote delega na fonte")
    assert(bulkRevokeWindowMs() == 60000, "janela de lote travada")
    assert(bulkRevokeWindowMs() == limitBulkRevokeWindowMs(), "janela de lote delega na fonte")
    assert(incidentSeverityFor(incidentEdgeAuthFailures()) == "WARN", "401 em rajada e WARN")
    assert(incidentSummaryFor(incidentEdgeAuthFailures()).length > 0, "resumo do 401 presente")
    assert(edgeAuthFailureThreshold() == 25, "limiar de 401 travado")
    assert(edgeAuthFailureThreshold() == limitEdgeAuthFailureThreshold(), "401 delega na fonte")
    assert(edgeAuthFailureWindowMs() == 60000, "janela de 401 travada")
    assert(edgeAuthFailureWindowMs() == limitEdgeAuthFailureWindowMs(), "janela de 401 delega na fonte")
    // Sinais distintos: vocabulario fechado, mesmo nivel por desenho.
    assert(incidentEdgeAuthFailures() != incidentEdgeRefusals(), "sinais separados")
    assert(incidentSeverityFor(incidentEdgeAuthFailures()) == incidentSeverityFor(incidentEdgeRefusals()), "mesmo nivel")
    // Edge sem heartbeat: quedas por ociosidade repetidas. Limiar baixo
    // (cada queda e um tunel que caiu de verdade) e janela folgada (300 s).
    assert(incidentSeverityFor(incidentEdgeIdleTimeouts()) == "WARN", "quedas por ociosidade e WARN")
    assert(incidentSummaryFor(incidentEdgeIdleTimeouts()).length > 0, "resumo das quedas presente")
    assert(edgeIdleTimeoutThreshold() == 5, "limiar de ociosidade travado")
    assert(edgeIdleTimeoutThreshold() == limitEdgeIdleTimeoutThreshold(), "ociosidade delega na fonte")
    assert(edgeIdleTimeoutWindowMs() == 300000, "janela de ociosidade travada")
    assert(edgeIdleTimeoutWindowMs() == limitEdgeIdleTimeoutWindowMs(), "janela de ociosidade delega na fonte")
    assert(incidentEdgeIdleTimeouts() != incidentEdgeRefusals(), "ociosidade separada das recusas")
    assert(incidentEdgeIdleTimeouts() != incidentEdgeAuthFailures(), "ociosidade separada do 401")
    // Expiracao em massa de kfs_: detector por conta, nao por Edge. Limiar e
    // janela proprios (um vencimento isolado e rotina da rotacao por TTL).
    assert(incidentSeverityFor(incidentMassTokenExpiry()) == "WARN", "expiracao em massa e WARN")
    assert(incidentSummaryFor(incidentMassTokenExpiry()).length > 0, "resumo da expiracao presente")
    assert(limitMassTokenExpiryThreshold() == 3, "limiar de expiracao travado")
    assert(limitMassTokenExpiryWindowMs() == 300000, "janela de expiracao travada")
    assert(errIncidentNotFound().indexOf("KCF125") >= 0, "codigo KCF125")
    assert(errHint(errIncidentNotFound()).length > 0, "Hint presente")
}

test "incidentes: abrir e idempotente por (sinal, conta)", "incident-unit" {
    var registry = Registry(incidentsPath("idem"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var first = registry.raiseIncident(incidentBulkTokenRevokes(), account.id)
    assert(first != null, "abre")
    if (first != null) {
        assert(first.severity == "WARN", "severidade do sinal")
        assert(first.resolvedAt == 0, "aberto")
    }
    var second = registry.raiseIncident(incidentBulkTokenRevokes(), account.id)
    assert(second == null, "nao duplica enquanto aberto")
    assert(registry.incidentsForAccount(account.id, true).size == 1, "um so")
}

test "incidentes: revogacao em lote abre incidente da conta", "incident-unit" {
    var registry = Registry(incidentsPath("bulk"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var d1 = registry.registerDevice(account, "d1", "pk")
    var d2 = registry.registerDevice(account, "d2", "pk")
    var d3 = registry.registerDevice(account, "d3", "pk")
    var d4 = registry.registerDevice(account, "d4", "pk")

    registry.revokeDevice(account.id, d1.id)
    assert(registry.incidentsForAccount(account.id, true).size == 0, "uma ainda nao")
    registry.revokeDevice(account.id, d2.id)
    assert(registry.incidentsForAccount(account.id, true).size == 0, "duas ainda nao")
    registry.revokeDevice(account.id, d3.id)
    var list = registry.incidentsForAccount(account.id, true)
    assert(list.size == 1, "terceira abre (limiar 3)")
    if (list.size == 1) {
        assert(list.get(0).kind == incidentBulkDeviceRevokes(), "sinal certo")
        assert(list.get(0).severity == "CRIT", "CRIT")
    }
    registry.revokeDevice(account.id, d4.id)
    assert(registry.incidentsForAccount(account.id, true).size == 1, "nao duplica")
}

test "incidentes: resolver fecha e permite abrir de novo depois", "incident-unit" {
    var registry = Registry(incidentsPath("resolve"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var opened = registry.raiseIncident(incidentBulkDeviceRevokes(), account.id)
    assert(opened != null, "aberto")
    var id = ""
    if (opened != null) {
        id = opened.id
    }
    assert(registry.resolveIncident(id) == true, "fecha")
    assert(registry.resolveIncident(id) == false, "fechar de novo nao acha")
    var again = registry.raiseIncident(incidentBulkDeviceRevokes(), account.id)
    assert(again != null, "pode reabrir depois de resolvido")
}

test "incidentes: escopo global aparece para a conta, escopo alheio nao", "incident-unit" {
    var registry = Registry(incidentsPath("scope"))
    var mel = registry.createAccount("mel", "mel@e.com", "segredo")
    var ana = registry.createAccount("ana", "ana@e.com", "segredo")
    registry.raiseIncident(incidentEdgeRefusals(), "")
    registry.raiseIncident(incidentBulkTokenRevokes(), ana.id)

    assert(registry.incidentsForAccount(mel.id, true).size == 1, "mel ve o global")
    assert(registry.incidentsForAccount(mel.id, false).size == 0, "mel nao ve o de ana")
    assert(registry.incidentsForAccount(ana.id, false).size == 1, "ana ve o seu")
}

test "incidentes: HTTP lista, resolve e recusa incidente alheio", "incident" {
    var controlPort = 19861
    var registry = Registry(incidentsPath("http"))
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var melToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var mel = registry.accountByHandle("mel")
    var melId = ""
    if (mel != null) {
        melId = mel.id
    }
    var opened = registry.raiseIncident(incidentBulkDeviceRevokes(), melId)

    var listed = httpPostJson(controlPort, "/v1/incidents", "{}", melToken)
    assert(statusOf(listed) == 200, "lista 200")
    assert(bodyOf(listed).indexOf("bulk_device_revokes") >= 0, "sinal na lista")
    assert(bodyOf(listed).indexOf("CRIT") >= 0, "severidade na lista")

    var incidentId = ""
    if (opened != null) {
        incidentId = opened.id
    }
    var resolved = httpPostJson(controlPort, "/v1/incidents", "{\"resolveId\":\"" + incidentId + "\"}", melToken)
    assert(statusOf(resolved) == 200, "resolve 200")

    // Outra conta nao enxerga nem fecha o incidente de mel (404 opaco).
    var other = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"ana\",\"email\":\"a@e.com\",\"password\":\"segredo\"}", "")
    var anaToken = mapField(json.decode<Map<String, String>>(bodyOf(other)), "token")
    assert(statusOf(httpPostJson(controlPort, "/v1/incidents", "{\"resolveId\":\"" + incidentId + "\"}", anaToken)) == 404, "alheio 404")
    var anaList = httpPostJson(controlPort, "/v1/incidents", "{}", anaToken)
    assert(bodyOf(anaList).indexOf("bulk_device_revokes") < 0, "lista de ana nao mostra")
}

test "incidentes: rajada de recusas do Edge abre incidente global", "incident-edge" {
    // Amostra do Edge e por processo: o EdgeState carrega a sonda.
    var registry = Registry(incidentsPath("edge"))
    var edgeState = EdgeState(registry)
    edgeState.refusalProbe.count = edgeRefusalThreshold() - 1
    edgeState.refusalProbe.windowStart = time.now()
    noteEdgeRefusalIncident(edgeState)
    var list = registry.incidentsForAccount("", true)
    assert(list.size == 1, "limiar abre o global")
    if (list.size == 1) {
        assert(list.get(0).kind == incidentEdgeRefusals(), "sinal do edge")
        assert(list.get(0).accountId.length == 0, "escopo global")
        assert(list.get(0).severity == "WARN", "WARN")
    }
    // Abaixo do limiar nao abre.
    var fresh = EdgeState(Registry(incidentsPath("edge2")))
    noteEdgeRefusalIncident(fresh)
    assert(fresh.registry.allIncidents().size == 0, "uma recusa nao e incidente")
}

test "incidentes: rajada de 401 no Edge abre incidente, controlada nao", "incident-auth" {
    var registry = Registry(incidentsPath("auth"))
    var edgeState = EdgeState(registry)
    edgeState.authFailureProbe.count = edgeAuthFailureThreshold() - 1
    edgeState.authFailureProbe.windowStart = time.now()
    noteEdgeAuthFailureIncident(edgeState)
    var list = registry.incidentsForAccount("", true)
    assert(list.size == 1, "limiar de 401 abre o global")
    if (list.size == 1) {
        assert(list.get(0).kind == incidentEdgeAuthFailures(), "sinal do 401")
        assert(list.get(0).accountId.length == 0, "escopo global")
        assert(list.get(0).severity == "WARN", "WARN")
        // Privacidade: nada de hostname/token/caminho no resumo.
        assert(list.get(0).summary.indexOf("kfs_") < 0, "sem credencial no resumo")
        assert(list.get(0).summary.indexOf(".") < 0, "sem hostname no resumo")
    }

    // Uma rajada abaixo do limiar nao abre.
    var quiet = EdgeState(Registry(incidentsPath("auth2")))
    noteEdgeAuthFailureIncident(quiet)
    assert(quiet.registry.allIncidents().size == 0, "um 401 nao e incidente")

    // Sondas independentes: nutrir a de 401 nao antecipa a de recusas.
    var shared = EdgeState(Registry(incidentsPath("auth3")))
    shared.authFailureProbe.count = edgeAuthFailureThreshold() - 1
    noteEdgeAuthFailureIncident(shared)
    noteEdgeRefusalIncident(shared)
    var kinds = shared.registry.allIncidents()
    assert(kinds.size == 1, "recusa nao foi contada pela sonda de 401")
    if (kinds.size == 1) {
        assert(kinds.get(0).kind == incidentEdgeAuthFailures(), "so o sinal de 401 abriu")
    }

    // Janela vencida zera o contador (sonda cheia de antes nao abre agora).
    var stale = EdgeState(Registry(incidentsPath("auth4")))
    stale.authFailureProbe.count = edgeAuthFailureThreshold() - 1
    stale.authFailureProbe.windowStart = time.now() - edgeAuthFailureWindowMs() - 1000
    noteEdgeAuthFailureIncident(stale)
    assert(stale.registry.allIncidents().size == 0, "janela vencida reseta antes de contar")
}

test "incidentes: quedas por ociosidade no Edge abrem incidente próprio", "incident-idle" {
    var registry = Registry(incidentsPath("idle"))
    var edgeState = EdgeState(registry)
    edgeState.idleTimeoutProbe.count = edgeIdleTimeoutThreshold() - 1
    edgeState.idleTimeoutProbe.windowStart = time.now()
    noteEdgeIdleTimeoutIncident(edgeState)
    var list = registry.incidentsForAccount("", true)
    assert(list.size == 1, "limiar de quedas abre o global")
    if (list.size == 1) {
        assert(list.get(0).kind == incidentEdgeIdleTimeouts(), "sinal de ociosidade")
        assert(list.get(0).accountId.length == 0, "escopo global (sem device)")
        assert(list.get(0).severity == "WARN", "WARN")
        // Privacidade: o sinal nao carrega device, hostname nem token.
        assert(list.get(0).summary.indexOf(".") < 0, "sem hostname no resumo")
        assert(list.get(0).summary.indexOf("kfs_") < 0, "sem credencial no resumo")
    }

    // Uma queda isolada nao e incidente (Agent parado e rotina).
    var quiet = EdgeState(Registry(incidentsPath("idle2")))
    noteEdgeIdleTimeoutIncident(quiet)
    assert(quiet.registry.allIncidents().size == 0, "uma queda nao e incidente")

    // Sondas independentes: quedas nao antecipam recusas nem 401.
    var shared = EdgeState(Registry(incidentsPath("idle3")))
    shared.idleTimeoutProbe.count = edgeIdleTimeoutThreshold() - 1
    noteEdgeIdleTimeoutIncident(shared)
    noteEdgeRefusalIncident(shared)
    noteEdgeAuthFailureIncident(shared)
    var kinds = shared.registry.allIncidents()
    assert(kinds.size == 1, "so a sonda de ociosidade abriu")
    if (kinds.size == 1) {
        assert(kinds.get(0).kind == incidentEdgeIdleTimeouts(), "sinal de ociosidade")
    }
    assert(shared.refusalProbe.count == 1, "recusas contaram na propria sonda")
    assert(shared.authFailureProbe.count == 1, "401 contou na propria sonda")

    // Janela vencida zera o contador.
    var stale = EdgeState(Registry(incidentsPath("idle4")))
    stale.idleTimeoutProbe.count = edgeIdleTimeoutThreshold() - 1
    stale.idleTimeoutProbe.windowStart = time.now() - edgeIdleTimeoutWindowMs() - 1000
    noteEdgeIdleTimeoutIncident(stale)
    assert(stale.registry.allIncidents().size == 0, "janela vencida reseta antes de contar")
}

// Tunel caindo em massa (Fase 17 slice 1, ultimo sinal do desenho sem
// detector): sessao perdida por EOF abrupto do Agent — sem GOAWAY de
// despedida e sem decisao do proprio Edge. Uma perda e rotina (processo
// morto, rede instavel); varias na janela significam agentes caindo em
// lote. A marca `edgeClosed` separa saida que e decisao do Edge (sweeper
// de ociosidade, GOAWAY de parada) de perda de verdade.
test "incidentes: perda abrupta de tuneis no Edge abre incidente próprio", "incident-loss" {
    // Sinal e limites travados na fonte unica.
    assert(incidentSeverityFor(incidentEdgeTunnelLosses()) == "WARN", "perda em massa e WARN")
    assert(incidentSummaryFor(incidentEdgeTunnelLosses()).length > 0, "resumo presente")
    assert(limitEdgeTunnelLossThreshold() == 5, "limiar de perda travado")
    assert(limitEdgeTunnelLossWindowMs() == 300000, "janela de perda travada")
    assert(incidentEdgeTunnelLosses() != incidentEdgeIdleTimeouts(), "sinal distinto da ociosidade")
    assert(incidentSummaryFor(incidentEdgeTunnelLosses()) != incidentSummaryFor(incidentEdgeIdleTimeouts()), "resumos distintos")

    var registry = Registry(incidentsPath("loss"))
    var edgeState = EdgeState(registry)
    edgeState.tunnelLossProbe.count = edgeTunnelLossThreshold() - 1
    edgeState.tunnelLossProbe.windowStart = time.now()
    noteEdgeTunnelLossIncident(edgeState)
    var list = registry.incidentsForAccount("", true)
    assert(list.size == 1, "limiar de perdas abre o global")
    if (list.size == 1) {
        assert(list.get(0).kind == incidentEdgeTunnelLosses(), "sinal de perda")
        assert(list.get(0).accountId.length == 0, "escopo global (sem device)")
        assert(list.get(0).severity == "WARN", "WARN")
        // Privacidade: o sinal nao carrega device, hostname nem token.
        assert(list.get(0).summary.indexOf(".") < 0, "sem hostname no resumo")
        assert(list.get(0).summary.indexOf("kfs_") < 0, "sem credencial no resumo")
    }

    // Uma perda isolada nao e incidente (Agent morto e rotina).
    var quiet = EdgeState(Registry(incidentsPath("loss2")))
    noteEdgeTunnelLossIncident(quiet)
    assert(quiet.registry.allIncidents().size == 0, "uma perda nao e incidente")

    // Sondas independentes: perdas nao antecipam recusas, 401 nem ociosidade.
    var shared = EdgeState(Registry(incidentsPath("loss3")))
    shared.tunnelLossProbe.count = edgeTunnelLossThreshold() - 1
    noteEdgeTunnelLossIncident(shared)
    noteEdgeRefusalIncident(shared)
    noteEdgeAuthFailureIncident(shared)
    noteEdgeIdleTimeoutIncident(shared)
    var kinds = shared.registry.allIncidents()
    assert(kinds.size == 1, "so a sonda de perda abriu")
    if (kinds.size == 1) {
        assert(kinds.get(0).kind == incidentEdgeTunnelLosses(), "sinal de perda")
    }
    assert(shared.refusalProbe.count == 1, "recusas contaram na propria sonda")
    assert(shared.authFailureProbe.count == 1, "401 contou na propria sonda")
    assert(shared.idleTimeoutProbe.count == 1, "ociosidade contou na propria sonda")

    // Janela vencida zera o contador.
    var stale = EdgeState(Registry(incidentsPath("loss4")))
    stale.tunnelLossProbe.count = edgeTunnelLossThreshold() - 1
    stale.tunnelLossProbe.windowStart = time.now() - edgeTunnelLossWindowMs() - 1000
    noteEdgeTunnelLossIncident(stale)
    assert(stale.registry.allIncidents().size == 0, "janela vencida reseta antes de contar")

    // A marca nasce falsa: saida propria do Edge e excecao, nao regra.
    var session = TunnelSession("s1", "d1", "a1", "")
    assert(session.edgeClosed == false, "marca de fechamento proprio nasce falsa")

    // Trava com ANCORA de indentacao no wiring (tecnica do c330b8c): o EOF
    // so conta SEM a marca, com palavra e sonda no nivel do if; sweeper e
    // goaway marcam ANTES de fechar. Dead-code wrap re-indenta e fica
    // vermelho.
    var tunnelSrc = File("src/kofcloud/edge/Tunnel.kf").readText()
    var tunnelText = ""
    if (tunnelSrc != null) {
        tunnelText = tunnelSrc
    }
    assert(tunnelText.length > 0, "le o Tunnel.kf")
    var connStart = tunnelText.indexOf("void handleTunnelConnection(")
    assert(connStart >= 0, "acha o handler da conexao")
    var connEnd = tunnelText.indexOf("void tunnelIdleSweeper(", connStart)
    assert(connEnd > connStart, "acha o fim do handler")
    var connBody = tunnelText.substring(connStart, connEnd)
    var firstCall = connBody.indexOf("\n                tunnelDiedAbruptly(state, session)")
    assert(firstCall >= 0, "EOF de peer conta perda no nivel do if")
    var catchStart = connBody.indexOf("\n        } catch (String e) {", firstCall)
    assert(catchStart > firstCall, "leitura que lanca tem destino proprio")
    assert(connBody.indexOf("\n            tunnelDiedAbruptly(state, session)", catchStart) > catchStart, "excecao de leitura conta perda com a mesma marca")
    var helperStart = tunnelText.indexOf("void tunnelDiedAbruptly(")
    assert(helperStart > connStart, "acha o helper do fim abrupto")
    var helperEnd = tunnelText.indexOf("void noteEdgeTunnelLossIncident(", helperStart)
    assert(helperEnd > helperStart, "acha o fim do helper")
    var helperBody = tunnelText.substring(helperStart, helperEnd)
    assert(helperBody.indexOf("\n    if (session.edgeClosed == false) {") >= 0, "perda so sem a marca de fechamento proprio")
    assert(helperBody.indexOf("\n        edgeEvent(\"warn\", \"tunel perdido: EOF do agent (\" + intToString(state.onlineCount()) + \" sessao(oes) vivas)\")") >= 0, "perda deixa palavra no nivel do if")
    assert(helperBody.indexOf("\n        noteEdgeTunnelLossIncident(state)") >= 0, "perda alimenta a sonda no nivel do if")
    var sweepStart = tunnelText.indexOf("void tunnelIdleSweeper(")
    assert(sweepStart > connStart, "acha o sweeper")
    var sweepEnd = tunnelText.indexOf("Bool handleTunnelFrame(", sweepStart)
    assert(sweepEnd > sweepStart, "acha o fim do sweeper")
    var sweepBody = tunnelText.substring(sweepStart, sweepEnd)
    assert(sweepBody.indexOf("\n                session.edgeClosed = true") >= 0, "sweeper marca antes de fechar")
    var edgeSrc = File("src/kofcloud/edge/EdgeState.kf").readText()
    var edgeText = ""
    if (edgeSrc != null) {
        edgeText = edgeSrc
    }
    assert(edgeText.length > 0, "le o EdgeState.kf")
    var goawayStart = edgeText.indexOf("void goawayAll(")
    assert(goawayStart >= 0, "acha o goawayAll")
    var goawayEnd = edgeText.indexOf("Bool isOnline(", goawayStart)
    assert(goawayEnd > goawayStart, "acha o fim do goawayAll")
    var goawayBody = edgeText.substring(goawayStart, goawayEnd)
    assert(goawayBody.indexOf("\n            session.edgeClosed = true") >= 0, "parada limpa marca antes de fechar")
}

// Caminho REAL: um Agent valido que some sem GOAWAY (crash, rede, processo
// morto) conta perda e deixa palavra; parada limpa (stop -> GOAWAY) nao
// conta. Precedente de fixture: incident-auth-e2e (mesmo trio in-process).
test "incidentes: tunel perdido abruptamente abre incidente e deixa palavra", "incident-loss-e2e" {
    var controlPort = 20302
    var tunnelPort = 20303
    var httpPort = 20304

    var registry = Registry("/tmp/kofcloud-inc-loss-" + crypto.randomHex(4) + ".json")
    var edgeState = EdgeState(registry)
    var edgeStop = "/tmp/kofcloud-inc-loss-edge-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, "", edgeStop) }
    var httpTask = spawn { serveHttp(edgeState, httpPort, limitMaxBodyBytes(), edgeStop) }
    assert(waitForPort(controlPort, 60), "control no ar")
    assert(waitForPort(tunnelPort, 60), "tunel no ar")
    assert(waitForPort(httpPort, 60), "http no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var accountToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pubkey\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")

    // A sonda e pre-carregada para UMA perda fechar o limiar (5 EOFs de
    // verdade seriam lentos e flakys; o detector puro ja trava a contagem).
    edgeState.tunnelLossProbe.count = edgeTunnelLossThreshold() - 1
    edgeState.tunnelLossProbe.windowStart = time.now()

    // O Tunnel real grava em edgeRuntimeLogPath(): limpa antes do HELLO para
    // a palavra ser prova deste teste (precedente do edge_events_test).
    File(edgeRuntimeLogPath()).delete()

    var hello = mapOf()
    hello.put("kind", "HELLO")
    hello.put("v", intToString(protocolVersion()))
    hello.put("deviceId", deviceId)
    hello.put("token", accountToken)
    hello.put("clientPub", "")
    var conn = net.connect("127.0.0.1", tunnelPort)
    conn.send(bytesFromString(json.encode(hello) + "\n"))
    var online = false
    var attempts = 100
    while (attempts > 0 && online == false) {
        online = edgeState.isOnline(deviceId)
        if (online == false) {
            time.sleep(50)
            attempts = attempts - 1
        }
    }
    assert(online, "sessao registrada no edge")

    // Queda abrupta: fecha o socket sem GOAWAY — o laço de leitura recebe
    // EOF e, sem a marca, conta perda.
    conn.close()
    var offline = false
    var waits = 100
    while (waits > 0 && offline == false) {
        offline = edgeState.isOnline(deviceId) == false
        if (offline == false) {
            time.sleep(50)
            waits = waits - 1
        }
    }
    assert(offline, "sessao desregistrada apos o EOF")
    assert(edgeState.tunnelLossProbe.count == edgeTunnelLossThreshold(), "EOF abrupto contou na sonda")
    var incidents = registry.allIncidents()
    assert(incidents.size == 1, "limiar abre o global")
    if (incidents.size == 1) {
        assert(incidents.get(0).kind == incidentEdgeTunnelLosses(), "sinal da perda")
        assert(incidents.get(0).accountId.length == 0, "escopo global, nao da conta")
        assert(incidents.get(0).summary.indexOf("notebook") < 0, "sem nome de device no incidente")
    }
    var text = readTextOr(edgeRuntimeLogPath(), "")
    assert(text.indexOf("tunel perdido: EOF do agent (") >= 0, "perda deixa palavra no arquivo: " + text)
    assert(text.indexOf(deviceId) < 0, "o device da sessao perdida nao vaza para o arquivo")
    assert(text.indexOf("kfc_") < 0, "nenhum token vaza para o arquivo")

    // Parada limpa NAO e perda: segunda sessao fica viva, o stop manda
    // GOAWAY para todas (goawayAll marca antes de fechar) e o EOF que chega
    // depois nao alimenta a sonda nem duplica o incidente.
    var alive = mapOf()
    alive.put("kind", "HELLO")
    alive.put("v", intToString(protocolVersion()))
    alive.put("deviceId", deviceId)
    alive.put("token", accountToken)
    alive.put("clientPub", "")
    var conn2 = net.connect("127.0.0.1", tunnelPort)
    conn2.send(bytesFromString(json.encode(alive) + "\n"))
    var online2 = false
    var tries = 100
    while (tries > 0 && online2 == false) {
        online2 = edgeState.isOnline(deviceId)
        if (online2 == false) {
            time.sleep(50)
            tries = tries - 1
        }
    }
    assert(online2, "segunda sessao registrada")
    var before = edgeState.tunnelLossProbe.count
    var incidentCount = registry.allIncidents().size
    writeTextTo(edgeStop, "stop")
    var gone = false
    var waits2 = 100
    while (waits2 > 0 && gone == false) {
        gone = edgeState.isOnline(deviceId) == false
        if (gone == false) {
            time.sleep(50)
            waits2 = waits2 - 1
        }
    }
    assert(gone, "GOAWAY de parada desregistra")
    assert(edgeState.tunnelLossProbe.count == before, "GOAWAY de parada nao e perda")
    assert(registry.allIncidents().size == incidentCount, "parada limpa nao duplica incidente")
    conn2.close()

    assert(waitForPort(controlPort, 60), "encerra")
}

// Expiracao em massa de kfs_ (Fase 17 slice 1, ultimo sinal do desenho):

// Expiracao em massa de kfs_ (Fase 17 slice 1, ultimo sinal do desenho):
// a varredura preguicosa que poda credencial vencida alimenta a sonda da
// CONTA dona. Vencimento isolado e rotina da rotacao por TTL; varios na
// janela significam rotacao quebrada ou estado adulterado.
test "incidentes: expiração em massa de kfs_ abre incidente da conta", "incident-expiry" {
    // Sinal e limites travados na fonte unica.
    assert(incidentSeverityFor(incidentMassTokenExpiry()) == "WARN", "expiracao em massa e WARN")
    assert(incidentSummaryFor(incidentMassTokenExpiry()).length > 0, "resumo presente")
    assert(limitMassTokenExpiryThreshold() == 3, "limiar de expiracao travado")
    assert(limitMassTokenExpiryWindowMs() == 300000, "janela de expiracao travada")
    assert(incidentMassTokenExpiry() != incidentBulkTokenRevokes(), "sinal distinto do revoke em lote")
    assert(incidentSummaryFor(incidentMassTokenExpiry()) != incidentSummaryFor(incidentBulkTokenRevokes()), "resumos distintos")

    // Detector puro: abaixo do limiar nao abre; no limiar abre; idempotente.
    var registry = Registry(incidentsPath("expiry"))
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    assert(registry.detectMassTokenExpiry(mel.id, time.now(), 1) == null, "uma vencida nao abre")
    assert(registry.allIncidents().size == 0, "nada aberto ainda")
    assert(registry.detectMassTokenExpiry(mel.id, time.now(), 1) == null, "duas vencidas nao abrem")
    var opened = registry.detectMassTokenExpiry(mel.id, time.now(), 1)
    assert(opened != null, "terceira fecha o limiar")
    if (opened != null) {
        assert(opened.kind == incidentMassTokenExpiry(), "sinal da expiracao")
        assert(opened.accountId == mel.id, "escopo da conta dona")
        assert(opened.severity == "WARN", "WARN")
        assert(opened.summary.indexOf("kfs_") < 0, "sem credencial no resumo")
        assert(opened.summary.indexOf("mel") < 0, "sem handle no resumo")
    }
    var again = registry.detectMassTokenExpiry(mel.id, time.now(), 1)
    assert(again == null, "acima do limiar nao duplica")
    assert(registry.incidentsForAccount(mel.id, true).size == 1, "um incidente so")

    // Janela vencida reseta: nao carrega contagem antiga para a proxima.
    var stale = Registry(incidentsPath("expiry2"))
    var ana = stale.createAccount("ana", "a@e.com", "segredo")
    stale.detectMassTokenExpiry(ana.id, time.now() - limitMassTokenExpiryWindowMs() - 1000, 2)
    assert(stale.allIncidents().size == 0, "janela vencida nao soma")
    assert(stale.detectMassTokenExpiry(ana.id, time.now(), 2) == null, "2 apos reset ainda nao abre")
    assert(stale.detectMassTokenExpiry(ana.id, time.now(), 1) != null, "3 apos reset abre")

    // Contas isoladas: uma conta vencendo nao conta para outra.
    var both = Registry(incidentsPath("expiry3"))
    var um = both.createAccount("uma", "uma@e.com", "segredo")
    var dois = both.createAccount("duas", "duas@e.com", "segredo")
    both.detectMassTokenExpiry(um.id, time.now(), 2)
    assert(both.detectMassTokenExpiry(dois.id, time.now(), 1) == null, "sondas por conta sao separadas")
    assert(both.allIncidents().size == 0, "nada aberto com 2+1 em contas diferentes")
}

// Caminho REAL: a varredura preguicosa de `serviceByServiceToken` e quem
// descobre o vencimento; ela tem que atribuir a conta dona e abrir o
// incidente dela — nao do vizinho, e sem carregar token nem servico.
test "incidentes: varredura preguicosa de kfs_ abre o incidente da conta certa", "incident-expiry-sweep" {
    var registry = Registry(incidentsPath("expirysw"))
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var ana = registry.createAccount("ana", "a@e.com", "segredo")
    var melDev = registry.registerDevice(mel, "nb", "pk")
    var anaDev = registry.registerDevice(ana, "nb", "pk")
    var melSvc = registry.publishService(mel, melDev.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED", "", "")
    var anaSvc = registry.publishService(ana, anaDev.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED", "", "")

    // Duas credenciais vencidas de mel e uma de ana, construidas no passado
    // (sem dormir TTL). Hash so — o valor em claro nunca e persistido.
    var past = time.now() - 1000
    var stale = time.now() - 1
    registry.serviceTokens.add(ServiceToken(melSvc.id, mel.id, tokenHash("kfs_mel_1"), past, stale))
    registry.serviceTokens.add(ServiceToken(melSvc.id, mel.id, tokenHash("kfs_mel_2"), past, stale))
    registry.serviceTokens.add(ServiceToken(anaSvc.id, ana.id, tokenHash("kfs_ana_1"), past, stale))

    // Qualquer validacao dispara a varredura. Um token inexistente ja basta.
    assert(registry.serviceByServiceToken("kfs_nao_existe") == null, "token invalido nao resolve")
    // mel tem 2 vencidas na janela: abaixo do limiar (3), nada abre.
    assert(registry.allIncidents().size == 0, "duas vencidas de mel nao abrem")
    assert(registry.incidentsForAccount(ana.id, false).size == 0, "uma vencida de ana nao abre")

    // Mais uma credencial vencida de mel: a proxima varredura fecha o limiar.
    registry.serviceTokens.add(ServiceToken(melSvc.id, mel.id, tokenHash("kfs_mel_3"), past, stale))
    assert(registry.serviceByServiceToken("kfs_nao_existe") == null, "varredura roda de novo")
    var melIncidents = registry.incidentsForAccount(mel.id, false)
    assert(melIncidents.size == 1, "terceira vencida de mel abre o incidente da conta")
    if (melIncidents.size == 1) {
        assert(melIncidents.get(0).kind == incidentMassTokenExpiry(), "sinal certo")
        assert(melIncidents.get(0).severity == "WARN", "WARN")
        // Privacidade: nem servico, nem token, nem hostname no sinal.
        assert(melIncidents.get(0).summary.indexOf("kfs_") < 0, "sem credencial")
        assert(melIncidents.get(0).summary.indexOf("site") < 0, "sem nome de servico")
    }
    // Ana continua sem incidente: a sonda nao misturou contas.
    assert(registry.incidentsForAccount(ana.id, false).size == 0, "ana nao herda o incidente de mel")

    // A poda levou as 4 vencidas; as validas (nenhuma aqui) ficariam.
    assert(registry.serviceTokens.size == 0, "todas as vencidas podadas")
}

// E2E do caminho real: um servico AUTHENTICATED publicado, token errado
// batendo no Edge. O 401 tem que contar na sonda de falhas de autenticacao
// (e nao na de recusas de tunel), e um token bom nao pode contar nada.
test "incidentes: 401 real no Edge alimenta a sonda de autenticacao", "incident-auth-e2e" {
    var localSvc = 19631
    var controlPort = 19632
    var tunnelPort = 19633
    var httpPort = 19634

    var app = web.app()
    app.get("/") { return "svc-auth" }
    var server = spawn { app.listen(localSvc) }
    assert(waitForPort(localSvc, 60), "servico local no ar")

    var registry = Registry("/tmp/kofcloud-inc-authe-" + crypto.randomHex(4) + ".json")
    var edgeState = EdgeState(registry)
    var edgeStop = "/tmp/kofcloud-inc-authe-edge-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, "", edgeStop) }
    var httpTask = spawn { serveHttp(edgeState, httpPort, limitMaxBodyBytes(), edgeStop) }
    assert(waitForPort(controlPort, 60), "control no ar")
    assert(waitForPort(tunnelPort, 60), "tunel no ar")
    assert(waitForPort(httpPort, 60), "http no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var accountToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var accountId = mapField(json.decode<Map<String, String>>(bodyOf(created)), "accountId")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pubkey\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"secret\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"" + intToString(localSvc) + "\",\"protocol\":\"http\",\"exposure\":\"AUTHENTICATED\"}"
    var published = httpPostJson(controlPort, "/v1/services", pubBody, accountToken)
    assert(statusOf(published) == 200, "AUTHENTICATED publicado")
    var serviceId = mapField(json.decode<Map<String, String>>(bodyOf(published)), "id")

    // Sem o Agent a rota existe mas o device esta OFFLINE: o 401 por
    // credencial acontece ANTES da checagem de sessao (ordem do front) e e
    // exatamente o caminho do atacante. O token honesto, porem, cairia em
    // 503 — entao para ele subimos o Agent como no e2e de AUTHENTICATED.
    var agentStop = "/tmp/kofcloud-inc-authe-agent-" + crypto.randomHex(4) + ".txt"
    File(agentStop).delete()

    // A sonda e pre-carregada para o limiar ser atingido com 3 requests: 25
    // 401 de verdade esbarrariam no rate limit por hostname (100/min), que
    // nao e o que este teste exercita.
    var base = edgeAuthFailureThreshold() - 3
    edgeState.authFailureProbe.count = base
    edgeState.authFailureProbe.windowStart = time.now()

    // Dois 401: abaixo do limiar, nada abre.
    assert(statusOf(httpGetRawAuth(httpPort, "/", "secret.mel.kofcloud.io", "kfs_errado1")) == 401, "errado -> 401")
    assert(statusOf(httpGetRawAuth(httpPort, "/", "secret.mel.kofcloud.io", "kfs_errado2")) == 401, "errado -> 401")
    assert(registry.allIncidents().size == 0, "dois 401 nao abrem")
    assert(edgeState.authFailureProbe.count == base + 2, "sonda contou os dois")
    assert(edgeState.refusalProbe.count == 0, "sonda de recusas intacta")

    // Terceiro 401 fecha o limiar (3) e abre o incidente global.
    assert(statusOf(httpGetRawAuth(httpPort, "/", "secret.mel.kofcloud.io", "kfs_errado3")) == 401, "errado -> 401")
    var incidents = registry.allIncidents()
    assert(incidents.size == 1, "limiar abre o global")
    if (incidents.size == 1) {
        assert(incidents.get(0).kind == incidentEdgeAuthFailures(), "sinal do 401")
        assert(incidents.get(0).accountId.length == 0, "escopo global, nao da conta")
    }

    // Token honesto nao conta nem reabre (incidente segue idempotente).
    // Sobe o Agent para a rota ficar ONLINE e o token bom chegar ao servico.
    var config = AgentConfig("http://127.0.0.1:" + intToString(controlPort), deviceId, accountId, accountToken, "", agentStop, "127.0.0.1", tunnelPort, 100)
    var agentTask = spawn { runAgent(config, true) }
    var online = false
    var attempts = 100
    while (attempts > 0 && online == false) {
        online = edgeState.isOnline(deviceId)
        if (online == false) {
            time.sleep(50)
            attempts = attempts - 1
        }
    }
    assert(online, "agent registrado no edge")
    var minted = httpPostJson(controlPort, "/v1/services/token", "{\"serviceId\":\"" + serviceId + "\"}", accountToken)
    assert(statusOf(minted) == 200, "token de servico emitido")
    var serviceToken = mapField(json.decode<Map<String, String>>(bodyOf(minted)), "token")
    var before = edgeState.authFailureProbe.count
    assert(statusOf(httpGetRawAuth(httpPort, "/", "secret.mel.kofcloud.io", serviceToken)) == 200, "token bom -> 200")
    assert(edgeState.authFailureProbe.count == before, "200 nao incrementa a sonda")
    assert(registry.allIncidents().size == 1, "sem incidente duplicado")

    // O incidente nao carrega hostname nem token (regra de privacidade).
    assert(incidents.get(0).summary.indexOf("secret.mel") < 0, "sem hostname no incidente")
    assert(incidents.get(0).summary.indexOf("kfs_") < 0, "sem token no incidente")

    writeTextTo(edgeStop, "stop")
    writeTextTo(agentStop, "stop")
    assert(waitForPort(controlPort, 60), "encerra")
}

test "incidentes: template de post-mortem tem as 5 secoes e sem dado de cliente", "postmortem-template" {
    // Trava da Fase 17 slice 3: o ciclo so fecha com post-mortem, e o
    // template nao pode apodrecer (sumir secao, perder o exemplo de
    // comando ou passar a pedir dado de cliente). Precedente: a trava
    // do SECURITY.md (security-policy). Caminho relativo ao repo: o
    // runner usa a raiz como cwd.
    var doc = readTextOr("docs/incidents/README.md", "")
    assert(doc.length > 0, "template existe e nao e vazio")
    assert(doc.indexOf("## Causa") >= 0, "secao causa")
    assert(doc.indexOf("## Impacto") >= 0, "secao impacto")
    assert(doc.indexOf("## Timeline") >= 0, "secao timeline")
    assert(doc.indexOf("## Correção") >= 0, "secao correcao")
    assert(doc.indexOf("## Ação preventiva") >= 0, "secao preventiva")
    // O template cita os comandos reais do ciclo (se um mudar de nome,
    // a trava quebra de proposito — procedimento desatualizado e pior
    // que nenhum, porque o operador segue passo que nao funciona).
    assert(doc.indexOf("kof cloud freeze") >= 0, "caminho contencao")
    assert(doc.indexOf("incidents --resolve") >= 0, "caminho resolve")
    // Regra de privacidade do template: orienta a nunca registrar dado
    // de cliente (mesma regra de log/metrica/audit).
    assert(doc.indexOf("kfs_") >= 0, "cita o que nao vazar")
    assert(doc.indexOf("sem hostname") >= 0, "proibe hostname")
}
test "incidents: --resolve solto ou repetido barra antes de qualquer rede", "incident-usage" {
    // `--resolve` sem valor saia 0 e LISTAVA os incidentes: o operador achava
    // que tinha fechado um incidente quando o comando nem tentou. Repetida
    // tambem e ambigua (flagValue leria a primeira). Fail-fast agora.
    //
    // Sem sessao o comando ja sai 1 pelo guard de login — o teste precisaria
    // de sessao REAL para distinguir o guard de uso. Uma sessao para um
    // control plane inexistente serve: se o parse passasse, o `http.post`
    // falharia com exit 1 tambem, entao o sinal tem que vir de outro lugar.
    // Por isso a sessao aponta para um control plane de verdade (abaixo).
    var port = 20194
    var registry = Registry("/tmp/kofcloud-inc-usage2-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, port, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(port, 60), "control no ar")
    var url = "http://127.0.0.1:" + intToString(port)
    var token = loginOrCreate(url, "mel", "segredo")
    var prior = readTextOr(sessionPath(), "")
    saveSession(LocalSession("", "mel", token, url))

    assert(cmdIncidents(listOf("--resolve")) == 1, "solto barra")
    assert(cmdIncidents(listOf("--resolve", "id-um", "--resolve", "id-dois")) == 1, "repetida barra")
    // Posicional solto continua barrando.
    assert(cmdIncidents(listOf("lixo")) == 1, "posicional solto barra")

    if (prior.length == 0) {
        File(sessionPath()).delete()
    } else {
        writeTextTo(sessionPath(), prior)
    }
}

test "incidents: --resolve com valor segue ate o control plane", "incident-usage" {
    var port = 20193
    var registry = Registry("/tmp/kofcloud-inc-usage-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, port, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(port, 60), "control no ar")
    var url = "http://127.0.0.1:" + intToString(port)
    var token = loginOrCreate(url, "mel", "segredo")
    var prior = readTextOr(sessionPath(), "")
    saveSession(LocalSession("", "mel", token, url))

    // Id inexistente: o comando chega ao control plane e a API responde
    // 404 KCF125 (exit 1) — a recusa acontece la, nao no parse local.
    var code = cmdIncidents(listOf("--resolve", "incidente-que-nao-existe"))
    assert(code == 1, "id inexistente -> 404 KCF125 da API (exit " + intToString(code) + ")")

    if (prior.length == 0) {
        File(sessionPath()).delete()
    } else {
        writeTextTo(sessionPath(), prior)
    }
}


Incident? bulkSuspensionIncident(Registry registry, String accountId) {
    for (var incident in registry.incidentsForAccount(accountId, false)) {
        if (incident.kind == incidentBulkSuspensions()) {
            return incident
        }
    }
    return null
}

test "incidente: suspensao em lote abre bulk_suspensions (WARN)", "incident-susp" {
    // Medido: os detectores cobriam revoke em lote (device/token), mas a
    // SUSPENSAO nao revoga nada — um token de conta comprometido podia
    // suspender todos os servicos sem incidente nenhum: cada site saia do
    // ar (404 opaco) e nenhum sinal disparava. Mesmo padrao do
    // `bulk_token_revokes`: limiar na janela, audit ring, idempotente.
    var registry = Registry(incidentsPath("susp"))
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var site = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    var api = registry.publishService(mel, device.id, "api", "127.0.0.1", 3000, "http", "PUBLIC", "", "")
    var db = registry.publishService(mel, device.id, "db", "127.0.0.1", 5432, "http", "PRIVATE", "", "")

    // Dois suspends: abaixo do limiar (3), nada abre.
    assert(registry.suspendService(mel.id, site.id), "suspende site")
    assert(registry.suspendService(mel.id, api.id), "suspende api")
    var before = registry.incidentsForAccount(mel.id, false)
    var bulkBefore = 0
    for (var incident in before) {
        if (incident.kind == incidentBulkSuspensions()) {
            bulkBefore = bulkBefore + 1
        }
    }
    assert(bulkBefore == 0, "dois suspends nao abrem")

    // Terceiro (limiar): abre WARN, escopo da conta.
    assert(registry.suspendService(mel.id, db.id), "suspende db")
    var opened = bulkSuspensionIncident(registry, mel.id)
    assert(opened != null, "incidente bulk_suspensions aberto")
    if (opened != null) {
        assert(opened.severity == severityWarn(), "severidade WARN")
        assert(opened.accountId == mel.id, "escopo da conta")
        assert(opened.summary.indexOf("suspended") >= 0, "resumo diz suspended")
    }

    // Idempotente: mais um suspend nao abre outro (o mesmo e o sinal).
    var db2 = registry.publishService(mel, device.id, "db2", "127.0.0.1", 5433, "http", "PRIVATE", "", "")
    assert(registry.suspendService(mel.id, db2.id), "quarto suspend")
    var after = bulkSuspensionIncident(registry, mel.id)
    var openedId = ""
    if (opened != null) {
        openedId = opened.id
    }
    if (after != null) {
        assert(after.id == openedId, "mesmo incidente (idempotente)")
    }
    var count = 0
    for (var incident in registry.incidentsForAccount(mel.id, false)) {
        if (incident.kind == incidentBulkSuspensions()) {
            count = count + 1
        }
    }
    assert(count == 1, "um incidente so")

    // Suspend de device tambem alimenta a mesma sinal (device.suspended).
    var dev2 = registry.registerDevice(mel, "srv", "pk2")
    assert(registry.suspendDevice(mel.id, dev2.id), "suspende device")
    assert(count == 1, "device suspend nao duplica")

    // Conta sem suspensos: nada.
    var ana = registry.createAccount("ana", "ana@e.com", "segredo")
    assert(bulkSuspensionIncident(registry, ana.id) == null, "outra conta intocada")
}

// Varredura PERIODICA (laco do serve): numa conta ociosa ninguem valida,
// entao a poda preguicosa (`serviceByServiceToken`) nunca roda. O laco tem
// que podar sem validacao, abrir o incidente da conta dona e parar no
// stopFile da plataforma — o mesmo `credentialExpirySweeper` do comando.
test "incidentes: varredura periodica poda credenciais ociosas e abre o incidente", "incident-expiry-idle" {
    var registry = Registry(incidentsPath("expiryswl"))
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var ana = registry.createAccount("ana", "a@e.com", "segredo")
    var melDev = registry.registerDevice(mel, "nb", "pk")
    var anaDev = registry.registerDevice(ana, "nb", "pk")
    var melSvc = registry.publishService(mel, melDev.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED", "", "")
    var anaSvc = registry.publishService(ana, anaDev.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED", "", "")

    // Vencidas construidas no passado (sem dormir TTL); hash so — o valor
    // em claro nunca e persistido. mel tem 3 (fecha o limiar), ana 1.
    var past = time.now() - 1000
    var stale = time.now() - 1
    registry.serviceTokens.add(ServiceToken(melSvc.id, mel.id, tokenHash("kfs_mel_1"), past, stale))
    registry.serviceTokens.add(ServiceToken(melSvc.id, mel.id, tokenHash("kfs_mel_2"), past, stale))
    registry.serviceTokens.add(ServiceToken(melSvc.id, mel.id, tokenHash("kfs_mel_3"), past, stale))
    registry.serviceTokens.add(ServiceToken(anaSvc.id, ana.id, tokenHash("kfs_ana_1"), past, stale))
    // Credenciais VALIDAS (kfs_ e kfc_) nao podem sair na varredura.
    registry.serviceTokens.add(ServiceToken(melSvc.id, mel.id, tokenHash("kfs_mel_viva"), past, time.now() + 60000))
    registry.tokens.add(TokenEntry(ana.id, tokenHash("kfc_viva"), past, time.now() + 60000))
    registry.tokens.add(TokenEntry(ana.id, tokenHash("kfc_morta"), past, stale))

    // O laco real, em processo, com intervalo curto (o comando passa
    // `limitExpirySweepMs()`; aqui o valor vem como parametro).
    var stop = "/tmp/kofcloud-inc-expiryswl-stop-" + crypto.randomHex(4) + ".txt"
    File(stop).delete()
    var loop = spawn { credentialExpirySweeper(registry, stop, 40) }
    var tries = 0
    while (registry.serviceTokens.size > 1 && tries < 100) {
        time.sleep(20)
        tries = tries + 1
    }
    assert(registry.serviceTokens.size == 1, "laco podou as vencidas e manteve a valida")
    assert(registry.pruneExpiredAccountTokens() == 0, "kfc_ vencida ja saiu no laco")
    assert(registry.tokens.size == 1, "kfc_ valida fica")

    // O sinal chega na conta dona SEM nenhuma validacao (conta ociosa):
    // mel tinha 3 vencidas na janela, ana 1.
    var melIncidents = registry.incidentsForAccount(mel.id, false)
    assert(melIncidents.size == 1, "laco abre o incidente da conta ociosa")
    if (melIncidents.size == 1) {
        assert(melIncidents.get(0).kind == incidentMassTokenExpiry(), "sinal certo")
        assert(melIncidents.get(0).severity == "WARN", "WARN")
        // Privacidade: nem credencial, nem servico, nem handle no resumo.
        assert(melIncidents.get(0).summary.indexOf("kfs_") < 0, "sem credencial no resumo")
        assert(melIncidents.get(0).summary.indexOf("site") < 0, "sem servico no resumo")
        assert(melIncidents.get(0).summary.indexOf("mel") < 0, "sem handle no resumo")
    }
    assert(registry.incidentsForAccount(ana.id, false).size == 0, "uma vencida nao abre")
    // Idempotente: segunda varredura nao acha nada nem duplica incidente.
    assert(registry.sweepExpiredCredentials() == 0, "segunda varredura nao acha nada")
    assert(registry.incidentsForAccount(mel.id, false).size == 1, "sem duplicar")

    // O laco para no stopFile (mesma sentenca do serve).
    writeTextTo(stop, "pare")
    await loop
}
