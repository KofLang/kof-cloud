import kofcloud.agent.Agent
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.model.Errors
import kofcloud.model.Incident
import kofcloud.edge.EdgeState
import kofcloud.edge.HttpFront
import kofcloud.edge.Tunnel
import kofcloud.store.Store
import kofcloud.util.Limits
import testkit.Support

// Fase 17 slice 1 — deteccao e severidade.
// Incidente = sinal com nivel, aberto por detector, fechado pelo operador.
// Nunca carrega dado de cliente: so kind, severidade, escopo e resumo fixo.

String incidentsPath(String name) {
    return "/tmp/kofcloud-inc-" + name + "-" + crypto.randomHex(4) + ".json"
}

test "incidentes: severidade e resumo por sinal", "incident-unit" {
    assert(incidentSeverityFor(incidentBulkDeviceRevokes()) == "CRIT", "revoke em lote de device e CRIT")
    assert(incidentSeverityFor(incidentBulkTokenRevokes()) == "WARN", "token e WARN")
    assert(incidentSeverityFor(incidentEdgeRefusals()) == "WARN", "edge e WARN")
    assert(incidentSeverityFor("desconhecido") == "INFO", "desconhecido e INFO")
    assert(incidentSummaryFor(incidentBulkDeviceRevokes()).length > 0, "resumo presente")
    assert(severityIsKnown("CRIT"), "CRIT conhecido")
    assert(severityIsKnown("nada") == false, "desconhecida recusada")
    assert(limitIncidents() > 0, "anel positivo")
    // Detectores em fonte unica (`util/Limits.kf`, mesma familia de
    // `limitHeartbeatMs`/`limitIdleSweepMs`): valor travado + delegacao
    // (mudar o default no Limits muda o detector — mutacao quebra).
    assert(edgeRefusalThreshold() == 10, "limiar do edge travado")
    assert(edgeRefusalThreshold() == limitEdgeRefusalThreshold(), "edge delega na fonte")
    assert(edgeRefusalWindowMs() == 60000, "janela do edge travada")
    assert(edgeRefusalWindowMs() == limitEdgeRefusalWindowMs(), "janela delega na fonte")
    assert(bulkRevokeThreshold() == 3, "limiar de lote travado")
    assert(bulkRevokeThreshold() == limitBulkRevokeThreshold(), "lote delega na fonte")
    assert(bulkRevokeWindowMs() == 60000, "janela de lote travada")
    assert(bulkRevokeWindowMs() == limitBulkRevokeWindowMs(), "janela de lote delega na fonte")
    assert(incidentSeverityFor(incidentEdgeAuthFailures()) == "WARN", "401 em rajada e WARN")
    assert(incidentSummaryFor(incidentEdgeAuthFailures()).length > 0, "resumo do 401 presente")
    assert(edgeAuthFailureThreshold() == 25, "limiar de 401 travado")
    assert(edgeAuthFailureThreshold() == limitEdgeAuthFailureThreshold(), "401 delega na fonte")
    assert(edgeAuthFailureWindowMs() == 60000, "janela de 401 travada")
    assert(edgeAuthFailureWindowMs() == limitEdgeAuthFailureWindowMs(), "janela de 401 delega na fonte")
    // Sinais distintos: vocabulario fechado, mesmo nivel por desenho.
    assert(incidentEdgeAuthFailures() != incidentEdgeRefusals(), "sinais separados")
    assert(incidentSeverityFor(incidentEdgeAuthFailures()) == incidentSeverityFor(incidentEdgeRefusals()), "mesmo nivel")
    // Edge sem heartbeat: quedas por ociosidade repetidas. Limiar baixo
    // (cada queda e um tunel que caiu de verdade) e janela folgada (300 s).
    assert(incidentSeverityFor(incidentEdgeIdleTimeouts()) == "WARN", "quedas por ociosidade e WARN")
    assert(incidentSummaryFor(incidentEdgeIdleTimeouts()).length > 0, "resumo das quedas presente")
    assert(edgeIdleTimeoutThreshold() == 5, "limiar de ociosidade travado")
    assert(edgeIdleTimeoutThreshold() == limitEdgeIdleTimeoutThreshold(), "ociosidade delega na fonte")
    assert(edgeIdleTimeoutWindowMs() == 300000, "janela de ociosidade travada")
    assert(edgeIdleTimeoutWindowMs() == limitEdgeIdleTimeoutWindowMs(), "janela de ociosidade delega na fonte")
    assert(incidentEdgeIdleTimeouts() != incidentEdgeRefusals(), "ociosidade separada das recusas")
    assert(incidentEdgeIdleTimeouts() != incidentEdgeAuthFailures(), "ociosidade separada do 401")
    assert(errIncidentNotFound().indexOf("KCF125") >= 0, "codigo KCF125")
    assert(errHint(errIncidentNotFound()).length > 0, "Hint presente")
}

test "incidentes: abrir e idempotente por (sinal, conta)", "incident-unit" {
    var registry = Registry(incidentsPath("idem"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var first = registry.raiseIncident(incidentBulkTokenRevokes(), account.id)
    assert(first != null, "abre")
    if (first != null) {
        assert(first.severity == "WARN", "severidade do sinal")
        assert(first.resolvedAt == 0, "aberto")
    }
    var second = registry.raiseIncident(incidentBulkTokenRevokes(), account.id)
    assert(second == null, "nao duplica enquanto aberto")
    assert(registry.incidentsForAccount(account.id, true).size == 1, "um so")
}

test "incidentes: revogacao em lote abre incidente da conta", "incident-unit" {
    var registry = Registry(incidentsPath("bulk"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var d1 = registry.registerDevice(account, "d1", "pk")
    var d2 = registry.registerDevice(account, "d2", "pk")
    var d3 = registry.registerDevice(account, "d3", "pk")
    var d4 = registry.registerDevice(account, "d4", "pk")

    registry.revokeDevice(account.id, d1.id)
    assert(registry.incidentsForAccount(account.id, true).size == 0, "uma ainda nao")
    registry.revokeDevice(account.id, d2.id)
    assert(registry.incidentsForAccount(account.id, true).size == 0, "duas ainda nao")
    registry.revokeDevice(account.id, d3.id)
    var list = registry.incidentsForAccount(account.id, true)
    assert(list.size == 1, "terceira abre (limiar 3)")
    if (list.size == 1) {
        assert(list.get(0).kind == incidentBulkDeviceRevokes(), "sinal certo")
        assert(list.get(0).severity == "CRIT", "CRIT")
    }
    registry.revokeDevice(account.id, d4.id)
    assert(registry.incidentsForAccount(account.id, true).size == 1, "nao duplica")
}

test "incidentes: resolver fecha e permite abrir de novo depois", "incident-unit" {
    var registry = Registry(incidentsPath("resolve"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var opened = registry.raiseIncident(incidentBulkDeviceRevokes(), account.id)
    assert(opened != null, "aberto")
    var id = ""
    if (opened != null) {
        id = opened.id
    }
    assert(registry.resolveIncident(id) == true, "fecha")
    assert(registry.resolveIncident(id) == false, "fechar de novo nao acha")
    var again = registry.raiseIncident(incidentBulkDeviceRevokes(), account.id)
    assert(again != null, "pode reabrir depois de resolvido")
}

test "incidentes: escopo global aparece para a conta, escopo alheio nao", "incident-unit" {
    var registry = Registry(incidentsPath("scope"))
    var mel = registry.createAccount("mel", "mel@e.com", "segredo")
    var ana = registry.createAccount("ana", "ana@e.com", "segredo")
    registry.raiseIncident(incidentEdgeRefusals(), "")
    registry.raiseIncident(incidentBulkTokenRevokes(), ana.id)

    assert(registry.incidentsForAccount(mel.id, true).size == 1, "mel ve o global")
    assert(registry.incidentsForAccount(mel.id, false).size == 0, "mel nao ve o de ana")
    assert(registry.incidentsForAccount(ana.id, false).size == 1, "ana ve o seu")
}

test "incidentes: HTTP lista, resolve e recusa incidente alheio", "incident" {
    var controlPort = 19861
    var registry = Registry(incidentsPath("http"))
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var melToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var mel = registry.accountByHandle("mel")
    var melId = ""
    if (mel != null) {
        melId = mel.id
    }
    var opened = registry.raiseIncident(incidentBulkDeviceRevokes(), melId)

    var listed = httpPostJson(controlPort, "/v1/incidents", "{}", melToken)
    assert(statusOf(listed) == 200, "lista 200")
    assert(bodyOf(listed).indexOf("bulk_device_revokes") >= 0, "sinal na lista")
    assert(bodyOf(listed).indexOf("CRIT") >= 0, "severidade na lista")

    var incidentId = ""
    if (opened != null) {
        incidentId = opened.id
    }
    var resolved = httpPostJson(controlPort, "/v1/incidents", "{\"resolveId\":\"" + incidentId + "\"}", melToken)
    assert(statusOf(resolved) == 200, "resolve 200")

    // Outra conta nao enxerga nem fecha o incidente de mel (404 opaco).
    var other = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"ana\",\"email\":\"a@e.com\",\"password\":\"segredo\"}", "")
    var anaToken = mapField(json.decode<Map<String, String>>(bodyOf(other)), "token")
    assert(statusOf(httpPostJson(controlPort, "/v1/incidents", "{\"resolveId\":\"" + incidentId + "\"}", anaToken)) == 404, "alheio 404")
    var anaList = httpPostJson(controlPort, "/v1/incidents", "{}", anaToken)
    assert(bodyOf(anaList).indexOf("bulk_device_revokes") < 0, "lista de ana nao mostra")
}

test "incidentes: rajada de recusas do Edge abre incidente global", "incident-edge" {
    // Amostra do Edge e por processo: o EdgeState carrega a sonda.
    var registry = Registry(incidentsPath("edge"))
    var edgeState = EdgeState(registry)
    edgeState.refusalProbe.count = edgeRefusalThreshold() - 1
    edgeState.refusalProbe.windowStart = time.now()
    noteEdgeRefusalIncident(edgeState)
    var list = registry.incidentsForAccount("", true)
    assert(list.size == 1, "limiar abre o global")
    if (list.size == 1) {
        assert(list.get(0).kind == incidentEdgeRefusals(), "sinal do edge")
        assert(list.get(0).accountId.length == 0, "escopo global")
        assert(list.get(0).severity == "WARN", "WARN")
    }
    // Abaixo do limiar nao abre.
    var fresh = EdgeState(Registry(incidentsPath("edge2")))
    noteEdgeRefusalIncident(fresh)
    assert(fresh.registry.allIncidents().size == 0, "uma recusa nao e incidente")
}

test "incidentes: rajada de 401 no Edge abre incidente, controlada nao", "incident-auth" {
    var registry = Registry(incidentsPath("auth"))
    var edgeState = EdgeState(registry)
    edgeState.authFailureProbe.count = edgeAuthFailureThreshold() - 1
    edgeState.authFailureProbe.windowStart = time.now()
    noteEdgeAuthFailureIncident(edgeState)
    var list = registry.incidentsForAccount("", true)
    assert(list.size == 1, "limiar de 401 abre o global")
    if (list.size == 1) {
        assert(list.get(0).kind == incidentEdgeAuthFailures(), "sinal do 401")
        assert(list.get(0).accountId.length == 0, "escopo global")
        assert(list.get(0).severity == "WARN", "WARN")
        // Privacidade: nada de hostname/token/caminho no resumo.
        assert(list.get(0).summary.indexOf("kfs_") < 0, "sem credencial no resumo")
        assert(list.get(0).summary.indexOf(".") < 0, "sem hostname no resumo")
    }

    // Uma rajada abaixo do limiar nao abre.
    var quiet = EdgeState(Registry(incidentsPath("auth2")))
    noteEdgeAuthFailureIncident(quiet)
    assert(quiet.registry.allIncidents().size == 0, "um 401 nao e incidente")

    // Sondas independentes: nutrir a de 401 nao antecipa a de recusas.
    var shared = EdgeState(Registry(incidentsPath("auth3")))
    shared.authFailureProbe.count = edgeAuthFailureThreshold() - 1
    noteEdgeAuthFailureIncident(shared)
    noteEdgeRefusalIncident(shared)
    var kinds = shared.registry.allIncidents()
    assert(kinds.size == 1, "recusa nao foi contada pela sonda de 401")
    if (kinds.size == 1) {
        assert(kinds.get(0).kind == incidentEdgeAuthFailures(), "so o sinal de 401 abriu")
    }

    // Janela vencida zera o contador (sonda cheia de antes nao abre agora).
    var stale = EdgeState(Registry(incidentsPath("auth4")))
    stale.authFailureProbe.count = edgeAuthFailureThreshold() - 1
    stale.authFailureProbe.windowStart = time.now() - edgeAuthFailureWindowMs() - 1000
    noteEdgeAuthFailureIncident(stale)
    assert(stale.registry.allIncidents().size == 0, "janela vencida reseta antes de contar")
}

test "incidentes: quedas por ociosidade no Edge abrem incidente próprio", "incident-idle" {
    var registry = Registry(incidentsPath("idle"))
    var edgeState = EdgeState(registry)
    edgeState.idleTimeoutProbe.count = edgeIdleTimeoutThreshold() - 1
    edgeState.idleTimeoutProbe.windowStart = time.now()
    noteEdgeIdleTimeoutIncident(edgeState)
    var list = registry.incidentsForAccount("", true)
    assert(list.size == 1, "limiar de quedas abre o global")
    if (list.size == 1) {
        assert(list.get(0).kind == incidentEdgeIdleTimeouts(), "sinal de ociosidade")
        assert(list.get(0).accountId.length == 0, "escopo global (sem device)")
        assert(list.get(0).severity == "WARN", "WARN")
        // Privacidade: o sinal nao carrega device, hostname nem token.
        assert(list.get(0).summary.indexOf(".") < 0, "sem hostname no resumo")
        assert(list.get(0).summary.indexOf("kfs_") < 0, "sem credencial no resumo")
    }

    // Uma queda isolada nao e incidente (Agent parado e rotina).
    var quiet = EdgeState(Registry(incidentsPath("idle2")))
    noteEdgeIdleTimeoutIncident(quiet)
    assert(quiet.registry.allIncidents().size == 0, "uma queda nao e incidente")

    // Sondas independentes: quedas nao antecipam recusas nem 401.
    var shared = EdgeState(Registry(incidentsPath("idle3")))
    shared.idleTimeoutProbe.count = edgeIdleTimeoutThreshold() - 1
    noteEdgeIdleTimeoutIncident(shared)
    noteEdgeRefusalIncident(shared)
    noteEdgeAuthFailureIncident(shared)
    var kinds = shared.registry.allIncidents()
    assert(kinds.size == 1, "so a sonda de ociosidade abriu")
    if (kinds.size == 1) {
        assert(kinds.get(0).kind == incidentEdgeIdleTimeouts(), "sinal de ociosidade")
    }
    assert(shared.refusalProbe.count == 1, "recusas contaram na propria sonda")
    assert(shared.authFailureProbe.count == 1, "401 contou na propria sonda")

    // Janela vencida zera o contador.
    var stale = EdgeState(Registry(incidentsPath("idle4")))
    stale.idleTimeoutProbe.count = edgeIdleTimeoutThreshold() - 1
    stale.idleTimeoutProbe.windowStart = time.now() - edgeIdleTimeoutWindowMs() - 1000
    noteEdgeIdleTimeoutIncident(stale)
    assert(stale.registry.allIncidents().size == 0, "janela vencida reseta antes de contar")
}

// E2E do caminho real: um servico AUTHENTICATED publicado, token errado
// batendo no Edge. O 401 tem que contar na sonda de falhas de autenticacao
// (e nao na de recusas de tunel), e um token bom nao pode contar nada.
test "incidentes: 401 real no Edge alimenta a sonda de autenticacao", "incident-auth-e2e" {
    var localSvc = 19631
    var controlPort = 19632
    var tunnelPort = 19633
    var httpPort = 19634

    var app = web.app()
    app.get("/") { return "svc-auth" }
    var server = spawn { app.listen(localSvc) }
    assert(waitForPort(localSvc, 60), "servico local no ar")

    var registry = Registry("/tmp/kofcloud-inc-authe-" + crypto.randomHex(4) + ".json")
    var edgeState = EdgeState(registry)
    var edgeStop = "/tmp/kofcloud-inc-authe-edge-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, "", edgeStop) }
    var httpTask = spawn { serveHttp(edgeState, httpPort, limitMaxBodyBytes(), edgeStop) }
    assert(waitForPort(controlPort, 60), "control no ar")
    assert(waitForPort(tunnelPort, 60), "tunel no ar")
    assert(waitForPort(httpPort, 60), "http no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var accountToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var accountId = mapField(json.decode<Map<String, String>>(bodyOf(created)), "accountId")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pubkey\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"secret\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"" + intToString(localSvc) + "\",\"protocol\":\"http\",\"exposure\":\"AUTHENTICATED\"}"
    var published = httpPostJson(controlPort, "/v1/services", pubBody, accountToken)
    assert(statusOf(published) == 200, "AUTHENTICATED publicado")
    var serviceId = mapField(json.decode<Map<String, String>>(bodyOf(published)), "id")

    // Sem o Agent a rota existe mas o device esta OFFLINE: o 401 por
    // credencial acontece ANTES da checagem de sessao (ordem do front) e e
    // exatamente o caminho do atacante. O token honesto, porem, cairia em
    // 503 — entao para ele subimos o Agent como no e2e de AUTHENTICATED.
    var agentStop = "/tmp/kofcloud-inc-authe-agent-" + crypto.randomHex(4) + ".txt"
    File(agentStop).delete()

    // A sonda e pre-carregada para o limiar ser atingido com 3 requests: 25
    // 401 de verdade esbarrariam no rate limit por hostname (100/min), que
    // nao e o que este teste exercita.
    var base = edgeAuthFailureThreshold() - 3
    edgeState.authFailureProbe.count = base
    edgeState.authFailureProbe.windowStart = time.now()

    // Dois 401: abaixo do limiar, nada abre.
    assert(statusOf(httpGetRawAuth(httpPort, "/", "secret.mel.kofcloud.io", "kfs_errado1")) == 401, "errado -> 401")
    assert(statusOf(httpGetRawAuth(httpPort, "/", "secret.mel.kofcloud.io", "kfs_errado2")) == 401, "errado -> 401")
    assert(registry.allIncidents().size == 0, "dois 401 nao abrem")
    assert(edgeState.authFailureProbe.count == base + 2, "sonda contou os dois")
    assert(edgeState.refusalProbe.count == 0, "sonda de recusas intacta")

    // Terceiro 401 fecha o limiar (3) e abre o incidente global.
    assert(statusOf(httpGetRawAuth(httpPort, "/", "secret.mel.kofcloud.io", "kfs_errado3")) == 401, "errado -> 401")
    var incidents = registry.allIncidents()
    assert(incidents.size == 1, "limiar abre o global")
    if (incidents.size == 1) {
        assert(incidents.get(0).kind == incidentEdgeAuthFailures(), "sinal do 401")
        assert(incidents.get(0).accountId.length == 0, "escopo global, nao da conta")
    }

    // Token honesto nao conta nem reabre (incidente segue idempotente).
    // Sobe o Agent para a rota ficar ONLINE e o token bom chegar ao servico.
    var config = AgentConfig("http://127.0.0.1:" + intToString(controlPort), deviceId, accountId, accountToken, "", agentStop, "127.0.0.1", tunnelPort, 100)
    var agentTask = spawn { runAgent(config, true) }
    var online = false
    var attempts = 100
    while (attempts > 0 && online == false) {
        online = edgeState.isOnline(deviceId)
        if (online == false) {
            time.sleep(50)
            attempts = attempts - 1
        }
    }
    assert(online, "agent registrado no edge")
    var minted = httpPostJson(controlPort, "/v1/services/token", "{\"serviceId\":\"" + serviceId + "\"}", accountToken)
    assert(statusOf(minted) == 200, "token de servico emitido")
    var serviceToken = mapField(json.decode<Map<String, String>>(bodyOf(minted)), "token")
    var before = edgeState.authFailureProbe.count
    assert(statusOf(httpGetRawAuth(httpPort, "/", "secret.mel.kofcloud.io", serviceToken)) == 200, "token bom -> 200")
    assert(edgeState.authFailureProbe.count == before, "200 nao incrementa a sonda")
    assert(registry.allIncidents().size == 1, "sem incidente duplicado")

    // O incidente nao carrega hostname nem token (regra de privacidade).
    assert(incidents.get(0).summary.indexOf("secret.mel") < 0, "sem hostname no incidente")
    assert(incidents.get(0).summary.indexOf("kfs_") < 0, "sem token no incidente")

    writeTextTo(edgeStop, "stop")
    writeTextTo(agentStop, "stop")
    assert(waitForPort(controlPort, 60), "encerra")
}

test "incidentes: template de post-mortem tem as 5 secoes e sem dado de cliente", "postmortem-template" {
    // Trava da Fase 17 slice 3: o ciclo so fecha com post-mortem, e o
    // template nao pode apodrecer (sumir secao, perder o exemplo de
    // comando ou passar a pedir dado de cliente). Precedente: a trava
    // do SECURITY.md (security-policy). Caminho relativo ao repo: o
    // runner usa a raiz como cwd.
    var doc = readTextOr("docs/incidents/README.md", "")
    assert(doc.length > 0, "template existe e nao e vazio")
    assert(doc.indexOf("## Causa") >= 0, "secao causa")
    assert(doc.indexOf("## Impacto") >= 0, "secao impacto")
    assert(doc.indexOf("## Timeline") >= 0, "secao timeline")
    assert(doc.indexOf("## Correção") >= 0, "secao correcao")
    assert(doc.indexOf("## Ação preventiva") >= 0, "secao preventiva")
    // O template cita os comandos reais do ciclo (se um mudar de nome,
    // a trava quebra de proposito — procedimento desatualizado e pior
    // que nenhum, porque o operador segue passo que nao funciona).
    assert(doc.indexOf("kof cloud freeze") >= 0, "caminho contencao")
    assert(doc.indexOf("incidents --resolve") >= 0, "caminho resolve")
    // Regra de privacidade do template: orienta a nunca registrar dado
    // de cliente (mesma regra de log/metrica/audit).
    assert(doc.indexOf("kfs_") >= 0, "cita o que nao vazar")
    assert(doc.indexOf("sem hostname") >= 0, "proibe hostname")
}