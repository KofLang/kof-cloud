import kofcloud.cli.Deploy
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.model.Service
import kofcloud.store.Store
import testkit.Support

// Fase 7 slice 1 — deploy declarativo: publica o que esta no manifesto e
// nada alem dele. Sem build, sem artefato, sem daemon: so publish em lote.
// `down` faz o inverso; nada fora do manifesto e tocado.

String deployManifest(String name, String body) {
    var path = "/tmp/kofcloud-deploy-" + name + "-" + crypto.randomHex(4) + ".json"
    File(path).writeText(body)
    return path
}

test "deploy: manifesto valido com defaults", "deploy" {
    var services = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080},{\"name\":\"api\",\"port\":3000,\"exposure\":\"AUTHENTICATED\",\"address\":\"localhost\"}]}")
    assert(services.size == 2, "dois servicos")
    assert(services.get(0).name == "site", "nome")
    assert(services.get(0).port == 8080, "porta numerica")
    assert(services.get(0).address == "127.0.0.1", "default address")
    assert(services.get(0).exposure == "PUBLIC", "default exposure")
    assert(services.get(0).protocol == "http", "default protocol")
    assert(services.get(1).exposure == "AUTHENTICATED", "exposure explicita")
    assert(services.get(1).address == "localhost", "address explicito")
    assert(services.get(1).protocol == "http", "protocol default mesmo com resto explicito")
}

test "deploy: manifesto com port como string (formato da API)", "deploy-str" {
    var services = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":\"8080\"}]}")
    assert(services.size == 1, "um servico")
    assert(services.get(0).port == 8080, "port string aceita")
}

test "deploy: manifestos invalidos com erro posicional", "deploy-err" {
    // Arquivo inexistente e arquivo vazio caem no mesmo caminho honesto:
    // readTextOr devolve "" e o cmdDeploy/cmdDown respondem "manifesto nao
    // encontrado" antes de qualquer parse ou rede.
    var missing = readTextOr("/tmp/kofcloud-deploy-inexistente-" + crypto.randomHex(8) + ".json", "")
    assert(missing == "", "inexistente vira vazio")
    var emptyPath = deployManifest("vazio", "")
    assert(readTextOr(emptyPath, "") == "", "vazio vira vazio")
    var bad1 = ""
    try {
        parseManifest("")
    } catch (String e) {
        bad1 = e
    }
    assert(bad1 == "manifesto vazio", "vazio")

    var bad2 = ""
    try {
        parseManifest("{\"services\":[]}")
    } catch (String e) {
        bad2 = e
    }
    assert(bad2 == "manifesto sem servicos", "vazio recusa")

    var bad3 = ""
    try {
        parseManifest("{\"services\":[{\"port\":8080}]}")
    } catch (String e) {
        bad3 = e
    }
    assert(bad3 == "servico sem nome na posicao 0", "nome com posicao")

    var bad4 = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"site\"}]}")
    } catch (String e) {
        bad4 = e
    }
    assert(bad4 == "servico \"site\" sem porta valida (1-65535)", "porta com nome")

    var bad5 = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"a\",\"port\":1},{\"name\":\"b\"}]}")
    } catch (String e) {
        bad5 = e
    }
    assert(bad5 == "servico \"b\" sem porta valida (1-65535)", "posicao correta")

    var bad6 = ""
    try {
        parseManifest("{\"services\":{\"name\":\"site\"}}")
    } catch (String e) {
        bad6 = e
    }
    assert(bad6 == "lista \"services\" nao e um array JSON", "nao-array")

    var bad7 = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"a\",\"port\":1}")
    } catch (String e) {
        bad7 = e
    }
    assert(bad7.indexOf("malformada") >= 0, "truncado")

    // Chave "port" dentro de valor nao confunde ("portaria" tem "port" mas
    // sem as aspas de fechamento na posicao certa).
    var tricky = parseManifest("{\"services\":[{\"name\":\"portaria\",\"port\":9000}]}")
    assert(tricky.get(0).name == "portaria", "substring nao casa")
    assert(tricky.get(0).port == 9000, "porta certa")

    // Exposure desconhecida nao cai para PUBLIC em silencio: typo
    // ("PUBLIK") num servico que devia ser PRIVATE exporia o servico.
    var badExposure = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"db\",\"port\":5432,\"exposure\":\"PUBLIK\"}]}")
    } catch (String e) {
        badExposure = e
    }
    assert(badExposure == "servico \"db\" com exposure invalida: PUBLIK", "exposure com nome e valor")
    // Vazia continua defaultando (ausente != invalido); as validas passam.
    var defaulted = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080},{\"name\":\"db\",\"port\":5432,\"exposure\":\"PRIVATE\"}]}")
    assert(defaulted.get(0).exposure == "PUBLIC", "ausente defaulta")

    // Protocol fora do MVP falha no parse, antes de publicar qualquer coisa.
    var badProtocol = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"db\",\"port\":5432,\"protocol\":\"tcp\"}]}")
    } catch (String e) {
        badProtocol = e
    }
    assert(badProtocol == "servico \"db\" com protocol invalido: tcp", "protocol com nome e valor")
    assert(defaulted.get(1).exposure == "PRIVATE", "valida passa")

    // Address fora de loopback falha no parse: o Agent conecta nesse
    // endereco — externo o transformaria em escaneador (SSRF). Lista
    // fechada: 127.0.0.1, localhost, ::1; ausente defaulta.
    var badAddress = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"db\",\"port\":5432,\"address\":\"10.0.0.5\"}]}")
    } catch (String e) {
        badAddress = e
    }
    assert(badAddress == "servico \"db\" com address invalido: 10.0.0.5", "address com nome e valor")
    var loopbacks = parseManifest("{\"services\":[{\"name\":\"a\",\"port\":1,\"address\":\"localhost\"},{\"name\":\"b\",\"port\":2,\"address\":\"::1\"}]}")
    assert(loopbacks.get(0).address == "localhost", "localhost passa")
    assert(loopbacks.get(1).address == "::1", "::1 passa")

    // Teto de porta: acima de 65535 falha no parse (antes passava e
    // quebrava so no relay/health).
    var bigPort = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"site\",\"port\":70000}]}")
    } catch (String e) {
        bigPort = e
    }
    assert(bigPort == "servico \"site\" sem porta valida (1-65535)", "teto com nome e faixa")

    // Espacos sobrando sao aparados (manifesto escrito a mao): nome,
    // porta-string, address, exposure e protocol com padding passam
    // aparados; nome so-espacos falha como sem nome (posicional), em vez
    // de publicar um servico em branco.
    var padded = parseManifest("{\"services\":[{\"name\":\"  site  \",\"port\":\" 8080 \",\"address\":\" localhost \",\"exposure\":\" PRIVATE \",\"protocol\":\" http \"}]}")
    assert(padded.get(0).name == "site", "nome aparado")
    assert(padded.get(0).port == 8080, "porta string com espaco aceita")
    assert(padded.get(0).address == "localhost", "address aparado")
    assert(padded.get(0).exposure == "PRIVATE", "exposure aparada")
    assert(padded.get(0).protocol == "http", "protocol aparado")
    var blankName = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"   \",\"port\":8080}]}")
    } catch (String e) {
        blankName = e
    }
    assert(blankName == "servico sem nome na posicao 0", "nome so-espacos falha")
}

test "deploy: diff mostra o que mudaria sem aplicar", "deploy-plan" {
    // Puro: duas listas, nenhuma rede, nenhum HOME. Cobre novo/igual/
    // diferente/extra numa chamada so (precedente: doctorTunnelLine).
    var live = listOf<Service>()
    live.add(Service("id-site", "acc", "dev", "site", "127.0.0.1", 8080, "http", "site.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0))
    live.add(Service("id-veterano", "acc", "dev", "veterano", "127.0.0.1", 9000, "http", "veterano.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0))
    var wanted = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080},{\"name\":\"mudou\",\"port\":3000,\"exposure\":\"PRIVATE\"}]}")
    var plan = diffDeployment(live, wanted)
    assert(plan.size == 3, "tres linhas: igual, novo, extra")
    assert(plan.get(0) == "= site (igual)", "igual detectado")
    assert(plan.get(1).startsWith("+ mudou"), "novo com +")
    assert(plan.get(2).startsWith("- veterano"), "extra com - e dica de prune")
    // Mudanca de porta vira ~ (vai atualizar), nao + (novo).
    var wanted2 = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":9090}]}")
    var plan2 = diffDeployment(live, wanted2)
    assert(plan2.size == 2, "mudado + extra")
    assert(plan2.get(0).startsWith("~ site"), "porta diferente e update")
    // Build aparece no plan sem executar: o operador ve que o deploy vai
    // rodar um comando local. Inclusive "=" marca: o deploy executa o build
    // antes de cada publish (mesmo o idempotente), entao "igual" nao e
    // "nada vai acontecer".
    var wanted3 = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080,\"build\":\"npm run build\"},{\"name\":\"novo\",\"port\":3000,\"build\":\"make dist\"},{\"name\":\"mudou\",\"port\":3000,\"exposure\":\"PRIVATE\"}]}")
    var plan3 = diffDeployment(live, wanted3)
    assert(plan3.get(0) == "= site (build) (igual)", "igual com build marca (vai rodar)")
    assert(plan3.get(1).startsWith("+ novo (build)"), "novo com build marca")
    assert(plan3.get(2).startsWith("+ mudou"), "novo sem build nao marca")
    var wanted4 = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":9090,\"build\":\"make dist\"}]}")
    var plan4 = diffDeployment(live, wanted4)
    assert(plan4.get(0).startsWith("~ site (build)"), "mudado com build marca")
    // Artifact aparece junto no plan sem tocar o disco: o operador ve que o
    // deploy vai conferir um arquivo local (e barrar o publish se sumiu).
    // Combina com build na mesma linha, na mesma ordem do manifesto.
    var wanted5 = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080,\"artifact\":\"dist/index.html\"},{\"name\":\"novo\",\"port\":3000,\"build\":\"npm run build\",\"artifact\":\"dist/app.js\"},{\"name\":\"mudou\",\"port\":3000,\"exposure\":\"PRIVATE\"}]}")
    var plan5 = diffDeployment(live, wanted5)
    assert(plan5.get(0) == "= site (artifact) (igual)", "igual com artifact marca")
    assert(plan5.get(1).startsWith("+ novo (build) (artifact)"), "novo com build+artifact marca os dois")
    assert(plan5.get(2).startsWith("+ mudou"), "novo sem nada nao marca")
}

test "deploy: build opcional no manifesto executa antes do publish", "deploy-build" {
    // Puro no parse + execucao real de comandos triviais (/bin/true e
    // /bin/false existem em Linux; o deploy roda no Linux). Ausente = sem
    // build (comportamento anterior, inalterado); presente e repassado como
    // esta; vazio equivale a ausente.
    var plain = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080}]}")
    assert(plain.get(0).build == "", "ausente vira vazio")
    var withBuild = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080,\"build\":\"npm run build\"}]}")
    assert(withBuild.get(0).build == "npm run build", "comando repassado")
    assert(withBuild.get(0).port == 8080, "resto intacto")
    var emptyBuild = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080,\"build\":\"\"}]}")
    assert(emptyBuild.get(0).build == "", "vazio vira ausente")
    // Execucao: vazio = skip honesto (nao toca o shell); true = ok;
    // false = exit 1 com motivo; comando inexistente = erro honesto.
    var skipped = runServiceBuild("")
    assert(skipped.ok == true, "sem build: ok")
    assert(skipped.detail == "sem build", "sem build: motivo")
    var good = runServiceBuild("/bin/true")
    assert(good.ok == true, "exit 0: ok")
    var bad = runServiceBuild("/bin/false")
    assert(bad.ok == false, "exit 1: falha")
    assert(bad.detail.indexOf("exit 1") >= 0, "exit no motivo")
    var missing = runServiceBuild("/nao/existe/kofcloud-build-" + crypto.randomHex(4))
    assert(missing.ok == false, "inexistente: falha honesta")
    // Artefato opcional: ausente vira "" (sem checagem, como sem build);
    // presente e repassado como esta; vazio equivale a ausente.
    assert(plain.get(0).artifact == "", "sem artifact: vazio")
    var withArtifact = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080,\"build\":\"npm run build\",\"artifact\":\"dist/index.html\"}]}")
    assert(withArtifact.get(0).artifact == "dist/index.html", "caminho repassado")
    assert(withArtifact.get(0).build == "npm run build", "build intacto")
    var emptyArtifact = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080,\"artifact\":\"\"}]}")
    assert(emptyArtifact.get(0).artifact == "", "vazio vira ausente")
    // So-espacos equivale a ausente (trim no parse): nao marca (build)/
    // (artifact) no plan, nao executa shell vazio, nao barra o publish.
    var blankBuild = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080,\"build\":\"   \"}]}")
    assert(blankBuild.get(0).build == "", "build so-espacos vira ausente")
    var blankArtifact = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080,\"artifact\":\"   \"}]}")
    assert(blankArtifact.get(0).artifact == "", "artifact so-espacos vira ausente")
    // Defesa em profundidade (puras toleram direto, sem passar pelo parse):
    // so-espacos comporta-se como ausente em run/build, plan e check.
    var blankSkipped = runServiceBuild("   ")
    assert(blankSkipped.ok == true, "build direto so-espacos: skip")
    assert(blankSkipped.detail == "sem build", "build direto so-espacos: motivo")
    assert(artifactProblem("site", "   ") == "", "artifact direto so-espacos: nada a apontar")
    // artifactProblem pura (so File().exists(), sem rede/HOME): sem
    // artifact = "" (sem checagem); caminho existente = ""; inexistente =
    // problema formatado igual ao do --check (mesma funcao nos dois).
    assert(artifactProblem("site", "") == "", "sem artifact: nada a apontar")
    assert(artifactProblem("site", "src/Main.kf") == "", "existente: ok")
    var ghost = "/nao/existe/kofcloud-artifact-" + crypto.randomHex(4)
    var flagged = artifactProblem("site", ghost)
    assert(flagged.indexOf("site") >= 0, "nomeia o servico")
    assert(flagged.indexOf("artefato ausente") >= 0, "nomeia o problema")
    assert(flagged.indexOf(ghost) >= 0, "mostra o caminho")
    assert(flagged.indexOf("deploy") >= 0, "orienta o re-deploy")
}

test "deploy: fim a fim publica e down remove so o manifesto", "deploy-e2e" {
    var controlPort = 19711
    var path = "/tmp/kofcloud-depe2e-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control plane no ar")

    // Conta + device + UM servico fora do manifesto (deploy nao toca nele).
    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var accountToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var extraBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"extra\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"9999\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    assert(statusOf(httpPostJson(controlPort, "/v1/services", extraBody, accountToken)) == 200, "extra fora do manifesto")

    var manifest = "{\"services\":[{\"name\":\"site\",\"port\":8080},{\"name\":\"api\",\"port\":3000,\"exposure\":\"AUTHENTICATED\"}]}"
    var file = deployManifest("e2e", manifest)

    // deploy via HTTP direto (o cmdDeploy precisa de sessao local; aqui
    // exercitamos o protocolo que ele usa, com o mesmo corpo).
    var services = parseManifest(manifest)
    assert(services.size == 2, "manifesto parseado")
    for (var wanted in services) {
        var body = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"" + wanted.name + "\",\"localAddress\":\"" + wanted.address + "\",\"localPort\":\"" + intToString(wanted.port) + "\",\"protocol\":\"http\",\"exposure\":\"" + wanted.exposure + "\"}"
        assert(statusOf(httpPostJson(controlPort, "/v1/services", body, accountToken)) == 200, "publicado: " + wanted.name)
    }
    // Idempotente: publicar de novo nao duplica.
    for (var wanted in services) {
        var body = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"" + wanted.name + "\",\"localAddress\":\"" + wanted.address + "\",\"localPort\":\"" + intToString(wanted.port) + "\",\"protocol\":\"http\",\"exposure\":\"" + wanted.exposure + "\"}"
        assert(statusOf(httpPostJson(controlPort, "/v1/services", body, accountToken)) == 200, "re-publica ok")
    }
    // Tres servicos agora (extra + 2 do manifesto), sem duplicata.
    var listedRaw = httpGetToken(controlPort, "/v1/services", accountToken)
    assert(statusOf(listedRaw) == 200, "lista autenticada")
    assert(countOccurrences(bodyOf(listedRaw), "\"name\"") == 3, "tres servicos, sem duplicata")

    // down remove SO os do manifesto (extra sobrevive).
    for (var wanted in services) {
        var target = serviceIdByNameIn(listedRaw, wanted.name)
        assert(target.length > 0, "alvo existe: " + wanted.name)
        var removeBody = "{\"serviceId\":\"" + target + "\"}"
        assert(statusOf(httpPostJson(controlPort, "/v1/services/remove", removeBody, accountToken)) == 200, "removido: " + wanted.name)
    }
    // down idempotente: remover de novo da 404, sem quebrar nada.
    var ghost = "{\"serviceId\":\"inexistente\"}"
    assert(statusOf(httpPostJson(controlPort, "/v1/services/remove", ghost, accountToken)) == 404, "remover de novo -> 404")
    var afterRaw = httpGetToken(controlPort, "/v1/services", accountToken)
    assert(countOccurrences(bodyOf(afterRaw), "\"name\"") == 1, "so o extra sobreviveu")
    assert(bodyOf(afterRaw).indexOf("\"extra\"") >= 0, "extra intacto")

    // --prune fecha o drift: orfao do MESMO device some; de outro device,
    // nunca (escopo do prune e o device atual).
    var otherDevice = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"cel\",\"publicKey\":\"pk2\"}", accountToken)
    var otherId = mapField(json.decode<Map<String, String>>(bodyOf(otherDevice)), "deviceId")
    var otherBody = "{\"deviceId\":\"" + otherId + "\",\"name\":\"alheio\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"9998\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    assert(statusOf(httpPostJson(controlPort, "/v1/services", otherBody, accountToken)) == 200, "servico de outro device")
    // Simula o prune: diff dos publicados DESTE device contra o manifesto.
    var prePrune = httpGetToken(controlPort, "/v1/services", accountToken)
    var pruned = pruneOrphans(controlPort, accountToken, deviceId, services)
    assert(pruned == 1, "um orfao podado (o extra)")
    var postPrune = httpGetToken(controlPort, "/v1/services", accountToken)
    assert(bodyOf(postPrune).indexOf("\"extra\"") < 0, "extra sumiu")
    assert(bodyOf(postPrune).indexOf("\"alheio\"") >= 0, "outro device intacto")
}

// Replica a regra do cmdDown --prune via protocolo: remove publicados
// DESTE device fora do manifesto; devolve quantos removeu.
Int pruneOrphans(Int controlPort, String token, String deviceId, List<ManifestService> wanted) {
    var pruned = 0
    var live = json.decode<List<Service>>(bodyOf(httpGetToken(controlPort, "/v1/services", token)))
    for (var service in live) {
        if (service.deviceId != deviceId) {
            continue
        }
        var declared = false
        for (var item in wanted) {
            if (service.name == item.name) {
                declared = true
            }
        }
        if (declared == false) {
            var removeBody = "{\"serviceId\":\"" + service.id + "\"}"
            assert(statusOf(httpPostJson(controlPort, "/v1/services/remove", removeBody, token)) == 200, "podado: " + service.name)
            pruned = pruned + 1
        }
    }
    return pruned
}

test "deploy: verify acusa servico fora do ar e aprova quando sobe", "deploy-check" {
    var controlPort = 19721
    var path = "/tmp/kofcloud-depchk-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(controlPort, 60), "control plane no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var accountToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var manifest = "{\"services\":[{\"name\":\"site\",\"port\":19729}]}"
    var services = parseManifest(manifest)
    var controlUrl = "http://127.0.0.1:" + intToString(controlPort)
    for (var wanted in services) {
        var body = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"" + wanted.name + "\",\"localAddress\":\"" + wanted.address + "\",\"localPort\":\"" + intToString(wanted.port) + "\",\"protocol\":\"http\",\"exposure\":\"" + wanted.exposure + "\"}"
        assert(statusOf(httpPostJson(controlPort, "/v1/services", body, accountToken)) == 200, "publicado")
    }

    // Publicado mas sem ninguem escutando: check acusa, sem derrubar nada.
    var down = verifyDeployment(controlUrl, accountToken, services)
    assert(down.size == 1, "um problema")
    assert(down.get(0).indexOf("site") >= 0, "nomeia o servico")
    assert(down.get(0).indexOf("sem resposta") >= 0, "diz que nao responde")

    // Sobe um listener cru na porta: check aprova.
    var listener = net.listen(19729)
    var slowServer = spawn {
        var serving = true
        while (serving) {
            try {
                var peer = listener.accept()
                peer.close()
            } catch (String e) {
                serving = false
            }
        }
    }
    assert(waitForPort(19729, 60), "servico local no ar")
    var up = verifyDeployment(controlUrl, accountToken, services)
    assert(up.size == 0, "tudo saudavel")
    assert(checkLocalService("127.0.0.1", 19729), "check unitario ok")
    assert(checkLocalService("127.0.0.1", 19728) == false, "porta fechada recusa")
    listener.close()

    // Drift de config: remove e republica o mesmo nome com porta/exposicao
    // diferentes (o publish e idempotente por nome — re-publicar retorna o
    // existente sem atualizar; drift real vem de remove+publish). O check
    // acusa ANTES de testar resposta, com o diff e a dica de re-deploy.
    var listedDrift = httpGetToken(controlPort, "/v1/services", accountToken)
    var driftTarget = serviceIdByNameIn(listedDrift, "site")
    assert(driftTarget.length > 0, "alvo existe")
    assert(statusOf(httpPostJson(controlPort, "/v1/services/remove", "{\"serviceId\":\"" + driftTarget + "\"}", accountToken)) == 200, "removido")
    var driftBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"19728\",\"protocol\":\"http\",\"exposure\":\"PRIVATE\"}"
    assert(statusOf(httpPostJson(controlPort, "/v1/services", driftBody, accountToken)) == 200, "republicado com drift")
    var drifted = verifyDeployment(controlUrl, accountToken, services)
    assert(drifted.size == 1, "um problema de drift")
    assert(drifted.get(0).indexOf("config diferente") >= 0, "acusa o drift")
    assert(drifted.get(0).indexOf("deploy") >= 0, "orienta o re-deploy")

    // Artefato declarado mas ausente no disco: mesmo publicado e
    // respondendo, o check avisa staleness (e o doctor tambem, via o mesmo
    // verifyDeployment). Sem artifact no manifesto = sem aviso.
    // Re-publica sem drift para isolar o cenario do artefato (o republicado
    // tem id novo — re-lista em vez de reusar o driftTarget removido).
    var relisted = httpGetToken(controlPort, "/v1/services", accountToken)
    var driftedId = serviceIdByNameIn(relisted, "site")
    assert(statusOf(httpPostJson(controlPort, "/v1/services/remove", "{\"serviceId\":\"" + driftedId + "\"}", accountToken)) == 200, "drift removido")
    var cleanBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"19729\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    assert(statusOf(httpPostJson(controlPort, "/v1/services", cleanBody, accountToken)) == 200, "republicado limpo")
    // Reabre o listener: o verify checa resposta antes do artefato, e o
    // listener original fechou no fim do cenario anterior.
    var listener2 = net.listen(19729)
    var serving2 = spawn {
        var open = true
        while (open) {
            try {
                var peer = listener2.accept()
                peer.close()
            } catch (String e) {
                open = false
            }
        }
    }
    assert(waitForPort(19729, 60), "servico local no ar de novo")
    var staleManifest = "{\"services\":[{\"name\":\"site\",\"port\":19729,\"artifact\":\"/nao/existe/kofcloud-artifact-" + crypto.randomHex(4) + "\"}]}"
    var stale = verifyDeployment(controlUrl, accountToken, parseManifest(staleManifest))
    assert(stale.size == 1, "um aviso de artefato")
    assert(stale.get(0).indexOf("artefato ausente") >= 0, "nomeia o artefato")
    assert(stale.get(0).indexOf("deploy") >= 0, "orienta o re-deploy")
    var noArtifact = verifyDeployment(controlUrl, accountToken, services)
    assert(noArtifact.size == 0, "sem artifact: tudo saudavel")
    listener2.close()
}

Int serviceCount(String controlUrl, String token, Int port) {
    return 0
}

// Conta ocorrencias nao sobrepostas (para contar servicos no JSON listado).
Int countOccurrences(String haystack, String needle) {
    if (needle.length == 0) {
        return 0
    }
    var count = 0
    var from = 0
    while (from <= haystack.length - needle.length) {
        var found = haystack.indexOf(needle, from)
        if (found < 0) {
            break
        }
        count = count + 1
        from = found + needle.length
    }
    return count
}

// Extrai o id do servico com o nome dado do corpo de GET /v1/services.
// "" quando ausente. O serviceJson do control plane emite "id" ANTES de
// "name", entao a busca e para tras a partir do nome (sem risco de pegar o
// id do servico vizinho).
String serviceIdByNameIn(String servicesRaw, String name) {
    var body = bodyOf(servicesRaw)
    var needle = "\"name\":\"" + name + "\""
    var at = body.indexOf(needle)
    if (at < 0) {
        return ""
    }
    var idKey = "\"id\":\""
    var head = body.substring(0, at)
    var back = head.lastIndexOf(idKey)
    if (back < 0) {
        return ""
    }
    var start = back + idKey.length
    var end = head.indexOf("\"", start)
    if (end < 0) {
        return ""
    }
    return head.substring(start, end)
}

test "deploy: loadManifestFile distingue ausente, invalido e valido", "deploy-load" {
    // Pura na decisao (so IO: ler + parsear) — cobre o caminho que
    // cmdDeploy/cmdDown usam antes de qualquer rede/sessao.
    assert(resolveManifestPath("") == "kofcloud.json", "vazio vira default")
    assert(resolveManifestPath("   ") == "kofcloud.json", "so-espacos vira default")
    assert(resolveManifestPath("  /tmp/x.json  ") == "/tmp/x.json", "padding apara")
    assert(resolveManifestPath("/tmp/x.json") == "/tmp/x.json", "flag passa direto")
    var missing = loadManifestFile("/tmp/kofcloud-deploy-ausente-" + crypto.randomHex(8) + ".json")
    assert(missing.ok == false, "inexistente falha")
    assert(missing.error.indexOf("nao encontrado") >= 0, "diz que nao achou")
    assert(missing.services.size == 0, "sem servicos no erro")
    var emptyPath = deployManifest("vazio-load", "")
    var empty = loadManifestFile(emptyPath)
    assert(empty.ok == false, "vazio falha")
    assert(empty.error.indexOf("nao encontrado") >= 0, "vazio e 'nao encontrado'")
    var badPath = deployManifest("bad-load", "{\"services\":[{\"name\":\"x\"}]}")
    var bad = loadManifestFile(badPath)
    assert(bad.ok == false, "invalido falha")
    assert(bad.error.indexOf("invalido") >= 0, "diz que e invalido")
    assert(bad.error.indexOf(badPath) >= 0, "erro cita o caminho")
    var goodPath = deployManifest("good-load", "{\"services\":[{\"name\":\"site\",\"port\":8080}]}")
    var good = loadManifestFile(goodPath)
    assert(good.ok == true, "valido passa")
    assert(good.error == "", "sem erro no ok")
    assert(good.services.size == 1, "um servico")
    assert(good.services.get(0).name == "site", "nome certo")
}
