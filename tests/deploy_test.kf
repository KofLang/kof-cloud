import kofcloud.cli.Commands
import kofcloud.cli.Usage
import kofcloud.protocol.Bytes
import kofcloud.cli.Deploy
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.model.Service
import kofcloud.store.Store
import kofcloud.util.Limits
import testkit.Support

// Fase 7 slice 1 — deploy declarativo: publica o que esta no manifesto e
// nada alem dele. Sem build, sem artefato, sem daemon: so publish em lote.
// `down` faz o inverso; nada fora do manifesto e tocado.

String deployManifest(String name, String body) {
    var path = "/tmp/kofcloud-deploy-" + name + "-" + crypto.randomHex(4) + ".json"
    File(path).writeText(body)
    return path
}

test "deploy: manifesto valido com defaults", "deploy" {
    var services = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080},{\"name\":\"api\",\"port\":3000,\"exposure\":\"AUTHENTICATED\",\"address\":\"localhost\"}]}")
    need(services.size == 2, "falhou")
    need(services.get(0).name == "site", "falhou")
    need(services.get(0).port == 8080, "falhou")
    need(services.get(0).address == "127.0.0.1", "falhou")
    need(services.get(0).exposure == "PUBLIC", "falhou")
    need(services.get(0).protocol == "http", "falhou")
    need(services.get(1).exposure == "AUTHENTICATED", "falhou")
    need(services.get(1).address == "localhost", "falhou")
    need(services.get(1).protocol == "http", "falhou")
}

test "deploy: manifesto com port como string (formato da API)", "deploy-str" {
    var services = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":\"8080\"}]}")
    need(services.size == 1, "falhou")
    need(services.get(0).port == 8080, "falhou")
}

test "deploy: manifestos invalidos com erro posicional", "deploy-err" {
    // Arquivo inexistente e arquivo vazio caem no mesmo caminho honesto:
    // readTextOr devolve "" e o cmdDeploy/cmdDown respondem "manifesto nao
    // encontrado" antes de qualquer parse ou rede.
    var missing = readTextOr("/tmp/kofcloud-deploy-inexistente-" + crypto.randomHex(8) + ".json", "")
    need(missing == "", "falhou")
    var emptyPath = deployManifest("vazio", "")
    need(readTextOr(emptyPath, "") == "", "falhou")
    var bad1 = ""
    try {
        parseManifest("")
    } catch (String e) {
        bad1 = e
    }
    need(bad1 == "manifesto vazio", "falhou")

    var bad2 = ""
    try {
        parseManifest("{\"services\":[]}")
    } catch (String e) {
        bad2 = e
    }
    need(bad2 == "manifesto sem servicos", "falhou")

    var bad3 = ""
    try {
        parseManifest("{\"services\":[{\"port\":8080}]}")
    } catch (String e) {
        bad3 = e
    }
    need(bad3 == "servico sem nome na posicao 0", "falhou")

    var bad4 = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"site\"}]}")
    } catch (String e) {
        bad4 = e
    }
    need(bad4 == "servico \"site\" sem porta valida (1-65535)", "falhou")

    var bad5 = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"a\",\"port\":1},{\"name\":\"b\"}]}")
    } catch (String e) {
        bad5 = e
    }
    need(bad5 == "servico \"b\" sem porta valida (1-65535)", "falhou")

    var bad6 = ""
    try {
        parseManifest("{\"services\":{\"name\":\"site\"}}")
    } catch (String e) {
        bad6 = e
    }
    need(bad6 == "lista \"services\" nao e um array JSON", "falhou")

    var bad7 = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"a\",\"port\":1}")
    } catch (String e) {
        bad7 = e
    }
    need(bad7.indexOf("malformada") >= 0, "falhou")

    // Nome repetido e ambiguidade, nao "dois servicos": o publish e
    // idempotente por nome, entao o segundo item reescrevia a config do
    // primeiro em silencio. Recusa posicional, antes de build/publish.
    var dupName = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080},{\"name\":\"site\",\"port\":9090}]}")
    } catch (String e) {
        dupName = e
    }
    need(dupName.indexOf("duplicado") >= 0, "falhou")
    need(dupName.indexOf("\"site\"") >= 0, "falhou")
    need(dupName.indexOf("posicao 1") >= 0, "falhou")
    // Nomes diferentes, mesmo prefixo, passam (nao e comparacao parcial).
    var similar = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080},{\"name\":\"site2\",\"port\":9090}]}")
    need(similar.size == 2, "falhou")
    // Duplicado com espacos sobrando tambem casa (o trim roda antes).
    var dupTrim = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080},{\"name\":\"  site  \",\"port\":9090}]}")
    } catch (String e) {
        dupTrim = e
    }
    need(dupTrim.indexOf("duplicado") >= 0, "falhou")

    // Chave "port" dentro de valor nao confunde ("portaria" tem "port" mas
    // sem as aspas de fechamento na posicao certa).
    var tricky = parseManifest("{\"services\":[{\"name\":\"portaria\",\"port\":9000}]}")
    need(tricky.get(0).name == "portaria", "falhou")
    need(tricky.get(0).port == 9000, "falhou")

    // Campo repetido na MESMA entrada: `manifestField` devolve a primeira
    // ocorrencia, entao um segundo "exposure":"PUBLIC" era ignorado em
    // silencio (medido: PRIVATE depois PUBLIC parseava PRIVATE). Uma
    // segunda exposicao escrita a mao e copia-paste sem editar — recusa
    // posicional como o nome repetido.
    var dupField = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"db\",\"port\":5432,\"exposure\":\"PRIVATE\",\"exposure\":\"PUBLIC\"}]}")
    } catch (String e) {
        dupField = e
    }
    need(dupField.indexOf("repetido") >= 0, "falhou")
    need(dupField.indexOf("\"exposure\"") >= 0, "falhou")
    need(dupField.indexOf("\"db\"") >= 0, "falhou")
    var dupPortField = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080,\"port\" : 9090}]}")
    } catch (String e) {
        dupPortField = e
    }
    need(dupPortField.indexOf("\"port\" repetido") >= 0, "falhou")
    // Mesma chave em servicos DIFERENTES nao e repeticao.
    var twoServices = parseManifest("{\"services\":[{\"name\":\"a\",\"port\":8080},{\"name\":\"b\",\"port\":8081}]}")
    need(twoServices.size == 2, "falhou")
    // Chave aparente dentro de string nao conta.
    var quoted = parseManifest("{\"services\":[{\"name\":\"a \\\"port\\\": 1\",\"port\":8080}]}")
    need(quoted.get(0).port == 8080, "falhou")

    // Exposure desconhecida nao cai para PUBLIC em silencio: typo
    // ("PUBLIK") num servico que devia ser PRIVATE exporia o servico.
    var badExposure = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"db\",\"port\":5432,\"exposure\":\"PUBLIK\"}]}")
    } catch (String e) {
        badExposure = e
    }
    need(badExposure == "servico \"db\" com exposure invalida: PUBLIK", "falhou")
    // Vazia continua defaultando (ausente != invalido); as validas passam.
    var defaulted = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080},{\"name\":\"db\",\"port\":5432,\"exposure\":\"PRIVATE\"}]}")
    need(defaulted.get(0).exposure == "PUBLIC", "falhou")

    // Protocol fora do MVP falha no parse, antes de publicar qualquer coisa.
    var badProtocol = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"db\",\"port\":5432,\"protocol\":\"tcp\"}]}")
    } catch (String e) {
        badProtocol = e
    }
    need(badProtocol == "servico \"db\" com protocol invalido: tcp", "falhou")
    need(defaulted.get(1).exposure == "PRIVATE", "falhou")

    // Address fora de loopback falha no parse: o Agent conecta nesse
    // endereco — externo o transformaria em escaneador (SSRF). Lista
    // fechada: 127.0.0.1, localhost, ::1; ausente defaulta.
    var badAddress = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"db\",\"port\":5432,\"address\":\"10.0.0.5\"}]}")
    } catch (String e) {
        badAddress = e
    }
    need(badAddress == "servico \"db\" com address invalido: 10.0.0.5", "falhou")
    var loopbacks = parseManifest("{\"services\":[{\"name\":\"a\",\"port\":1,\"address\":\"localhost\"},{\"name\":\"b\",\"port\":2,\"address\":\"::1\"}]}")
    need(loopbacks.get(0).address == "localhost", "falhou")
    need(loopbacks.get(1).address == "::1", "falhou")

    // Teto de porta: acima de 65535 falha no parse (antes passava e
    // quebrava so no relay/health).
    var bigPort = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"site\",\"port\":70000}]}")
    } catch (String e) {
        bigPort = e
    }
    need(bigPort == "servico \"site\" sem porta valida (1-65535)", "falhou")

    // Espacos sobrando sao aparados (manifesto escrito a mao): nome,
    // porta-string, address, exposure e protocol com padding passam
    // aparados; nome so-espacos falha como sem nome (posicional), em vez
    // de publicar um servico em branco.
    var padded = parseManifest("{\"services\":[{\"name\":\"  site  \",\"port\":\" 8080 \",\"address\":\" localhost \",\"exposure\":\" PRIVATE \",\"protocol\":\" http \"}]}")
    need(padded.get(0).name == "site", "falhou")
    need(padded.get(0).port == 8080, "falhou")
    need(padded.get(0).address == "localhost", "falhou")
    need(padded.get(0).exposure == "PRIVATE", "falhou")
    need(padded.get(0).protocol == "http", "falhou")
    var blankName = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"   \",\"port\":8080}]}")
    } catch (String e) {
        blankName = e
    }
    need(blankName == "servico sem nome na posicao 0", "falhou")

    // Allowlist WAF (Fase 10 slice 3): ausente vira "" (sem restricao, como
    // servico legado); presente e normalizado com as mesmas funcoes da API;
    // malformado falha posicional no parse (nao publica regra morta).
    var noPolicy = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080}]}")
    need(noPolicy.get(0).allowMethods == "", "falhou")
    need(noPolicy.get(0).allowPaths == "", "falhou")
    var withPolicy = parseManifest("{\"services\":[{\"name\":\"api\",\"port\":3000,\"allowMethods\":\"GET, POST,GET\",\"allowPaths\":\"/api/*, /health\"}]}")
    need(withPolicy.get(0).allowMethods == "GET,POST", "falhou")
    need(withPolicy.get(0).allowPaths == "/api/*,/health", "falhou")
    var badMethods = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"api\",\"port\":3000,\"allowMethods\":\"get, POST\"}]}")
    } catch (String e) {
        badMethods = e
    }
    need(badMethods == "servico \"api\" com allowMethods invalido: get, POST", "falhou")
    var badPaths = ""
    try {
        parseManifest("{\"services\":[{\"name\":\"api\",\"port\":3000,\"allowPaths\":\"api/*\"}]}")
    } catch (String e) {
        badPaths = e
    }
    need(badPaths == "servico \"api\" com allowPaths invalido: api/*", "falhou")
}

test "deploy: diff mostra o que mudaria sem aplicar", "deploy-plan" {
    // Puro: duas listas, nenhuma rede, nenhum HOME. Cobre novo/igual/
    // diferente/extra numa chamada so (precedente: doctorTunnelLine).
    var live = listOf<Service>()
    live.add(Service("id-site", "acc", "dev", "site", "127.0.0.1", 8080, "http", "site.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0, "", "", ""))
    live.add(Service("id-veterano", "acc", "dev", "veterano", "127.0.0.1", 9000, "http", "veterano.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0, "", "", ""))
    var wanted = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080},{\"name\":\"mudou\",\"port\":3000,\"exposure\":\"PRIVATE\"}]}")
    var plan = diffDeployment(live, wanted)
    need(plan.size == 3, "falhou")
    need(plan.get(0) == "= site (igual)", "falhou")
    need(plan.get(1).startsWith("+ mudou"), "falhou")
    need(plan.get(2).startsWith("- veterano"), "falhou")
    // Mudanca de porta vira ~ (vai atualizar), nao + (novo).
    var wanted2 = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":9090}]}")
    var plan2 = diffDeployment(live, wanted2)
    need(plan2.size == 2, "falhou")
    need(plan2.get(0).startsWith("~ site"), "falhou")
    // Build aparece no plan sem executar: o operador ve que o deploy vai
    // rodar um comando local. Inclusive "=" marca: o deploy executa o build
    // antes de cada publish (mesmo o idempotente), entao "igual" nao e
    // "nada vai acontecer".
    var wanted3 = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080,\"build\":\"npm run build\"},{\"name\":\"novo\",\"port\":3000,\"build\":\"make dist\"},{\"name\":\"mudou\",\"port\":3000,\"exposure\":\"PRIVATE\"}]}")
    var plan3 = diffDeployment(live, wanted3)
    need(plan3.get(0) == "= site (build) (igual)", "falhou")
    need(plan3.get(1).startsWith("+ novo (build)"), "falhou")
    need(plan3.get(2).startsWith("+ mudou"), "falhou")
    var wanted4 = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":9090,\"build\":\"make dist\"}]}")
    var plan4 = diffDeployment(live, wanted4)
    need(plan4.get(0).startsWith("~ site (build)"), "falhou")
    // Artifact aparece junto no plan sem tocar o disco: o operador ve que o
    // deploy vai conferir um arquivo local (e barrar o publish se sumiu).
    // Combina com build na mesma linha, na mesma ordem do manifesto.
    var wanted5 = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080,\"artifact\":\"dist/index.html\"},{\"name\":\"novo\",\"port\":3000,\"build\":\"npm run build\",\"artifact\":\"dist/app.js\"},{\"name\":\"mudou\",\"port\":3000,\"exposure\":\"PRIVATE\"}]}")
    var plan5 = diffDeployment(live, wanted5)
    need(plan5.get(0) == "= site (artifact) (igual)", "falhou")
    need(plan5.get(1).startsWith("+ novo (build) (artifact)"), "falhou")
    need(plan5.get(2).startsWith("+ mudou"), "falhou")
    // Allowlist: servico sem politica contra live sem politica segue "=";
    // so-mudanca-de-politica vira "~" (vai atualizar); live sem politica
    // contra manifesto com politica tambem vira "~". O plan agora diz a
    // verdade: publishService reescreve a config mutavel do existente
    // (antes devolvia o existente sem aplicar nada — ver registry_test).
    var wanted6 = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080,\"allowMethods\":\"GET\",\"allowPaths\":\"/api/*\"}]}")
    var plan6 = diffDeployment(live, wanted6)
    need(plan6.get(0).startsWith("~ site"), "falhou")
    need(plan6.size == 2, "falhou")
    var livePolicy = listOf<Service>()
    livePolicy.add(Service("id-site", "acc", "dev", "site", "127.0.0.1", 8080, "http", "site.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0, "GET", "/api/*", ""))
    var plan7 = diffDeployment(livePolicy, wanted6)
    need(plan7.get(0) == "= site (igual)", "falhou")

    // Escopo por device (o manifesto descreve a maquina LOCAL): publicado
    // NOUTRO device nao e "igual" (o publish responderia 409) e nao e
    // "extra" (o down --prune nunca toca outro device). Medido: sem escopo
    // os dois casos mentiam.
    var liveDevices = listOf<Service>()
    liveDevices.add(Service("id-b", "acc", "devB", "remoto", "127.0.0.1", 7000, "http", "remoto.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0, "", "", ""))
    var wantedDevices = parseManifest("{\"services\":[{\"name\":\"remoto\",\"port\":7000}]}")
    // Sem escopo: igual (comportamento legado, ainda usado por chamadores sem sessao).
    need(diffDeployment(liveDevices, wantedDevices).get(0).startsWith("= remoto"), "falhou")
    // Com escopo: conflito explicito, nunca "+":
    var scopedPlan = diffDeploymentFor(liveDevices, wantedDevices, "devA")
    need(scopedPlan.size == 1, "falhou")
    need(scopedPlan.get(0).startsWith("! remoto"), "falhou")
    need(scopedPlan.get(0).indexOf("devB") >= 0, "falhou")
    // Extra de outro device nao aparece (o prune nao o alcanca).
    var wantedEmpty = parseManifest("{\"services\":[{\"name\":\"meu\",\"port\":9000}]}")
    var legacyPlan = diffDeployment(listOf<Service>(liveDevices.get(0)), wantedEmpty)
    need(legacyPlan.size == 2, "falhou")
    var scopedEmpty = diffDeploymentFor(listOf<Service>(liveDevices.get(0)), wantedEmpty, "devA")
    need(scopedEmpty.size == 1, "falhou")
    need(scopedEmpty.get(0).startsWith("+ meu"), "falhou")
    // Servico DESTE device fora do manifesto continua aparecendo como extra.
    var mine = Service("id-a", "acc", "devA", "orfa", "127.0.0.1", 9100, "http", "orfa.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0, "", "", "")
    var scopedMixed = diffDeploymentFor(listOf<Service>(mine), wantedEmpty, "devA")
    need(scopedMixed.size == 2, "falhou")
    need(scopedMixed.get(1).startsWith("- orfa"), "falhou")
}

test "deploy: sumario do down nao mente quando nada foi removido", "deploy-down-summary" {
    // Puro. Medido: com 3 servicos no manifesto e nenhum publicado o down
    // dizia "3 servico(s) do manifesto removidos" — contava o manifesto, nao
    // o que saiu. O verbo agora depende do que aconteceu.
    need(downSummary(3, 0, 0, 0).indexOf("nada a remover") >= 0, "falhou")
    need(downSummary(3, 0, 0, 0).indexOf("removidos") < 0, "falhou")
    need(downSummary(3, 0, 3, 0).indexOf("3 noutro dispositivo") >= 0, "falhou")
    var one = downSummary(3, 1, 0, 0)
    need(one == "down ok: 1 servico(s) do manifesto removidos", "falhou")
    var two = downSummary(5, 2, 1, 0)
    need(two.indexOf("2 servico(s) do manifesto removidos") >= 0, "falhou")
    // Falha domina o resumo (nao diz "ok" com falha).
    need(downSummary(3, 1, 0, 2) == "down com 2 falha(s)", "falhou")
}

test "deploy: down distingue ausente de publicado noutro dispositivo", "deploy-down-scope" {
    // Puro (precedente: diffDeployment): o `down` resolve o alvo dentro do
    // device da sessao. Antes, um servico homonimo publicado noutro device
    // imprimia "ausente (ok)" — o operador achava que nao havia nada e o
    // servico seguia no ar com o mesmo hostname.
    var live = listOf<Service>()
    live.add(Service("id-a", "acc", "devA", "site", "127.0.0.1", 8080, "http", "site.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0, "", "", ""))
    live.add(Service("id-b", "acc", "devB", "outro", "127.0.0.1", 9000, "http", "outro.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0, "", "", ""))
    need(serviceIdOnDevice(live, "site", "devA") == "id-a", "falhou")
    need(serviceIdOnDevice(live, "site", "devB") == "", "falhou")
    need(serviceIdOnDevice(live, "outro", "devA") == "", "falhou")
    need(serviceIdOnDevice(live, "nao-existe", "devA") == "", "falhou")
    need(serviceDeviceElsewhere(live, "outro", "devA") == "devB", "falhou")
    need(serviceDeviceElsewhere(live, "site", "devA") == "", "falhou")
    need(serviceDeviceElsewhere(live, "nao-existe", "devA") == "", "falhou")
    var line = downElsewhereLine("outro", "devB")
    need(line.indexOf("outro") >= 0, "falhou")
    need(line.indexOf("devB") >= 0, "falhou")
    need(line.indexOf("nao removido") >= 0, "falhou")
    need(line.indexOf("down") >= 0, "falhou")
    // Nome igual em DOIS devices: o proprio vence (remove o dele).
    live.add(Service("id-a2", "acc", "devA", "dup", "127.0.0.1", 7000, "http", "dup.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0, "", "", ""))
    live.add(Service("id-b2", "acc", "devB", "dup", "127.0.0.1", 7001, "http", "dup.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0, "", "", ""))
    need(serviceIdOnDevice(live, "dup", "devA") == "id-a2", "falhou")
}

test "deploy: down exige --yes (guarda pura + contagem de orfaos)", "deploy-down-guard" {
    // Puro. O `down` REMOVE; sem confirmacao explicita ele aborta. Medido:
    // um down que aborta por remocao falha + servico re-publicado entre os
    // dois comandos fazia o down seguinte apagar um servico que o operador
    // nao pediu naquele momento.
    var live = listOf<Service>()
    live.add(Service("id-a", "acc", "devA", "site", "127.0.0.1", 8080, "http", "site.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0, "", "", ""))
    live.add(Service("id-x", "acc", "devA", "velho", "127.0.0.1", 9000, "http", "velho.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0, "", "", ""))
    live.add(Service("id-b", "acc", "devB", "alheio", "127.0.0.1", 7000, "http", "alheio.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0, "", "", ""))
    var services = listOf<ManifestService>()
    services.add(ManifestService("site", "127.0.0.1", 8080, "PUBLIC", "http", "", "", "", "", ""))
    // So o proprio device conta: "velho" (devA, fora do manifesto) = 1 orfao;
    // "alheio" (devB) nunca e orfao do prune.
    need(downOrphanCount(live, services, "devA") == 1, "falhou")
    need(downOrphanCount(live, services, "devB") == 1, "falhou")
    var noServices = listOf<ManifestService>()
    need(downOrphanCount(live, noServices, "devA") == 2, "falhou")
    // Mensagem: nomeia os declarados, e os orfaos so com --prune.
    var msg = downConfirmationRequired(3, 2, true)
    need(msg.indexOf("3 declarado(s)") >= 0, "falhou")
    need(msg.indexOf("2 orfao(s)") >= 0, "falhou")
    need(msg.indexOf("irreversivel") >= 0, "falhou")
    need(msg.indexOf("down --yes") >= 0, "falhou")
    var plain = downConfirmationRequired(1, 5, false)
    need(plain.indexOf("orfao") < 0, "falhou")
}

test "deploy: down --yes repetido barra no uso", "deploy-down-guard" {
    // Booleana repetida barra antes de qualquer rede (mesma regra do
    // --prune/--check), entao roda sem sessao.
    var bad = cmdDown(listOf("--yes", "--yes"))
    need(bad == 1, "falhou")
}

test "deploy: build opcional no manifesto executa antes do publish", "deploy-build" {
    // Puro no parse + execucao real de comandos triviais (/bin/true e
    // /bin/false existem em Linux; o deploy roda no Linux). Ausente = sem
    // build (comportamento anterior, inalterado); presente e repassado como
    // esta; vazio equivale a ausente.
    var plain = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080}]}")
    need(plain.get(0).build == "", "falhou")
    var withBuild = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080,\"build\":\"npm run build\"}]}")
    need(withBuild.get(0).build == "npm run build", "falhou")
    need(withBuild.get(0).port == 8080, "falhou")
    var emptyBuild = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080,\"build\":\"\"}]}")
    need(emptyBuild.get(0).build == "", "falhou")
    // Execucao: vazio = skip honesto (nao toca o shell); true = ok;
    // false = exit 1 com motivo; comando inexistente = erro honesto.
    var skipped = runServiceBuild("")
    need(skipped.ok == true, "falhou")
    need(skipped.detail == "sem build", "falhou")
    var good = runServiceBuild("/bin/true")
    need(good.ok == true, "falhou")
    var bad = runServiceBuild("/bin/false")
    need(bad.ok == false, "falhou")
    need(bad.detail.indexOf("exit 1") >= 0, "falhou")
    var missing = runServiceBuild("/nao/existe/kofcloud-build-" + crypto.randomHex(4))
    need(missing.ok == false, "falhou")
    // Medido: `process.run("echo hi")` procura um executavel com o nome
    // inteiro e falha com exit -1 — o exemplo documentado
    // ("npm run build") nunca funcionou. O build roda pelo shell.
    var withArgs = runServiceBuild("echo hi")
    need(withArgs.ok == true, "falhou")
    var shellExit = runServiceBuild("exit 3")
    need(shellExit.ok == false, "falhou")
    need(shellExit.detail.indexOf("exit 3") >= 0, "falhou")
    var pipeline = runServiceBuild("echo um | tr a-z A-Z")
    need(pipeline.ok == true, "falhou")
    var badCmd = runServiceBuild("no-such-cmd-kofcloud-" + crypto.randomHex(4))
    need(badCmd.ok == false, "falhou")
    var blankArg = runServiceBuild("   ")
    need(blankArg.ok == true, "falhou")
    // Diagnostico: so "exit N" obrigava o operador a reproduzir o comando.
    // O detalhe agora traz a ultima linha de stderr (canal de erro), com
    // stdout como alternativa — uma linha so, nunca o comando.
    var explain = runServiceBuild("echo 'erro: modulo ausente' >&2; exit 2")
    need(explain.ok == false, "falhou")
    need(explain.detail.indexOf("exit 2") >= 0, "falhou")
    need(explain.detail.indexOf("erro: modulo ausente") >= 0, "falhou")
    var stdoutOnly = runServiceBuild("echo 'falhou no passo 3'; exit 1")
    need(stdoutOnly.detail.indexOf("falhou no passo 3") >= 0, "falhou")
    var silent = runServiceBuild("exit 4")
    need(silent.detail == "build falhou (exit 4)", "falhou")
    var noisy = runServiceBuild("echo primeira >&2; echo ULTIMA >&2; exit 5")
    need(noisy.detail.indexOf("ULTIMA") >= 0, "falhou")
    need(noisy.detail.indexOf("primeira") < 0, "falhou")
    need(lastLineOf("a\n\nb  \n") == "b", "falhou")
    need(lastLineOf("") == "", "falhou")
    need(buildFailureDetail(7, "", "") == "build falhou (exit 7)", "falhou")
    // Artefato opcional: ausente vira "" (sem checagem, como sem build);
    // presente e repassado como esta; vazio equivale a ausente.
    need(plain.get(0).artifact == "", "falhou")
    var withArtifact = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080,\"build\":\"npm run build\",\"artifact\":\"dist/index.html\"}]}")
    need(withArtifact.get(0).artifact == "dist/index.html", "falhou")
    need(withArtifact.get(0).build == "npm run build", "falhou")
    var emptyArtifact = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080,\"artifact\":\"\"}]}")
    need(emptyArtifact.get(0).artifact == "", "falhou")
    // So-espacos equivale a ausente (trim no parse): nao marca (build)/
    // (artifact) no plan, nao executa shell vazio, nao barra o publish.
    var blankBuild = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080,\"build\":\"   \"}]}")
    need(blankBuild.get(0).build == "", "falhou")
    var blankArtifact = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":8080,\"artifact\":\"   \"}]}")
    need(blankArtifact.get(0).artifact == "", "falhou")
    // Defesa em profundidade (puras toleram direto, sem passar pelo parse):
    // so-espacos comporta-se como ausente em run/build, plan e check.
    var blankSkipped = runServiceBuild("   ")
    need(blankSkipped.ok == true, "falhou")
    need(blankSkipped.detail == "sem build", "falhou")
    need(artifactProblem("site", "   ") == "", "falhou")
    // artifactProblem pura (so File().exists(), sem rede/HOME): sem
    // artifact = "" (sem checagem); caminho existente = ""; inexistente =
    // problema formatado igual ao do --check (mesma funcao nos dois).
    need(artifactProblem("site", "") == "", "falhou")
    need(artifactProblem("site", "src/Main.kf") == "", "falhou")
    var ghost = "/nao/existe/kofcloud-artifact-" + crypto.randomHex(4)
    var flagged = artifactProblem("site", ghost)
    need(flagged.indexOf("site") >= 0, "falhou")
    need(flagged.indexOf("artefato ausente") >= 0, "falhou")
    need(flagged.indexOf(ghost) >= 0, "falhou")
    need(flagged.indexOf("deploy") >= 0, "falhou")
    // Medido: `File(dir).exists()` e true para DIRETORIO, entao o deploy
    // publicava um servico cujo "artefato" era uma pasta. Exige-se conteudo
    // legivel (readText != null), nao so existencia.
    var dir = "/tmp/kofcloud-deploy-diretorio-" + crypto.randomHex(4)
    Directory(dir).createDirectories()
    need(artifactProblem("site", dir) != "", "falhou")
    var plainFile = dir + "/index.html"
    File(plainFile).writeText("<h1>oi</h1>")
    need(artifactProblem("site", plainFile) == "", "falhou")
    var emptyFile = dir + "/vazio"
    File(emptyFile).writeText("")
    need(artifactProblem("site", emptyFile) == "", "falhou")
    File(emptyFile).delete()
}

test "deploy: fim a fim publica e down remove so o manifesto", "deploy-e2e" {
    var controlPort = 19711
    var path = "/tmp/kofcloud-depe2e-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    // Teto de servicos por device elevado: este cenario publica varios
    // (manifesto + orfaos + homonimos) e o default (10) faria o publish
    // falhar no meio, escondendo o que o teste mede.
    registry.setLimits(5, 40)
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")

    // Conta + device + UM servico fora do manifesto (deploy nao toca nele).
    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var accountToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var extraBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"extra\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"9999\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    need(statusOf(httpPostJson(controlPort, "/v1/services", extraBody, accountToken)) == 200, "falhou")

    var manifest = "{\"services\":[{\"name\":\"site\",\"port\":8080},{\"name\":\"api\",\"port\":3000,\"exposure\":\"AUTHENTICATED\"}]}"
    var file = deployManifest("e2e", manifest)

    // deploy via HTTP direto (o cmdDeploy precisa de sessao local; aqui
    // exercitamos o protocolo que ele usa, com o mesmo corpo).
    var services = parseManifest(manifest)
    need(services.size == 2, "falhou")
    for (var wanted in services) {
        var body = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"" + wanted.name + "\",\"localAddress\":\"" + wanted.address + "\",\"localPort\":\"" + intToString(wanted.port) + "\",\"protocol\":\"http\",\"exposure\":\"" + wanted.exposure + "\"}"
        need(statusOf(httpPostJson(controlPort, "/v1/services", body, accountToken)) == 200, "falhou")
    }
    // Idempotente: publicar de novo nao duplica.
    for (var wanted in services) {
        var body = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"" + wanted.name + "\",\"localAddress\":\"" + wanted.address + "\",\"localPort\":\"" + intToString(wanted.port) + "\",\"protocol\":\"http\",\"exposure\":\"" + wanted.exposure + "\"}"
        need(statusOf(httpPostJson(controlPort, "/v1/services", body, accountToken)) == 200, "falhou")
    }
    // Tres servicos agora (extra + 2 do manifesto), sem duplicata.
    var listedRaw = httpGetToken(controlPort, "/v1/services", accountToken)
    need(statusOf(listedRaw) == 200, "falhou")
    need(countOccurrences(bodyOf(listedRaw), "\"name\"") == 3, "falhou")

    // down remove SO os do manifesto (extra sobrevive).
    for (var wanted in services) {
        var target = serviceIdByNameIn(listedRaw, wanted.name)
        need(target.length > 0, "falhou")
        var removeBody = "{\"serviceId\":\"" + target + "\"}"
        need(statusOf(httpPostJson(controlPort, "/v1/services/remove", removeBody, accountToken)) == 200, "falhou")
    }
    // down idempotente: remover de novo da 404, sem quebrar nada.
    var ghost = "{\"serviceId\":\"inexistente\"}"
    need(statusOf(httpPostJson(controlPort, "/v1/services/remove", ghost, accountToken)) == 404, "falhou")
    var afterRaw = httpGetToken(controlPort, "/v1/services", accountToken)
    need(countOccurrences(bodyOf(afterRaw), "\"name\"") == 1, "falhou")
    need(bodyOf(afterRaw).indexOf("\"extra\"") >= 0, "falhou")

    // --prune fecha o drift: orfao do MESMO device some; de outro device,
    // nunca (escopo do prune e o device atual).
    // Homonimo noutro device: o hostname e `<nome>.<handle>` — igual para
    // os dois — entao dois servicos homonimos na mesma conta seriam
    // inalcancaveis (o roteamento casa o primeiro). Medido: antes o publish
    // devolvia 200 com o servico do OUTRO device e nada era publicado.
    // Agora e 409 KCF139.
    var otherDevice = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"cel\",\"publicKey\":\"pk2\"}", accountToken)
    var otherId = mapField(json.decode<Map<String, String>>(bodyOf(otherDevice)), "deviceId")
    var homonymBody = "{\"deviceId\":\"" + otherId + "\",\"name\":\"extra\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"9998\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    var homonymResp = httpPostJson(controlPort, "/v1/services", homonymBody, accountToken)
    need(statusOf(homonymResp) == 409, "falhou")
    need(bodyOf(homonymResp).indexOf("KCF139") >= 0, "falhou")
    var otherBody = "{\"deviceId\":\"" + otherId + "\",\"name\":\"alheio\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"9998\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    need(statusOf(httpPostJson(controlPort, "/v1/services", otherBody, accountToken)) == 200, "falhou")
    // Simula o prune: diff dos publicados DESTE device contra o manifesto.
    var prePrune = httpGetToken(controlPort, "/v1/services", accountToken)
    var pruned = pruneOrphans(controlPort, accountToken, deviceId, services)
    need(pruned == 1, "falhou")
    var postPrune = httpGetToken(controlPort, "/v1/services", accountToken)
    need(bodyOf(postPrune).indexOf("\"extra\"") < 0, "falhou")
    need(bodyOf(postPrune).indexOf("\"alheio\"") >= 0, "falhou")
}

// Replica a regra do cmdDown --prune via protocolo: remove publicados
// DESTE device fora do manifesto; devolve quantos removeu.
Int pruneOrphans(Int controlPort, String token, String deviceId, List<ManifestService> wanted) {
    var pruned = 0
    var live = json.decode<List<Service>>(bodyOf(httpGetToken(controlPort, "/v1/services", token)))
    for (var service in live) {
        if (service.deviceId != deviceId) {
            continue
        }
        var declared = false
        for (var item in wanted) {
            if (service.name == item.name) {
                declared = true
            }
        }
        if (declared == false) {
            var removeBody = "{\"serviceId\":\"" + service.id + "\"}"
            need(statusOf(httpPostJson(controlPort, "/v1/services/remove", removeBody, token)) == 200, "falhou")
            pruned = pruned + 1
        }
    }
    return pruned
}

test "deploy: verify acusa servico fora do ar e aprova quando sobe", "deploy-check" {
    var controlPort = 19721
    var path = "/tmp/kofcloud-depchk-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var accountToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var manifest = "{\"services\":[{\"name\":\"site\",\"port\":19729}]}"
    var services = parseManifest(manifest)
    var controlUrl = "http://127.0.0.1:" + intToString(controlPort)
    for (var wanted in services) {
        var body = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"" + wanted.name + "\",\"localAddress\":\"" + wanted.address + "\",\"localPort\":\"" + intToString(wanted.port) + "\",\"protocol\":\"http\",\"exposure\":\"" + wanted.exposure + "\"}"
        need(statusOf(httpPostJson(controlPort, "/v1/services", body, accountToken)) == 200, "falhou")
    }

    // Publicado mas sem ninguem escutando: check acusa, sem derrubar nada.
    var down = verifyDeployment(controlUrl, accountToken, services)
    need(down.size == 1, "falhou")
    need(down.get(0).indexOf("site") >= 0, "falhou")
    need(down.get(0).indexOf("sem resposta") >= 0, "falhou")

    // Sobe um servico HTTP de verdade na porta: check aprova. O listener
    // que apenas aceitava e fechava passava no connect TCP antigo; com a
    // sonda do Agent (GET com prazo) ele e corretamente DEGRADED.
    var listener = net.listen(19729)
    var slowServer = spawn {
        var serving = true
        while (serving) {
            try {
                var peer = listener.accept()
                var worker = spawn { serveOkOnce(peer) }
            } catch (String e) {
                serving = false
            }
        }
    }
    need(waitForPort(19729, 60), "falhou")
    var up = verifyDeployment(controlUrl, accountToken, services)
    need(up.size == 0, "falhou")
    need(checkLocalService("127.0.0.1", 19729), "falhou")
    need(checkLocalService("127.0.0.1", 19728) == false, "falhou")

    // Escopo por device: o manifesto descreve a maquina LOCAL. Publicado
    // noutro device nao e "publicado aqui" — antes o --check/doctor davam
    // verde para um deploy que nunca chegou nesta maquina (medido).
    var otherDev = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"outro\",\"publicKey\":\"pk2\"}", accountToken)
    var otherDevId = mapField(json.decode<Map<String, String>>(bodyOf(otherDev)), "deviceId")
    var elsewhere = "{\"deviceId\":\"" + otherDevId + "\",\"name\":\"noutro\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"19729\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    need(statusOf(httpPostJson(controlPort, "/v1/services", elsewhere, accountToken)) == 200, "falhou")
    var wantedElsewhere = parseManifest("{\"services\":[{\"name\":\"noutro\",\"port\":19729}]}")
    // Sem escopo (compatibilidade): o chamador antigo aprova.
    need(verifyDeployment(controlUrl, accountToken, wantedElsewhere).size == 0, "falhou")
    var scoped = verifyDeploymentFor(controlUrl, accountToken, wantedElsewhere, deviceId)
    need(scoped.size == 1, "falhou")
    need(scoped.get(0).indexOf("noutro") >= 0, "falhou")
    need(scoped.get(0).indexOf("dispositivo") >= 0, "falhou")
    need(scoped.get(0).indexOf("kof cloud deploy") >= 0, "falhou")
    listener.close()

    // Drift de config: remove e republica o mesmo nome com porta/exposicao
    // diferentes (o publish e idempotente por nome — re-publicar retorna o
    // existente sem atualizar; drift real vem de remove+publish). O check
    // acusa ANTES de testar resposta, com o diff e a dica de re-deploy.
    var listedDrift = httpGetToken(controlPort, "/v1/services", accountToken)
    var driftTarget = serviceIdByNameIn(listedDrift, "site")
    need(driftTarget.length > 0, "falhou")
    need(statusOf(httpPostJson(controlPort, "/v1/services/remove", "{\"serviceId\":\"" + driftTarget + "\"}", accountToken)) == 200, "falhou")
    var driftBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"19728\",\"protocol\":\"http\",\"exposure\":\"PRIVATE\"}"
    need(statusOf(httpPostJson(controlPort, "/v1/services", driftBody, accountToken)) == 200, "falhou")
    var drifted = verifyDeployment(controlUrl, accountToken, services)
    need(drifted.size == 1, "falhou")
    need(drifted.get(0).indexOf("config diferente") >= 0, "falhou")
    need(drifted.get(0).indexOf("deploy") >= 0, "falhou")

    // Artefato declarado mas ausente no disco: mesmo publicado e
    // respondendo, o check avisa staleness (e o doctor tambem, via o mesmo
    // verifyDeployment). Sem artifact no manifesto = sem aviso.
    // Re-publica sem drift para isolar o cenario do artefato (o republicado
    // tem id novo — re-lista em vez de reusar o driftTarget removido).
    var relisted = httpGetToken(controlPort, "/v1/services", accountToken)
    var driftedId = serviceIdByNameIn(relisted, "site")
    need(statusOf(httpPostJson(controlPort, "/v1/services/remove", "{\"serviceId\":\"" + driftedId + "\"}", accountToken)) == 200, "falhou")
    var cleanBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"19729\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    need(statusOf(httpPostJson(controlPort, "/v1/services", cleanBody, accountToken)) == 200, "falhou")
    // Reabre o listener: o verify checa resposta antes do artefato, e o
    // listener original fechou no fim do cenario anterior.
    var listener2 = net.listen(19729)
    var serving2 = spawn {
        var open = true
        while (open) {
            try {
                var peer = listener2.accept()
                var worker = spawn { serveOkOnce(peer) }
            } catch (String e) {
                open = false
            }
        }
    }
    need(waitForPort(19729, 60), "falhou")
    var staleManifest = "{\"services\":[{\"name\":\"site\",\"port\":19729,\"artifact\":\"/nao/existe/kofcloud-artifact-" + crypto.randomHex(4) + "\"}]}"
    var stale = verifyDeployment(controlUrl, accountToken, parseManifest(staleManifest))
    need(stale.size == 1, "falhou")
    need(stale.get(0).indexOf("artefato ausente") >= 0, "falhou")
    need(stale.get(0).indexOf("deploy") >= 0, "falhou")
    var noArtifact = verifyDeployment(controlUrl, accountToken, services)
    need(noArtifact.size == 0, "falhou")

    // Drift de politica WAF: remove e republica sem allowlist (o publish e
    // idempotente — re-publicar retorna o existente; drift real vem de
    // remove+publish). O check acusa allowMethods/allowPaths antes da
    // resposta, como porta/exposure/protocol. Politica igual = saudavel.
    var relistedPolicy = httpGetToken(controlPort, "/v1/services", accountToken)
    var policyId = serviceIdByNameIn(relistedPolicy, "site")
    need(statusOf(httpPostJson(controlPort, "/v1/services/remove", "{\"serviceId\":\"" + policyId + "\"}", accountToken)) == 200, "falhou")
    var bareBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"19729\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    need(statusOf(httpPostJson(controlPort, "/v1/services", bareBody, accountToken)) == 200, "falhou")
    var policyManifest = "{\"services\":[{\"name\":\"site\",\"port\":19729,\"allowMethods\":\"GET\",\"allowPaths\":\"/api/*\"}]}"
    var driftedPolicy = verifyDeployment(controlUrl, accountToken, parseManifest(policyManifest))
    need(driftedPolicy.size == 1, "falhou")
    need(driftedPolicy.get(0).indexOf("config diferente") >= 0, "falhou")
    need(driftedPolicy.get(0).indexOf("allowMethods") >= 0, "falhou")
    need(driftedPolicy.get(0).indexOf("deploy") >= 0, "falhou")
    var bareManifest = "{\"services\":[{\"name\":\"site\",\"port\":19729}]}"
    var bareOk = verifyDeployment(controlUrl, accountToken, parseManifest(bareManifest))
    need(bareOk.size == 0, "falhou")
    listener2.close()
}

Int serviceCount(String controlUrl, String token, Int port) {
    return 0
}

// Conta ocorrencias nao sobrepostas (para contar servicos no JSON listado).
Int countOccurrences(String haystack, String needle) {
    if (needle.length == 0) {
        return 0
    }
    var count = 0
    var from = 0
    while (from <= haystack.length - needle.length) {
        var found = haystack.indexOf(needle, from)
        if (found < 0) {
            break
        }
        count = count + 1
        from = found + needle.length
    }
    return count
}

// Extrai o id do servico com o nome dado do corpo de GET /v1/services.
// "" quando ausente. O serviceJson do control plane emite "id" ANTES de
// "name", entao a busca e para tras a partir do nome (sem risco de pegar o
// id do servico vizinho).
String serviceIdByNameIn(String servicesRaw, String name) {
    var body = bodyOf(servicesRaw)
    var needle = "\"name\":\"" + name + "\""
    var at = body.indexOf(needle)
    if (at < 0) {
        return ""
    }
    var idKey = "\"id\":\""
    var head = body.substring(0, at)
    var back = head.lastIndexOf(idKey)
    if (back < 0) {
        return ""
    }
    var start = back + idKey.length
    var end = head.indexOf("\"", start)
    if (end < 0) {
        return ""
    }
    return head.substring(start, end)
}

test "deploy: loadManifestFile distingue ausente, invalido e valido", "deploy-load" {
    // Pura na decisao (so IO: ler + parsear) — cobre o caminho que
    // cmdDeploy/cmdDown usam antes de qualquer rede/sessao.
    need(resolveManifestPath("") == "kofcloud.json", "falhou")
    need(resolveManifestPath("   ") == "kofcloud.json", "falhou")
    need(resolveManifestPath("  /tmp/x.json  ") == "/tmp/x.json", "falhou")
    need(resolveManifestPath("/tmp/x.json") == "/tmp/x.json", "falhou")
    var missing = loadManifestFile("/tmp/kofcloud-deploy-ausente-" + crypto.randomHex(8) + ".json")
    need(missing.ok == false, "falhou")
    need(missing.error.indexOf("nao encontrado") >= 0, "falhou")
    need(missing.services.size == 0, "falhou")
    var emptyPath = deployManifest("vazio-load", "")
    var empty = loadManifestFile(emptyPath)
    need(empty.ok == false, "falhou")
    need(empty.error.indexOf("nao encontrado") >= 0, "falhou")
    var badPath = deployManifest("bad-load", "{\"services\":[{\"name\":\"x\"}]}")
    var bad = loadManifestFile(badPath)
    need(bad.ok == false, "falhou")
    need(bad.error.indexOf("invalido") >= 0, "falhou")
    need(bad.error.indexOf(badPath) >= 0, "falhou")
    var goodPath = deployManifest("good-load", "{\"services\":[{\"name\":\"site\",\"port\":8080}]}")
    var good = loadManifestFile(goodPath)
    need(good.ok == true, "falhou")
    need(good.error == "", "falhou")
    need(good.services.size == 1, "falhou")
    need(good.services.get(0).name == "site", "falhou")
}

test "deploy: scan acusa segredo no manifesto e aprova o limpo", "deploy-scan" {
    // Pura, sem rede nem HOME (precedente: deploy-err): manifesto limpo =
    // zero achados; kfs_/kfc_/password em qualquer servico = achado com o
    // nome (sem vazar o valor); vazio = limpo.
    var clean = scanManifestSecrets("{\"services\":[{\"name\":\"site\",\"port\":8080}]}")
    need(clean.size == 0, "falhou")
    need(scanManifestSecrets("").size == 0, "falhou")
    need(scanManifestSecrets("   ").size == 0, "falhou")
    var leaked = scanManifestSecrets("{\"services\":[{\"name\":\"site\",\"port\":8080},{\"name\":\"api\",\"port\":3000,\"build\":\"deploy kfs_abc123\"}]}")
    need(leaked.size == 1, "falhou")
    need(leaked.get(0).indexOf("api") >= 0, "falhou")
    need(leaked.get(0).indexOf("kfs_abc123") < 0, "falhou")
    var account = scanManifestSecrets("{\"services\":[{\"name\":\"db\",\"port\":5432,\"password\":\"segredo\"}]}")
    need(account.size == 1, "falhou")
    var accountToken = scanManifestSecrets("{\"services\":[{\"name\":\"site\",\"port\":8080,\"artifact\":\"kfc_x\"}]}")
    need(accountToken.size == 1, "falhou")
}

test "deploy: check local usa GET com prazo (500 e servico mudo nao passam)", "deploy-check-http" {
    // Antes era so um connect TCP: medido, tanto um servico que responde
    // 500 quanto um que aceita e NUNCA responde passavam como "respondendo",
    // e o `deploy --check` declarava saudavel um deploy quebrado.
    var okPort = 20131
    var badPort = 20133
    var mutePort = 20135

    var okListener = net.listen(okPort)
    var okTask = spawn {
        var open = true
        while (open) {
            try {
                var c = okListener.accept()
                var w = spawn {
                    c.receive(4096)
                    c.send(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok"))
                    c.close()
                }
            } catch (String e) {
                open = false
            }
        }
    }
    var badListener = net.listen(badPort)
    var badTask = spawn {
        var open = true
        while (open) {
            try {
                var c = badListener.accept()
                var w = spawn {
                    c.receive(4096)
                    c.send(bytesFromString("HTTP/1.1 500 Internal Server Error\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"))
                    c.close()
                }
            } catch (String e) {
                open = false
            }
        }
    }
    var muteListener = net.listen(mutePort)
    var held = listOf<Conn>()
    var muteTask = spawn {
        var open = true
        while (open) {
            try {
                var c = muteListener.accept()
                held.add(c)
            } catch (String e) {
                open = false
            }
        }
    }
    need(waitForPort(okPort, 60), "falhou")
    need(waitForPort(badPort, 60), "falhou")
    need(waitForPort(mutePort, 60), "falhou")

    need(checkLocalService("127.0.0.1", okPort), "falhou")
    need(checkLocalService("127.0.0.1", badPort) == false, "falhou")
    var started = time.now()
    need(checkLocalService("127.0.0.1", mutePort) == false, "falhou")
    var elapsed = time.now() - started
    need(elapsed < 15000, "falhou")
    need(checkLocalService("127.0.0.1", 20137) == false, "falhou")

    // Protocolo nao-http continua no connect simples (nao ha sonda melhor).
    need(checkLocalServiceFor("127.0.0.1", okPort, "tcp"), "falhou")
    need(checkLocalServiceFor("127.0.0.1", 20137, "tcp") == false, "falhou")

    okListener.close()
    badListener.close()
    muteListener.close()
    for (var c in held) {
        c.close()
    }
}

// Responde 200 a uma requisicao e fecha (fixture de servico saudavel).
void serveOkOnce(Conn peer) {
    peer.receive(8192)
    peer.send(bytesFromString("HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok"))
    peer.close()
}

test "deploy: check acusa servico SUSPENSO com a dica do unsuspend", "deploy-check-suspended" {
    // Medido lendo o caminho: `verifyDeploymentFor` so olhava config + sonda
    // local. Um servico SUSPENSO respondia localmente (o processo esta de
    // pe) e o config casava, entao o --check/doctor davam verde — mas a
    // rota esta fora (404 opaco na borda) e republicar NAO dessuspende
    // (republicar preserva o status de proposito). A dica certa e o
    // unsuspend.
    var live = listOf<Service>()
    live.add(Service("id-site", "acc", "devA", "site", "127.0.0.1", 8080, "http", "site.mel.kofcloud.io", "PUBLIC", "SUSPENDED", 0, "", "", ""))

    // Puro (`suspendedByName`, o ponto da decisao): sem rede. Sem escopo.
    need(statusIsSuspended(suspendedByName(live, "site", "")), "falhou")
    // Com escopo no mesmo device: acusado.
    need(statusIsSuspended(suspendedByName(live, "site", "devA")), "falhou")
    // Homonimo NOUTRO device: nao conta (o caso dele e "publicado noutro
    // dispositivo", que ja tem problema proprio).
    need(suspendedByName(live, "site", "devB") == "", "falhou")
    // Sem match: vazio (o "nao publicado" e tratado antes).
    need(suspendedByName(live, "outro", "devA") == "", "falhou")

    // ONLINE/UNKNOWN/OFFLINE nao caem na dica do unsuspend.
    var online = listOf<Service>()
    online.add(Service("id-site", "acc", "devA", "site", "127.0.0.1", 8080, "http", "site.mel.kofcloud.io", "PUBLIC", "ONLINE", 0, "", "", ""))
    need(statusIsSuspended(suspendedByName(online, "site", "devA")) == false, "falhou")

    // Fim a fim: control plane de verdade, servico suspenso pela API. O
    // check acusa o SUSPENSO (e nao "sem resposta") mesmo com o processo
    // local respondendo.
    var controlPort = 19821
    var registry = Registry("/tmp/kofcloud-depsusp-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")
    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var dev = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", token)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(dev)), "deviceId")
    var listener = net.listen(19822)
    var loop = spawn {
        var serving = true
        while (serving) {
            try {
                var peer = listener.accept()
                var worker = spawn { serveOkOnce(peer) }
            } catch (String e) {
                serving = false
            }
        }
    }
    need(waitForPort(19822, 60), "falhou")
    var pub = httpPostJson(controlPort, "/v1/services", "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"19822\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}", token)
    need(statusOf(pub) == 200, "falhou")
    var serviceId = mapField(json.decode<Map<String, String>>(bodyOf(pub)), "id")
    var susp = httpPostJson(controlPort, "/v1/services/suspend", "{\"serviceId\":\"" + serviceId + "\"}", token)
    need(statusOf(susp) == 200, "falhou")

    var wanted = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":19822}]}")
    var controlUrl = "http://127.0.0.1:" + intToString(controlPort)
    var problems = verifyDeploymentFor(controlUrl, token, wanted, deviceId)
    need(problems.size == 1, "falhou")
    need(problems.get(0).indexOf("SUSPENSO") >= 0, "falhou")
    need(problems.get(0).indexOf("unsuspend") >= 0, "falhou")
    need(problems.get(0).indexOf("kof cloud deploy") < 0, "falhou")
    need(checkLocalService("127.0.0.1", 19822), "falhou")

    // Unsuspend volta ao verde.
    need(statusOf(httpPostJson(controlPort, "/v1/services/unsuspend", "{\"serviceId\":\"" + serviceId + "\"}", token)) == 200, "falhou")
    need(verifyDeploymentFor(controlUrl, token, wanted, deviceId).size == 0, "falhou")
    listener.close()
}
test "deploy: check avisa kfs_ perto do fim (mesmo predicado do token-list)", "deploy-kfswarn" {
    var window = limitTokenExpiryWarnMs()
    var now = 1000000000000L
    var agora = longToString(now)
    var calm = listOf<ServiceTokenEntry>()
    calm.add(ServiceTokenEntry("svc", "a1b2c3d4", "1700000000000", longToString(now + window + 86400000L)))
    need(kfsExpiryCheckLine("api", calm, agora) == "", "falhou")
    var expired = listOf<ServiceTokenEntry>()
    expired.add(ServiceTokenEntry("svc", "a1b2c3d4", "1700000000000", longToString(now - 1)))
    need(kfsExpiryCheckLine("api", expired, agora) == "", "falhou")
    var hot = listOf<ServiceTokenEntry>()
    hot.add(ServiceTokenEntry("svc", "a1b2c3d4", "1700000000000", null))
    hot.add(ServiceTokenEntry("svc", "e5f6a7b8", "1700000000000", longToString(now + window - 1000L)))
    var line = kfsExpiryCheckLine("api", hot, agora)
    need(line.indexOf("api:") >= 0, "falhou")
    need(line.indexOf("1 credencial(is)") >= 0, "falhou")
    need(line.indexOf("service rotate api") >= 0, "falhou")
    need(line.indexOf("a1b2c3d4") < 0, "falhou")

    var raw = File("src/kofcloud/cli/Deploy.kf").readText()
    var text = ""
    if (raw != null) {
        text = raw
    }
    if (text.length == 0) {
        return
    }
    var startCheck = text.indexOf("Int cmdDeploy(")
    need(startCheck >= 0, "falhou")
    var endCheck = text.indexOf("Int cmdDown(", startCheck)
    need(endCheck > startCheck, "falhou")
    var bodyCheck = text.substring(startCheck, endCheck)
    // Ancora de indentacao (nao so presenca): o laco do check corre
    // INCONDICIONALMENTE no nivel do corpo (4 espacos). Um dead-code wrap
    // (`if (falso) { laco }`) re-indenta e a trava fica vermelha — lacuna
    // real: esse wrap passou sem ficar vermelho no commit 2af856a.
    var loopCall = "for (var warn in kfsExpiryWarningsFor(session.controlUrl, session.token, services, identity.deviceId, now)) {"
    need(bodyCheck.indexOf("\n    " + loopCall) >= 0, "falhou")
    need(bodyCheck.indexOf("check: aviso: ") >= 0, "falhou")
    need(bodyCheck.indexOf("check: aviso: ") < bodyCheck.indexOf("check ok: "), "falhou")
    // O --plan descreve o que o deploy faria; o aviso do que o deploy NAO
    // conserta (credencial vencendo) tem de aparecer la tambem, com o
    // MESMO busca (a 2a chamada no corpo — a 1a e do --check), no nivel
    // do bloco --plan (12 espacos; wrap re-indenta e quebra).
    need(bodyCheck.indexOf("kfsExpiryWarningsFor(session.controlUrl, session.token, services, identity.deviceId, now)", bodyCheck.indexOf("kfsExpiryWarningsFor(session.controlUrl, session.token, services, identity.deviceId, now)") + 1) >= 0, "falhou")
    need(bodyCheck.indexOf("\n            " + loopCall) >= 0, "falhou")
    need(bodyCheck.indexOf("plan: aviso: ") >= 0, "falhou")
    need(bodyCheck.indexOf("plan: aviso: ") < bodyCheck.indexOf("var plan = diffDeploymentFor"), "falhou")

    var controlPort = 19881
    var path = "/tmp/kofcloud-depkfswarn-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")
    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", token)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var pub = httpPostJson(controlPort, "/v1/services", "{\"deviceId\":\"" + deviceId + "\",\"name\":\"api\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"19882\",\"protocol\":\"http\",\"exposure\":\"AUTHENTICATED\"}", token)
    need(statusOf(pub) == 200, "falhou")
    var serviceId = mapField(json.decode<Map<String, String>>(bodyOf(pub)), "id")
    var wanted = parseManifest("{\"services\":[{\"name\":\"api\",\"port\":19882,\"exposure\":\"AUTHENTICATED\"}]}")
    var controlUrl = "http://127.0.0.1:" + intToString(controlPort)
    var fioNow = longToString(time.now())
    need(kfsExpiryWarningsFor(controlUrl, token, wanted, deviceId, fioNow).size == 0, "falhou")

    var issue = httpPostJson(controlPort, "/v1/services/token", "{\"serviceId\":\"" + serviceId + "\",\"ttlHours\":\"1\"}", token)
    need(statusOf(issue) == 200, "falhou")
    var warnings = kfsExpiryWarningsFor(controlUrl, token, wanted, deviceId, fioNow)
    need(warnings.size == 1, "falhou")
    need(warnings.get(0).indexOf("api:") >= 0, "falhou")
    need(warnings.get(0).indexOf("service rotate api") >= 0, "falhou")

    var pub2 = httpPostJson(controlPort, "/v1/services", "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"19883\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}", token)
    need(statusOf(pub2) == 200, "falhou")
    var wantedPublic = parseManifest("{\"services\":[{\"name\":\"site\",\"port\":19883}]}")
    need(kfsExpiryWarningsFor(controlUrl, token, wantedPublic, deviceId, fioNow).size == 0, "falhou")
}

// Fonte unica das travas de exemplo (deploy-ci/deploy-action): extrai o
// primeiro token apos cada "kof cloud " e confere que o help tem a linha
// "  <token> ". Comparacao por codigo de char (precedente do
// parseEdgeHosts): char e Int. Terminadores: espaco/quebra/aspas/backtick
// (citacao em prosa). Devolve quantas citacoes conferiu.
Int assertCitedCommands(String text, String help, String label) {
    var cursor = text.indexOf("kof cloud ")
    var cited = 0
    while (cursor >= 0) {
        var start = cursor + 10
        var end = start
        var scanning = true
        while (scanning && end < text.length) {
            var c = text.charAt(end) as Int
            if (c == 32 || c == 10 || c == 34 || c == 96) {
                scanning = false
            } else {
                end = end + 1
            }
        }
        var cmd = text.substring(start, end)
        need(cmd.length > 0, "falhou")
        need(help.indexOf("  " + cmd + " ") >= 0 || help.indexOf("  " + cmd + "\n") >= 0, "falhou")
        cited = cited + 1
        cursor = text.indexOf("kof cloud ", end)
    }
    return cited
}

test "deploy: exemplo de pipeline CI cita so comandos reais", "deploy-ci" {
    // F18 slice 3 — "pipeline de exemplo no repo". O exemplo e documentacao
    // que EXECUTA: qualquer `kof cloud <cmd>` citado tem de existir no help
    // (a interface que o binario mostra), o fluxo tem de ser o honesto
    // (runner self-hosted na maquina do `connect`, device fixo `ci` que o
    // re-registro dedupa — rodar o pipeline nao gera devices novos) e a
    // senha nunca pode aparecer literal (so via segredo mascarado pelo
    // Actions e env do passo). Mesmo padrao da trava cruzada usage-parity:
    // o teste le o arquivo do disco.
    var example = readTextOr("docs/examples/ci-pipeline.yml", "")
    need(example.length > 0, "falhou")
    need(example.indexOf("self-hosted") >= 0, "falhou")
    need(example.indexOf("connect") >= 0, "falhou")

    // Toda invocacao citada existe no help (fonte unica acima).
    var help = usageText()
    var cited = assertCitedCommands(example, help, "pipeline")
    need(cited >= 3, "falhou")

    // O fluxo citado e o do slice: login com device fixo, diff sem aplicar,
    // deploy com verificacao — as 3 fases do CI/GitOps do plano.
    need(example.indexOf("kof cloud login") >= 0, "falhou")
    need(example.indexOf("--device ci") >= 0, "falhou")
    need(example.indexOf("kof cloud deploy --plan") >= 0, "falhou")
    need(example.indexOf("kof cloud deploy --check") >= 0, "falhou")

    // Credencial nunca literal: a senha vem de segredo mascarado e chega ao
    // comando por env do passo ($KOF_PASSWORD), nunca inline no run.
    need(example.indexOf("secrets.KOF_PASSWORD") >= 0, "falhou")
    assert(example.indexOf("KOF_PASSWORD\")") >= 0 || example.indexOf("KOF_PASSWORD\"") >= 0, "senha via env do passo")
    assert(example.indexOf("password: \"") < 0 && example.indexOf("password:adef") < 0, "sem senha literal no exemplo")
}

test "deploy: exemplo de action reutilizavel cita so comandos reais", "deploy-action" {
    // Fecha o "Action oficial reutilizavel pendente" do slice 3: o exemplo
    // da action composite segue a MESMA regra da documentacao que executa —
    // todo `kof cloud <cmd>` citado existe no help, o pre-requisito
    // self-hosted esta no topo e a senha nunca aparece literal (input do
    // composite alimentado de secrets.*, chegando por env do passo).
    var action = readTextOr("docs/examples/action.yml", "")
    need(action.length > 0, "falhou")
    need(action.indexOf("self-hosted") >= 0, "falhou")
    need(action.indexOf("connect") >= 0, "falhou")
    need(action.indexOf("using: 'composite'") >= 0, "falhou")

    var help = usageText()
    var cited = assertCitedCommands(action, help, "action")
    need(cited >= 3, "falhou")

    need(action.indexOf("kof cloud login") >= 0, "falhou")
    need(action.indexOf("kof cloud deploy --plan") >= 0, "falhou")
    need(action.indexOf("kof cloud deploy --check") >= 0, "falhou")
    need(action.indexOf("default: 'ci'") >= 0, "falhou")

    // Credencial nunca literal: input obrigatorio com dica de segredo e
    // consumo por env do passo, nunca inline no run.
    need(action.indexOf("inputs.password") >= 0, "falhou")
    need(action.indexOf("KOF_PASSWORD: ${{ inputs.password }}") >= 0, "falhou")
    need(action.indexOf("secrets.") >= 0, "falhou")
    assert(action.indexOf("password: \"") < 0 && action.indexOf("password:adef") < 0, "sem senha literal na action")
}
