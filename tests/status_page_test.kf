import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.control.StatusPage
import kofcloud.model.Incident
import kofcloud.store.Store
import testkit.Support

// Fase 17 slice 3 (parcial) — status page publica.
// Le so incidentes GLOBAIS (plataforma). Sem login, sem token, sem dado de
// conta. Sem a flag `--status-page` as rotas nem existem.

String statusPath(String name) {
    return "/tmp/kofcloud-status-" + name + "-" + crypto.randomHex(4) + ".json"
}

test "status: estado geral agrega severidade dos abertos", "status-unit" {
    need(overallStatus(listOf<Incident>()) == "operational", "falhou")
    var warn = Incident("1", "x", "WARN", "", "s", 0, 0)
    var crit = Incident("2", "y", "CRIT", "", "s", 0, 0)
    need(overallStatus(listOf(warn)) == "partial_outage", "falhou")
    need(overallStatus(listOf(warn, crit)) == "major_outage", "falhou")
    var resolvedCrit = Incident("3", "z", "CRIT", "", "s", 0, 1)
    need(overallStatus(listOf(resolvedCrit)) == "operational", "falhou")
    need(overallStatusLabel("major_outage").indexOf("Interrupcao") >= 0, "falhou")
}

test "status: estado corrupto aparece como degradacao (nunca verde)", "status-unit" {
    // Medido: com o arquivo de estado ilegivel o `serve` sobe VAZIO (avisa
    // so no stdout) e a status page continua "Operacional" — o mundo via
    // verde sobre perda de dados. Agora corrupt = partial_outage, com aviso
    // explicito no HTML e no JSON.
    var empty = listOf<Incident>()
    need(overallStatusWith(empty, false) == "operational", "falhou")
    need(overallStatusWith(empty, true) == "partial_outage", "falhou")
    // CRIT vence corrupt (interrupcao maior e mais grave).
    var crit = Incident("1", "x", "CRIT", "", "s", 0, 0)
    need(overallStatusWith(listOf(crit), true) == "major_outage", "falhou")
    // WARN + corrupt continua partial (nao sobe nem desce por causa do corrupt).
    var warn = Incident("2", "y", "WARN", "", "s", 0, 0)
    need(overallStatusWith(listOf(warn), true) == "partial_outage", "falhou")
    // A linha do aviso: "" quando ok, texto fixo sem dado de conta quando corrupt.
    need(stateWarningLine(false) == "", "falhou")
    need(stateWarningLine(true).indexOf("VAZIO") >= 0, "falhou")
    // Na pagina: status != operational e aviso presente.
    var html = statusPageHtml(empty, true)
    need(html.indexOf("Degradacao parcial") >= 0, "falhou")
    need(html.indexOf("VAZIO") >= 0, "falhou")
    var json = statusPageJson(empty, true)
    need(json.indexOf("\"status\":\"partial_outage\"") >= 0, "falhou")
    need(json.indexOf("\"dataCorrupt\":\"true\"") >= 0, "falhou")
    need(json.indexOf("\"warning\"") >= 0, "falhou")
    // Estado saudavel segue verde e sem aviso.
    var okHtml = statusPageHtml(empty, false)
    need(okHtml.indexOf("Operacional") >= 0, "falhou")
    need(okHtml.indexOf("VAZIO") < 0, "falhou")
    var okJson = statusPageJson(empty, false)
    need(okJson.indexOf("\"dataCorrupt\":\"false\"") >= 0, "falhou")
    need(okJson.indexOf("\"warning\"") < 0, "falhou")
}

test "status: so os globais passam, nunca dado de conta", "status-unit" {
    var accountIncident = Incident("1", "x", "CRIT", "conta-1", "s", 0, 0)
    var global = Incident("2", "y", "WARN", "", "s", 0, 0)
    var filtered = globalOnly(listOf(accountIncident, global))
    need(filtered.size == 1, "falhou")
    need(filtered.get(0).accountId.length == 0, "falhou")
    // O JSON e o HTML construidos a partir da lista COMPLETA tambem filtram.
    need(statusPageJson(listOf(accountIncident, global), false).indexOf("conta-1") < 0, "falhou")
    need(statusPageHtml(listOf(accountIncident, global), false).indexOf("conta-1") < 0, "falhou")
}

test "status: timestamp ISO-8601 UTC", "status-unit" {
    need(isoTimestamp(0) == "1970-01-01T00:00:00Z", "falhou")
    need(isoTimestamp(86400000) == "1970-01-02T00:00:00Z", "falhou")
    // 2024-02-29T12:34:56Z
    need(isoTimestamp(1709210096000) == "2024-02-29T12:34:56Z", "falhou")
}

test "status: HTML escapa e JSON e valido", "status-unit" {
    var evil = Incident("1", "x", "WARN", "", "<script>alert(1)</script>", 0, 0)
    var html = statusPageHtml(listOf(evil), false)
    need(html.indexOf("<script>alert(1)</script>") < 0, "falhou")
    need(html.indexOf("&lt;script&gt;") >= 0, "falhou")
    var body = statusPageJson(listOf(evil), false)
    need(body.startsWith("{\"status\":\"partial_outage\""), "falhou")
    need(body.indexOf("<script>") < 0, "falhou")
    // O JSON decodifica (nao e texto solto).
    var parsed = json.decode<Map<String, String>>(body)
    need(parsed.size >= 1, "falhou")
}

test "status: rota publica serve HTML/JSON sem token; sem flag e 404", "status" {
    var controlPort = 19881
    var registry = Registry(statusPath("http"))
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    control.enableStatusPage()
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")

    // Injeta um incidente GLOBAL e um de conta.
    registry.raiseIncident("edge_refusals", "")
    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var mel = registry.accountByHandle("mel")
    if (mel != null) {
        registry.raiseIncident("bulk_device_revokes", mel.id)
    }

    var html = httpGetRaw(controlPort, "/status", "127.0.0.1")
    need(statusOf(html) == 200, "falhou")
    need(bodyOf(html).indexOf("edge_refusals") < 0, "falhou")
    need(bodyOf(html).indexOf("the edge refused many tunnels") >= 0, "falhou")
    need(bodyOf(html).indexOf("many devices revoked") < 0, "falhou")

    var jsonBody = httpGetRaw(controlPort, "/status.json", "127.0.0.1")
    need(statusOf(jsonBody) == 200, "falhou")
    need(bodyOf(jsonBody).indexOf("partial_outage") >= 0, "falhou")
    need(bodyOf(jsonBody).indexOf("many devices revoked") < 0, "falhou")

    // Sem a flag, as rotas nao existem.
    var otherPort = 19882
    var off = ControlPlane(Registry(statusPath("off")), otherPort, "127.0.0.1", 0)
    var offServer = spawn { off.start() }
    need(waitForPort(otherPort, 60), "falhou")
    need(statusOf(httpGetRaw(otherPort, "/status", "127.0.0.1")) == 404, "falhou")
    need(statusOf(httpGetRaw(otherPort, "/status.json", "127.0.0.1")) == 404, "falhou")
}