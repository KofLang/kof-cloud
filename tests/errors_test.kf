import kofcloud.agent.Agent
import kofcloud.cli.Commands
import kofcloud.cli.Local
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.edge.EdgeState
import kofcloud.edge.HttpFront
import kofcloud.edge.Tunnel
import kofcloud.model.Errors
import kofcloud.store.Store
import testkit.Support
import kofcloud.util.Limits

// R6 — erros estaveis: todo erro da plataforma viaja como "KCFnnn: ...".
// Codigos nunca sao removidos nem renumerados; a CLI traduz para Hint.
// Aqui: control plane (HTTP real) e Edge (HTTP real pelo tunel).

String errorCodeOf(String response) {
    return mapField(json.decode<Map<String, String>>(bodyOf(response)), "error")
}

Bool codeIs(String body, String code) {
    return body.indexOf(code) >= 0
}

test "erros: control plane devolve codigos estaveis", "errors" {
    var path = "/tmp/kofcloud-err-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    var control = ControlPlane(registry, 19500, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(19500, 60), "falhou")

    var badHandle = httpPostJson(19500, "/v1/accounts", "{\"handle\":\"MEL\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    need(statusOf(badHandle) == 400, "falhou")
    need(codeIs(errorCodeOf(badHandle), "KCF001"), "falhou")

    // Senha curta: o handler barra antes de criar (400 KCF005). Sem esta
    // trava, o ramo `password.length < 4` poderia sumir ou mudar de codigo
    // sem quebrar nada — o construtor e a Hint ja estao travados, mas o fio
    // (status+corpo via HTTP) nao estava.
    var shortPass = httpPostJson(19500, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"abc\"}", "")
    need(statusOf(shortPass) == 400, "falhou")
    need(codeIs(errorCodeOf(shortPass), "KCF005"), "falhou")

    var created = httpPostJson(19500, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"mel@example.com\",\"password\":\"segredo\"}", "")
    need(statusOf(created) == 200, "falhou")
    var accountToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var duplicate = httpPostJson(19500, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"outro@e.com\",\"password\":\"segredo\"}", "")
    need(statusOf(duplicate) == 409, "falhou")
    need(codeIs(errorCodeOf(duplicate), "KCF002"), "falhou")

    var wrongPass = httpPostJson(19500, "/v1/login", "{\"handle\":\"mel\",\"password\":\"errada\"}", "")
    need(statusOf(wrongPass) == 401, "falhou")
    need(codeIs(errorCodeOf(wrongPass), "KCF003"), "falhou")
    var unknownUser = httpPostJson(19500, "/v1/login", "{\"handle\":\"ninguem\",\"password\":\"x\"}", "")
    need(statusOf(unknownUser) == 401, "falhou")
    need(codeIs(errorCodeOf(unknownUser), "KCF003"), "falhou")

    var noToken = httpGetRaw(19500, "/v1/devices", "127.0.0.1")
    need(statusOf(noToken) == 401, "falhou")
    need(codeIs(bodyOf(noToken), "KCF004"), "falhou")

    var badDevice = httpPostJson(19500, "/v1/devices", "{\"name\":\"\",\"publicKey\":\"\"}", accountToken)
    need(statusOf(badDevice) == 400, "falhou")
    need(codeIs(errorCodeOf(badDevice), "KCF020"), "falhou")

    var device = httpPostJson(19500, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pubkey\"}", accountToken)
    need(statusOf(device) == 200, "falhou")
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(device)), "deviceId")

    var badPort = httpPostJson(19500, "/v1/services", "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"0\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}", accountToken)
    need(statusOf(badPort) == 400, "falhou")
    need(codeIs(errorCodeOf(badPort), "KCF043"), "falhou")

    // Teto: porta acima de 65535 tambem e 400 (antes passava e quebrava so
    // no net.connect do relay).
    var bigPort = httpPostJson(19500, "/v1/services", "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"99999\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}", accountToken)
    need(statusOf(bigPort) == 400, "falhou")
    need(codeIs(errorCodeOf(bigPort), "KCF043"), "falhou")

    // Porta que estoura Int fazia WRAP na API: 4294968080 virava 784 e era
    // publicada em silencio; 4294967296 virava 0. Agora e 400 como qualquer
    // porta fora da faixa.
    var wrappedPort = httpPostJson(19500, "/v1/services", "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"4294968080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}", accountToken)
    need(statusOf(wrappedPort) == 400, "falhou")
    need(codeIs(errorCodeOf(wrappedPort), "KCF043"), "falhou")
    var zeroWrapPort = httpPostJson(19500, "/v1/services", "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"4294967296\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}", accountToken)
    need(statusOf(zeroWrapPort) == 400, "falhou")
    need(codeIs(errorCodeOf(zeroWrapPort), "KCF043"), "falhou")

    var badName = httpPostJson(19500, "/v1/services", "{\"deviceId\":\"" + deviceId + "\",\"name\":\"SITE!\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}", accountToken)
    need(statusOf(badName) == 400, "falhou")
    need(codeIs(errorCodeOf(badName), "KCF040"), "falhou")

    // Exposure desconhecida nao cai para PUBLIC em silencio: um typo
    // ("PUBLIK") num servico que devia ser PRIVATE o exporia.
    var badExposure = httpPostJson(19500, "/v1/services", "{\"deviceId\":\"" + deviceId + "\",\"name\":\"db\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"5432\",\"protocol\":\"http\",\"exposure\":\"PUBLIK\"}", accountToken)
    need(statusOf(badExposure) == 400, "falhou")
    need(codeIs(errorCodeOf(badExposure), "KCF045"), "falhou")

    // Protocol fora do MVP nao e aceito em silencio: o tunel so fala HTTP.
    var badProtocol = httpPostJson(19500, "/v1/services", "{\"deviceId\":\"" + deviceId + "\",\"name\":\"db\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"5432\",\"protocol\":\"tcp\",\"exposure\":\"PRIVATE\"}", accountToken)
    need(statusOf(badProtocol) == 400, "falhou")
    need(codeIs(errorCodeOf(badProtocol), "KCF046"), "falhou")

    // Address fora de loopback nao e aceito: o Agent conectaria nesse
    // endereco — externo o transformaria em escaneador (SSRF).
    var badAddress = httpPostJson(19500, "/v1/services", "{\"deviceId\":\"" + deviceId + "\",\"name\":\"db\",\"localAddress\":\"169.254.169.254\",\"localPort\":\"80\",\"protocol\":\"http\",\"exposure\":\"PRIVATE\"}", accountToken)
    need(statusOf(badAddress) == 400, "falhou")
    need(codeIs(errorCodeOf(badAddress), "KCF047"), "falhou")
}

test "erros: conta nao dona recebe 404 opaco (nao revela recurso alheio)", "errors-xacct" {
    var path = "/tmp/kofcloud-errx-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    var control = ControlPlane(registry, 19510, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(19510, 60), "falhou")

    var melCreated = httpPostJson(19510, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"mel@example.com\",\"password\":\"segredo\"}", "")
    var mel = json.decode<Map<String, String>>(bodyOf(melCreated))
    var anaCreated = httpPostJson(19510, "/v1/accounts", "{\"handle\":\"ana\",\"email\":\"ana@example.com\",\"password\":\"segredo\"}", "")
    var ana = json.decode<Map<String, String>>(bodyOf(anaCreated))

    var melDevice = httpPostJson(19510, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", mapField(mel, "token"))
    var melDeviceId = mapField(json.decode<Map<String, String>>(bodyOf(melDevice)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + melDeviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    var published = httpPostJson(19510, "/v1/services", pubBody, mapField(mel, "token"))
    need(statusOf(published) == 200, "falhou")
    var serviceId = mapField(json.decode<Map<String, String>>(bodyOf(published)), "id")

    // ana tenta operar sobre o device/servico de mel: mesmo 404 de inexistente
    var anaDevice = httpPostJson(19510, "/v1/services", pubBody, mapField(ana, "token"))
    need(statusOf(anaDevice) == 404, "falhou")
    need(codeIs(errorCodeOf(anaDevice), "KCF021"), "falhou")

    var anaTokenBody = "{\"serviceId\":\"" + serviceId + "\"}"
    var anaToken = httpPostJson(19510, "/v1/services/token", anaTokenBody, mapField(ana, "token"))
    need(statusOf(anaToken) == 404, "falhou")
    need(codeIs(errorCodeOf(anaToken), "KCF041"), "falhou")

    // owner-gate do status: ana nao altera o status do servico de mel
    var anaStatus = httpPostJson(19510, "/v1/services/status", "{\"serviceId\":\"" + serviceId + "\",\"status\":\"OFFLINE\"}", mapField(ana, "token"))
    need(statusOf(anaStatus) == 404, "falhou")
    need(codeIs(errorCodeOf(anaStatus), "KCF041"), "falhou")
    var svcBefore = registry.serviceById(serviceId)
    need(svcBefore != null && svcBefore.status == "UNKNOWN", "falhou")

    // e o dono consegue
    var melStatus = httpPostJson(19510, "/v1/services/status", "{\"serviceId\":\"" + serviceId + "\",\"status\":\"ONLINE\"}", mapField(mel, "token"))
    need(statusOf(melStatus) == 200, "falhou")
    var svcAfter = registry.serviceById(serviceId)
    need(svcAfter != null && svcAfter.status == "ONLINE", "falhou")
}

test "erros: device resolve por nome ou id (publish --device)", "errors-device" {
    var path = "/tmp/kofcloud-errd-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    var control = ControlPlane(registry, 19546, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(19546, 60), "falhou")

    var created = httpPostJson(19546, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var accountToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var controlUrl = "http://127.0.0.1:19546"
    var session = LocalSession("", "", accountToken, controlUrl)

    var nb = httpPostJson(19546, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pk1\"}", accountToken)
    var nbId = mapField(json.decode<Map<String, String>>(bodyOf(nb)), "deviceId")
    var srv = httpPostJson(19546, "/v1/devices", "{\"name\":\"server\",\"publicKey\":\"pk2\"}", accountToken)
    var srvId = mapField(json.decode<Map<String, String>>(bodyOf(srv)), "deviceId")

    // Nome resolve para o id (e o outro nome resolve para o outro id).
    need(deviceIdByNameOrId(session, "notebook") == nbId, "falhou")
    need(deviceIdByNameOrId(session, "server") == srvId, "falhou")
    // Id passa direto (compat: quem ja usa id nao quebra).
    need(deviceIdByNameOrId(session, nbId) == nbId, "falhou")
    // Nome inexistente: "" (o chamador responde erro local honesto).
    need(deviceIdByNameOrId(session, "fantasma") == "", "falhou")
    // Trim como o parseManifest: padding resolve igual (CLI e manifesto
    // aceitam os mesmos nomes; espacos sobrando nao quebram a resolucao).
    need(deviceIdByNameOrId(session, "  notebook  ") == nbId, "falhou")
    need(deviceIdByNameOrId(session, "  " + nbId + "  ") == nbId, "falhou")
    // So-espacos nao resolve nada (""): os guardas do device revoke/suspend/
    // unsuspend pedem `uso` antes de qualquer fetch, igual aos comandos de
    // servico (unpublish/status/token/token-revoke ja faziam com trim).
    need(deviceIdByNameOrId(session, "   ") == "", "falhou")

    // E o id resolvido opera de verdade: suspende por nome via API (o que
    // os comandos fazem depois de resolver).
    var suspendBody = "{\"deviceId\":\"" + deviceIdByNameOrId(session, "notebook") + "\"}"
    need(statusOf(httpPostJson(19546, "/v1/devices/suspend", suspendBody, accountToken)) == 200, "falhou")
    var suspended = registry.deviceById(nbId)
    need(suspended != null, "falhou")
    if (suspended != null) {
        need(suspended.status == "SUSPENDED", "falhou")
    }
    var unsuspendBody = "{\"deviceId\":\"" + deviceIdByNameOrId(session, "notebook") + "\"}"
    need(statusOf(httpPostJson(19546, "/v1/devices/unsuspend", unsuspendBody, accountToken)) == 200, "falhou")
}

test "erros: limites e owner-gate no registry viajam como KCF080/KCF081/KCF022/KCF060", "errors-reg" {
    var registry = Registry("/tmp/kofcloud-errr-" + crypto.randomHex(4) + ".json")
    registry.setLimits(1, 1)
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var ana = registry.createAccount("ana", "a@e.com", "segredo")
    var d1 = registry.registerDevice(mel, "d1", "pk1")
    var blocked = ""
    try {
        registry.registerDevice(mel, "d2", "pk2")
    } catch (String e) {
        blocked = e
    }
    need(codeIs(blocked, "KCF080"), "falhou")

    registry.publishService(mel, d1.id, "site", "127.0.0.1", 8080, "http", "PUBLIC", "", "")
    var blockedSvc = ""
    try {
        registry.publishService(mel, d1.id, "api", "127.0.0.1", 3000, "http", "PUBLIC", "", "")
    } catch (String e) {
        blockedSvc = e
    }
    need(codeIs(blockedSvc, "KCF081"), "falhou")

    var anaDevice = registry.registerDevice(ana, "nb", "pk")
    var notYours = ""
    try {
        registry.publishService(ana, d1.id, "x", "127.0.0.1", 9000, "http", "PUBLIC", "", "")
    } catch (String e) {
        notYours = e
    }
    need(codeIs(notYours, "KCF022"), "falhou")

    var site = registry.serviceByName(mel.id, "site")
    need(site != null, "falhou")
    var tokenDenied = ""
    if (site != null) {
        try {
            registry.issueServiceToken(ana.id, site.id)
        } catch (String e) {
            tokenDenied = e
        }
    }
    need(codeIs(tokenDenied, "KCF060"), "falhou")

    // Contrato interno-vs-borda do owner-gate do status: o registry devolve
    // o motivo real (KCF041 inexistente, KCF042 alheio); a borda reescreve
    // ambos para KCF041 opaco (travado via HTTP no errors-xacct). Se o
    // registry passar a devolver outra coisa, este teste quebra — e se a
    // borda passar a repassar o KCF042, o errors-xacct quebra.
    if (site != null) {
        need(codeIs(registry.reportServiceStatus(mel.id, "fantasma", "ONLINE"), "KCF041"), "falhou")
        need(codeIs(registry.reportServiceStatus(ana.id, site.id, "OFFLINE"), "KCF042"), "falhou")
    }
}

test "erros: publishHttpStatus mapeia familia -> HTTP (trava pura)", "errors-publish-status" {
    // Fonte unica do mapeamento que o publishError usa na borda: limite
    // 429, validacao 400, resto (dono/recurso) 404 opaco. Mudar um ramo
    // sem atualizar a trava quebra aqui de proposito.
    need(publishHttpStatus(errLimitDevices()) == 429, "falhou")
    need(publishHttpStatus(errLimitServices()) == 429, "falhou")
    need(publishHttpStatus(errInvalidServiceName()) == 400, "falhou")
    need(publishHttpStatus(errLocalPort()) == 400, "falhou")
    need(publishHttpStatus(errDeviceNotYours()) == 404, "falhou")
    need(publishHttpStatus(errDeviceRevoked()) == 409, "falhou")
    need(publishHttpStatus(errDeviceNotFound()) == 404, "falhou")
    need(publishHttpStatus("KCF999: algo estranho") == 404, "falhou")
    // O freeze tem mapeamento proprio (freezeHttpStatus): KCF023 -> 409
    // (revogado terminal, acionavel), resto -> 404 opaco. Mesma recusa do
    // publish, outra borda: mudar um ramo sem atualizar aqui quebra.
    need(freezeHttpStatus(errDeviceRevoked()) == 409, "falhou")
    need(freezeHttpStatus(errTargetNotFound()) == 404, "falhou")
    need(freezeHttpStatus("KCF999: algo estranho") == 404, "falhou")
}

test "erros: Edge devolve codigos estaveis (rota, auth, offline, conteudo)", "errors-edge" {
    var localSvc = 19520
    var controlPort = 19521
    var tunnelPort = 19522
    var httpPort = 19523

    var app = web.app()
    app.get("/") { return "svc-up" }
    var server = spawn { app.listen(localSvc) }
    need(waitForPort(localSvc, 60), "falhou")

    var registry = Registry("/tmp/kofcloud-erre-" + crypto.randomHex(4) + ".json")
    var edgeState = EdgeState(registry)
    var edgeStop = "/tmp/kofcloud-erre-stop-" + crypto.randomHex(4) + ".txt"
    var agentStop = "/tmp/kofcloud-erre-agent-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    File(agentStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, "", edgeStop) }
    var httpTask = spawn { serveHttp(edgeState, httpPort, limitMaxBodyBytes(), edgeStop) }
    need(waitForPort(controlPort, 60), "falhou")
    need(waitForPort(tunnelPort, 60), "falhou")
    need(waitForPort(httpPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"mel@example.com\",\"password\":\"segredo\"}", "")
    var account = json.decode<Map<String, String>>(bodyOf(created))
    var accountToken = mapField(account, "token")
    var accountId = mapField(account, "accountId")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pubkey\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")

    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"pub\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"" + intToString(localSvc) + "\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    need(statusOf(httpPostJson(controlPort, "/v1/services", pubBody, accountToken)) == 200, "falhou")
    var secBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"secret\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"" + intToString(localSvc) + "\",\"protocol\":\"http\",\"exposure\":\"AUTHENTICATED\"}"
    need(statusOf(httpPostJson(controlPort, "/v1/services", secBody, accountToken)) == 200, "falhou")

    // sem tunel: device offline -> 503 KCF102
    var offline = httpGetRaw(httpPort, "/", "pub.mel.kofcloud.io")
    need(statusOf(offline) == 503, "falhou")
    need(codeIs(bodyOf(offline), "KCF102"), "falhou")

    // host desconhecido e PRIVATE respondem o mesmo 404 opaco
    var unknown = httpGetRaw(httpPort, "/", "naoexiste.mel.kofcloud.io")
    need(statusOf(unknown) == 404, "falhou")
    need(codeIs(bodyOf(unknown), "KCF100"), "falhou")

    var config = AgentConfig("http://127.0.0.1:" + intToString(controlPort), deviceId, accountId, accountToken, "", agentStop, "127.0.0.1", tunnelPort, 100)
    var agentTask = spawn { runAgent(config, true) }
    var online = false
    var attempts = 100
    while (attempts > 0 && online == false) {
        online = edgeState.isOnline(deviceId)
        if (online == false) {
            time.sleep(50)
            attempts = attempts - 1
        }
    }
    need(online, "falhou")

    need(statusOf(httpGetRaw(httpPort, "/", "pub.mel.kofcloud.io")) == 200, "falhou")

    var noCred = httpGetRaw(httpPort, "/", "secret.mel.kofcloud.io")
    need(statusOf(noCred) == 401, "falhou")
    need(codeIs(bodyOf(noCred), "KCF101"), "falhou")
    need(responseHeader(noCred, "www-authenticate") == "Bearer", "falhou")

    writeTextTo(agentStop, "stop")
    time.sleep(1500)
    need(edgeState.isOnline(deviceId) == false, "falhou")
    writeTextTo(edgeStop, "stop")
    time.sleep(1000)
    File(agentStop).delete()
    File(edgeStop).delete()
}

test "erros: Hint orienta sem vazar segredo ou recurso alheio", "errors-hint" {
    need(errHint("KCF004: missing or invalid account token").indexOf("login") >= 0, "falhou")
    need(errHint("KCF005: password too short").indexOf("4 caracteres") >= 0, "falhou")
    need(errPasswordTooShort().indexOf("KCF005") >= 0, "falhou")
    need(errHint(errPasswordTooShort()).indexOf("4 caracteres") >= 0, "falhou")
    need(errHint("KCF043: localPort required").indexOf("--port") >= 0, "falhou")
    need(errHint("KCF044: serviceId required").indexOf("service list") >= 0, "falhou")
    need(errHint("KCF022: not the owner of device").indexOf("outra conta") >= 0, "falhou")
    need(errHint("KCF060: not the owner of service").indexOf("outra conta") >= 0, "falhou")
    need(errHint("KCF061: serviceId and token required").indexOf("service token") >= 0, "falhou")
    need(errHint("KCF062: ttlHours must be positive").indexOf("--ttl") >= 0, "falhou")
    need(errHint("KCF101: authentication required").indexOf("kfs_") >= 0, "falhou")
    need(errHint("KCF100: no route for host").indexOf("domain list") >= 0, "falhou")
    need(errHint("KCF102: device not connected").indexOf("connect") >= 0, "falhou")
    need(errHint("KCF103: service site is OFFLINE").indexOf("logs") >= 0, "falhou")
    need(errHint("KCF104: tunnel error: boom").indexOf("reconexao") >= 0, "falhou")
    need(errHint("KCF105: empty response from service").indexOf("porta") >= 0, "falhou")
    need(errHint("KCF106: too many concurrent streams").indexOf("instantes") >= 0, "falhou")
    need(errHint("KCF107: too many requests").indexOf("instante") >= 0, "falhou")
    need(errHint("KCF108: too many connections for this service").indexOf("instantes") >= 0, "falhou")
    need(errHint(errWafDenied()).indexOf("_waf_denied") >= 0, "falhou")
    need(errHint(errWafAllowDenied()).indexOf("_waf_allow_denied") >= 0, "falhou")
    need(errHint("KCF110: request body too large").indexOf("httpBodyBytes") >= 0, "falhou")
    need(errHint("KCF112: upstream did not respond in time").indexOf("tunnelIdleMs") >= 0, "falhou")
    need(errHint("KCF120: bad hostname").indexOf("api.example.com") >= 0, "falhou")
    need(errHint("KCF121: hostname already registered").indexOf("domain list") >= 0, "falhou")
    need(errHint("KCF122: domain not found").indexOf("domain list") >= 0, "falhou")
    need(errHint("KCF124: does not resolve").indexOf("verify") >= 0, "falhou")
    need(errHint("KCF080: too many active devices").indexOf("revoke") >= 0, "falhou")
    need(errHint("KCF045: exposure must be PUBLIC").indexOf("PRIVATE") >= 0, "falhou")
    need(errHint("KCF046: protocol must be http").indexOf("HTTP") >= 0, "falhou")
    need(errHint("KCF047: localAddress must be loopback").indexOf("loopback") >= 0, "falhou")
    need(errHint("KCF063: short id matches more").indexOf("kfs_") >= 0, "falhou")
    need(errHint("KCF999: algo desconhecido") == "", "falhou")
}

test "erros: todo KCF emitido tem Hint (trava de regressao)", "errors-hint-all" {
    // Camada 1 — os construtores reais emitem o codigo e tem Hint (amarra o
    // corpo de cada err*(): trocar o codigo dentro do construtor quebra).
    // Os 62 construtores de Errors.kf; os 2 parametrizados recebem valor
    // ficticio (nunca viaja — so prova que a saida casa com a dica).
    var emitted = listOf<String>()
    emitted.add(errInvalidHandle())
    emitted.add(errHandleTaken())
    emitted.add(errInvalidCredentials())
    emitted.add(errUnauthorized())
    emitted.add(errPasswordTooShort())
    emitted.add(errDeviceFields())
    emitted.add(errDeviceNotFound())
    emitted.add(errDeviceNotYours())
    emitted.add(errDeviceRevoked())
    emitted.add(errInvalidServiceName())
    emitted.add(errServiceNotFound())
    emitted.add(errServiceNotYours())
    emitted.add(errLocalPort())
    emitted.add(errServiceIdRequired())
    emitted.add(errInvalidExposure())
    emitted.add(errInvalidProtocol())
    emitted.add(errInvalidAddress())
    emitted.add(errInvalidStatus())
    emitted.add(errServiceTokenForbidden())
    emitted.add(errServiceTokenRequired())
    emitted.add(errInvalidTtl())
    emitted.add(errAmbiguousToken())
    emitted.add(errAccountTokenNotFound())
    emitted.add(errLimitDevices())
    emitted.add(errLimitServices())
    emitted.add(errNoRoute())
    emitted.add(errAuthRequired())
    emitted.add(errDeviceOffline())
    emitted.add(errServiceDown("svc", "OFFLINE"))
    emitted.add(errTunnel("boom"))
    emitted.add(errEmptyUpstream())
    emitted.add(errTooManyStreams())
    emitted.add(errRateLimited())
    emitted.add(errServiceOverloaded())
    emitted.add(errWafDenied())
    emitted.add(errWafAllowDenied())
    emitted.add(errInvalidAllowMethod())
    emitted.add(errInvalidAllowPath())
    emitted.add(errBodyTooLarge())
    emitted.add(errUpstreamTimeout())
    emitted.add(errResponseTooLarge())
    emitted.add(errHeaderTooLarge())
    emitted.add(errTooManyPublicConns())
    emitted.add(errInvalidContentLength())
    emitted.add(errInvalidHost())
    emitted.add(errInvalidUpstreamResponse())
    emitted.add(errInvalidRequestLine())
    emitted.add(errInvalidHeaderLine())
    emitted.add(errServiceNameTaken())
    emitted.add(errServiceNameAmbiguous())
    emitted.add(errLoginRateLimited())
    emitted.add(errInvalidCustomHostname())
    emitted.add(errDomainTaken())
    emitted.add(errDomainNotFound())
    emitted.add(errDomainUnreachable())
    emitted.add(errDomainResolvesElsewhere())
    emitted.add(errTargetRequired())
    emitted.add(errInvalidTarget())
    emitted.add(errTargetNotFound())
    emitted.add(errTargetNotFrozen())
    emitted.add(errIncidentNotFound())
    emitted.add(errInvalidWebhook())
    emitted.add(errWebhookNotFound())
    emitted.add(errHeadWithBody())
    need(emitted.size == 64, "falhou")
    for (var msg in emitted) {
        need(errHint(msg).length > 0, "falhou")
    }
    // Camada 2 — lista canonica por codigo (amarra o errHint(): codigo novo
    // sem ramo de dica quebra aqui).
    // KCF123 e reservado, nunca emitido.
    // Se um codigo novo for adicionado sem Hint, este teste quebra de
    // proposito — Hint sem teste apodrece em silencio (licao KCF005).
    var codes = listOf<String>()
    codes.add("KCF001")
    codes.add("KCF002")
    codes.add("KCF003")
    codes.add("KCF004")
    codes.add("KCF005")
    codes.add("KCF020")
    codes.add("KCF021")
    codes.add("KCF022")
    codes.add("KCF023")
    codes.add("KCF040")
    codes.add("KCF041")
    codes.add("KCF042")
    codes.add("KCF043")
    codes.add("KCF044")
    codes.add("KCF045")
    codes.add("KCF046")
    codes.add("KCF047")
    codes.add("KCF048")
    codes.add("KCF060")
    codes.add("KCF061")
    codes.add("KCF062")
    codes.add("KCF063")
    codes.add("KCF064")
    codes.add("KCF080")
    codes.add("KCF081")
    codes.add("KCF100")
    codes.add("KCF101")
    codes.add("KCF102")
    codes.add("KCF103")
    codes.add("KCF104")
    codes.add("KCF105")
    codes.add("KCF106")
    codes.add("KCF107")
    codes.add("KCF108")
    codes.add("KCF109")
    codes.add("KCF110")
    codes.add("KCF111")
    codes.add("KCF112")
    codes.add("KCF113")
    codes.add("KCF114")
    codes.add("KCF115")
    codes.add("KCF116")
    codes.add("KCF117")
    codes.add("KCF118")
    codes.add("KCF119")
    codes.add("KCF120")
    codes.add("KCF121")
    codes.add("KCF122")
    codes.add("KCF124")
    codes.add("KCF125")
    codes.add("KCF126")
    codes.add("KCF127")
    codes.add("KCF128")
    codes.add("KCF129")
    codes.add("KCF130")
    codes.add("KCF131")
    codes.add("KCF132")
    codes.add("KCF133")
    codes.add("KCF134")
    codes.add("KCF136")
    codes.add("KCF139")
    codes.add("KCF140")
    codes.add("KCF141")
    codes.add("KCF164")
    for (var code in codes) {
        need(errHint(code + ": x").length > 0, "falhou")
    }
    // Camada 3 — completude: a lista canonica cobre TODOS os codigos que os
    // construtores emitem. Sem isso, um construtor novo entra no `emitted`
    // (camada 1) mas fica fora da lista (camada 2), e o Hint dele nunca e
    // verificado por codigo. Medido: KCF115 e KCF134 estavam exatamente
    // nesse buraco (construtores e Hint existiam, lista canonica nao).
    var fromConstructors = listOf<String>()
    for (var msg in emitted) {
        var head = msg.substring(0, 6)
        if (fromConstructors.contains(head) == false) {
            fromConstructors.add(head)
        }
    }
    need(fromConstructors.size == codes.size, "falhou")
    for (var code in fromConstructors) {
        need(codes.contains(code), "falhou")
    }
    // E o reservado continua sem dica (nunca emitido — se alguem emitir,
    // o teste acima nao pega, mas a tabela do protocolo acusa).
    need(errHint("KCF123: reservado") == "", "falhou")
}

test "erros: revoke e TTL invalidos viajam como KCF061/KCF062", "errors-token" {
    var controlPort = 19540
    var registry = Registry("/tmp/kofcloud-errt-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, controlPort, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(controlPort, 60), "falhou")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var accountToken = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"nb\",\"publicKey\":\"pk\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"AUTHENTICATED\"}"
    var published = httpPostJson(controlPort, "/v1/services", pubBody, accountToken)
    need(statusOf(published) == 200, "falhou")
    var serviceId = mapField(json.decode<Map<String, String>>(bodyOf(published)), "id")

    // Revoke sem serviceId nem token: 400 KCF061 (nao 404 — e erro de
    // requisicao, nao recurso ausente).
    var noFields = httpPostJson(controlPort, "/v1/services/token/revoke", "{}", accountToken)
    need(statusOf(noFields) == 400, "falhou")
    need(codeIs(errorCodeOf(noFields), "KCF061"), "falhou")
    // Revoke sem o token: mesmo 400 (o serviceId sozinho nao basta).
    var noTokenField = httpPostJson(controlPort, "/v1/services/token/revoke", "{\"serviceId\":\"" + serviceId + "\"}", accountToken)
    need(statusOf(noTokenField) == 400, "falhou")
    need(codeIs(errorCodeOf(noTokenField), "KCF061"), "falhou")
    // Revoke de token inexistente: 404 opaco, nao 400 (a forma esta certa,
    // o recurso e que nao existe).
    var ghost = httpPostJson(controlPort, "/v1/services/token/revoke", "{\"serviceId\":\"" + serviceId + "\",\"token\":\"kfs_inexistente\"}", accountToken)
    need(statusOf(ghost) == 404, "falhou")

    // Padding colado no token (copiar-colar com espaco) tambem e 404
    // opaco: o servidor compara o hash exato (e o prefixo curto), entao
    // " kfs_..." nunca casa — indistinguivel de token alheio. Por isso
    // o CLI apara o token antes de enviar (mesma paridade de trim do
    // nome); aqui o protocolo mostra o comportamento sem o trim.
    var issued = httpPostJson(controlPort, "/v1/services/token", "{\"serviceId\":\"" + serviceId + "\"}", accountToken)
    need(statusOf(issued) == 200, "falhou")
    var realToken = mapField(json.decode<Map<String, String>>(bodyOf(issued)), "token")
    var padded = httpPostJson(controlPort, "/v1/services/token/revoke", "{\"serviceId\":\"" + serviceId + "\",\"token\":\" " + realToken + " \"}", accountToken)
    need(statusOf(padded) == 404, "falhou")
    var exact = httpPostJson(controlPort, "/v1/services/token/revoke", "{\"serviceId\":\"" + serviceId + "\",\"token\":\"" + realToken + "\"}", accountToken)
    need(statusOf(exact) == 200, "falhou")

    // TTL zero e lixo: 400 KCF062 (na borda, igual ao e2e autenticado).
    var zeroTtl = httpPostJson(controlPort, "/v1/services/token", "{\"serviceId\":\"" + serviceId + "\",\"ttlHours\":\"0\"}", accountToken)
    need(statusOf(zeroTtl) == 400, "falhou")
    need(codeIs(errorCodeOf(zeroTtl), "KCF062"), "falhou")
    var junkTtl = httpPostJson(controlPort, "/v1/services/token", "{\"serviceId\":\"" + serviceId + "\",\"ttlHours\":\"para-sempre\"}", accountToken)
    need(statusOf(junkTtl) == 400, "falhou")
    need(codeIs(errorCodeOf(junkTtl), "KCF062"), "falhou")
}

test "erros: revokeTokenError mapeia outcome -> HTTP+corpo (trava pura)", "errors-revoke-status" {
    // Fonte unica do mapeamento que o handleRevokeServiceToken usa:
    // "ambiguous" -> 409 com KCF063, resto -> 404 com corpo reescrito para
    // KCF041 opaco (nunca vaza se o token existe). Mudar um ramo sem
    // atualizar a trava quebra aqui de proposito (precedente:
    // errors-publish-status, domains-status).
    var ambiguous = revokeTokenError("ambiguous")
    need(ambiguous.code == 409, "falhou")
    need(codeIs(ambiguous.body, "KCF063"), "falhou")
    var missing = revokeTokenError("")
    need(missing.code == 404, "falhou")
    need(codeIs(missing.body, "KCF041"), "falhou")
    var other = revokeTokenError("algo-estranho")
    need(other.code == 404, "falhou")
    need(codeIs(other.body, "KCF041"), "falhou")
}

test "device: nome resolve para o device VIVO apos re-registro", "device-name-live" {
    // Apos revogar + registrar de novo com o mesmo nome, a lista tem dois
    // devices homonimos. O resolvedor da CLI casava o PRIMEIRO por ordem de
    // lista — podia escolher o revogado (e `device revoke <nome>` virava
    // no-op silencioso). Nome tem de levar ao vivo; id continua exato.
    var port = 19567
    var registry = Registry("/tmp/kofcloud-devlive-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, port, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(port, 60), "falhou")
    var url = "http://127.0.0.1:" + intToString(port)
    var created = httpPostJson(port, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")

    var firstId = registerDevice(url, token, "notebook", "pk1")
    requireOk(http.post(url + "/v1/devices/revoke", "{\"deviceId\":\"" + firstId + "\"}", jsonHeader(token)))
    var secondId = registerDevice(url, token, "notebook", "pk2")
    need(secondId != firstId, "falhou")

    var session = LocalSession("", "mel", token, url)
    need(deviceIdByNameOrId(session, "notebook") == secondId, "falhou")
    need(deviceIdByNameOrId(session, firstId) == firstId, "falhou")
}

test "credencial trocada: kfs_ como senha/token/chave e recusado localmente", "cred-mixup" {
    // Medido no uso real: publish/rotate/login com `$(cat api.kfs)` mandavam
    // a credencial de SERVICO para a conta (ou para a chave do dispositivo)
    // e o control plane respondia "unauthorized"/handshake quebrado sem
    // dizer que o arquivo era o errado.
    need(credentialMixupError("--password", "kfs_abc123") != "", "o kfs_ como senha e recusado")
    need(credentialMixupError("--password", "segredo-bom") == "", "senha normal passa")
    need(credentialMixupError("--password", "") == "", "senha vazia nao e mixup (validada antes)")
    need(credentialMixupError("--password", "  kfs_abc123  ").indexOf("--password") >= 0, "a mensagem nomeia o campo (com trim)")
    need(credentialMixupError("--password", "kfs_abc").indexOf("kfs_") >= 0, "a mensagem nomeia o kfs_")
    need(credentialMixupError("--password", "kfs_abc").indexOf("servico AUTHENTICATED") >= 0, "a mensagem explica o que o kfs_ autentica")
    // O valor nunca entra na mensagem.
    var mixDevice = credentialMixupError("--device", "kfs_SEGREDO123")
    need(mixDevice != "", "kfs_ como --device e recusado")
    need(mixDevice.indexOf("SEGREDO") < 0, "o valor nunca entra na mensagem")
    need(credentialMixupError("--device", "notebook") == "", "nome de device normal passa")
    need(credentialMixupError("--device", "kfc_abc") == "", "kfc_ NAO e mixup (e a credencial da conta)")
}

test "credencial trocada: login recusa antes de qualquer rede", "cred-mixup-e2e" {
    var priorSession = readTextOr(sessionPath(), "")
    var priorIdentity = readTextOr(identityPath(), "")
    File(sessionPath()).delete()
    File(identityPath()).delete()
    // Control inalcancavel de proposito: a recusa tem de vir ANTES da rede
    // (se tentasse conectar, o teste quebraria por erro de conexao, nao 0/1
    // deterministico).
    var code = cmdLogin(listOf("mel", "--password", "kfs_nao-e-senha", "--control", "http://127.0.0.1:1"))
    need(code == 1, "login com kfs_ como senha recusa (exit 1)")
    var stored = readTextOr(sessionPath(), "")
    need(stored.length == 0, "nada foi gravado na sessao")
    // Senha normal segue para a rede (e falha por conexao): prova que a
    // guarda so pega o mixup.
    var normal = cmdLogin(listOf("mel", "--password", "segredo", "--control", "http://127.0.0.1:1"))
    need(normal == 1, "senha normal tenta a rede e falha")
    if (priorSession.length > 0) {
        writeTextTo(sessionPath(), priorSession)
    }
    if (priorIdentity.length > 0) {
        writeTextTo(identityPath(), priorIdentity)
    }
}
