
import kofcloud.cli.Commands
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.store.Store
import testkit.Support

// Integracao: Agent <-> Control Plane (HTTP real sobre socket).
// Porta dedicada 18080 para nao colidir com outros suites.

test "control plane: ciclo conta -> device -> publish -> list -> revoke" {
    var path = "/tmp/kofcloud-cp-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    var control = ControlPlane(registry, 18080, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(18080, 60), "falhou")

    var health = httpGetRaw(18080, "/v1/health", "127.0.0.1")
    need(statusOf(health) == 200, "falhou")

    var created = httpPostJson(18080, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"mel@example.com\",\"password\":\"segredo\"}", "")
    need(statusOf(created) == 200, "falhou")
    var createdBody = json.decode<Map<String, String>>(bodyOf(created))
    var token = mapField(createdBody, "token")
    need(token.startsWith("kfc_"), "falhou")

    var deviceBody = "{\"name\":\"notebook\",\"publicKey\":\"pubkey-abc\"}"
    var device = httpPostJson(18080, "/v1/devices", deviceBody, token)
    need(statusOf(device) == 200, "falhou")
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(device)), "deviceId")
    need(deviceId.length > 0, "falhou")

    var publishBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    var published = httpPostJson(18080, "/v1/services", publishBody, token)
    need(statusOf(published) == 200, "falhou")
    need(bodyOf(published).indexOf("site.mel.kofcloud.io") >= 0, "falhou")

    var listed = httpGetRaw(18080, "/v1/services", "127.0.0.1")
    // a rota exige token; sem ele responde 401 (prova a autorizacao)
    need(statusOf(listed) == 401, "falhou")

    var connectBody = "{\"deviceId\":\"" + deviceId + "\"}"
    var connect = httpPostJson(18080, "/v1/connect", connectBody, token)
    need(statusOf(connect) == 200, "falhou")
    need(bodyOf(connect).indexOf("edgePort") >= 0, "falhou")

    var revokeBody = "{\"deviceId\":\"" + deviceId + "\"}"
    var revoked = httpPostJson(18080, "/v1/devices/revoke", revokeBody, token)
    need(statusOf(revoked) == 200, "falhou")
    var revokedDevice = registry.deviceById(deviceId)
    need(revokedDevice != null, "falhou")
    if (revokedDevice != null) {
        need(revokedDevice.status == "REVOKED", "falhou")
    }
}

test "control plane: token invalido e recusado" {
    var path = "/tmp/kofcloud-cp2-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    var control = ControlPlane(registry, 18081, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(18081, 60), "falhou")
    var denied = httpPostJson(18081, "/v1/devices", "{\"name\":\"x\",\"publicKey\":\"y\"}", "kfc_falso")
    need(statusOf(denied) == 401, "falhou")
}

test "control plane: HTTPS com PEM do operador (serve --tls-cert/--tls-key)", "control-tls" {
    // E2E (porta dedicada 18082): openssl gera o par, enableTls liga o
    // listenSecure, e o cliente http.get (trust-all no Kof) le o /v1/health.
    // Prova o slice Fase 9 parcial: login/token viajam cifrados no control.
    trustLocalhostTls()
    var dir = "/tmp/kofcloud-tls-" + crypto.randomHex(4)
    Directory(dir).createDirectories()
    var certPath = dir + "/cert.pem"
    var keyPath = dir + "/key.pem"
    var gen = process.run("openssl", "req", "-x509", "-newkey", "rsa:2048", "-keyout", keyPath, "-out", certPath, "-days", "1", "-nodes", "-subj", "/CN=localhost", "-addext", "subjectAltName=IP:127.0.0.1,DNS:localhost")
    need(gen.exitCode == 0, "falhou")
    var certPem = readTextOr(certPath, "")
    var keyPem = readTextOr(keyPath, "")
    need(certPem.length > 0 && keyPem.length > 0, "falhou")
    var path = "/tmp/kofcloud-cp-tls-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    var control = ControlPlane(registry, 18082, "127.0.0.1", 0)
    control.enableTls(certPem, keyPem)
    var server = spawn { control.start() }
    need(waitForPort(18082, 60), "falhou")
    var health = http.get("https://127.0.0.1:18082/v1/health")
    need(health.indexOf("ok") >= 0, "falhou")
    // HSTS (Fase 9 slice 2): o runtime do Kof 0.8 NAO emite mais
    // Strict-Transport-Security por default (medido: a resposta crua via
    // openssl s_client sob TLS traz so os headers do handler). Se o KofCloud
    // quer o header, tem de emiti-lo; a trava abaixo impede que a prosa das
    // docs prometa o que o fio nao entrega.
    var raw = process.run("sh", "-c", "printf 'GET /v1/health HTTP/1.0\r\n\r\n' | timeout 15 openssl s_client -connect 127.0.0.1:18082 -quiet 2>/dev/null")
    var hsts = responseHeader(raw.stdout, "strict-transport-security")
    // HSTS reimplementado no control plane (o runtime 0.8 deixou de emitir,
    // §823): o header sai pelo middleware do listener TLS, com o valor da
    // fonte unica, e so sob TLS.
    need(hsts == hstsHeaderValue(), "hsts sob TLS: " + hsts)
    need(hstsHeaderValue() == "max-age=31536000", "valor travado da fonte unica")
    need(hstsHeaderName() == "Strict-Transport-Security", "nome travado da fonte unica")
    need(hstsHeaderValue().indexOf("includeSubDomains") < 0, "sem includeSubDomains (escopo do Edge e outro)")
    // HTTP sem TLS nao anuncia HSTS (anunciar em claro seria mentir).
    var plain = ControlPlane(registry, 18083, "127.0.0.1", 0)
    var plainServer = spawn { plain.start() }
    need(waitForPort(18083, 60), "falhou")
    var plainRaw = httpGetRaw(18083, "/v1/health", "127.0.0.1")
    need(responseHeader(plainRaw, "strict-transport-security") == "", "falhou")
}

test "control plane: fluxo real da CLI (login + device) sobre HTTPS", "control-tls-cli" {
    // Fecha o gap do slice anterior: so o /v1/health estava provado. Aqui
    // passam as funcoes REAIS que o `cmdLogin` chama — loginOrCreate (cria
    // a conta e emite o kfc_) e registerDevice (header X-KofCloud-Token) —
    // contra o control plane com TLS. Sem tocar HOME: saveSession/
    // saveIdentity ficam no cmdLogin, nao nestas funcoes.
    var dir = "/tmp/kofcloud-tlscli-" + crypto.randomHex(4)
    Directory(dir).createDirectories()
    var certPath = dir + "/cert.pem"
    var keyPath = dir + "/key.pem"
    var gen = process.run("openssl", "req", "-x509", "-newkey", "rsa:2048", "-keyout", keyPath, "-out", certPath, "-days", "1", "-nodes", "-subj", "/CN=localhost", "-addext", "subjectAltName=IP:127.0.0.1,DNS:localhost")
    need(gen.exitCode == 0, "falhou")
    var certPem = readTextOr(certPath, "")
    var keyPem = readTextOr(keyPath, "")
    var path = "/tmp/kofcloud-cp-tlscli-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    var control = ControlPlane(registry, 18084, "127.0.0.1", 0)
    control.enableTls(certPem, keyPem)
    var server = spawn { control.start() }
    need(waitForPort(18084, 60), "falhou")
    var controlUrl = "https://127.0.0.1:18084"
    // Login/criacao de conta pela CLI real, sobre TLS.
    var token = loginOrCreate(controlUrl, "mel", "segredo")
    need(token.startsWith("kfc_"), "falhou")
    // Device pela CLI real (header X-KofCloud-Token) sobre TLS.
    var deviceId = registerDevice(controlUrl, token, "nb", "pk")
    need(deviceId.length > 0, "falhou")
    // O token e a credencial: nunca aparecem na URL nem em header de log.
    need(controlUrl.indexOf(token) < 0, "falhou")
}

test "control: toda rota /v1 registrada esta documentada em docs/06", "control-docs" {
    // A tabela do 06-control-protocol e o contrato publico. Cinco rotas
    // existiam no codigo e nao estavam nela (audit/verify, services/rotate,
    // services/rotation, token-hygiene, webhook) — um integrador lendo a doc
    // nao as descobria. Este teste le AS DUAS FONTES e exige que toda rota
    // registrada apareca na tabela (e vice-versa).
    var codeRaw = File("src/kofcloud/control/ControlPlane.kf").readText()
    var docRaw = File("docs/06-control-protocol.md").readText()
    var code = ""
    var doc = ""
    if (codeRaw != null) {
        code = codeRaw
    }
    if (docRaw != null) {
        doc = docRaw
    }
    if (code.length == 0 || doc.length == 0) {
        return
    }
    var routes = listOf<String>()
    for (var verb in listOf("get", "post")) {
        var needle = "app." + verb + "(\"/v1/"
        var cursor = code.indexOf(needle)
        while (cursor >= 0) {
            var start = cursor + needle.length - 4
            var end = code.indexOf("\"", start)
            if (end > start) {
                var route = code.substring(start, end)
                if (routes.contains(route) == false) {
                    routes.add(route)
                }
            }
            cursor = code.indexOf(needle, end)
        }
    }
    need(routes.size >= 30, "falhou")
    var missing = listOf<String>()
    for (var route in routes) {
        if (doc.indexOf("`" + route + "`") < 0) {
            missing.add(route)
        }
    }
    var detail = ""
    for (var route in missing) {
        detail = detail + " " + route
    }
    need(missing.size == 0, "falhou")
    // Honestidade do ciclo de billing (trava docs×codigo, padrao das travas
    // de docs): o export fechava a janela so em memoria e um restart
    // RE-FATURAVA — o reset passou a persistir na hora (`usageSnapshot`
    // grava junto do zeramento) e a frase stale ("Um crash entre o
    // snapshot...") ficou na doc. Este assert impede o regresso: exige o
    // texto novo condizente com o codigo e proibe o velho.
    need(code.indexOf("usageSnapshot") >= 0, "falhou")
    need(doc.indexOf("O reset do export persiste na hora") >= 0, "falhou")
    need(doc.indexOf("entre o snapshot e o próximo") < 0, "falhou")
}

test "control plane: publish em device revogado devolve 409 KCF023", "control-publish-revoked" {
    // Medido: a rota aceitava publicar num device revogado (200) e criava um
    // servico que nunca serviria. Agora o registry recusa (KCF023) e a borda
    // mapeia para 409 — o pedido e do dono e o recurso existe, mas o estado
    // impede; 404 opaco esconderia a causa acionavel.
    var port = 18095
    var registry = Registry("/tmp/kofcloud-cp-rev-" + crypto.randomHex(4) + ".json")
    var control = ControlPlane(registry, port, "127.0.0.1", 0)
    var server = spawn { control.start() }
    need(waitForPort(port, 60), "falhou")

    var created = httpPostJson(port, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var token = mapField(json.decode<Map<String, String>>(bodyOf(created)), "token")
    var device = httpPostJson(port, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pk\"}", token)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(device)), "deviceId")

    var revoked = httpPostJson(port, "/v1/devices/revoke", "{\"deviceId\":\"" + deviceId + "\"}", token)
    need(statusOf(revoked) == 200, "falhou")

    var publishBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    var published = httpPostJson(port, "/v1/services", publishBody, token)
    need(statusOf(published) == 409, "falhou")
    need(bodyOf(published).indexOf("KCF023") >= 0, "falhou")
    // accountByHandle e nulavel: estreita antes de ler .id (SEM049).
    var mel = registry.accountByHandle("mel")
    need(mel != null, "falhou")
    if (mel != null) {
        need(registry.servicesForAccount(mel.id).size == 0, "falhou")
    }
}
