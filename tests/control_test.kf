
import kofcloud.cli.Commands
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.store.Store
import testkit.Support

// Integracao: Agent <-> Control Plane (HTTP real sobre socket).
// Porta dedicada 18080 para nao colidir com outros suites.

test "control plane: ciclo conta -> device -> publish -> list -> revoke" {
    var path = "/tmp/kofcloud-cp-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    var control = ControlPlane(registry, 18080, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(18080, 60), "control plane no ar")

    var health = httpGetRaw(18080, "/v1/health", "127.0.0.1")
    assert(statusOf(health) == 200, "health 200")

    var created = httpPostJson(18080, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"mel@example.com\",\"password\":\"segredo\"}", "")
    assert(statusOf(created) == 200, "conta criada")
    var createdBody = json.decode<Map<String, String>>(bodyOf(created))
    var token = mapField(createdBody, "token")
    assert(token.startsWith("kfc_"), "token emitido")

    var deviceBody = "{\"name\":\"notebook\",\"publicKey\":\"pubkey-abc\"}"
    var device = httpPostJson(18080, "/v1/devices", deviceBody, token)
    assert(statusOf(device) == 200, "device registrado")
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(device)), "deviceId")
    assert(deviceId.length > 0, "deviceId presente")

    var publishBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"8080\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    var published = httpPostJson(18080, "/v1/services", publishBody, token)
    assert(statusOf(published) == 200, "servico publicado")
    assert(bodyOf(published).indexOf("site.mel.kofcloud.io") >= 0, "hostname no corpo")

    var listed = httpGetRaw(18080, "/v1/services", "127.0.0.1")
    // a rota exige token; sem ele responde 401 (prova a autorizacao)
    assert(statusOf(listed) == 401, "listagem sem token e recusada")

    var connectBody = "{\"deviceId\":\"" + deviceId + "\"}"
    var connect = httpPostJson(18080, "/v1/connect", connectBody, token)
    assert(statusOf(connect) == 200, "connect 200")
    assert(bodyOf(connect).indexOf("edgePort") >= 0, "edge informado")

    var revokeBody = "{\"deviceId\":\"" + deviceId + "\"}"
    var revoked = httpPostJson(18080, "/v1/devices/revoke", revokeBody, token)
    assert(statusOf(revoked) == 200, "revogado")
    var revokedDevice = registry.deviceById(deviceId)
    assert(revokedDevice != null, "device existe")
    if (revokedDevice != null) {
        assert(revokedDevice.status == "REVOKED", "status no registry")
    }
}

test "control plane: token invalido e recusado" {
    var path = "/tmp/kofcloud-cp2-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    var control = ControlPlane(registry, 18081, "127.0.0.1", 0)
    var server = spawn { control.start() }
    assert(waitForPort(18081, 60), "control plane no ar")
    var denied = httpPostJson(18081, "/v1/devices", "{\"name\":\"x\",\"publicKey\":\"y\"}", "kfc_falso")
    assert(statusOf(denied) == 401, "401 sem token valido")
}

test "control plane: HTTPS com PEM do operador (serve --tls-cert/--tls-key)", "control-tls" {
    // E2E (porta dedicada 18082): openssl gera o par, enableTls liga o
    // listenSecure, e o cliente http.get (trust-all no Kof) le o /v1/health.
    // Prova o slice Fase 9 parcial: login/token viajam cifrados no control.
    var dir = "/tmp/kofcloud-tls-" + crypto.randomHex(4)
    Directory(dir).createDirectories()
    var certPath = dir + "/cert.pem"
    var keyPath = dir + "/key.pem"
    var gen = process.run("openssl", "req", "-x509", "-newkey", "rsa:2048", "-keyout", keyPath, "-out", certPath, "-days", "1", "-nodes", "-subj", "/CN=localhost", "-addext", "subjectAltName=IP:127.0.0.1,DNS:localhost")
    assert(gen.exitCode == 0, "openssl gerou o par")
    var certPem = readTextOr(certPath, "")
    var keyPem = readTextOr(keyPath, "")
    assert(certPem.length > 0 && keyPem.length > 0, "PEMs lidos do disco")
    var path = "/tmp/kofcloud-cp-tls-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    var control = ControlPlane(registry, 18082, "127.0.0.1", 0)
    control.enableTls(certPem, keyPem)
    var server = spawn { control.start() }
    assert(waitForPort(18082, 60), "control plane TLS no ar")
    var health = http.get("https://127.0.0.1:18082/v1/health")
    assert(health.indexOf("ok") >= 0, "health via HTTPS: " + health)
    // HSTS (Fase 9 slice 2 parcial): o runtime do Kof emite
    // Strict-Transport-Security em TODA resposta web.app() sob TLS
    // (Policy.headers=true por default; gated em req.secure do SSLSocket —
    // medido em JvmRuntimeWebDispatch/JvmWebSecurityRuntime). http.get so
    // devolve corpo, entao a prova e a resposta crua via openssl s_client
    // (precedente daemon-argv: openssl via process.run; sh+printf monta o
    // CRLF que o readRequest exige — LF puro espera eterno).
    var raw = process.run("sh", "-c", "printf 'GET /v1/health HTTP/1.0\r\n\r\n' | timeout 15 openssl s_client -connect 127.0.0.1:18082 -quiet 2>/dev/null")
    var hsts = responseHeader(raw.stdout, "strict-transport-security")
    assert(hsts.indexOf("max-age=") >= 0, "HSTS via HTTPS: " + hsts)
    // HTTP sem TLS nao anuncia HSTS (anunciar em claro seria mentir).
    var plain = ControlPlane(registry, 18083, "127.0.0.1", 0)
    var plainServer = spawn { plain.start() }
    assert(waitForPort(18083, 60), "control plane HTTP no ar")
    var plainRaw = httpGetRaw(18083, "/v1/health", "127.0.0.1")
    assert(responseHeader(plainRaw, "strict-transport-security") == "", "sem HSTS em HTTP")
}

test "control plane: fluxo real da CLI (login + device) sobre HTTPS", "control-tls-cli" {
    // Fecha o gap do slice anterior: so o /v1/health estava provado. Aqui
    // passam as funcoes REAIS que o `cmdLogin` chama — loginOrCreate (cria
    // a conta e emite o kfc_) e registerDevice (header X-KofCloud-Token) —
    // contra o control plane com TLS. Sem tocar HOME: saveSession/
    // saveIdentity ficam no cmdLogin, nao nestas funcoes.
    var dir = "/tmp/kofcloud-tlscli-" + crypto.randomHex(4)
    Directory(dir).createDirectories()
    var certPath = dir + "/cert.pem"
    var keyPath = dir + "/key.pem"
    var gen = process.run("openssl", "req", "-x509", "-newkey", "rsa:2048", "-keyout", keyPath, "-out", certPath, "-days", "1", "-nodes", "-subj", "/CN=localhost", "-addext", "subjectAltName=IP:127.0.0.1,DNS:localhost")
    assert(gen.exitCode == 0, "openssl gerou o par")
    var certPem = readTextOr(certPath, "")
    var keyPem = readTextOr(keyPath, "")
    var path = "/tmp/kofcloud-cp-tlscli-" + crypto.randomHex(4) + ".json"
    var registry = Registry(path)
    var control = ControlPlane(registry, 18084, "127.0.0.1", 0)
    control.enableTls(certPem, keyPem)
    var server = spawn { control.start() }
    assert(waitForPort(18084, 60), "control plane TLS no ar")
    var controlUrl = "https://127.0.0.1:18084"
    // Login/criacao de conta pela CLI real, sobre TLS.
    var token = loginOrCreate(controlUrl, "mel", "segredo")
    assert(token.startsWith("kfc_"), "token emitido via HTTPS: " + token)
    // Device pela CLI real (header X-KofCloud-Token) sobre TLS.
    var deviceId = registerDevice(controlUrl, token, "nb", "pk")
    assert(deviceId.length > 0, "device registrado via HTTPS: " + deviceId)
    // O token e a credencial: nunca aparecem na URL nem em header de log.
    assert(controlUrl.indexOf(token) < 0, "token fora da URL")
}
