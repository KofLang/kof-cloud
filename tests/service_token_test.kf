import kofcloud.cli.Commands
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.identity.Tokens
import kofcloud.util.Text
import testkit.Support

// Fase 5 — credencial de servico (kfs_) para servicos AUTHENTICATED.
// O token da conta autoriza a EMISSAO; o token emitido autoriza o ACESSO e
// vale apenas para o servico que o originou.

String serviceTokenPath(String name) {
    return "/tmp/kofcloud-stoken-" + name + "-" + crypto.randomHex(4) + ".json"
}

test "token de servico: resolve o servico que o originou" {
    var registry = Registry(serviceTokenPath("resolve"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED", "", "")
    var token = registry.issueServiceToken(account.id, service.id)
    need(token.startsWith("kfs_"), "falhou")
    var resolved = registry.serviceByServiceToken(token)
    need(resolved != null, "falhou")
    if (resolved != null) {
        need(resolved.id == service.id, "falhou")
    }
}

test "token de servico: nao vale para outro servico" {
    var registry = Registry(serviceTokenPath("cross"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var site = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED", "", "")
    var api = registry.publishService(account, device.id, "api", "127.0.0.1", 3000, "http", "AUTHENTICATED", "", "")
    var siteToken = registry.issueServiceToken(account.id, site.id)
    var owner = registry.serviceByServiceToken(siteToken)
    need(owner != null, "falhou")
    if (owner != null) {
        need(owner.id != api.id, "falhou")
    }
}

test "token de servico: token invalido ou vazio nao resolve" {
    var registry = Registry(serviceTokenPath("invalid"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED", "", "")
    registry.issueServiceToken(account.id, service.id)
    need(registry.serviceByServiceToken("kfs_naoexiste") == null, "falhou")
    need(registry.serviceByServiceToken("") == null, "falhou")
}

test "token de servico: so a conta dona emite" {
    var registry = Registry(serviceTokenPath("owner"))
    var mel = registry.createAccount("mel", "mel@e.com", "segredo")
    var ana = registry.createAccount("ana", "ana@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED", "", "")
    var blocked = false
    try {
        registry.issueServiceToken(ana.id, service.id)
    } catch (String e) {
        blocked = true
    }
    need(blocked, "falhou")
}

test "token de servico: remover o servico poda as credenciais" {
    var path = serviceTokenPath("prune")
    var registry = Registry(path)
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED", "", "")
    var token = registry.issueServiceToken(account.id, service.id)
    need(registry.serviceByServiceToken(token) != null, "falhou")
    need(registry.removeService(account.id, service.id) == true, "falhou")
    need(registry.serviceByServiceToken(token) == null, "falhou")
    // Cruzamento remoção × higiene: a credencial podada NÃO fica no relatório
    // de higiene ("sem expiração" é para credencial VIVA que ninguém rotacionou —
    // órfã não é pendência, e o serviço nem existe mais para ser nomeado).
    need(registry.tokensWithoutExpiry(account.id).size == 0, "falhou")
    need(registry.servicesWithUnrotatedTokens(account.id).size == 0, "falhou")
    var reloaded = Registry(path)
    need(reloaded.serviceByServiceToken(token) == null, "falhou")
    need(reloaded.tokensWithoutExpiry(account.id).size == 0, "falhou")
}

test "token de servico: revogar o dispositivo poda as credenciais dos servicos" {
    var registry = Registry(serviceTokenPath("revoke"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED", "", "")
    var token = registry.issueServiceToken(account.id, service.id)
    need(registry.revokeDevice(account.id, device.id) == true, "falhou")
    need(registry.serviceByServiceToken(token) == null, "falhou")
    // Cruzamento revoke-device × higiene (espelho do removeService): a poda
    // do device REVOKED também limpa o relatório — órfã de device morto não
    // é pendência de rotação.
    need(registry.tokensWithoutExpiry(account.id).size == 0, "falhou")
    need(registry.servicesWithUnrotatedTokens(account.id).size == 0, "falhou")
}

test "token de servico: persiste entre recargas do registry" {
    var path = serviceTokenPath("persist")
    var registry = Registry(path)
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED", "", "")
    var token = registry.issueServiceToken(account.id, service.id)
    var reloaded = Registry(path)
    need(reloaded.serviceByServiceToken(token) != null, "falhou")
}

test "token de servico: revoke invalida so o token revogado", "token-revoke" {
    var registry = Registry(serviceTokenPath("revoke-one"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED", "", "")
    var leaked = registry.issueServiceToken(account.id, service.id)
    var spared = registry.issueServiceToken(account.id, service.id)
    need(registry.revokeServiceToken(account.id, service.id, leaked) == true, "falhou")
    need(registry.serviceByServiceToken(leaked) == null, "falhou")
    need(registry.serviceByServiceToken(spared) != null, "falhou")
    // Idempotente: revogar de novo nao e erro de estado, so retorna false.
    need(registry.revokeServiceToken(account.id, service.id, leaked) == false, "falhou")
}

test "token de servico: revoke exige dono, servico e token validos", "token-revoke-gate" {    var registry = Registry(serviceTokenPath("revoke-gate"))
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var ana = registry.createAccount("ana", "ana@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED", "", "")
    var token = registry.issueServiceToken(mel.id, service.id)
    // Outra conta nao revoga (mesmo sabendo o token): false, sem vazar nada.
    need(registry.revokeServiceToken(ana.id, service.id, token) == false, "falhou")
    need(registry.serviceByServiceToken(token) != null, "falhou")
    // Servico inexistente: false.
    need(registry.revokeServiceToken(mel.id, "inexistente", token) == false, "falhou")
    // Token vazio/errado: false.
    need(registry.revokeServiceToken(mel.id, service.id, "") == false, "falhou")
    need(registry.revokeServiceToken(mel.id, service.id, "kfs_inexistente") == false, "falhou")
    // E2E: endpoint HTTP devolve 200 e o token para de autorizar.
    need(true, "falhou")
}

test "token de servico: inventario lista sem expor valores", "token-list" {
    var registry = Registry(serviceTokenPath("inventory"))
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var ana = registry.createAccount("ana", "ana@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED", "", "")
    // Vazio antes de emitir.
    need(registry.serviceTokensFor(mel.id, service.id).size == 0, "falhou")
    // Emite duas: o inventario cresce, mas nunca devolve o valor.
    var first = registry.issueServiceToken(mel.id, service.id)
    var second = registry.issueServiceToken(mel.id, service.id)
    var entries = registry.serviceTokensFor(mel.id, service.id)
    need(entries.size == 2, "falhou")
    for (var entry in entries) {
        need(entry.serviceId == service.id, "falhou")
        need(entry.tokenHash != first && entry.tokenHash != second, "falhou")
        need(entry.tokenHash.length > 8, "falhou")
    }
    // Conta alheia nao ve nada (nem existencia): lista vazia, sem oraculo.
    need(registry.serviceTokensFor(ana.id, service.id).size == 0, "falhou")
    // Servico inexistente: vazio, sem erro.
    need(registry.serviceTokensFor(mel.id, "inexistente").size == 0, "falhou")
    // Revogar uma tira so ela do inventario.
    need(registry.revokeServiceToken(mel.id, service.id, first) == true, "falhou")
    need(registry.serviceTokensFor(mel.id, service.id).size == 1, "falhou")
}

test "token de servico: expiracao opcional poda na validacao", "token-ttl" {
    var registry = Registry(serviceTokenPath("ttl"))
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED", "", "")
    // Sem TTL: vale para sempre (comportamento antigo), expiresAt zero.
    var forever = registry.issueServiceToken(mel.id, service.id, 0)
    need(registry.serviceByServiceToken(forever) != null, "falhou")
    var listed = registry.serviceTokensFor(mel.id, service.id)
    need(listed.size == 1, "falhou")
    need(listed.get(0).expiresAt == 0, "falhou")
    // Com TTL: expiracao futura marcada, ainda valida.
    var timed = registry.issueServiceToken(mel.id, service.id, 24)
    need(registry.serviceByServiceToken(timed) != null, "falhou")
    need(registry.serviceTokensFor(mel.id, service.id).size == 2, "falhou")
    // Expirada: constroi o registro direto no passado (sem dormir 1h).
    var stale = ServiceToken(service.id, mel.id, tokenHash("kfs_vencido"), time.now() - 1000, time.now() - 1)
    registry.serviceTokens.add(stale)
    var expiredBefore = metricCount("kofcloud_control_service_tokens_expired_total")
    need(registry.serviceByServiceToken("kfs_vencido") == null, "falhou")
    need(metricCount("kofcloud_control_service_tokens_expired_total") == expiredBefore + 1, "falhou")
    // A poda preguicosa removeu: nem no inventario aparece mais.
    need(registry.serviceTokensFor(mel.id, service.id).size == 2, "falhou")
    // As validas sobrevivem a poda.
    need(registry.serviceByServiceToken(forever) != null, "falhou")
    need(registry.serviceByServiceToken(timed) != null, "falhou")
    // TTL longo (720 h = 30 dias) nao pode estourar: em Int (32 bits),
    // `720 * 3600000` = -1702967296 e a credencial nasceria vencida
    // (medido com o CLI 0.6.3). Em Long = 2592000000, no futuro.
    var longTtl = registry.issueServiceToken(mel.id, service.id, 720)
    need(registry.serviceByServiceToken(longTtl) != null, "falhou")
    var marked = false
    for (var entry in registry.serviceTokensFor(mel.id, service.id)) {
        if (entry.serviceId == service.id && entry.expiresAt > time.now()) {
            marked = true
        }
    }
    need(marked, "falhou")
}

test "token de servico: revoke aceita id curto unico, recusa ambiguo", "token-short" {
    var registry = Registry(serviceTokenPath("short"))
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED", "", "")
    var first = registry.issueServiceToken(mel.id, service.id)
    var second = registry.issueServiceToken(mel.id, service.id)
    // Id curto: 8 primeiros hex do hash (mesmo que o inventario mostra).
    var firstId = tokenHash(first).substring(0, 8)
    var secondId = tokenHash(second).substring(0, 8)
    if (firstId == secondId) {
        // Colisao de 32 bits entre dois tokens: astronomicamente improvavel
        // (1/4bi); se um dia cair aqui, o teste acusa em vez de fingir.
        assert(false, "colisao de id curto no teste (re-rodar)")
    }
    // Prefixo que casa com os dois: ambiguo (nem toca em nada).
    var common = ""
    var i = 0
    while (i < 8 && firstId.substring(0, i + 1) == secondId.substring(0, i + 1)) {
        i = i + 1
    }
    if (i > 0) {
        var ambiguous = firstId.substring(0, i)
        need(registry.revokeServiceTokenResult(mel.id, service.id, ambiguous) == "ambiguous", "falhou")
        need(registry.serviceByServiceToken(first) != null, "falhou")
        need(registry.serviceByServiceToken(second) != null, "falhou")
    }
    // Id curto unico: revoga exatamente aquele.
    need(registry.revokeServiceTokenResult(mel.id, service.id, firstId) == "revoked", "falhou")
    need(registry.serviceByServiceToken(first) == null, "falhou")
    need(registry.serviceByServiceToken(second) != null, "falhou")
    // E o wrapper Bool continua valendo true/false.
    need(registry.revokeServiceToken(mel.id, service.id, secondId) == true, "falhou")
}

test "token de servico: serializadores puros sem rede", "token-serial" {
    // shortTokenId: 8 primeiros hex; curto passa direto.
    need(shortTokenId("0123456789abcdef") == "01234567", "falhou")
    need(shortTokenId("abc") == "abc", "falhou")
    need(shortTokenId("") == "", "falhou")
    // Com TTL e sem TTL: expiresAt so aparece quando > 0.
    var forever = ServiceToken("svc-1", "acc-1", "0123456789abcdef", 1000, 0)
    var timed = ServiceToken("svc-1", "acc-1", "0123456789abcdef", 1000, 2000)
    var foreverJson = serviceTokenJson(forever)
    var timedJson = serviceTokenJson(timed)
    var foreverBody = json.decode<Map<String, String>>(foreverJson)
    need(mapField(foreverBody, "id") == "01234567", "falhou")
    need(mapField(foreverBody, "serviceId") == "svc-1", "falhou")
    need(mapField(foreverBody, "expiresAt") == "", "falhou")
    need(foreverJson.indexOf("kfs_") < 0, "falhou")
    var timedBody = json.decode<Map<String, String>>(timedJson)
    need(mapField(timedBody, "expiresAt") == "2000", "falhou")
    // Lista: envolve em colchetes, vazia vira [].
    var oneItems = listOf<ServiceToken>()
    oneItems.add(forever)
    var oneList = serviceTokenListJson(oneItems)
    need(oneList.startsWith("[") && oneList.endsWith("]"), "falhou")
    need(oneList.indexOf("01234567") >= 0, "falhou")
    need(serviceTokenListJson(listOf<ServiceToken>()) == "[]", "falhou")
    // joinStrings: separador so entre partes.
    need(joinStrings(listOf("a", "b", "c"), ",") == "a,b,c", "falhou")
    need(joinStrings(listOf<String>(), ",") == "", "falhou")
}

// Contador Prometheus atual (0 quando ausente): cada suite roda no mesmo
// processo, entao a assercao e sempre relativa (antes/depois).
Int metricCount(String name) {
    for (var line in observability.metrics().split("\n")) {
        var trimmed = line.trim()
        if (trimmed.startsWith(name + " ")) {
            return parseIntSafe(trimmed.substring(name.length + 1).trim(), 0)
        }
    }
    return 0
}

test "aviso de expiracao proxima do kfs_ (service token-list)", "svcwarn" {
    // Medido: o aviso de expiracao proxima existia so para o kfc_
    // (`tokenAccountWarningLine`); o `service token-list` mostrava
    // "expira em <epoch>" cru — epoch nao e legivel e a janela de rotacao
    // (default 7 dias) passava despercebida. Mesma fonte do fio
    // (`limitTokenExpiryWarnMs`), mesmo padrao do irmao.
    var now = 1000000000000L
    var window = limitTokenExpiryWarnMs()

    // Sem TTL ("0"): silencio (nao expira nunca).
    need(serviceTokenExpiryWarning("0", longToString(now)) == "", "falhou")
    need(serviceTokenExpiryWarning("", longToString(now)) == "", "falhou")
    // Vencida: silencio (o inventario nem lista vencida, mas o helper
    // defende).
    need(serviceTokenExpiryWarning(longToString(now - 1), longToString(now)) == "", "falhou")
    // Fora da janela: silencio.
    need(serviceTokenExpiryWarning(longToString(now + window + 1000), longToString(now)) == "", "falhou")
    // Dentro da janela: AVISO com a acao.
    var warn = serviceTokenExpiryWarning(longToString(now + window - 1000), longToString(now))
    need(warn.indexOf("AVISO") >= 0, "falhou")
    need(warn.indexOf("service rotate") >= 0, "falhou")
    need(warn.indexOf("h —") >= 0, "falhou")
}

test "svcwarn: cmdServiceTokenList aplica o aviso (trava de fonte)", "svcwarn" {
    // Os puros cobrem as funcoes; a trava impede o `cmdServiceTokenList`
    // deixar de APLICAR o aviso (o operador pediria a lista e receberia o
    // epoch cru em silencio).
    var raw = File("src/kofcloud/cli/Commands.kf").readText()
    var text = ""
    if (raw != null) {
        text = raw
    }
    if (text.length == 0) {
        return
    }
    var start = text.indexOf("Int cmdServiceTokenList(")
    var end = text.indexOf("// Revoga UMA credencial kfs_", start)
    if (end < 0) {
        end = text.length
    }
    var body = text.substring(start, end)
    need(body.indexOf("serviceTokenExpiryWarning(") >= 0, "falhou")
    // O resumo do `service status` tambem conta as perto do fim: passa o
    // relogio do chamador e usa o mesmo predicado — sem isso, o status
    // voltava a contar "com expiracao" sem dizer qual estava no fim.
    var startStatus = text.indexOf("Int cmdServiceStatus(")
    var endStatus = text.indexOf("Int cmdServiceSuspend(", startStatus)
    if (endStatus < 0) {
        endStatus = text.length
    }
    var bodyStatus = text.substring(startStatus, endStatus)
    need(bodyStatus.indexOf("tokenInventoryLine(entries, longToString(time.now()))") >= 0, "falhou")
}
