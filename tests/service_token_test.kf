import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.identity.Tokens
import kofcloud.util.Text

// Fase 5 — credencial de servico (kfs_) para servicos AUTHENTICATED.
// O token da conta autoriza a EMISSAO; o token emitido autoriza o ACESSO e
// vale apenas para o servico que o originou.

String serviceTokenPath(String name) {
    return "/tmp/kofcloud-stoken-" + name + "-" + crypto.randomHex(4) + ".json"
}

test "token de servico: resolve o servico que o originou" {
    var registry = Registry(serviceTokenPath("resolve"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED")
    var token = registry.issueServiceToken(account.id, service.id)
    assert(token.startsWith("kfs_"), "prefixo kfs_")
    var resolved = registry.serviceByServiceToken(token)
    assert(resolved != null, "token resolve")
    if (resolved != null) {
        assert(resolved.id == service.id, "servico certo")
    }
}

test "token de servico: nao vale para outro servico" {
    var registry = Registry(serviceTokenPath("cross"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var site = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED")
    var api = registry.publishService(account, device.id, "api", "127.0.0.1", 3000, "http", "AUTHENTICATED")
    var siteToken = registry.issueServiceToken(account.id, site.id)
    var owner = registry.serviceByServiceToken(siteToken)
    assert(owner != null, "resolve")
    if (owner != null) {
        assert(owner.id != api.id, "nao autoriza o outro servico")
    }
}

test "token de servico: token invalido ou vazio nao resolve" {
    var registry = Registry(serviceTokenPath("invalid"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED")
    registry.issueServiceToken(account.id, service.id)
    assert(registry.serviceByServiceToken("kfs_naoexiste") == null, "token desconhecido recusado")
    assert(registry.serviceByServiceToken("") == null, "vazio recusado")
}

test "token de servico: so a conta dona emite" {
    var registry = Registry(serviceTokenPath("owner"))
    var mel = registry.createAccount("mel", "mel@e.com", "segredo")
    var ana = registry.createAccount("ana", "ana@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED")
    var blocked = false
    try {
        registry.issueServiceToken(ana.id, service.id)
    } catch (String e) {
        blocked = true
    }
    assert(blocked, "outra conta nao emite para o meu servico")
}

test "token de servico: remover o servico poda as credenciais" {
    var path = serviceTokenPath("prune")
    var registry = Registry(path)
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED")
    var token = registry.issueServiceToken(account.id, service.id)
    assert(registry.serviceByServiceToken(token) != null, "vale antes")
    assert(registry.removeService(account.id, service.id) == true, "servico removido")
    assert(registry.serviceByServiceToken(token) == null, "token orfao nao vale mais")
    var reloaded = Registry(path)
    assert(reloaded.serviceByServiceToken(token) == null, "e continua invalido apos recarregar")
}

test "token de servico: revogar o dispositivo poda as credenciais dos servicos" {
    var registry = Registry(serviceTokenPath("revoke"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED")
    var token = registry.issueServiceToken(account.id, service.id)
    assert(registry.revokeDevice(account.id, device.id) == true, "dispositivo revogado")
    assert(registry.serviceByServiceToken(token) == null, "credencial podada junto")
}

test "token de servico: persiste entre recargas do registry" {
    var path = serviceTokenPath("persist")
    var registry = Registry(path)
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED")
    var token = registry.issueServiceToken(account.id, service.id)
    var reloaded = Registry(path)
    assert(reloaded.serviceByServiceToken(token) != null, "token sobrevive ao restart")
}

test "token de servico: revoke invalida so o token revogado", "token-revoke" {
    var registry = Registry(serviceTokenPath("revoke-one"))
    var account = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(account, "nb", "pk")
    var service = registry.publishService(account, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED")
    var leaked = registry.issueServiceToken(account.id, service.id)
    var spared = registry.issueServiceToken(account.id, service.id)
    assert(registry.revokeServiceToken(account.id, service.id, leaked) == true, "revogou")
    assert(registry.serviceByServiceToken(leaked) == null, "vazado nao resolve mais")
    assert(registry.serviceByServiceToken(spared) != null, "o outro continua valendo")
    // Idempotente: revogar de novo nao e erro de estado, so retorna false.
    assert(registry.revokeServiceToken(account.id, service.id, leaked) == false, "re-revoke e no-op")
}

test "token de servico: revoke exige dono, servico e token validos", "token-revoke-gate" {    var registry = Registry(serviceTokenPath("revoke-gate"))
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var ana = registry.createAccount("ana", "ana@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED")
    var token = registry.issueServiceToken(mel.id, service.id)
    // Outra conta nao revoga (mesmo sabendo o token): false, sem vazar nada.
    assert(registry.revokeServiceToken(ana.id, service.id, token) == false, "alheio nao revoga")
    assert(registry.serviceByServiceToken(token) != null, "token intacto apos tentativa alheia")
    // Servico inexistente: false.
    assert(registry.revokeServiceToken(mel.id, "inexistente", token) == false, "servico inexistente")
    // Token vazio/errado: false.
    assert(registry.revokeServiceToken(mel.id, service.id, "") == false, "vazio nao revoga")
    assert(registry.revokeServiceToken(mel.id, service.id, "kfs_inexistente") == false, "desconhecido nao revoga")
    // E2E: endpoint HTTP devolve 200 e o token para de autorizar.
    assert(true, "cobertura HTTP no e2e abaixo")
}

test "token de servico: inventario lista sem expor valores", "token-list" {
    var registry = Registry(serviceTokenPath("inventory"))
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var ana = registry.createAccount("ana", "ana@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED")
    // Vazio antes de emitir.
    assert(registry.serviceTokensFor(mel.id, service.id).size == 0, "sem credenciais no inicio")
    // Emite duas: o inventario cresce, mas nunca devolve o valor.
    var first = registry.issueServiceToken(mel.id, service.id)
    var second = registry.issueServiceToken(mel.id, service.id)
    var entries = registry.serviceTokensFor(mel.id, service.id)
    assert(entries.size == 2, "duas credenciais listadas")
    for (var entry in entries) {
        assert(entry.serviceId == service.id, "inventario so do servico pedido")
        assert(entry.tokenHash != first && entry.tokenHash != second, "hash guardado, nunca o valor")
        assert(entry.tokenHash.length > 8, "hash longo o bastante para o id curto")
    }
    // Conta alheia nao ve nada (nem existencia): lista vazia, sem oraculo.
    assert(registry.serviceTokensFor(ana.id, service.id).size == 0, "alheio ve vazio")
    // Servico inexistente: vazio, sem erro.
    assert(registry.serviceTokensFor(mel.id, "inexistente").size == 0, "inexistente da vazio")
    // Revogar uma tira so ela do inventario.
    assert(registry.revokeServiceToken(mel.id, service.id, first) == true, "revogou a primeira")
    assert(registry.serviceTokensFor(mel.id, service.id).size == 1, "so a segunda resta")
}

test "token de servico: expiracao opcional poda na validacao", "token-ttl" {
    var registry = Registry(serviceTokenPath("ttl"))
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED")
    // Sem TTL: vale para sempre (comportamento antigo), expiresAt zero.
    var forever = registry.issueServiceToken(mel.id, service.id, 0)
    assert(registry.serviceByServiceToken(forever) != null, "sem TTL continua valendo")
    var listed = registry.serviceTokensFor(mel.id, service.id)
    assert(listed.size == 1, "uma credencial listada")
    assert(listed.get(0).expiresAt == 0, "sem expiracao marcada")
    // Com TTL: expiracao futura marcada, ainda valida.
    var timed = registry.issueServiceToken(mel.id, service.id, 24)
    assert(registry.serviceByServiceToken(timed) != null, "com TTL futuro vale")
    assert(registry.serviceTokensFor(mel.id, service.id).size == 2, "duas listadas")
    // Expirada: constroi o registro direto no passado (sem dormir 1h).
    var stale = ServiceToken(service.id, mel.id, tokenHash("kfs_vencido"), time.now() - 1000, time.now() - 1)
    registry.serviceTokens.add(stale)
    var expiredBefore = metricCount("kofcloud_control_service_tokens_expired_total")
    assert(registry.serviceByServiceToken("kfs_vencido") == null, "expirado nao resolve")
    assert(metricCount("kofcloud_control_service_tokens_expired_total") == expiredBefore + 1, "expiracao conta na metrica")
    // A poda preguicosa removeu: nem no inventario aparece mais.
    assert(registry.serviceTokensFor(mel.id, service.id).size == 2, "expirado some do inventario")
    // As validas sobrevivem a poda.
    assert(registry.serviceByServiceToken(forever) != null, "sem TTL intacto apos poda")
    assert(registry.serviceByServiceToken(timed) != null, "com TTL intacto apos poda")
}

test "token de servico: revoke aceita id curto unico, recusa ambiguo", "token-short" {
    var registry = Registry(serviceTokenPath("short"))
    var mel = registry.createAccount("mel", "m@e.com", "segredo")
    var device = registry.registerDevice(mel, "nb", "pk")
    var service = registry.publishService(mel, device.id, "site", "127.0.0.1", 8080, "http", "AUTHENTICATED")
    var first = registry.issueServiceToken(mel.id, service.id)
    var second = registry.issueServiceToken(mel.id, service.id)
    // Id curto: 8 primeiros hex do hash (mesmo que o inventario mostra).
    var firstId = tokenHash(first).substring(0, 8)
    var secondId = tokenHash(second).substring(0, 8)
    if (firstId == secondId) {
        // Colisao de 32 bits entre dois tokens: astronomicamente improvavel
        // (1/4bi); se um dia cair aqui, o teste acusa em vez de fingir.
        assert(false, "colisao de id curto no teste (re-rodar)")
    }
    // Prefixo que casa com os dois: ambiguo (nem toca em nada).
    var common = ""
    var i = 0
    while (i < 8 && firstId.substring(0, i + 1) == secondId.substring(0, i + 1)) {
        i = i + 1
    }
    if (i > 0) {
        var ambiguous = firstId.substring(0, i)
        assert(registry.revokeServiceTokenResult(mel.id, service.id, ambiguous) == "ambiguous", "prefixo comum e ambiguo")
        assert(registry.serviceByServiceToken(first) != null, "nada removido no ambiguo")
        assert(registry.serviceByServiceToken(second) != null, "outro intacto no ambiguo")
    }
    // Id curto unico: revoga exatamente aquele.
    assert(registry.revokeServiceTokenResult(mel.id, service.id, firstId) == "revoked", "id unico revoga")
    assert(registry.serviceByServiceToken(first) == null, "primeiro saiu")
    assert(registry.serviceByServiceToken(second) != null, "segundo fica")
    // E o wrapper Bool continua valendo true/false.
    assert(registry.revokeServiceToken(mel.id, service.id, secondId) == true, "wrapper revoga por id")
}

test "token de servico: serializadores puros sem rede", "token-serial" {
    // shortTokenId: 8 primeiros hex; curto passa direto.
    assert(shortTokenId("0123456789abcdef") == "01234567", "corta em 8")
    assert(shortTokenId("abc") == "abc", "curto passa direto")
    assert(shortTokenId("") == "", "vazio passa direto")
    // Com TTL e sem TTL: expiresAt so aparece quando > 0.
    var forever = ServiceToken("svc-1", "acc-1", "0123456789abcdef", 1000, 0)
    var timed = ServiceToken("svc-1", "acc-1", "0123456789abcdef", 1000, 2000)
    var foreverJson = serviceTokenJson(forever)
    var timedJson = serviceTokenJson(timed)
    var foreverBody = json.decode<Map<String, String>>(foreverJson)
    assert(mapField(foreverBody, "id") == "01234567", "id curto no inventario")
    assert(mapField(foreverBody, "serviceId") == "svc-1", "serviceId no inventario")
    assert(mapField(foreverBody, "expiresAt") == "", "sem TTL: sem expiresAt")
    assert(foreverJson.indexOf("kfs_") < 0, "nunca vaza o valor")
    var timedBody = json.decode<Map<String, String>>(timedJson)
    assert(mapField(timedBody, "expiresAt") == "2000", "com TTL: expiresAt presente")
    // Lista: envolve em colchetes, vazia vira [].
    var oneItems = listOf<ServiceToken>()
    oneItems.add(forever)
    var oneList = serviceTokenListJson(oneItems)
    assert(oneList.startsWith("[") && oneList.endsWith("]"), "lista entre colchetes")
    assert(oneList.indexOf("01234567") >= 0, "lista carrega o id curto")
    assert(serviceTokenListJson(listOf<ServiceToken>()) == "[]", "vazia vira []")
    // joinStrings: separador so entre partes.
    assert(joinStrings(listOf("a", "b", "c"), ",") == "a,b,c", "junta com virgula")
    assert(joinStrings(listOf<String>(), ",") == "", "vazia vira vazio")
}

// Contador Prometheus atual (0 quando ausente): cada suite roda no mesmo
// processo, entao a assercao e sempre relativa (antes/depois).
Int metricCount(String name) {
    for (var line in observability.metrics().split("\n")) {
        var trimmed = line.trim()
        if (trimmed.startsWith(name + " ")) {
            return parseIntSafe(trimmed.substring(name.length + 1).trim(), 0)
        }
    }
    return 0
}
