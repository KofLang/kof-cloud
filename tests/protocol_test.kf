
import kofcloud.protocol.Bytes
import kofcloud.protocol.Frame
import kofcloud.protocol.LineCodec
import kofcloud.protocol.Session
import kofcloud.protocol.Tunnel
import kofcloud.protocol.Version

test "framing: linha completa e resto parcial" {
    var codec = LineCodec()
    codec.feed(bytesFromString("{\"t\":\"PING\"}\n{\"t\":\"P"))
    var first = codec.nextLine()
    assert(first == "{\"t\":\"PING\"}", "primeira linha")
    assert(codec.nextLine() == "", "segunda incompleta")
    assert(codec.remainder() == "{\"t\":\"P", "resto guardado")
}

test "framing: linha partida em dois feeds" {
    var codec = LineCodec()
    codec.feed(bytesFromString("{\"t\":\"DA"))
    assert(codec.hasLine() == false, "sem linha ainda")
    codec.feed(bytesFromString("TA\"}\n"))
    assert(codec.nextLine() == "{\"t\":\"DATA\"}", "remontada")
}

test "bytes: base64 preserva bytes altos" {
    var data = new Byte[4]
    data[0] = 0
    data[1] = 200
    data[2] = 255
    data[3] = 10
    var back = bytesFromBase64(bytesToBase64(data))
    assert(back.length == 4, "tamanho")
    var ok = true
    for (var i = 0; i < data.length; i++) {
        if (data[i] != back[i]) {
            ok = false
        }
    }
    assert(ok, "byte preserving")
}

test "bytes: base64 e byte-exato (4/3, sem expansao UTF-8)" {
    // O caminho antigo (bytesToString + encoding.base64Encode do stdlib)
    // empacotava o byte alto como UTF-8 e inflava a saida; o base64 proprio
    // mapeia cada byte a um valor da tabela, entao o tamanho e 4*ceil(n/3).
    var data = new Byte[3]
    data[0] = 0
    data[1] = -56
    data[2] = -1
    assert(bytesToBase64(data) == "AMj/", "tabela RFC 4648, byte a byte")
    var big = new Byte[9000]
    for (var i = 0; i < 9000; i++) {
        big[i] = (i % 251) as Byte
    }
    var encoded = bytesToBase64(big)
    assert(encoded.length == 12000, "9000 bytes -> 12000 chars")
    assert(bytesToString(bytesFromBase64(encoded)) == bytesToString(big), "ida e volta")
    // padding identico ao stdlib nas bordas de 1 e 2 bytes
    var one = new Byte[1]
    one[0] = 65
    assert(bytesToBase64(one) == "QQ==", "1 byte")
    var two = new Byte[2]
    two[0] = 65
    two[1] = 66
    assert(bytesToBase64(two) == "QUI=", "2 bytes")
    assert(bytesToBase64(bytesEmpty()) == "", "vazio")
}

test "bytes: base64 decodifica tolerante (ignora invalido, para no '=')" {
    assert(bytesToString(bytesFromBase64("TWFu\n")) == "Man", "espaco em branco ignorado")
    assert(bytesToString(bytesFromBase64("TQ==")) == "M", "1 byte com padding")
    assert(bytesToString(bytesFromBase64("TWE=")) == "Ma", "2 bytes com padding")
    assert(bytesFromBase64("").length == 0, "vazio")
}

test "bytes: concat e slice" {
    var a = bytesFromString("abc")
    var b = bytesFromString("de")
    var joined = bytesConcat(a, b)
    assert(joined.length == 5, "concatenado")
    assert(bytesToString(bytesSlice(joined, 1, 4)) == "bcd", "slice")
}

test "bytes: indice de substring" {
    var data = bytesFromString("GET / HTTP/1.1\r\n\r\nbody")
    assert(bytesIndexOf(data, "\r\n\r\n", 0) == 14, "fim dos headers")
    assert(bytesIndexOf(data, "zzz", 0) == -1, "ausente")
}

test "frame: encode tem terminador e decode volta" {
    var frame = newFrame("DATA")
    frame.put("s", "7")
    frame.put("d", "aGk=")
    var line = encodeFrame(frame)
    assert(line.endsWith("\n"), "terminador")
    var back = decodeFrame(line.substring(0, line.length - 1))
    assert(frameKind(back) == "DATA", "kind")
    assert(frameInt(back, "s") == 7, "stream id")
    assert(frameField(back, "d") == "aGk=", "payload")
}


test "frame: inteiro do fio nao sofre wrap de Int", "frame-int" {
    // `parseIntSafe` acumula em 32 bits: um HELLO com `v: 4294967297` virava 1
    // e passava a checagem de versao; um heartbeat forjado virava 1500 ms e
    // encurtava o laco do Agent. Fora de [0, Int.MAX] = 0, que os chamadores
    // ja tratam como "ausente".
    var forged = newFrame("HELLO")
    forged.put("v", "4294967297")
    assert(frameInt(forged, "v") == 0, "versao forjada nao vira 1")
    var hb = newFrame("WELCOME")
    hb.put("heartbeatMs", "4294968796")
    assert(frameInt(hb, "heartbeatMs") == 0, "heartbeat forjado nao vira 1500")
    var big = newFrame("X")
    big.put("n", "2147483648")
    assert(frameInt(big, "n") == 0, "acima de Int.MAX")
    var top = newFrame("X")
    top.put("n", "2147483647")
    assert(frameInt(top, "n") == 2147483647, "Int.MAX cabe")
    var neg = newFrame("X")
    neg.put("n", "-1")
    assert(frameInt(neg, "n") == 0, "negativo = 0")
    var missing = newFrame("X")
    assert(frameInt(missing, "n") == 0, "ausente = 0")
    var normal = newFrame("DATA")
    normal.put("s", "7")
    assert(frameInt(normal, "s") == 7, "stream id normal")
}

test "tunnel: hello carrega versao e identidade" {
    var frame = helloFrame("dev-1", "tok-1", "pub-1")
    assert(frameKind(frame) == "HELLO", "kind")
    assert(frameInt(frame, "v") == protocolVersion(), "versao")
    assert(frameField(frame, "deviceId") == "dev-1", "device")
    assert(frameField(frame, "token") == "tok-1", "token")
}

test "tunnel: welcome distingue aceito de recusado", "welcome-reasons" {
    var ok = welcomeFrame(true, "", "sess-1", "srv-pub", 15000)
    assert(frameBool(ok, "ok") == true, "aceito")
    assert(frameField(ok, "sessionId") == "sess-1", "sessao")
    var no = welcomeFrame(false, "DEVICE_REVOKED", "", "", 0)
    assert(frameBool(no, "ok") == false, "recusado")
    assert(frameField(no, "reason") == "DEVICE_REVOKED", "motivo")
    // Todos os motivos de recusa do handshake viajam no mesmo campo
    // (Edge recusa em Tunnel.kf; Agent decide fatal em isFatal).
    for (var reason in listOf("VERSION_UNSUPPORTED", "DEVICE_UNKNOWN", "AUTH_FAILED", "DEVICE_SUSPENDED")) {
        var refused = welcomeFrame(false, reason, "", "", 0)
        assert(frameField(refused, "reason") == reason, reason + " preservado")
    }
}

test "session: abre stream e roteia payload" {
    var session = TunnelSession("s1", "d1", "a1", "")
    var streamId = session.openStream()
    assert(session.streamCount() == 1, "um stream")
    session.deliver(streamId, "payload-a")
    assert(session.nextFromStream(streamId) == "payload-a", "entregue")
    session.closeStream(streamId)
    assert(session.streamCount() == 0, "fechado")
}

test "session: streams sao independentes" {
    var session = TunnelSession("s1", "d1", "a1", "")
    var a = session.openStream()
    var b = session.openStream()
    assert(a != b, "ids distintos")
    session.deliver(b, "para-b")
    session.deliver(a, "para-a")
    assert(session.nextFromStream(a) == "para-a", "a recebe o seu")
    assert(session.nextFromStream(b) == "para-b", "b recebe o seu")
}

test "opened: handshake por stream distingue aceito de recusado", "opened-reasons" {
    var ok = openedFrame("7", true, "")
    assert(frameKind(ok) == "OPENED", "tipo")
    assert(openedAccepted(openedMarker(ok)), "aceito")
    var no = openedFrame("7", false, "SERVICE_UNKNOWN")
    assert(openedAccepted(openedMarker(no)) == false, "recusado")
    assert(openedReason(openedMarker(no)) == "SERVICE_UNKNOWN", "motivo preservado")
    assert(openedReason("!OPEN:ok") == "", "aceito nao tem motivo")
    // Códigos de erro de stream/sessao viajam nos mesmos campos
    // (RESET.code no relay/idle; GOAWAY.code no encerramento).
    var reset = resetFrame("3", "IDLE_TIMEOUT")
    assert(frameKind(reset) == "RESET", "tipo reset")
    assert(frameField(reset, "code") == "IDLE_TIMEOUT", "codigo preservado")
    var goaway = goawayFrame("SHUTDOWN")
    assert(frameKind(goaway) == "GOAWAY", "tipo goaway")
    assert(frameField(goaway, "code") == "SHUTDOWN", "codigo goaway")
}
