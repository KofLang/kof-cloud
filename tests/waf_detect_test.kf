import kofcloud.agent.Agent
import kofcloud.control.ControlPlane
import kofcloud.control.Registry
import kofcloud.edge.EdgeState
import kofcloud.edge.HttpFront
import kofcloud.edge.Http
import kofcloud.edge.Tunnel
import kofcloud.model.Errors
import kofcloud.store.Store
import kofcloud.util.Limits
import kofcloud.util.Text
import testkit.Support

// WAF slice 1 (Fase 10) — detectar e enforce: o Edge inspeciona metodo+path
// e CONTA por padrao nos dois modos. Default (detectar) segue com o relay
// (nenhum legitimo quebra); com enforce ligado casa vira 403 KCF109 antes
// do relay, sem stream e sem tocar no Agent.

test "waf detectar: assinaturas puras por padrao", "wafdetect-unit" {
    // Cada padrao tem nome proprio (e o unico dado que chega a metrica).
    assert(wafDetectSignature("GET", "/files/../../etc/passwd") == "traversal", "traversal ../")
    assert(wafDetectSignature("GET", "/x/..%2f..%2fsecret") == "traversal", "traversal codificado")
    assert(wafDetectSignature("GET", "/x%00y") == "nullbyte", "null byte")
    assert(wafDetectSignature("GET", "/search?q=UNION SELECT * FROM users") == "sqli-union", "union select")
    assert(wafDetectSignature("GET", "/login?u=x' OR 1=1--") == "sqli-tautology", "or 1=1")
    assert(wafDetectSignature("GET", "/q=<script>alert(1)</script>") == "xss-script", "script em query")
    // Caixa nao importa; metodo entra na inspecao.
    assert(wafDetectSignature("get", "/Q=<SCRIPT>") == "xss-script", "caixa mista")
    // Limpo nao conta.
    assert(wafDetectSignature("GET", "/") == "", "raiz limpa")
    assert(wafDetectSignature("GET", "/api/users?page=2") == "", "query legitima")
    assert(wafDetectSignature("POST", "/echo") == "", "post legitimo")
    // KCF109 existe e tem Hint (o enforce usa esse codigo).
    assert(errWafDenied().indexOf("KCF109") >= 0, "codigo KCF109")
    assert(errHint(errWafDenied()).length > 0, "tem Hint")
}

test "waf detectar: payload percent/form-encoded vira assinatura", "wafencoded-unit" {
    // O buraco documentado em 17-limitations: as assinaturas eram literais,
    // entao `%2e%2e%2f` e `union+select` passavam. Uma passada de decode
    // bounded resolve os scanners reais sem varrer bytes por byte.
    assert(wafDetectSignature("GET", "/x/%2e%2e%2f%2e%2e%2fetc/passwd") == "traversal", "traversal %2e%2e%2f")
    assert(wafDetectSignature("GET", "/x/..%5C..%5Cwin") == "traversal", "traversal %5C (backslash decodificado)")
    assert(wafDetectSignature("GET", "/search?q=union+select+pw") == "sqli-union", "union+select em query")
    assert(wafDetectSignature("GET", "/q=%3Cscript%3Ealert(1)") == "xss-script", "xss %3C decodificado")
    assert(wafDetectSignature("GET", "/login?u=x%27+OR+1%3D1--") == "sqli-tautology", "tautologia form-encoded")
    assert(wafDetectBodySignature("q=%2e%2e%2f%2e%2e%2fetc%2fpasswd") == "traversal", "traversal no corpo")
    assert(wafDetectBodySignature("u=union+select+1") == "sqli-union", "union+select no corpo")
    // Hexaceimal invalido fica como esta: nao inventa ataque nem quebra.
    assert(wafDetectSignature("GET", "/x/%zz%2") == "", "escape invalido nao casa")
    assert(wafDetectSignature("GET", "/x/%2541") == "", "percent literal (%25) nao abre cadeia")
    // Uma passada so: dupla codificacao NAO e desfeita em cadeia (sem
    // falso positivo caro e sem custo recursivo).
    assert(wafDetectSignature("GET", "/x/%252e%252e%252f") == "", "dupla codificacao nao decodifica em cadeia")
    // Legitimo com encoding continua limpo: espaco, acento e `+` de query.
    assert(wafDetectSignature("GET", "/search?q=nota+fiscal") == "", "query legitima com +")
    assert(wafDetectSignature("GET", "/busca?q=caf%C3%A9") == "", "utf-8 percent legitimo")
    assert(wafDetectSignature("GET", "/api/users?page=2") == "", "query numerica")
    // Decoder puro: bordas de buffer circular (padrao no inicio/fim/atravessa).
    assert(wafDecodedContains("ab%20cd", "ab cd", false) == true, "match atravessando o ring")
    assert(wafDecodedContains("%2e%2e%2f", "../", false) == true, "match exato no inicio")
    assert(wafDecodedContains("x%2e%2e%2f", "../", false) == true, "match no fim")
    assert(wafDecodedContains("abc", "../", false) == false, "sem match")
    assert(wafDecodedContains("a+b", "a b", true) == true, "+ vira espaco quando ligado")
    assert(wafDecodedContains("a+b", "a b", false) == false, "+ literal quando desligado")
    assert(wafHexValue('f' as Char) == 15 && wafHexValue('A' as Char) == 10 && wafHexValue('g' as Char) == -1, "hex")
}

test "waf allowlist: matcher puro de metodos e paths", "wafallow-unit" {
    // Listas vazias = sem restricao (servico legado passa tudo).
    assert(wafAllowCheck("GET", "/", listOf<String>(), listOf<String>()) == true, "vazio libera")
    assert(wafAllowCheck("DELETE", "/admin", listOf<String>(), listOf<String>()) == true, "vazio libera tudo")
    // Metodo: casa exato, resto barra.
    var methods = listOf<String>()
    methods.add("GET")
    methods.add("POST")
    assert(wafAllowCheck("GET", "/qualquer", methods, listOf<String>()) == true, "metodo listado passa")
    assert(wafAllowCheck("POST", "/qualquer", methods, listOf<String>()) == true, "segundo metodo passa")
    assert(wafAllowCheck("DELETE", "/qualquer", methods, listOf<String>()) == false, "metodo fora barra")
    assert(wafAllowCheck("get", "/qualquer", methods, listOf<String>()) == false, "metodo e case-sensitive")
    // Path: exato ou prefixo /*; query ignorada; /api2 nao e /api/*.
    var paths = listOf<String>()
    paths.add("/api/*")
    paths.add("/health")
    assert(wafAllowCheck("GET", "/api/users", listOf<String>(), paths) == true, "prefixo casa")
    assert(wafAllowCheck("GET", "/api/users?page=2", listOf<String>(), paths) == true, "query ignorada")
    assert(wafAllowCheck("GET", "/health", listOf<String>(), paths) == true, "exato casa")
    assert(wafAllowCheck("GET", "/api2", listOf<String>(), paths) == false, "prefixo parcial nao casa")
    assert(wafAllowCheck("GET", "/outro", listOf<String>(), paths) == false, "fora da lista barra")
    // Combinado: metodo E path precisam passar.
    assert(wafAllowCheck("GET", "/api/users", methods, paths) == true, "ambos passam")
    assert(wafAllowCheck("DELETE", "/api/users", methods, paths) == false, "metodo barra mesmo com path ok")
    assert(wafAllowCheck("GET", "/outro", methods, paths) == false, "path barra mesmo com metodo ok")
}

test "waf detectar: ataque conta mas passa; legitimo nao conta", "wafdetect" {
    var localSvc = 19761
    var controlPort = 19762
    var tunnelPort = 19763
    var httpPort = 19764

    // Servidor TCP cru de proposito: o web.app() do runtime fecha a conexao
    // sem headers para paths com `..` (medido em probe) — e o que esta em
    // prova e a deteccao no Edge, nao o web server. Responde 200 a qualquer
    // path (eco do path no corpo, para provar que o relay completou).
    var localListener = net.listen(localSvc)
    var localServer = spawn {
        var serving = true
        while (serving) {
            try {
                var peer = localListener.accept()
                var worker = spawn { serveDetectPeer(peer) }
            } catch (String e) {
                serving = false
            }
        }
    }
    assert(waitForPort(localSvc, 60), "servico local no ar")

    var registry = Registry("/tmp/kofcloud-wafdetect-" + crypto.randomHex(4) + ".json")
    var edgeState = EdgeState(registry)
    var edgeStop = "/tmp/kofcloud-wafdetect-edge-" + crypto.randomHex(4) + ".txt"
    var agentStop = "/tmp/kofcloud-wafdetect-agent-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    File(agentStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, "", edgeStop) }
    var httpTask = spawn { serveHttp(edgeState, httpPort, limitMaxBodyBytes(), edgeStop) }
    assert(waitForPort(controlPort, 60), "control no ar")
    assert(waitForPort(tunnelPort, 60), "tunel no ar")
    assert(waitForPort(httpPort, 60), "http no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var account = json.decode<Map<String, String>>(bodyOf(created))
    var accountToken = mapField(account, "token")
    var accountId = mapField(account, "accountId")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pubkey\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"" + intToString(localSvc) + "\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    assert(statusOf(httpPostJson(controlPort, "/v1/services", pubBody, accountToken)) == 200, "PUBLIC publicado")

    var config = AgentConfig("http://127.0.0.1:" + intToString(controlPort), deviceId, accountId, accountToken, "", agentStop, "127.0.0.1", tunnelPort, 100)
    var agentTask = spawn { runAgent(config, true) }
    var online = false
    var attempts = 100
    while (attempts > 0 && online == false) {
        online = edgeState.isOnline(deviceId)
        if (online == false) {
            time.sleep(50)
            attempts = attempts - 1
        }
    }
    assert(online, "agent online")

    var host = "site.mel.kofcloud.io"
    // Linha de base: legitimo passa e ainda nao contou nada.
    assert(bodyOf(httpGetRaw(httpPort, "/", host)) == "svc-detect", "GET segue funcionando")
    assert(metricValue(observability.metrics(), "kofcloud_edge_waf_detected_total") == -1, "nada contado antes do ataque")

    // Ataque em modo detectar: CONTA mas passa (200, chega no servico),
    // marcado com would-block (o enforce bloquearia sem quebrar nada hoje).
    var evil = httpGetRaw(httpPort, "/files/../../etc/passwd", host)
    assert(statusOf(evil) == 200, "detectar nao bloqueia")
    assert(responseHeader(evil, "X-KofCloud-WAF") == "would-block", "detectar marca would-block")
    assert(metricValue(observability.metrics(), "kofcloud_edge_waf_detected_total") >= 1, "deteccao contada")
    assert(metricValue(observability.metrics(), "kofcloud_edge_waf_detected_total_traversal") >= 1, "padrao traversal contado")

    // Legitimo depois do ataque: segue 200, sem contar de novo e sem marca.
    var clean = httpGetRaw(httpPort, "/", host)
    assert(bodyOf(clean) == "svc-detect", "legitimo segue 200")
    assert(responseHeader(clean, "X-KofCloud-WAF") == "", "legitimo sem marca")

    // Ataque em HEADER (faltava: so path e corpo eram vistos). Detecta e
    // segue, marcado — o valor do header nunca aparece na resposta nem na
    // metrica, so o nome do padrao.
    var headerAttack = httpGetRawHeaders(httpPort, "/", host, listOf<String>("User-Agent: sqlmap/1.7 (UNION SELECT password FROM users)"))
    assert(statusOf(headerAttack) == 200, "detectar nao bloqueia header")
    assert(responseHeader(headerAttack, "X-KofCloud-WAF") == "would-block", "header marcado would-block")
    assert(metricValue(observability.metrics(), "kofcloud_edge_waf_detected_total_sqli_union") >= 1, "padrao do header contado")

    // Header legitimo (o mesmo tipo que o navegador manda) nao conta.
    var baselineHeaders = metricValue(observability.metrics(), "kofcloud_edge_waf_detected_total")
    var okHeaders = httpGetRawHeaders(httpPort, "/", host, listOf<String>("User-Agent: Mozilla/5.0 (X11; Linux x86_64)", "Cookie: sess=abc123; theme=dark"))
    assert(statusOf(okHeaders) == 200, "headers legitimos 200")
    assert(metricValue(observability.metrics(), "kofcloud_edge_waf_detected_total") == baselineHeaders, "headers legitimos nao contam")

    // Parada limpa.
    writeTextTo(agentStop, "stop")
    time.sleep(1500)
    writeTextTo(edgeStop, "stop")
    time.sleep(1000)
    File(agentStop).delete()
    File(edgeStop).delete()
    localListener.close()
}

test "waf enforce: ataque vira 403 KCF109 sem tocar no relay; legitimo passa", "wafenforce" {
    var localSvc = 19781
    var controlPort = 19782
    var tunnelPort = 19783
    var httpPort = 19784

    // Servidor TCP cru (mesmo motivo do detectar: o web.app() do runtime
    // fecha a conexao sem headers para paths com `..`, e o que esta em
    // prova e o Edge, nao o web server). Conta quantas requisicoes chegam
    // ao local: com enforce, o ataque NUNCA chega.
    var localListener = net.listen(localSvc)
    var reached = new Int[1]
    reached[0] = 0
    var localServer = spawn {
        var serving = true
        while (serving) {
            try {
                var peer = localListener.accept()
                var worker = spawn { serveEnforcePeer(peer, reached) }
            } catch (String e) {
                serving = false
            }
        }
    }
    assert(waitForPort(localSvc, 60), "servico local no ar")

    var registry = Registry("/tmp/kofcloud-wafenforce-" + crypto.randomHex(4) + ".json")
    var edgeState = EdgeState(registry)
    edgeState.setWafEnforce(true)
    var edgeStop = "/tmp/kofcloud-wafenforce-edge-" + crypto.randomHex(4) + ".txt"
    var agentStop = "/tmp/kofcloud-wafenforce-agent-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    File(agentStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, "", edgeStop) }
    var httpTask = spawn { serveHttp(edgeState, httpPort, limitMaxBodyBytes(), edgeStop) }
    assert(waitForPort(controlPort, 60), "control no ar")
    assert(waitForPort(tunnelPort, 60), "tunel no ar")
    assert(waitForPort(httpPort, 60), "http no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var account = json.decode<Map<String, String>>(bodyOf(created))
    var accountToken = mapField(account, "token")
    var accountId = mapField(account, "accountId")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pubkey\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"" + intToString(localSvc) + "\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    assert(statusOf(httpPostJson(controlPort, "/v1/services", pubBody, accountToken)) == 200, "PUBLIC publicado")

    var config = AgentConfig("http://127.0.0.1:" + intToString(controlPort), deviceId, accountId, accountToken, "", agentStop, "127.0.0.1", tunnelPort, 100)
    var agentTask = spawn { runAgent(config, true) }
    var online = false
    var attempts = 100
    while (attempts > 0 && online == false) {
        online = edgeState.isOnline(deviceId)
        if (online == false) {
            time.sleep(50)
            attempts = attempts - 1
        }
    }
    assert(online, "agent online")

    var host = "site.mel.kofcloud.io"
    // Legitimo passa mesmo com enforce ligado.
    assert(bodyOf(httpGetRaw(httpPort, "/", host)) == "svc-detect", "legitimo passa no enforce")
    assert(reached[0] >= 1, "legitimo chegou ao local")

    // Ataque vira 403 KCF109 ANTES do relay: o local nao ve nada alem do
    // que ja viu (o legitimo acima).
    var seenBefore = reached[0]
    var evil = httpGetRaw(httpPort, "/files/../../etc/passwd", host)
    assert(statusOf(evil) == 403, "enforce bloqueia")
    assert(bodyOf(evil).indexOf("KCF109") >= 0, "KCF109 no corpo")
    assert(responseHeader(evil, "X-KofCloud-WAF") == "blocked", "enforce marca blocked")
    assert(reached[0] == seenBefore, "ataque nao chegou ao local")
    assert(metricValue(observability.metrics(), "kofcloud_edge_waf_detected_total_traversal") >= 1, "padrao contado")
    assert(metricValue(observability.metrics(), "kofcloud_edge_http_denied_total_waf_denied") >= 1, "negada contada")

    // Legitimo depois do ataque: segue 200.
    assert(bodyOf(httpGetRaw(httpPort, "/", host)) == "svc-detect", "legitimo segue 200")

    // Ataque em header com enforce: 403 KCF109 antes do relay (o local nao
    // recebe mais nada alem do que ja recebeu).
    var seenBeforeHeader = reached[0]
    var evilHeader = httpGetRawHeaders(httpPort, "/", host, listOf<String>("X-Probe: ' OR 1=1--"))
    assert(statusOf(evilHeader) == 403, "enforce bloqueia header")
    assert(bodyOf(evilHeader).indexOf("KCF109") >= 0, "KCF109 no corpo do header")
    assert(responseHeader(evilHeader, "X-KofCloud-WAF") == "blocked", "header marcado blocked")
    assert(reached[0] == seenBeforeHeader, "ataque em header nao chegou ao local")
    assert(metricValue(observability.metrics(), "kofcloud_edge_waf_detected_total_sqli_tautology") >= 1, "padrao do header contado")

    // Header legitimo segue passando com enforce ligado.
    assert(statusOf(httpGetRawHeaders(httpPort, "/", host, listOf<String>("User-Agent: Mozilla/5.0"))) == 200, "header legitimo passa no enforce")

    // Payload percent/form-encoded (o buraco das assinaturas literais):
    // bloqueado antes do relay, como o cru. O local continua sem ver nada.
    var seenBeforeEncoded = reached[0]
    var encoded = httpGetRaw(httpPort, "/api?q=%2e%2e%2f%2e%2e%2fetc%2fpasswd", host)
    assert(statusOf(encoded) == 403, "enforce bloqueia traversal percent")
    assert(bodyOf(encoded).indexOf("KCF109") >= 0, "KCF109 no encoded")
    assert(responseHeader(encoded, "X-KofCloud-WAF") == "blocked", "encoded marcado blocked")
    assert(reached[0] == seenBeforeEncoded, "payload encoded nao chegou ao local")
    assert(metricValue(observability.metrics(), "kofcloud_edge_waf_detected_total_traversal") >= 2, "traversal encoded contado")
    var encodedSqli = httpGetRaw(httpPort, "/api?q=union+select+pw", host)
    assert(statusOf(encodedSqli) == 403, "enforce bloqueia union+select")
    assert(metricValue(observability.metrics(), "kofcloud_edge_waf_detected_total_sqli_union") >= 1, "union encoded contado")
    // Encoding legitimo continua passando (senao o WAF quebraria busca real).
    assert(bodyOf(httpGetRaw(httpPort, "/busca?q=nota+fiscal", host)) == "svc-detect", "query legitima com + passa")
    assert(bodyOf(httpGetRaw(httpPort, "/busca?q=caf%C3%A9", host)) == "svc-detect", "utf-8 percent legitimo passa")
    assert(statusOf(httpGetRawHeaders(httpPort, "/", host, listOf<String>("Referer: https://x/?a=1%2Fb"))) == 200, "percent legado no header passa")

    // Parada limpa.
    writeTextTo(agentStop, "stop")
    time.sleep(1500)
    writeTextTo(edgeStop, "stop")
    time.sleep(1000)
    File(agentStop).delete()
    File(edgeStop).delete()
    localListener.close()
}

// Peer contador para o enforce: responde 200 constante (como o detectar)
// mas so marca o que passou PELO RELAY. Health check do Agent virou um
// `GET /` de verdade (agent/Health.kf, Fase 4): ele tambem chega aqui, e
// conta-lo corromperia `reached` no meio das assercoes (o probe roda em
// outra task e pode cair entre `seenBefore = reached[0]` e o `assert`).
// O Edge assina o relay com `X-Forwarded-For: edge`; o probe nao tem esse
// header. Distinguir pelo header e deterministico; contar por tempo nao e.
void serveEnforcePeer(Conn peer, Int[] reached) {
    var req = ""
    var reading = true
    while (reading) {
        var chunk = peer.receive(4096)
        if (chunk.length == 0) {
            reading = false
        } else {
            req = req + bytesToString(chunk)
            if (req.indexOf("\r\n\r\n") >= 0) {
                reading = false
            }
        }
    }
    if (req.length > 0 && req.indexOf("HTTP/") >= 0) {
        if (req.toLowerCase().indexOf("x-forwarded-for:") >= 0) {
            reached[0] = reached[0] + 1
        }
        var body = "svc-detect"
        var head = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: " + body.length + "\r\nConnection: close\r\n\r\n"
        peer.send(bytesFromString(head + body))
    }
    peer.close()
}

// Um peer do servidor cru: le ate o fim dos headers (ou EOF, caso do
// health check TCP que so conecta e fecha) e responde 200 constante a
// qualquer requisicao real. O corpo fixo prova que o relay completou;
// a deteccao vive na metrica do Edge, nao aqui.
void serveDetectPeer(Conn peer) {
    var req = ""
    var reading = true
    while (reading) {
        var chunk = peer.receive(4096)
        if (chunk.length == 0) {
            reading = false
        } else {
            req = req + bytesToString(chunk)
            if (req.indexOf("\r\n\r\n") >= 0) {
                reading = false
            }
        }
    }
    if (req.length > 0 && req.indexOf("HTTP/") >= 0) {
        var body = "svc-detect"
        var head = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: " + body.length + "\r\nConnection: close\r\n\r\n"
        peer.send(bytesFromString(head + body))
    }
    peer.close()
}

Int metricValue(String exposition, String name) {
    for (var line in exposition.split("\n")) {
        var trimmed = line.trim()
        if (trimmed.startsWith(name + " ")) {
            return parseIntSafe(trimmed.substring(name.length + 1).trim(), -1)
        }
    }
    return -1
}

test "waf detectar: valores de header completam a cobertura", "wafheader-unit" {
    // O padrao vale igual em path, corpo e header (lista unica): um ataque
    // escondido em User-Agent/Referer/Cookie nao passa mais em claro.
    var agent = listOf<String>()
    agent.add("User-Agent: sqlmap/1.7 (UNION SELECT password FROM users)")
    assert(wafDetectHeadersSignature(agent) == "sqli-union", "union no User-Agent")
    var referer = listOf<String>()
    referer.add("Referer: http://x/<script>alert(1)</script>")
    assert(wafDetectHeadersSignature(referer) == "xss-script", "xss no Referer")
    var cookie = listOf<String>()
    cookie.add("Cookie: sess=../../etc/passwd")
    assert(wafDetectHeadersSignature(cookie) == "traversal", "traversal no Cookie")
    var xff = listOf<String>()
    xff.add("X-Custom: a%00b")
    assert(wafDetectHeadersSignature(xff) == "nullbyte", "null byte em header custom")

    // Legitimo nao casa (nomes e valores comuns).
    var clean = listOf<String>()
    clean.add("Host: site.mel.kofcloud.io")
    clean.add("User-Agent: Mozilla/5.0 (X11; Linux x86_64)")
    clean.add("Accept: text/html,application/xhtml+xml")
    clean.add("Cookie: sess=abc123; theme=dark")
    assert(wafDetectHeadersSignature(clean) == "", "headers legitimos")

    // Headers da plataforma ficam fora: Authorization e credencial (nunca
    // varrida nem ecoada), Host e rota, Content-Length/Connection sao do
    // protocolo. Um valor com cara de ataque ali nao pode bloquear o
    // legitimo (nem um token opaco virar 403).
    assert(wafHeaderIgnored("authorization"), "authorization ignorado")
    assert(wafHeaderIgnored("Authorization"), "caixa nao fura a lista")
    assert(wafHeaderIgnored("host"), "host ignorado")
    assert(wafHeaderIgnored("content-length"), "content-length ignorado")
    assert(wafHeaderIgnored("x-forwarded-for"), "x-forwarded-for ignorado")
    assert(wafHeaderIgnored("user-agent") == false, "user-agent inspecionado")
    assert(wafHeaderIgnored("cookie") == false, "cookie inspecionado")
    var authHeader = listOf<String>()
    authHeader.add("Authorization: Bearer ../not-really-a-path")
    assert(wafDetectHeadersSignature(authHeader) == "", "credencial nao e varrida")

    // Valor acima do teto de inspecao nao e varrido (mesma regra fail-open
    // do corpo: nao vira custo nem falso positivo).
    var big = ""
    var i = 0
    while (i < wafBodyInspectBytes() + 10) {
        big = big + "a"
        i = i + 1
    }
    var oversized = listOf<String>()
    oversized.add("X-Big: " + big + " UNION SELECT")
    assert(wafDetectHeadersSignature(oversized) == "", "header grande nao inspecionado")

    // Linha malformada (sem dois-pontos) e ignorada, nunca lanca.
    var malformed = listOf<String>()
    malformed.add("sem-dois-pontos UNION SELECT")
    assert(wafDetectHeadersSignature(malformed) == "", "linha malformada ignorada")

    // Percent-encoding no valor: decodifica UMA passada para o mesmo
    // vocabulario. `+` NAO vira espaco em header (isso e form-encoding de
    // query/corpo) — so `%NN`.
    var encodedHeader = listOf<String>()
    encodedHeader.add("Referer: http://x/%2e%2e%2f%2e%2e%2fetc/passwd")
    assert(wafDetectHeadersSignature(encodedHeader) == "traversal", "traversal percent no header")
    var encodedAgent = listOf<String>()
    encodedAgent.add("User-Agent: probe%3Cscript%3Ealert(1)")
    assert(wafDetectHeadersSignature(encodedAgent) == "xss-script", "xss percent no header")
    // `+` literal no header nao vira espaco: "union+select" continua limpo.
    var plusHeader = listOf<String>()
    plusHeader.add("X-Plus: union+select")
    assert(wafDetectHeadersSignature(plusHeader) == "", "header nao trata + como espaco")
}

test "waf detectar: corpo pequeno tambem e inspecionado", "wafbody-unit" {
    // O desenho do slice 1 prometia "corpo pequeno"; so metodo+path deixava
    // POST de formulario/JSON passar sem inspecao.
    assert(wafDetectBodySignature("q=UNION SELECT * FROM users") == "sqli-union", "union no corpo")
    assert(wafDetectBodySignature("{\"u\":\"x' OR 1=1--\"}") == "sqli-tautology", "tautologia em JSON")
    assert(wafDetectBodySignature("{\"q\":\"<script>alert(1)</script>\"}") == "xss-script", "xss em JSON")
    assert(wafDetectBodySignature("file=../../etc/passwd") == "traversal", "traversal no corpo")
    assert(wafDetectBodySignature("a=%00b") == "nullbyte", "null byte no corpo")
    // Legitimo nao casa.
    assert(wafDetectBodySignature("{\"name\":\"Mel\",\"page\":2}") == "", "json legitimo")
    assert(wafDetectBodySignature("") == "", "corpo vazio")
    // Acima do teto de inspecao nao e varrido (nao vira falso positivo caro).
    var big = ""
    var i = 0
    while (i < wafBodyInspectBytes() + 10) {
        big = big + "a"
        i = i + 1
    }
    assert(wafDetectBodySignature(big + " UNION SELECT") == "", "corpo grande nao inspecionado")
    assert(wafBodyInspectBytes() > 0, "teto positivo")
    // Fonte unica: o teto delega no Limits (default 64 KiB, afinavel por
    // config). Trava o casamento + o comportamento fail-open do zerado.
    assert(wafBodyInspectBytes() == limitWafBodyInspectBytes(), "teto do Limits")
    assert(limitWafBodyInspectBytes() == 65536, "default 64 KiB")
}

test "waf detectar: ataque no corpo (POST) conta e marca would-block", "wafdetect-body" {
    var localSvc = 19811
    var controlPort = 19812
    var tunnelPort = 19813
    var httpPort = 19814

    var localListener = net.listen(localSvc)
    var localServer = spawn {
        var serving = true
        while (serving) {
            try {
                var peer = localListener.accept()
                var worker = spawn { serveDetectPeer(peer) }
            } catch (String e) {
                serving = false
            }
        }
    }
    assert(waitForPort(localSvc, 60), "servico local no ar")

    var registry = Registry("/tmp/kofcloud-wafbody-" + crypto.randomHex(4) + ".json")
    var edgeState = EdgeState(registry)
    var edgeStop = "/tmp/kofcloud-wafbody-edge-" + crypto.randomHex(4) + ".txt"
    var agentStop = "/tmp/kofcloud-wafbody-agent-" + crypto.randomHex(4) + ".txt"
    File(edgeStop).delete()
    File(agentStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, "", edgeStop) }
    var httpTask = spawn { serveHttp(edgeState, httpPort, limitMaxBodyBytes(), edgeStop) }
    assert(waitForPort(controlPort, 60), "control no ar")
    assert(waitForPort(tunnelPort, 60), "tunel no ar")
    assert(waitForPort(httpPort, 60), "http no ar")

    var created = httpPostJson(controlPort, "/v1/accounts", "{\"handle\":\"mel\",\"email\":\"m@e.com\",\"password\":\"segredo\"}", "")
    var account = json.decode<Map<String, String>>(bodyOf(created))
    var accountToken = mapField(account, "token")
    var accountId = mapField(account, "accountId")
    var deviceResponse = httpPostJson(controlPort, "/v1/devices", "{\"name\":\"notebook\",\"publicKey\":\"pubkey\"}", accountToken)
    var deviceId = mapField(json.decode<Map<String, String>>(bodyOf(deviceResponse)), "deviceId")
    var pubBody = "{\"deviceId\":\"" + deviceId + "\",\"name\":\"site\",\"localAddress\":\"127.0.0.1\",\"localPort\":\"" + intToString(localSvc) + "\",\"protocol\":\"http\",\"exposure\":\"PUBLIC\"}"
    assert(statusOf(httpPostJson(controlPort, "/v1/services", pubBody, accountToken)) == 200, "PUBLIC publicado")

    var config = AgentConfig("http://127.0.0.1:" + intToString(controlPort), deviceId, accountId, accountToken, "", agentStop, "127.0.0.1", tunnelPort, 100)
    var agentTask = spawn { runAgent(config, true) }
    var online = false
    var attempts = 100
    while (attempts > 0 && online == false) {
        online = edgeState.isOnline(deviceId)
        if (online == false) {
            time.sleep(50)
            attempts = attempts - 1
        }
    }
    assert(online, "agent online")

    var host = "site.mel.kofcloud.io"
    // A metrica e global do processo: outros testes WAF podem ja ter contado.
    // A prova e "nao aumentou", nao "esta em zero".
    var baseline = metricValue(observability.metrics(), "kofcloud_edge_waf_detected_total")
    // POST legitimo antes: 200, sem contagem.
    var ok = httpPostRaw(httpPort, "/submit", host, listOf<String>("Content-Type: application/json"), "{\"name\":\"Mel\"}")
    assert(statusOf(ok) == 200, "POST legitimo 200")
    assert(metricValue(observability.metrics(), "kofcloud_edge_waf_detected_total") == baseline, "legitimo nao conta")

    // POST com SQLi no corpo: modo detectar CONTA e marca would-block.
    var evil = httpPostRaw(httpPort, "/submit", host, listOf<String>("Content-Type: application/json"), "{\"q\":\"x' OR 1=1--\"}")
    assert(statusOf(evil) == 200, "detectar nao bloqueia o corpo")
    assert(responseHeader(evil, "X-KofCloud-WAF") == "would-block", "marca would-block")
    assert(metricValue(observability.metrics(), "kofcloud_edge_waf_detected_total_sqli_tautology") >= 1, "padrao do corpo contado")

    // Enforce: o mesmo POST vira 403 KCF109 sem chegar ao servico local.
    edgeState.setWafEnforce(true)
    var blocked = httpPostRaw(httpPort, "/submit", host, listOf<String>("Content-Type: application/json"), "{\"q\":\"<script>alert(1)</script>\"}")
    assert(statusOf(blocked) == 403, "enforce bloqueia corpo")
    assert(bodyOf(blocked).indexOf("KCF109") >= 0, "KCF109")
    assert(responseHeader(blocked, "X-KofCloud-WAF") == "blocked", "marca blocked")

    // Parada limpa.
    writeTextTo(agentStop, "stop")
    time.sleep(1500)
    writeTextTo(edgeStop, "stop")
    time.sleep(1000)
    File(agentStop).delete()
    File(edgeStop).delete()
    localListener.close()
}
