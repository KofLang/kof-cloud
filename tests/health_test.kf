import kofcloud.agent.Agent
import kofcloud.agent.Health
import kofcloud.model.Service
import kofcloud.protocol.Bytes
import kofcloud.protocol.Session
import kofcloud.util.Limits
import testkit.Support

// Health check do servico local (docs/04-service.md).
//
// Antes o check era so um connect TCP: um servico que aceitava a conexao e
// devolvia 500 — ou nunca respondia — ficava ONLINE para sempre, e DEGRADED
// nunca era emitido. Agora e um GET / de verdade com prazo: < 500 = ONLINE,
// >= 500 ou sem resposta a tempo = DEGRADED, recusa = OFFLINE.

Service healthService(Int port, String allowPaths) {
    return Service("svc", "acc", "dev", "site", "127.0.0.1", port, "http", "site.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0L, "", allowPaths)
}

// Servidor TCP cru que responde sempre com `raw` depois de ler o pedido.
void serveRawFixed(Listener listener, String raw) {
    var open = true
    while (open) {
        try {
            var peer = listener.accept()
            var worker = spawn {
                peer.receive(8192)
                peer.send(bytesFromString(raw))
                peer.close()
            }
        } catch (String e) {
            open = false
        }
    }
}

// Servidor que aceita e NUNCA responde (conexoes ficam presas ate o fim).
void serveSilent(Listener listener, List<Conn> held) {
    var open = true
    while (open) {
        try {
            var peer = listener.accept()
            held.add(peer)
        } catch (String e) {
            open = false
        }
    }
}

test "health: status line e caminho da sonda sao puros", "health-unit" {
    assert(parseStatusLine("HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n") == 200, "200")
    assert(parseStatusLine("HTTP/1.1 500 Internal Server Error\r\n") == 500, "500")
    assert(parseStatusLine("HTTP/1.0 404 Not Found") == 404, "sem crlf final")
    assert(parseStatusLine("garbage") == 0, "nao HTTP")
    assert(parseStatusLine("") == 0, "vazio")
    assert(parseStatusLine("HTTP/1.1 abc OK") == 0, "status nao numerico")
    // Fora de 100-599 nao e status usavel: o parse devolve 0 e o caller
    // trata como resposta quebrada (DEGRADED), nunca como codigo legitimo.
    assert(parseStatusLine("HTTP/1.1 099 Weird\r\n") == 0, "abaixo de 100")
    assert(parseStatusLine("HTTP/1.1 600 Nope\r\n") == 0, "acima de 599")
    assert(parseStatusLine("HTTP/1.1 99 X\r\n") == 0, "2 digitos")
    assert(parseStatusLine("HTTP/1.1 1234 X\r\n") == 123, "os 3 primeiros digitos valem")
    // Mesmo digitos fora da faixa numa linha longa: o resto e motivo, nao codigo.
    assert(parseStatusLine("HTTP/1.1 200 OK\r\nContent-Length: 4294967396\r\n") == 200, "CL gigante no header nao contamina")

    // Sem allowlist: /. Com allowlist: o primeiro caminho literal — `/` pode
    // nao estar nela e um 403 seria lido como falha de health.
    var plain = healthService(8080, "")
    assert(healthPath(plain) == "/", "sem allowlist usa /")
    var restricted = healthService(8080, "/api/health,/api/*")
    assert(healthPath(restricted) == "/api/health", "allowlist: primeiro literal")
    var onlyWild = healthService(8080, "/api/*")
    assert(healthPath(onlyWild) == "/", "so curinga cai no /")
    assert(hostHeaderFor(plain) == "site.mel.kofcloud.io", "host do pedido")
    assert(protocolIsHttp("http") && protocolIsHttp(" HTTP "), "http reconhecido")

    // Fonte unica do prazo: positivo, com recuo seguro.
    assert(limitHealthTimeoutMs() > 0, "prazo positivo")
    // Teto do cabecalho da sonda tambem na fonte unica: valor travado +
    // delegacao (mudar o default no Limits muda a sonda — mutacao quebra).
    // O teto e do caminho de health, distinto do `maxBytes` do Edge.
    assert(limitHealthHeadBytes() == 16384, "teto do cabecalho da sonda travado")
    assert(limitHealthHeadBytes() == limitHealthResponseHeadBytes(), "sonda delega na fonte")
    var healthCycle = limitHealthMs()
    assert(limitHealthTimeoutMs() < healthCycle, "prazo cabe no ciclo do health")
}

test "health: 200 = ONLINE, 500 = DEGRADED, sem resposta = DEGRADED, recusa = OFFLINE", "health" {
    var okPort = 20031
    var badPort = 20033
    var silentPort = 20035
    var deadPort = 20037

    var okListener = net.listen(okPort)
    var okServer = spawn { serveRawFixed(okListener, "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok") }
    var badListener = net.listen(badPort)
    var badServer = spawn { serveRawFixed(badListener, "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 0\r\nConnection: close\r\n\r\n") }
    var silentListener = net.listen(silentPort)
    var held = listOf<Conn>()
    var silentServer = spawn { serveSilent(silentListener, held) }
    assert(waitForPort(okPort, 60), "servico ok no ar")
    assert(waitForPort(badPort, 60), "servico 500 no ar")
    assert(waitForPort(silentPort, 60), "servico mudo no ar")

    var okService = healthService(okPort, "")
    var badService = healthService(badPort, "")
    var silentService = healthService(silentPort, "")
    var deadService = healthService(deadPort, "")

    assert(checkService(okService) == statusOnline(), "200 -> ONLINE")
    assert(checkService(badService) == statusDegraded(), "500 -> DEGRADED (antes: ONLINE so por abrir a porta)")
    var started = time.now()
    assert(checkService(silentService) == statusDegraded(), "mudo -> DEGRADED no prazo")
    var elapsed = time.now() - started
    assert(elapsed < limitHealthTimeoutMs() * 3, "prazo respeitado (elapsed=" + intToString(elapsed) + "ms)")
    assert(checkService(deadService) == statusOffline(), "porta fechada -> OFFLINE")

    okListener.close()
    badListener.close()
    silentListener.close()
    for (var c in held) {
        c.close()
    }
}

test "health: ciclo le a tabela da sessao (hot-reload), memoria poda removido", "health-reload" {
    // currentServiceNames espelha a tabela viva que o refresher troca via
    // setServices; pruneHealthMemory devolve a memoria `last` ao tamanho da
    // tabela. Puro, sem tunel: trava o contrato que o agentHealth usa — o
    // ciclo sonda o que esta servido AGORA, nao a lista do connect.
    var session = TunnelSession("s1", "d1", "a1", "")
    assert(currentServiceNames(session).size == 0, "tabela vazia: nada a sondar")
    var svc = healthService(8080, "")
    session.setServices(listOf(svc))
    var names = currentServiceNames(session)
    assert(names.size == 1 && names.get(0) == "site", "troca da tabela aparece")

    var last = mapOf()
    last.put("site", statusOnline())
    pruneHealthMemory(last, names)
    assert(last.get("site") == statusOnline(), "presente continua lembrado")

    // Servico removido no hot-reload (trocado por outro nome): sai da tabela
    // E da memoria — se um dia voltar, o primeiro ciclo reporta de novo como
    // mudanca.
    var late = Service("late-id", "acc", "dev", "late", "127.0.0.1", 8081, "http", "late.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0L, "", "")
    session.setServices(listOf(late))
    var swapped = currentServiceNames(session)
    assert(swapped.size == 1 && swapped.get(0) == "late", "tabela nova, sem tocar na anterior")
    pruneHealthMemory(last, swapped)
    assert(last.get("site") == null, "removido sai da memoria")
}

// Servidor que conta SONDA de health: o check envia "GET ... HTTP/1.1";
// waitForPort so conecta e fecha (receive vazio). Contar o accept pegaria o
// ready-check como sonda e deixaria a assercao trivialmente verdadeira.
void serveCounting(Listener listener, Int[] probes) {
    var open = true
    while (open) {
        try {
            var peer = listener.accept()
            var worker = spawn {
                var got = peer.receive(8192)
                if (got.length > 0) {
                    probes[0] = probes[0] + 1
                }
                var body = "ok"
                var head = "HTTP/1.1 200 OK\r\nContent-Length: " + body.length + "\r\nConnection: close\r\n\r\n"
                peer.send(bytesFromString(head + body))
                peer.close()
            }
        } catch (String e) {
            open = false
        }
    }
}

Int countValue(Int[] counter) {
    return counter[0]
}

test "health: apos hot-reload sonda o servico novo e para de sondar o removido", "health-follows-reload" {
    // Regressao do bug real: agentHealth recebia a List do connect (copiada
    // pelo spawn) e nunca via a troca do refresher. Um servico removido
    // continuava sondado para sempre e um novo nunca era sondado (STATUS
    // ficava UNKNOWN). Aqui a sessao faz o papel do refresher.
    var firstPort = 20041
    var latePort = 20042
    var firstListener = net.listen(firstPort)
    var firstCount = new Int[1]
    firstCount[0] = 0
    var firstServer = spawn { serveCounting(firstListener, firstCount) }
    var lateListener = net.listen(latePort)
    var lateCount = new Int[1]
    lateCount[0] = 0
    var lateServer = spawn { serveCounting(lateListener, lateCount) }
    assert(waitForPort(firstPort, 60), "primeiro servico no ar")
    assert(waitForPort(latePort, 60), "servico tardio no ar")

    var session = TunnelSession("s1", "d1", "a1", "")
    var first = Service("id-1", "acc", "dev", "first", "127.0.0.1", firstPort, "http", "first.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0L, "", "")
    session.setServices(listOf(first))
    var healthTask = spawn { agentHealth(session, 100) }

    var firstProbed = false
    var waits = 100
    while (waits > 0 && firstProbed == false) {
        if (countValue(firstCount) > 0) {
            firstProbed = true
        } else {
            time.sleep(50)
            waits = waits - 1
        }
    }
    assert(firstProbed, "servico inicial sondado")
    assert(countValue(lateCount) == 0, "servico ainda nao publicado nao e sondado")

    // Hot-reload: some `first`, entra `late` (o Edge poda a rota na mesma troca).
    var late = Service("id-2", "acc", "dev", "late", "127.0.0.1", latePort, "http", "late.mel.kofcloud.io", "PUBLIC", "UNKNOWN", 0L, "", "")
    session.setServices(listOf(late))

    var lateProbed = false
    waits = 100
    while (waits > 0 && lateProbed == false) {
        if (countValue(lateCount) > 0) {
            lateProbed = true
        } else {
            time.sleep(50)
            waits = waits - 1
        }
    }
    assert(lateProbed, "servico novo sondado apos a troca")

    // O removido nao pode continuar sendo sondado: deixa varios ciclos
    // folgados (healthMs=100) e confere que o contador nao andou.
    var settled = countValue(firstCount)
    time.sleep(800)
    assert(countValue(firstCount) == settled, "removido deixa de ser sondado (" + intToString(settled) + " -> " + intToString(countValue(firstCount)) + ")")

    // Encerra a task de health e os listeners.
    session.close()
    time.sleep(250)
    firstListener.close()
    lateListener.close()
}
