import kofcloud.cli.Commands
import kofcloud.cli.Usage
import kofcloud.store.Store
import kofcloud.util.Text
import testkit.Support

// F16 s3-cont — falha de bind dos listeners do `serve`. Medido: `net.listen`
// numa porta ocupada LANÇA ("cannot listen on port ... Endereco ja em uso"),
// e os tres listeners do serve abrem DENTRO de `spawn` — a excecao morria na
// task e o serve anunciava as portas como no ar com a borda inexistente.
// Agora a porta e testada ANTES de anunciar/spawnar.

test "serve-bind: mensagem de recusa e pre-bind puros", "serve-bind-unit" {
    // Rotulos por papel.
    need(servePortLabel("control") == "control", "falhou")
    need(servePortLabel("tunnel") == "tunel", "falhou")
    need(servePortLabel("http") == "publica", "falhou")

    // Recusa: nomeia o papel, a porta e o motivo; promete que nada subiu e
    // aponta a saida (outra --<role>-port ou liberar a porta).
    var refusal = serveBindRefusal("tunnel", 7000, "kof.net: cannot listen on port 7000: Endereco ja em uso")
    need(refusal.indexOf("recusado") >= 0, "falhou")
    need(refusal.indexOf("tunel 7000") >= 0, "falhou")
    need(refusal.indexOf("Endereco ja em uso") >= 0, "falhou")
    need(refusal.indexOf("nenhuma porta foi anunciada") >= 0, "falhou")
    need(refusal.indexOf("--tunnel-port") >= 0, "falhou")
}

test "serve-bind: pre-bind detecta a porta ocupada e libera quando livre", "serve-bind-unit" {
    var port = 19981
    // Porta livre: pre-bind passa ("") e a porta fica livre para o listener.
    need(prebindServeListener("tunnel", port) == "", "falhou")
    // Porta ocupada: segura um listener e o pre-bind devolve o motivo.
    var held = net.listen(port)
    var err = prebindServeListener("tunnel", port)
    need(err.length > 0, "falhou")
    need(err.indexOf("port") >= 0, "falhou")
    // Solta a porta: volta a passar.
    held.close()
    need(prebindServeListener("tunnel", port) == "", "falhou")
}

test "serve-bind: e2e — serve recusa subir com a porta ocupada", "serve-bind-e2e" {
    // Segura a porta do tunel e chama cmdServe com portas dedicadas: a recusa
    // sai ANTES de subir o control plane (nao deixa metade no ar).
    var tunnelPort = 19982
    var held = net.listen(tunnelPort)
    var code = cmdServe(listOf("--control-port", "19983", "--tunnel-port", intToString(tunnelPort), "--http-port", "19984"))
    need(code == 1, "falhou")
    // O control-plane port NAO subiu (a recusa foi antes do start).
    var controlUp = false
    try {
        var probe = net.connect("127.0.0.1", 19983)
        probe.close()
        controlUp = true
    } catch (String e) {
    }
    need(controlUp == false, "falhou")
    held.close()
}
