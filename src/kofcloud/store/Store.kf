package kofcloud.store

// Persistencia em arquivo JSON. Sem banco: o MVP guarda estado em disco com
// File/Directory do kof.io. Escrita nao e atomica (o Kof nao expoe rename
// atomico) — documentado em docs/17-limitations.md.

String readTextOr(String path, String fallback) {
    var text = File(path).readText()
    if (text == null) {
        return fallback
    }
    return text
}

Bool writeTextTo(String path, String text) {
    var dir = parentDir(path)
    if (dir.length > 0) {
        Directory(dir).createDirectories()
    }
    return File(path).writeText(text)
}

Bool fileExists(String path) {
    return File(path).exists()
}

// Append best-effort de uma linha em arquivo texto (read+write — o stdlib
// nao expoe append atomico nem fd de append; mesma limitacao do rename do
// cabecalho, ver 17-limitations). NUNCA lanca: devolve false em falha de IO
// para o chamador decidir ignorar (contrato do espelho WORM do audit: a
// trilha redundante jamais quebra o caminho da requisicao). Duas linhas
// concorrentes podem intercalar (sem lock, L3) — o espelho e aproximação
// como os contadores; a cadeia de hashes detecta linha perdida/adulterada.
Bool appendLineTo(String path, String line) {
    try {
        var existing = readTextOr(path, "")
        writeTextTo(path, existing + line + "\n")
        return true
    } catch (String e) {
        return false
    }
}

String parentDir(String path) {
    var index = -1
    for (var i = 0; i < path.length; i++) {
        if (path.charAt(i) == 47) {
            index = i
        }
    }
    if (index <= 0) {
        return ""
    }
    return path.substring(0, index)
}
