package kofcloud.cli

// Texto de ajuda da CLI.

String usageText() {
    var out = "kof cloud — conecte sua maquina a internet\n"
    out = out + "\n"
    out = out + "uso: kof cloud <comando> [opcoes]\n"
    out = out + "\n"
    out = out + "  login <handle> --password <p> [--control <url>] [--device <nome>]\n"
    out = out + "  logout\n"
    out = out + "  connect\n"
    out = out + "  disconnect\n"
    out = out + "  status\n"
    out = out + "  device list\n"
    out = out + "  device revoke <deviceId>\n"
    out = out + "  device suspend <deviceId>\n"
    out = out + "  device unsuspend <deviceId>\n"
    out = out + "  publish <nome> --port <porta> [--exposure PUBLIC|AUTHENTICATED|PRIVATE] [--address <addr>] [--device <nome>]\n"
    out = out + "  unpublish <nome>\n"
    out = out + "  service list\n"
    out = out + "  service status <nome>\n"
    out = out + "  service suspend <nome>\n"
    out = out + "  service unsuspend <nome>\n"
    out = out + "  service token <nome> [--ttl <horas>]  (credencial kfs_ para AUTHENTICATED)\n"
    out = out + "  service token-list <nome>   (inventario, sem valores)\n"
    out = out + "  service token-revoke <nome> <kfs_>  (revoga UMA credencial vazada)\n"
    out = out + "  domain list\n"
    out = out + "  domain add <hostname> --service <nome>\n"
    out = out + "  domain verify <hostname>\n"
    out = out + "  domain remove <hostname>\n"
    out = out + "  deploy [--file kofcloud.json] [--check]   (publica os servicos do manifesto + verifica)\n"
    out = out + "  down [--file kofcloud.json]     (remove os servicos do manifesto)\n"
    out = out + "  daemon install|status|uninstall   (systemd --user, sem root)\n"
    out = out + "  doctor [--file kofcloud.json]       (diagnostico: login, control, device, tunel, servicos)\n"
    out = out + "  audit                     (trilha de auditoria da conta)\n"
    out = out + "  logs [--tail <linhas>]  (log local do agent, teto 256 KiB)\n"
    out = out + "\n"
    out = out + "  serve [--control-port 8080] [--tunnel-port 7000] [--http-port 8081]\n"
    out = out + "        sobe a plataforma (control plane + edge) localmente\n"
    return out
}
