package kofcloud.cli

import kofcloud.cli.Deploy
import kofcloud.util.Hosts
import kofcloud.util.Text

// Texto de ajuda da CLI. As linhas do manifesto montam o nome do arquivo
// a partir de defaultManifestPath() — precedente: a linha do serve ja
// monta as portas a partir de defaultControlPort()/defaultTunnelPort()/
// defaultHttpPort(). Sem isso, mudar o default deixava o help mentindo
// (o deploy-usage trava as duas familias).

String usageText() {
    var out = "kof cloud — conecte sua maquina a internet\n"
    out = out + "\n"
    out = out + "uso: kof cloud <comando> [opcoes]\n"
    out = out + "\n"
    out = out + "  login <handle> --password <p> [--control <url>] [--device <nome>]\n"
    out = out + "  logout\n"
    out = out + "  connect\n"
    out = out + "  disconnect\n"
    out = out + "  status\n"
    out = out + "  device list\n"
    out = out + "  device revoke <nome|deviceId>\n"
    out = out + "  device suspend <nome|deviceId>\n"
    out = out + "  device unsuspend <nome|deviceId>\n"
    out = out + "  publish <nome> --port <porta> [--exposure PUBLIC|AUTHENTICATED|PRIVATE] [--address <addr>] [--device <nome>]\n"
    out = out + "  unpublish <nome>\n"
    out = out + "  service list\n"
    out = out + "  service status <nome>\n"
    out = out + "  service suspend <nome>\n"
    out = out + "  service unsuspend <nome>\n"
    out = out + "  service token <nome> [--ttl <horas>]  (credencial kfs_ para AUTHENTICATED)\n"
    out = out + "  service token-list <nome>   (inventario, sem valores)\n"
    out = out + "  service token-revoke <nome> <kfs_|id>  (revoga UMA credencial; id curto se unico)\n"
    out = out + "  domain list\n"
    out = out + "  domain add <hostname> --service <nome>\n"
    out = out + "  domain verify <hostname>\n"
    out = out + "  domain remove <hostname>\n"
    out = out + "  deploy [--file " + defaultManifestPath() + "] [--check] [--plan]  (publica + verifica; --plan so mostra o diff e marca (build)/(artifact); manifesto aceita build/artifact por servico)\n"
    out = out + "  down [--file " + defaultManifestPath() + "] [--prune]  (remove os do manifesto; --prune remove orfaos do device)\n"
    out = out + "  daemon install|status|uninstall   (systemd --user, sem root)\n"
    out = out + "  doctor [--file " + defaultManifestPath() + "]       (diagnostico: login, control, device, tunel, servicos)\n"
    out = out + "  audit                     (trilha de auditoria da conta)\n"
    out = out + "  logs [--tail <linhas>]  (log local do agent, teto 256 KiB)\n"
    out = out + "\n"
    out = out + "  serve [--control-port " + intToString(defaultControlPort()) + "] [--tunnel-port " + intToString(defaultTunnelPort()) + "] [--http-port " + intToString(defaultHttpPort()) + "] [--state <arquivo>]\n"
    out = out + "        sobe a plataforma (control plane + edge) localmente\n"
    return out
}
