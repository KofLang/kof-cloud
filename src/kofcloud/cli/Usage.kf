package kofcloud.cli

import kofcloud.cli.Deploy
import kofcloud.util.Hosts
import kofcloud.util.Text

// Texto de ajuda da CLI. As linhas do manifesto montam o nome do arquivo
// a partir de defaultManifestPath() — precedente: a linha do serve ja
// monta as portas a partir de defaultControlPort()/defaultTunnelPort()/
// defaultHttpPort(). Sem isso, mudar o default deixava o help mentindo
// (o deploy-usage trava as duas familias).

String usageText() {
    var out = "kof cloud — conecte sua maquina a internet\n"
    out = out + "\n"
    out = out + "uso: kof cloud <comando> [opcoes]\n"
    out = out + "\n"
    out = out + "  login <handle> --password <p> [--control <url>] [--device <nome>]\n"
    out = out + "  logout\n"
    out = out + "  connect\n"
    out = out + "  disconnect\n"
    out = out + "  status\n"
    out = out + "  device list [--json]   (--json = saida estavel para CI, com o eixo de presenca)\n"
    out = out + "  device revoke <nome|deviceId> [--yes]  (irreversivel: remove o device + servicos/credenciais; sem --yes so avisa)\n"
    out = out + "  device suspend <nome|deviceId>\n"
    out = out + "  device unsuspend <nome|deviceId>\n"
    out = out + "  publish <nome> --port <porta> [--exposure PUBLIC|AUTHENTICATED|PRIVATE] [--address <addr>] [--device <nome>] [--allow-method VERBO]... [--allow-path /caminho]... [--max-body <bytes>]\n"
    out = out + "  unpublish <nome>\n"
    out = out + "  service list [--json]   (--json = saida estavel para CI)\n"
    out = out + "  service status <nome> [--tls-cert <pem>]  (com o PEM, julga expiracao e cobertura para os hosts do servico)\n"
    out = out + "  service suspend <nome>\n"
    out = out + "  service unsuspend <nome>\n"
    out = out + "  service token <nome> [--ttl <horas>]  (credencial kfs_ para AUTHENTICATED)\n"
    out = out + "  service token-list <nome>   (inventario, sem valores)\n"
    out = out + "  service token-revoke <nome> <kfs_|id>  (revoga UMA credencial; id curto se unico)\n"
    out = out + "  service tokens   (credenciais validas SEM expiracao na conta)\n"
    out = out + "  service rotate (<nome>|--all) [--ttl <horas>] [--prune]  (credencial nova; revoga as antigas SO depois do TTL)\n"
    out = out + "  service rotation <nome>   (quantas credenciais ainda valem)\n"
    out = out + "  domain list [--json]   (--json = saida estavel para CI)\n"
    out = out + "  domain add <hostname> --service <nome> [--dns-webhook <url> | --dns-cmd <cmd>] [--dry-run]  (CNAME: webhook do operador OU CLI do provedor — {hostname}/{target}/{service} no comando; --dry-run mostra e nao registra nem envia)\n"
    out = out + "  domain verify <hostname> [--tls-cert <pem>]  (com o PEM, confere ANTES que ele cobre o hostname)\n"
    out = out + "  domain remove <hostname>\n"
    out = out + "  deploy [--file " + defaultManifestPath() + "] [--check] [--plan] [--watch]  (publica + verifica; --plan so mostra o diff e marca (build)/(artifact); --watch observa o manifesto e re-publica o que mudar — nunca remove; manifesto aceita build/artifact por servico; pare com o arquivo deploy-watch-stop)\n"
    out = out + "  down [--file " + defaultManifestPath() + "] [--prune] [--yes]  (remove os do manifesto; --prune remove orfaos do device; sem --yes so avisa)\n"
    out = out + "  daemon install|status|uninstall   (artefato por SO — systemd/launchd/Windows — sem root, ativacao manual)\n"
    out = out + "  doctor [--file " + defaultManifestPath() + "] [--tls-cert <pem>]       (diagnostico: login, control, device, tunel, auditoria, tls, servicos)\n"
    out = out + "  metrics [--grep <texto>] [--percentiles] [--control <url>]   (export Prometheus; --percentiles = p50/p95/p99 de latencia do Edge; sem auth, so agregados)\n  usage [--export]   (uso da conta: requests e bytes roteados pelo Edge; --export fecha a janela — le e zera, para billing externo)\n  audit [--sbom] [--verify] [--action <acao>] [--tail <n>]  (trilha da conta; --sbom = inventario local; --action filtra, --tail corta)\n"
    out = out + "  scan [--file <caminho>] [--tls-cert <pem>]  (segredos no manifesto/ambiente, PEM expirando, .kfs commitado e pins de dependencia abertos no repo; exit 1 com achado)\n"
    out = out + "  webhook set <url> --secret <s> | show | remove | test   (incidentes; HMAC-SHA256)\n"
    out = out + "  freeze service|device <nome|id>     (contencao: suspende + revoga credenciais + incidente)\n"
    out = out + "  freeze account                      (a conta inteira: devices + servicos + kfs_)\n"
    out = out + "  unfreeze service|device <nome|id>   (restaura o status anterior)\n"
    out = out + "  unfreeze account                    (restaura device e servico ao status anterior)\n"
    out = out + "  incidents [--all] [--resolve <id>]   (abertos da conta + plataforma)\n"
    out = out + "  migrate --from <estado.json> [--to <destino.json>] [--dry-run]\n"
    out = out + "  state-backup [--file <estado.json>]   (copia o estado ao lado antes de trocar de backend)\n"
    out = out + "  token list|revoke <id|kfc_...>|rotate [--ttl <horas>]|rotation|prune   (credencial da CONTA)\n"
    out = out + "  logs [--tail <linhas>] [--runtime|--edge]  (marcos de sessao; --runtime = eventos do Agent; --edge = eventos do Edge)\n"
    out = out + "\n"
    out = out + "  serve [--control-port " + intToString(defaultControlPort()) + "] [--tunnel-port " + intToString(defaultTunnelPort()) + "] [--http-port " + intToString(defaultHttpPort()) + "] [--state <arquivo>] [--backup-dir <dir>] [--panel] [--status-page] [--waf detectar|enforce] [--tls-cert <pem> --tls-key <pem> | --tls-cert-cmd <cmd> --tls-key-cmd <cmd>] [--tunnel-secret-file <arq> | --tunnel-secret-cmd <cmd>]\n"
    out = out + "        sobe a plataforma (control plane + edge) localmente; com o par TLS o control plane serve HTTPS\n"
    return out
}
