package kofcloud.cli

import kofcloud.cli.Deploy
import kofcloud.util.Hosts
import kofcloud.util.Text

// Texto de ajuda da CLI. As linhas do manifesto montam o nome do arquivo
// a partir de defaultManifestPath() — precedente: a linha do serve ja
// monta as portas a partir de defaultControlPort()/defaultTunnelPort()/
// defaultHttpPort(). Sem isso, mudar o default deixava o help mentindo
// (o deploy-usage trava as duas familias).

String usageText() {
    var out = "kof cloud — conecte sua maquina a internet\n"
    out = out + "\n"
    out = out + "uso: kof cloud <comando> [opcoes]\n"
    out = out + "\n"
    out = out + "  login <handle> --password <p> [--control <url>] [--device <nome>]\n"
    out = out + "  logout\n"
    out = out + "  connect\n"
    out = out + "  disconnect\n"
    out = out + "  status\n"
    out = out + "  device list\n"
    out = out + "  device revoke <nome|deviceId>\n"
    out = out + "  device suspend <nome|deviceId>\n"
    out = out + "  device unsuspend <nome|deviceId>\n"
    out = out + "  publish <nome> --port <porta> [--exposure PUBLIC|AUTHENTICATED|PRIVATE] [--address <addr>] [--device <nome>] [--allow-method VERBO]... [--allow-path /caminho]...\n"
    out = out + "  unpublish <nome>\n"
    out = out + "  service list\n"
    out = out + "  service status <nome>\n"
    out = out + "  service suspend <nome>\n"
    out = out + "  service unsuspend <nome>\n"
    out = out + "  service token <nome> [--ttl <horas>]  (credencial kfs_ para AUTHENTICATED)\n"
    out = out + "  service token-list <nome>   (inventario, sem valores)\n"
    out = out + "  service token-revoke <nome> <kfs_|id>  (revoga UMA credencial; id curto se unico)\n"
    out = out + "  service tokens   (credenciais validas SEM expiracao na conta)\n"
    out = out + "  service rotate (<nome>|--all) [--ttl <horas>] [--prune]  (credencial nova; revoga as antigas SO depois do TTL)\n"
    out = out + "  service rotation <nome>   (quantas credenciais ainda valem)\n"
    out = out + "  domain list\n"
    out = out + "  domain add <hostname> --service <nome>\n"
    out = out + "  domain verify <hostname>\n"
    out = out + "  domain remove <hostname>\n"
    out = out + "  deploy [--file " + defaultManifestPath() + "] [--check] [--plan]  (publica + verifica; --plan so mostra o diff e marca (build)/(artifact); manifesto aceita build/artifact por servico)\n"
    out = out + "  down [--file " + defaultManifestPath() + "] [--prune]  (remove os do manifesto; --prune remove orfaos do device)\n"
    out = out + "  daemon install|status|uninstall   (systemd --user, sem root)\n"
    out = out + "  doctor [--file " + defaultManifestPath() + "] [--tls-cert <pem>]       (diagnostico: login, control, device, tunel, tls, servicos)\n"
    out = out + "  audit [--sbom]              (trilha de auditoria da conta; --sbom = inventario local dos fontes)\n"
    out = out + "  scan [--file <caminho>] [--tls-cert <pem>]  (segredos no manifesto/ambiente + PEM expirando; exit 1 com achado)\n"
    out = out + "  webhook set <url> --secret <s> | show | remove | test   (incidentes; HMAC-SHA256)\n"
    out = out + "  freeze service|device <nome|id>     (contencao: suspende + revoga credenciais + incidente)\n"
    out = out + "  freeze account                      (a conta inteira: devices + servicos + kfs_)\n"
    out = out + "  unfreeze service|device <nome|id>   (restaura o status anterior)\n"
    out = out + "  unfreeze account                    (restaura device e servico ao status anterior)\n"
    out = out + "  incidents [--all] [--resolve <id>]   (abertos da conta + plataforma)\n"
    out = out + "  logs [--tail <linhas>] [--runtime]  (marcos de sessao; --runtime = eventos reais do Agent)\n"
    out = out + "\n"
    out = out + "  serve [--control-port " + intToString(defaultControlPort()) + "] [--tunnel-port " + intToString(defaultTunnelPort()) + "] [--http-port " + intToString(defaultHttpPort()) + "] [--state <arquivo>] [--panel] [--status-page] [--waf detectar|enforce] [--tls-cert <pem> --tls-key <pem>]\n"
    out = out + "        sobe a plataforma (control plane + edge) localmente; com o par TLS o control plane serve HTTPS\n"
    return out
}
