package kofcloud.cli

import kofcloud.cli.Commands
import kofcloud.cli.Daemon
import kofcloud.cli.Doctor
import kofcloud.cli.Deploy
import kofcloud.cli.Local
import kofcloud.cli.Usage
import kofcloud.util.Text

// Dispatcher de subcomandos. `kof cloud <comando> [args...]`.
//
// O comando principal e `connect` (o agente); `serve` sobe a plataforma
// (control plane + edge) para operacao local/teste.

Int runCli(List<String> args) {
    if (args.size == 0) {
        print(usageText())
        return 1
    }
    var first = args.get(0)
    if (first == "help" || first == "--help" || first == "-h") {
        print(usageText())
        return 0
    }
    var rest = args.subList(1, args.size)

    if (first == "login") {
        return cmdLogin(rest)
    }
    if (first == "logout") {
        return cmdLogout(rest)
    }
    if (first == "connect") {
        return cmdConnect(rest)
    }
    if (first == "disconnect") {
        return cmdDisconnect(rest)
    }
    if (first == "status") {
        return cmdStatus(rest)
    }
    if (first == "device") {
        return runDevice(rest)
    }
    if (first == "publish") {
        return cmdPublish(rest)
    }
    if (first == "unpublish") {
        return cmdUnpublish(rest)
    }
    if (first == "service") {
        return runService(rest)
    }
    if (first == "domain") {
        return runDomain(rest)
    }
    if (first == "deploy") {
        return cmdDeploy(rest)
    }
    if (first == "down") {
        return cmdDown(rest)
    }
    if (first == "doctor") {
        return cmdDoctor(rest)
    }
    if (first == "daemon") {
        return runDaemon(rest)
    }
    if (first == "logs") {
        return cmdLogs(rest)
    }
    if (first == "audit") {
        return cmdAudit(rest)
    }
    if (first == "serve") {
        return cmdServe(rest)
    }

    println("comando desconhecido: " + first)
    print(usageText())
    return 1
}

Int runDevice(List<String> args) {
    if (args.size == 0) {
        println("uso: kof cloud device list|revoke|suspend|unsuspend <id>")
        return 1
    }
    var sub = args.get(0)
    var rest = args.subList(1, args.size)
    if (sub == "list") {
        return cmdDeviceList(rest)
    }
    if (sub == "revoke") {
        return cmdDeviceRevoke(rest)
    }
    if (sub == "suspend") {
        return cmdDeviceSuspend(rest)
    }
    if (sub == "unsuspend") {
        return cmdDeviceUnsuspend(rest)
    }
    println("subcomando desconhecido: device " + sub)
    return 1
}

Int runService(List<String> args) {
    if (args.size == 0) {
        println("uso: kof cloud service list|status|suspend|unsuspend|token <nome>|token-list <nome>|token-revoke <nome> <kfs_...>")
        return 1
    }
    var sub = args.get(0)
    var rest = args.subList(1, args.size)
    if (sub == "list") {
        return cmdServiceList(rest)
    }
    if (sub == "status") {
        return cmdServiceStatus(rest)
    }
    if (sub == "suspend") {
        return cmdServiceSuspend(rest)
    }
    if (sub == "unsuspend") {
        return cmdServiceUnsuspend(rest)
    }
    if (sub == "token") {
        return cmdServiceToken(rest)
    }
    if (sub == "token-list") {
        return cmdServiceTokenList(rest)
    }
    if (sub == "token-revoke") {
        return cmdServiceTokenRevoke(rest)
    }
    println("subcomando desconhecido: service " + sub)
    return 1
}

Int runDomain(List<String> args) {
    if (args.size == 0) {
        println("uso: kof cloud domain list|add|verify|remove")
        return 1
    }
    var sub = args.get(0)
    var rest = args.subList(1, args.size)
    if (sub == "list") {
        return cmdDomainList(rest)
    }
    if (sub == "add") {
        return cmdDomainAdd(rest)
    }
    if (sub == "verify") {
        return cmdDomainVerify(rest)
    }
    if (sub == "remove") {
        return cmdDomainRemove(rest)
    }
    println("subcomando desconhecido: domain " + sub)
    return 1
}

Int runDaemon(List<String> args) {
    if (args.size == 0) {
        println("uso: kof cloud daemon install|status|uninstall")
        return 1
    }
    var sub = args.get(0)
    var rest = args.subList(1, args.size)
    if (sub == "install") {
        return cmdDaemonInstall(rest)
    }
    if (sub == "status") {
        return cmdDaemonStatus(rest)
    }
    if (sub == "uninstall") {
        return cmdDaemonUninstall(rest)
    }
    println("subcomando desconhecido: daemon " + sub)
    return 1
}
