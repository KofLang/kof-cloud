package kofcloud.cli

import kofcloud.agent.Health
import kofcloud.cli.Commands
import kofcloud.cli.Local
import kofcloud.model.Errors
import kofcloud.model.Exposure
import kofcloud.model.Service
import kofcloud.util.Hosts
import kofcloud.util.Text
import kofcloud.store.Store

// Deploy declarativo (Fase 7, slice 1): publica o que esta no manifesto e
// nada alem dele. Sem build, sem transferencia de artefato, sem daemon — so
// `publish` em lote sobre as primitivas existentes (identity + device +
// tunnel + service). O `down` faz o inverso. Nao destroi nada fora do
// manifesto: deploy nunca remove servico que ele nao declarou.
//
// Manifesto (`kofcloud.json`, `--file` para outro caminho):
//   {"services": [{"name": "site", "port": 8080,
//                  "address": "127.0.0.1", "exposure": "PUBLIC"}]}
// `address` defaulta para 127.0.0.1 e `exposure` para PUBLIC — os mesmos
// defaults do `publish`. `allowMethods`/`allowPaths` (Fase 10 slice 3) sao
// opcionais e seguem a mesma regra da API: ausentes = sem restricao,
// presentes sao normalizados (`normalizeAllowMethods`/`normalizeAllowPaths`)
// e politica malformada falha no parse antes de publicar qualquer coisa.

record ManifestService(String name, String address, Int port, String exposure, String protocol, String build, String artifact, String allowMethods, String allowPaths)

// Resultado de rodar o build de UM servico: ok=true, comando executado;
// ok=false traz o motivo ja formatado ("falhou (exit N)" ou "nao executou").
// Pura na decisao (so IO: executa o comando via process.run). Comando vazio
// ou so-espacos (sem "build" no manifesto, ou "build": "   ") = skip honesto,
// nao executa nada. Defesa em profundidade com o trim do parseManifest:
// quem chamar direto com espacos recebe o mesmo skip, sem tocar o shell.
record BuildResult(Bool ok, String detail)

// Ultima linha nao vazia de uma saida de processo ("" quando nao ha). O
// build do usuario costuma terminar com o erro na ultima linha; mostrar so
// "exit 1" obriga o operador a reproduzir o comando a mao. Pura.
String lastLineOf(String text) {
    var last = ""
    for (var line in text.split("\n")) {
        var trimmed = line.trim()
        if (trimmed.length > 0) {
            last = trimmed
        }
    }
    return last
}

// Detalhe da falha do build: `build falhou (exit N) — <ultima linha>`. Usa
// stderr quando houver (e o canal de erro do shell), senao stdout — builds
// reais imprimem o diagnostico num dos dois. Nunca inclui o comando nem
// mais que uma linha: o detalhe vai para o terminal/relatorio do usuario,
// nao para log de plataforma.
String buildFailureDetail(Int exitCode, String stdout, String stderr) {
    var tail = lastLineOf(stderr)
    if (tail.length == 0) {
        tail = lastLineOf(stdout)
    }
    if (tail.length == 0) {
        return "build falhou (exit " + intToString(exitCode) + ")"
    }
    return "build falhou (exit " + intToString(exitCode) + ") — " + tail
}

// Roda o `build` do manifesto pelo SHELL (`sh -c`), como a documentacao
// promete ("comando de shell rodado antes do publish, ex. `npm run build`").
// Medido: `process.run("echo hi")` procura um executavel com esse nome
// inteiro e falha com exit -1 (mesma licao do daemonSystemctl, que tambem
// passou a usar argv). Sem o shell, todo `build` com argumentos — o caso
// normal — falhava e o servico nao era publicado, com uma mensagem que
// parecia culpa do projeto do usuario.
BuildResult runServiceBuild(String buildCmd) {
    if (buildCmd.trim().length == 0) {
        return BuildResult(true, "sem build")
    }
    try {
        var result = process.run("sh", "-c", buildCmd)
        if (result.exitCode == 0) {
            return BuildResult(true, "ok")
        }
        return BuildResult(false, buildFailureDetail(result.exitCode, result.stdout, result.stderr))
    } catch (String e) {
        return BuildResult(false, "build nao executou: " + e)
    }
}

String defaultManifestPath() {
    return "kofcloud.json"
}

// Resolve o caminho do manifesto: --file quando dado, senao o default.
// Pura, testavel sem HOME/rede (precedente: diffDeployment). Ausente,
// vazio ou so-espacos = default; senao, o valor aparado (precedente:
// resolveStatePath no serve). Sem isso, `--file "   "` pulava o default
// e virava path invalido ("nao encontrado") em vez do manifesto padrao.
String resolveManifestPath(String flagPath) {
    var trimmed = flagPath.trim()
    if (trimmed.length == 0) {
        return defaultManifestPath()
    }
    return trimmed
}

// Resultado de carregar o manifesto: ok=true traz services; ok=false
// traz o erro ja formatado para impressao ("nao encontrado" ou
// "invalido (motivo)"). Pura na decisao (so IO: ler + parsear).
record ManifestLoad(Bool ok, String error, List<ManifestService> services)

ManifestLoad loadManifestFile(String path) {
    var raw = readTextOr(path, "")
    if (raw.length == 0) {
        return ManifestLoad(false, "manifesto nao encontrado: " + path, listOf<ManifestService>())
    }
    try {
        return ManifestLoad(true, "", parseManifest(raw))
    } catch (String e) {
        return ManifestLoad(false, "manifesto invalido (" + path + "): " + e, listOf<ManifestService>())
    }
}

// Health check local pos-deploy: o servico responde no endereco publicado?
//
// Usa a MESMA sonda do Agent (`agent/Health.checkService`): GET / HTTP/1.1
// com prazo, status < 500 = saudavel. Antes era so um connect TCP — medido:
// um servico que responde 500 e um que aceita e NUNCA responde passavam os
// dois como "respondendo", e o `deploy --check` declarava saudavel um deploy
// quebrado (o mesmo defeito que o health do Agent ja tinha corrigido).
// O protocolo do manifesto decide: `http` faz GET; qualquer outro fica no
// connect (nao ha como sondar outro protocolo hoje).
Bool checkLocalService(String address, Int port) {
    return checkLocalServiceFor(address, port, "http")
}

Bool checkLocalServiceFor(String address, Int port, String protocol) {
    var service = Service(
        "local-check", "", "", "local-check", address, port, protocol,
        address + ":" + intToString(port), "PRIVATE", "UNKNOWN", 0L, "", ""
    )
    var status = checkService(service)
    return status == statusOnline()
}

// Diff manifesto x publicado, sem aplicar nada (para `deploy --plan`).
// Pura: recebe as duas listas e devolve linhas legiveis ("+ site" novo,
// "~ site" muda porta/address/exposure, "= site" igual, "! site" nome
// tomado noutro device). Ordem: manifesto primeiro (o que vai acontecer),
// depois extras.
// TODA linha de servico declarado com build carrega " (build)" e com
// artifact carrega " (artifact)" — inclusive "=": o deploy executa o build
// e confere o artifact antes de cada publish (mesmo o idempotente), entao
// "igual" nao significa "nada vai acontecer". O operador ve ANTES de
// aplicar que um comando local sera executado e um arquivo sera conferido
// (o --plan nunca executa nada, so sinaliza).
//
// `expectedDeviceId` (opcional, "" = sem escopo): o manifesto descreve a
// maquina LOCAL. Servico homonimo publicado NOUTRO device nao e "igual"
// (o publish responderia 409) — vira "! nome (conflito: existe no
// dispositivo X)" — e um servico de outro device nao e "fora do manifesto"
// (o `down --prune` nunca toca outro device): nao aparece. Medido nos dois
// casos.
List<String> diffDeployment(List<Service> live, List<ManifestService> wanted) {
    return diffDeploymentFor(live, wanted, "")
}

List<String> diffDeploymentFor(List<Service> live, List<ManifestService> wanted, String expectedDeviceId) {
    var out = listOf<String>()
    for (var item in wanted) {
        var found = false
        var same = false
        var conflictedOn = ""
        for (var service in live) {
            if (service.name == item.name) {
                if (expectedDeviceId.length > 0 && service.deviceId != expectedDeviceId) {
                    conflictedOn = service.deviceId
                } else {
                    found = true
                    if (service.localPort == item.port && service.localAddress == item.address && service.exposure == item.exposure && service.protocol == item.protocol && service.allowMethods == item.allowMethods && service.allowPaths == item.allowPaths) {
                        same = true
                    }
                }
            }
        }
        var buildMark = ""
        if (item.build.trim().length > 0) {
            buildMark = " (build)"
        }
        if (item.artifact.trim().length > 0) {
            buildMark = buildMark + " (artifact)"
        }
        if (found == false && conflictedOn.length > 0) {
            out.add("! " + item.name + buildMark + " (conflito: nome ja usado no dispositivo " + conflictedOn + ")")
        } else if (found == false) {
            out.add("+ " + item.name + buildMark + " (novo: " + item.address + ":" + intToString(item.port) + " " + item.exposure + ")")
        } else if (same) {
            out.add("= " + item.name + buildMark + " (igual)")
        } else {
            out.add("~ " + item.name + buildMark + " (vai atualizar)")
        }
    }
    for (var service in live) {
        // Extra so faz sentido DESTE device: o `down --prune` nunca toca
        // servico de outro device, entao listar como "fora do manifesto"
        // prometia uma remocao que nao acontece.
        if (expectedDeviceId.length > 0 && service.deviceId != expectedDeviceId) {
            continue
        }
        var declared = false
        for (var item in wanted) {
            if (service.name == item.name) {
                declared = true
            }
        }
        if (declared == false) {
            out.add("- " + service.name + " (fora do manifesto; use down --prune para remover)")
        }
    }
    return out
}

// Devolve "" quando nao ha nada a apontar (sem artifact declarado, vazio
// ou so-espacos, ou arquivo com conteudo legivel); senao devolve o problema
// ja formatado `nome: artefato ausente (caminho) — rode: kof cloud deploy`.
// Pura na decisao (so IO: leitura do arquivo); usada pelo deploy pos-build
// (fail-fast) e pelo verifyDeployment (--check/doctor). Precedente:
// runServiceBuild (BuildResult) e diffDeployment (pura + testavel).
// O trim espelha o parseManifest: caminho so-espacos nunca existiria no
// disco e barraria o publish a toa — trata como ausente, sem checar.
// Medido: `File(dir).exists()` e true para DIRETORIO, entao o deploy
// publicava um servico cujo "artefato" era uma pasta; por isso exige-se
// conteudo legivel (`readText()` em dir devolve null), nao so existencia.
String artifactProblem(String serviceName, String artifact) {
    var trimmed = artifact.trim()
    if (trimmed.length == 0 || File(trimmed).readText() != null) {
        return ""
    }
    return serviceName + ": artefato ausente (" + trimmed + ") — rode: kof cloud deploy"
}

// Confere que cada servico do manifesto esta publicado **neste device**
// (existe no control plane para esta conta), COM A MESMA CONFIG (porta/
// address/exposure/protocol/allowMethods/allowPaths) e responde localmente.
// Devolve a lista de problemas `nome: motivo`; vazia = tudo saudavel.
// Drift de config e acusado antes do check de resposta (nao adianta o local
// responder se e outro servico que esta publicado). Por ultimo, o artefato
// declarado (quando ha): arquivo local ausente vira aviso de staleness —
// nunca bloqueio, e nunca antes do publicado/resposta (publicado continua
// sendo o primario).
//
// `expectedDeviceId`: o manifesto descreve a maquina LOCAL (o deploy publica
// com o deviceId da sessao), entao um servico homonimo publicado NOUTRO
// device nao serve como "publicado" — sem essa checagem o `--check`/`doctor`
// davam verde para um deploy que nunca chegou nesta maquina (medido). Vazio
// = sem escopo (comportamento antigo; usado por chamadores que nao tem a
// sessao).
List<String> verifyDeployment(String controlUrl, String token, List<ManifestService> wanted) {
    return verifyDeploymentFor(controlUrl, token, wanted, "")
}

List<String> verifyDeploymentFor(String controlUrl, String token, List<ManifestService> wanted, String expectedDeviceId) {
    var problems = listOf<String>()
    var live = listOf<Service>()
    try {
        live = fetchServices(controlUrl, token)
    } catch (String e) {
        problems.add("control plane: " + e)
        return problems
    }
    for (var service in wanted) {
        var found = false
        var drift = ""
        var otherDevice = ""
        for (var remote in live) {
            if (remote.name == service.name) {
                if (expectedDeviceId.length > 0 && remote.deviceId != expectedDeviceId) {
                    // Homonimo/legado noutro device: nao conta como publicado
                    // AQUI (o manifesto descreve esta maquina).
                    otherDevice = remote.deviceId
                } else {
                    found = true
                    if (remote.localPort != service.port) {
                        drift = "porta " + intToString(remote.localPort) + " != " + intToString(service.port)
                    } else if (remote.localAddress != service.address) {
                        drift = "address " + remote.localAddress + " != " + service.address
                    } else if (remote.exposure != service.exposure) {
                        drift = "exposure " + remote.exposure + " != " + service.exposure
                    } else if (remote.protocol != service.protocol) {
                        drift = "protocol " + remote.protocol + " != " + service.protocol
                    } else if (remote.allowMethods != service.allowMethods) {
                        drift = "allowMethods " + remote.allowMethods + " != " + service.allowMethods
                    } else if (remote.allowPaths != service.allowPaths) {
                        drift = "allowPaths " + remote.allowPaths + " != " + service.allowPaths
                    }
                }
            }
        }
        if (found == false && otherDevice.length > 0) {
            problems.add(service.name + ": publicado no dispositivo " + otherDevice + ", nao neste — rode: kof cloud deploy")
        } else if (found == false) {
            problems.add(service.name + ": nao publicado")
        } else if (drift.length > 0) {
            problems.add(service.name + ": publicado com config diferente (" + drift + ") — rode: kof cloud deploy")
        } else if (checkLocalServiceFor(service.address, service.port, service.protocol) == false) {
            problems.add(service.name + ": publicado mas sem resposta em " + service.address + ":" + intToString(service.port))
        } else {
            var missing = artifactProblem(service.name, service.artifact)
            if (missing.length > 0) {
                problems.add(missing)
            }
        }
    }
    return problems
}

// Parse com erros honestos de CLI (mensagem + uso, sem codigo KCF — KCF e
// para erros da plataforma via API, nao para manifesto local malformado).
// `port` aceita numero ou string (o control plane usa strings, mas manifesto
// com numero e o idiomatico em JSON); o resto tem defaults de `publish`.
// Varredura de segredos no manifesto (Fase 19 slice 2 parcial): texto cru,
// por servico. Segredo em QUALQUER campo e achado (o manifesto so declara
// nome/porta/address/exposure/protocol/build/artifact/allowlist — nenhum
// deles deve conter credencial). Pura, sem IO: o cmdScan le o arquivo e
// formata. Nunca imprime o valor — so o campo e o servico.
List<String> scanManifestSecrets(String raw) {
    var findings = listOf<String>()
    var trimmed = raw.trim()
    if (trimmed.length == 0) {
        return findings
    }
    var index = 0
    for (var entry in splitManifestObjects(manifestArray(trimmed))) {
        var name = manifestField(entry, "name").trim()
        if (name.length == 0) {
            name = "#" + intToString(index)
        }
        if (entry.indexOf("kfs_") >= 0 || entry.indexOf("kfc_") >= 0 || entry.indexOf("password") >= 0) {
            findings.add("servico \"" + name + "\": possivel segredo no manifesto (kfs_/kfc_/password) — remova antes do commit")
        }
        index = index + 1
    }
    return findings
}

// Nomes de variavel de ambiente que, se definidos, indicam credencial no
// ambiente do shell (o Kof nao enumera env: `config.env(nome)` le um nome
// por vez — por isso a lista e curada, nao uma varredura de tudo).
List<String> sensitiveEnvNames() {
    return listOf(
        "KOFCLOUD_TOKEN", "KOFCLOUD_SECRET", "KOFCLOUD_TUNNEL_SECRET",
        "KFS_TOKEN", "KFC_TOKEN", "GITHUB_TOKEN", "GH_TOKEN",
        "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN",
        "DATABASE_URL", "DB_PASSWORD", "PGPASSWORD", "MYSQL_PWD"
    )
}

// Varredura de segredos no ambiente (Fase 19 slice 2). Recebe pares
// "NOME=valor" ja coletados (puro: sem IO, testavel sem env real). Achado
// quando o NOME e sensivel e tem valor, ou quando QUALQUER valor carrega
// kfs_/kfc_/password. Nunca imprime o valor — so o nome.
List<String> scanEnvSecrets(List<String> pairs) {
    var findings = listOf<String>()
    var sensitive = sensitiveEnvNames()
    for (var pair in pairs) {
        var eq = pair.indexOf("=")
        if (eq <= 0) {
            continue
        }
        var name = pair.substring(0, eq)
        var value = pair.substring(eq + 1)
        if (value.length == 0) {
            continue
        }
        if (sensitive.contains(name)) {
            findings.add("ambiente: " + name + " esta definida (valor nao exibido) — prefira `secrets.get`/kof.config")
        } else if (value.indexOf("kfs_") >= 0 || value.indexOf("kfc_") >= 0 || value.indexOf("password") >= 0) {
            findings.add("ambiente: " + name + " parece conter credencial (valor nao exibido)")
        }
    }
    return findings
}

// Coleta os pares "NOME=valor" dos nomes sensiveis definidos no processo.
// IO (config.env) fica aqui; a decisao e scanEnvSecrets.
List<String> collectSensitiveEnv() {
    var out = listOf<String>()
    for (var name in sensitiveEnvNames()) {
        var value = config.env(name)
        if (value != null) {
            out.add(name + "=" + value)
        }
    }
    return out
}

List<ManifestService> parseManifest(String raw) {
    var trimmed = raw.trim()
    if (trimmed.length == 0) {
        throw "manifesto vazio"
    }
    var servicesRaw = manifestArray(trimmed)
    var out = listOf<ManifestService>()
    var index = 0
    for (var entry in splitManifestObjects(servicesRaw)) {
        // Trim nos campos de texto: JSON permite "  site  " e o manifesto e
        // escrito a mao — espacos sobrando nao devem virar nome com espaco,
        // nem " PUBLIC " falhar como exposure invalida quando o usuario
        // claramente quis dizer PUBLIC. Mesma regra do build/artifact
        // (commit do trim): aparado no parse, erro posicional honesto segue
        // mostrando o valor aparado.
        var name = manifestField(entry, "name").trim()
        var port = parsePortSafe(manifestField(entry, "port"), 0)
        var address = manifestField(entry, "address").trim()
        if (address.length == 0) {
            address = defaultLocalAddress()
        }
        // So loopback: o Agent conecta nesse endereco a cada request —
        // qualquer outro valor o transformaria num escaneador da rede
        // local via tunel publico (SSRF). Falha posicional no parse.
        if (validLocalAddress(address) == false) {
            throw "servico \"" + name + "\" com address invalido: " + address
        }
        var exposure = manifestField(entry, "exposure").trim()
        if (exposure.length == 0) {
            exposure = defaultExposure()
        }
        // Sem default silencioso para valor desconhecido: `exposureFrom`
        // cairia para PUBLIC e um typo ("PUBLIK") exporia o que devia ser
        // PRIVATE. Falha posicional, como nome e porta.
        if (exposureIsKnown(exposure) == false) {
            throw "servico \"" + name + "\" com exposure invalida: " + exposure
        }
        // Mesma regra da API (KCF046): o tunel do MVP so fala HTTP. Falha
        // posicional no parse, antes de publicar qualquer coisa.
        var protocol = manifestField(entry, "protocol").trim()
        if (protocol.length == 0) {
            protocol = defaultProtocol()
        }
        if (protocolIsSupported(protocol) == false) {
            throw "servico \"" + name + "\" com protocol invalido: " + protocol
        }
        // Build opcional (Fase 7, slice 5): comando de shell rodado pelo
        // `deploy` ANTES do publish (ex.: "npm run build", "make dist").
        // Ausente = sem build (comportamento atual, inalterado); presente e
        // executado como esta — sem sandbox no MVP (mesma confianca do
        // `connect` local). Vazio ou so-espacos ("", "   ") equivale a
        // ausente (trim no parse: shell ignora espacos sobrando, e o plan
        // nao deve marcar "(build)" por espacos).
        var build = manifestField(entry, "build").trim()
        // Artefato opcional (Fase 7, slice 5 passo 3): caminho local que o
        // `deploy --check` (e o `doctor`, via verifyDeployment) confere —
        // ex.: "dist/index.html" depois de "npm run build". Ausente, vazio
        // ou so-espacos = sem checagem (comportamento atual, inalterado).
        // E so um aviso de staleness ("o arquivo sumiu? rode o deploy de
        // novo"), nunca bloqueio: o check nao sabe reconstruir, so apontar.
        // Trim no parse: caminho com espaco sobrando nunca existiria no
        // disco e barraria o publish a toa (fail-fast do passo 5).
        var artifact = manifestField(entry, "artifact").trim()
        // Allowlist WAF (Fase 10 slice 3): mesma regra da API (`POST
        // /v1/services` — `ControlPlane.kf` normaliza com as mesmas funcoes).
        // Ausente/vazio = sem restricao (servico legado passa); presente e
        // normalizado (espacos aparados, repeticao removida); malformado
        // falha posicional no parse (metodo fora da comparacao exata nunca
        // casaria — nao publica uma regra morta). KCF113/KCF114 continuam
        // sendo o erro da API para quem publica fora do deploy.
        var allowMethodsRaw = manifestField(entry, "allowMethods").trim()
        var allowMethods = normalizeAllowMethods(allowMethodsRaw, httpVerbs())
        if (allowMethods.length == 0 && allowMethodsRaw.length > 0) {
            throw "servico \"" + name + "\" com allowMethods invalido: " + allowMethodsRaw
        }
        var allowPathsRaw = manifestField(entry, "allowPaths").trim()
        var allowPaths = normalizeAllowPaths(allowPathsRaw)
        if (allowPaths.length == 0 && allowPathsRaw.length > 0) {
            throw "servico \"" + name + "\" com allowPaths invalido: " + allowPathsRaw
        }
        if (name.length == 0) {
            throw "servico sem nome na posicao " + intToString(index)
        }
        if (port <= 0 || port > 65535) {
            throw "servico \"" + name + "\" sem porta valida (1-65535)"
        }
        // Nome repetido e ambiguidade, nao "dois servicos": o publish e
        // idempotente por nome (`serviceByName` devolve o existente), entao o
        // segundo item reescreveria a config do primeiro em silencio e o
        // usuario ficaria com uma porta so, sem saber qual. Falha posicional
        // antes de qualquer build/publish (mesma familia de nome/porta/
        // exposure/protocol/allowlist).
        for (var seen in out) {
            if (seen.name == name) {
                throw "servico \"" + name + "\" duplicado no manifesto (posicao " + intToString(index) + ") — cada nome publica um servico so"
            }
        }
        out.add(ManifestService(name, address, port, exposure, protocol, build, artifact, allowMethods, allowPaths))
        index = index + 1
    }
    if (out.size == 0) {
        throw "manifesto sem servicos"
    }
    return out
}

// Extrai o array da chave "services" respeitando strings (nao confunde
// chave dentro de valor). Devolve o texto interno (sem os colchetes).
String manifestArray(String root) {
    var key = "\"services\""
    var at = root.indexOf(key)
    if (at < 0) {
        throw "manifesto sem lista \"services\""
    }
    var i = at + key.length
    while (i < root.length && root.charAt(i) != 58) {
        i = i + 1
    }
    if (i >= root.length) {
        throw "manifesto sem lista \"services\""
    }
    i = i + 1
    while (i < root.length && (root.charAt(i) == 32 || root.charAt(i) == 10 || root.charAt(i) == 13 || root.charAt(i) == 9)) {
        i = i + 1
    }
    if (i >= root.length || root.charAt(i) != 91) {
        throw "lista \"services\" nao e um array JSON"
    }
    var depth = 0
    var inString = false
    var escaped = false
    var start = i
    while (i < root.length) {
        var c = root.charAt(i)
        if (inString) {
            if (escaped) {
                escaped = false
            } else if (c == 92) {
                escaped = true
            } else if (c == 34) {
                inString = false
            }
        } else {
            if (c == 34) {
                inString = true
            } else if (c == 91) {
                depth = depth + 1
            } else if (c == 93) {
                depth = depth - 1
                if (depth == 0) {
                    return root.substring(start + 1, i)
                }
            }
        }
        i = i + 1
    }
    throw "lista \"services\" malformada"
}

// Divide o interior do array em objetos (texto), respeitando strings e
// escapes — chaves e colchetes dentro de valores nao quebram o split.
List<String> splitManifestObjects(String inner) {
    var out = listOf<String>()
    if (inner.trim().length == 0) {
        return out
    }
    var depth = 0
    var inString = false
    var escaped = false
    var current = ""
    for (var i = 0; i < inner.length; i++) {
        var c = inner.charAt(i)
        if (inString) {
            if (escaped) {
                escaped = false
            } else if (c == 92) {
                escaped = true
            } else if (c == 34) {
                inString = false
            }
        } else {
            if (c == 34) {
                inString = true
            } else if (c == 123) {
                depth = depth + 1
            } else if (c == 125) {
                depth = depth - 1
            }
        }
        current = current + (c as Char)
        if (depth == 0 && inString == false) {
            var trimmed = current.trim()
            if (trimmed.length == 0 || trimmed == ",") {
                // Separador entre objetos (virgula, espacos): descarta, sem
                // tentar extrair. Sem isso, a virgula contaminaria o proximo
                // piece e nada seria extraido.
                current = ""
            } else {
                var piece = trimmed
                if (piece.endsWith(",")) {
                    piece = piece.substring(0, piece.length - 1).trim()
                }
                if (piece.startsWith("{") && piece.endsWith("}")) {
                    out.add(piece)
                    current = ""
                }
            }
        }
        if (depth < 0) {
            throw "lista \"services\" malformada"
        }
    }
    if (current.trim().length > 0 || depth != 0 || inString) {
        throw "lista \"services\" malformada"
    }
    return out
}

// Le um campo de um objeto JSON plano: string ("...") com escapes basicos
// ou numero/bool puro (devolvido como texto). Busca a chave com aspas
// exatas, entao "port" nao casa com "portaria".
String manifestField(String entry, String key) {
    var needle = "\"" + key + "\""
    var at = entry.indexOf(needle)
    if (at < 0) {
        return ""
    }
    var i = at + needle.length
    while (i < entry.length && entry.charAt(i) != 58) {
        i = i + 1
    }
    if (i >= entry.length) {
        return ""
    }
    i = i + 1
    while (i < entry.length && (entry.charAt(i) == 32 || entry.charAt(i) == 10 || entry.charAt(i) == 13 || entry.charAt(i) == 9)) {
        i = i + 1
    }
    if (i >= entry.length) {
        return ""
    }
    if (entry.charAt(i) == 34) {
        var out = ""
        var escaped = false
        var j = i + 1
        while (j < entry.length) {
            var c = entry.charAt(j)
            if (escaped) {
                if (c == 34 || c == 92) {
                    out = out + (c as Char)
                } else {
                    out = out + (92 as Char) + (c as Char)
                }
                escaped = false
            } else if (c == 92) {
                escaped = true
            } else if (c == 34) {
                return out
            } else {
                out = out + (c as Char)
            }
            j = j + 1
        }
        return ""
    }
    var num = ""
    var k = i
    while (k < entry.length) {
        var d = entry.charAt(k)
        if ((d >= 48 && d <= 57) || d == 45 || d == 43 || d == 46) {
            num = num + (d as Char)
        } else {
            break
        }
        k = k + 1
    }
    return num
}

Int cmdDeploy(List<String> args) {
    if (extraPositional(args, 0) || flagMissingValue(args, "--file") || flagDuplicated(args, "--file")) {
        println("uso: kof cloud deploy [--file <caminho>] [--check] [--plan]")
        return 1
    }
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var identity = loadIdentity()
    if (identity == null) {
        println(notLoggedInLine())
        return 1
    }
    var path = resolveManifestPath(flagValue(args, "--file"))
    var loaded = loadManifestFile(path)
    if (loaded.ok == false) {
        println(loaded.error)
        println("uso: kof cloud deploy [--file <caminho>]")
        if (loaded.error.indexOf("invalido") >= 0) {
            println("Hint: confira o exemplo em docs/09-flows.md")
        }
        return 1
    }
    var services = loaded.services
    // --plan: mostra o diff sem aplicar nada (como `terraform plan`).
    // Puro depois do fetch: nenhuma escrita, nenhum publish.
    if (hasFlag(args, "--plan")) {
        try {
            var live = fetchServices(session.controlUrl, session.token)
            var plan = diffDeploymentFor(live, services, identity.deviceId)
            if (plan.size == 0) {
                println("plan: nada a fazer (manifesto vazio não chega aqui — parse recusaria)")
            }
            for (var line in plan) {
                println("plan: " + line)
            }
            return 0
        } catch (String e) {
            printFail("falha", e)
            return 1
        }
    }
    var failures = 0
    for (var wanted in services) {
        // Build antes do publish (Fase 7, slice 5): gera o artefato local
        // antes de expor. Falhou = nao publica esse servico (fail-fast por
        // servico: os demais seguem; o parcial aparece no relatorio).
        // Mesmo com o trim do parse, checa espacos aqui (defesa em
        // profundidade: ManifestService pode vir de outra via no futuro).
        if (wanted.build.trim().length > 0) {
            var built = runServiceBuild(wanted.build)
            if (built.ok == false) {
                printFail("falha no build de " + wanted.name, built.detail)
                failures = failures + 1
                continue
            }
            println("build ok: " + wanted.name)
        }
        // Artefato declarado: confere logo apos o build, antes do publish
        // (fail-fast — um typo no caminho nao vira servico publicado sem
        // o arquivo que o --check cobraria depois). Mesma funcao do check.
        var missing = artifactProblem(wanted.name, wanted.artifact)
        if (missing.length > 0) {
            printFail("falha no artefato de " + wanted.name, wanted.artifact + " nao existe")
            failures = failures + 1
            continue
        }
        var body = mapOf()
        body.put("deviceId", identity.deviceId)
        body.put("name", wanted.name)
        body.put("localAddress", wanted.address)
        body.put("localPort", intToString(wanted.port))
        body.put("protocol", wanted.protocol)
        body.put("exposure", wanted.exposure)
        body.put("allowMethods", wanted.allowMethods)
        body.put("allowPaths", wanted.allowPaths)
        try {
            var created = requireOk(http.post(session.controlUrl + "/v1/services", json.encode(body), jsonHeader(session.token)))
            var service = json.decode<Service>(created)
            println("publicado: " + service.name + " -> https://" + service.hostname + " [" + service.exposure + "]")
        } catch (String e) {
            printFail("falha ao publicar " + wanted.name, e)
            failures = failures + 1
        }
    }
    if (failures > 0) {
        println("deploy parcial: " + intToString(failures) + " falha(s)")
        return 1
    }
    println("deploy ok: " + intToString(services.size) + " servico(s)")
    // Verificacao pos-deploy (slice 2): confirma que cada servico esta
    // publicado E responde localmente. Nao e rollback — so diagnostico.
    if (hasFlag(args, "--check") == false) {
        return 0
    }
    var problems = verifyDeploymentFor(session.controlUrl, session.token, services, identity.deviceId)
    if (problems.size == 0) {
        println("check ok: " + intToString(services.size) + " servico(s) publicados e respondendo")
        return 0
    }
    for (var problem in problems) {
        println("check: " + problem)
    }
    println("Hint: suba o servico local na porta do manifesto e rode `kof cloud deploy` de novo")
    return 1
}

// Id do servico `name` publicado NESTE device ("" = nao ha). Pura: o
// `down` resolve o alvo dentro do device da sessao, nunca na conta toda —
// o manifesto descreve esta maquina. Medido: sem o filtro, um down no
// notebookA removia o "site" do notebookB.
String serviceIdOnDevice(List<Service> live, String name, String deviceId) {
    for (var service in live) {
        if (service.name == name && service.deviceId == deviceId) {
            return service.id
        }
    }
    return ""
}

// Device onde `name` esta publicado FORA do device do chamador ("" = nao
// esta em outro). Separado de `serviceIdOnDevice` para o `down` distinguir
// "nao existe" de "existe la" — as duas coisas imprimiam "ausente (ok)".
String serviceDeviceElsewhere(List<Service> live, String name, String deviceId) {
    for (var service in live) {
        if (service.name == name && service.deviceId != deviceId) {
            return service.deviceId
        }
    }
    return ""
}

// Mensagem do `down` quando o servico do manifesto vive noutro device
// (fonte unica, como serviceNotFoundLine): nomeia o servico e o device, e
// diz que a remocao tem de ser feita la.
String downElsewhereLine(String name, String deviceId) {
    return "noutro dispositivo (nao removido): " + name + " (device " + deviceId + ") — rode o down la"
}

Int cmdDown(List<String> args) {
    if (extraPositional(args, 0) || flagMissingValue(args, "--file") || flagDuplicated(args, "--file")) {
        println("uso: kof cloud down [--file <caminho>] [--prune]")
        return 1
    }
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var identity = loadIdentity()
    if (identity == null) {
        println(notLoggedInLine())
        return 1
    }
    var path = resolveManifestPath(flagValue(args, "--file"))
    var loaded = loadManifestFile(path)
    if (loaded.ok == false) {
        println(loaded.error)
        return 1
    }
    var services = loaded.services
    var prune = hasFlag(args, "--prune")
    var failures = 0
    try {
        var live = fetchServices(session.controlUrl, session.token)
        for (var wanted in services) {
            // Decisao pura (testavel sem rede): alvo DESTE device, ou o
            // device alheio onde o nome vive, ou nenhum dos dois.
            var target = serviceIdOnDevice(live, wanted.name, identity.deviceId)
            var elsewhere = serviceDeviceElsewhere(live, wanted.name, identity.deviceId)
            if (target.length == 0 && elsewhere.length > 0) {
                // Existe, mas noutro dispositivo: nao e "ausente" e o down
                // nao o toca (o manifesto descreve esta maquina). Dizer
                // "ausente (ok)" escondia que o servico continua publicado
                // em outro lugar com o mesmo hostname.
                println(downElsewhereLine(wanted.name, elsewhere))
            } else if (target.length == 0) {
                println("ausente (ok): " + wanted.name)
            } else {
                var body = mapOf()
                body.put("serviceId", target)
                try {
                    requireOk(http.post(session.controlUrl + "/v1/services/remove", json.encode(body), jsonHeader(session.token)))
                    println("removido: " + wanted.name)
                } catch (String e) {
                    printFail("falha ao remover " + wanted.name, e)
                    failures = failures + 1
                }
            }
        }
        // --prune fecha o drift: remove publicados DESTE device que nao
        // estao no manifesto (ex.: publish manual antigo). Escopo: so o
        // device atual (nunca toca servico de outro device) e so o que
        // nao foi declarado (nunca remove a mais do que o diff).
        if (prune) {
            var pruned = 0
            for (var service in live) {
                if (service.deviceId != identity.deviceId) {
                    continue
                }
                var declared = false
                for (var wanted in services) {
                    if (service.name == wanted.name) {
                        declared = true
                    }
                }
                if (declared == false) {
                    var body = mapOf()
                    body.put("serviceId", service.id)
                    try {
                        requireOk(http.post(session.controlUrl + "/v1/services/remove", json.encode(body), jsonHeader(session.token)))
                        println("podado (fora do manifesto): " + service.name)
                        pruned = pruned + 1
                    } catch (String e) {
                        printFail("falha ao podar " + service.name, e)
                        failures = failures + 1
                    }
                }
            }
            println("prune: " + intToString(pruned) + " orfao(s) removidos")
        }
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
    if (failures > 0) {
        return 1
    }
    println("down ok: " + intToString(services.size) + " servico(s) do manifesto removidos")
    return 0
}

// Varredura local de segredos (Fase 19 slice 2 parcial): `kof cloud scan`
// le o manifesto e acusa credencial literal ANTES do commit/deploy — sem
// login, sem rede. Local por desenho: o que esta no disco e o que pode
// vazar no git. Exit 1 com achado (falha o CI), 0 limpo.
Int cmdScan(List<String> args) {
    if (extraPositional(args, 0) || flagMissingValue(args, "--file") || flagDuplicated(args, "--file") || flagMissingValue(args, "--tls-cert") || flagDuplicated(args, "--tls-cert")) {
        println("uso: kof cloud scan [--file <caminho>] [--tls-cert <pem>]")
        return 1
    }
    var findings = listOf<String>()
    // 1) Manifesto (segredos literais).
    var path = resolveManifestPath(flagValue(args, "--file"))
    var raw = readTextOr(path, "")
    if (raw.length == 0) {
        println("manifesto nao encontrado: " + path)
        return 1
    }
    for (var finding in scanManifestSecrets(raw)) {
        findings.add(finding)
    }
    // 2) Ambiente do processo (nomes sensiveis definidos).
    for (var finding in scanEnvSecrets(collectSensitiveEnv())) {
        findings.add(finding)
    }
    // 3) PEM do operador: expirado ou expirando em 30 dias (aviso, nao erro
    //    de configuracao — o serve tambem so avisa).
    var certPath = flagValue(args, "--tls-cert").trim()
    if (certPath.length > 0) {
        if (fileExists(certPath) == false) {
            findings.add("tls: certificado nao encontrado: " + certPath)
        } else {
            var check = process.run("openssl", "x509", "-in", certPath, "-noout", "-checkend", tlsCheckendWindowSec())
            if (tlsCertExpiringSoon(check.exitCode)) {
                findings.add("tls: " + certPath + " expira em menos de 30 dias (ou nao e um PEM valido) — renove antes do vencimento")
            }
        }
    }
    if (findings.size == 0) {
        println("scan ok: nenhum segredo no manifesto/ambiente e nenhum PEM expirando")
        return 0
    }
    for (var finding in findings) {
        println(finding)
    }
    return 1
}
