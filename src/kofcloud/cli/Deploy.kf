package kofcloud.cli

import kofcloud.cli.Commands
import kofcloud.cli.Local
import kofcloud.model.Errors
import kofcloud.model.Service
import kofcloud.util.Hosts
import kofcloud.util.Text
import kofcloud.store.Store

// Deploy declarativo (Fase 7, slice 1): publica o que esta no manifesto e
// nada alem dele. Sem build, sem transferencia de artefato, sem daemon — so
// `publish` em lote sobre as primitivas existentes (identity + device +
// tunnel + service). O `down` faz o inverso. Nao destroi nada fora do
// manifesto: deploy nunca remove servico que ele nao declarou.
//
// Manifesto (`kofcloud.json`, `--file` para outro caminho):
//   {"services": [{"name": "site", "port": 8080,
//                  "address": "127.0.0.1", "exposure": "PUBLIC"}]}
// `address` defaulta para 127.0.0.1 e `exposure` para PUBLIC — os mesmos
// defaults do `publish`.

record ManifestService(String name, String address, Int port, String exposure, String protocol, String build)

// Resultado de rodar o build de UM servico: ok=true, comando executado;
// ok=false traz o motivo ja formatado ("falhou (exit N)" ou "nao executou").
// Pura na decisao (so IO: executa o comando via process.run). Comando vazio
// (sem "build" no manifesto) = skip honesto, nao executa nada.
record BuildResult(Bool ok, String detail)

BuildResult runServiceBuild(String buildCmd) {
    if (buildCmd.length == 0) {
        return BuildResult(true, "sem build")
    }
    try {
        var result = process.run(buildCmd)
        if (result.exitCode == 0) {
            return BuildResult(true, "ok")
        }
        return BuildResult(false, "build falhou (exit " + intToString(result.exitCode) + ")")
    } catch (String e) {
        return BuildResult(false, "build nao executou: " + e)
    }
}

String defaultManifestPath() {
    return "kofcloud.json"
}

// Resolve o caminho do manifesto: --file quando dado, senao o default.
// Pura, testavel sem HOME/rede (precedente: diffDeployment).
String resolveManifestPath(String flagPath) {
    if (flagPath.length == 0) {
        return defaultManifestPath()
    }
    return flagPath
}

// Resultado de carregar o manifesto: ok=true traz services; ok=false
// traz o erro ja formatado para impressao ("nao encontrado" ou
// "invalido (motivo)"). Pura na decisao (so IO: ler + parsear).
record ManifestLoad(Bool ok, String error, List<ManifestService> services)

ManifestLoad loadManifestFile(String path) {
    var raw = readTextOr(path, "")
    if (raw.length == 0) {
        return ManifestLoad(false, "manifesto nao encontrado: " + path, listOf<ManifestService>())
    }
    try {
        return ManifestLoad(true, "", parseManifest(raw))
    } catch (String e) {
        return ManifestLoad(false, "manifesto invalido (" + path + "): " + e, listOf<ManifestService>())
    }
}

// Health check local pos-deploy: o servico responde no endereco publicado?
// Mesma regra do Agent (agent/Health.kf): TCP bem-sucedido = ok. Nao usa o
// Agent nem o tunel — e uma verificacao da maquina do usuario contra ela
// mesma, antes de declarar o deploy saudavel.
Bool checkLocalService(String address, Int port) {
    try {
        var conn = net.connect(address, port)
        conn.close()
        return true
    } catch (String e) {
        return false
    }
}

// Diff manifesto x publicado, sem aplicar nada (para `deploy --plan`).
// Pura: recebe as duas listas e devolve linhas legiveis ("+ site" novo,
// "~ site" muda porta/address/exposure, "= site" igual). `live` deve vir
// filtrado pelo chamador (conta atual; device atual se quiser escopo).
// Ordem: manifesto primeiro (o que vai acontecer), depois extras.
// Linhas "+" e "~" carregam " (build)" quando o servico declara build — o
// operador ve ANTES de aplicar que o deploy vai executar um comando local
// (o --plan nunca executa nada, so sinaliza).
List<String> diffDeployment(List<Service> live, List<ManifestService> wanted) {
    var out = listOf<String>()
    for (var item in wanted) {
        var found = false
        var same = false
        for (var service in live) {
            if (service.name == item.name) {
                found = true
                if (service.localPort == item.port && service.localAddress == item.address && service.exposure == item.exposure && service.protocol == item.protocol) {
                    same = true
                }
            }
        }
        var buildMark = ""
        if (item.build.length > 0) {
            buildMark = " (build)"
        }
        if (found == false) {
            out.add("+ " + item.name + buildMark + " (novo: " + item.address + ":" + intToString(item.port) + " " + item.exposure + ")")
        } else if (same) {
            out.add("= " + item.name + " (igual)")
        } else {
            out.add("~ " + item.name + buildMark + " (vai atualizar)")
        }
    }
    for (var service in live) {
        var declared = false
        for (var item in wanted) {
            if (service.name == item.name) {
                declared = true
            }
        }
        if (declared == false) {
            out.add("- " + service.name + " (fora do manifesto; use down --prune para remover)")
        }
    }
    return out
}

// Confere que cada servico do manifesto esta publicado (existe no control
// plane para esta conta), COM A MESMA CONFIG (porta/address/exposure/
// protocol) e responde localmente. Devolve a lista de problemas
// `nome: motivo`; vazia = tudo saudavel. Drift de config e acusado antes
// do check de resposta (nao adianta o local responder se e outro servico
// que esta publicado).
List<String> verifyDeployment(String controlUrl, String token, List<ManifestService> wanted) {
    var problems = listOf<String>()
    var live = listOf<Service>()
    try {
        live = fetchServices(controlUrl, token)
    } catch (String e) {
        problems.add("control plane: " + e)
        return problems
    }
    for (var service in wanted) {
        var found = false
        var drift = ""
        for (var remote in live) {
            if (remote.name == service.name) {
                found = true
                if (remote.localPort != service.port) {
                    drift = "porta " + intToString(remote.localPort) + " != " + intToString(service.port)
                } else if (remote.localAddress != service.address) {
                    drift = "address " + remote.localAddress + " != " + service.address
                } else if (remote.exposure != service.exposure) {
                    drift = "exposure " + remote.exposure + " != " + service.exposure
                } else if (remote.protocol != service.protocol) {
                    drift = "protocol " + remote.protocol + " != " + service.protocol
                }
            }
        }
        if (found == false) {
            problems.add(service.name + ": nao publicado")
        } else if (drift.length > 0) {
            problems.add(service.name + ": publicado com config diferente (" + drift + ") — rode: kof cloud deploy")
        } else if (checkLocalService(service.address, service.port) == false) {
            problems.add(service.name + ": publicado mas sem resposta em " + service.address + ":" + intToString(service.port))
        }
    }
    return problems
}

// Parse com erros honestos de CLI (mensagem + uso, sem codigo KCF — KCF e
// para erros da plataforma via API, nao para manifesto local malformado).
// `port` aceita numero ou string (o control plane usa strings, mas manifesto
// com numero e o idiomatico em JSON); o resto tem defaults de `publish`.
List<ManifestService> parseManifest(String raw) {
    var trimmed = raw.trim()
    if (trimmed.length == 0) {
        throw "manifesto vazio"
    }
    var servicesRaw = manifestArray(trimmed)
    var out = listOf<ManifestService>()
    var index = 0
    for (var entry in splitManifestObjects(servicesRaw)) {
        var name = manifestField(entry, "name")
        var port = parseIntSafe(manifestField(entry, "port"), 0)
        var address = manifestField(entry, "address")
        if (address.length == 0) {
            address = "127.0.0.1"
        }
        // So loopback: o Agent conecta nesse endereco a cada request —
        // qualquer outro valor o transformaria num escaneador da rede
        // local via tunel publico (SSRF). Falha posicional no parse.
        if (validLocalAddress(address) == false) {
            throw "servico \"" + name + "\" com address invalido: " + address
        }
        var exposure = manifestField(entry, "exposure")
        if (exposure.length == 0) {
            exposure = "PUBLIC"
        }
        // Sem default silencioso para valor desconhecido: `exposureFrom`
        // cairia para PUBLIC e um typo ("PUBLIK") exporia o que devia ser
        // PRIVATE. Falha posicional, como nome e porta.
        if (exposure != "PUBLIC" && exposure != "AUTHENTICATED" && exposure != "PRIVATE") {
            throw "servico \"" + name + "\" com exposure invalida: " + exposure
        }
        // Mesma regra da API (KCF046): o tunel do MVP so fala HTTP. Falha
        // posicional no parse, antes de publicar qualquer coisa.
        var protocol = manifestField(entry, "protocol")
        if (protocol.length == 0) {
            protocol = "http"
        }
        if (protocol != "http") {
            throw "servico \"" + name + "\" com protocol invalido: " + protocol
        }
        // Build opcional (Fase 7, slice 5): comando de shell rodado pelo
        // `deploy` ANTES do publish (ex.: "npm run build", "make dist").
        // Ausente = sem build (comportamento atual, inalterado); presente e
        // executado como esta — sem sandbox no MVP (mesma confianca do
        // `connect` local). Vazio ("" explicito) equivale a ausente.
        var build = manifestField(entry, "build")
        if (name.length == 0) {
            throw "servico sem nome na posicao " + intToString(index)
        }
        if (port <= 0 || port > 65535) {
            throw "servico \"" + name + "\" sem porta valida (1-65535)"
        }
        out.add(ManifestService(name, address, port, exposure, protocol, build))
        index = index + 1
    }
    if (out.size == 0) {
        throw "manifesto sem servicos"
    }
    return out
}

// Extrai o array da chave "services" respeitando strings (nao confunde
// chave dentro de valor). Devolve o texto interno (sem os colchetes).
String manifestArray(String root) {
    var key = "\"services\""
    var at = root.indexOf(key)
    if (at < 0) {
        throw "manifesto sem lista \"services\""
    }
    var i = at + key.length
    while (i < root.length && root.charAt(i) != 58) {
        i = i + 1
    }
    if (i >= root.length) {
        throw "manifesto sem lista \"services\""
    }
    i = i + 1
    while (i < root.length && (root.charAt(i) == 32 || root.charAt(i) == 10 || root.charAt(i) == 13 || root.charAt(i) == 9)) {
        i = i + 1
    }
    if (i >= root.length || root.charAt(i) != 91) {
        throw "lista \"services\" nao e um array JSON"
    }
    var depth = 0
    var inString = false
    var escaped = false
    var start = i
    while (i < root.length) {
        var c = root.charAt(i)
        if (inString) {
            if (escaped) {
                escaped = false
            } else if (c == 92) {
                escaped = true
            } else if (c == 34) {
                inString = false
            }
        } else {
            if (c == 34) {
                inString = true
            } else if (c == 91) {
                depth = depth + 1
            } else if (c == 93) {
                depth = depth - 1
                if (depth == 0) {
                    return root.substring(start + 1, i)
                }
            }
        }
        i = i + 1
    }
    throw "lista \"services\" malformada"
}

// Divide o interior do array em objetos (texto), respeitando strings e
// escapes — chaves e colchetes dentro de valores nao quebram o split.
List<String> splitManifestObjects(String inner) {
    var out = listOf<String>()
    if (inner.trim().length == 0) {
        return out
    }
    var depth = 0
    var inString = false
    var escaped = false
    var current = ""
    for (var i = 0; i < inner.length; i++) {
        var c = inner.charAt(i)
        if (inString) {
            if (escaped) {
                escaped = false
            } else if (c == 92) {
                escaped = true
            } else if (c == 34) {
                inString = false
            }
        } else {
            if (c == 34) {
                inString = true
            } else if (c == 123) {
                depth = depth + 1
            } else if (c == 125) {
                depth = depth - 1
            }
        }
        current = current + (c as Char)
        if (depth == 0 && inString == false) {
            var trimmed = current.trim()
            if (trimmed.length == 0 || trimmed == ",") {
                // Separador entre objetos (virgula, espacos): descarta, sem
                // tentar extrair. Sem isso, a virgula contaminaria o proximo
                // piece e nada seria extraido.
                current = ""
            } else {
                var piece = trimmed
                if (piece.endsWith(",")) {
                    piece = piece.substring(0, piece.length - 1).trim()
                }
                if (piece.startsWith("{") && piece.endsWith("}")) {
                    out.add(piece)
                    current = ""
                }
            }
        }
        if (depth < 0) {
            throw "lista \"services\" malformada"
        }
    }
    if (current.trim().length > 0 || depth != 0 || inString) {
        throw "lista \"services\" malformada"
    }
    return out
}

// Le um campo de um objeto JSON plano: string ("...") com escapes basicos
// ou numero/bool puro (devolvido como texto). Busca a chave com aspas
// exatas, entao "port" nao casa com "portaria".
String manifestField(String entry, String key) {
    var needle = "\"" + key + "\""
    var at = entry.indexOf(needle)
    if (at < 0) {
        return ""
    }
    var i = at + needle.length
    while (i < entry.length && entry.charAt(i) != 58) {
        i = i + 1
    }
    if (i >= entry.length) {
        return ""
    }
    i = i + 1
    while (i < entry.length && (entry.charAt(i) == 32 || entry.charAt(i) == 10 || entry.charAt(i) == 13 || entry.charAt(i) == 9)) {
        i = i + 1
    }
    if (i >= entry.length) {
        return ""
    }
    if (entry.charAt(i) == 34) {
        var out = ""
        var escaped = false
        var j = i + 1
        while (j < entry.length) {
            var c = entry.charAt(j)
            if (escaped) {
                if (c == 34 || c == 92) {
                    out = out + (c as Char)
                } else {
                    out = out + (92 as Char) + (c as Char)
                }
                escaped = false
            } else if (c == 92) {
                escaped = true
            } else if (c == 34) {
                return out
            } else {
                out = out + (c as Char)
            }
            j = j + 1
        }
        return ""
    }
    var num = ""
    var k = i
    while (k < entry.length) {
        var d = entry.charAt(k)
        if ((d >= 48 && d <= 57) || d == 45 || d == 43 || d == 46) {
            num = num + (d as Char)
        } else {
            break
        }
        k = k + 1
    }
    return num
}

Int cmdDeploy(List<String> args) {
    if (extraPositional(args, 0) || flagMissingValue(args, "--file") || flagDuplicated(args, "--file")) {
        println("uso: kof cloud deploy [--file <caminho>] [--check] [--plan]")
        return 1
    }
    var session = loadSession()
    if (session == null) {
        println("nao logado — rode: kof cloud login <handle> --password <senha>")
        return 1
    }
    var identity = loadIdentity()
    if (identity == null) {
        println("nao logado — rode: kof cloud login <handle> --password <senha>")
        return 1
    }
    var path = resolveManifestPath(flagValue(args, "--file"))
    var loaded = loadManifestFile(path)
    if (loaded.ok == false) {
        println(loaded.error)
        println("uso: kof cloud deploy [--file <caminho>]")
        if (loaded.error.indexOf("invalido") >= 0) {
            println("Hint: confira o exemplo em docs/09-flows.md")
        }
        return 1
    }
    var services = loaded.services
    // --plan: mostra o diff sem aplicar nada (como `terraform plan`).
    // Puro depois do fetch: nenhuma escrita, nenhum publish.
    if (hasFlag(args, "--plan")) {
        try {
            var live = fetchServices(session.controlUrl, session.token)
            var plan = diffDeployment(live, services)
            if (plan.size == 0) {
                println("plan: nada a fazer (manifesto vazio não chega aqui — parse recusaria)")
            }
            for (var line in plan) {
                println("plan: " + line)
            }
            return 0
        } catch (String e) {
            printFail("falha", e)
            return 1
        }
    }
    var failures = 0
    for (var wanted in services) {
        // Build antes do publish (Fase 7, slice 5): gera o artefato local
        // antes de expor. Falhou = nao publica esse servico (fail-fast por
        // servico: os demais seguem; o parcial aparece no relatorio).
        if (wanted.build.length > 0) {
            var built = runServiceBuild(wanted.build)
            if (built.ok == false) {
                printFail("falha no build de " + wanted.name, built.detail)
                failures = failures + 1
                continue
            }
            println("build ok: " + wanted.name)
        }
        var body = mapOf()
        body.put("deviceId", identity.deviceId)
        body.put("name", wanted.name)
        body.put("localAddress", wanted.address)
        body.put("localPort", intToString(wanted.port))
        body.put("protocol", wanted.protocol)
        body.put("exposure", wanted.exposure)
        try {
            var created = requireOk(http.post(session.controlUrl + "/v1/services", json.encode(body), jsonHeader(session.token)))
            var service = json.decode<Service>(created)
            println("publicado: " + service.name + " -> https://" + service.hostname + " [" + service.exposure + "]")
        } catch (String e) {
            printFail("falha ao publicar " + wanted.name, e)
            failures = failures + 1
        }
    }
    if (failures > 0) {
        println("deploy parcial: " + intToString(failures) + " falha(s)")
        return 1
    }
    println("deploy ok: " + intToString(services.size) + " servico(s)")
    // Verificacao pos-deploy (slice 2): confirma que cada servico esta
    // publicado E responde localmente. Nao e rollback — so diagnostico.
    if (hasFlag(args, "--check") == false) {
        return 0
    }
    var problems = verifyDeployment(session.controlUrl, session.token, services)
    if (problems.size == 0) {
        println("check ok: " + intToString(services.size) + " servico(s) publicados e respondendo")
        return 0
    }
    for (var problem in problems) {
        println("check: " + problem)
    }
    println("Hint: suba o servico local na porta do manifesto e rode `kof cloud deploy` de novo")
    return 1
}

Int cmdDown(List<String> args) {
    if (extraPositional(args, 0) || flagMissingValue(args, "--file") || flagDuplicated(args, "--file")) {
        println("uso: kof cloud down [--file <caminho>] [--prune]")
        return 1
    }
    var session = loadSession()
    if (session == null) {
        println("nao logado")
        return 1
    }
    var identity = loadIdentity()
    if (identity == null) {
        println("nao logado")
        return 1
    }
    var path = resolveManifestPath(flagValue(args, "--file"))
    var loaded = loadManifestFile(path)
    if (loaded.ok == false) {
        println(loaded.error)
        return 1
    }
    var services = loaded.services
    var prune = hasFlag(args, "--prune")
    var failures = 0
    try {
        var live = fetchServices(session.controlUrl, session.token)
        for (var wanted in services) {
            var target = ""
            for (var service in live) {
                if (service.name == wanted.name) {
                    target = service.id
                }
            }
            if (target.length == 0) {
                println("ausente (ok): " + wanted.name)
            } else {
                var body = mapOf()
                body.put("serviceId", target)
                try {
                    requireOk(http.post(session.controlUrl + "/v1/services/remove", json.encode(body), jsonHeader(session.token)))
                    println("removido: " + wanted.name)
                } catch (String e) {
                    printFail("falha ao remover " + wanted.name, e)
                    failures = failures + 1
                }
            }
        }
        // --prune fecha o drift: remove publicados DESTE device que nao
        // estao no manifesto (ex.: publish manual antigo). Escopo: so o
        // device atual (nunca toca servico de outro device) e so o que
        // nao foi declarado (nunca remove a mais do que o diff).
        if (prune) {
            var pruned = 0
            for (var service in live) {
                if (service.deviceId != identity.deviceId) {
                    continue
                }
                var declared = false
                for (var wanted in services) {
                    if (service.name == wanted.name) {
                        declared = true
                    }
                }
                if (declared == false) {
                    var body = mapOf()
                    body.put("serviceId", service.id)
                    try {
                        requireOk(http.post(session.controlUrl + "/v1/services/remove", json.encode(body), jsonHeader(session.token)))
                        println("podado (fora do manifesto): " + service.name)
                        pruned = pruned + 1
                    } catch (String e) {
                        printFail("falha ao podar " + service.name, e)
                        failures = failures + 1
                    }
                }
            }
            println("prune: " + intToString(pruned) + " orfao(s) removidos")
        }
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
    if (failures > 0) {
        return 1
    }
    println("down ok: " + intToString(services.size) + " servico(s) do manifesto removidos")
    return 0
}
