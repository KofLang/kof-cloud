Int cmdServiceStatus(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println("nao logado")
        return 1
    }
    var name = firstPositional(args)
    if (name.length == 0 || extraPositional(args, 1)) {
        println("uso: kof cloud service status <nome>")
        return 1
    }
    try {
        var services = fetchServices(session.controlUrl, session.token)
        for (var service in services) {
            if (service.name == name) {
                println("Servico: " + service.name)
                println("Host:    https://" + service.hostname)
                println("Local:   " + service.localAddress + ":" + intToString(service.localPort))
                println("Exposicao: " + service.exposure)
                println("Status:  " + service.status)
                // Inventario de credenciais junto do status: o operador ve
                // de relance se ha kfs_ com prazo a vigiar (só AUTHENTICATED
                // usa; nos demais, a lista vem vazia e nada e impresso).
                try {
                    var tokenBody = mapOf()
                    tokenBody.put("serviceId", service.id)
                    var tokenRaw = requireOk(http.post(session.controlUrl + "/v1/services/tokens", json.encode(tokenBody), jsonHeader(session.token)))
                    var entries = json.decode<List<ServiceTokenEntry>>(tokenRaw)
                    var inventory = tokenInventoryLine(entries)
                    if (inventory.length > 0) {
                        println(inventory)
                    }
                } catch (String inner) {
                    // Inventario e diagnostico secundario: nao derruba o
                    // status se falhar (o dado principal ja saiu).
                }
                // Dominios proprios vinculados: o operador ve de relance se
                // o servico tem customs (e se falta DNS em algum). Falha
                // silenciosa nao derruba o status (mesma regra do inventario).
                try {
                    var domainRaw = requireOk(http.get(session.controlUrl + "/v1/domains", authHeader(session.token)))
                    var domains = json.decode<List<DomainEntry>>(domainRaw)
                    var customs = customDomainsFor(domains, service.name)
                    for (var custom in customs) {
                        println("Dominio: " + domainListLine(custom))
                    }
                } catch (String innerDomains) {
                }
                return 0
            }
        }
        println("servico nao encontrado: " + name)
        return 1
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

Int cmdServiceSuspend(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println("nao logado")
        return 1
    }
    var name = firstPositional(args)
    if (name.length == 0 || extraPositional(args, 1)) {
        println("uso: kof cloud service suspend <nome>")
        return 1
    }
    try {
        var target = serviceIdByName(session, name)
        if (target.length == 0) {
            println("servico nao encontrado: " + name)
            return 1
