// `logs` (marcos de sessao, gravados pela CLI) e `logs --runtime` (eventos
// reais do Agent: connect, reconnect, recusa fatal, health, streams). Os dois
// arquivos tem teto proprio; `--tail` vale para o escolhido.
// Contencao (Fase 17 slice 2): `freeze service|device <nome|id>` suspende,
// revoga credenciais vivas e abre o incidente; `unfreeze` restaura o status
// anterior. Sempre reversivel — nada e destruido.
Int cmdFreeze(List<String> args) {
    return runContainment(args, true)
}

Int cmdUnfreeze(List<String> args) {
    return runContainment(args, false)
}

Int runContainment(List<String> args, Bool freezing) {
    var verb = "unfreeze"
    if (freezing) {
        verb = "freeze"
    }
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    if (extraPositional(args, 2)) {
        println("uso: kof cloud " + verb + " service|device <nome|id>")
        return 1
    }
    var kind = firstPositional(args).trim()
    var name = secondPositional(args).trim()
    if (kind.length == 0 || name.length == 0) {
        println("uso: kof cloud " + verb + " service|device <nome|id>")
        return 1
    }
    if (kind != "service" && kind != "device") {
        println("alvo invalido: use service ou device")
        return 1
    }
    try {
        var targetId = name
        if (kind == "service") {
            var services = fetchServices(session.controlUrl, session.token)
            var matched = matchServiceName(services, name)
            if (matched.length == 0) {
                println(serviceNotFoundLine(name))
                return 1
            }
            targetId = matched
        } else {
            var devices = fetchDevices(session.controlUrl, session.token)
            var matched = ""
            for (var device in devices) {
                if (device.name == name || device.id == name) {
                    matched = device.id
                }
            }
            if (matched.length == 0) {
                println(deviceNotFoundLine(name))
                return 1
            }
            targetId = matched
        }
        var body = mapOf()
        body.put("target", kind)
        body.put("id", targetId)
        var endpoint = "/v1/freeze"
        if (freezing == false) {
            endpoint = "/v1/unfreeze"
        }
        var raw = requireOk(http.post(session.controlUrl + endpoint, json.encode(body), jsonHeader(session.token)))
        var result = json.decode<Map<String, String>>(raw)
        if (freezing) {
            println("Congelado (" + kind + "): " + name)
            println("Credenciais revogadas: " + mapField(result, "revoked"))
            println("Incidente: " + mapField(result, "incidentId"))
            println("")
            println("Reverter: kof cloud unfreeze " + kind + " " + name)
        } else {
            println("Descongelado (" + kind + "): " + name)
            println("Configuracao preservada; status anterior restaurado.")
            println("Credenciais revogadas no freeze NAO voltam — emita novas se precisar.")
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

// Incidentes (Fase 17 slice 1): lista os abertos da conta + os globais
// (plataforma). `--all` mostra so os globais; `--resolve <id>` fecha um.
Int cmdIncidents(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    if (extraPositional(args, 0)) {
        println("uso: kof cloud incidents [--all] [--resolve <id>]")
        return 1
    }
    var resolveId = flagValue(args, "--resolve").trim()
    try {
        var body = mapOf()
        if (hasFlag(args, "--all")) {
            body.put("all", "true")
        }
        if (resolveId.length > 0) {
            body.put("resolveId", resolveId)
        }
        var raw = requireOk(http.post(session.controlUrl + "/v1/incidents", json.encode(body), jsonHeader(session.token)))
        var list = json.decode<List<IncidentEntry>>(raw)
        if (resolveId.length > 0) {
            println("Incidente fechado: " + resolveId)
        }
        if (list.size == 0) {
            println("nenhum incidente aberto")
            return 0
        }
        for (var incident in list) {
            var state = "ABERTO"
            if (incident.resolvedAt != "0") {
                state = "FECHADO"
            }
            println(incident.severity + "  " + incident.kind + "  " + state + "  " + incident.id)
            println("  " + incident.summary)
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

Int cmdLogs(List<String> args) {
    var runtime = hasFlag(args, "--runtime")
    var path = logPath()
    if (runtime) {
        path = agentRuntimeLogPath()
    }
    var text = readTextOr(path, "")
    if (text.length == 0) {
        if (runtime) {
            println("sem eventos de runtime (o Agent ainda nao rodou neste host)")
        } else {
            println("sem logs")
        }
        return 0
    }
    var tailRaw = flagValue(args, "--tail")
    // Solta: sem valor nao ha o que aparar. Duplicada: `flagValue` leria
    // a primeira em silencio (o operador leria a ultima no comando).
    if (flagMissingValue(args, "--tail") || flagDuplicated(args, "--tail")) {
        println(usoLogsLine())
        return 1
    }
    if (tailRaw.trim().length > 0) {
        var n = parseIntSafe(tailRaw.trim(), -1)
        if (n <= 0) {
            println(usoLogsLine())
            return 1
        }
        text = tailLines(text, n)
    }
    println(text)
    return 0
}

record AuditEntry(String at, String actor, String action, String target)

// Inventario SBOM (Fase 19 slice 1 parcial): lista curada dos 44 fontes do
// KofCloud — sem Directory.list (plano, sem recursao) e sem versao no repo
// ou no stdlib (STATUS.md documenta o toolchain; nada inventado). O hash
// e sha256 sobre o texto (sonda provou byte-identico ao sha256sum). Pura
// na composicao: SBOM de verdade passa root + conteudos; File.readText
// vive no cmdAudit (precedente: loadManifestFile separa parse de IO).
List<String> sbomModules() {
    return listOf("src/kofcloud/agent/Agent.kf", "src/kofcloud/agent/Backoff.kf", "src/kofcloud/agent/Events.kf", "src/kofcloud/agent/Health.kf", "src/kofcloud/agent/Metrics.kf", "src/kofcloud/agent/Relay.kf", "src/kofcloud/cli/Cli.kf", "src/kofcloud/cli/Commands.kf", "src/kofcloud/cli/Daemon.kf", "src/kofcloud/cli/Deploy.kf", "src/kofcloud/cli/Doctor.kf", "src/kofcloud/cli/Local.kf", "src/kofcloud/cli/Usage.kf", "src/kofcloud/control/ControlPlane.kf", "src/kofcloud/control/Metrics.kf", "src/kofcloud/control/Panel.kf", "src/kofcloud/control/Registry.kf", "src/kofcloud/edge/EdgeState.kf", "src/kofcloud/edge/HttpFront.kf", "src/kofcloud/edge/Http.kf", "src/kofcloud/edge/Metrics.kf", "src/kofcloud/edge/Relay.kf", "src/kofcloud/edge/Tunnel.kf", "src/kofcloud/identity/Keys.kf", "src/kofcloud/identity/Tokens.kf", "src/kofcloud/model/Account.kf", "src/kofcloud/model/Audit.kf", "src/kofcloud/model/CustomDomain.kf", "src/kofcloud/model/Device.kf", "src/kofcloud/model/Errors.kf", "src/kofcloud/model/Exposure.kf", "src/kofcloud/model/Service.kf", "src/kofcloud/protocol/Bytes.kf", "src/kofcloud/protocol/Frame.kf", "src/kofcloud/protocol/LineCodec.kf", "src/kofcloud/protocol/Payload.kf", "src/kofcloud/protocol/Session.kf", "src/kofcloud/protocol/Tunnel.kf", "src/kofcloud/protocol/Version.kf", "src/kofcloud/store/Store.kf", "src/kofcloud/util/Hosts.kf", "src/kofcloud/util/Limits.kf", "src/kofcloud/util/Text.kf", "src/Main.kf")
}

// Linha do SBOM: "sha256  caminho" (formato do sha256sum, verificavel por
// fora). Conteudo vazio = arquivo ilegivel (nunca hash de string vazia em
// silencio — seria fingerprint falso).
String sbomLine(String path, String content) {
    if (content.length == 0) {
        return "UNREADABLE  " + path
    }
    return crypto.sha256(content) + "  " + path
}

String sbomText(List<String> modules, List<String> contents) {
    var i = 0
    var out = ""
    while (i < modules.size && i < contents.size) {
        out = out + sbomLine(modules.get(i), contents.get(i)) + "\n"
        i = i + 1
    }
    return out
}

// Trilha de auditoria da conta: ultimos eventos dos proprios recursos.
// Com --sbom: inventario local dos fontes (sem login, sem rede) — Fase 19
// slice 1 parcial. Local por desenho: o SBOM descreve o que esta no disco,
// nao o que o servidor diz que esta.
Int cmdAudit(List<String> args) {
    if (hasFlag(args, "--sbom")) {
        if (extraPositional(args, 0) || flagDuplicated(args, "--sbom")) {
            println("uso: kof cloud audit [--sbom]")
            return 1
        }
        var modules = sbomModules()
        var contents = listOf<String>()
        for (var module in modules) {
            var text = File(module).readText()
            if (text == null) {
                text = ""
            }
            contents.add(text)
        }
        println(sbomText(modules, contents))
        return 0
    }
    if (extraPositional(args, 0)) {
        println("uso: kof cloud audit")
        return 1
    }
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    try {
        var raw = requireOk(http.get(session.controlUrl + "/v1/audit", authHeader(session.token)))
        var events = json.decode<List<AuditEntry>>(raw)
        if (events.size == 0) {
            println("sem eventos")
            return 0
        }
        for (var event in events) {
            println(event.at + "  " + event.action + "  " + event.target)
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

// ---- helpers de control plane ----

List<Service> fetchServices(String control, String token) {
    var raw = requireOk(http.get(control + "/v1/services", authHeader(token)))
    return json.decode<List<Service>>(raw)
}

List<Device> fetchDevices(String control, String token) {
    var raw = requireOk(http.get(control + "/v1/devices", authHeader(token)))
    return json.decode<List<Device>>(raw)
}

String logPath() {
    return kofcloudHome() + "/agent.log"
}

// Sobe a plataforma: control plane + edge no MESMO processo, compartilhando
// uma unica instancia de Registry (sem corrida de arquivo entre processos).
// Portas do `serve` validas? Pura, sem IO — o cmdServe chama antes de
// abrir qualquer listener (fail-fast: sem bind parcial). Mesma faixa da
// API/manifesto (KCF043): 1-65535. Devolve "" quando ok.
String validateServePorts(Int controlPort, Int tunnelPort, Int httpPort) {
    if (controlPort <= 0 || controlPort > 65535) {
        return "control-port invalida: " + intToString(controlPort) + " (use 1-65535)"
    }
    if (tunnelPort <= 0 || tunnelPort > 65535) {
        return "tunnel-port invalida: " + intToString(tunnelPort) + " (use 1-65535)"
    }
    if (httpPort <= 0 || httpPort > 65535) {
        return "http-port invalida: " + intToString(httpPort) + " (use 1-65535)"
    }
    return ""
}

// Caminho do estado do `serve --state`: ausente, vazio ou so-espacos =
// default (`~/.kofcloud/control-state.json`); senao, o valor aparado.
// Pura, sem HOME nem rede — o default vive aqui como o chamador ja fazia
// inline (precedente: resolveLoginInputs/resolveDaemonControl). Sem isso,
// `--state "   "` pulava o default (length > 0) e virava path invalido.
String resolveStatePath(String flagRaw) {
    var trimmed = flagRaw.trim()
    if (trimmed.length == 0) {
        return kofcloudHome() + "/control-state.json"
    }
    return trimmed
}

// TLS do control plane (`serve --tls-cert/--tls-key`): ausente = HTTP
// (comportamento atual); presente exige o PAR (cert + key) — metade sozinha
// e erro posicional, nao default silencioso. Pura, sem IO: o cmdServe le os
// PEMs e falha cedo se o arquivo nao existir. "" = sem TLS.
String resolveTlsPair(String certRaw, String keyRaw) {
    var cert = certRaw.trim()
    var key = keyRaw.trim()
    if (cert.length == 0 && key.length == 0) {
        return ""
    }
    if (cert.length == 0 || key.length == 0) {
        return "tls exige --tls-cert e --tls-key juntos (par ausente)"
    }
    return cert + "\n" + key
}

// Esquema do control plane no banner: https com TLS, http sem.
String controlScheme(String tlsPair) {
    if (tlsPair.length > 0) {
        return "https"
    }
    return "http"
}

// Aviso de PEM expirando (Fase 9 slice 3 parcial): `openssl x509 -checkend`
// devolve exit 0 = valido alem do prazo, 1 = expira dentro (ou PEM ruim).
// Aviso, nunca bloqueio (precedente: artifact ausente no deploy): cortar
// o serve por relogio torto seria pior que servir com cert velho. Pura na
// decisao (exitCode -> Bool); IO (process.run) vive no cmdServe.
Bool tlsCertExpiringSoon(Int checkendExitCode) {
    return checkendExitCode != 0
}

// Portas: control HTTP, tunel e HTTP publico do edge.
Int cmdServe(List<String> args) {
    // Flag solta vira string vazia no parseIntSafe (default silencioso);
    // duplicada leria a primeira. Ambas rejeitadas antes de validar faixa.
    // --state segue a mesma regra (precedente: --file/--control/--device):
    // solto caia no default em silencio, duplicado lia a primeira.
    if (flagMissingValue(args, "--control-port") || flagMissingValue(args, "--tunnel-port") || flagMissingValue(args, "--http-port") || flagMissingValue(args, "--state") || flagMissingValue(args, "--waf") || flagMissingValue(args, "--tls-cert") || flagMissingValue(args, "--tls-key")) {
        println(usoServeLine())
        return 1
    }
    if (flagDuplicated(args, "--control-port") || flagDuplicated(args, "--tunnel-port") || flagDuplicated(args, "--http-port") || flagDuplicated(args, "--state") || flagDuplicated(args, "--waf") || flagDuplicated(args, "--tls-cert") || flagDuplicated(args, "--tls-key")) {
        println("flag repetida — informe uma so vez: kof cloud serve [--control-port N] [--tunnel-port N] [--http-port N] [--state <caminho>] [--waf detectar|enforce] [--tls-cert <pem> --tls-key <pem>]")
        return 1
    }
    var controlPort = parseIntSafe(flagValue(args, "--control-port").trim(), defaultControlPort())
    var tunnelPort = parseIntSafe(flagValue(args, "--tunnel-port").trim(), defaultTunnelPort())
    var httpPort = parseIntSafe(flagValue(args, "--http-port").trim(), defaultHttpPort())
    var statePath = resolveStatePath(flagValue(args, "--state"))
    var wafMode = resolveWafMode(flagValue(args, "--waf"))
    var panel = hasFlag(args, "--panel")
    var statusPage = hasFlag(args, "--status-page")
    var tunnelSecret = config.str("kofcloud.tunnelSecret", "")
    var maxBytes = limitMaxBodyBytes()
    // TLS do control plane (Fase 9 slice 1 parcial): par cert+key em PEM;
    // ausente = HTTP (comportamento atual); metade sozinha = erro local.
    var tlsPair = resolveTlsPair(flagValue(args, "--tls-cert"), flagValue(args, "--tls-key"))
    if (tlsPair.startsWith("tls exige")) {
        println(tlsPair)
        println(usoServeLine())
        return 1
    }
    var tlsCertPath = ""
    var tlsKeyPath = ""
    if (tlsPair.length > 0) {
        var sep = tlsPair.indexOf("\n")
        tlsCertPath = tlsPair.substring(0, sep)
        tlsKeyPath = tlsPair.substring(sep + 1)
        var certPem = readTextOr(tlsCertPath, "")
        var keyPem = readTextOr(tlsKeyPath, "")
        if (certPem.length == 0 || keyPem.length == 0) {
            println("tls: PEM ilegivel (cert ou key vazio/ausente) — confira --tls-cert/--tls-key")
            println(usoServeLine())
            return 1
        }
        // Aviso de expiracao (Fase 9 slice 3 parcial): 30 dias. openssl
        // ausente/erro = sem aviso (nao ha o que checar); expiracao nao
        // bloqueia o serve (aviso, nunca bloqueio — o operador decide).
        try {
            var check = process.run("openssl", "x509", "-in", tlsCertPath, "-noout", "-checkend", "2592000")
            if (tlsCertExpiringSoon(check.exitCode)) {
                println("aviso: certificado TLS expira em menos de 30 dias — renove o PEM")
            }
        } catch (String e) {
        }
    }

    // Fail-fast: valida as tres portas ANTES de abrir qualquer listener —
    // sem isso, --control-port abc caia no default 8080 em silencio e porta
    // fora da faixa quebrava so no bind (com metade da plataforma no ar).
    var portsError = validateServePorts(controlPort, tunnelPort, httpPort)
    if (portsError.length > 0) {
        println(portsError)
        println(usoServeLine())
        return 1
    }
    if (wafMode == "?") {
        println("waf invalido: " + flagValue(args, "--waf").trim() + " (use detectar|enforce)")
        println(usoServeLine())
        return 1
    }

    var registry = Registry(statePath)
    var edgeState = EdgeState(registry)
    edgeState.setWafEnforce(wafMode == "enforce")

    println("kofcloud control plane  -> " + controlScheme(tlsPair) + "://127.0.0.1:" + intToString(controlPort))
    println("kofcloud edge tunnel    -> 127.0.0.1:" + intToString(tunnelPort))
    println("kofcloud edge public    -> http://127.0.0.1:" + intToString(httpPort))
    println("estado: " + statePath)
    println("waf: " + wafMode)
    if (tlsPair.length > 0) {
        println("tls: control plane em HTTPS (cert do operador)")
    }
    if (panel) {
        println("painel: http://127.0.0.1:" + intToString(controlPort) + "/panel")
    }
    if (statusPage) {
        println("status:  http://127.0.0.1:" + intToString(controlPort) + "/status")
    }

    var platformStop = kofcloudHome() + "/platform-stop"
    File(platformStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    if (panel) {
        control.enablePanel()
    }
    if (statusPage) {
        control.enableStatusPage()
    }
    if (tlsPair.length > 0) {
        // PEMs ja validados acima (nao-vazios); rele do disco por clareza —
        // o readTextOr do fail-fast e a fonte da verdade, sem duplicar regra.
        var sep = tlsPair.indexOf("\n")
        control.enableTls(readTextOr(tlsPair.substring(0, sep), ""), readTextOr(tlsPair.substring(sep + 1), ""))
    }
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, tunnelSecret, platformStop) }
    var httpTask = spawn { serveHttp(edgeState, httpPort, maxBytes, platformStop) }
    await controlTask
    return 0
}

void appendLog(String message) {
    var line = longToString(time.now()) + " " + message + "\n"
    var file = File(logPath())
    // Teto anti-crescimento infinito: estouro corta o inicio (linhas
    // inteiras), mantendo o recente. O que entra aqui nunca tem segredo
    // (so marcos de sessao — ver cmdConnect); tokens e chaves jamais.
    if (file.exists()) {
        var capped = trimLogHead(readTextOr(logPath(), "") + line, limitLogBytes())
        writeTextTo(logPath(), capped)
    } else {
        writeTextTo(logPath(), line)
    }
}
