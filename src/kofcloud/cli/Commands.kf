    }
}

Int cmdDomainAdd(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    // `--service` solto vira "" (erro generico de uso, sem apontar a
    // flag); duplicado leria a primeira em silencio. Fail-fast com o uso.
    if (flagMissingValue(args, "--service") || flagDuplicated(args, "--service") || flagMissingValue(args, "--dns-webhook") || flagDuplicated(args, "--dns-webhook") || flagMissingValue(args, "--dns-cmd") || flagDuplicated(args, "--dns-cmd") || flagDuplicated(args, "--dry-run")) {
        println(usoDomainAddLine())
        return 1
    }
    var hostname = firstPositional(args).trim()
    var service = flagValue(args, "--service").trim()
    if (hostname.length == 0 || service.length == 0 || extraPositional(args, 1)) {
        println(usoDomainAddLine())
        return 1
    }
    // Fail-fast local (F18 s1): URL invalida barra ANTES de registrar o
    // dominio — mesma regra do webhook de incidentes (https, ou http so em
    // loopback; sem credencial na URL). O dominio nao pode nascer PENDING
    // com o assistente quebrado.
    var dryRun = hasFlag(args, "--dry-run")
    var dnsUrl = flagValue(args, "--dns-webhook").trim()
    var dnsCmd = flagValue(args, "--dns-cmd").trim()
    // F18 s1: UMA fonte de DNS (webhook ou comando do provedor) — duas
    // seriam escolha silenciosa.
    var dnsCmdErr = dnsCmdError(dnsCmd, dnsUrl)
    if (dnsCmdErr.length > 0) {
        println(dnsCmdErr)
        println(usoDomainAddLine())
        return 1
    }
    if (dnsUrl.length > 0) {
        var urlError = webhookUrlError(dnsUrl)
        if (urlError.length > 0) {
            println("webhook DNS invalido: " + urlError)
            println(usoDomainAddLine())
            return 1
        }
    }
    if (dryRun) {
        if (dnsCmd.length > 0) {
            println(dnsCmdPreview(dnsCmdExpand(dnsCmd, hostname, service, serviceHostname(service, session.handle))))
            return 0
        }
        var previewToken = envOrNull("KOF_KOFCLOUD_DNS_WEBHOOK_TOKEN").trim()
        var payload = dnsWebhookPayload(hostname, service, serviceHostname(service, session.handle))
        println(dnsWebhookPreview(dnsUrl, payload, dnsWebhookHeaders(previewToken), previewToken.length > 0))
        return 0
    }
    var body = mapOf()
    body.put("hostname", hostname)
    body.put("service", service)
    try {
        var raw = requireOk(http.post(session.controlUrl + "/v1/domains", json.encode(body), jsonHeader(session.token)))
        var created = json.decode<DomainStatus>(raw)
        println("Dominio registrado (pendente de DNS):")
        println("  hostname: " + created.hostname)
        println("  instrucao: " + created.instruction)
        println("")
        println("Crie o CNAME e rode: kof cloud domain verify " + created.hostname)
        if (dnsUrl.length > 0) {
            var token = envOrNull("KOF_KOFCLOUD_DNS_WEBHOOK_TOKEN").trim()
            var err = dnsWebhookDeliver(dnsUrl, dnsWebhookPayload(hostname, service, dnsTargetFromInstruction(created.instruction)), dnsWebhookHeaders(token))
            if (err.length == 0) {
                println("webhook DNS: pedido de criacao enviado a " + dnsUrl + " (target " + dnsTargetFromInstruction(created.instruction) + ")")
            } else {
                println("AVISO: webhook DNS falhou (" + err + ") — crie o CNAME manualmente e rode domain verify")
            }
        }
        if (dnsCmd.length > 0) {
            var cmdErr = dnsCmdRun(dnsCmdExpand(dnsCmd, hostname, service, dnsTargetFromInstruction(created.instruction)))
            if (cmdErr.length == 0) {
                println("provedor DNS: comando executado com target " + dnsTargetFromInstruction(created.instruction) + " (confirme o CNAME e rode domain verify)")
            } else {
                println("AVISO: " + cmdErr + " — crie o CNAME manualmente e rode domain verify")
            }
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

// Julga o PEM do operador contra o hostname ANTES de qualquer rede
// (Fase 6/9: `domain verify --tls-cert`). DNS OK com certificado errado e
// um HTTPS quebrado descoberto tarde — melhor barrar aqui. O veredito e
// puro (`domainCertLine`); este trecho so executa o openssl, com o mesmo
// criterio do `doctor`/`scan`: binario ausente = aviso, nunca recusa
// inventada. Devolve true quando reprova (o chamador para com exit 1).
Bool domainTlsBlocks(String certPath, String hostname) {
    var exists = fileExists(certPath)
    var parseExit = -1
    var sanOut = ""
    var subjectOut = ""
    var expiring = false
    var endMs = 0L
    if (exists) {
        try {
            var parse = process.run("openssl", "x509", "-in", certPath, "-noout")
            parseExit = parse.exitCode
            if (parseExit == 0) {
                sanOut = process.run("openssl", "x509", "-in", certPath, "-noout", "-ext", "subjectAltName").stdout
                subjectOut = process.run("openssl", "x509", "-in", certPath, "-noout", "-subject").stdout
                var checkend = process.run("openssl", "x509", "-in", certPath, "-noout", "-checkend", tlsCheckendWindowSec())
                expiring = tlsCertExpiringSoon(checkend.exitCode)
                endMs = tlsCertEndDate(certPath)
            }
        } catch (String e) {
            parseExit = -1
        }
    }
    var line = domainCertLineWith(certPath, hostname, exists, parseExit, sanOut, subjectOut, expiring, endMs)
    println(line)
    return line.startsWith("FALHA")
}

// Rodapé TLS do `service status --tls-cert` (Fase 9 slice 3): roda o openssl
// UMA vez (parse + checkend + SAN + subject, o mesmo quarteto do
// `domainTlsBlocks`) e devolve uma linha `domainCertLine` POR hostname do
// serviço — o default da conta e os customs impressos no próprio status.
// Reusar a linha do `domain verify --tls-cert` mantém UMA regra de veredito
// (`certHostVerdict`): expiração visível como aviso na linha ok, PEM
// ausente/inválido/que não cobre como FALHA; openssl ausente vira aviso, não
// recusa inventada. Lista vazia (sem --tls-cert) devolve lista vazia.
List<String> serviceCertLines(String certPath, List<String> hosts) {
    var out = listOf<String>()
    if (certPath.length == 0 || hosts.size == 0) {
        return out
    }
    var exists = fileExists(certPath)
    var parseExit = -1
    var sanOut = ""
    var subjectOut = ""
    var expiring = false
    var endMs = 0L
    if (exists) {
        try {
            parseExit = process.run("openssl", "x509", "-in", certPath, "-noout").exitCode
            if (parseExit == 0) {
                sanOut = process.run("openssl", "x509", "-in", certPath, "-noout", "-ext", "subjectAltName").stdout
                subjectOut = process.run("openssl", "x509", "-in", certPath, "-noout", "-subject").stdout
                var checkend = process.run("openssl", "x509", "-in", certPath, "-noout", "-checkend", tlsCheckendWindowSec())
                expiring = tlsCertExpiringSoon(checkend.exitCode)
                endMs = tlsCertEndDate(certPath)
            }
        } catch (String e) {
            parseExit = -1
        }
    }
    for (var host in hosts) {
        out.add(domainCertLineWith(certPath, host, exists, parseExit, sanOut, subjectOut, expiring, endMs))
    }
    return out
}

Int cmdDomainVerify(List<String> args) {
    // Flag solta/repetida barra antes de qualquer efeito (precedente:
    // --service do domain add e --tls-cert do serve).
    if (flagMissingValue(args, "--tls-cert") || flagDuplicated(args, "--tls-cert") || extraPositional(args, 1)) {
        println(usoDomainVerifyLine())
        return 1
    }
    var hostname = firstPositional(args).trim()
    if (hostname.length == 0) {
        println(usoDomainVerifyLine())
        return 1
    }
    // PEM antes do login: o operador descobre o certificado errado mesmo
    // sem sessao (e sem tocar o control plane).
    var certPath = flagValue(args, "--tls-cert").trim()
    if (certPath.length > 0) {
        if (domainTlsBlocks(certPath, hostname)) {
            return 1
        }
    }
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var body = mapOf()
    body.put("hostname", hostname)
    try {
        var raw = requireOk(http.post(session.controlUrl + "/v1/domains/verify", json.encode(body), jsonHeader(session.token)))
        var verified = json.decode<DomainStatus>(raw)
        println("Dominio verificado: " + verified.hostname)
        println("Rota ativa.")
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

