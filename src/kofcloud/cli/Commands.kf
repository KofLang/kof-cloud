        var domains = json.decode<List<DomainEntry>>(raw)
        if (asJson) {
            // Saida estavel para CI: `[]` tambem e uma lista valida (nunca
            // silencio, que quebraria o parser).
            println(domainListJsonFor(domains))
            return 0
        }
        for (var domain in domains) {
            println(domainListLine(domain))
        }
        return 0
    } catch (String e) {
