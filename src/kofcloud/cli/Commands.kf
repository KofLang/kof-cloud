// ---- servicos ----

// Valida nome/porta/exposure/address ANTES de qualquer rede ou sessao:
// pura, testavel sem HOME. Devolve "" quando ok, ou a mensagem de erro
// (mesmas regras da API KCF045/KCF047 — fail-fast local com dica).
// Teto de corpo por servico na CLI: "" (herda o global), inteiro positivo
// em bytes, ou a mensagem de erro (KCF142). Pura — o cmdPublish barra antes
// da rede, a mesma regra da API.
String validateMaxBodyBytes(String raw) {
    var trimmed = raw.trim()
    if (trimmed.length == 0) {
        return ""
    }
    var parsed = parseIntBounded(trimmed, -1, 2147483647)
    if (parsed <= 0) {
        return errInvalidMaxBody()
    }
    return ""
}

String validatePublishLocal(String name, Int port, String exposure, String address) {
    // Trim como o parseManifest (manifesto e CLI aceitam os mesmos campos;
    // espacos sobrando nao devem virar nome com espaco nem exposure
    // invalida). Pura: apara copias locais, sem tocar os args.
    var trimmedName = name.trim()
    var trimmedExposure = exposure.trim()
    var trimmedAddress = address.trim()
    if (trimmedName.length == 0 || port <= 0 || port > 65535) {
        return "uso: kof cloud publish <nome> --port <porta> (porta 1-65535)"
    }
    if (exposureIsKnown(trimmedExposure) == false) {
        return "exposure invalida: " + trimmedExposure + " (use PUBLIC, AUTHENTICATED ou PRIVATE)"
    }
    if (validLocalAddress(trimmedAddress) == false) {
        return "address invalido: " + trimmedAddress + " (use 127.0.0.1, localhost ou ::1)"
    }
    return ""
}

Int cmdPublish(List<String> args) {
    var identity = loadIdentity()
    var session = loadSession()
    if (identity == null) {
        println(notLoggedInLine())
        return 1
    }
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var name = firstPositional(args).trim()
    // Flags com valor obrigatorio quando presentes: `--port` solto (sem
    // valor) nao pode cair no erro generico de uso nem em default.
    // Duplicada tambem nao: `flagValue` leria a primeira em silencio.
    if (flagMissingValue(args, "--port") || flagMissingValue(args, "--address") || flagMissingValue(args, "--exposure") || flagMissingValue(args, "--device") || flagMissingValue(args, "--max-body")) {
        println("uso: kof cloud publish <nome> --port <porta> [--exposure PUBLIC|AUTHENTICATED|PRIVATE] [--address <addr>] [--device <nome>] [--max-body <bytes>]")
        return 1
    }
    if (flagDuplicated(args, "--port") || flagDuplicated(args, "--address") || flagDuplicated(args, "--exposure") || flagDuplicated(args, "--device") || flagDuplicated(args, "--max-body")) {
        println("flag repetida — informe uma so vez: kof cloud publish <nome> --port <porta> [--exposure PUBLIC|AUTHENTICATED|PRIVATE] [--address <addr>] [--device <nome>]")
        return 1
    }
    if (extraPositional(args, 1)) {
        println("argumento a mais — uso: kof cloud publish <nome> --port <porta> [--exposure PUBLIC|AUTHENTICATED|PRIVATE] [--address <addr>] [--device <nome>] [--max-body <bytes>]")
        return 1
    }
    var port = parsePortSafe(flagValue(args, "--port"), 0)
    // Trim como o parseManifest (ausente/vazio/so-espacos = default, igual
    // ao "ausente defaulta" do manifesto): espacos sobrando nao devem virar
    // nome com espaco nem exposure invalida.
    var address = flagValue(args, "--address").trim()
    if (address.length == 0) {
        address = defaultLocalAddress()
    }
    var exposure = flagValue(args, "--exposure").trim()
    if (exposure.length == 0) {
        exposure = defaultExposure()
    }
    var deviceId = identity.deviceId
    var overrideDevice = flagValue(args, "--device")
    if (overrideDevice.length > 0) {
        // Aceita NOME ou id: a ajuda documenta <nome>, mas ids tambem
        // funcionam (compat). Nome resolve pela lista da conta; id passa
        // direto e o control plane valida (404 opaco se alheio).
        var picked = resolveDeviceByNameOrId(session, overrideDevice)
        deviceId = picked.deviceId
        if (deviceId.length == 0) {
            printDeviceNotFound(picked.devices, overrideDevice)
            return 1
        }
    }
    // Fail-fast local (mesmas regras da API KCF045/KCF047): evita uma
    // viagem de rede para um erro certo, com dica acionavel na hora.
    // Allowlist WAF opcional (mesma politica do POST /v1/services): aceita
    // uma flag por item; validacao local antes da rede (KCF113/KCF114).
    var methodsRaw = repeatedCsv(flagValues(args, "--allow-method"))
    var methodsGiven = flagValues(args, "--allow-method").size > 0
    if (methodsGiven && methodsRaw.length == 0) {
        println("--allow-method sem valor — use --allow-method GET (repita para varios)")
        return 1
    }
    var allowMethods = normalizeAllowMethods(methodsRaw, httpVerbs())
    if (methodsGiven && allowMethods.length == 0) {
        println(errInvalidAllowMethod())
        println(errHint(errInvalidAllowMethod()))
        return 1
    }
    var pathsRaw = repeatedCsv(flagValues(args, "--allow-path"))
    var pathsGiven = flagValues(args, "--allow-path").size > 0
    if (pathsGiven && pathsRaw.length == 0) {
        println("--allow-path sem valor — use --allow-path /api/* (repita para varios)")
        return 1
    }
    var allowPaths = normalizeAllowPaths(pathsRaw)
    if (pathsGiven && allowPaths.length == 0) {
        println(errInvalidAllowPath())
        println(errHint(errInvalidAllowPath()))
        return 1
    }
    var localError = validatePublishLocal(name, port, exposure, address)
    if (localError.length > 0) {
        println(localError)
        return 1
    }
    // Teto de corpo por servico (F10 s2): validado antes da rede; vazio =
    // herda o global.
    var maxBodyRaw = flagValue(args, "--max-body").trim()
    var maxBodyError = validateMaxBodyBytes(maxBodyRaw)
    if (maxBodyError.length > 0) {
        println(maxBodyError)
        println(errHint(errInvalidMaxBody()))
        return 1
    }
    var body = mapOf()
    body.put("deviceId", deviceId)
    body.put("name", name)
    body.put("localAddress", address)
    body.put("localPort", intToString(port))
    body.put("protocol", defaultProtocol())
    body.put("exposure", exposure)
    if (allowMethods.length > 0) {
        body.put("allowMethods", allowMethods)
    }
    if (allowPaths.length > 0) {
        body.put("allowPaths", allowPaths)
    }
    if (maxBodyRaw.length > 0) {
        body.put("maxBodyBytes", maxBodyRaw)
    }
    try {
        var raw = requireOk(http.post(session.controlUrl + "/v1/services", json.encode(body), jsonHeader(session.token)))
        var service = json.decode<Service>(raw)
        println("Servico publicado.")
        println("")
        println("Nome:   " + service.name)
        println("Local:  " + service.localAddress + ":" + intToString(service.localPort))
        println("Publico: https://" + service.hostname)
        println("Status: " + service.status)
        if (service.allowMethods.length > 0) {
            println("Metodos: " + service.allowMethods)
        }
        if (service.allowPaths.length > 0) {
            println("Caminhos: " + service.allowPaths)
        }
        if (serviceCapText(service.maxBodyBytes).length > 0) {
            println("Teto de corpo: " + serviceCapText(service.maxBodyBytes) + " bytes (por servico)")
        }
        return 0
    } catch (String e) {
        printFail("falha ao publicar", e)
        return 1
    }
}

Int cmdUnpublish(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var name = firstPositional(args)
    if (name.trim().length == 0 || extraPositional(args, 1)) {
        println("uso: kof cloud unpublish <nome>")
        return 1
    }
    try {
        var services = fetchServices(session.controlUrl, session.token)
        var match = resolveServiceName(services, name)
        if (match.ambiguous) {
            println(serviceAmbiguousLine(name.trim(), match.deviceIds))
            return 1
        }
        var target = match.uniqueId
        if (target.length == 0) {
            printServiceNotFound(services, name)
            return 1
        }
        var body = mapOf()
        body.put("serviceId", target)
        requireOk(http.post(session.controlUrl + "/v1/services/remove", json.encode(body), jsonHeader(session.token)))
        println("Servico removido: " + name)
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

// Nome do dispositivo dono do servico, para as linhas do `service list` e
// do `service status`. Com varios dispositivos por conta (limite default 5),
// a lista sem o device nao responde "onde isto roda?" — era preciso cruzar
// `device list` com o `deviceId` do servico. Puro: recebe a lista ja buscada;
// id sem correspondencia (device removido) cai no proprio id, sem sumir.
String deviceLabelFor(List<Device> devices, String deviceId) {
    if (deviceId.length == 0) {
        return "?"
    }
    for (var device in devices) {
        if (device.id == deviceId) {
            return device.name
        }
    }
    return deviceId
}

// Linha do `service list`: nome, hostname, exposicao, status e o device.
String serviceListLine(Service service, List<Device> devices) {
    return service.name + "  https://" + service.hostname + "  " + service.exposure + "  " + service.status + "  device: " + deviceLabelFor(devices, service.deviceId)
}

Int cmdServiceList(List<String> args) {
    if (extraPositional(args, 0) || flagDuplicated(args, "--json")) {
        println("uso: kof cloud service list [--json]")
        return 1
    }
    var asJson = hasFlag(args, "--json")
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    try {
        var services = fetchServices(session.controlUrl, session.token)
        if (asJson) {
            // Saida estavel para CI: `[]` tambem e uma lista valida (nunca o
            // texto de "nenhum servico", que quebraria o parser).
            println(serviceListJsonFor(services))
            return 0
        }
        if (services.size == 0) {
            println("nenhum servico publicado")
            return 0
        }
        // Devices so para rotular a origem; falha na consulta nao esconde a
        // lista (o rotulo cai no id, que a API ja devolve).
        var devices = listOf<Device>()
        try {
            devices = fetchDevices(session.controlUrl, session.token)
        } catch (String e) {
        }
        for (var service in services) {
            println(serviceListLine(service, devices))
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

// Linha do tunel do dispositivo que serve o servico, a partir do corpo de
// /v1/presence ja buscado (ou do erro da busca). Pura, sem rede nem HOME —
// mesma regra do `status`/`device list` (`bodyContainsId`).
//
// O `Status:` do servico e o ultimo health reportado pelo Agent: uma foto
// que pode estar velha. Sem esta linha, um servico aparecia `ONLINE` com o
// tunel caido — o site fora do ar e o operador lendo "ONLINE". Presenca
// indisponivel nunca vira OFFLINE inventado.
String serviceTunnelLine(String deviceId, String presenceRaw, String presenceError) {
    if (presenceError.length > 0) {
        return "Tunel:   desconhecido (presenca indisponivel: " + presenceError + ")"
    }
    if (bodyContainsId(presenceRaw, deviceId)) {
        return "Tunel:   ONLINE (device no ar)"
    }
    return "Tunel:   OFFLINE (device sem sessao no Edge — rode: kof cloud connect)"
}

// Contradicao entre o health reportado e o tunel real: `ONLINE` e a ultima
// foto do Agent, nao uma prova de que o site responde agora. Devolve "" quando
// nao ha o que avisar (tunel vivo, presenca desconhecida, ou status que ja
// nao promete rota). Pura: o chamador passa o que ja buscou.
String serviceReachabilityNote(String status, Bool tunnelOnline, Bool tunnelKnown) {
    if (tunnelKnown == false || tunnelOnline) {
        return ""
    }
    if (status == "ONLINE") {
        return "Aviso:   health diz ONLINE mas o tunel esta OFFLINE — o site esta fora do ar (health e a ultima foto do Agent)."
    }
    return ""
}

Int cmdServiceStatus(List<String> args) {
    // Flag solta/repetida barra antes de qualquer rede (precedente:
    // --tls-cert do domain verify e do scan).
    if (flagMissingValue(args, "--tls-cert") || flagDuplicated(args, "--tls-cert")) {
        println("uso: kof cloud service status <nome> [--tls-cert <pem>]")
        return 1
    }
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var name = firstPositional(args)
    if (name.trim().length == 0 || extraPositional(args, 1)) {
        println("uso: kof cloud service status <nome> [--tls-cert <pem>]")
        return 1
    }
    try {
        var services = fetchServices(session.controlUrl, session.token)
        // Mesmo resolvedor dos comandos que ja recusam ambiguidade: com o
        // mesmo nome em 2 devices (estado legado — a API ja barra novos), o
        // status imprimia o PRIMEIRO em silencio. Nunca escolhe um device
        // arbitrario: nomeia os dois e diz como desambiguar.
        var match = resolveServiceName(services, name)
        if (match.ambiguous) {
            println(serviceAmbiguousLine(name.trim(), match.deviceIds))
            return 1
        }
        var trimmed = name.trim()
        for (var service in services) {
            if (service.name == trimmed) {
                println("Servico: " + service.name)
                println("Host:    https://" + service.hostname)
                try {
                    var devices = fetchDevices(session.controlUrl, session.token)
                    println("Device:  " + deviceLabelFor(devices, service.deviceId))
                } catch (String innerDevice) {
                    println("Device:  " + deviceLabelFor(listOf<Device>(), service.deviceId))
                }
                println("Local:   " + service.localAddress + ":" + intToString(service.localPort))
                println("Exposicao: " + service.exposure)
                println("Status:  " + service.status)
                // O `Status:` e o health reportado pelo Agent (foto que pode
                // estar velha). A presenca real do device vem do Edge: sem
                // ela, um servico `ONLINE` com o tunel caido lia como "no ar".
                var presenceRaw = ""
                var presenceError = ""
                try {
                    presenceRaw = requireOk(http.get(session.controlUrl + "/v1/presence", authHeader(session.token)))
                } catch (String innerPresence) {
                    presenceError = innerPresence
                }
                var tunnelOnline = presenceError.length == 0 && bodyContainsId(presenceRaw, service.deviceId)
                var tunnelKnown = presenceError.length == 0
                println(serviceTunnelLine(service.deviceId, presenceRaw, presenceError))
                var note = serviceReachabilityNote(service.status, tunnelOnline, tunnelKnown)
                if (note.length > 0) {
                    println(note)
                }
                if (service.allowMethods.length > 0) {
                    println("Metodos: " + service.allowMethods)
                }
                if (service.allowPaths.length > 0) {
                    println("Caminhos: " + service.allowPaths)
                }
                // Inventario de credenciais junto do status: o operador ve
                // de relance se ha kfs_ com prazo a vigiar (só AUTHENTICATED
                // usa; nos demais, a lista vem vazia e nada e impresso).
                // O resumo conta as perto do fim com o MESMO predicado do
                // `token-list` (mesma janela, mesmo relogio) — o status era
                // quem contava "com expiracao" sem dizer qual estava no fim.
                try {
                    var tokenBody = mapOf()
                    tokenBody.put("serviceId", service.id)
                    var tokenRaw = requireOk(http.post(session.controlUrl + "/v1/services/tokens", json.encode(tokenBody), jsonHeader(session.token)))
                    var entries = json.decode<List<ServiceTokenEntry>>(tokenRaw)
                    var inventory = tokenInventoryLine(entries, longToString(time.now()))
                    if (inventory.length > 0) {
                        println(inventory)
                    }
                } catch (String inner) {
                    // Inventario e diagnostico secundario: nao derruba o
                    // status se falhar (o dado principal ja saiu).
                }
                // Dominios proprios vinculados: o operador ve de relance se
                // o servico tem customs (e se falta DNS em algum). Falha
                // silenciosa nao derruba o status (mesma regra do inventario).
                var statusHosts = listOf<String>()
                try {
                    var domainRaw = requireOk(http.get(session.controlUrl + "/v1/domains", authHeader(session.token)))
                    var domains = json.decode<List<DomainEntry>>(domainRaw)
                    var customs = customDomainsFor(domains, service.name)
                    for (var custom in customs) {
                        println("Dominio: " + domainListLine(custom))
                        statusHosts.add(custom.hostname)
                    }
                } catch (String innerDomains) {
                }
                // Rodaapé TLS (Fase 9 slice 3): com --tls-cert, o PEM julgado
                // contra o hostname do status + os customs (uma linha por
                // hostname, via a mesma `domainCertLine` do domain verify).
                // PEM que nao cobre ou invalido vira FALHA (exit 1); aviso de
                // expiracao ou openssl ausente so aparecem na linha. Sem
                // --tls-cert nada e impresso — o status nao muda para quem
                // nao pediu.
                var certPath = flagValue(args, "--tls-cert").trim()
                if (certPath.length > 0) {
                    var certHosts = listOf(service.hostname)
                    for (var domainHost in statusHosts) {
                        if (domainHost != service.hostname) {
                            certHosts.add(domainHost)
                        }
                    }
                    var certLines = serviceCertLines(certPath, certHosts)
                    var certFailed = false
                    for (var certLine in certLines) {
                        println(certLine)
                        if (certLine.startsWith("FALHA")) {
                            certFailed = true
                        }
                    }
                    if (certFailed) {
                        return 1
                    }
                }
                return 0
            }
        }
        printServiceNotFound(services, name)
        return 1
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

Int cmdServiceSuspend(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var name = firstPositional(args)
    if (name.trim().length == 0 || extraPositional(args, 1)) {
        println("uso: kof cloud service suspend <nome>")
        return 1
    }
    try {
        var target = resolveServiceOrReport(session, name)
        if (target.length == 0) {
            return 1
        }
        var body = mapOf()
        body.put("serviceId", target)
        requireOk(http.post(session.controlUrl + "/v1/services/suspend", json.encode(body), jsonHeader(session.token)))
        println("Servico suspenso (fora da rota, nada removido): " + name)
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

Int cmdServiceUnsuspend(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var name = firstPositional(args)
    if (name.trim().length == 0 || extraPositional(args, 1)) {
        println("uso: kof cloud service unsuspend <nome>")
