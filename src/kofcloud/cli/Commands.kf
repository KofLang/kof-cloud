// `logs` (marcos de sessao, gravados pela CLI) e `logs --runtime` (eventos
// reais do Agent: connect, reconnect, recusa fatal, health, streams). Os dois
// arquivos tem teto proprio; `--tail` vale para o escolhido.
// Webhook de incidentes (Fase 17 s3): `set <url> --secret <s>`, `show`,
// `remove`, `test`. O segredo nunca aparece na saida (so o prefixo).
Int cmdWebhook(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var sub = firstPositional(args).trim()
    if (sub.length == 0) {
        println("uso: kof cloud webhook set <url> --secret <segredo> | show | remove | test")
        return 1
    }
    // Aridade por subcomando: `show`/`remove`/`test` nao tem posicional e
    // `set` tem exatamente um (a URL). Antes, `webhook show lixo` executava
    // o show e ignorava o token; `webhook set a b --secret s` configurava
    // "a" e descartava "b" em silencio.
    var maxPositional = 1
    if (sub == "set") {
        maxPositional = 2
    }
    if (extraPositional(args, maxPositional)) {
        println("uso: kof cloud webhook set <url> --secret <segredo> | show | remove | test")
        return 1
    }
    try {
        var body = mapOf()
        var endpoint = "/v1/webhook"
        if (sub == "set") {
            var url = secondPositional(args).trim()
            var secret = flagValue(args, "--secret").trim()
            // `--secret` sem valor ou repetido: flagValue devolveria "" ou o
            // primeiro valor — segredo errado configurado em silencio.
            if (url.length == 0 || secret.length == 0 || flagMissingValue(args, "--secret") || flagDuplicated(args, "--secret")) {
                println("uso: kof cloud webhook set <url> --secret <segredo>")
                return 1
            }
            body.put("action", "set")
            body.put("url", url)
            body.put("secret", secret)
        } else if (sub == "show") {
            body.put("action", "show")
        } else if (sub == "remove") {
            body.put("action", "remove")
        } else if (sub == "test") {
            body.put("action", "test")
        } else {
            println("subcomando desconhecido: webhook " + sub)
            return 1
        }
        var raw = requireOk(http.post(session.controlUrl + endpoint, json.encode(body), jsonHeader(session.token)))
        var result = json.decode<Map<String, String>>(raw)
        if (sub == "set") {
            println("Webhook configurado.")
            println("  URL:    " + mapField(result, "url"))
            println("  Segredo: " + mapField(result, "secretHint") + " (guardado; nunca e impresso por inteiro)")
            println("")
            println("O receptor deve verificar o header `X-KofCloud-Signature: sha256=<hex>`,")
            println("calculando hex(HMAC-SHA256(segredo, corpo_bruto)) em tempo constante.")
        } else if (sub == "show") {
            println("URL:     " + mapField(result, "url"))
            println("Segredo: " + mapField(result, "secretHint"))
        } else if (sub == "remove") {
            println("Webhook removido.")
        } else {
            var delivered = mapField(result, "delivered")
            if (delivered == "200") {
                println("Entrega de teste OK.")
            } else {
                println("Entrega de teste falhou (o incidente fica registrado de qualquer forma).")
            }
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

// Contencao (Fase 17 slice 2): `freeze service|device <nome|id>` suspende,
// revoga credenciais vivas e abre o incidente; `unfreeze` restaura o status
// anterior. Sempre reversivel — nada e destruido.
Int cmdFreeze(List<String> args) {
    return runContainment(args, true)
}

Int cmdUnfreeze(List<String> args) {
    return runContainment(args, false)
}

Int runContainment(List<String> args, Bool freezing) {
    var verb = "unfreeze"
    if (freezing) {
        verb = "freeze"
    }
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    if (extraPositional(args, 2)) {
        println("uso: kof cloud " + verb + " service|device <nome|id>")
        return 1
    }
    // `account` e o alvo da propria conta: sem id, sem nome — o token decide.
    var kind = firstPositional(args).trim()
    var name = secondPositional(args).trim()
    if (kind.length == 0) {
        println("uso: kof cloud " + verb + " service|device <nome|id> | account")
        return 1
    }
    if (kind != "service" && kind != "device" && kind != "account") {
        println("alvo invalido: use service, device ou account")
        return 1
    }
    if (kind != "account" && name.length == 0) {
        println("uso: kof cloud " + verb + " service|device <nome|id>")
        return 1
    }
    if (kind == "account" && name.length > 0) {
        println("uso: kof cloud " + verb + " account   (sem id: a conta do login)")
        return 1
    }
    try {
        var targetId = name
        if (kind == "service") {
            var services = fetchServices(session.controlUrl, session.token)
            var match = resolveServiceName(services, name)
            if (match.ambiguous) {
                println(serviceAmbiguousLine(name.trim(), match.deviceIds))
                return 1
            }
            var matched = match.uniqueId
            if (matched.length == 0) {
                printServiceNotFound(services, name)
                return 1
            }
            targetId = matched
        } else if (kind == "device") {
            var devices = fetchDevices(session.controlUrl, session.token)
            var matched = ""
            for (var device in devices) {
                if (device.name == name || device.id == name) {
                    matched = device.id
                }
            }
            if (matched.length == 0) {
                printDeviceNotFound(devices, name)
                return 1
            }
            targetId = matched
        }
        var body = mapOf()
        body.put("target", kind)
        body.put("id", targetId)
        var endpoint = "/v1/freeze"
        if (freezing == false) {
            endpoint = "/v1/unfreeze"
        }
        var raw = requireOk(http.post(session.controlUrl + endpoint, json.encode(body), jsonHeader(session.token)))
        var result = json.decode<Map<String, String>>(raw)
        var label = name
        if (kind == "account") {
            label = session.handle
        }
        if (freezing) {
            println("Congelado (" + kind + "): " + label)
            println("Credenciais revogadas: " + mapField(result, "revoked"))
            println("Incidente: " + mapField(result, "incidentId"))
            println("")
            var undo = "kof cloud unfreeze " + kind
            if (name.length > 0) {
                undo = undo + " " + name
            }
            println("Reverter: " + undo)
        } else {
            println("Descongelado (" + kind + "): " + label)
            println("Configuracao preservada; status anterior restaurado.")
            println("Credenciais revogadas no freeze NAO voltam — emita novas se precisar.")
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

// Incidentes (Fase 17 slice 1): lista os abertos da conta + os globais
// (plataforma). `--all` mostra so os globais; `--resolve <id>` fecha um.
Int cmdIncidents(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    if (extraPositional(args, 0) || flagDuplicated(args, "--all") || flagMissingValue(args, "--resolve") || flagDuplicated(args, "--resolve")) {
        println("uso: kof cloud incidents [--all] [--resolve <id>]")
        return 1
    }
    var resolveId = flagValue(args, "--resolve").trim()
    try {
        var body = mapOf()
        if (hasFlag(args, "--all")) {
            body.put("all", "true")
        }
        if (resolveId.length > 0) {
            body.put("resolveId", resolveId)
        }
        var raw = requireOk(http.post(session.controlUrl + "/v1/incidents", json.encode(body), jsonHeader(session.token)))
        var list = json.decode<List<IncidentEntry>>(raw)
        if (resolveId.length > 0) {
            println("Incidente fechado: " + resolveId)
        }
        if (list.size == 0) {
            println("nenhum incidente aberto")
            return 0
        }
        for (var incident in list) {
            var state = "ABERTO"
            if (incident.resolvedAt != "0") {
                state = "FECHADO"
            }
            println(incident.severity + "  " + incident.kind + "  " + state + "  " + incident.id)
            println("  " + incident.summary)
            if (incidentIsReopen(incident.kind)) {
                println("  reincidencia de " + incidentBaseKind(incident.kind) + " depois de resolvido — CRIT de proposito; o historico esta no audit")
            }
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

// Migracao de estado (Fase 16 slice 1): `--dry-run` le a origem, valida e,
// se houver destino, compara as contagens SEM escrever. Sem --dry-run copia
// o arquivo validado para o destino (mesmo backend de arquivo; outros
// backends virão com a interface de store da Fase 16).
Int cmdMigrate(List<String> args) {
    if (extraPositional(args, 0) || flagMissingValue(args, "--from") || flagDuplicated(args, "--from") || flagMissingValue(args, "--to") || flagDuplicated(args, "--to") || flagDuplicated(args, "--dry-run")) {
        println("uso: kof cloud migrate --from <estado.json> [--to <destino.json>] [--dry-run]")
        return 1
    }
    var from = flagValue(args, "--from").trim()
    var to = flagValue(args, "--to").trim()
    var dryRun = hasFlag(args, "--dry-run")
    if (from.length == 0) {
        println("uso: kof cloud migrate --from <estado.json> [--to <destino.json>] [--dry-run]")
        return 1
    }
    if (fileExists(from) == false) {
        println("origem nao encontrada: " + from)
        return 1
    }
    var source = Registry(from)
    if (source.loadStatus == "corrupt") {
        println("origem ilegivel: " + from)
        println("O arquivo existe mas nao decodifica como estado do control plane.")
        println("Nada foi escrito — restaure de um backup ou corrija o JSON.")
        return 1
    }
    var before = source.stateCounts()
    println("origem: " + from + " (" + source.loadStatus + ")")
    println("  " + countsLine(before))
    if (to.length == 0) {
        println("")
        println("Nada a comparar (sem --to). Leitura e validacao OK.")
        return 0
    }
    var targetCounts = before
    if (fileExists(to)) {
        var target = Registry(to)
        if (target.loadStatus == "corrupt") {
            println("destino ilegivel: " + to)
            return 1
        }
        targetCounts = target.stateCounts()
        println("destino: " + to + " (" + target.loadStatus + ")")
        println("  " + countsLine(targetCounts))
    } else {
        println("destino: " + to + " (nao existe — sera criado)")
    }
    var diff = diffCounts(targetCounts, before)
    if (diff.length > 0) {
        println("")
        println("diferencas (destino -> origem):")
        print(diff)
    } else {
        println("")
        println("contagens identicas.")
    }
    if (dryRun) {
        println("")
        println("--dry-run: nada foi escrito.")
        return 0
    }
    var raw = readTextOr(from, "")
    if (writeTextTo(to, raw) == false) {
        println("falha ao gravar " + to)
        return 1
    }
    println("")
    println("estado copiado para " + to)
    return 0
}

// Copia de seguranca (Fase 16 s1): preserva o estado em disco antes de
// qualquer troca de backend. Recusa origem ilegivel — a falha e no arquivo,
// nao no backup, e nao se copia o que nao decodifica.
Int cmdStateBackup(List<String> args) {
    if (extraPositional(args, 0) || flagMissingValue(args, "--file") || flagDuplicated(args, "--file")) {
        println("uso: kof cloud state-backup [--file <estado.json>]")
        return 1
    }
    var path = resolveStatePath(flagValue(args, "--file"))
    var registry = Registry(path)
    if (registry.loadStatus == "corrupt") {
        println("origem ilegivel: " + path)
        println("O arquivo existe mas nao decodifica como estado do control plane.")
        println("Nada foi copiado — restaure de um backup ou corrija o JSON.")
        return 1
    }
    if (registry.loadStatus == "absent") {
        println("sem estado em " + path + " — nada a copiar")
        return 1
    }
    var stamp = "" + longToString(time.now())
    var backup = registry.backupStateFile(stamp)
    if (backup == "!") {
        println("falha ao copiar " + path)
        return 1
    }
    println("backup: " + backup)
    println("  " + countsLine(registry.stateCounts()))
    return 0
}

Int cmdLogs(List<String> args) {
    // --runtime/--edge repetidos seguiam normal: `hasFlag` leria o primeiro e
    // o comando rodaria como se fosse um so (mesma regra do --tail abaixo).
    // `logs` nao tem posicional: `logs lixo` lia o log e ignorava o token
    // (typo silencioso). Barra antes de ler o arquivo.
    if (flagDuplicated(args, "--runtime") || flagDuplicated(args, "--edge") || extraPositional(args, 0)) {
        println(usoLogsLine())
        return 1
    }
    var runtime = hasFlag(args, "--runtime")
    var edge = hasFlag(args, "--edge")
    // Mutuamente exclusivos por desenho: os dois seriam "eventos reais" de
    // processos diferentes (Agent local x Edge da plataforma); ler os dois
    // de uma vez misturaria mundos sem dizer qual linha vem de qual.
    if (runtime && edge) {
        println(usoLogsLine())
        return 1
    }
    var path = logPath()
    if (runtime) {
        path = agentRuntimeLogPath()
    } else if (edge) {
        path = edgeRuntimeLogPath()
    }
    var text = readTextOr(path, "")
    if (text.length == 0) {
        if (runtime) {
            println("sem eventos de runtime (o Agent ainda nao rodou neste host)")
        } else if (edge) {
            println("sem eventos do Edge (o serve ainda nao rodou neste host)")
        } else {
            println("sem logs")
        }
        return 0
    }
    var tailRaw = flagValue(args, "--tail")
    // Solta: sem valor nao ha o que aparar. Duplicada: `flagValue` leria
    // a primeira em silencio (o operador leria a ultima no comando).
    if (flagMissingValue(args, "--tail") || flagDuplicated(args, "--tail")) {
        println(usoLogsLine())
        return 1
    }
    if (tailRaw.trim().length > 0) {
        var n = parseIntBounded(tailRaw, -1, 2147483647)
        if (n <= 0) {
            println(usoLogsLine())
            return 1
        }
        text = tailLines(text, n)
    }
    println(text)
    return 0
}

record AuditEntry(String at, String actor, String action, String target, String prevHash, String hash)

// Inventario SBOM (Fase 19 slice 1 parcial): lista curada dos 49 fontes do
// KofCloud — sem Directory.list (plano, sem recursao) e sem versao no repo
// ou no stdlib (STATUS.md documenta o toolchain; nada inventado). O hash
// e sha256 sobre o texto (sonda provou byte-identico ao sha256sum). Pura
// na composicao: SBOM de verdade passa root + conteudos; File.readText
// vive no cmdAudit (precedente: loadManifestFile separa parse de IO).
List<String> sbomModules() {
    return listOf("src/kofcloud/agent/Agent.kf", "src/kofcloud/agent/Backoff.kf", "src/kofcloud/agent/Events.kf", "src/kofcloud/agent/Health.kf", "src/kofcloud/agent/Metrics.kf", "src/kofcloud/agent/Relay.kf", "src/kofcloud/cli/Cli.kf", "src/kofcloud/cli/Commands.kf", "src/kofcloud/cli/Daemon.kf", "src/kofcloud/cli/Deploy.kf", "src/kofcloud/cli/Doctor.kf", "src/kofcloud/cli/Local.kf", "src/kofcloud/cli/Usage.kf", "src/kofcloud/control/ControlPlane.kf", "src/kofcloud/control/Metrics.kf", "src/kofcloud/control/Panel.kf", "src/kofcloud/control/Registry.kf", "src/kofcloud/control/StatusPage.kf", "src/kofcloud/edge/EdgeState.kf", "src/kofcloud/edge/Events.kf", "src/kofcloud/edge/HttpFront.kf", "src/kofcloud/edge/Http.kf", "src/kofcloud/edge/Metrics.kf", "src/kofcloud/edge/Relay.kf", "src/kofcloud/edge/Tunnel.kf", "src/kofcloud/identity/Keys.kf", "src/kofcloud/identity/Tokens.kf", "src/kofcloud/model/Account.kf", "src/kofcloud/model/Audit.kf", "src/kofcloud/model/CustomDomain.kf", "src/kofcloud/model/Device.kf", "src/kofcloud/model/Errors.kf", "src/kofcloud/model/Exposure.kf", "src/kofcloud/model/Incident.kf", "src/kofcloud/model/Service.kf", "src/kofcloud/model/StateCopy.kf", "src/kofcloud/model/Webhook.kf", "src/kofcloud/protocol/Bytes.kf", "src/kofcloud/protocol/Frame.kf", "src/kofcloud/protocol/LineCodec.kf", "src/kofcloud/protocol/Payload.kf", "src/kofcloud/protocol/Session.kf", "src/kofcloud/protocol/Tunnel.kf", "src/kofcloud/protocol/Version.kf", "src/kofcloud/store/Store.kf", "src/kofcloud/util/Hosts.kf", "src/kofcloud/util/Limits.kf", "src/kofcloud/util/Text.kf", "src/Main.kf")
}

// Linha do SBOM: "sha256  caminho" (formato do sha256sum, verificavel por
// fora). Conteudo vazio = arquivo ilegivel (nunca hash de string vazia em
// silencio — seria fingerprint falso).
String sbomLine(String path, String content) {
    if (content.length == 0) {
        return "UNREADABLE  " + path
    }
    return crypto.sha256(content) + "  " + path
}

String sbomText(List<String> modules, List<String> contents) {
    var i = 0
    var out = ""
    while (i < modules.size && i < contents.size) {
        out = out + sbomLine(modules.get(i), contents.get(i)) + "\n"
        i = i + 1
    }
    return out
}

// Trilha de auditoria da conta: ultimos eventos dos proprios recursos.
// Com --sbom: inventario local dos fontes (sem login, sem rede) — Fase 19
// slice 1 parcial. Local por desenho: o SBOM descreve o que esta no disco,
// nao o que o servidor diz que esta.
// Eventos que sobrevivem ao filtro de acao (`--action`): casing exato e o
// vocabulario do fio (device.revoked, service.published...) — sem lowercase
// escondendo typo. Puro, sem rede nem HOME.
List<AuditEntry> auditFilterAction(List<AuditEntry> events, String action) {
    var out = listOf<AuditEntry>()
    for (var event in events) {
        if (event.action == action) {
            out.add(event)
        }
    }
    return out
}

// Ultimas `n` linhas da trilha FILTRADA (a ordem do anel e antigo -> novo,
// entao "tail" significa os eventos mais recentes). `n` <= 0 ou acima do
// tamanho devolve tudo. Puro, sem rede nem HOME.
List<AuditEntry> auditTail(List<AuditEntry> events, Int n) {
    if (n <= 0) {
        return events
    }
    var size = events.size
    if (n >= size) {
        return events
    }
    return events.subList(size - n, size)
}

// Linha do evento para o `audit`: mesmo formato de sempre, com o ator —
// sem ele, "quem revogou?" exigia cruzar com a resposta crua da API.
String auditLine(AuditEntry event) {
    return event.at + "  " + event.actor + "  " + event.action + "  " + event.target
}

Int cmdAudit(List<String> args) {
    if (hasFlag(args, "--sbom")) {
        if (extraPositional(args, 0) || flagDuplicated(args, "--sbom")) {
            println("uso: kof cloud audit [--sbom]")
            return 1
        }
        var modules = sbomModules()
        var contents = listOf<String>()
        for (var module in modules) {
            var text = File(module).readText()
            if (text == null) {
                text = ""
            }
            contents.add(text)
        }
        println(sbomText(modules, contents))
        return 0
    }
    if (hasFlag(args, "--verify")) {
        if (extraPositional(args, 0) || flagDuplicated(args, "--verify")) {
            println("uso: kof cloud audit [--sbom] [--verify]")
            return 1
        }
        var verifySession = loadSession()
        if (verifySession == null) {
            println(notLoggedInLine())
            return 1
        }
        try {
            var raw = requireOk(http.get(verifySession.controlUrl + "/v1/audit/verify", authHeader(verifySession.token)))
            var result = json.decode<Map<String, String>>(raw)
            var events = mapField(result, "events")
            if (mapField(result, "ok") == "true") {
                println("Cadeia de auditoria integra (" + events + " eventos).")
                // Espelho WORM (Fase 19 s4): campos aditivos no fio — control
                // plane antigo responde sem eles e o verify segue honesto
                // (mostra "desconhecido" em vez de mentir "ok").
                var mirrorOk = mapField(result, "mirrorOk")
                if (mirrorOk == "true") {
                    println("Espelho WORM integra (" + mapField(result, "mirrorEvents") + " eventos).")
                } else if (mirrorOk == "false") {
                    println("ESPELHO WORM com problema (" + mapField(result, "mirrorEvents") + " eventos, quebra em \"" + mapField(result, "mirrorBrokenAt") + "\") — trilha redundante comprometida.")
                    return 1
                } else {
                    println("Espelho WORM: desconhecido (control plane sem verificacao do espelho).")
                }
                return 0
            }
            println("CADEIA QUEBRADA no evento " + mapField(result, "brokenAt") + " de " + events + ".")
            println("Alguem alterou ou removeu um evento da trilha — investigue antes de confiar nela.")
            return 1
        } catch (String e) {
            printFail("falha", e)
            return 1
        }
    }
    // --action/--tail: filtrar na CLI (sem API nova). O anel tem 100
    // eventos; achar "quando o device foi revogado" num dump de 100 linhas
    // era varredura visual. Solta/repetida barra no uso (mesma regra de
    // --tail do logs); valor invalido no tail tambem.
    if (extraPositional(args, 0) || flagMissingValue(args, "--action") || flagDuplicated(args, "--action") || flagMissingValue(args, "--tail") || flagDuplicated(args, "--tail")) {
        println("uso: kof cloud audit [--sbom] [--verify] [--action <acao>] [--tail <n>]")
        return 1
    }
    var actionFilter = flagValue(args, "--action").trim()
    var tailRaw = flagValue(args, "--tail").trim()
    var tail = parseIntBounded(tailRaw, -1, 2147483647)
    if (tailRaw.length > 0 && tail <= 0) {
        println("tail invalido: use um numero positivo (ex: --tail 20)")
        return 1
    }
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    try {
        var raw = requireOk(http.get(session.controlUrl + "/v1/audit", authHeader(session.token)))
        var events = json.decode<List<AuditEntry>>(raw)
        if (actionFilter.length > 0) {
            events = auditFilterAction(events, actionFilter)
        }
        if (tail > 0) {
            events = auditTail(events, tail)
        }
        if (events.size == 0) {
            if (actionFilter.length > 0) {
                println("sem eventos com acao " + actionFilter)
            } else {
                println("sem eventos")
            }
            return 0
        }
        for (var event in events) {
            println(auditLine(event))
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

// ---- helpers de control plane ----

List<Service> fetchServices(String control, String token) {
    var raw = requireOk(http.get(control + "/v1/services", authHeader(token)))
    return json.decode<List<Service>>(raw)
}

List<Device> fetchDevices(String control, String token) {
    var raw = requireOk(http.get(control + "/v1/devices", authHeader(token)))
    return json.decode<List<Device>>(raw)
}

String logPath() {
    return kofcloudHome() + "/agent.log"
}

// Sobe a plataforma: control plane + edge no MESMO processo, compartilhando
// uma unica instancia de Registry (sem corrida de arquivo entre processos).
// Portas do `serve` validas? Pura, sem IO — o cmdServe chama antes de
// abrir qualquer listener (fail-fast: sem bind parcial). Mesma faixa da
// API/manifesto (KCF043): 1-65535. Devolve "" quando ok.
// Porta de flag do `serve`: ausente/vazia usa o default; presente e invalida
// vira -1 para `validateServePorts` recusar com mensagem. Sem isso, um valor
// que estoura Int fazia wrap (4294968080 -> 784) ou caia no default em
// silencio. Pura.
Int portFlagValue(String raw, Int fallback) {
    if (raw.trim().length == 0) {
        return fallback
    }
    return parsePortSafe(raw, -1)
}

String validateServePorts(Int controlPort, Int tunnelPort, Int httpPort) {
    if (controlPort <= 0 || controlPort > 65535) {
        return "control-port invalida: " + intToString(controlPort) + " (use 1-65535)"
    }
    if (tunnelPort <= 0 || tunnelPort > 65535) {
        return "tunnel-port invalida: " + intToString(tunnelPort) + " (use 1-65535)"
    }
    if (httpPort <= 0 || httpPort > 65535) {
        return "http-port invalida: " + intToString(httpPort) + " (use 1-65535)"
    }
    return ""
}

// Rotulo humano da porta por papel (mensagem de recusa do bind). Pura.
String servePortLabel(String role) {
    if (role == "control") {
        return "control"
    }
    if (role == "tunnel") {
        return "tunel"
    }
    return "publica"
}

// Mensagem da recusa quando um listener do `serve` nao consegue abrir o
// bind (F16 s3-cont): porta ocupada/privilegiada. Pura — o teste julga o
// texto sem tocar a rede; o bind real vive em prebindServeListener.
String serveBindRefusal(String role, Int port, String cause) {
    return "recusado: nao foi possivel abrir a porta " + servePortLabel(role) + " " + intToString(port) + "\n" +
        "  motivo: " + cause + "\n" +
        "  nenhuma porta foi anunciada como no ar. use outro --" + role + "-port ou libere a porta."
}

// Pre-bind de UM listener (F16 s3-cont): o `serve` abre os tres listeners
// DENTRO de `spawn`; se a porta estivesse ocupada, `net.listen` lancaria e a
// excecao morreria na task — o `serve` seguiria anunciando as portas como no
// ar, com a borda silenciosamente inexistente. Aqui a porta e testada ANTES
// de qualquer spawn/anuncio: abrir e fechar na hora (o listener real reusa o
// bind em seguida). Devolve "" quando a porta abre, ou o motivo da falha.
String prebindServeListener(String role, Int port) {
    try {
        var probe = net.listen(port)
        probe.close()
        return ""
    } catch (String e) {
        return e
    }
}

// Caminho do estado do `serve --state`: ausente, vazio ou so-espacos =
// default (`~/.kofcloud/control-state.json`); senao, o valor aparado.
// Pura, sem HOME nem rede — o default vive aqui como o chamador ja fazia
// inline (precedente: resolveLoginInputs/resolveDaemonControl). Sem isso,
// `--state "   "` pulava o default (length > 0) e virava path invalido.
String resolveStatePath(String flagRaw) {
    var trimmed = flagRaw.trim()
    if (trimmed.length == 0) {
        return kofcloudHome() + "/control-state.json"
    }
    return trimmed
}

// Segredos de fonte externa (F18 s5): o `serve` pode ler o tunnel secret e
// os PEMs de um ARQUIVO ou de um COMANDO (qualquer provedor: Vault, AWS SM,
// 1Password Connect expõem um CLI — a plataforma fala o protocolo aberto do
// shell, nunca um SDK). Lido UMA vez na partida e mantido so em memoria:
// nada e gravado em disco pela plataforma e nenhum valor e impresso (o
// banner diz so a ORIGEM). Rotacao = reiniciar o serve (SIGHUP nao existe,
// L3). Funcoes puras: a decisao nao toca IO, o exec vive em readSecretSource.
//
// "Nenhuma", "exatamente uma" — duas fontes para o mesmo segredo seriam
// escolha silenciosa (a que veio depois, ou a que o codigo leu primeiro):
// erro posicional, como o par TLS.
String secretSourceError(String inlineValue, String filePath, String cmdText, String label) {
    var sources = 0
    if (inlineValue.length > 0) {
        sources = sources + 1
    }
    if (filePath.trim().length > 0) {
        sources = sources + 1
    }
    if (cmdText.trim().length > 0) {
        sources = sources + 1
    }
    if (sources > 1) {
        return label + ": informe UMA fonte (flag direta, arquivo ou comando) — " + intToString(sources) + " dadas"
    }
    return ""
}

// Linha do banner para a origem do segredo: "" (sem origem), "arquivo <p>"
// ou "comando" — o comando NUNCA e ecoado inteiro (pode carregar token na
// linha; o operador sabe o que digitou). Pura.
String secretSourceLabel(String filePath, String cmdText) {
    if (cmdText.trim().length > 0) {
        return "comando (saida lida na partida; o valor nunca e impresso nem gravado)"
    }
    if (filePath.trim().length > 0) {
        return "arquivo " + filePath.trim()
    }
    return ""
}

// Le a fonte externa. `inlineValue` ja vem resolvida (env/config), `file`
// le o arquivo (trim: newline final de `vault kv get -field` nao e segredo),
// `cmd` roda via `sh -c` (precedente: build do deploy — process.run nao faz
// split de shell; o exec vive em `runSecretSource`, compartilhado com os
// PEMs por comando). Falha vira String de erro explicita; "" so quando nao
// ha fonte. O valor nunca entra em mensagem de erro.
//
// O `serve` passa `inlineValue=""` de proposito: com arquivo ou comando o
// env/config nao pode vencer (a fonte externa que o operador passou e a
// escolhida; as fontes ja sao exclusivas pelo `secretSourceError`).
String readSecretSource(String inlineValue, String filePath, String cmdText, String label) {
    if (cmdText.trim().length > 0) {
        return runSecretSource(cmdText, label)
    }
    if (filePath.trim().length > 0) {
        var fromFile = readTextOr(filePath.trim(), "")
        if (fromFile.trim().length == 0) {
            return label + ": arquivo ilegivel ou vazio (" + filePath.trim() + ")"
        }
        return fromFile.trim()
    }
    return inlineValue
}

// Fonte por COMANDO de qualquer segredo (tunnel secret e os dois PEMs):
// execucao unica, para os tres caminhos nao divergirem no contrato de falha
// ("<label>: comando falhou (exit N) — nada foi lido", "saida vazia",
// "comando nao executou") — que e o que `secretSourceFailed` reconhece.
// Mesmo contrato, mesmo trim do newline final, mesmo comando via `sh -c`.
String runSecretSource(String cmdText, String label) {
    try {
        var result = process.run("sh", "-c", cmdText)
        if (result.exitCode != 0) {
            return label + ": comando falhou (exit " + intToString(result.exitCode) + ") — nada foi lido"
        }
        var value = result.stdout.trim()
        if (value.length == 0) {
            return label + ": comando nao devolveu valor (saida vazia)"
        }
        return value
    } catch (String e) {
        return label + ": comando nao executou (" + e + ")"
    }
}

// Falha (mensagem de erro/aviso) vs. valor: o chamador distingue pelo
// prefixo do label — este helper e pura e sem IO. Prefixo com ":" e o que
// readSecretSource usa nas mensagens; um segredo legitimo raramente comeca
// com o label assim, mas para eliminar ambiguidade o chamador compara por
// `startsWith(label + ":")` — o label tem espaco ("tunnel secret"), o que
// nao aparece em segredo hex/opaco.
Bool secretSourceFailed(String label, String valueOrError) {
    return valueOrError.startsWith(label + ":")
}

// TLS do control plane (`serve --tls-cert/--tls-key`): ausente = HTTP
// (comportamento atual); presente exige o PAR (cert + key) — metade sozinha
// e erro posicional, nao default silencioso. Pura, sem IO: o cmdServe le os
// PEMs e falha cedo se o arquivo nao existir. "" = sem TLS.
String resolveTlsPair(String certRaw, String keyRaw) {
    var cert = certRaw.trim()
    var key = keyRaw.trim()
    if (cert.length == 0 && key.length == 0) {
        return ""
    }
    if (cert.length == 0 || key.length == 0) {
        return "tls exige --tls-cert e --tls-key juntos (par ausente)"
    }
    return cert + "\n" + key
}

// Esquema do control plane no banner: https com TLS, http sem.
String controlScheme(String tlsPair) {
    if (tlsPair.length > 0) {
        return "https"
    }
    return "http"
}

// Aviso de PEM expirando (Fase 9 slice 3 parcial): `openssl x509 -checkend`
// devolve exit 0 = valido alem do prazo, 1 = expira dentro (ou PEM ruim).
// Aviso, nunca bloqueio (precedente: artifact ausente no deploy): cortar
// o serve por relogio torto seria pior que servir com cert velho. Pura na
// decisao (exitCode -> Bool); IO (process.run) vive no cmdServe.
// A janela (30 dias, em segundos — unidade que `-checkend` entende) e
// fonte unica dos 5 pontos que consultam o openssl (cmdServe, domain
// status/verify, scan, doctor) + os testes que geram PEM real: mudar o prazo
// muda todos juntos, sem cacar literais `2592000` espalhados.
String tlsCheckendWindowSec() {
    return "2592000"
}

Bool tlsCertExpiringSoon(Int checkendExitCode) {
    return checkendExitCode != 0
}

// Veredito do PEM: "ok" | "expiring" (expira dentro da janela) |
// "expired" (ja venceu) | "unknown" (sem data legivel — sem aviso).
// `checkend != 0` so diz "dentro da janela OU vencido"; a data real
// (`openssl x509 -enddate`) separa os dois. Pura: a data e epoch em ms
// (0 = nao legivel) e o instante vem do chamador.
String tlsCertVerdict(Int checkendExitCode, Long certEndMs) {
    if (checkendExitCode == 0) {
        return "ok"
    }
    if (certEndMs <= 0L) {
        // openssl so recusou a janela; sem a data, o aviso conservador da
        // fatia original (expirando) continua sendo o texto.
        return "expiring"
    }
    // Comparacao com o relogio: o verdict NAO recebe `now` porque a unica
    // decisao e "a data ja passou?" — `certExpiredAt` (puro) faz essa conta.
    if (certExpiredAt(certEndMs, time.now())) {
        return "expired"
    }
    return "expiring"
}

// A data de fim ja passou (puro: agora entra como parametro). Endereco
// invalido (0/negativo) nunca e "vencido" — sem dado nao se inventa.
Bool certExpiredAt(Long certEndMs, Long nowMs) {
    if (certEndMs <= 0L) {
        return false
    }
    return certEndMs < nowMs
}

// Fim de validade do PEM em epoch ms (0 = illegivel/openssl ausente).
// `openssl x509 -enddate -noout` imprime `notAfter=Jun  1 12:00:00 2027 GMT`.
// O Kof nao tem parser de data sem biblioteca aqui; usamos o formato
// compacto do openssl (`-dateopt iso_8601` nao e universal), entao lemos a
// forma ISO que o `-enddate` sempre traz no locale C via regex manual:
// procuramos `YYYY-MM-DD` e, se nao houver, o mes textual do formato C.
Long tlsCertEndDate(String certPath) {
    try {
        var out = process.run("openssl", "x509", "-in", certPath, "-noout", "-enddate").stdout
        var at = out.indexOf("notAfter=")
        if (at < 0) {
            return 0L
        }
        return parseCertEndDate(out.substring(at + 9))
    } catch (String e) {
        return 0L
    }
}

List<String> certMonthNames() {
    return listOf("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
}

// Data do `-enddate` em epoch ms. Aceita os dois formatos que o openssl
// pode imprimir: o C (`Jun  1 12:00:00 2027 GMT`) e o ISO-8601 do openssl 3
// com `-dateopt iso_8601` ou locale (`2027-06-01 12:00:00Z`). 0 = ilegivel.
Long parseCertEndDate(String text) {
    var iso = certIsoDateMs(text)
    if (iso > 0L) {
        return iso
    }
    return parseCertDate(text)
}

// `YYYY-MM-DD` em epoch ms (UTC), sem biblioteca e sem ciclo de import (o
// Deploy.kf tem a mesma `parseIsoDateMs`, mas importa o Commands). 0 quando
// nao ha data ISO legivel no texto.
Long certIsoDateMs(String text) {
    var k = 0
    while (k + 10 <= text.length) {
        var ok = true
        var j = 0
        while (j < 10) {
            var c = text.charAt(k + j) as Int
            if (j == 4 || j == 7) {
                if (c != 45) {
                    ok = false
                }
            } else {
                if (c < 48 || c > 57) {
                    ok = false
                }
            }
            j = j + 1
        }
        if (ok) {
            var year = parseIntBounded(text.substring(k, k + 4), -1, 9999)
            var mon = parseIntBounded(text.substring(k + 5, k + 7), -1, 12)
            var day = parseIntBounded(text.substring(k + 8, k + 10), -1, 31)
            if (year >= 1970 && mon >= 1 && day >= 1) {
                return certDaysMs(year, mon, day)
            }
        }
        k = k + 1
    }
    return 0L
}

// Data do formato C do openssl (`Jun  1 12:00:00 2027 GMT`) em epoch ms
// (meia-noite UTC do dia — basta para "ja venceu?"). 0 quando ilegivel.
Long parseCertDate(String text) {
    var parts = text.split(" ")
    var tokens = listOf<String>()
    for (var part in parts) {
        if (part.trim().length > 0) {
            tokens.add(part.trim())
        }
    }
    if (tokens.size < 4) {
        return 0L
    }
    var months = certMonthNames()
    var mon = 0
    var i = 0
    while (i < months.size) {
        if (months.get(i) == tokens.get(0)) {
            mon = i + 1
        }
        i = i + 1
    }
    var day = parseIntBounded(tokens.get(1), -1, 31)
    var year = parseIntBounded(tokens.get(3), -1, 9999)
    if (mon == 0 || day < 1 || year < 1970) {
        return 0L
    }
    return certDaysMs(year, mon, day)
}

// Dias desde 1970-01-01 (formula civil de Hinnant) > epoch ms. O Deploy.kf
// tem `civilDaysMs` igual; aqui ele fica local porque o Deploy importa o
// Commands (import de volta seria ciclo).
Long certDaysMs(Int year, Int mon, Int day) {
    var y = year
    var mp = mon - 3
    if (mon <= 2) {
        y = y - 1
        mp = mon + 9
    }
    var era = y / 400
    var yoe = y - era * 400
    var doy = (153 * mp + 2) / 5 + day - 1
    var doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    var days = (era * 146097 + doe - 719468) as Long
    return days * 86400000L
}

// Portas: control HTTP, tunel e HTTP publico do edge.
Int cmdServe(List<String> args) {
    // Flag solta vira string vazia no parseIntSafe (default silencioso);
    // duplicada leria a primeira. Ambas rejeitadas antes de validar faixa.
    // --state segue a mesma regra (precedente: --file/--control/--device):
    // solto caia no default em silencio, duplicado lia a primeira.
    if (flagMissingValue(args, "--control-port") || flagMissingValue(args, "--tunnel-port") || flagMissingValue(args, "--http-port") || flagMissingValue(args, "--state") || flagMissingValue(args, "--backup-dir") || flagMissingValue(args, "--waf") || flagMissingValue(args, "--tls-cert") || flagMissingValue(args, "--tls-key") || flagMissingValue(args, "--tunnel-secret-file") || flagMissingValue(args, "--tunnel-secret-cmd") || flagMissingValue(args, "--tls-cert-cmd") || flagMissingValue(args, "--tls-key-cmd")) {
        println(usoServeLine())
        return 1
    }
    // `serve` nao tem posicional: `serve lixo` subia a plataforma e ignorava
    // o token (typo silencioso). Barra antes de qualquer bind.
    if (extraPositional(args, 0)) {
        println(usoServeLine())
        return 1
    }
    if (flagDuplicated(args, "--control-port") || flagDuplicated(args, "--tunnel-port") || flagDuplicated(args, "--http-port") || flagDuplicated(args, "--state") || flagDuplicated(args, "--backup-dir") || flagDuplicated(args, "--waf") || flagDuplicated(args, "--tls-cert") || flagDuplicated(args, "--tls-key") || flagDuplicated(args, "--tunnel-secret-file") || flagDuplicated(args, "--tunnel-secret-cmd") || flagDuplicated(args, "--tls-cert-cmd") || flagDuplicated(args, "--tls-key-cmd") || flagDuplicated(args, "--panel") || flagDuplicated(args, "--status-page")) {
        println("flag repetida — informe uma so vez: kof cloud serve [--control-port N] [--tunnel-port N] [--http-port N] [--state <caminho>] [--backup-dir <dir>] [--panel] [--status-page] [--waf detectar|enforce] [--tls-cert <pem> --tls-key <pem>]")
        return 1
    }
    var controlPort = portFlagValue(flagValue(args, "--control-port"), defaultControlPort())
    var tunnelPort = portFlagValue(flagValue(args, "--tunnel-port"), defaultTunnelPort())
    var httpPort = portFlagValue(flagValue(args, "--http-port"), defaultHttpPort())
    var statePath = resolveStatePath(flagValue(args, "--state"))
    var wafMode = resolveWafMode(flagValue(args, "--waf"))
    var panel = hasFlag(args, "--panel")
    var statusPage = hasFlag(args, "--status-page")
    // Segredo do tunel de fonte externa (F18 s5): flag direta (config/env),
    // arquivo ou comando — nunca duas fontes (erro posicional). Lido na
    // partida, mantido so em memoria, jamais impresso.
    var tunnelCmd = flagValue(args, "--tunnel-secret-cmd")
    var tunnelFile = flagValue(args, "--tunnel-secret-file")
    var tunnelBase = config.str("kofcloud.tunnelSecret", "")
    var tunnelErr = secretSourceError(tunnelBase, tunnelFile, tunnelCmd, "tunnel secret")
    if (tunnelErr.length > 0) {
        println(tunnelErr)
        println(usoServeLine())
        return 1
    }
    // Toda fonte e conferida na PARTIDA, antes de qualquer listener: a linha
    // "tunnel secret: fonte comando (...)" era anunciada e o comando so rodava
    // depois, DENTRO do spawn — um comando de provedor (Vault caido, token
    // expirado) derrubava a task do tunel e o serve seguia anunciando a
    // borda com a porta muda. Falha = recusa visivel (exit 1, nada no ar).
    var tunnelSecret = readSecretSource("", tunnelFile, "", "tunnel secret")
    if (secretSourceFailed("tunnel secret", tunnelSecret)) {
        println(tunnelSecret)
        println(usoServeLine())
        return 1
    }
    if (tunnelCmd.trim().length > 0) {
        tunnelSecret = runSecretSource(tunnelCmd, "tunnel secret")
        if (secretSourceFailed("tunnel secret", tunnelSecret)) {
            println(tunnelSecret)
            println(usoServeLine())
            return 1
        }
    }
    var maxBytes = limitMaxBodyBytes()
    // TLS do control plane (Fase 9 slice 1 parcial): par cert+key em PEM;
    // ausente = HTTP (comportamento atual); metade sozinha = erro local.
    // F18 s5: o PEM tambem pode vir de um comando (--tls-cert-cmd/-key-cmd),
    // exclusivo com o caminho de arquivo (--tls-cert/--tls-key).
    var certCmd = flagValue(args, "--tls-cert-cmd")
    var keyCmd = flagValue(args, "--tls-key-cmd")
    var tlsPair = resolveTlsPair(flagValue(args, "--tls-cert"), flagValue(args, "--tls-key"))
    if (tlsPair.startsWith("tls exige")) {
        println(tlsPair)
        println(usoServeLine())
        return 1
    }
    var tlsCommands = certCmd.trim().length > 0 || keyCmd.trim().length > 0
    if (tlsPair.length > 0 && tlsCommands) {
        println("tls: informe os PEMs por arquivo (--tls-cert/--tls-key) OU por comando (--tls-cert-cmd/--tls-key-cmd), nao os dois")
        println(usoServeLine())
        return 1
    }
    if (tlsCommands && (certCmd.trim().length == 0 || keyCmd.trim().length == 0)) {
        println("tls exige --tls-cert-cmd e --tls-key-cmd juntos (par ausente)")
        println(usoServeLine())
        return 1
    }
    var tlsCertPath = ""
    var tlsKeyPath = ""
    if (tlsCommands) {
        // Comandos: o PEM vai direto para o listenSecure (nunca a um arquivo
        // temporario — gravar em disco e o que a fatia existe para evitar).
        tlsCertPath = ""
        tlsKeyPath = ""
    } else if (tlsPair.length > 0) {
        var sep = tlsPair.indexOf("\n")
        tlsCertPath = tlsPair.substring(0, sep)
        tlsKeyPath = tlsPair.substring(sep + 1)
        var certPem = readTextOr(tlsCertPath, "")
        var keyPem = readTextOr(tlsKeyPath, "")
        if (certPem.length == 0 || keyPem.length == 0) {
            println("tls: PEM ilegivel (cert ou key vazio/ausente) — confira --tls-cert/--tls-key")
            println(usoServeLine())
            return 1
        }
        // Aviso de expiracao (Fase 9 slice 3 parcial): 30 dias OU ja
        // vencido. openssl ausente/erro = sem aviso (nao ha o que checar);
        // expiracao nao bloqueia o serve (aviso, nunca bloqueio — o operador
        // decide). O aviso ja vencido era INALCANCAVEL: o `-checkend` sai 1
        // tambem para cert vencido, a camada tratava como "expira em 30
        // dias" e o operador logo descobria que servia HTTPS com cert morto
        // a semanas. `tlsCertVerdict` (pura) separa os dois pela data real.
        try {
            var check = process.run("openssl", "x509", "-in", tlsCertPath, "-noout", "-checkend", tlsCheckendWindowSec())
            var verdict = tlsCertVerdict(check.exitCode, tlsCertEndDate(tlsCertPath))
            if (verdict == "expired") {
                println("AVISO: certificado TLS JA VENCIDO — navegadores recusam o handshake; renove o PEM e reinicie o serve")
            } else if (verdict == "expiring") {
                println("aviso: certificado TLS expira em menos de 30 dias — renove o PEM")
            }
        } catch (String e) {
        }
    }

    // Fail-fast: valida as tres portas ANTES de abrir qualquer listener —
    // sem isso, --control-port abc caia no default 8080 em silencio e porta
    // fora da faixa quebrava so no bind (com metade da plataforma no ar).
    var portsError = validateServePorts(controlPort, tunnelPort, httpPort)
    if (portsError.length > 0) {
        println(portsError)
        println(usoServeLine())
        return 1
    }
    // Pre-bind (F16 s3-cont): testa as tres portas ANTES de anunciar/spawnar.
    // Sem isso, porta ocupada morria dentro do `spawn` e o serve anunciava
    // portas no ar com a borda inexistente (medido: net.listen lanca
    // "cannot listen on port ... Endereco ja em uso" e a excecao some na task).
    var bindRoles = listOf("control", "tunnel", "http")
    var bindPorts = listOf(controlPort, tunnelPort, httpPort)
    var bi = 0
    while (bi < bindRoles.size) {
        var bindErr = prebindServeListener(bindRoles.get(bi), bindPorts.get(bi))
        if (bindErr.length > 0) {
            println(serveBindRefusal(bindRoles.get(bi), bindPorts.get(bi), bindErr))
            println(usoServeLine())
            return 1
        }
        bi = bi + 1
    }
    if (wafMode == "?") {
        println("waf invalido: " + flagValue(args, "--waf").trim() + " (use detectar|enforce)")
        println(usoServeLine())
        return 1
    }

    var registry = Registry(statePath)
    if (registry.loadStatus == "corrupt") {
        // Fail-closed (Fase 16 s3): com o arquivo ilegivel o serve subia
        // VAZIO e servia "conta sumida" — publicar ali criava conta nova por
        // cima da perda. A mensagem de recusa e PURA (testavel) e o exit e
        // nao-zero; o arquivo nunca e tocado (backup manual antes de seguir).
        println(serveCorruptRefusal(statePath))
        return 1
    }
    // Backups automaticos do estado (F16 s1): a copia e do estado ESTAVEL
    // (sem mutacao ha kofcloud.limits.backupStateMs — backup de escrita no
    // meio perde a mutacao seguinte) e o estado ilegivel nao e copiado
    // (o fail-closed acima ja recusou). Acima do teto a poda remove os mais
    // antigos. Best-effort: falha de IO vira aviso, nunca derruba o serve —
    // disco cheio derrubaria o save() do proprio estado.
    var backupDir = flagValue(args, "--backup-dir").trim()
    if (backupDir.length > 0) {
        println(stateBackupLine(registry.loadStatus, registry.path, backupDir, registry.backupOnBoot(backupDir, limitBackupStateMs(), limitStateBackups())))
    }
    var edgeState = EdgeState(registry)
    edgeState.setWafEnforce(wafMode == "enforce")

    println("kofcloud control plane  -> " + controlScheme(tlsPair) + "://127.0.0.1:" + intToString(controlPort))
    println("kofcloud edge tunnel    -> 127.0.0.1:" + intToString(tunnelPort))
    println("kofcloud edge public    -> http://127.0.0.1:" + intToString(httpPort))
    println("estado: " + statePath)
    println("waf: " + wafMode)
    var secretLabel = secretSourceLabel(tunnelFile, tunnelCmd)
    if (secretLabel.length > 0) {
        println("tunnel secret: fonte " + secretLabel)
    }
    if (tlsCommands) {
        println("tls: control plane em HTTPS (PEMs dos comandos do operador)")
    } else if (tlsPair.length > 0) {
        println("tls: control plane em HTTPS (cert do operador)")
    }
    if (panel) {
        println("painel: http://127.0.0.1:" + intToString(controlPort) + "/panel")
    }
    if (statusPage) {
        println("status:  http://127.0.0.1:" + intToString(controlPort) + "/status")
    }

    var platformStop = kofcloudHome() + "/platform-stop"
    File(platformStop).delete()
    var control = ControlPlane(registry, controlPort, "127.0.0.1", tunnelPort)
    if (panel) {
        control.enablePanel()
    }
    if (statusPage) {
        control.enableStatusPage()
    }
    if (tlsCommands) {
        // PEMs dos comandos: lidos UMA vez aqui (nao antes — o --dry-run
        // nao existe no serve; ler so no momento de subir evita segredo na
        // memoria por mais tempo que o necessario). Falha = nao sobe HTTPS
        // com PEM vazio (erro explicito).
        var certFromCmd = runSecretSource(certCmd, "tls cert")
        var keyFromCmd = runSecretSource(keyCmd, "tls key")
        if (secretSourceFailed("tls cert", certFromCmd)) {
            println(certFromCmd)
            println(usoServeLine())
            return 1
        }
        if (secretSourceFailed("tls key", keyFromCmd)) {
            println(keyFromCmd)
            println(usoServeLine())
            return 1
        }
        control.enableTls(certFromCmd, keyFromCmd)
    } else if (tlsPair.length > 0) {
        // PEMs ja validados acima (nao-vazios); rele do disco por clareza —
        // o readTextOr do fail-fast e a fonte da verdade, sem duplicar regra.
        var sep = tlsPair.indexOf("\n")
        control.enableTls(readTextOr(tlsPair.substring(0, sep), ""), readTextOr(tlsPair.substring(sep + 1), ""))
    }
    var controlTask = spawn { control.start() }
    var tunnelTask = spawn { serveTunnel(edgeState, tunnelPort, tunnelSecret, platformStop) }
    var httpTask = spawn { serveHttp(edgeState, httpPort, maxBytes, platformStop) }
    var expiryTask = spawn { credentialExpirySweeper(registry, platformStop, limitExpirySweepMs()) }
    var usageTask = spawn { usagePushSweeper(registry, platformStop, limitUsagePushMs()) }
    await controlTask
    return 0
}

// Linha do banner do backup automatico (pura): nomeia o resultado sem
// segredo. "estado ilegivel" e inalcancavel pelo cmdServe (o fail-closed
// recusa antes) — fica aqui para a fatia ser reusavel sem mentir.
String stateBackupLine(String loadStatus, String statePath, String dir, String result) {
    if (loadStatus == "absent") {
        return "backup: sem estado em " + statePath + " — nada a copiar"
    }
    if (loadStatus == "corrupt") {
        return "backup: estado ilegivel — nada foi copiado (preserve o arquivo antes de qualquer troca)"
    }
    if (result.startsWith("!")) {
        return "backup: AVISO — nao foi possivel copiar para " + dir + " (" + result.substring(1) + "); o serve segue"
    }
    return "backup: " + result
}

// Laco da varredura periodica de credenciais vencidas (serve): a poda
// preguicosa (`serviceByServiceToken`/`accountByToken`) so roda quando
// alguem valida — conta ociosa acumula kfs_/kfc_ vencidos no estado sem
// sinal ate la. O laco poda e alimenta a sonda de expiracao em massa sem
// validacao, no passo de `limitExpirySweepMs()`. Mesma sentenca dos demais
// lacos (para no stopFile da plataforma; o Kof nao tem relogio por task).
// Pusher de uso para billing (F18 s4): a cada passo empurra a janela das
// contas com webhook configurado (Registry.pushUsageAll — no-op sem webhook
// ou sem uso). Mesmo padrao de sentinela/parada do sweeper de credenciais;
// erro de entrega nunca derruba o laco (o proximo passo reempurra a janela
// seguinte — a que falhou ja foi snapshotada e o consumidor deduplica por
// periodEnd, como no export).
void usagePushSweeper(Registry registry, String platformStop, Int intervalMs) {
    var running = true
    while (running) {
        time.sleep(intervalMs)
        if (File(platformStop).exists()) {
            running = false
        } else {
            registry.pushUsageAll()
        }
    }
}

void credentialExpirySweeper(Registry registry, String platformStop, Int intervalMs) {
    var running = true
    while (running) {
        time.sleep(intervalMs)
        if (File(platformStop).exists()) {
            running = false
        } else {
            registry.sweepExpiredCredentials()
        }
    }
}

void appendLog(String message) {
    var line = longToString(time.now()) + " " + message + "\n"
    var file = File(logPath())
    // Teto anti-crescimento infinito: estouro corta o inicio (linhas
    // inteiras), mantendo o recente. O que entra aqui nunca tem segredo
    // (so marcos de sessao — ver cmdConnect); tokens e chaves jamais.
    if (file.exists()) {
        var capped = trimLogHead(readTextOr(logPath(), "") + line, limitLogBytes())
        writeTextTo(logPath(), capped)
    } else {
        writeTextTo(logPath(), line)
    }
}
