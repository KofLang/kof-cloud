// ---- servicos ----

// Valida nome/porta/exposure/address ANTES de qualquer rede ou sessao:
// pura, testavel sem HOME. Devolve "" quando ok, ou a mensagem de erro
// (mesmas regras da API KCF045/KCF047 — fail-fast local com dica).
String validatePublishLocal(String name, Int port, String exposure, String address) {
    if (name.length == 0 || port <= 0 || port > 65535) {
        return "uso: kof cloud publish <nome> --port <porta> (porta 1-65535)"
    }
    if (exposure != "PUBLIC" && exposure != "AUTHENTICATED" && exposure != "PRIVATE") {
        return "exposure invalida: " + exposure + " (use PUBLIC, AUTHENTICATED ou PRIVATE)"
    }
    if (validLocalAddress(address) == false) {
        return "address invalido: " + address + " (use 127.0.0.1, localhost ou ::1)"
    }
    return ""
}

Int cmdPublish(List<String> args) {
    var identity = loadIdentity()
    var session = loadSession()
    if (identity == null) {
        println("nao logado — rode: kof cloud login <handle> --password <senha>")
        return 1
    }
    if (session == null) {
        println("nao logado — rode: kof cloud login <handle> --password <senha>")
        return 1
    }
    var name = firstPositional(args)
    // Flags com valor obrigatorio quando presentes: `--port` solto (sem
    // valor) nao pode cair no erro generico de uso nem em default.
    // Duplicada tambem nao: `flagValue` leria a primeira em silencio.
    if (flagMissingValue(args, "--port") || flagMissingValue(args, "--address") || flagMissingValue(args, "--exposure") || flagMissingValue(args, "--device")) {
        println("uso: kof cloud publish <nome> --port <porta> [--exposure PUBLIC|AUTHENTICATED|PRIVATE] [--address <addr>] [--device <nome>]")
        return 1
    }
    if (flagDuplicated(args, "--port") || flagDuplicated(args, "--address") || flagDuplicated(args, "--exposure") || flagDuplicated(args, "--device")) {
        println("flag repetida — informe uma so vez: kof cloud publish <nome> --port <porta> [--exposure PUBLIC|AUTHENTICATED|PRIVATE] [--address <addr>] [--device <nome>]")
        return 1
    }
    if (extraPositional(args, 1)) {
        println("argumento a mais — uso: kof cloud publish <nome> --port <porta> [--exposure PUBLIC|AUTHENTICATED|PRIVATE] [--address <addr>] [--device <nome>]")
        return 1
    }
    var port = parseIntSafe(flagValue(args, "--port"), 0)
    var address = flagValue(args, "--address")
    if (address.length == 0) {
        address = "127.0.0.1"
    }
    var exposure = flagValue(args, "--exposure")
    if (exposure.length == 0) {
        exposure = "PUBLIC"
    }
    var deviceId = identity.deviceId
    var overrideDevice = flagValue(args, "--device")
    if (overrideDevice.length > 0) {
        // Aceita NOME ou id: a ajuda documenta <nome>, mas ids tambem
        // funcionam (compat). Nome resolve pela lista da conta; id passa
        // direto e o control plane valida (404 opaco se alheio).
        deviceId = deviceIdByNameOrId(session, overrideDevice)
        if (deviceId.length == 0) {
            println("dispositivo nao encontrado: " + overrideDevice)
            return 1
        }
    }
    // Fail-fast local (mesmas regras da API KCF045/KCF047): evita uma
    // viagem de rede para um erro certo, com dica acionavel na hora.
    var localError = validatePublishLocal(name, port, exposure, address)
    if (localError.length > 0) {
        println(localError)
        return 1
    }
    var body = mapOf()
    body.put("deviceId", deviceId)
    body.put("name", name)
    body.put("localAddress", address)
    body.put("localPort", intToString(port))
    body.put("protocol", "http")
    body.put("exposure", exposure)
    try {
        var raw = requireOk(http.post(session.controlUrl + "/v1/services", json.encode(body), jsonHeader(session.token)))
        var service = json.decode<Service>(raw)
        println("Servico publicado.")
        println("")
        println("Nome:   " + service.name)
        println("Local:  " + service.localAddress + ":" + intToString(service.localPort))
        println("Publico: https://" + service.hostname)
        println("Status: " + service.status)
        return 0
    } catch (String e) {
        printFail("falha ao publicar", e)
        return 1
    }
}

Int cmdUnpublish(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println("nao logado")
        return 1
    }
    var name = firstPositional(args)
    if (name.length == 0 || extraPositional(args, 1)) {
        println("uso: kof cloud unpublish <nome>")
        return 1
    }
    try {
        var services = fetchServices(session.controlUrl, session.token)
        var target = ""
        for (var service in services) {
            if (service.name == name) {
                target = service.id
            }
        }
        if (target.length == 0) {
            println("servico nao encontrado: " + name)
            return 1
        }
        var body = mapOf()
        body.put("serviceId", target)
        requireOk(http.post(session.controlUrl + "/v1/services/remove", json.encode(body), jsonHeader(session.token)))
        println("Servico removido: " + name)
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

