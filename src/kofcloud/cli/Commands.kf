// Nome de servico aparado para comparacao (os 4 comandos que leem nome
// posicional: unpublish/status/token/token-revoke + o --service do domain
// add verificam via `trimmed == service.name`; sem isso, `" site "` nao
// resolve o servico `site` — mesma regra do publish/resolvers).
// Pura, sem rede nem HOME.
String matchServiceName(List<Service> services, String name) {
    var trimmed = name.trim()
    for (var service in services) {
        if (service.name == trimmed) {
            return service.id
        }
    }
    return ""
}

// Id do servico pelo nome (para os comandos que operam por serviceId).
// "" quando nao existe na conta. Delega no matchServiceName (mesma regra
// do parseManifest: "  site  " na CLI resolve o servico "site").
String serviceIdByName(LocalSession session, String name) {
    var services = fetchServices(session.controlUrl, session.token)
    return matchServiceName(services, name)
}

// Id do dispositivo por NOME ou id (para `--device`). Nome resolve pela
// lista da conta (filtrada no control plane); id passa direto e o control
// plane valida depois (404 opaco se alheio/inexistente). "" so quando o
// NOME nao existe — id cru nunca e recusado aqui.
String deviceIdByNameOrId(LocalSession session, String nameOrId) {
    var trimmed = nameOrId.trim()
    var devices = fetchDevices(session.controlUrl, session.token)
    for (var device in devices) {
        if (device.name == trimmed) {
            return device.id
        }
    }
    for (var device in devices) {
        if (device.id == trimmed) {
            return device.id
        }
    }
    return ""
}

// TTL do `service token --ttl` valido? Vazio ou so-espacos = sem expiracao
// (ok); senao, inteiro positivo aparado (mesma regra do KCF062 na API).
// Pura, sem rede nem HOME — o cmdServiceToken usa antes de qualquer fetch.
Bool validTtlHours(String ttlRaw) {
    var trimmed = ttlRaw.trim()
    if (trimmed.length == 0) {
        return true
    }
    return parseIntSafe(trimmed, -1) > 0
}

// Emite uma credencial kfs_ para um servico AUTHENTICATED. O token da conta
// autoriza a emissao; o token devolvido e o que o cliente final usa.
// `--ttl <horas>`: expiracao opcional (ex.: 24 = 1 dia); sem flag, sem
// expiracao. Valido localmente antes da rede (mesma regra do KCF062);
// o control plane valida de novo (defesa em profundidade).
Int cmdServiceToken(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var name = firstPositional(args)
    if (name.trim().length == 0 || extraPositional(args, 1)) {
        println(usoServiceTokenLine())
        return 1
    }
    var ttlRaw = flagValue(args, "--ttl")
    if (flagMissingValue(args, "--ttl") || flagDuplicated(args, "--ttl")) {
        println(usoServiceTokenLine())
        return 1
    }
    if (validTtlHours(ttlRaw) == false) {
        println("ttl invalido: " + ttlRaw.trim() + " (use horas positivas, ex: --ttl 24)")
        return 1
    }
    try {
        var services = fetchServices(session.controlUrl, session.token)
        var trimmed = name.trim()
        var target = ""
        var exposure = ""
        var hostname = ""
        for (var service in services) {
            if (service.name == trimmed) {
                target = service.id
                exposure = service.exposure
                hostname = service.hostname
            }
        }
        if (target.length == 0) {
            println(serviceNotFoundLine(name))
            return 1
        }
        if (exposureRequiresAuth(exposure) == false) {
            println("aviso: " + name + " esta " + exposure + " — o token so e exigido em AUTHENTICATED")
        }
        var body = mapOf()
        body.put("serviceId", target)
        if (ttlRaw.trim().length > 0) {
            body.put("ttlHours", ttlRaw.trim())
        }
        var raw = requireOk(http.post(session.controlUrl + "/v1/services/token", json.encode(body), jsonHeader(session.token)))
        var token = mapField(json.decode<Map<String, String>>(raw), "token")
        println("Token de acesso (" + name + "):")
        println(token)
        if (ttlRaw.trim().length > 0) {
            println("Expira em " + ttlRaw.trim() + "h — depois disso, 401 ate emitir outro.")
        }
        println("")
        println("Uso:")
        println("  curl -H 'Authorization: Bearer " + token + "' https://" + hostname + "/")
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

// Lista as credenciais kfs_ de UM servico (inventario, sem valores).
// Devolve id curto + emissao (+ expiracao, quando houver) para o operador
// saber o que revogar; o kfs_ em claro so existe no instante da emissao e
// nunca e recuperavel. Expiradas nao aparecem (podadas na validacao).
record ServiceTokenEntry(String serviceId, String id, String createdAt, String? expiresAt)

// Resumo do inventario de kfs_ para `service status`: puro, sem rede nem
// HOME — recebe as entradas ja buscadas e devolve a linha pronta ("" quando
// nao ha credenciais). Conta com e sem expiracao separadas para o operador
// saber que ha prazo a vigiar (`token-list` mostra cada uma). Nunca vaza
// valor de token (as entradas so tem id curto, por desenho da API).
String tokenInventoryLine(List<ServiceTokenEntry> entries) {
    if (entries.size == 0) {
        return ""
    }
    var withTtl = 0
    for (var entry in entries) {
        if (entry.expiresAt != null) {
            withTtl = withTtl + 1
        }
    }
    var line = "Credenciais: " + intToString(entries.size) + " emitida(s)"
    if (withTtl > 0) {
        line = line + " (" + intToString(withTtl) + " com expiracao — veja: kof cloud service token-list)"
    }
    return line
}

Int cmdServiceTokenList(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var name = firstPositional(args)
    if (name.trim().length == 0 || extraPositional(args, 1)) {
        println("uso: kof cloud service token-list <nome>")
        return 1
    }
    try {
        var target = serviceIdByName(session, name)
        if (target.length == 0) {
            println(serviceNotFoundLine(name))
            return 1
        }
        var body = mapOf()
        body.put("serviceId", target)
        var raw = requireOk(http.post(session.controlUrl + "/v1/services/tokens", json.encode(body), jsonHeader(session.token)))
        var entries = json.decode<List<ServiceTokenEntry>>(raw)
        if (entries.size == 0) {
            println("nenhuma credencial emitida para: " + name)
            return 0
        }
        for (var entry in entries) {
            var line = entry.id + "  emitida em " + entry.createdAt
            if (entry.expiresAt != null) {
                line = line + "  expira em " + entry.expiresAt
            }
            println(line)
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

// Revoga UMA credencial kfs_ (ex.: vazou no log, no chat, no repo).
// Aceita o valor completo (kfs_...) OU o id curto do `token-list`
// (quando unico no servico; ambiguo pede o completo com 409 KCF063).
// O valor viaja no corpo HTTPS ate o control plane (nunca em URL/log)
// e so o hash e comparado/guardado.
Int cmdServiceTokenRevoke(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var name = firstPositional(args).trim()
    var token = secondPositional(args).trim()
    if (name.length == 0 || token.length == 0 || extraPositional(args, 2)) {
        println("uso: kof cloud service token-revoke <nome> <kfs_...|id>")
        return 1
    }
    try {
        var services = fetchServices(session.controlUrl, session.token)
        var target = matchServiceName(services, name)
        if (target.length == 0) {
            println(serviceNotFoundLine(name))
            return 1
        }
        var body = mapOf()
        body.put("serviceId", target)
        body.put("token", token)
        requireOk(http.post(session.controlUrl + "/v1/services/token/revoke", json.encode(body), jsonHeader(session.token)))
        println("Token revogado para o servico: " + name)
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

// Rotacao assistida (Fase 19 s3): emite uma credencial nova para o servico e
// revoga as anteriores SO depois do TTL (overlap). `--prune` limpa as ja
// expiradas. O token novo aparece uma unica vez — troque onde ele e usado
// antes do prazo acabar.
//
// `rotate --all` (mesmo slice, pendente ate este commit): itera os servicos
// da conta e rotaciona um por um. Falha num servico nao aborta os demais
// (precedente: down --prune poda em lote); o resumo final lista ok/falhas
// e o exit e 1 se alguma falhar. Sem --ttl segue a regra do singular:
// credencial sem expiracao nunca e revogada em silencio.
Int rotateAllServices(LocalSession session, List<Service> services, Int ttl, Bool prune) {
    var done = 0
    var failures = listOf<String>()
    for (var service in services) {
        var body = mapOf()
        body.put("serviceId", service.id)
        if (ttl > 0) {
            body.put("ttlHours", intToString(ttl))
        }
        if (prune) {
            body.put("prune", "true")
        }
        try {
            var raw = requireOk(http.post(session.controlUrl + "/v1/services/rotate", json.encode(body), jsonHeader(session.token)))
            var result = json.decode<Map<String, String>>(raw)
            println(service.name + ": nova " + mapField(result, "token") + " (revogadas " + mapField(result, "revoked") + ", valendo " + mapField(result, "pending") + ")")
            done = done + 1
        } catch (String e) {
            failures.add(service.name)
        }
    }
    if (services.size == 0) {
        println("nenhum servico para rotacionar")
        return 0
    }
    if (failures.size > 0) {
        printFail("falha em " + intToString(failures.size) + " servico(s)", failures.get(0))
        return 1
    }
    println("rotate --all ok: " + intToString(done) + " servico(s)")
    return 0
}

Int cmdServiceRotate(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    // --all dispensa o nome (rotaciona TODOS os servicos da conta); com
    // nome exige exatamente 1 posicional. --all + nome = ambíguo, barra.
    var all = hasFlag(args, "--all")
    var name = firstPositional(args).trim()
    if (all) {
        if (name.length > 0 || extraPositional(args, 1)) {
            println("uso: kof cloud service rotate --all [--ttl <horas>] [--prune]")
            return 1
        }
    } else if (extraPositional(args, 1)) {
        println("uso: kof cloud service rotate <nome> [--ttl <horas>] [--prune]")
        return 1
    }
    var ttlRaw = flagValue(args, "--ttl").trim()
    var ttl = parseIntSafe(ttlRaw, 0)
    if (name.length == 0 && all == false) {
        println("uso: kof cloud service rotate <nome> [--ttl <horas>] [--prune]")
        return 1
    }
    if (ttlRaw.length > 0 && ttl <= 0) {
        println("ttl invalido: use horas inteiras > 0")
        return 1
    }
    if (flagMissingValue(args, "--ttl") || flagDuplicated(args, "--ttl") || flagDuplicated(args, "--all") || flagDuplicated(args, "--prune")) {
        println("uso: kof cloud service rotate [--all] <nome> [--ttl <horas>] [--prune]")
        return 1
    }
    var prune = hasFlag(args, "--prune")
    try {
        var services = fetchServices(session.controlUrl, session.token)
        if (all) {
            return rotateAllServices(session, services, ttl, prune)
        }
        var target = matchServiceName(services, name)
        if (target.length == 0) {
            println(serviceNotFoundLine(name))
            return 1
        }
        var body = mapOf()
        body.put("serviceId", target)
        if (ttl > 0) {
            body.put("ttlHours", intToString(ttl))
        }
        if (prune) {
            body.put("prune", "true")
        }
        var raw = requireOk(http.post(session.controlUrl + "/v1/services/rotate", json.encode(body), jsonHeader(session.token)))
        var result = json.decode<Map<String, String>>(raw)
        println("Credencial nova (" + name + "):")
        println(mapField(result, "token"))
        println("")
        println("Revogadas por expiracao: " + mapField(result, "revoked"))
        println("Ainda valendo (inclui a nova): " + mapField(result, "pending"))
        if (ttl > 0) {
            println("")
            println("Troque onde usa o token em ate " + intToString(ttl) + "h; depois rode:")
            println("  kof cloud service rotation " + name + "   (para conferir)")
            println("  kof cloud service rotate " + name + " --ttl " + intToString(ttl) + "  (proxima rotacao)")
        } else {
            println("")
            println("Sem --ttl a credencial nao expira: rotacione com --ttl para revogar as antigas.")
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

Int cmdServiceRotation(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var name = firstPositional(args).trim()
    if (name.length == 0 || extraPositional(args, 1)) {
        println("uso: kof cloud service rotation <nome>")
        return 1
    }
    try {
        var services = fetchServices(session.controlUrl, session.token)
        var target = matchServiceName(services, name)
        if (target.length == 0) {
            println(serviceNotFoundLine(name))
            return 1
        }
        var body = mapOf()
        body.put("serviceId", target)
        var raw = requireOk(http.post(session.controlUrl + "/v1/services/rotation", json.encode(body), jsonHeader(session.token)))
        var result = json.decode<Map<String, String>>(raw)
        var pending = parseIntSafe(mapField(result, "pending"), 0)
        println("Credenciais validas (" + name + "): " + intToString(pending))
        if (pending <= 1) {
            println("Rotacao concluida: so a credencial atual vale.")
        } else {
            println("Rotacao em andamento: aguarde o TTL das antigas (ou revogue com `service token-revoke`).")
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

// Segundo argumento posicional (o primeiro e capturado por firstPositional).
String secondPositional(List<String> args) {
    var seen = false
    for (var arg in args) {
        if (arg.startsWith("--") == false) {
            if (seen) {
                return arg
            }
            seen = true
        }
    }
    return ""
}

