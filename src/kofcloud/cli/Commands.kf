}

// Id do servico pelo nome, com o desfecho explicito quando ha homonimos.
// Antes `matchServiceName` devolvia o PRIMEIRO que casava: com "site" em
// dois devices, `service status site`, `unpublish site` e `token-revoke site`
// agiam num device arbitrario (a ordem da lista decide) sem avisar — medido.
// `uniqueId` vazio + `ambiguous` true = recuse e liste; o chamador decide a
// mensagem. Pura, sem rede nem HOME.
record ServiceMatch(String uniqueId, Bool ambiguous, List<String> deviceIds)

ServiceMatch resolveServiceName(List<Service> services, String name) {
    var trimmed = name.trim()
    var found = listOf<Service>()
    for (var service in services) {
        if (service.name == trimmed) {
            found.add(service)
        }
    }
    if (found.size == 0) {
        return ServiceMatch("", false, listOf<String>())
    }
    if (found.size > 1) {
        var deviceIds = listOf<String>()
        for (var service in found) {
            deviceIds.add(service.deviceId)
        }
        return ServiceMatch("", true, deviceIds)
    }
    return ServiceMatch(found.get(0).id, false, listOf<String>())
}

// Mensagem unica para o nome ambiguo (fonte unica, como serviceNotFoundLine):
// nomeia o servico e os devices onde ele vive, e diz como desambiguar.
String serviceAmbiguousLine(String name, List<String> deviceIds) {
    return "servico \"" + name + "\" existe em " + intToString(deviceIds.size) + " dispositivos — use `service unpublish|status` do dispositivo certo e remova o duplicado (" + joinCsv(deviceIds) + ")"
}

// "nao encontrado" + dica de caixa (quando ha candidato). Ponto unico das
// mensagens: o aviso de `serviceCaseHint` nunca aparece sem o "nao
// encontrado" e vice-versa — dois prints que se separariam em silencio.
void printServiceNotFound(List<Service> services, String name) {
    println(serviceNotFoundLine(name))
    var hint = serviceCaseHint(services, name)
    if (hint.length > 0) {
        println(hint)
    }
}

// Nome de servico aparado para comparacao (os 4 comandos que leem nome
// posicional: unpublish/status/token/token-revoke + o --service do domain
// add verificam via `trimmed == service.name`; sem isso, `" site "` nao
// resolve o servico `site` — mesma regra do publish/resolvers).
// Pura, sem rede nem HOME. Devolve "" tanto para inexistente quanto para
// ambiguo — quem precisa distinguir usa `resolveServiceName`.
String matchServiceName(List<Service> services, String name) {
    return resolveServiceName(services, name).uniqueId
}

// Guarda de destruicao do `device revoke` (Fase 4/controle): revogar e
// IRREVERSIVEL e leva junto tudo do device — servicos publicados e
// credenciais vivas (mesma familia do `down`, que ja exige --yes). Sem
// confirmacao explicita, um typo ou um comando colado de um script
// derrubava a maquina inteira da plataforma. Pura, sem IO: o chamador ja
// resolveu o nome para id antes de perguntar, entao a mensagem nomeia o
// alvo real.
// Dispositivo informado que nao existe mas casa com um da conta sem
// distinguir maiusculas ("Notebook" x "notebook"). O nome e chave exata —
// adivinhar escolheria a maquina errada —, mas "dispositivo nao encontrado"
// sozinho nao da pista. Ponto unico das mensagens: o aviso nunca aparece
// sem o "nao encontrado". Pura, sem IO (mesma regra da `serviceCaseHint`).
String deviceCaseHint(List<Device> devices, String name) {
    var wanted = name.trim()
    if (wanted.length == 0) {
        return ""
    }
    for (var device in devices) {
        if (device.name != wanted && sameLettersIgnoringCase(device.name, wanted)) {
            return "aviso: o nome importa a caixa — \"" + device.name + "\" existe (informado: \"" + wanted + "\")"
        }
    }
    return ""
}

void printDeviceNotFound(List<Device> devices, String name) {
    println(deviceNotFoundLine(name))
    var hint = deviceCaseHint(devices, name)
    if (hint.length > 0) {
        println(hint)
    }
}

String deviceRevokeConfirmationRequired(String name) {
    return "device revoke remove o dispositivo \"" + name + "\" da plataforma E os servicos/credenciais dele — a revogacao e irreversivel; confirme com `kof cloud device revoke " + name + " --yes`"
}

// Nome de servico que NAO existe mas casa com um publicado sem distinguir
// maiusculas: "Site" nao resolve "site" — o manifesto/CLI casam EXATO, e
// adivinhar (abaixar tudo) mudaria a chave do manifesto em silencio. Mas
// dizer so "nao encontrado" faz o operador conferir o nome no `service list`
// e achar que esta certo. O aviso nomeia o servico e a regra; "" quando nao
// ha candidato (nao inventa dica). Pura, sem IO.
String serviceCaseHint(List<Service> services, String name) {
    var wanted = name.trim()
    if (wanted.length == 0) {
        return ""
    }
    for (var service in services) {
        if (service.name != wanted && sameLettersIgnoringCase(service.name, wanted)) {
            return "aviso: o nome importa a caixa — \"" + service.name + "\" existe (informado: \"" + wanted + "\")"
        }
    }
    return ""
}

// Mesmas letras, caixa diferente? Pura sem `toLowerCase` (a caixa e uma
// lacuna medida do runtime — L20): compara caractere a caractere, e para
// A-Z/a-z aceita as duas formas de um MESMO papel (a<->A etc.).
Bool sameLettersIgnoringCase(String a, String b) {
    if (a.length != b.length) {
        return false
    }
    var i = 0
    while (i < a.length) {
        if (loweredChar(a.charAt(i) as Int) != loweredChar(b.charAt(i) as Int)) {
            return false
        }
        i = i + 1
    }
    return true
}

// Minusculo so para ASCII A-Z; qualquer outro codigo fica igual. Usado SO
// na comparacao acima (nunca para montar texto).
Int loweredChar(Int c) {
    if (c >= 65 && c <= 90) {
        return c + 32
    }
    return c
}

// Resolve o nome para um id e imprime o motivo quando nao da: inexistente
// usa `serviceNotFoundLine`; ambiguo (mesmo nome em 2+ devices) usa
// `serviceAmbiguousLine` — nunca escolhe um device arbitrariamente. Os
// comandos por nome fazem `var target = resolveServiceOrReport(...); if
// (target.length == 0) { return 1 }`. IO (fetch) fica aqui; a decisao e a
// pura `resolveServiceName`.
String resolveServiceOrReport(LocalSession session, String name) {
    var services = fetchServices(session.controlUrl, session.token)
    var match = resolveServiceName(services, name)
    if (match.ambiguous) {
        println(serviceAmbiguousLine(name.trim(), match.deviceIds))
        return ""
    }
    if (match.uniqueId.length == 0) {
        printServiceNotFound(services, name)
        return ""
    }
    return match.uniqueId
}

// Id do dispositivo por NOME ou id (para `--device`). Nome resolve pela
// lista da conta (filtrada no control plane); id passa direto e o control
// plane valida depois (404 opaco se alheio/inexistente). "" so quando o
// NOME nao existe — id cru nunca e recusado aqui.
String deviceIdByNameOrId(LocalSession session, String nameOrId) {
    return resolveDeviceByNameOrId(session, nameOrId).deviceId
}

// Mesma resolucao, devolvendo tambem a lista da conta — a dica de caixa
// precisa dela e duas buscas seriam duas viagens ao control plane para o
// caso de erro (o comum resolve sem dica e a lista nao e usada).
record DeviceResolution(String deviceId, List<Device> devices)

DeviceResolution resolveDeviceByNameOrId(LocalSession session, String nameOrId) {
    var trimmed = nameOrId.trim()
    var devices = fetchDevices(session.controlUrl, session.token)
    // Nome: prefere o device VIVO. Depois de um re-registro (revogar e depois
    // logar de novo com o mesmo nome) convivem o revogado e o novo; devolver
    // o primeiro por ordem de lista podia escolher o morto — e `device revoke
    // <nome>` num revogado era no-op silencioso. Ids sao unicos e passam.
    for (var device in devices) {
        if (device.name == trimmed && deviceIsRevoked(device.status) == false) {
            return DeviceResolution(device.id, devices)
        }
    }
    for (var device in devices) {
        if (device.name == trimmed) {
            return DeviceResolution(device.id, devices)
        }
    }
    for (var device in devices) {
        if (device.id == trimmed) {
            return DeviceResolution(device.id, devices)
        }
    }
    return DeviceResolution("", devices)
}

// TTL do `service token --ttl` valido? Vazio ou so-espacos = sem expiracao
// (ok); senao, inteiro positivo aparado (mesma regra do KCF062 na API).
// Pura, sem rede nem HOME — o cmdServiceToken usa antes de qualquer fetch.
Bool validTtlHours(String ttlRaw) {
    var trimmed = ttlRaw.trim()
    if (trimmed.length == 0) {
        return true
    }
    return parseIntBounded(trimmed, -1, 2147483647) > 0
}

// Emite uma credencial kfs_ para um servico AUTHENTICATED. O token da conta
// autoriza a emissao; o token devolvido e o que o cliente final usa.
// `--ttl <horas>`: expiracao opcional (ex.: 24 = 1 dia); sem flag, sem
// expiracao. Valido localmente antes da rede (mesma regra do KCF062);
// o control plane valida de novo (defesa em profundidade).
Int cmdServiceToken(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var name = firstPositional(args)
    if (name.trim().length == 0 || extraPositional(args, 1)) {
        println(usoServiceTokenLine())
        return 1
    }
    var ttlRaw = flagValue(args, "--ttl")
    if (flagMissingValue(args, "--ttl") || flagDuplicated(args, "--ttl")) {
        println(usoServiceTokenLine())
        return 1
    }
    if (validTtlHours(ttlRaw) == false) {
        println("ttl invalido: " + ttlRaw.trim() + " (use horas positivas, ex: --ttl 24)")
        return 1
    }
    try {
        var services = fetchServices(session.controlUrl, session.token)
        // Emitir credencial para o device errado e pior que recusar: o kfs_
        // daria acesso ao servico de OUTRO dispositivo da conta. Mesmo
        // resolvedor dos comandos de rotate/revoke/rotation.
        var match = resolveServiceName(services, name)
        if (match.ambiguous) {
            println(serviceAmbiguousLine(name.trim(), match.deviceIds))
            return 1
        }
        var trimmed = name.trim()
        var target = ""
        var exposure = ""
        var hostname = ""
        for (var service in services) {
            if (service.name == trimmed) {
                target = service.id
                exposure = service.exposure
                hostname = service.hostname
            }
        }
        if (target.length == 0) {
            printServiceNotFound(services, name)
            return 1
        }
        if (exposureRequiresAuth(exposure) == false) {
            println("aviso: " + name + " esta " + exposure + " — o token so e exigido em AUTHENTICATED")
        }
        var body = mapOf()
        body.put("serviceId", target)
        if (ttlRaw.trim().length > 0) {
            body.put("ttlHours", ttlRaw.trim())
        }
        var raw = requireOk(http.post(session.controlUrl + "/v1/services/token", json.encode(body), jsonHeader(session.token)))
        var token = mapField(json.decode<Map<String, String>>(raw), "token")
        println("Token de acesso (" + name + "):")
        println(token)
        if (ttlRaw.trim().length > 0) {
            println("Expira em " + ttlRaw.trim() + "h — depois disso, 401 ate emitir outro.")
        }
        println("")
        println("Uso:")
        println("  curl -H 'Authorization: Bearer " + token + "' https://" + hostname + "/")
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

// Lista as credenciais kfs_ de UM servico (inventario, sem valores).
// Devolve id curto + emissao (+ expiracao, quando houver) para o operador
// saber o que revogar; o kfs_ em claro so existe no instante da emissao e
// nunca e recuperavel. Expiradas nao aparecem (podadas na validacao).
record ServiceTokenEntry(String serviceId, String id, String createdAt, String? expiresAt)

// Resumo do inventario de kfs_ para `service status`: puro, sem rede nem
// HOME — recebe as entradas ja buscadas e devolve a linha pronta ("" quando
// nao ha credenciais). Conta com e sem expiracao separadas para o operador
// saber que ha prazo a vigiar (`token-list` mostra cada uma). Nunca vaza
// valor de token (as entradas so tem id curto, por desenho da API).
// As perto do fim sao contadas com o MESMO predicado do aviso por entrada
// do `token-list` (`serviceTokenExpiryWarning` — mesma janela do fio), com
// o `now` do chamador: o que o status conta e exatamente o que a lista
// marcara, sem relogio nem janela propios.
String tokenInventoryLine(List<ServiceTokenEntry> entries, String now) {
    if (entries.size == 0) {
        return ""
    }
    var withTtl = 0
    var expiring = 0
    for (var entry in entries) {
        if (entry.expiresAt != null) {
            withTtl = withTtl + 1
            if (serviceTokenExpiryWarning(entry.expiresAt, now).length > 0) {
                expiring = expiring + 1
            }
        }
    }
    var line = "Credenciais: " + intToString(entries.size) + " emitida(s)"
    if (withTtl > 0) {
        line = line + " (" + intToString(withTtl) + " com expiracao — veja: kof cloud service token-list)"
        if (expiring > 0) {
            line = line + "\nAVISO: " + intToString(expiring) + " expira(m) em menos de " + intToString((limitTokenExpiryWarnMs() / 3600000L) as Int) + "h — rotacione: kof cloud service rotate <nome> --ttl <horas>"
        }
    }
    return line
}

// Aviso de expiracao proxima da credencial da CONTA (Fase 19): pura sobre
// os epochs em texto do `/v1/tokens` (nunca o valor — o inventario so tem
// id curto). Sem TTL (`""`/`0`) ou vencida/restante fora da janela = "";
// dentro da janela = linha AVISO com a acao. A mesma janela do fio
// (`kofcloud.limits.tokenExpiryWarnMs`) em fonte unica — fio e CLI nunca
// divergem sobre quem merece o aviso.
String tokenAccountWarningLine(String expiresAt, String now) {
    var at = parseLongSafe(expiresAt, 0L)
    if (at <= 0L) {
        return ""
    }
    var rest = at - parseLongSafe(now, 0L)
    if (rest <= 0L) {
        return ""
    }
    if (rest > limitTokenExpiryWarnMs()) {
        return ""
    }
    return "AVISO: esta credencial expira em menos de " + intToString((limitTokenExpiryWarnMs() / 3600000L) as Int) + "h — rode: kof cloud token rotate --ttl <horas>"
}

// Contador do sinal `expiring` no corpo de /v1/tokens (vetor plano de
// objetos planos, chave e valor literais): -1 quando o corpo nao parece uma
// lista JSON. Pura. O `"false"` nao casa com `"expiring":"true"` porque o
// prefixo inclui as aspas de abertura da chave — `x"expiring":"true"` nao
// ocorre dentro de `"expiring":"false"`. Morava no Doctor.kf; veio para
// ca (import kofcloud.cli.Commands ja o alcanca de la, sem ciclo) quando
// o `status` passou a ler o MESMO sinal.
// Aviso de expiracao proxima no `status`: o MESMO sinal do fio que o
// `token list` (AVISO por entrada), o doctor (camada da credencial) e o
// painel (camada do Diagnostico) ja mostram — o status era o comando de
// rotina que ficava cego, e o operador que so roda `status` descobria a
// perda da sessao nos 401. Pura sobre o corpo de /v1/tokens (busca a
// `countTokenExpiring` abaixo): nunca re-deriva com relogio proprio.
// Conta por entrada como o doctor (o inventario nao diz QUAL entrada e a
// da sessao — sem valor no fio), entao o texto e da conta. "" quando nao ha
// o que avisar (busca falhou = o status ja mostra as outras linhas cair;
// corpo ilegivel = -1; nenhuma na janela = 0): aviso sem sinal seria
// inventado. A janela citada vem do mesmo Limits do fio — fonte unica.
Int countTokenExpiring(String tokensRaw) {
    var trimmed = tokensRaw.trim()
    if (trimmed.startsWith("[") == false) {
        return -1
    }
    var count = 0
    var rest = tokensRaw
    var mark = "\"expiring\":\"true\""
    var at = rest.indexOf(mark)
    while (at >= 0) {
        count = count + 1
        rest = rest.substring(at + mark.length, rest.length)
        at = rest.indexOf(mark)
    }
    return count
}

String statusCredentialWarning(String tokensRaw) {
    var expiring = countTokenExpiring(tokensRaw)
    if (expiring <= 0) {
        return ""
    }
    var hours = intToString((limitTokenExpiryWarnMs() / 3600000L) as Int)
    return "AVISO: " + intToString(expiring) + " credencial(is) da conta expiram em menos de " + hours + "h — rode: kof cloud token rotate --ttl <horas>"
}

// Aviso de expiracao proxima da credencial de SERVICO (kfs_), no mesmo
// padrao do `tokenAccountWarningLine` (kfc_): pura sobre os epochs em
// texto do `/v1/services/tokens` (nunca o valor — o inventario so tem id
// curto). Sem TTL (`""`/`0`) ou vencida/restante fora da janela = "";
// dentro da janela = linha AVISO com a acao. A mesma janela do fio
// (`kofcloud.limits.tokenExpiryWarnMs`) — fio e CLI nunca divergem sobre
// quem merece o aviso.
String serviceTokenExpiryWarning(String expiresAt, String now) {
    var at = parseLongSafe(expiresAt, 0L)
    if (at <= 0L) {
        return ""
    }
    var rest = at - parseLongSafe(now, 0L)
    if (rest <= 0L) {
        return ""
    }
    if (rest > limitTokenExpiryWarnMs()) {
        return ""
    }
    return "  AVISO: expira em menos de " + intToString((limitTokenExpiryWarnMs() / 3600000L) as Int) + "h — rotacione: kof cloud service rotate <nome> --ttl <horas>"
}

Int cmdServiceTokenList(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var name = firstPositional(args)
    if (name.trim().length == 0 || extraPositional(args, 1)) {
        println("uso: kof cloud service token-list <nome>")
        return 1
    }
    try {
        var target = resolveServiceOrReport(session, name)
        if (target.length == 0) {
            return 1
        }
        var body = mapOf()
        body.put("serviceId", target)
        var raw = requireOk(http.post(session.controlUrl + "/v1/services/tokens", json.encode(body), jsonHeader(session.token)))
        var entries = json.decode<List<ServiceTokenEntry>>(raw)
        if (entries.size == 0) {
            println("nenhuma credencial emitida para: " + name)
            return 0
        }
        var now = longToString(time.now())
        for (var entry in entries) {
            var line = entry.id + "  emitida em " + entry.createdAt
            if (entry.expiresAt != null) {
                line = line + "  expira em " + entry.expiresAt
                var warn = serviceTokenExpiryWarning(entry.expiresAt, now)
                if (warn.length > 0) {
                    line = line + "\n" + warn
                }
            }
            println(line)
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

// Revoga UMA credencial kfs_ (ex.: vazou no log, no chat, no repo).
// Aceita o valor completo (kfs_...) OU o id curto do `token-list`
// (quando unico no servico; ambiguo pede o completo com 409 KCF063).
// O valor viaja no corpo HTTPS ate o control plane (nunca em URL/log)
// e so o hash e comparado/guardado.
Int cmdServiceTokenRevoke(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var name = firstPositional(args).trim()
    var token = secondPositional(args).trim()
    if (name.length == 0 || token.length == 0 || extraPositional(args, 2)) {
        println("uso: kof cloud service token-revoke <nome> <kfs_...|id>")
        return 1
    }
    try {
        var services = fetchServices(session.controlUrl, session.token)
        var match = resolveServiceName(services, name)
        if (match.ambiguous) {
            println(serviceAmbiguousLine(name.trim(), match.deviceIds))
            return 1
        }
        var target = match.uniqueId
        if (target.length == 0) {
            printServiceNotFound(services, name)
            return 1
        }
        var body = mapOf()
        body.put("serviceId", target)
        body.put("token", token)
        requireOk(http.post(session.controlUrl + "/v1/services/token/revoke", json.encode(body), jsonHeader(session.token)))
        println("Token revogado para o servico: " + name)
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

// Rotacao assistida (Fase 19 s3): emite uma credencial nova para o servico e
// revoga as anteriores SO depois do TTL (overlap). `--prune` limpa as ja
// expiradas. O token novo aparece uma unica vez — troque onde ele e usado
// antes do prazo acabar.
//
// `rotate --all` (mesmo slice, pendente ate este commit): itera os servicos
// da conta e rotaciona um por um. Falha num servico nao aborta os demais
// (precedente: down --prune poda em lote); o resumo final lista ok/falhas
// e o exit e 1 se alguma falhar. Sem --ttl segue a regra do singular:
// credencial sem expiracao nunca e revogada em silencio.
// Diretorio das credenciais emitidas pelo `rotate --all`. Fonte unica do
// caminho (o help e o aviso derivam, os testes derivam tambem).
String rotateAllDir() {
    return kofcloudHome() + "/service-tokens"
}

// Linha do resumo do `rotate --all` para UM servico. Pura: em arquivo o
// valor em claro aparece uma unica vez (regra do kfs_), na tela so o
// caminho; em falha, o nome e o motivo sem valor nenhum.
String rotateAllLine(String name, String filePath) {
    return name + ": credencial gravada em " + filePath + " (uma vez; mova para o lugar definitivo)"
}

Int rotateAllServices(LocalSession session, List<Service> services, Int ttl, Bool prune) {
    var done = 0
    var failures = listOf<String>()
    for (var service in services) {
        var body = mapOf()
        body.put("serviceId", service.id)
        if (ttl > 0) {
            body.put("ttlHours", intToString(ttl))
        }
        if (prune) {
            body.put("prune", "true")
        }
        try {
            var raw = requireOk(http.post(session.controlUrl + "/v1/services/rotate", json.encode(body), jsonHeader(session.token)))
            var result = json.decode<Map<String, String>>(raw)
            // N credenciais em claro no scrollback e o oposto da regra do
            // kfs_ (o valor existe UMA vez, na emissao). Grava em arquivo
            // (best-effort sem chmod no Kof, L3) e imprime so o caminho —
            // o mesmo que o `service token` recomenda ("copie agora"), sem
            // obrigar o operador a copiar N valores na mao.
            var dir = rotateAllDir()
            Directory(dir).createDirectories()
            var filePath = dir + "/" + service.name + ".kfs"
            if (writeTextTo(filePath, mapField(result, "token") + "\n") == false) {
                failures.add(service.name)
                continue
            }
            println(rotateAllLine(service.name, filePath) + " (revogadas " + mapField(result, "revoked") + ", valendo " + mapField(result, "pending") + ")")
            done = done + 1
        } catch (String e) {
            failures.add(service.name)
        }
    }
    if (services.size == 0) {
        println("nenhum servico para rotacionar")
        return 0
    }
    if (failures.size > 0) {
        printFail("falha em " + intToString(failures.size) + " servico(s)", failures.get(0))
        return 1
    }
    println("rotate --all ok: " + intToString(done) + " servico(s); credenciais em " + rotateAllDir())
    return 0
}

Int cmdServiceRotate(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    // --all dispensa o nome (rotaciona TODOS os servicos da conta); com
    // nome exige exatamente 1 posicional. --all + nome = ambíguo, barra.
    var all = hasFlag(args, "--all")
    var name = firstPositional(args).trim()
    if (all) {
        if (name.length > 0 || extraPositional(args, 1)) {
            println("uso: kof cloud service rotate --all [--ttl <horas>] [--prune]")
            return 1
        }
    } else if (extraPositional(args, 1)) {
        println("uso: kof cloud service rotate <nome> [--ttl <horas>] [--prune]")
        return 1
    }
    var ttlRaw = flagValue(args, "--ttl").trim()
    var ttl = parseIntBounded(ttlRaw, 0, 2147483647)
    if (name.length == 0 && all == false) {
        println("uso: kof cloud service rotate <nome> [--ttl <horas>] [--prune]")
        return 1
    }
    if (ttlRaw.length > 0 && ttl <= 0) {
        println("ttl invalido: use horas inteiras > 0")
        return 1
    }
    if (flagMissingValue(args, "--ttl") || flagDuplicated(args, "--ttl") || flagDuplicated(args, "--all") || flagDuplicated(args, "--prune")) {
        println("uso: kof cloud service rotate [--all] <nome> [--ttl <horas>] [--prune]")
        return 1
    }
    var prune = hasFlag(args, "--prune")
    try {
        var services = fetchServices(session.controlUrl, session.token)
        if (all) {
            return rotateAllServices(session, services, ttl, prune)
        }
        var match = resolveServiceName(services, name)
        if (match.ambiguous) {
            println(serviceAmbiguousLine(name.trim(), match.deviceIds))
            return 1
        }
        var target = match.uniqueId
        if (target.length == 0) {
            printServiceNotFound(services, name)
            return 1
        }
        var body = mapOf()
        body.put("serviceId", target)
        if (ttl > 0) {
            body.put("ttlHours", intToString(ttl))
        }
        if (prune) {
            body.put("prune", "true")
        }
        var raw = requireOk(http.post(session.controlUrl + "/v1/services/rotate", json.encode(body), jsonHeader(session.token)))
        var result = json.decode<Map<String, String>>(raw)
        println("Credencial nova (" + name + "):")
        println(mapField(result, "token"))
        println("")
        println("Revogadas por expiracao: " + mapField(result, "revoked"))
        println("Ainda valendo (inclui a nova): " + mapField(result, "pending"))
        if (ttl > 0) {
            println("")
            println("Troque onde usa o token em ate " + intToString(ttl) + "h; depois rode:")
            println("  kof cloud service rotation " + name + "   (para conferir)")
            println("  kof cloud service rotate " + name + " --ttl " + intToString(ttl) + "  (proxima rotacao)")
        } else {
            println("")
            println("Sem --ttl a credencial nao expira: rotacione com --ttl para revogar as antigas.")
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

// ---- credenciais da conta (kfc_) ----
//
// O kfc_ autoriza tudo na conta e ate aqui nao tinha ciclo de vida: `logout`
// apagava so o arquivo local e o valor seguia valido no servidor para sempre.
// Estes comandos espelham o desenho do kfs_ (inventario sem valores, revogacao
// por id curto, rotacao com overlap).

record AccountTokenEntry(String id, String createdAt, String? expiresAt)

Int cmdTokenList(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    if (extraPositional(args, 0)) {
        println("uso: kof cloud token list")
        return 1
    }
    try {
        var raw = requireOk(http.get(session.controlUrl + "/v1/tokens", authHeader(session.token)))
        var entries = json.decode<List<AccountTokenEntry>>(raw)
        if (entries.size == 0) {
            println("nenhuma credencial valida nesta conta")
            return 0
        }
        for (var entry in entries) {
            var line = entry.id + "  emitida em " + entry.createdAt
            var expiredAt = "0"
            if (entry.expiresAt != null) {
                line = line + "  expira em " + entry.expiresAt
                expiredAt = entry.expiresAt
            } else {
                line = line + "  sem expiracao"
            }
            println(line)
            var warn = tokenAccountWarningLine(expiredAt, longToString(time.now()))
            if (warn.length > 0) {
                println(warn)
            }
        }
        println("")
        println("Revogar: kof cloud token revoke <id|kfc_...>")
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

Int cmdTokenRevoke(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var target = firstPositional(args).trim()
    if (target.length == 0 || extraPositional(args, 1)) {
        println("uso: kof cloud token revoke <id|kfc_...>")
        return 1
    }
    try {
        var body = mapOf()
        body.put("token", target)
        requireOk(http.post(session.controlUrl + "/v1/tokens/revoke", json.encode(body), jsonHeader(session.token)))
        println("Credencial revogada.")
        if (target == session.token) {
            println("Era a credencial desta sessao — rode `kof cloud login` de novo.")
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

// Rotaciona a credencial da conta com overlap: a nova e gravada na sessao
// local na hora (senao o operador se trancaria fora), as antigas so caem
// depois do TTL. Sem --ttl nada e revogado em silencio.
Int cmdTokenRotate(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    if (extraPositional(args, 0) || flagMissingValue(args, "--ttl") || flagDuplicated(args, "--ttl")) {
        println("uso: kof cloud token rotate [--ttl <horas>]")
        return 1
    }
    var ttlRaw = flagValue(args, "--ttl").trim()
    if (validTtlHours(ttlRaw) == false) {
        println("ttl invalido: " + ttlRaw + " (use horas positivas, ex: --ttl 24)")
        return 1
    }
    var ttl = parseIntBounded(ttlRaw, 0, 2147483647)
    try {
        var body = mapOf()
        if (ttl > 0) {
            body.put("ttlHours", intToString(ttl))
        }
        var raw = requireOk(http.post(session.controlUrl + "/v1/tokens/rotate", json.encode(body), jsonHeader(session.token)))
        var result = json.decode<Map<String, String>>(raw)
        var fresh = mapField(result, "token")
        // Grava a nova credencial ANTES de qualquer outra coisa: a antiga
        // pode expirar a qualquer momento e o operador nao pode ficar sem.
        saveSession(LocalSession(session.accountId, session.handle, fresh, session.controlUrl))
        println("Credencial nova (gravada nesta sessao):")
        println(fresh)
        println("")
        println("Revogadas por expiracao: " + mapField(result, "revoked"))
        println("Ainda valendo (inclui a nova): " + mapField(result, "pending"))
        if (ttl > 0) {
            println("")
            println("Troque onde usa o kfc_ em ate " + intToString(ttl) + "h; depois rode:")
            println("  kof cloud token rotation   (para conferir)")
        } else {
            println("")
            println("Sem --ttl a credencial nao expira: rotacione com --ttl para revogar as antigas.")
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

// Remove credenciais antigas: cada `login` emite um token novo sem revogar o
// anterior, entao o inventario cresce a cada entrada. `token prune` mantem a
// da sessao atual e revoga o resto — a acao recomendada pelo `token rotation`.
Int cmdTokenPrune(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    if (extraPositional(args, 0)) {
        println("uso: kof cloud token prune")
        return 1
    }
    try {
        var raw = requireOk(http.post(session.controlUrl + "/v1/tokens/prune", "{}", jsonHeader(session.token)))
        // Contagem escrita pelo servidor (control plane); aqui so decide entre
        // "nada" e "quantas". parseIntBounded com teto Int: se o JSON vier
        // adulterado, falha para 0 = "nada a remover" (nunca vira numero
        // absurdo nem negativo).
        var removed = parseIntBounded(mapField(json.decode<Map<String, String>>(raw), "revoked"), 0, 2147483647)
        if (removed == 0) {
            println("Nada a remover: so a credencial desta sessao vale.")
            return 0
        }
        println("Credenciais revogadas: " + intToString(removed))
        println("A credencial desta sessao continua valida.")
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

Int cmdTokenRotation(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    if (extraPositional(args, 0)) {
        println("uso: kof cloud token rotation")
        return 1
    }
    try {
        var raw = requireOk(http.post(session.controlUrl + "/v1/tokens/rotation", "{}", jsonHeader(session.token)))
        var pending = parseIntBounded(mapField(json.decode<Map<String, String>>(raw), "pending"), 0, 2147483647)
        println("Credenciais validas nesta conta: " + intToString(pending))
        if (pending <= 1) {
            println("Rotacao concluida: so a credencial atual vale.")
        } else {
            println("Rotacao em andamento: aguarde o TTL das antigas (ou revogue com `token revoke`).")
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

// Higiene de credenciais (Fase 19 s2): servicos da conta com kfs_ validos
// SEM expiracao. Leitura; o passo recomendado e `service rotate --ttl`.
// Uso da conta (F18 s4 — billing externo): o que o Edge roteou para os
// servicos deste dono, em requests e bytes. Leitura por default; `--export`
// fecha a janela (le e zera no servidor — POST /v1/usage/export, com rastro
// de auditoria), o ciclo que o consumidor de billing espera.
Int cmdUsage(List<String> args) {
    if (extraPositional(args, 0) || flagDuplicated(args, "--export")) {
        println("uso: kof cloud usage [--export]")
        return 1
    }
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    try {
        var raw = ""
        if (hasFlag(args, "--export")) {
            if (flagMissingValue(args, "--x") == false) {
            }
            raw = requireOk(http.post(session.controlUrl + "/v1/usage/export", "{}", jsonHeader(session.token)))
        } else {
            raw = requireOk(http.get(session.controlUrl + "/v1/usage", authHeader(session.token)))
        }
        var result = json.decode<Map<String, String>>(raw)
        if (hasFlag(args, "--export")) {
            println("Janela de uso fechada (o contador zera; o proximo export cobre a janela seguinte):")
        } else {
            println("Uso da conta (roteado pelo Edge):")
        }
        println("  requests: " + mapField(result, "requests"))
        println("  entrada:  " + mapField(result, "bytesIn") + " bytes")
        println("  saida:    " + mapField(result, "bytesOut") + " bytes")
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

// Linhas de um export Prometheus que casam com o filtro (substring na
// linha, caixa exata — nomes de metrica sao identificadores). Pura, sem
// rede: o cmdMetrics le o fio e formata aqui. Filtro vazio = todas; linhas
// vazias saem (o export termina com newline).
List<String> metricsLines(String text, String filter) {
    var out = listOf<String>()
    for (var line in text.split("\n")) {
        if (line.length == 0) {
            continue
        }
        if (filter.length > 0 && line.indexOf(filter) < 0) {
            continue
        }
        out.add(line)
    }
    return out
}

// Contagem de um contador Prometheus pelo prefixo exato. Devolve -1 quando
// a metrica nao aparece na exposicao. Puro: o percentil usa a MESMA leitura
// para todas as faixas (uma passada por linha por faixa; a exposicao e
// pequena e a CLI roda no terminal).
Int expositionCounter(String exposition, String namePrefix) {
    for (var line in exposition.split("\n")) {
        if (line.startsWith("#")) {
            continue
        }
        if (line.startsWith(namePrefix + " ")) {
            return parseIntBounded(line.substring(namePrefix.length + 1).trim(), -1, 2147483647)
        }
    }
    return -1
}

// Contagens por faixa de latencia do EDGE na exposicao (ordem de
// `latencyBucketLimitsMs()` mais o excedente no fim). Faixa zerada nao e
// exportada pela stdlib (medido: `_le_50 2` e `_le_500 1`, sem as do meio),
// entao ausente vira 0 — nunca "faltando". Puro.
List<Int> latencyBucketCounts(String exposition) {
    var out = listOf<Int>()
    var limits = latencyBucketLimitsMs()
    for (var limit in limits) {
        var n = expositionCounter(exposition, metricRequestLatencyMs() + "_le_" + intToString(limit))
        if (n < 0) {
            n = 0
        }
        out.add(n)
    }
    var over = expositionCounter(exposition, metricRequestLatencyMs() + "_gt_" + intToString(limits.get(limits.size - 1)))
    if (over < 0) {
        over = 0
    }
    out.add(over)
    return out
}

// Bloco de percentis (F14 s1): p50/p95/p99 nearest-rank sobre as faixas do
// Edge. Sem cardinalidade por cliente — e o histograma AGREGADO que ja
// existe; o valor e um TETO de faixa, dito como tal.
String latencyPercentileLines(String exposition) {
    var counts = latencyBucketCounts(exposition)
    var limits = latencyBucketLimitsMs()
    return "  latencia p50: " + percentileFromBuckets(limits, counts, 50) + "\n" +
        "  latencia p95: " + percentileFromBuckets(limits, counts, 95) + "\n" +
        "  latencia p99: " + percentileFromBuckets(limits, counts, 99)
}

// `kof cloud metrics [--grep <texto>] [--control <url>]`: le o export
// Prometheus do control plane (`GET /v1/metrics`, SEM auth — so agregados,
// mesma regra do /v1/health) e imprime. Sem sessao usa `--control` ou o
// default (metricas nao sao dado de conta: qualquer um que alcance o
// control as le, como no fio). Antes o operador precisava de `curl` para
// ver o que a plataforma ja exporta.
Int cmdMetrics(List<String> args) {
    if (extraPositional(args, 0) || flagMissingValue(args, "--grep") || flagDuplicated(args, "--grep") || flagMissingValue(args, "--control") || flagDuplicated(args, "--control") || flagDuplicated(args, "--percentiles")) {
        println("uso: kof cloud metrics [--grep <texto>] [--percentiles] [--control <url>]")
        return 1
    }
    var control = flagValue(args, "--control").trim()
    if (control.length == 0) {
        var session = loadSession()
        if (session != null) {
            control = session.controlUrl
        } else {
            control = defaultControlUrl()
        }
    }
    var filter = flagValue(args, "--grep").trim()
    try {
        var raw = requireOk(http.get(control + "/v1/metrics", "Accept: text/plain"))
        if (hasFlag(args, "--percentiles")) {
            // Resumo agregado do histograma (p50/p95/p99). O prometheus cru
            // continua disponivel sem a flag.
            println("latencia das requisicoes publicas do Edge (teto de faixa, agregado):")
            for (var pl in latencyPercentileLines(raw).split("\n")) {
                if (pl.length > 0) {
                    println(pl)
                }
            }
            return 0
        }
        var lines = metricsLines(raw, filter)
        if (lines.size == 0) {
            if (filter.length > 0) {
                println("nenhuma metrica casa com: " + filter)
            } else {
                println("export vazio (nenhuma metrica emitida ainda)")
            }
            return 0
        }
        for (var line in lines) {
            println(line)
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

Int cmdServiceTokens(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    if (extraPositional(args, 0)) {
        println("uso: kof cloud service tokens")
        return 1
    }
    try {
        var raw = requireOk(http.post(session.controlUrl + "/v1/services/token-hygiene", "{}", jsonHeader(session.token)))
        var result = json.decode<Map<String, String>>(raw)
        var services = json.decode<List<String>>(mapField(result, "services"))
        var count = parseIntBounded(mapField(result, "count"), 0, 2147483647)
        if (count == 0) {
            println("Higiene ok: nenhuma credencial valida sem expiracao.")
            return 0
        }
        println("Credenciais validas SEM expiracao: " + intToString(count))
        for (var name in services) {
            println("  servico: " + name)
        }
        println("")
        println("Rotacione com prazo: kof cloud service rotate <nome> --ttl 24")
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

Int cmdServiceRotation(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var name = firstPositional(args).trim()
    if (name.length == 0 || extraPositional(args, 1)) {
        println("uso: kof cloud service rotation <nome>")
        return 1
    }
    try {
        var services = fetchServices(session.controlUrl, session.token)
        var match = resolveServiceName(services, name)
        if (match.ambiguous) {
            println(serviceAmbiguousLine(name.trim(), match.deviceIds))
            return 1
        }
        var target = match.uniqueId
        if (target.length == 0) {
            printServiceNotFound(services, name)
            return 1
        }
        var body = mapOf()
        body.put("serviceId", target)
        var raw = requireOk(http.post(session.controlUrl + "/v1/services/rotation", json.encode(body), jsonHeader(session.token)))
        var result = json.decode<Map<String, String>>(raw)
        var pending = parseIntBounded(mapField(result, "pending"), 0, 2147483647)
        println("Credenciais validas (" + name + "): " + intToString(pending))
        if (pending <= 1) {
            println("Rotacao concluida: so a credencial atual vale.")
        } else {
            println("Rotacao em andamento: aguarde o TTL das antigas (ou revogue com `service token-revoke`).")
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

