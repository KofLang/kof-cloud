// Implementacao dos subcomandos. Cada um devolve o exit code.

// Incidente como o CLI le (GET /v1/incidents).
record IncidentEntry(String id, String kind, String severity, String accountId, String summary, String openedAt, String resolvedAt)

record DomainEntry(String hostname, String kind, String service, String status)

// Mensagens "nao encontrado" da CLI (fonte unica): 7 pontos de servico e 4
// de dispositivo imprimiam o mesmo literal. Helpers puros para travar o
// formato em teste (precedente: domainListLine/tokenInventoryLine).
String serviceNotFoundLine(String name) {
    return "servico nao encontrado: " + name
}

String deviceNotFoundLine(String name) {
    return "dispositivo nao encontrado: " + name
}

// Guarda de sessao da CLI (fonte unica): comandos que exigem login repetiam
// `println("nao logado")` bare em ~20 pontos enquanto outros ja davam a dica
// de login — o operador sem sessao recebia mensagens diferentes pelo mesmo
// estado. Todos os pontos agora usam a forma com dica (precedente:
// serviceNotFoundLine/deviceNotFoundLine).
String notLoggedInLine() {
    return "nao logado — rode: kof cloud login <handle> --password <senha>"
}

// Linhas de `uso:` repetidas em dois guardas do mesmo comando (fonte unica):
// cada par abaixo aparecia 2x — uma para flag invalida (missing/duplicada)
// e outra para args invalidos. Helpers puros para travar o formato em teste
// (precedente: serviceNotFoundLine/deviceNotFoundLine/notLoggedInLine).
// O `uso:` do dispatch (kof cloud <grupo> sem subcomando) tambem e fonte
// unica aqui: ele precisa listar TODOS os subs que o runXxx despacha —
// antes `service` omitia tokens|rotate|rotation e `token` omitia prune,
// e o operador descobria o subcomando so no help.
String usoServiceTokenLine() {
    return "uso: kof cloud service token <nome> [--ttl <horas>]"
}

String usoServiceDispatchLine() {
    return "uso: kof cloud service list|status|suspend|unsuspend|token <nome>|token-list <nome>|token-revoke <nome> <kfs_...|id>|tokens|rotate|rotation"
}

String usoTokenDispatchLine() {
    return "uso: kof cloud token list|revoke|rotate|rotation|prune"
}

String usoDeviceDispatchLine() {
    return "uso: kof cloud device list|revoke|suspend|unsuspend <nome|id>"
}

String usoDomainDispatchLine() {
    return "uso: kof cloud domain list|add|verify|remove"
}

String usoDaemonDispatchLine() {
    return "uso: kof cloud daemon install|status|uninstall"
}

String usoServeLine() {
    return "uso: kof cloud serve [--control-port N] [--tunnel-port N] [--http-port N] [--state <caminho>] [--backup-dir <dir>] [--waf detectar|enforce] [--panel] [--tls-cert <pem> --tls-key <pem> | --tls-cert-cmd <cmd> --tls-key-cmd <cmd>] [--tunnel-secret-file <arq> | --tunnel-secret-cmd <cmd>] (portas 1-65535)"
}

// Modo WAF do `serve --waf`: ausente, vazio ou so-espacos = detectar
// (conta e segue); "enforce" liga o 403; qualquer outro valor e erro
// (fail-fast, sem default mentiroso). Pura, sem rede nem HOME — o chamador
// aplica no EdgeState. Precedente: resolveStatePath (mesma regra de
// ausente/vazio/so-espacos = default, valor aparado).
String resolveWafMode(String flagRaw) {
    var trimmed = flagRaw.trim()
    if (trimmed.length == 0) {
        return "detectar"
    }
    if (trimmed == "detectar" || trimmed == "enforce") {
        return trimmed
    }
    return "?"
}

// Recusa do `serve` com estado ilegivel (Fase 16 s3). Pura para o teste
// julgar o texto sem subir processo; o arquivo e so CITADO (nunca tocado) e
// nao ha dado de conta — a perda e de plataforma.
String serveCorruptRefusal(String statePath) {
    return "recusado: o arquivo de estado existe mas nao decodifica como estado do control plane\n" +
        "  arquivo: " + statePath + "\n" +
        "  o control plane NAO subiu e o arquivo NAO foi tocado.\n" +
        "  faca backup e restaure, ou use outro --state: kof cloud state-backup --file <estado.json>"
}

String usoLogsLine() {
    return "uso: kof cloud logs [--tail <linhas>] [--runtime|--edge]"
}

String usoDomainAddLine() {
    return "uso: kof cloud domain add <hostname> --service <nome> [--dns-webhook <url> | --dns-cmd <cmd>] [--dry-run]"
}

// Fase 18 slice 1 — webhook DNS generico. A plataforma fala o protocolo do
// mercado (webhook HTTP), nao o contrario: o operador hospeda um receptor
// que cria o CNAME no provedor que quiser (sem SDK proprietario). Payload
// com fonte unica; o token NUNCA vai no corpo, na saida ou em log — so no
// header, e vem do ambiente do operador (Kof nao enumera env).
String dnsWebhookPayload(String hostname, String service, String target) {
    var body = mapOf()
    body.put("action", "create_cname")
    body.put("hostname", hostname)
    body.put("service", service)
    body.put("target", target)
    return json.encode(body)
}

// Headers do POST do webhook DNS. Sem token no ambiente segue SEM
// Authorization (receptor local nao precisa); fonte unica para o teste
// travar o formato sem rede e sem o valor do token no teste.
String dnsWebhookHeaders(String token) {
    var headers = "Content-Type: application/json"
    var clean = token.trim()
    if (clean.length > 0) {
        headers = headers + "\nAuthorization: Bearer " + clean
    }
    return headers
}

// O Kof nao enumera env e `config.env` devolve null para nome ausente —
// `.` direto NPE (medido: `--dns-webhook` sem o token no ambiente quebrava
// a CLI DEPOIS de registrar o dominio). Fonte unica da leitura tolerante.
String envOrNull(String name) {
    var value = config.env(name)
    if (value == null) {
        return ""
    }
    return value
}

// POST do webhook DNS com o mesmo prazo do webhook de incidentes (o comando
// roda inline e um receptor que aceita e nao responde nao pode pendurar a
// CLI). Falha nao propaga: o dominio ja esta registrado (PENDING) e o CNAME
// manual continua possivel. Devolve "" quando ok.
String dnsWebhookDeliver(String url, String payload, String headers) {
    try {
        http.timeout(limitWebhookTimeoutSec())
        http.post(url, payload, headers)
        return ""
    } catch (String e) {
        return e
    }
}

// Previa do `--dry-run` (regra da Fase 18: todo conector tem modo dry-run —
// mostra o que faria, sem registrar dominio e sem tocar a rede). Recebe os
// MESMOS headers que seriam enviados e mascara o valor do token: com token
// no ambiente so a PRESENCA do header sai; sem token, a ausencia e nomeada
// para o operador saber que o receptor pode exigir credencial. Puro: o teste
// trava o texto inteiro, inclusive que o valor nunca aparece.
String dnsWebhookPreview(String url, String payload, String headers, Bool tokenPresent) {
    var shown = headers
    if (tokenPresent) {
        var marker = "Authorization: Bearer "
        var idx = shown.indexOf(marker)
        if (idx >= 0) {
            shown = shown.substring(0, idx + marker.length) + "*** (KOF_KOFCLOUD_DNS_WEBHOOK_TOKEN)"
        }
    }
    var out = "dry-run: nada foi enviado e o dominio nao foi registrado"
    if (url.length > 0) {
        out = out + "\n  POST " + url
        out = out + "\n  corpo: " + payload
        out = out + "\n  headers: " + shown
        if (tokenPresent == false) {
            out = out + "\n  (sem Authorization: KOF_KOFCLOUD_DNS_WEBHOOK_TOKEN ausente)"
        }
    } else {
        out = out + "\n  (sem --dns-webhook: crie o CNAME manualmente e rode domain verify)"
    }
    return out
}

// F18 s1 — provedor DNS por COMANDO (Cloudflare, Route53 e qualquer outro
// com CLI): o operador passa o comando que cria o CNAME e a plataforma roda
// via `sh -c` (protocolo aberto do shell, sem SDK e sem lock-in — a mesma
// regra do slice 5 dos segredos). O valor de credencial (token da Cloudflare
// etc.) fica no ambiente do operador; NUNCA aparece no comando impresso, no
// dry-run ou em log. O comando pode usar {hostname}, {target} e {service}:
// a plataforma substitui antes de executar (o operador escreve o comando
// declarativamente). Puro: o exec vive em dnsCmdRun.
String dnsCmdError(String cmdText, String webhookUrl) {
    if (cmdText.trim().length == 0) {
        return ""
    }
    if (webhookUrl.trim().length > 0) {
        return "informe UMA fonte de DNS (--dns-webhook ou --dns-cmd), nao as duas"
    }
    return ""
}

// Alvo do CNAME a partir da instrucao devolvida pelo control plane
// ("CNAME <hostname> -> <target>"). O `--dns-cmd` e o `--dns-webhook`
// precisam do hostname do SERVICO; antes a CLI mandava
// `webhookUrlHost(controlUrl)` — o host do control plane
// (`api.kofcloud.io`), que nao e para onde o CNAME aponta, e o provedor
// criava um registro errado (o `verify` nunca sairia de PENDING). A
// instrucao JA carrega o alvo certo (`customTargetFor` no control), entao
// ela e a fonte — sem inferir hostname localmente. Puro (testavel sem
// rede); instrucao vazia/sem "->" devolve "" (nunca inventa alvo).
String dnsTargetFromInstruction(String instruction) {
    var at = instruction.indexOf("->")
    if (at < 0) {
        return ""
    }
    return instruction.substring(at + 2).trim()
}

// Substitui os placeholders {hostname}/{target}/{service}. Puro (testavel
// sem executar nada). Substituicao textual sequencial (sem regex — o
// `String.split` do Kof trata o argumento como regex).
String dnsCmdExpand(String cmdText, String hostname, String service, String target) {
    var out = cmdText
    out = out.replace("{hostname}", hostname)
    out = out.replace("{target}", target)
    out = out.replace("{service}", service)
    return out
}

// Previa do `--dry-run` do comando DNS: mostra o comando EXPANDIDO e o
// rotulo "a linha do comando NAO e ecoada inteira" nao — o comando e o que
// o operador digitou (ele sabe); credencial deve estar no ambiente, nao no
// comando. Puro.
String dnsCmdPreview(String expanded) {
    return "dry-run: nada foi executado e o dominio nao foi registrado\n  comando: " + expanded
}

// Executa o comando do provedor DNS. Falha (exit != 0 ou excecao) devolve a
// mensagem para o AVISO (o dominio ja ficou PENDING; o caminho manual segue
// possivel), nunca aborta. O stdout e descartado (pode conter dado do
// provedor); so o exit code decide. "" = ok.
String dnsCmdRun(String expanded) {
    try {
        var result = process.run("sh", "-c", expanded)
        if (result.exitCode != 0) {
            return "comando do provedor falhou (exit " + intToString(result.exitCode) + ")"
        }
        return ""
    } catch (String e) {
        return "comando do provedor nao executou (" + e + ")"
    }
}

String usoDomainVerifyLine() {
    return "uso: kof cloud domain verify <hostname> [--tls-cert <pem>]"
}

// Uma linha do `domain list`: customs mostram PENDING/VERIFIED (o operador
// precisa saber se falta o DNS); wildcard/service nao tem ciclo proprio.
String domainListLine(DomainEntry domain) {
    var line = domain.kind + "  " + domain.hostname
    if (domain.status.length > 0) {
        line = line + "  " + domain.status
    }
    return line
}

record DomainStatus(String hostname, String status, String instruction, String verifiedAt)

// Customs vinculados a UM servico (para o `service status`): puro, sem rede
// nem HOME — recebe a lista do GET /v1/domains e o nome do servico, devolve
// so os customs daquele servico (precedente: tokenInventoryLine). Lista
// vazia quando nada aponta para ele (servico novo, sem dominio proprio).
// Dominios proprios cujo registro [CNAME] APONTA para um dos servicos desta
// maquina. O `status` listava os servicos sem dizer quais hostnames externos
// levam a eles: o operador que mexeu no DNS de `api.example.com` sabia o
// hostname mas nao QUAL servico e onde ele roda (e vice-versa). Pura: casa
// o alvo do registro (`service`) com os nomes publicados localmente, um por
// linha; custom sem servico (ou com servico de outra maquina) fica fora.
List<DomainEntry> domainsPointingToServices(List<DomainEntry> domains, List<Service> services) {
    var out = listOf<DomainEntry>()
    for (var domain in domains) {
        if (domain.kind != "custom" || domain.service.length == 0) {
            continue
        }
        for (var service in services) {
            if (service.name == domain.service) {
                out.add(domain)
            }
        }
    }
    return out
}

// Linha do `status` para um dominio proprio apontando para a maquina, com
// o nome do servico alvo na frente (o `domainListLine` sozinho nao diz
// para onde o CNAME leva). "" quando o servico nao esta na lista.
String statusDomainLine(DomainEntry domain, List<Service> services) {
    var serviceName = domain.service
    for (var service in services) {
        if (service.name == domain.service) {
            serviceName = service.name
        }
    }
    return "  " + serviceName + " <- " + domainListLine(domain)
}

List<DomainEntry> customDomainsFor(List<DomainEntry> domains, String serviceName) {
    var out = listOf<DomainEntry>()
    for (var domain in domains) {
        if (domain.kind == "custom" && domain.service == serviceName) {
            out.add(domain)
        }
    }
    return out
}

// Falha com dica humana (padrao kof-share `errText`): a primeira linha mantem
// o codigo estavel da plataforma; a `Hint:` orienta o proximo passo sem
// revelar segredos ou recursos alheios.
void printFail(String context, String raw) {
    if (context.length > 0) {
        println(context + ": " + raw)
    } else {
        println(raw)
    }
    var hint = errHint(raw)
    if (hint.length > 0) {
        println("Hint: " + hint)
    }
}

// Todas as ocorrencias de uma flag repetivel (--allow-method GET --allow-method POST).
List<String> flagValues(List<String> args, String flag) {
    var out = listOf<String>()
    var i = 0
    while (i < args.size) {
        if (args.get(i) == flag && i + 1 < args.size) {
            out.add(args.get(i + 1))
            i = i + 1
        }
        i = i + 1
    }
    return out
}

// Junta valores repetidos em CSV, aparando e recusando item vazio. "" quando
// algum item e vazio (o chamador reporta erro e nao publica).
String repeatedCsv(List<String> values) {
    var out = ""
    for (var value in values) {
        var item = value.trim()
        if (item.length == 0) {
            return ""
        }
        if (out.length == 0) {
            out = item
        } else {
            out = out + "," + item
        }
    }
    return out
}

String flagValue(List<String> args, String flag) {
    var i = 0
    while (i < args.size) {
        if (args.get(i) == flag && i + 1 < args.size) {
            return args.get(i + 1)
        }
        i = i + 1
    }
    return ""
}

Bool hasFlag(List<String> args, String flag) {
    for (var arg in args) {
        if (arg == flag) {
            return true
        }
    }
    return false
}

// Flag presente mas sem valor (ex.: `--ttl` no fim, ou seguido de outra
// flag). `flagValue` devolveria "" — indistinguivel de "flag ausente" —
// e o chamador aplicaria o default em silencio, mentindo sobre a intencao
// do operador. Devolve true so quando a flag esta la E o proximo token
// nao existe ou tambem e flag.
Bool flagMissingValue(List<String> args, String flag) {
    var i = 0
    while (i < args.size) {
        if (args.get(i) == flag) {
            if (i + 1 >= args.size) {
                return true
            }
            if (args.get(i + 1).startsWith("--")) {
                return true
            }
            return false
        }
        i = i + 1
    }
    return false
}

// Flag repetida (`--port 80 --port 8080`): `flagValue` devolveria a
// primeira em silencio, ignorando a segunda — ambiguidade que vira
// surpresa (o operador acha que vale a ultima). Fail-fast: qualquer
// duplicata e erro antes de qualquer efeito.
Bool flagDuplicated(List<String> args, String flag) {
    var seen = false
    for (var arg in args) {
        if (arg == flag) {
            if (seen) {
                return true
            }
            seen = true
        }
    }
    return false
}

// Flags que CONSOMEM o token seguinte (o valor). Fonte unica: `positionalArgs`
// usa esta lista, e o teste trava que toda flag lida com `flagValue` aparece
// aqui. Sem isso o valor de uma flag desconhecida contava como posicional —
// `incidents --resolve <id>` e `webhook set <url> --secret <s>` barrassem
// SEMPRE com o erro de uso (medido), e a flag nunca funcionava.
List<String> valueFlags() {
    return listOf(
        "--port", "--address", "--exposure", "--device", "--ttl", "--tail",
        "--control", "--control-port", "--tunnel-port", "--http-port",
        "--state", "--backup-dir", "--waf", "--tls-cert", "--tls-key", "--service", "--file",
        "--password", "--from", "--to", "--resolve", "--secret",
        "--allow-method", "--allow-path", "--action", "--dns-webhook", "--max-body",
        "--tunnel-secret-file", "--tunnel-secret-cmd", "--tls-cert-cmd", "--tls-key-cmd",
        "--dns-cmd",
        "--grep"
    )
}

// Argumentos posicionais (o que sobra fora de flags e do valor que cada uma
// consome). Fonte unica dos tres leitores: `firstPositional`, `secondPositional`
// e `extraPositional` delegam aqui. Antes, os extratores pegavam o primeiro/
// segundo token sem `--` SEM pular o valor da flag — com a flag antes do
// argumento, o VALOR virava o posicional (medido): `publish --port 8080 site`
// publicava um servico chamado "8080"; `login --password segredo mel` criava
// conta com handle "segredo" (a senha virava hostname publico!);
// `webhook set --secret s https://hook` configurava URL "s";
// `service rotate --ttl 24 --all` barrava com posicional fantasma "24".
List<String> positionalArgs(List<String> args) {
    var out = listOf<String>()
    var known = valueFlags()
    var i = 0
    while (i < args.size) {
        var arg = args.get(i)
        if (known.contains(arg)) {
            i = i + 2
            continue
        }
        if (arg.startsWith("--") == false) {
            out.add(arg)
        }
        i = i + 1
    }
    return out
}

String firstPositional(List<String> args) {
    var pos = positionalArgs(args)
    if (pos.size == 0) {
        return ""
    }
    return pos.get(0)
}

// Segundo argumento posicional (o primeiro e capturado por firstPositional).
String secondPositional(List<String> args) {
    var pos = positionalArgs(args)
    if (pos.size < 2) {
        return ""
    }
    return pos.get(1)
}

// Posicionais alem do esperado (`service token-revoke site kfs_x lixo`):
// ler os N primeiros em silencio e descartar o resto e typo que vira acao
// errada sem aviso. Devolve true quando ha mais posicionais que `max`.
// Puro, sem rede nem HOME. Mesma fonte (`positionalArgs`) que os extratores:
// o que eles leem e exatamente o que aqui conta.
Bool extraPositional(List<String> args, Int max) {
    return positionalArgs(args).size > max
}

// ---- login / logout ----

// Entradas do login aparadas (handle/--control/--device; senha intacta de
// proposito — credencial, espacos podem ser intencionais). Pura, sem rede
// nem HOME: o default do control/device vive no chamador (control le de
// config, device cai em "default"), aqui so normaliza. O handle e rotulo
// DNS (`validLabel`): " mel " nunca validaria na API (400 KCF001); o
// --device com padding registraria nome sujo que depois nao resolve; e
// --device so-espacos escapava do default. A senha nunca e aparada.
record LoginInputs(String handle, String control, String device)

LoginInputs resolveLoginInputs(String handleRaw, String controlRaw, String deviceRaw) {
    return LoginInputs(handleRaw.trim(), controlRaw.trim(), deviceRaw.trim())
}

Int cmdLogin(List<String> args) {
    var handle = firstPositional(args)
    var password = flagValue(args, "--password")
    var control = flagValue(args, "--control")
    if (control.length == 0) {
        control = defaultControlUrl()
    }
    var deviceName = flagValue(args, "--device")
    if (deviceName.length == 0) {
        deviceName = "default"
    }
    var inputs = resolveLoginInputs(handle, control, deviceName)
    handle = inputs.handle
    control = inputs.control
    deviceName = inputs.device
    if (deviceName.length == 0) {
        deviceName = "default"
    }
    if (handle.length == 0 || password.length == 0 || extraPositional(args, 1) || flagMissingValue(args, "--password") || flagMissingValue(args, "--control") || flagMissingValue(args, "--device") || flagDuplicated(args, "--password") || flagDuplicated(args, "--control") || flagDuplicated(args, "--device")) {
        println("uso: kof cloud login <handle> --password <senha> [--control <url>] [--device <nome>]")
        return 1
    }

    var token = ""
    try {
        token = loginOrCreate(control, handle, password)
    } catch (String e) {
        printFail("falha no login", e)
        return 1
    }

    var pair = generateKeyPair()
    var deviceId = ""
    try {
        deviceId = registerDevice(control, token, deviceName, pair.publicKey)
    } catch (String e) {
        printFail("falha ao registrar dispositivo", e)
        return 1
    }

    saveSession(LocalSession("", handle, token, control))
    saveIdentity(LocalIdentity(deviceId, "", handle, deviceName, pair.privateKey, pair.publicKey))
    println("Logado como " + handle)
    println("Dispositivo: " + deviceName + " (" + deviceId + ")")
    println("Control plane: " + control)
    return 0
}

// Cadastro implicito: tenta entrar; se o login falhar, cria a conta.
// O caminho de criacao so e honesto quando a conta NAO existe — se ela ja
// existe, o login falhou porque a senha esta errada, e devolver o KCF002 do
// cadastro dizia "identificador em uso" para quem so digitou a senha errada.
// Pura: mapeia a falha do cadastro para o erro certo, sem tocar a rede.
String createFailureMessage(String createError) {
    if (createError.indexOf("KCF002") >= 0) {
        return errInvalidCredentials()
    }
    return createError
}

// O teto de tentativas de login (KCF134) e uma resposta HONESTA do control
// plane: o handle esta sob ataque e a janela do abuse prevention ainda nao
// zerou. Nao e "senha invalida" (KCF003) e, sobretudo, nao pode virar um
// convite para cadastrar conta: o cadastro implicito seria um caminho para
// BURlar o teto do handle. A falha limitada sobe intacta para o operador.
Bool loginRateLimited(String error) {
    return error.indexOf("KCF134") >= 0
}

String loginOrCreate(String control, String handle, String password) {
    var loginBody = mapOf()
    loginBody.put("handle", handle)
    loginBody.put("password", password)
    try {
        var raw = requireOk(http.post(control + "/v1/login", json.encode(loginBody), "Content-Type: application/json"))
        return mapField(json.decode<Map<String, String>>(raw), "token")
    } catch (String e) {
        // Teto de login: nao ha nada a criar e nada a tentar de novo — o
        // operador precisa saber que a janela ainda esta correndo.
        if (loginRateLimited(e)) {
            throw e
        }
        var createBody = mapOf()
        createBody.put("handle", handle)
        createBody.put("email", handle + "@kofcloud.local")
        createBody.put("password", password)
        var raw = ""
        try {
            raw = requireOk(http.post(control + "/v1/accounts", json.encode(createBody), "Content-Type: application/json"))
        } catch (String createError) {
            throw createFailureMessage(createError)
        }
        return mapField(json.decode<Map<String, String>>(raw), "token")
    }
}

String registerDevice(String control, String token, String name, String publicKey) {
    var body = mapOf()
    body.put("name", name)
    body.put("publicKey", publicKey)
    var raw = requireOk(http.post(control + "/v1/devices", json.encode(body), jsonHeader(token)))
    return mapField(json.decode<Map<String, String>>(raw), "deviceId")
}

Int cmdLogout(List<String> args) {
    if (extraPositional(args, 0)) {
        println("uso: kof cloud logout")
        return 1
    }
    // Revoga a credencial no servidor ANTES de apagar o local — antes o
    // logout era so-local e o kfc_ seguia valido para sempre (17-limitations).
    // Auto-revogacao: o valor da sessao autoriza e e o alvo (o endpoint nao
    // tem guarda de "token em uso"). KCF004 na revogacao = a credencial ja
    // nao era valida (vencida/revogada): nada vivo a revogar, nao e falha.
    var session = loadSession()
    var attempted = false
    var confirmed = false
    var revokeError = ""
    if (session != null) {
        var token = session.token
        if (token.length > 0) {
            attempted = true
            var body = mapOf()
            body.put("token", token)
            try {
                requireOk(http.post(session.controlUrl + "/v1/tokens/revoke", json.encode(body), jsonHeader(token)))
                confirmed = true
            } catch (String e) {
                revokeError = e
            }
        }
    }
    File(identityPath()).delete()
    File(sessionPath()).delete()
    File(stopPath()).delete()
    var disposition = logoutDisposition(attempted, confirmed, revokeError)
    if (disposition == "revoked") {
        println("Sessao encerrada. Credencial revogada no servidor.")
    } else if (disposition == "dead") {
        println("Sessao encerrada. Credencial ja nao era valida no servidor.")
    } else if (disposition == "local") {
        println("Sessao encerrada.")
    } else {
        println("Sessao encerrada localmente.")
        println("aviso: nao consegui revogar a credencial no servidor — ela segue valida.")
        println("Rode `kof cloud token revoke` apos logar de novo.")
    }
    return 0
}

// Saida do logout a partir da tentativa de revogacao (a rede fica no
// chamador): "local" = sem sessao; "revoked" = servidor confirmou; "dead" =
// KCF004 (credencial ja vencida/revogada — nada vivo, nao e falha); "warn"
// = outra falha (rede/control fora) — a credencial sobreviveu e o operador
// precisa saber. Pura para travar as quatro saidas sem HOME nem rede.
String logoutDisposition(Bool attempted, Bool confirmed, String revokeError) {
    if (attempted == false) {
        return "local"
    }
    if (confirmed) {
        return "revoked"
    }
    if (revokeError.indexOf("KCF004") >= 0) {
        return "dead"
    }
    return "warn"
}

// ---- connect / disconnect ----

Int cmdConnect(List<String> args) {
    if (extraPositional(args, 0)) {
        println("uso: kof cloud connect")
        return 1
    }
    var identity = loadIdentity()
    var session = loadSession()
    if (identity == null) {
        println(notLoggedInLine())
        return 1
    }
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    File(stopPath()).delete()
    appendLog("connecting as " + identity.deviceName + " (" + identity.deviceId + ")")
    var config = AgentConfig(session.controlUrl, identity.deviceId, session.accountId, session.token, identity.privateKey, stopPath(), "", 0, 0)
    runAgent(config, false)
    appendLog("agent stopped")
    return 0
}

Int cmdDisconnect(List<String> args) {
    if (extraPositional(args, 0)) {
        println("uso: kof cloud disconnect")
        return 1
    }
    writeTextTo(stopPath(), longToString(time.now()))
    println("Desconexao solicitada — o agente encerra no proximo heartbeat.")
    return 0
}

// ---- status ----

// Estado do agente para o `status`, derivado da presenca real no Edge.
// Puro (precedente: doctorTunnelLine): o chamador passa o que ja buscou.
// ATIVO so com tunel vivo; sem presenca consultavel = desconhecido (nunca
// inventa ATIVO nem PARADO); sem tunel = PARADO, distinguindo "parada
// pedida" (stopFile) de "nunca subiu/caiu".
String agentStatusLine(Bool tunnelOnline, Bool tunnelKnown, Bool stopped) {
    if (tunnelOnline) {
        return "ATIVO (tunel vivo)"
    }
    if (tunnelKnown == false) {
        return "desconhecido (presenca indisponivel)"
    }
    if (stopped) {
        return "PARADO (parada pedida; rode: kof cloud connect)"
    }
    return "PARADO (sem tunel; rode: kof cloud connect)"
}

Int cmdStatus(List<String> args) {
    var identity = loadIdentity()
    var session = loadSession()
    if (identity == null) {
        println("Estado: DESCONECTADO (nao logado)")
        return 0
    }
    if (session == null) {
        println("Estado: DESCONECTADO (nao logado)")
        return 0
    }
    if (extraPositional(args, 0)) {
        println("uso: kof cloud status")
        return 1
    }
    println("Conta:        " + identity.handle)
    println("Dispositivo:  " + identity.deviceName + " (" + identity.deviceId + ")")
    println("Control:      " + session.controlUrl)
    // Tunel real, confirmado pelo Edge (nao pela maquina local): o control
    // plane responde com os devices que tem sessao viva NESTE Edge. So conta
    // o device atual; OFFLINE aqui significa "sem rota" mesmo com o agente
    // rodando (tunel caiu, Edge reiniciou, conta suspensa...).
    //
    // O estado do AGENTE vem daqui, nao do arquivo de parada: antes o
    // `status` dizia "Agente: ATIVO" so porque o stopFile nao existia —
    // medido, uma maquina que nunca rodou `connect` aparecia ATIVO. O
    // stopFile so distingue "parada pedida" de "nunca subiu/caiu".
    var tunnelOnline = false
    var tunnelKnown = false
    try {
        var raw = requireOk(http.get(session.controlUrl + "/v1/presence", authHeader(session.token)))
        // Lista JSON de ids (strings). Comparacao por substring com aspas:
        // IDs sao UUIDs sem aspas internas, entao nao ha falso positivo.
        // (json.decode nao suporta List<Map<...>> — JSN004.)
        tunnelOnline = bodyContainsId(raw, identity.deviceId)
        tunnelKnown = true
        if (tunnelOnline) {
            println("Tunel:        ONLINE (sessao viva no Edge)")
        } else {
            println("Tunel:        OFFLINE (sem sessao no Edge — rode: kof cloud connect)")
        }
    } catch (String e) {
        println("Tunel:        desconhecido (" + e + ")")
    }
    println("Agente:       " + agentStatusLine(tunnelOnline, tunnelKnown, fileExists(stopPath())))
    var statusServices = listOf<Service>()
    try {
        var services = fetchServices(session.controlUrl, session.token)
        statusServices = services
        println("Servicos:     " + intToString(services.size))
        // Mesma linha do `service list` (device incluido): operador ve onde
        // cada servico roda sem cruzar comandos. Falha ao buscar devices nao
        // esconde a lista (o rotulo cai no id).
        var devices = listOf<Device>()
        try {
            devices = fetchDevices(session.controlUrl, session.token)
        } catch (String e) {
        }
        for (var service in services) {
            println("  " + serviceListLine(service, devices))
        }
    } catch (String e) {
        println("Servicos:     indisponivel (" + e + ")")
    }
    // Dominios proprios que levam a ESTA maquina (best-effort): o operador
    // ve, junto dos servicos, quais hostnames externos apontam para eles.
    if (statusServices.size > 0) {
        try {
            var domainsRaw = requireOk(http.get(session.controlUrl + "/v1/domains", authHeader(session.token)))
            var pointing = domainsPointingToServices(json.decode<List<DomainEntry>>(domainsRaw), statusServices)
            if (pointing.size > 0) {
                println("Dominios:     " + intToString(pointing.size) + " apontando para esta maquina")
                for (var domain in pointing) {
                    println(statusDomainLine(domain, statusServices))
                }
            }
        } catch (String e) {
        }
    }
    // Credencial da conta perto do fim (mesmo sinal do fio que o
    // `token list`/`doctor`/painel; detalhes no comentario da funcao).
    // Best-effort: falha de busca nao derruba o status (as linhas de cima
    // ja mostram o control fora do ar) e nunca ha valor de kfc_ aqui.
    try {
        var tokensRaw = requireOk(http.get(session.controlUrl + "/v1/tokens", authHeader(session.token)))
        var credWarn = statusCredentialWarning(tokensRaw)
        if (credWarn.length > 0) {
            println(credWarn)
        }
    } catch (String e) {
    }
    return 0
}

// ---- dispositivos ----

// Linha do `device list`: nome, id, status de cadastro e presenca REAL
// confirmada pelo Edge (`/v1/presence`), nao inferida do processo local.
// Puro: recebe o corpo do presence ja buscado (mesma regra do `status` e do
// `doctor` — `bodyContainsId`). Lista de dispositivos sem saber qual esta
// vivo obriga o operador a cruzar dois comandos para responder "este
// notebook esta no ar?".
// Presenca do device derivada do fio: "ONLINE"/"OFFLINE"/"desconhecido (...)".
// Fonte unica da linha de texto e do --json (as duas nao podem divergir).
String presenceOf(String deviceId, String presenceRaw, String presenceError) {
    if (presenceError.length > 0) {
        return "desconhecido (" + presenceError + ")"
    }
    if (bodyContainsId(presenceRaw, deviceId)) {
        return "ONLINE"
    }
    return "OFFLINE"
}

// Listagens em JSON (CI/automacao): delegam na MESMA serializacao do fio
// (`serviceJson`/`deviceJson` do control plane — o que o operador ve no
// curl e o que a CLI imprime), e o device ganha o eixo de presenca que a
// API nao carrega por device (vem do /v1/presence). O domain delega no
// corpo do GET /v1/domains — mesma entrada que a linha de texto imprime.
// Nada inventado: saida vazia e `[]`, nunca texto de "nenhum servico".
String serviceListJsonFor(List<Service> services) {
    var parts = listOf<String>()
    for (var service in services) {
        parts.add(serviceJson(service))
    }
    return "[" + joinStrings(parts, ",") + "]"
}

String deviceListJsonFor(List<Device> devices, String presenceRaw, String presenceError) {
    var parts = listOf<String>()
    for (var device in devices) {
        var entry = mapOf()
        entry.put("id", device.id)
        entry.put("deviceId", device.id)
        entry.put("name", device.name)
        entry.put("status", device.status)
        entry.put("tunnel", presenceOf(device.id, presenceRaw, presenceError))
        parts.add(json.encode(entry))
    }
    return "[" + joinStrings(parts, ",") + "]"
}

// JSON do `domain list` (mesma lista do fio que a linha de texto imprime —
// precedente: serviceListJsonFor). Uma entrada por dominio com os campos
// que o operador ve no texto (kind/hostname/service + status quando ha).
String domainListJsonFor(List<DomainEntry> domains) {
    var parts = listOf<String>()
    for (var domain in domains) {
        var entry = mapOf()
        entry.put("hostname", domain.hostname)
        entry.put("kind", domain.kind)
        entry.put("service", domain.service)
        entry.put("status", domain.status)
        parts.add(json.encode(entry))
    }
    return "[" + joinStrings(parts, ",") + "]"
}

String deviceListLine(Device device, String presenceRaw, String presenceError) {
    return device.name + "  " + device.id + "  " + device.status + "  tunel: " + presenceOf(device.id, presenceRaw, presenceError)
}

Int cmdDeviceList(List<String> args) {
    if (extraPositional(args, 0) || flagDuplicated(args, "--json")) {
        println("uso: kof cloud device list [--json]")
        return 1
    }
    var asJson = hasFlag(args, "--json")
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    try {
        var devices = fetchDevices(session.controlUrl, session.token)
        // Presenca: uma falha na consulta nao esconde a lista — a coluna vira
        // "desconhecido", nunca um OFFLINE inventado (texto e --json usam a
        // mesma `presenceOf`).
        var presenceRaw = ""
        var presenceError = ""
        try {
            presenceRaw = requireOk(http.get(session.controlUrl + "/v1/presence", authHeader(session.token)))
        } catch (String e) {
            presenceError = e
        }
        if (asJson) {
            println(deviceListJsonFor(devices, presenceRaw, presenceError))
            return 0
        }
        if (devices.size == 0) {
            println("nenhum dispositivo registrado")
            return 0
        }
        for (var device in devices) {
            println(deviceListLine(device, presenceRaw, presenceError))
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

Int cmdDeviceRevoke(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var deviceArg = firstPositional(args)
    // Posicional sobrando barra ANTES de qualquer efeito: `device revoke
    // notebook lixo` revogava/suspendia `notebook` em silencio (revoke ainda
    // remove servicos e credenciais do device) — typo virava acao destrutiva.
    if (deviceArg.trim().length == 0 || extraPositional(args, 1)) {
        println("uso: kof cloud device revoke <nome|deviceId> [--yes]")
        return 1
    }
    // --yes repetido barra no uso (mesma regra do down/--check do deploy).
    if (flagDuplicated(args, "--yes")) {
        println("uso: kof cloud device revoke <nome|deviceId> [--yes]")
        return 1
    }
    var deviceId = deviceArg
    try {
        var resolved = resolveDeviceByNameOrId(session, deviceArg)
        deviceId = resolved.deviceId
        if (deviceId.length == 0) {
            printDeviceNotFound(resolved.devices, deviceArg)
            return 1
        }
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
    // Guarda de destruicao: resolve o alvo antes de perguntar (a mensagem
    // nomeia o dispositivo real) e nao toca no control plane sem --yes.
    if (hasFlag(args, "--yes") == false) {
        println(deviceRevokeConfirmationRequired(deviceArg.trim()))
        return 1
    }
    var body = mapOf()
    body.put("deviceId", deviceId)
    try {
        requireOk(http.post(session.controlUrl + "/v1/devices/revoke", json.encode(body), jsonHeader(session.token)))
        println("Dispositivo revogado: " + deviceArg)
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

