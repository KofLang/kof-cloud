// ---- servicos ----

// Valida nome/porta/exposure/address ANTES de qualquer rede ou sessao:
// pura, testavel sem HOME. Devolve "" quando ok, ou a mensagem de erro
// (mesmas regras da API KCF045/KCF047 — fail-fast local com dica).
String validatePublishLocal(String name, Int port, String exposure, String address) {
    // Trim como o parseManifest (manifesto e CLI aceitam os mesmos campos;
    // espacos sobrando nao devem virar nome com espaco nem exposure
    // invalida). Pura: apara copias locais, sem tocar os args.
    var trimmedName = name.trim()
    var trimmedExposure = exposure.trim()
    var trimmedAddress = address.trim()
    if (trimmedName.length == 0 || port <= 0 || port > 65535) {
        return "uso: kof cloud publish <nome> --port <porta> (porta 1-65535)"
    }
    if (exposureIsKnown(trimmedExposure) == false) {
        return "exposure invalida: " + trimmedExposure + " (use PUBLIC, AUTHENTICATED ou PRIVATE)"
    }
    if (validLocalAddress(trimmedAddress) == false) {
        return "address invalido: " + trimmedAddress + " (use 127.0.0.1, localhost ou ::1)"
    }
    return ""
}

Int cmdPublish(List<String> args) {
    var identity = loadIdentity()
    var session = loadSession()
    if (identity == null) {
        println(notLoggedInLine())
        return 1
    }
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var name = firstPositional(args).trim()
    // Flags com valor obrigatorio quando presentes: `--port` solto (sem
    // valor) nao pode cair no erro generico de uso nem em default.
    // Duplicada tambem nao: `flagValue` leria a primeira em silencio.
    if (flagMissingValue(args, "--port") || flagMissingValue(args, "--address") || flagMissingValue(args, "--exposure") || flagMissingValue(args, "--device")) {
        println("uso: kof cloud publish <nome> --port <porta> [--exposure PUBLIC|AUTHENTICATED|PRIVATE] [--address <addr>] [--device <nome>]")
        return 1
    }
    if (flagDuplicated(args, "--port") || flagDuplicated(args, "--address") || flagDuplicated(args, "--exposure") || flagDuplicated(args, "--device")) {
        println("flag repetida — informe uma so vez: kof cloud publish <nome> --port <porta> [--exposure PUBLIC|AUTHENTICATED|PRIVATE] [--address <addr>] [--device <nome>]")
        return 1
    }
    if (extraPositional(args, 1)) {
        println("argumento a mais — uso: kof cloud publish <nome> --port <porta> [--exposure PUBLIC|AUTHENTICATED|PRIVATE] [--address <addr>] [--device <nome>]")
        return 1
    }
    var port = parseIntSafe(flagValue(args, "--port").trim(), 0)
    // Trim como o parseManifest (ausente/vazio/so-espacos = default, igual
    // ao "ausente defaulta" do manifesto): espacos sobrando nao devem virar
    // nome com espaco nem exposure invalida.
    var address = flagValue(args, "--address").trim()
    if (address.length == 0) {
        address = defaultLocalAddress()
    }
    var exposure = flagValue(args, "--exposure").trim()
    if (exposure.length == 0) {
        exposure = defaultExposure()
    }
    var deviceId = identity.deviceId
    var overrideDevice = flagValue(args, "--device")
    if (overrideDevice.length > 0) {
        // Aceita NOME ou id: a ajuda documenta <nome>, mas ids tambem
        // funcionam (compat). Nome resolve pela lista da conta; id passa
        // direto e o control plane valida (404 opaco se alheio).
        deviceId = deviceIdByNameOrId(session, overrideDevice)
        if (deviceId.length == 0) {
            println(deviceNotFoundLine(overrideDevice))
            return 1
        }
    }
    // Fail-fast local (mesmas regras da API KCF045/KCF047): evita uma
    // viagem de rede para um erro certo, com dica acionavel na hora.
    var localError = validatePublishLocal(name, port, exposure, address)
    if (localError.length > 0) {
        println(localError)
        return 1
    }
    var body = mapOf()
    body.put("deviceId", deviceId)
    body.put("name", name)
    body.put("localAddress", address)
    body.put("localPort", intToString(port))
    body.put("protocol", defaultProtocol())
    body.put("exposure", exposure)
    try {
        var raw = requireOk(http.post(session.controlUrl + "/v1/services", json.encode(body), jsonHeader(session.token)))
        var service = json.decode<Service>(raw)
        println("Servico publicado.")
        println("")
        println("Nome:   " + service.name)
        println("Local:  " + service.localAddress + ":" + intToString(service.localPort))
        println("Publico: https://" + service.hostname)
        println("Status: " + service.status)
        return 0
    } catch (String e) {
        printFail("falha ao publicar", e)
        return 1
    }
}

Int cmdUnpublish(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var name = firstPositional(args)
    if (name.trim().length == 0 || extraPositional(args, 1)) {
        println("uso: kof cloud unpublish <nome>")
        return 1
    }
    try {
        var services = fetchServices(session.controlUrl, session.token)
        var target = matchServiceName(services, name)
        if (target.length == 0) {
            println(serviceNotFoundLine(name))
            return 1
        }
        var body = mapOf()
        body.put("serviceId", target)
        requireOk(http.post(session.controlUrl + "/v1/services/remove", json.encode(body), jsonHeader(session.token)))
        println("Servico removido: " + name)
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

Int cmdServiceList(List<String> args) {
    if (extraPositional(args, 0)) {
        println("uso: kof cloud service list")
        return 1
    }
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    try {
        var services = fetchServices(session.controlUrl, session.token)
        if (services.size == 0) {
            println("nenhum servico publicado")
            return 0
        }
        for (var service in services) {
            println(service.name + "  https://" + service.hostname + "  " + service.exposure + "  " + service.status)
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

Int cmdServiceStatus(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var name = firstPositional(args)
    if (name.trim().length == 0 || extraPositional(args, 1)) {
        println("uso: kof cloud service status <nome>")
        return 1
    }
    try {
        var services = fetchServices(session.controlUrl, session.token)
        var trimmed = name.trim()
        for (var service in services) {
            if (service.name == trimmed) {
                println("Servico: " + service.name)
                println("Host:    https://" + service.hostname)
                println("Local:   " + service.localAddress + ":" + intToString(service.localPort))
                println("Exposicao: " + service.exposure)
                println("Status:  " + service.status)
                // Inventario de credenciais junto do status: o operador ve
                // de relance se ha kfs_ com prazo a vigiar (só AUTHENTICATED
                // usa; nos demais, a lista vem vazia e nada e impresso).
                try {
                    var tokenBody = mapOf()
                    tokenBody.put("serviceId", service.id)
                    var tokenRaw = requireOk(http.post(session.controlUrl + "/v1/services/tokens", json.encode(tokenBody), jsonHeader(session.token)))
                    var entries = json.decode<List<ServiceTokenEntry>>(tokenRaw)
                    var inventory = tokenInventoryLine(entries)
                    if (inventory.length > 0) {
                        println(inventory)
                    }
                } catch (String inner) {
                    // Inventario e diagnostico secundario: nao derruba o
                    // status se falhar (o dado principal ja saiu).
                }
                // Dominios proprios vinculados: o operador ve de relance se
                // o servico tem customs (e se falta DNS em algum). Falha
                // silenciosa nao derruba o status (mesma regra do inventario).
                try {
                    var domainRaw = requireOk(http.get(session.controlUrl + "/v1/domains", authHeader(session.token)))
                    var domains = json.decode<List<DomainEntry>>(domainRaw)
                    var customs = customDomainsFor(domains, service.name)
                    for (var custom in customs) {
                        println("Dominio: " + domainListLine(custom))
                    }
                } catch (String innerDomains) {
                }
                return 0
            }
        }
        println(serviceNotFoundLine(name))
        return 1
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

