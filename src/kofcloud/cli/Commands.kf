// Implementacao dos subcomandos. Cada um devolve o exit code.

// Incidente como o CLI le (GET /v1/incidents).
record IncidentEntry(String id, String kind, String severity, String accountId, String summary, String openedAt, String resolvedAt)

record DomainEntry(String hostname, String kind, String service, String status)

// Mensagens "nao encontrado" da CLI (fonte unica): 7 pontos de servico e 4
// de dispositivo imprimiam o mesmo literal. Helpers puros para travar o
// formato em teste (precedente: domainListLine/tokenInventoryLine).
String serviceNotFoundLine(String name) {
    return "servico nao encontrado: " + name
}

String deviceNotFoundLine(String name) {
    return "dispositivo nao encontrado: " + name
}

// Guarda de sessao da CLI (fonte unica): comandos que exigem login repetiam
// `println("nao logado")` bare em ~20 pontos enquanto outros ja davam a dica
// de login — o operador sem sessao recebia mensagens diferentes pelo mesmo
// estado. Todos os pontos agora usam a forma com dica (precedente:
// serviceNotFoundLine/deviceNotFoundLine).
String notLoggedInLine() {
    return "nao logado — rode: kof cloud login <handle> --password <senha>"
}

// Linhas de `uso:` repetidas em dois guardas do mesmo comando (fonte unica):
// cada par abaixo aparecia 2x — uma para flag invalida (missing/duplicada)
// e outra para args invalidos. Helpers puros para travar o formato em teste
// (precedente: serviceNotFoundLine/deviceNotFoundLine/notLoggedInLine).
String usoServiceTokenLine() {
    return "uso: kof cloud service token <nome> [--ttl <horas>]"
}

String usoServeLine() {
    return "uso: kof cloud serve [--control-port N] [--tunnel-port N] [--http-port N] [--state <caminho>] [--waf detectar|enforce] [--panel] [--tls-cert <pem> --tls-key <pem>] (portas 1-65535)"
}

// Modo WAF do `serve --waf`: ausente, vazio ou so-espacos = detectar
// (conta e segue); "enforce" liga o 403; qualquer outro valor e erro
// (fail-fast, sem default mentiroso). Pura, sem rede nem HOME — o chamador
// aplica no EdgeState. Precedente: resolveStatePath (mesma regra de
// ausente/vazio/so-espacos = default, valor aparado).
String resolveWafMode(String flagRaw) {
    var trimmed = flagRaw.trim()
    if (trimmed.length == 0) {
        return "detectar"
    }
    if (trimmed == "detectar" || trimmed == "enforce") {
        return trimmed
    }
    return "?"
}

String usoLogsLine() {
    return "uso: kof cloud logs [--tail <linhas>]"
}

String usoDomainAddLine() {
    return "uso: kof cloud domain add <hostname> --service <nome>"
}

// Uma linha do `domain list`: customs mostram PENDING/VERIFIED (o operador
// precisa saber se falta o DNS); wildcard/service nao tem ciclo proprio.
String domainListLine(DomainEntry domain) {
    var line = domain.kind + "  " + domain.hostname
    if (domain.status.length > 0) {
        line = line + "  " + domain.status
    }
    return line
}

record DomainStatus(String hostname, String status, String instruction, String verifiedAt)

// Customs vinculados a UM servico (para o `service status`): puro, sem rede
// nem HOME — recebe a lista do GET /v1/domains e o nome do servico, devolve
// so os customs daquele servico (precedente: tokenInventoryLine). Lista
// vazia quando nada aponta para ele (servico novo, sem dominio proprio).
List<DomainEntry> customDomainsFor(List<DomainEntry> domains, String serviceName) {
    var out = listOf<DomainEntry>()
    for (var domain in domains) {
        if (domain.kind == "custom" && domain.service == serviceName) {
            out.add(domain)
        }
    }
    return out
}

// Falha com dica humana (padrao kof-share `errText`): a primeira linha mantem
// o codigo estavel da plataforma; a `Hint:` orienta o proximo passo sem
// revelar segredos ou recursos alheios.
void printFail(String context, String raw) {
    if (context.length > 0) {
        println(context + ": " + raw)
    } else {
        println(raw)
    }
    var hint = errHint(raw)
    if (hint.length > 0) {
        println("Hint: " + hint)
    }
}

String flagValue(List<String> args, String flag) {
    var i = 0
    while (i < args.size) {
        if (args.get(i) == flag && i + 1 < args.size) {
            return args.get(i + 1)
        }
        i = i + 1
    }
    return ""
}

Bool hasFlag(List<String> args, String flag) {
    for (var arg in args) {
        if (arg == flag) {
            return true
        }
    }
    return false
}

// Flag presente mas sem valor (ex.: `--ttl` no fim, ou seguido de outra
// flag). `flagValue` devolveria "" — indistinguivel de "flag ausente" —
// e o chamador aplicaria o default em silencio, mentindo sobre a intencao
// do operador. Devolve true so quando a flag esta la E o proximo token
// nao existe ou tambem e flag.
Bool flagMissingValue(List<String> args, String flag) {
    var i = 0
    while (i < args.size) {
        if (args.get(i) == flag) {
            if (i + 1 >= args.size) {
                return true
            }
            if (args.get(i + 1).startsWith("--")) {
                return true
            }
            return false
        }
        i = i + 1
    }
    return false
}

// Flag repetida (`--port 80 --port 8080`): `flagValue` devolveria a
// primeira em silencio, ignorando a segunda — ambiguidade que vira
// surpresa (o operador acha que vale a ultima). Fail-fast: qualquer
// duplicata e erro antes de qualquer efeito.
Bool flagDuplicated(List<String> args, String flag) {
    var seen = false
    for (var arg in args) {
        if (arg == flag) {
            if (seen) {
                return true
            }
            seen = true
        }
    }
    return false
}

String firstPositional(List<String> args) {
    for (var arg in args) {
        if (arg.startsWith("--") == false) {
            return arg
        }
    }
    return ""
}

// Posicionais alem do esperado (`service token-revoke site kfs_x lixo`):
// first/secondPositional leriam os N primeiros em silencio e o resto
// sumiria — typo que vira acao errada sem aviso. Devolve true quando ha
// mais posicionais que `max`. Puro, sem rede nem HOME.
// NOTA: valores de flag (`--port 8080`) nao sao posicionais — pula o
// token seguinte a qualquer flag conhecida com valor.
Bool extraPositional(List<String> args, Int max) {
    var count = 0
    var i = 0
    while (i < args.size) {
        var arg = args.get(i)
        if (arg == "--port" || arg == "--address" || arg == "--exposure" || arg == "--device" || arg == "--ttl" || arg == "--tail" || arg == "--control" || arg == "--control-port" || arg == "--tunnel-port" || arg == "--http-port" || arg == "--state" || arg == "--waf" || arg == "--tls-cert" || arg == "--tls-key" || arg == "--service" || arg == "--file" || arg == "--password") {
            i = i + 2
            continue
        }
        if (arg.startsWith("--") == false) {
            count = count + 1
            if (count > max) {
                return true
            }
        }
        i = i + 1
    }
    return false
}

// ---- login / logout ----

// Entradas do login aparadas (handle/--control/--device; senha intacta de
// proposito — credencial, espacos podem ser intencionais). Pura, sem rede
// nem HOME: o default do control/device vive no chamador (control le de
// config, device cai em "default"), aqui so normaliza. O handle e rotulo
// DNS (`validLabel`): " mel " nunca validaria na API (400 KCF001); o
// --device com padding registraria nome sujo que depois nao resolve; e
// --device so-espacos escapava do default. A senha nunca e aparada.
record LoginInputs(String handle, String control, String device)

LoginInputs resolveLoginInputs(String handleRaw, String controlRaw, String deviceRaw) {
    return LoginInputs(handleRaw.trim(), controlRaw.trim(), deviceRaw.trim())
}

Int cmdLogin(List<String> args) {
    var handle = firstPositional(args)
    var password = flagValue(args, "--password")
    var control = flagValue(args, "--control")
    if (control.length == 0) {
        control = defaultControlUrl()
    }
    var deviceName = flagValue(args, "--device")
    if (deviceName.length == 0) {
        deviceName = "default"
    }
    var inputs = resolveLoginInputs(handle, control, deviceName)
    handle = inputs.handle
    control = inputs.control
    deviceName = inputs.device
    if (deviceName.length == 0) {
        deviceName = "default"
    }
    if (handle.length == 0 || password.length == 0 || extraPositional(args, 1) || flagMissingValue(args, "--password") || flagMissingValue(args, "--control") || flagMissingValue(args, "--device") || flagDuplicated(args, "--password") || flagDuplicated(args, "--control") || flagDuplicated(args, "--device")) {
        println("uso: kof cloud login <handle> --password <senha> [--control <url>] [--device <nome>]")
        return 1
    }

    var token = ""
    try {
        token = loginOrCreate(control, handle, password)
    } catch (String e) {
        printFail("falha no login", e)
        return 1
    }

    var pair = generateKeyPair()
    var deviceId = ""
    try {
        deviceId = registerDevice(control, token, deviceName, pair.publicKey)
    } catch (String e) {
        printFail("falha ao registrar dispositivo", e)
        return 1
    }

    saveSession(LocalSession("", handle, token, control))
    saveIdentity(LocalIdentity(deviceId, "", handle, deviceName, pair.privateKey, pair.publicKey))
    println("Logado como " + handle)
    println("Dispositivo: " + deviceName + " (" + deviceId + ")")
    println("Control plane: " + control)
    return 0
}

String loginOrCreate(String control, String handle, String password) {
    var loginBody = mapOf()
    loginBody.put("handle", handle)
    loginBody.put("password", password)
    try {
        var raw = requireOk(http.post(control + "/v1/login", json.encode(loginBody), "Content-Type: application/json"))
        return mapField(json.decode<Map<String, String>>(raw), "token")
    } catch (String e) {
        var createBody = mapOf()
        createBody.put("handle", handle)
        createBody.put("email", handle + "@kofcloud.local")
        createBody.put("password", password)
        var raw = requireOk(http.post(control + "/v1/accounts", json.encode(createBody), "Content-Type: application/json"))
        return mapField(json.decode<Map<String, String>>(raw), "token")
    }
}

String registerDevice(String control, String token, String name, String publicKey) {
    var body = mapOf()
    body.put("name", name)
    body.put("publicKey", publicKey)
    var raw = requireOk(http.post(control + "/v1/devices", json.encode(body), jsonHeader(token)))
    return mapField(json.decode<Map<String, String>>(raw), "deviceId")
}

Int cmdLogout(List<String> args) {
    if (extraPositional(args, 0)) {
        println("uso: kof cloud logout")
        return 1
    }
    File(identityPath()).delete()
    File(sessionPath()).delete()
    File(stopPath()).delete()
    println("Sessao encerrada.")
    return 0
}

// ---- connect / disconnect ----

Int cmdConnect(List<String> args) {
    if (extraPositional(args, 0)) {
        println("uso: kof cloud connect")
        return 1
    }
    var identity = loadIdentity()
    var session = loadSession()
    if (identity == null) {
        println(notLoggedInLine())
        return 1
    }
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    File(stopPath()).delete()
    appendLog("connecting as " + identity.deviceName + " (" + identity.deviceId + ")")
    var config = AgentConfig(session.controlUrl, identity.deviceId, session.accountId, session.token, identity.privateKey, stopPath(), "", 0, 0)
    runAgent(config, false)
    appendLog("agent stopped")
    return 0
}

Int cmdDisconnect(List<String> args) {
    if (extraPositional(args, 0)) {
        println("uso: kof cloud disconnect")
        return 1
    }
    writeTextTo(stopPath(), longToString(time.now()))
    println("Desconexao solicitada — o agente encerra no proximo heartbeat.")
    return 0
}

// ---- status ----

Int cmdStatus(List<String> args) {
    var identity = loadIdentity()
    var session = loadSession()
    if (identity == null) {
        println("Estado: DESCONECTADO (nao logado)")
        return 0
    }
    if (session == null) {
        println("Estado: DESCONECTADO (nao logado)")
        return 0
    }
    if (extraPositional(args, 0)) {
        println("uso: kof cloud status")
        return 1
    }
    println("Conta:        " + identity.handle)
    println("Dispositivo:  " + identity.deviceName + " (" + identity.deviceId + ")")
    println("Control:      " + session.controlUrl)
    if (fileExists(stopPath())) {
        println("Agente:       PARADO")
    } else {
        println("Agente:       ATIVO")
    }
    // Tunel real, confirmado pelo Edge (nao pela maquina local): o control
    // plane responde com os devices que tem sessao viva NESTE Edge. So conta
    // o device atual; OFFLINE aqui significa "sem rota" mesmo com o agente
    // rodando (tunel caiu, Edge reiniciou, conta suspensa...).
    try {
        var raw = requireOk(http.get(session.controlUrl + "/v1/presence", authHeader(session.token)))
        // Lista JSON de ids (strings). Comparacao por substring com aspas:
        // IDs sao UUIDs sem aspas internas, entao nao ha falso positivo.
        // (json.decode nao suporta List<Map<...>> — JSN004.)
        var online = bodyContainsId(raw, identity.deviceId)
        if (online) {
            println("Tunel:        ONLINE (sessao viva no Edge)")
        } else {
            println("Tunel:        OFFLINE (sem sessao no Edge — rode: kof cloud connect)")
        }
    } catch (String e) {
        println("Tunel:        desconhecido (" + e + ")")
    }
    try {
        var services = fetchServices(session.controlUrl, session.token)
        println("Servicos:     " + intToString(services.size))
        for (var service in services) {
            println("  " + service.name + "  ->  https://" + service.hostname + "  [" + service.status + "]")
        }
    } catch (String e) {
        println("Servicos:     indisponivel (" + e + ")")
    }
    return 0
}

// ---- dispositivos ----

Int cmdDeviceList(List<String> args) {
    if (extraPositional(args, 0)) {
        println("uso: kof cloud device list")
        return 1
    }
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    try {
        var devices = fetchDevices(session.controlUrl, session.token)
        if (devices.size == 0) {
            println("nenhum dispositivo registrado")
            return 0
        }
        for (var device in devices) {
            println(device.name + "  " + device.id + "  " + device.status)
        }
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

Int cmdDeviceRevoke(List<String> args) {
    var session = loadSession()
    if (session == null) {
        println(notLoggedInLine())
        return 1
    }
    var deviceArg = firstPositional(args)
    if (deviceArg.trim().length == 0) {
        println("uso: kof cloud device revoke <nome|deviceId>")
        return 1
    }
    var deviceId = deviceArg
    try {
        deviceId = deviceIdByNameOrId(session, deviceArg)
        if (deviceId.length == 0) {
            println(deviceNotFoundLine(deviceArg))
            return 1
        }
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
    var body = mapOf()
    body.put("deviceId", deviceId)
    try {
        requireOk(http.post(session.controlUrl + "/v1/devices/revoke", json.encode(body), jsonHeader(session.token)))
        println("Dispositivo revogado: " + deviceArg)
        return 0
    } catch (String e) {
        printFail("falha", e)
        return 1
    }
}

