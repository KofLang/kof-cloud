package kofcloud.cli

import kofcloud.cli.Commands
import kofcloud.cli.Deploy
import kofcloud.cli.Local
import kofcloud.model.Errors
import kofcloud.model.Device
import kofcloud.util.Text
import kofcloud.store.Store

// Diagnostico somente-leitura (Fase 7, slice 4): responde "onde quebrou?"
// sem alterar nada — nenhum publish, remove, revoke, token ou escrita.
// Cada checagem retorna "" (ok) ou "motivo" (falha); o comando imprime uma
// linha por checagem e sai 0 so se todas passarem.
//
// Ordem (da maquina para a internet): sessao local -> control plane ->
// edge -> DNS do hostname -> porta local de cada servico do manifesto
// (se houver `kofcloud.json`; sem manifesto, so identidade + plataforma).

record DoctorReport(Bool ok, List<String> lines)

String doctorOkLine(String label) {
    return "ok   " + label
}

String doctorFailLine(String label, String why) {
    return "FALHA " + label + ": " + why
}

// Linha da camada do tunel a partir do corpo de /v1/presence ja buscado
// (ou do erro da busca): pura, sem rede nem HOME — testavel sem tunel.
// Devolve a linha pronta; "" significa "ok, sessao viva".
String doctorTunnelLine(String presenceRaw, String deviceId, String fetchError) {
    if (fetchError.length > 0) {
        return doctorFailLine("tunel", "presenca indisponivel (" + fetchError + ")")
    }
    if (bodyContainsId(presenceRaw, deviceId)) {
        return doctorOkLine("tunel ativo no Edge (sessao viva)")
    }
    return doctorFailLine("tunel", "sem sessao no Edge — rode: kof cloud connect")
}

// Linha da camada TLS a partir do resultado de `openssl x509` ja executado
// (pura, sem rede nem HOME): "" quando nao ha `--tls-cert` (nada a checar).
// Distingue arquivo ausente, PEM invalido e expiracao em 30 dias — o
// caminho aparece na mensagem, o conteudo do PEM nunca.
String doctorTlsLine(String certPath, Bool exists, Int parseExit, Int checkendExit) {
    if (certPath.length == 0) {
        return ""
    }
    if (exists == false) {
        return doctorFailLine("tls", certPath + " nao encontrado")
    }
    if (parseExit != 0) {
        return doctorFailLine("tls", certPath + " nao e um PEM valido (openssl x509 falhou)")
    }
    if (tlsCertExpiringSoon(checkendExit)) {
        return doctorFailLine("tls", certPath + " expira em menos de 30 dias — renove o PEM")
    }
    return doctorOkLine("tls (" + certPath + ", valido por mais de 30 dias)")
}

DoctorReport doctorCheck(String manifestPath) {
    return doctorCheckWith(manifestPath, "")
}

DoctorReport doctorCheckWith(String manifestPath, String tlsCertPath) {
    var lines = listOf<String>()
    var failed = false

    // 1. Identidade/conta local.
    var session = loadSession()
    if (session == null) {
        lines.add(doctorFailLine("login local", notLoggedInLine()))
        return DoctorReport(false, lines)
    }
    var identity = loadIdentity()
    if (identity == null) {
        lines.add(doctorFailLine("login local", notLoggedInLine()))
        return DoctorReport(false, lines)
    }
    lines.add(doctorOkLine("login local (" + identity.handle + "/" + identity.deviceName + ")"))

    // 2. Control plane alcancavel e autenticado.
    var health = ""
    try {
        health = requireOk(http.get(session.controlUrl + "/v1/health", authHeader(session.token)))
    } catch (String e) {
        lines.add(doctorFailLine("control plane", session.controlUrl + " inacessivel ou fora do ar (" + e + ")"))
        return DoctorReport(false, lines)
    }
    if (health.indexOf("\"ok\"") < 0 && health.indexOf("ok") < 0) {
        lines.add(doctorFailLine("control plane", "resposta inesperada de " + session.controlUrl + "/v1/health"))
        return DoctorReport(false, lines)
    }
    lines.add(doctorOkLine("control plane (" + session.controlUrl + ")"))

    // 3. Dispositivo conhecido pelo control plane.
    var devices = listOf<Device>()
    try {
        devices = fetchDevices(session.controlUrl, session.token)
    } catch (String e) {
        lines.add(doctorFailLine("dispositivo", "nao foi possivel listar devices (" + e + ")"))
        return DoctorReport(false, lines)
    }
    var known = false
    for (var device in devices) {
        if (device.id == identity.deviceId) {
            known = true
        }
    }
    if (known == false) {
        lines.add(doctorFailLine("dispositivo", "este device nao esta registrado — rode: kof cloud login novamente"))
        return DoctorReport(false, lines)
    }
    lines.add(doctorOkLine("dispositivo registrado (" + identity.deviceId + ")"))

    // 4. Tunel real no Edge (presenca confirmada, nao inferida do processo
    // local): sem sessao viva nao ha rota, mesmo com manifesto ok. Antes
    // dos servicos para rodar tambem sem `kofcloud.json`. A decisao vive
    // em doctorTunnelLine (pura, com teste); aqui so busca e formata.
    var tunnelLine = ""
    try {
        var presenceRaw = requireOk(http.get(session.controlUrl + "/v1/presence", authHeader(session.token)))
        tunnelLine = doctorTunnelLine(presenceRaw, identity.deviceId, "")
    } catch (String e) {
        tunnelLine = doctorTunnelLine("", identity.deviceId, e)
    }
    lines.add(tunnelLine)
    if (tunnelLine.startsWith("FALHA")) {
        failed = true
    }

    // 4b. Certificado TLS do operador, quando informado (Fase 9 slice 3
    // parcial). So avisa/checa: nao bloqueia o resto do diagnostico. A
    // decisao vive em doctorTlsLine (pura, com teste).
    if (tlsCertPath.length > 0) {
        var exists = fileExists(tlsCertPath)
        var parseExit = 1
        var checkendExit = 1
        if (exists) {
            try {
                parseExit = process.run("openssl", "x509", "-in", tlsCertPath, "-noout").exitCode
                checkendExit = process.run("openssl", "x509", "-in", tlsCertPath, "-noout", "-checkend", tlsCheckendWindowSec()).exitCode
            } catch (String e) {
                // openssl ausente: sem como julgar — nao inventa FALHA.
                parseExit = 0
                checkendExit = 0
            }
        }
        var tlsLine = doctorTlsLine(tlsCertPath, exists, parseExit, checkendExit)
        lines.add(tlsLine)
        if (tlsLine.startsWith("FALHA")) {
            failed = true
        }
    }

    // 5. Servicos publicados acessiveis + porta local respondendo.
    if (manifestPath.length == 0) {
        manifestPath = defaultManifestPath()
    }
    var raw = readTextOr(manifestPath, "")
    if (raw.length == 0) {
        lines.add(doctorOkLine("manifesto (ausente — pulando checagem de servicos)"))
        return DoctorReport(failed == false, lines)
    }
    var wanted = listOf<ManifestService>()
    try {
        wanted = parseManifest(raw)
    } catch (String e) {
        lines.add(doctorFailLine("manifesto", manifestPath + " invalido (" + e + ")"))
        return DoctorReport(false, lines)
    }
    // Delega a ordem de checagem ao verifyDeployment (mesma do --check:
    // nao publicado -> drift de config -> sem resposta local). Antes o
    // doctor replicava so publicado/resposta e deixava o drift passar em
    // silencio — agora os dois caminhos acusam igual. Sem fetch proprio:
    // o verify lista sozinho e devolve os problemas ja ordenados.
    var problems = verifyDeployment(session.controlUrl, session.token, wanted)
    if (problems.size == 0) {
        for (var service in wanted) {
            lines.add(doctorOkLine(service.name + " publicado e respondendo em " + service.address + ":" + intToString(service.port)))
        }
        return DoctorReport(failed == false, lines)
    }
    for (var problem in problems) {
        lines.add(doctorFailLine("servico", problem))
    }
    return DoctorReport(false, lines)
}

Int cmdDoctor(List<String> args) {
    if (extraPositional(args, 0) || flagMissingValue(args, "--file") || flagDuplicated(args, "--file") || flagMissingValue(args, "--tls-cert") || flagDuplicated(args, "--tls-cert")) {
        println("uso: kof cloud doctor [--file kofcloud.json] [--tls-cert <pem>]")
        return 1
    }
    // Mesma regra do deploy/down: ausente/vazio/so-espacos = manifesto
    // padrao; senao, o valor aparado (resolveManifestPath, em Deploy.kf).
    // Sem isso, `--file "   "` pulava o default no doctorCheck e lia path
    // invalido (reportava "manifesto ausente" em vez do kofcloud.json).
    var file = resolveManifestPath(flagValue(args, "--file"))
    var report = doctorCheckWith(file, flagValue(args, "--tls-cert").trim())
    for (var line in report.lines) {
        println(line)
    }
    if (report.ok) {
        return 0
    }
    println("Hint: corrija o primeiro FALHA acima e rode de novo")
    return 1
}
