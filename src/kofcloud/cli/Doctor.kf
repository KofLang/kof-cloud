package kofcloud.cli

import kofcloud.cli.Commands
import kofcloud.cli.Deploy
import kofcloud.cli.Local
import kofcloud.model.Errors
import kofcloud.model.Device
import kofcloud.util.Limits
import kofcloud.util.Text
import kofcloud.store.Store

// Diagnostico somente-leitura (Fase 7, slice 4): responde "onde quebrou?"
// sem alterar nada — nenhum publish, remove, revoke, token ou escrita.
// Cada checagem retorna "" (ok) ou "motivo" (falha); o comando imprime uma
// linha por checagem e sai 0 so se todas passarem.
//
// Ordem (da maquina para a internet): sessao local -> control plane ->
// edge -> DNS do hostname -> porta local de cada servico do manifesto
// (se houver `kofcloud.json`; sem manifesto, so identidade + plataforma).

record DoctorReport(Bool ok, List<String> lines)

String doctorOkLine(String label) {
    return "ok   " + label
}

String doctorFailLine(String label, String why) {
    return "FALHA " + label + ": " + why
}

// Linha de aviso do doctor: sinaliza sem falhar (exit e o veredito das
// FALHA; rotacao de credencial e rotina, nao outage — mesmo contrato do
// `check: aviso:` do deploy --check). Formato proprio para nunca ser
// confundido com ok/FALHA por quem roda o doctor em script.
String doctorWarnLine(String label, String why) {
    return "AVISO " + label + ": " + why
}

// Linha da camada do tunel a partir do corpo de /v1/presence ja buscado
// (ou do erro da busca): pura, sem rede nem HOME — testavel sem tunel.
// Devolve a linha pronta; "" significa "ok, sessao viva".
// Camada do control plane. Pura: o chamador ja tentou o `/v1/health` e
// passa o corpo (sucesso) ou o erro da tentativa. O health responde 503
// quando o estado em disco e ilegivel (F16 s3), e `http.get` LANCA em >=500
// (medido: "HTTP 503 from <url>") — antes o doctor traduzia isso como
// "inacessivel ou fora do ar", mandando o operador olhar rede/processo
// quando o problema era o ARQUIVO DE ESTADO. Agora 503 nomeia o estado, as
// demais falhas de rede seguem "inacessivel", e um corpo sem `ok` vira
// "resposta inesperada" (nunca verde). Nao carrega conta nem credencial.
String doctorControlLine(String controlUrl, String healthBody, String fetchError) {
    if (fetchError.length > 0) {
        if (fetchError.indexOf("503") >= 0) {
            return doctorFailLine("control plane", controlUrl + " respondeu 503: estado do control ilegivel (o arquivo existe mas nao decodifica) — faca backup e restaure: kof cloud state-backup --file <estado.json>")
        }
        return doctorFailLine("control plane", controlUrl + " inacessivel ou fora do ar (" + fetchError + ")")
    }
    if (healthBody.indexOf("\"ok\"") < 0) {
        return doctorFailLine("control plane", "resposta inesperada de " + controlUrl + "/v1/health")
    }
    return doctorOkLine("control plane (" + controlUrl + ")")
}

String doctorTunnelLine(String presenceRaw, String deviceId, String fetchError) {
    if (fetchError.length > 0) {
        return doctorFailLine("tunel", "presenca indisponivel (" + fetchError + ")")
    }
    if (bodyContainsId(presenceRaw, deviceId)) {
        return doctorOkLine("tunel ativo no Edge (sessao viva)")
    }
    return doctorFailLine("tunel", "sem sessao no Edge — rode: kof cloud connect")
}

// Linha da camada do ciclo de vida do dispositivo, a partir do status ja
// lido da lista (`fetchDevices`). Pura, sem rede nem HOME — testavel sem
// control plane (mesmo padrao de doctorTunnelLine/doctorTlsLine).
//
// O doctor so conferia "registrado": um device REVOGADO recebia
// `ok dispositivo registrado` e, na camada seguinte, a dica
// "rode: kof cloud connect" — que e recusada com DEVICE_REVOKED (fatal).
// Agora REVOKED e FALHA com a orientacao certa (re-registrar; nao ha volta
// por status) e SUSPENDED e FALHA apontando o unsuspend (reversivel).
String doctorDeviceLine(String deviceStatus) {
    if (deviceStatus == "REVOKED") {
        return doctorFailLine("dispositivo", "revogado — o tunel e recusado para sempre (DEVICE_REVOKED); registre de novo: kof cloud login --device <nome>")
    }
    if (deviceStatus == "SUSPENDED") {
        return doctorFailLine("dispositivo", "suspenso — o tunel e recusado; libere com: kof cloud device unsuspend <nome|id>")
    }
    return doctorOkLine("dispositivo registrado (" + deviceStatus + ")")
}

// Linha da camada da auditoria a partir do corpo de /v1/audit/verify ja
// buscado (ou do erro da busca): pura, sem rede nem HOME — testavel sem
// control plane (mesmo padrao de doctorTunnelLine/doctorDeviceLine).
//
// Antes o doctor aprovava "tudo ok" com a trilha de auditoria comprometida
// (cadeia quebrada = adulteracao/remocao; espelho comprometido = trilha
// redundante adulterada) — o operador so descobria rodando `audit --verify`
// por conta própria. Mesma decisao do comando (campos do fio, aditivos:
// control plane antigo sem mirrorOk = "espelho nao reportado", nunca FALHA
// nem mentira "integra"). Sem dado sensivel: so contadores e indices.
String doctorAuditLine(String verifyRaw, String fetchError) {
    if (fetchError.length > 0) {
        return doctorFailLine("auditoria", "verificacao indisponivel (" + fetchError + ")")
    }
    var fields = mapOf<String, String>()
    try {
        fields = json.decode<Map<String, String>>(verifyRaw)
    } catch (String e) {
        return doctorFailLine("auditoria", "resposta inesperada de /v1/audit/verify")
    }
    var events = mapField(fields, "events")
    if (mapField(fields, "ok") == "true") {
        if (mapField(fields, "mirrorOk") == "false") {
            return doctorFailLine("auditoria", "espelho comprometido (quebra em " + mapField(fields, "mirrorBrokenAt") + ") — trilha redundante adulterada; investigue (detalhes: kof cloud audit --verify)")
        }
        var mirror = auditMirrorNote(fields)
        return doctorOkLine("auditoria integra (" + events + " eventos na cadeia" + mirror + ")")
    }
    return doctorFailLine("auditoria", "cadeia quebrada no evento " + mapField(fields, "brokenAt") + " de " + events + " — alguem alterou ou removeu um evento da trilha; investigue antes de confiar nela (detalhes: kof cloud audit --verify)")
}

// Linha da camada da credencial da conta a partir do corpo de /v1/tokens ja
// buscado (ou do erro da busca): pura, sem rede nem HOME — testavel sem
// control plane (mesmo padrao de doctorAuditLine).
//
// O doctor autentica COM o kfc_ e era o unico ativo sem camada propria — a
// sessao podia morrer em dias com diagnostico todo verde. Aqui o doctor le o
// MESMO sinal do fio que o `token list` (campo aditivo `expiring`, fonte
// unica `nearAccountTokenExpiry` no control plane): nunca re-deriva com
// relogio proprio. Leitura por substring e honesta aqui porque o fio e um
// vetor plano de objetos planos e o sinal e uma chave literal com valor
// literal; evita `json.decode<List<Map<...>>>`, que a stdlib nao suporta
// (JSN004: colecoes aninhadas — descoberto ao compilar esta camada). Mesma
// decisao do PEM (30 dias): expira em breve = FALHA com a acao — e a janela
// citada vem do mesmo Limits do aviso do CLI. Contagem por ocorrencia do
// sinal; o valor do kfc_ nunca aparece (so o contador).
String doctorAccountTokenLine(String tokensRaw, String fetchError) {
    if (fetchError.length > 0) {
        return doctorFailLine("credencial", "inventario indisponivel (" + fetchError + ")")
    }
    var expiring = countTokenExpiring(tokensRaw)
    if (expiring < 0) {
        return doctorFailLine("credencial", "resposta inesperada de /v1/tokens")
    }
    if (expiring > 0) {
        var hours = intToString((limitTokenExpiryWarnMs() / 3600000L) as Int)
        return doctorFailLine("credencial", intToString(expiring) + " credencial(is) expiram em menos de " + hours + "h — rode: kof cloud token rotate --ttl <horas>")
    }
    return doctorOkLine("credencial da conta (sem expiracao proxima)")
}

// Nota do espelho para a linha ok da auditoria: "" quando integra,
// " — espelho nao reportado" contra control plane antigo (campos aditivos
// no fio). Espelho adulterado nao passa por aqui — vira FALHA dedicada na
// `doctorAuditLine`. Pura.
String auditMirrorNote(Map<String, String> fields) {
    var mirrorOk = mapField(fields, "mirrorOk")
    if (mirrorOk == "true") {
        return ""
    }
    if (mirrorOk == "false") {
        return " — ESPELHO COMPROMETIDO"
    }
    return " — espelho nao reportado (control plane antigo)"
}

// Linha da camada TLS a partir do resultado de `openssl x509` ja executado
// (pura, sem rede nem HOME): "" quando nao ha `--tls-cert` (nada a checar).
// Distingue arquivo ausente, PEM invalido e expiracao em 30 dias — o
// caminho aparece na mensagem, o conteudo do PEM nunca.
String doctorTlsLine(String certPath, Bool exists, Int parseExit, Int checkendExit) {
    return doctorTlsLineFor(certPath, exists, parseExit, checkendExit, "", "", listOf<String>())
}

// Versao com cobertura de host: recebe as saidas de `openssl x509` (SAN e
// subject) e os hostnames que o PEM PRECISA cobrir (os servicos do
// manifesto). Antes a camada TLS so olhava formato e validade — um PEM
// valido de OUTRO dominio passava no `doctor` e o HTTPS so quebrava em
// producao, no handshake. `domainCertLine` ja julgava isso no
// `domain verify --tls-cert`; aqui a mesma decisao vale para os hostnames
// do manifesto (a regra de cobertura em `certHostVerdict`, uma so).
//
// `sanOut` vazio + `parseExit == 0` significa que o openssl nao foi
// consultado (chamador antigo sem cobertura): nesse caso so valida formato.
String doctorTlsLineFor(String certPath, Bool exists, Int parseExit, Int checkendExit, String sanOut, String subjectOut, List<String> requiredHosts) {
    if (certPath.length == 0) {
        return ""
    }
    if (exists == false) {
        return doctorFailLine("tls", certPath + " nao encontrado")
    }
    if (parseExit != 0) {
        return doctorFailLine("tls", certPath + " nao e um PEM valido (openssl x509 falhou)")
    }
    if (tlsCertExpiringSoon(checkendExit)) {
        return doctorFailLine("tls", certPath + " expira em menos de 30 dias — renove o PEM")
    }
    if (requiredHosts.size > 0 && sanOut.length > 0) {
        for (var host in requiredHosts) {
            var verdict = certHostVerdict(host, exists, parseExit, sanOut, subjectOut)
            if (verdict.length > 0) {
                return doctorFailLine("tls", certPath + " nao cobre " + host + " — " + verdict)
            }
        }
        return doctorOkLine("tls (" + certPath + ", cobre " + intToString(requiredHosts.size) + " servico(s) e vale por mais de 30 dias)")
    }
    return doctorOkLine("tls (" + certPath + ", valido por mais de 30 dias)")
}

// Hostnames publicos que o PEM precisa cobrir, a partir do manifesto e do
// handle da conta. Puro: sem rede nem HOME. Sem manifesto, lista vazia
// (nada a conferir).
List<String> tlsRequiredHosts(List<ManifestService> services, String handle) {
    var out = listOf<String>()
    if (handle.trim().length == 0) {
        return out
    }
    for (var service in services) {
        var host = serviceHostname(service.name, handle.trim())
        if (out.contains(host) == false) {
            out.add(host)
        }
    }
    return out
}

DoctorReport doctorCheck(String manifestPath) {
    return doctorCheckWith(manifestPath, "")
}

DoctorReport doctorCheckWith(String manifestPath, String tlsCertPath) {
    var lines = listOf<String>()
    var failed = false

    // 1. Identidade/conta local.
    var session = loadSession()
    if (session == null) {
        lines.add(doctorFailLine("login local", notLoggedInLine()))
        return DoctorReport(false, lines)
    }
    var identity = loadIdentity()
    if (identity == null) {
        lines.add(doctorFailLine("login local", notLoggedInLine()))
        return DoctorReport(false, lines)
    }
    lines.add(doctorOkLine("login local (" + identity.handle + "/" + identity.deviceName + ")"))

    // 2. Control plane alcancavel e autenticado.
    var health = ""
    var healthError = ""
    try {
        health = requireOk(http.get(session.controlUrl + "/v1/health", authHeader(session.token)))
    } catch (String e) {
        healthError = e
    }
    var controlLine = doctorControlLine(session.controlUrl, health, healthError)
    lines.add(controlLine)
    if (controlLine.startsWith("FALHA")) {
        return DoctorReport(false, lines)
    }

    // 2a. Ciclo de vida da credencial da conta (Fase 19): o doctor autentica
    // COM o kfc_ mas esta era a unica camada sem olhar para ele — a sessao
    // podia morrer em dias com diagnostico todo verde. A decisao vive em
    // doctorAccountTokenLine (pura, com teste); aqui so busca (o endpoint
    // existe no control plane atual; num antigo a camada reporta
    // "indisponivel", nao inventa ok).
    var tokenLine = ""
    try {
        var tokensRaw = requireOk(http.get(session.controlUrl + "/v1/tokens", authHeader(session.token)))
        tokenLine = doctorAccountTokenLine(tokensRaw, "")
    } catch (String e) {
        tokenLine = doctorAccountTokenLine("", e)
    }
    lines.add(tokenLine)
    if (tokenLine.startsWith("FALHA")) {
        failed = true
    }

    // 3. Dispositivo conhecido pelo control plane.
    var devices = listOf<Device>()
    try {
        devices = fetchDevices(session.controlUrl, session.token)
    } catch (String e) {
        lines.add(doctorFailLine("dispositivo", "nao foi possivel listar devices (" + e + ")"))
        return DoctorReport(false, lines)
    }
    var known = false
    for (var device in devices) {
        if (device.id == identity.deviceId) {
            known = true
        }
    }
    if (known == false) {
        lines.add(doctorFailLine("dispositivo", "este device nao esta registrado — rode: kof cloud login novamente"))
        return DoctorReport(false, lines)
    }
    // Ciclo de vida, nao so registro: REVOKED/SUSPENDED viram FALHA com a
    // dica certa (unsuspend para suspenso; re-registro para revogado) em vez
    // de `ok` seguido de "rode: connect" — que o Edge recusa nos dois casos
    // (DEVICE_SUSPENDED/DEVICE_REVOKED, fatais no Agent).
    var deviceStatus = ""
    for (var device in devices) {
        if (device.id == identity.deviceId) {
            deviceStatus = device.status
        }
    }
    var deviceLine = doctorDeviceLine(deviceStatus)
    lines.add(deviceLine)
    if (deviceLine.startsWith("FALHA")) {
        failed = true
    }

    // 4. Tunel real no Edge (presenca confirmada, nao inferida do processo
    // local): sem sessao viva nao ha rota, mesmo com manifesto ok. Antes
    // dos servicos para rodar tambem sem `kofcloud.json`. A decisao vive
    // em doctorTunnelLine (pura, com teste); aqui so busca e formata.
    var tunnelLine = ""
    try {
        var presenceRaw = requireOk(http.get(session.controlUrl + "/v1/presence", authHeader(session.token)))
        tunnelLine = doctorTunnelLine(presenceRaw, identity.deviceId, "")
    } catch (String e) {
        tunnelLine = doctorTunnelLine("", identity.deviceId, e)
    }
    lines.add(tunnelLine)
    if (tunnelLine.startsWith("FALHA")) {
        failed = true
    }

    // 4a. Integridade da trilha de auditoria (Fase 19 slice 4): cadeia
    // quebrada ou espelho comprometido viram FALHA com orientacao — mesma
    // decisao do `audit --verify`, pura em doctorAuditLine (com teste); aqui
    // so busca (o endpoint existe no control plane atual; num antigo ele
    // falha e a camada reporta "indisponivel", nao inventa ok).
    var auditLine = ""
    try {
        var verifyRaw = requireOk(http.get(session.controlUrl + "/v1/audit/verify", authHeader(session.token)))
        auditLine = doctorAuditLine(verifyRaw, "")
    } catch (String e) {
        auditLine = doctorAuditLine("", e)
    }
    lines.add(auditLine)
    if (auditLine.startsWith("FALHA")) {
        failed = true
    }

    // 4b. Certificado TLS do operador, quando informado (Fase 9 slice 3
    // parcial). So avisa/checa: nao bloqueia o resto do diagnostico. A
    // decisao vive em doctorTlsLine (pura, com teste).
    if (tlsCertPath.length > 0) {
        var exists = fileExists(tlsCertPath)
        var parseExit = 1
        var checkendExit = 1
        var sanOut = ""
        var subjectOut = ""
        if (exists) {
            try {
                parseExit = process.run("openssl", "x509", "-in", tlsCertPath, "-noout").exitCode
                checkendExit = process.run("openssl", "x509", "-in", tlsCertPath, "-noout", "-checkend", tlsCheckendWindowSec()).exitCode
                if (parseExit == 0) {
                    sanOut = process.run("openssl", "x509", "-in", tlsCertPath, "-noout", "-ext", "subjectAltName").stdout
                    subjectOut = process.run("openssl", "x509", "-in", tlsCertPath, "-noout", "-subject").stdout
                }
            } catch (String e) {
                // openssl ausente: sem como julgar — nao inventa FALHA.
                parseExit = 0
                checkendExit = 0
            }
        }
        // Hostnames do manifesto: o PEM precisa cobri-los, nao so estar
        // valido. Manifesto ausente/invalido nao falha aqui — a checagem
        // dele tem camada propria mais abaixo; aqui e so "o que cobrir".
        var requiredHosts = listOf<String>()
        var peek = loadManifestFile(manifestPath)
        if (peek.ok) {
            requiredHosts = tlsRequiredHosts(peek.services, session.handle)
        }
        var tlsLine = doctorTlsLineFor(tlsCertPath, exists, parseExit, checkendExit, sanOut, subjectOut, requiredHosts)
        lines.add(tlsLine)
        if (tlsLine.startsWith("FALHA")) {
            failed = true
        }
    }

    // 5. Servicos publicados acessiveis + porta local respondendo.
    if (manifestPath.length == 0) {
        manifestPath = defaultManifestPath()
    }
    var raw = readTextOr(manifestPath, "")
    if (raw.length == 0) {
        lines.add(doctorOkLine("manifesto (ausente — pulando checagem de servicos)"))
        return DoctorReport(failed == false, lines)
    }
    var wanted = listOf<ManifestService>()
    try {
        wanted = parseManifest(raw)
    } catch (String e) {
        lines.add(doctorFailLine("manifesto", manifestPath + " invalido (" + e + ")"))
        return DoctorReport(false, lines)
    }
    // Delega a ordem de checagem ao verifyDeployment (mesma do --check:
    // nao publicado -> drift de config -> sem resposta local). Antes o
    // doctor replicava so publicado/resposta e deixava o drift passar em
    // silencio — agora os dois caminhos acusam igual. Sem fetch proprio:
    // o verify lista sozinho e devolve os problemas ja ordenados.
    var problems = verifyDeploymentFor(session.controlUrl, session.token, wanted, identity.deviceId)
    // Aviso de kfs_ perto do fim (Fase 19, mesma fonte do --check): linha
    // "aviso" no doctor — nunca FALHA nem exit 1. Antes das linhas ok: o
    // operador que le "ok site publicado e respondendo" tambem le o que
    // vai derruba-lo em breve. Melhor-esforco: sem lista, sem aviso.
    var now = longToString(time.now())
    for (var warn in kfsExpiryWarningsFor(session.controlUrl, session.token, wanted, identity.deviceId, now)) {
        lines.add(doctorWarnLine("servico", warn))
    }
    if (problems.size == 0) {
        for (var service in wanted) {
            lines.add(doctorOkLine(service.name + " publicado e respondendo em " + service.address + ":" + intToString(service.port)))
        }
        return DoctorReport(failed == false, lines)
    }
    for (var problem in problems) {
        lines.add(doctorFailLine("servico", problem))
    }
    return DoctorReport(false, lines)
}

Int cmdDoctor(List<String> args) {
    if (extraPositional(args, 0) || flagMissingValue(args, "--file") || flagDuplicated(args, "--file") || flagMissingValue(args, "--tls-cert") || flagDuplicated(args, "--tls-cert")) {
        println("uso: kof cloud doctor [--file kofcloud.json] [--tls-cert <pem>]")
        return 1
    }
    // Mesma regra do deploy/down: ausente/vazio/so-espacos = manifesto
    // padrao; senao, o valor aparado (resolveManifestPath, em Deploy.kf).
    // Sem isso, `--file "   "` pulava o default no doctorCheck e lia path
    // invalido (reportava "manifesto ausente" em vez do kofcloud.json).
    var file = resolveManifestPath(flagValue(args, "--file"))
    var report = doctorCheckWith(file, flagValue(args, "--tls-cert").trim())
    for (var line in report.lines) {
        println(line)
    }
    if (report.ok) {
        return 0
    }
    println("Hint: corrija o primeiro FALHA acima e rode de novo")
    return 1
}
