package kofcloud.protocol

import kofcloud.protocol.Bytes
import kofcloud.util.Limits

// Acumula bytes e extrai frames delimitados por \n.
//
// Conn.receive() devolve "o que chegou", sem respeitar fronteiras de frame.
// O LineCodec guarda o resto parcial entre chamadas, de modo que um frame
// partido em dois receives e remontado corretamente.

class LineCodec {
    String pending
    Bool overflow

    constructor() {
        this.pending = ""
        this.overflow = false
    }

    void feed(Byte[] chunk) {
        if (this.overflow) {
            return
        }
        this.pending = this.pending + bytesToString(chunk)
        if (this.pending.length > maxTunnelLineBytes()) {
            // Linha gigante sem terminador: descarta e trava em overflow.
            // Quem le derruba a conexao (fail-closed) — um peer que manda
            // isso e hostil ou esta corrompido.
            this.pending = ""
            this.overflow = true
        }
    }

    // True quando algum feed estourou o teto (a conexao deve cair).
    Bool overflowed() {
        return this.overflow
    }

    // Proximo frame completo, ou "" quando ainda nao ha um.
    // Um frame valido nunca e vazio (todo frame e um objeto JSON), entao ""
    // significa "sem linha completa".
    String nextLine() {
        var index = this.pending.indexOf("\n")
        if (index < 0) {
            return ""
        }
        var line = this.pending.substring(0, index)
        this.pending = this.pending.substring(index + 1)
        return line
    }

    Bool hasLine() {
        return this.pending.indexOf("\n") >= 0
    }

    String remainder() {
        return this.pending
    }
}
