package kofcloud.protocol

import kofcloud.protocol.Frame
import kofcloud.protocol.Tunnel
import kofcloud.model.Service
import kofcloud.util.Limits

// Estado de uma sessao de tunel: multiplexacao de streams sobre uma conexao.
//
// IMPORTANTE: esta classe NAO guarda o Conn. Em Kof, Conn nao e uma classe
// emitida — usar Conn como campo de classe ou como tipo de retorno de spawn
// quebra em runtime (NoClassDefFoundError: KofRuntime$NetConn). O Conn vive
// como parametro/captura de closure em quem faz o I/O; o estado compartilhado
// entre tasks vive aqui, em canais e mapas (tipos reais).

class TunnelSession {
    String sessionId
    String deviceId
    String accountId
    String sessionKey
    Map<String, Channel<String>> inboxes
    Channel<String> outbox
    Int nextStreamId
    Int maxStreams
    Bool open
    // Ultima atividade util (ms): qualquer frame nao-PING recebido. O PING
    // de heartbeat nao conta — senao o tunel nunca seria ocioso por definicao
    // (ver handleTunnelFrame: so DATA/END/RESET/OPEN/STATUS atualizam).
    Long lastActivityMs
    // Streams com primeiro byte ha mais de idleStreamMs sem END sao
    // encerrados com RESET (nao derrubam a sessao).
    Map<String, Long> streamStartedMs

    // Servicos que este Agent serve NESTA sessao, por nome. Vive aqui (e nao
    // num Map capturado por spawn) porque Map passado como argumento de task
    // e copiado por valor: o refresher atualiza e o handler do OPEN precisa
    // ver a mesma tabela. Objeto compartilhado = visao unica.
    Map<String, Service> servicesByName

    constructor(sessionId: String, deviceId: String, accountId: String, sessionKey: String) {
        this.sessionId = sessionId
        this.deviceId = deviceId
        this.accountId = accountId
        this.sessionKey = sessionKey
        this.inboxes = mapOf()
        this.outbox = channel<String>()
        this.nextStreamId = 1
        this.maxStreams = limitStreams()
        this.open = true
        this.lastActivityMs = time.now()
        this.streamStartedMs = mapOf()
        this.servicesByName = mapOf()
    }

    // Troca atomica da tabela (hot-reload): limpa e preenche. Streams em voo
    // usam inboxes proprias e nao sao afetados; o proximo OPEN ja ve o novo.
    void setServices(List<Service> services) {
        var fresh = mapOf()
        for (var service in services) {
            fresh.put(service.name, service)
        }
        this.servicesByName = fresh
    }

    Service? serviceNamed(String name) {
        return this.servicesByName.get(name)
    }

    void setMaxStreams(Int limit) {
        this.maxStreams = limit
    }

    // Sem vaga: o chamador devolve 429 (Edge) ou RESET LIMIT_EXCEEDED (Agent).
    Bool atCapacity() {
        return this.inboxes.size >= this.maxStreams
    }

    // Abre um stream e devolve seu id opaco; "" quando a sessao esta no limite.
    String openStream() {
        if (this.atCapacity()) {
            return ""
        }
        var id = "" + this.nextStreamId
        this.nextStreamId = this.nextStreamId + 1
        this.inboxes.put(id, channel<String>())
        this.streamStartedMs.put(id, time.now())
        this.touch()
        return id
    }

    // Registra um stream com id atribuido pelo peer (lado que recebe OPEN).
    void registerStream(String streamId) {
        this.inboxes.put(streamId, channel<String>())
        this.streamStartedMs.put(streamId, time.now())
    }

    void closeStream(String streamId) {
        this.inboxes.remove(streamId)
        this.streamStartedMs.remove(streamId)
    }

    Bool hasStream(String streamId) {
        return this.inboxes.get(streamId) != null
    }

    Int streamCount() {
        return this.inboxes.size
    }

    // Marca atividade util. O PING/PONG de heartbeat NAO chama touch de
    // proposito: heartbeat prova que o TCP esta vivo, nao que ha trabalho.
    void touch() {
        this.lastActivityMs = time.now()
    }

    Long idleMs() {
        return time.now() - this.lastActivityMs
    }

    // Streams com primeiro byte ha mais de `idleMs` sem END: devolve os ids.
    // O chamador envia RESET e fecha (nao derruba a sessao).
    List<String> idleStreams(Long idleMs) {
        var out = listOf<String>()
        var now = time.now()
        for (var streamId in this.streamStartedMs.keys()) {
            var started = this.streamStartedMs.get(streamId)
            if (started != null && now - started > idleMs) {
                out.add(streamId)
            }
        }
        return out
    }

    // Entrega um item (payload base64 ou marcador) ao stream.
    void deliver(String streamId, String item) {
        var inbox = this.inboxes.get(streamId)
        if (inbox != null) {
            inbox.send(item)
        }
    }

    // Proximo item da inbox do stream; bloqueia ate haver um.
    String nextFromStream(String streamId) {
        var inbox = this.inboxes.get(streamId)
        if (inbox == null) {
            return streamResetMarker()
        }
        return inbox.receive()
    }

    // Enfileira um frame para o escritor do tunel drenar.
    void send(Map<String, String> frame) {
        this.outbox.send(encodeFrame(frame))
    }

    void sendRaw(String encodedFrameLine) {
        this.outbox.send(encodedFrameLine)
    }

    void close() {
        this.open = false
        this.outbox.send(streamCloseMarker())
    }
}
