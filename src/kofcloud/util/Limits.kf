package kofcloud.util

// Limites do KofCloud. Configuraveis por kof.config/env
// (KOF_KOFCLOUD_LIMITS_DEVICES, KOF_KOFCLOUD_LIMITS_SERVICES,
//  KOF_KOFCLOUD_LIMITS_STREAMS, KOF_KOFCLOUD_LIMITS_HTTPREQUESTS,
//  KOF_KOFCLOUD_LIMITS_HTTPWINDOWMS, KOF_KOFCLOUD_LIMITS_FREEZEMARKS).
//
// Protegem as duas pontas: a infraestrutura KofCloud e a maquina do usuario.
// O que e aplicado hoje: dispositivos ativos por conta, servicos por
// dispositivo, streams simultaneos por tunel, requisicoes por hostname no
// Edge, bytes por frame DATA no tunel, conexoes simultaneas por servico
// (429 KCF108 antes do OPEN), idle timeout de tunel/stream (IDLE_TIMEOUT),
// tamanho do anel de auditoria e de incidentes, o teto das marcas de freeze
// (poda inertes, nunca recusa containment) e o teto do cabecalho da
// sonda de health.

Int deviceLimitFrom(Int configured) {
    if (configured <= 0) {
        return 5
    }
    return configured
}

Int limitDevices() {
    return deviceLimitFrom(config.int("kofcloud.limits.devices", 5))
}

Int serviceLimitFrom(Int configured) {
    if (configured <= 0) {
        return 10
    }
    return configured
}

Int limitServices() {
    return serviceLimitFrom(config.int("kofcloud.limits.services", 10))
}

// Streams simultaneos por tunel. Fonte pura para o recuo ser provavel em
// teste (a config vem do ambiente do processo — precedente
// `serviceConnLimitFrom`): zero/negativo recai no default porque aqui zero
// NAO significa "sem limite" — e o MAXIMO de streams abertos, entao 0 faz
// `atCapacity()` responder sempre verdade e TODO OPEN ser recusado (429 no
// Edge, RESET LIMIT_EXCEEDED no Agent): um typo na config tirava o relay do
// ar inteiro em silencio.
Int streamLimitFrom(Int configured) {
    if (configured <= 0) {
        return 128
    }
    return configured
}

Int limitStreams() {
    return streamLimitFrom(config.int("kofcloud.limits.streams", 128))
}

// Profundidade da fila de entrada POR STREAM (itens ainda nao consumidos).
// Os canais do Kof sao ilimitados (medido: `Channel` so tem send/receive, sem
// trySend nem close), entao sem contador explicito um stream cujo consumidor
// esta lento acumula memoria sem teto — e um servico local que devolve
// gigabytes derruba o Agent inteiro. Fila cheia -> RESET LIMIT_EXCEEDED
// naquele stream, nunca bloqueio do leitor do tunel (que pararia TODOS os
// streams: exatamente a monopolizacao que o desenho proibe).
Int limitQueueDepth() {
    var depth = config.int("kofcloud.limits.queueDepth", 64)
    if (depth <= 0) {
        return 64
    }
    return depth
}

// Teto de bytes uteis por frame DATA (antes do base64). Quem envia fatia;
// quem recebe recusa a linha inteira acima de ~4/3 disso (margem do base64).
// Protege os dois lados contra um peer que manda uma linha gigante de uma
// vez (o LineCodec acumularia sem teto).
//
// Recuo em fonte pura (precedentes `serviceConnLimitFrom`/`publicConnLimitFrom`):
// zero/invalido recai no default porque com 0 os dois lados do fio
// DESACORDAM — o remetente continua mandando blocos de sendChunkBytes (o
// clamp so age com cap > 0) enquanto o receptor recusa linha acima de
// 0*2+4096 = 4096 bytes: o relay quebra no meio, silencioso. Nao e kill
// switch (um desligamento deliberado de DATA recusaria frames, nao
// dessincronizaria os peers) e nada documenta 0 como intencao aqui.
Int frameLimitFrom(Int configured) {
    if (configured <= 0) {
        return 1048576
    }
    return configured
}

Int limitFrameBytes() {
    return frameLimitFrom(config.int("kofcloud.limits.frameBytes", 1048576))
}

// Bloco de envio de cada frame DATA. Bem menor que o teto: blocos pequenos
// chegam mais cedo (time-to-first-byte), usam menos memoria por frame e,
// sobre tudo, evitam o custo O(n^2) de `bytesToString` em blocos grandes
// (medido: ~1 s para 100 KiB em bytesToBase64; o custo total e n*tamanho —
// ver 17-limitations). O teto (limitFrameBytes) continua valendo na recepcao.
// ver 17-limitations). O teto (limitFrameBytes) continua valendo na recepcao.
//
// Ociosidade maxima sem frames uteis (nao-PING) antes de derrubar a sessao
// (ms). Heartbeat sozinho nao renova: tunel parado e tunel morto para fins
// de roteamento — o Agent reconecta sozinho e o Edge limpa a rota.
//
// Recuo em fonte pura (familia deviceLimitFrom et al.): zero/invalido recai
// no default porque 0 nao e "nunca derruba" — e derruba TUDO: o sweep compara
// `idleMs() > limite`, entao com 0 todo tunel quieto cai 1 ms apos o touch e
// o upstreamWaitMs do Edge (herdado deste valor) zera a espera de resposta
// (todo proxy devolve 504). Nada documenta 0 como intencao aqui.
Int tunnelIdleMsFrom(Int configured) {
    if (configured <= 0) {
        return 120000
    }
    return configured
}

Int limitTunnelIdleMs() {
    return tunnelIdleMsFrom(config.int("kofcloud.limits.tunnelIdleMs", 120000))
}

// Vida maxima de um stream sem END (ms): stream preso (peer que abre e some
// no meio do DATA) e encerrado com RESET sem derrubar a sessao.
//
// Recuo em fonte pura pelo mesmo motivo: com 0 o primeiro sweep RESETA todo
// stream aberto (idleStreams compara `ocioso > limite`) — o servico para de
// responder na hora, com o tunel "vivo". Zero nunca foi kill switch.
Int streamIdleMsFrom(Int configured) {
    if (configured <= 0) {
        return 30000
    }
    return configured
}

Int limitStreamIdleMs() {
    return streamIdleMsFrom(config.int("kofcloud.limits.streamIdleMs", 30000))
}

// Intervalo do heartbeat do tunel (PING/PONG, ms). Fonte unica: o Edge
// anuncia no WELCOME e no /v1/connect, e o Agent recai no mesmo valor
// quando o fio vem sem heartbeat valido. Mesmo valor nos tres pontos.
//
// Recuo em fonte pura: com 0/negativo o pinger vira `time.sleep(0)` e
// martela PING sem parar (busy-loop que torra CPU nos dois lados). Nada
// documenta 0 como intencao aqui — zerado recai no default, como os irmaos.
Int heartbeatMsFrom(Int configured) {
    if (configured <= 0) {
        return 15000
    }
    return configured
}

Int limitHeartbeatMs() {
    return heartbeatMsFrom(config.int("kofcloud.limits.heartbeatMs", 15000))
}

// Passo da varredura de ociosidade (ms): Edge e Agent verificam a cada
// passo se a sessao passou do idle ou se ha streams presos. Fonte unica
// para os dois sweepers varrerem no mesmo ritmo.
//
// Recuo em fonte pura: com 0/negativo o sweeper vira `time.sleep(0)` e gira
// sem parar (busy-loop). Zerado recai no default.
Int idleSweepMsFrom(Int configured) {
    if (configured <= 0) {
        return 5000
    }
    return configured
}

Int limitIdleSweepMs() {
    return idleSweepMsFrom(config.int("kofcloud.limits.idleSweepMs", 5000))
}

// Passo da varredura periodica de credenciais vencidas (ms): o serve
// reaproveita SOZINHO o que a poda preguicosa deixou para tras (conta
// ociosa acumula kfs_/kfc_ vencidos sem sinal ate alguem validar).
//
// Recuo em fonte pura (familia `idleSweepMsFrom`): com 0/negativo o laco
// viraria `time.sleep(0)` e giraria sem parar. Zerado recai no default.
Int expirySweepMsFrom(Int configured) {
    if (configured <= 0) {
        return 60000
    }
    return configured
}

Int limitExpirySweepMs() {
    return expirySweepMsFrom(config.int("kofcloud.limits.expirySweepMs", 60000))
}

// Intervalo do health check local do Agent (ms): a cada passo o Agent
// reconecta TCP nos servicos e reporta mudanca ao Edge; o refresher da
// tabela re-busca os servicos a cada 6 passos. Fonte unica para que o
// ciclo de health e o de refresh andem juntos.
//
// Recuo em fonte pura: com 0/negativo o laco de health vira `time.sleep(0)`
// e sonda os servicos locais sem parar (busy-loop). O refresh e derivado
// (`limitRefreshMs(healthMs)`), entao o piso aqui tambem protege o refresh.
// Zerado recai no default.
Int healthMsFrom(Int configured) {
    if (configured <= 0) {
        return 5000
    }
    return configured
}

Int limitHealthMs() {
    return healthMsFrom(config.int("kofcloud.limits.healthMs", 5000))
}

// Prazo de UMA checagem de health do servico local (ms). O `receive` bloqueia
// e o Kof nao tem recv com prazo (L3): o deadline e uma task que fecha a
// conexao depois do prazo, e o receive em voo lanca (medido: "Socket
// closed"). Tem que caber folgado no ciclo do health — um servico lento nao
// pode atrasar a checagem dos outros. Zerado/invalido recai no default.
Int limitHealthTimeoutMs() {
    var ms = config.int("kofcloud.limits.healthTimeoutMs", 2000)
    if (ms <= 0) {
        return 2000
    }
    return ms
}

// Intervalo do refresher da tabela de servicos (ms): re-busca os servicos
// via /v1/connect e troca a tabela DA SESSAO. Por desenho e 6x o health —
// os dois ciclos andam juntos; health zerado/invalido recai no default.
// Fonte unica para o spawn (connectAndServe) e o fallback dentro do
// refresher — sem isso o `* 6` do chamador e o `30000` do fallback
// andariam separados.
Int limitRefreshMs(Int healthMs) {
    if (healthMs <= 0) {
        healthMs = limitHealthMs()
    }
    return healthMs * 6
}

Int sendChunkBytes() {
    var size = config.int("kofcloud.limits.sendChunkBytes", 16384)
    if (size <= 0) {
        size = 16384
    }
    var cap = limitFrameBytes()
    if (cap > 0 && size > cap) {
        size = cap
    }
    return size
}

// Teto de uma linha do protocolo de tunel (frame JSON + base64). O base64
// do stdlib passa por String (UTF-8): bytes altos expandem ate ~2x, entao o
// teto usa 2x + margem do envelope JSON. Quem ultrapassar tem a conexao
// derrubada (fail-closed) — um peer que manda linha gigante e hostil ou
// esta corrompido, e o LineCodec nao deve acumular sem teto.
Int maxTunnelLineBytes() {
    return limitFrameBytes() * 2 + 4096
}

// Requisicoes publicas por hostname e por janela no Edge (abuse prevention).
// O Edge TCP nao expoe o IP de origem (sem `peer` em Conn), entao a chave e
// o Host solicitado — que e exatamente o que o abuso (varredura de hostnames,
// forca bruta em AUTHENTICATED) rotaciona menos.
//
// Recuo seguro, com fonte pura para o teste poder prova-lo (a config vem do
// ambiente do processo — precedentes `serviceConnLimitFrom`/
// `streamLimitFrom`): zero/negativo recai no default porque cota ZERO no
// `security.rateLimit` recusa o PRIMEIRO pedido e todos os seguintes — todo
// hostname ficaria em 429 KCF107 para sempre, a borda inteira fora do ar por
// um typo na config.
Int httpRequestLimitFrom(Int configured) {
    if (configured <= 0) {
        return 100
    }
    return configured
}

Int limitHttpRequests() {
    return httpRequestLimitFrom(config.int("kofcloud.limits.httpRequests", 100))
}

Int limitHttpWindowMs() {
    return config.int("kofcloud.limits.httpWindowMs", 60000)
}

// Recuo anunciado no `Retry-After` do 429 (segundos) quando a janela do rate
// limit vem zerada/invalida. Fonte unica do `EdgeState.httpRetryAfterSec()` —
// sem isso, o recuo duplicava a semantica da janela default (60 s) como
// literal solto. Afinavel por config mas sem recuo silencioso: zerado ou
// negativo recai no default (429 sem Retry-After util quebraria o cliente
// honesto mais do que o abusivo).
Int limitHttpRetryAfterSec() {
    return config.int("kofcloud.limits.httpRetryAfterSec", 60)
}

// Converte a janela do rate limit de milissegundos (a unidade da config e do
// `Retry-After`) para SEGUNDOS, que e a unidade de `security.rateLimit`.
// Fonte unica: antes o Edge passava `httpWindowMs` direto, e o default de
// 60000 ms virava uma janela de 60000 SEGUNDOS (~16,7 h) — um hostname que
// batesse no limite ficava fora do ar o resto do dia, e 101 requisicoes
// bastavam para causar isso. Medido com o CLI 0.6.3 (janela 1 volta em ~1 s;
// janela 1000 segue barrada apos 1,3 s).
// Arredonda para cima (nunca para baixo): janela curta demais recusaria menos
// que o configurado. Zero/negativo recai no default em segundos, pela mesma
// regra de recuo do `Retry-After` — `security.rateLimit` com janela <= 0
// devolve false e bloqueia tudo para sempre.
Int httpWindowSeconds(Int windowMs) {
    if (windowMs <= 0) {
        var fallback = limitHttpRetryAfterSec()
        if (fallback <= 0) {
            fallback = 60
        }
        return fallback
    }
    var seconds = windowMs / 1000
    if (windowMs % 1000 > 0) {
        seconds = seconds + 1
    }
    if (seconds <= 0) {
        seconds = 1
    }
    return seconds
}

// Tentativas de /v1/login por handle numa janela, antes de recusar com 429.
// O Edge tem rate limit por hostname, mas o LOGIN acontece no control plane,
// que nao tinha nenhum: uma senha podia ser testada sem limite por uma
// conexao local (ou por quem alcanca o control). A chave e o handle (o
// control plane nao expoe o IP de origem em `web.app()`); isso protege a
// conta de forca bruta dirigida, que e o ataque que importa aqui.
// Recuo seguro: zerado/invalido cai no default.
Int limitLoginAttempts() {
    var n = config.int("kofcloud.limits.loginAttempts", 10)
    if (n <= 0) {
        return 10
    }
    return n
}

Int limitLoginWindowMs() {
    var ms = config.int("kofcloud.limits.loginWindowMs", 60000)
    if (ms <= 0) {
        return 60000
    }
    return ms
}

// Conexoes publicas SIMULTANEAS aceitas pelo Edge (uma task por conexao).
// docs/10-edge.md prometia 1024 com 503; nao existia teto nenhum — cada
// accept criava uma task sem limite, entao uma rajada de conexoes abertas e
// ociosas (slowloris) consumia uma task e um socket por conexao ate a
// exaustao da maquina. Excedeu -> 503 KCF117 + fecha, antes de ler o pedido.
// Contagem aproximada sob corrida (check-then-act sem lock, L3): erra por
// poucas unidades, nunca recusa a menos nem trava.
//
// Recuo em fonte pura para o teste poder prova-lo (a config vem do ambiente
// do processo — precedentes `serviceConnLimitFrom`/`streamLimitFrom`/
// `httpRequestLimitFrom`/`httpBodyLimitFrom`): zero/negativo recai no default
// porque o teto conta conexoes em aberto — com 0, o PRIMEIRO accept ja seria
// recusado com 503 KCF117 e a borda nunca atenderia ninguem. O ramo era
// inline e correto, mas inalcançavel em teste (o `<= 0` nunca roda) — a
// extração o torna provável por mutação.
Int publicConnLimitFrom(Int configured) {
    if (configured <= 0) {
        return 1024
    }
    return configured
}

Int limitPublicConns() {
    return publicConnLimitFrom(config.int("kofcloud.limits.publicConns", 1024))
}

// Conexoes publicas simultaneas EM RELAY por servico (o recurso caro: tunel
// + servico local). Excedeu -> 429 KCF108 com Retry-After, ANTES de abrir
// stream. Contagem aproximada sob corrida extrema (check-then-act sem lock;
// o Kof nao expoe mutex — ver 17-limitations.md L3): pode estourar em poucas
// unidades, nunca falhar fechado nem travar. O rate limit (atomico) segura
// o volume; este segura a profundidade.
//
// Recuo seguro, com fonte pura para o teste poder prova-lo (o fallback
// inline nao e alcancavel em teste: a config vem do ambiente do processo —
// precedente `httpWindowSeconds`). Zero/negativo recai no default porque
// aqui zero NAO significa "sem limite": o teto e o MAXIMO de conexoes em
// aberto, entao `0` faz `tryAcquireServiceConn` recusar TODO relay com
// 429 KCF108 (0 >= 0 e sempre verdade) — um typo na config tirava todos os
// servicos do ar em silencio.
Int serviceConnLimitFrom(Int configured) {
    if (configured <= 0) {
        return 64
    }
    return configured
}

Int limitServiceConns() {
    return serviceConnLimitFrom(config.int("kofcloud.limits.serviceConns", 64))
}

// Teto do corpo de uma requisicao publica (bytes). Excedeu -> 413 KCF110,
// recusado no Edge ANTES do relay (nao consome stream nem toca no Agent).
// Protege a maquina do usuario de uploads que ela nao pediu para aceitar.
//
// Recuo seguro, com fonte pura para o teste poder prova-lo (a config vem do
// ambiente do processo — precedentes `serviceConnLimitFrom`/
// `streamLimitFrom`/`httpRequestLimitFrom`): zero/negativo recai no default
// porque o teto compara `declared > bodyLimit` — com 0, TODO pedido com
// corpo vira 413 KCF110 e nenhum upload/formulario passa (so GET sem corpo
// escapa): outage parcial silencioso por um typo na config.
Int httpBodyLimitFrom(Int configured) {
    if (configured <= 0) {
        return 1048576
    }
    return configured
}

Int limitHttpBodyBytes() {
    return httpBodyLimitFrom(config.int("kofcloud.limits.httpBodyBytes", 1048576))
}

// Teto do `agent.log` e do `agent-runtime.log` locais (bytes). Append que
// estourar corta o inicio (linhas inteiras, via trimLogHead) em vez de
// crescer sem limite: log local de diagnostico, nao trilha de auditoria
// (essa vive no control plane, em anel de 100). Default folgado para
// sessoes longas de connect.
//
// Recuo em fonte pura: com 0/negativo o `trimLogHead` devolve o texto sem
// cortar (`maxBytes <= 0` = sem teto) e os DOIS logs crescem sem limite —
// disco cheio e o processo do Agent morre numa escrita. Zero nunca foi
// "sem log": a saida continua no stdout.
Int logBytesFrom(Int configured) {
    if (configured <= 0) {
        return 262144
    }
    return configured
}

Int limitLogBytes() {
    return logBytesFrom(config.int("kofcloud.limits.logBytes", 262144))
}

// Teto do corpo HTTP que o Edge aceita/acumula no relay (bytes). Fonte
// unica: o `serve` passa ao HttpFront/relay; sem isso o config default e
// o fallback do parse andariam separados. Afinavel por config mas sem recuo
// silencioso: zero/negativo recaem no default (com 0 todo pedido com corpo
// viraria 413 KCF110 — a mesma classe de outage dos tetos de capacidade).
// Fonte pura para o recuo ser provavel em teste (mesma receita da familia).
Int maxBodyLimitFrom(Int configured) {
    if (configured <= 0) {
        return 16777216
    }
    return configured
}

Int limitMaxBodyBytes() {
    return maxBodyLimitFrom(config.int("kofcloud.maxBodyBytes", 16777216))
}

// Teto da resposta do servico local que o Edge acumula por requisicao
// (bytes). Excedeu -> 502 KCF115 e o stream e cancelado (RESET), para o
// Agent parar de empurrar bytes. Fonte unica do `maxResponseBytes` do relay
// (os 16 MiB de `limitMaxBodyBytes` sao o teto do CORPO da REQUISICAO; antes,
// a resposta herdava esse numero e, ao passar dele, era cortada em silencio).
// Sem recuo silencioso: zero/negativo recaem no default (com 0 toda resposta
// com corpo viraria 502 KCF115). Fonte pura para o recuo ser provavel em
// teste (mesma receita da familia).
Int maxResponseLimitFrom(Int configured) {
    if (configured <= 0) {
        return 16777216
    }
    return configured
}

Int limitMaxResponseBytes() {
    return maxResponseLimitFrom(config.int("kofcloud.maxResponseBytes", 16777216))
}

// Teto do corpo que o WAF inspeciona por assinatura (bytes). Acima disso o
// corpo NAO e varrido (o teto de corpo do Edge, `httpBodyBytes` 1 MiB, e outro
// limite). Fonte unica do `wafBodyInspectBytes()` em `util.Text` — 64 KiB
// cobre formularios e JSON de API sem varrer uploads grandes a cada request.
// Afinavel por config mas NAO recai em default quando zerado: teto zerado
// desliga a inspecao de corpo (fail-open do detectar), nao vira 64 KiB.
Int limitWafBodyInspectBytes() {
    return config.int("kofcloud.limits.wafBodyInspectBytes", 65536)
}

// Base e teto do backoff exponencial de reconexao do Agent (ms). Fonte unica
// dos `defaultBackoffBase()`/`defaultBackoffMax()` em `agent/Backoff` — sem
// isso, afinar o ritmo de reconexao exigiria editar o produto, nao a config.
// Afinaveis por config mas sem recuo silencioso: base zerada/negativa recai
// no default (evita loop agressivo de reconexao) e teto abaixo da base recai
// na base (evita `min(base, max)` invertido). Fontes puras para o recuo ser
// provavel em teste (mesma receita da familia de recuo seguro).
Int backoffBaseLimitFrom(Int configured) {
    if (configured <= 0) {
        return 500
    }
    return configured
}

Int limitBackoffBaseMs() {
    return backoffBaseLimitFrom(config.int("kofcloud.limits.backoffBaseMs", 500))
}

Int backoffMaxLimitFrom(Int configured, Int base) {
    if (configured < base) {
        return base
    }
    return configured
}

Int limitBackoffMaxMs() {
    return backoffMaxLimitFrom(config.int("kofcloud.limits.backoffMaxMs", 30000), limitBackoffBaseMs())
}

// Tamanho do anel de auditoria operacional (eventos por control plane).
// Fonte unica do `Registry.audit()` — sem isso, afinar a trilha exigiria
// editar o produto, nao a config. Afinavel por config mas sem recuo
// silencioso: zerado/negativo recai no default (anel desligado perderia a
// trilha de abuso sem avisar; o default 100 cabe em disco e em memoria).
// Fonte pura para o recuo ser provavel em teste (mesma receita do anel de
// incidentes e do teto das marcas de freeze).
Int auditEventLimitFrom(Int configured) {
    if (configured <= 0) {
        return 100
    }
    return configured
}

Int limitAuditEvents() {
    return auditEventLimitFrom(config.int("kofcloud.limits.auditEvents", 100))
}

// Tamanho do anel de incidentes (os mais antigos ja resolvidos saem
// primeiro). Fonte unica do `Registry.openIncident` — mesma regra do anel de
// auditoria: afinar sem editar o produto. Recuo seguro explicito: zerado ou
// negativo recai no default (anel desligado esconderia um incidente aberto).
Int limitIncidentRing() {
    var cap = config.int("kofcloud.limits.incidents", 100)
    if (cap <= 0) {
        return 100
    }
    return cap
}

// Teto das marcas de freeze (map alvo -> status anterior, persistido no
// ControlState). NAO e teto de capacidade nem de cadastro: passar do teto
// NUNCA recusa congelar (containment vem primeiro — recusar freeze de conta
// por limite de marcas seria o incidente mandando no remedio). Acima do
// teto, o Registry poda as marcas INERTES (alvo removido ou device REVOKED:
// o unfreeze nelas ja responde 404/409 sem ler a marca). Marcas vivas nao
// sao podadas — se mesmo assim passar do teto, o teto cede: a
// reversibilidade de alvo congelado vale mais que o teto. Fonte pura para o
// recuo ser provavel em teste (precedente `limitIncidentRing`).
Int freezeMarkLimitFrom(Int configured) {
    if (configured <= 0) {
        return 1000
    }
    return configured
}

Int limitFreezeMarks() {
    return freezeMarkLimitFrom(config.int("kofcloud.limits.freezeMarks", 1000))
}

// Teto do cabecalho lido na sonda de health local (Agent). O servico do
// usuario pode responder cabecalho gigante; a sonda so precisa da status
// line, entao le ate achar `\r\n\r\n` ou bater neste teto. Fonte unica da
// sonda (`readResponseHead`) — o teto do Edge para conexao publica e outro
// (`maxBytes`), de proposito: sao caminhos diferentes. Recuo seguro: nao
// positivo recai no default (teto zero cortaria toda sonda e todo servico
// viraria DEGRADED).
Int limitHealthResponseHeadBytes() {
    var cap = config.int("kofcloud.limits.healthHeadBytes", 16384)
    if (cap <= 0) {
        return 16384
    }
    return cap
}

// Tamanho de cada leitura crua de socket do TUNEL e do HTTP publico
// (bytes). Fonte unica dos 6 pontos que leem o fio em blocos
// (`conn.receive(n)`: HELLO + loop do tunel no Edge, WELCOME + loop no
// Agent, headers + corpo no `readRequestBytes` do Edge): `receive`
// devolve "o que chegou" sem respeitar fronteira de frame, entao o tamanho
// do bloco nao muda corretude (o LineCodec acumula ate o `\n`); so muda
// quantas chamadas sao feitas por linha. Sem fonte unica, afinar o bloco
// exigiria caçar os 6 literais `8192` espalhados. Fora do alcance de
// proposito: o `local.receive(16384)` do relay (socket do servico local,
// nao o fio) continua proprio — bloco maior ali favorece resposta local.
Int receiveChunkBytes() {
    return config.int("kofcloud.limits.receiveChunkBytes", 8192)
}

// Passo do polling do arquivo-sentinela no Edge (ms): o `serve` nao tem
// sinal nem watch de arquivo (L3), entao um watcher verifica a cada passo
// se o stopFile apareceu e fecha o listener (o `accept` lanca e o serve
// encerra). Curto porque a parada pedida pelo `disconnect` deve ser
// percebida rapido; o custo e uma checagem de arquivo por passo.
Int stopFilePollMs() {
    return config.int("kofcloud.limits.stopFilePollMs", 100)
}

// Passo do polling do arquivo-sentinela no Agent (ms): o watchdog verifica
// a cada passo se o stopFile apareceu e fecha a sessao (saida limpa, sem
// backoff). Separado do passo do Edge de proposito: o Edge vigia um
// listener parado no `accept` (passo curto e barato), o Agent vigia uma
// sessao viva com mais tarefas concorrentes (passo um pouco maior).
Int agentStopPollMs() {
    return config.int("kofcloud.limits.agentStopPollMs", 250)
}

// Limiar do detector de recusas do Edge (Fase 17 slice 1): quantas recusas
// de tunel dentro da janela abrem o incidente global `edge_refusals`.
// Fonte unica do `noteEdgeRefusalIncident` — afinar sem editar o produto.
// Recuo seguro: zerado/negativo recai no default (limiar desligado nunca
// abriria o incidente, e abrir de menos e pior que abrir demais aqui —
// recusas em rajada sao o sinal de Edge sob ataque ou conta com problema).
Int limitEdgeRefusalThreshold() {
    var threshold = config.int("kofcloud.limits.edgeRefusalThreshold", 10)
    if (threshold <= 0) {
        threshold = 10
    }
    return threshold
}

// Janela do detector de recusas do Edge (ms). Fonte unica do
// `noteEdgeRefusalIncident` — mesma janela nos dois ramos (reset e
// comparacao). Recuo seguro: zerada/negativa recai no default (janela
// zerada nunca acumularia, e o detector morreria silencioso).
Int limitEdgeRefusalWindowMs() {
    var window = config.int("kofcloud.limits.edgeRefusalWindowMs", 60000)
    if (window <= 0) {
        window = 60000
    }
    return window
}

//
// Abuse prevention (Fase 17 slice 1): rajada de 401 no Edge. Servico
// AUTHENTICATED responde 401 quando o `kfs_` apresentado nao e daquele
// servico; uma rajada e forca bruta (ou cliente mal configurado em loop).
// Limiar mais alto que o das recusas de tunel de proposito: um cliente
// honesto com token vencido tambem gera 401, e uma rajada de tres seria
// ruido. Mesma semantica de recuo: zerado/negativo volta ao default.
Int limitEdgeAuthFailureThreshold() {
    var threshold = config.int("kofcloud.limits.edgeAuthFailureThreshold", 25)
    if (threshold <= 0) {
        threshold = 25
    }
    return threshold
}

Int limitEdgeAuthFailureWindowMs() {
    var window = config.int("kofcloud.limits.edgeAuthFailureWindowMs", 60000)
    if (window <= 0) {
        window = 60000
    }
    return window
}

// Edge sem heartbeat (Fase 17 slice 1): quantas sessoes mudas o sweeper
// derruba dentro da janela ate abrir o incidente global. Derrubar uma sessao
// ociosa e rotina (Agent parado, notebook suspenso); varias em sequencia
// significam loop de reconexao. Limiar baixo de proposito: o custo de olhar
// e baixo, e cada queda e um tunel que caiu na pratica. Mesma semantica de
// recuo: zerado/negativo volta ao default.
Int limitEdgeIdleTimeoutThreshold() {
    var threshold = config.int("kofcloud.limits.edgeIdleTimeoutThreshold", 5)
    if (threshold <= 0) {
        threshold = 5
    }
    return threshold
}

Int limitEdgeIdleTimeoutWindowMs() {
    var window = config.int("kofcloud.limits.edgeIdleTimeoutWindowMs", 300000)
    if (window <= 0) {
        window = 300000
    }
    return window
}

// Limiar do detector de revogacao em lote (por conta, Fase 17 slice 1):
// quantas revogacoes (device ou token) dentro da janela abrem o incidente.
// Fonte unica do `Registry.detectBulkRevokes` — os dois ramos (device e
// token) usam o mesmo limiar de proposito: lote e lote, seja qual for o
// alvo. Recuo seguro: zerado/negativo recai no default (limiar desligado
// nunca abriria o incidente de lote).
Int limitBulkRevokeThreshold() {
    var threshold = config.int("kofcloud.limits.bulkRevokeThreshold", 3)
    if (threshold <= 0) {
        threshold = 3
    }
    return threshold
}

// Janela do detector de revogacao em lote (ms). Fonte unica do chamador
// `Registry.revokeDeviceInner` — a janela viaja como `Long` ate o
// `detectBulkRevokes` porque `time.now()` e `Long`. Recuo seguro:
// zerada/negativa recai no default (janela zerada nunca acumularia).
Long limitBulkRevokeWindowMs() {
    var window = config.int("kofcloud.limits.bulkRevokeWindowMs", 60000)
    if (window <= 0) {
        window = 60000
    }
    return window
}

// Limiar do detector de expiracao em massa de `kfs_` (por conta, Fase 17
// slice 1): quantas credenciais VENCIDAS na janela abrem o incidente. Um
// vencimento isolado e rotina (a rotacao por TTL faz isso de proposito);
// varios juntos significam rotacao mal planejada ou estado adulterado.
// Fonte unica do `Registry.detectMassTokenExpiry` — recuo seguro: zerado/
// negativo recai no default (limiar desligado nunca abriria o incidente).
Int limitMassTokenExpiryThreshold() {
    var threshold = config.int("kofcloud.limits.massTokenExpiryThreshold", 3)
    if (threshold <= 0) {
        threshold = 3
    }
    return threshold
}

// Janela do detector de expiracao em massa (ms). Fonte unica do mesmo
// chamador; a janela viaja como `Long` ate a varredura porque `time.now()`
// e `Long`. Recuo seguro: zerada/negativa recai no default.
Long limitMassTokenExpiryWindowMs() {
    var window = config.int("kofcloud.limits.massTokenExpiryWindowMs", 300000)
    if (window <= 0) {
        window = 300000
    }
    return window
}

// Teto do espelho WORM do audit em bytes (`<estado>.worm.jsonl`, Fase 19
// slice 4). O espelho nasceu sem cap e crescia para sempre — esgotar o
// disco do control plane com trilha operacional e DoS, nao historia. Acima
// do teto o append poda a CABECA do arquivo em linhas inteiras (sempre
// mantendo o evento mais novo): a rotacao possivel sem rename no stdlib. O
// verify de sufixo tolera as raizes desconhecidas que a poda produz (ver
// `auditWormChainError`). Recuo seguro da familia: zerado/negativo recai no
// default — 0 aqui nao significa "sem teto", significaria descartar todo
// append e deixar o arquivo com no maximo uma linha.
Int wormMirrorBytesFrom(Int configured) {
    if (configured <= 0) {
        return 8388608
    }
    return configured
}

Int limitWormMirrorBytes() {
    return wormMirrorBytesFrom(config.int("kofcloud.limits.wormMirrorBytes", 8388608))
}
