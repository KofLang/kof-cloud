package kofcloud.util

// Limites do KofCloud. Configuraveis por kof.config/env
// (KOF_KOFCLOUD_LIMITS_DEVICES, KOF_KOFCLOUD_LIMITS_SERVICES,
//  KOF_KOFCLOUD_LIMITS_STREAMS, KOF_KOFCLOUD_LIMITS_HTTPREQUESTS,
//  KOF_KOFCLOUD_LIMITS_HTTPWINDOWMS).
//
// Protegem as duas pontas: a infraestrutura KofCloud e a maquina do usuario.
// O que e aplicado hoje: dispositivos ativos por conta, servicos por
// dispositivo, streams simultaneos por tunel, requisicoes por hostname no
// Edge, bytes por frame DATA no tunel, conexoes simultaneas por servico
// (429 KCF108 antes do OPEN) e idle timeout de tunel/stream (IDLE_TIMEOUT).

Int limitDevices() {
    return config.int("kofcloud.limits.devices", 5)
}

Int limitServices() {
    return config.int("kofcloud.limits.services", 10)
}

Int limitStreams() {
    return config.int("kofcloud.limits.streams", 128)
}

// Teto de bytes uteis por frame DATA (antes do base64). Quem envia fatia;
// quem recebe recusa a linha inteira acima de ~4/3 disso (margem do base64).
// Protege os dois lados contra um peer que manda uma linha gigante de uma
// vez (o LineCodec acumularia sem teto).
Int limitFrameBytes() {
    return config.int("kofcloud.limits.frameBytes", 1048576)
}

// Bloco de envio de cada frame DATA. Bem menor que o teto: blocos pequenos
// chegam mais cedo (time-to-first-byte), usam menos memoria por frame e,
// sobre tudo, evitam o custo O(n^2) de `bytesToString` em blocos grandes
// (medido: ~1 s para 100 KiB em bytesToBase64; o custo total e n*tamanho —
// ver 17-limitations). O teto (limitFrameBytes) continua valendo na recepcao.
// Ociosidade maxima sem frames uteis (nao-PING) antes de derrubar a sessao
// (ms). Heartbeat sozinho nao renova: tunel parado e tunel morto para fins
// de roteamento — o Agent reconecta sozinho e o Edge limpa a rota.
Int limitTunnelIdleMs() {
    return config.int("kofcloud.limits.tunnelIdleMs", 120000)
}

// Vida maxima de um stream sem END (ms): stream preso (peer que abre e some
// no meio do DATA) e encerrado com RESET sem derrubar a sessao.
Int limitStreamIdleMs() {
    return config.int("kofcloud.limits.streamIdleMs", 30000)
}

// Intervalo do heartbeat do tunel (PING/PONG, ms). Fonte unica: o Edge
// anuncia no WELCOME e no /v1/connect, e o Agent recai no mesmo valor
// quando o fio vem sem heartbeat valido. Mesmo valor nos tres pontos.
Int limitHeartbeatMs() {
    return config.int("kofcloud.limits.heartbeatMs", 15000)
}

// Passo da varredura de ociosidade (ms): Edge e Agent verificam a cada
// passo se a sessao passou do idle ou se ha streams presos. Fonte unica
// para os dois sweepers varrerem no mesmo ritmo.
Int limitIdleSweepMs() {
    return config.int("kofcloud.limits.idleSweepMs", 5000)
}

// Intervalo do health check local do Agent (ms): a cada passo o Agent
// reconecta TCP nos servicos e reporta mudanca ao Edge; o refresher da
// tabela re-busca os servicos a cada 6 passos. Fonte unica para que o
// ciclo de health e o de refresh andem juntos.
Int limitHealthMs() {
    return config.int("kofcloud.limits.healthMs", 5000)
}

// Intervalo do refresher da tabela de servicos (ms): re-busca os servicos
// via /v1/connect e troca a tabela DA SESSAO. Por desenho e 6x o health —
// os dois ciclos andam juntos; health zerado/invalido recai no default.
// Fonte unica para o spawn (connectAndServe) e o fallback dentro do
// refresher — sem isso o `* 6` do chamador e o `30000` do fallback
// andariam separados.
Int limitRefreshMs(Int healthMs) {
    if (healthMs <= 0) {
        healthMs = limitHealthMs()
    }
    return healthMs * 6
}

Int sendChunkBytes() {
    var size = config.int("kofcloud.limits.sendChunkBytes", 16384)
    if (size <= 0) {
        size = 16384
    }
    var cap = limitFrameBytes()
    if (cap > 0 && size > cap) {
        size = cap
    }
    return size
}

// Teto de uma linha do protocolo de tunel (frame JSON + base64). O base64
// do stdlib passa por String (UTF-8): bytes altos expandem ate ~2x, entao o
// teto usa 2x + margem do envelope JSON. Quem ultrapassar tem a conexao
// derrubada (fail-closed) — um peer que manda linha gigante e hostil ou
// esta corrompido, e o LineCodec nao deve acumular sem teto.
Int maxTunnelLineBytes() {
    return limitFrameBytes() * 2 + 4096
}

// Requisicoes publicas por hostname e por janela no Edge (abuse prevention).
// O Edge TCP nao expoe o IP de origem (sem `peer` em Conn), entao a chave e
// o Host solicitado — que e exatamente o que o abuso (varredura de hostnames,
// forca bruta em AUTHENTICATED) rotaciona menos.
Int limitHttpRequests() {
    return config.int("kofcloud.limits.httpRequests", 100)
}

Int limitHttpWindowMs() {
    return config.int("kofcloud.limits.httpWindowMs", 60000)
}

// Conexoes publicas simultaneas EM RELAY por servico (o recurso caro: tunel
// + servico local). Excedeu -> 429 KCF108 com Retry-After, ANTES de abrir
// stream. Contagem aproximada sob corrida extrema (check-then-act sem lock;
// o Kof nao expoe mutex — ver 17-limitations.md L3): pode estourar em poucas
// unidades, nunca falhar fechado nem travar. O rate limit (atomico) segura
// o volume; este segura a profundidade.
Int limitServiceConns() {
    return config.int("kofcloud.limits.serviceConns", 64)
}

// Teto do corpo de uma requisicao publica (bytes). Excedeu -> 413 KCF110,
// recusado no Edge ANTES do relay (nao consome stream nem toca no Agent).
// Protege a maquina do usuario de uploads que ela nao pediu para aceitar.
Int limitHttpBodyBytes() {
    return config.int("kofcloud.limits.httpBodyBytes", 1048576)
}

// Teto do `agent.log` local (bytes). Append que estourar corta o inicio
// (linhas inteiras, via trimLogHead) em vez de crescer sem limite: log
// local de diagnostico, nao trilha de auditoria (essa vive no control
// plane, em anel de 100). Default folgado para sessoes longas de connect.
Int limitLogBytes() {
    return config.int("kofcloud.limits.logBytes", 262144)
}

// Teto do corpo HTTP que o Edge aceita/acumula no relay (bytes). Fonte
// unica: o `serve` passa ao HttpFront/relay; sem isso o config default e
// o fallback do parse andariam separados.
Int limitMaxBodyBytes() {
    return config.int("kofcloud.maxBodyBytes", 16777216)
}

// Tamanho de cada leitura crua de socket do TUNEL e do HTTP publico
// (bytes). Fonte unica dos 6 pontos que leem o fio em blocos
// (`conn.receive(n)`: HELLO + loop do tunel no Edge, WELCOME + loop no
// Agent, headers + corpo no `readRequestBytes` do Edge): `receive`
// devolve "o que chegou" sem respeitar fronteira de frame, entao o tamanho
// do bloco nao muda corretude (o LineCodec acumula ate o `\n`); so muda
// quantas chamadas sao feitas por linha. Sem fonte unica, afinar o bloco
// exigiria caçar os 6 literais `8192` espalhados. Fora do alcance de
// proposito: o `local.receive(16384)` do relay (socket do servico local,
// nao o fio) continua proprio — bloco maior ali favorece resposta local.
Int receiveChunkBytes() {
    return config.int("kofcloud.limits.receiveChunkBytes", 8192)
}

// Passo do polling do arquivo-sentinela no Edge (ms): o `serve` nao tem
// sinal nem watch de arquivo (L3), entao um watcher verifica a cada passo
// se o stopFile apareceu e fecha o listener (o `accept` lanca e o serve
// encerra). Curto porque a parada pedida pelo `disconnect` deve ser
// percebida rapido; o custo e uma checagem de arquivo por passo.
Int stopFilePollMs() {
    return config.int("kofcloud.limits.stopFilePollMs", 100)
}

// Passo do polling do arquivo-sentinela no Agent (ms): o watchdog verifica
// a cada passo se o stopFile apareceu e fecha a sessao (saida limpa, sem
// backoff). Separado do passo do Edge de proposito: o Edge vigia um
// listener parado no `accept` (passo curto e barato), o Agent vigia uma
// sessao viva com mais tarefas concorrentes (passo um pouco maior).
Int agentStopPollMs() {
    return config.int("kofcloud.limits.agentStopPollMs", 250)
}
