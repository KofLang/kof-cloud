package kofcloud.util

// Helpers de texto e de mapa que o protocolo e a CLI compartilham.

Int parseIntSafe(String text, Int fallback) {
    if (text.length == 0) {
        return fallback
    }
    var negative = false
    var i = 0
    if (text.charAt(0) == 45) {
        negative = true
        i = 1
    }
    var acc = 0
    var digits = 0
    while (i < text.length) {
        var c = text.charAt(i) as Int
        if (c < 48 || c > 57) {
            return fallback
        }
        acc = acc * 10 + (c - 48)
        digits = digits + 1
        i = i + 1
    }
    if (digits == 0) {
        return fallback
    }
    if (negative) {
        return 0 - acc
    }
    return acc
}

String intToString(Int value) {
    return "" + value
}

String longToString(Long value) {
    return "" + value
}

String boolToString(Bool value) {
    if (value) {
        return "true"
    }
    return "false"
}

// Valor de uma chave em Map<String,String>; "" quando ausente.
String mapField(Map<String, String> map, String key) {
    var value = map.get(key)
    if (value == null) {
        return ""
    }
    return value
}

// O cliente HTTP do Kof devolve o corpo mesmo em 4xx (so lanca em >=500).
// Para o control plane, um erro vem como {"error":"..."} — este helper
// transforma isso numa excecao, em vez de deixar o campo ausente virar "".
String requireOk(String raw) {
    var trimmed = raw.trim()
    if (trimmed.startsWith("{")) {
        var map = json.decode<Map<String, String>>(trimmed)
        var error = mapField(map, "error")
        if (error.length > 0) {
            throw error
        }
    }
    return raw
}

// Corpo JSON e um id opaco (UUID/hex, sem aspas internas)? Presenca exata
// entre aspas — evita falso positivo de prefixo. Usado onde
// json.decode<List<...>> nao compila (JSN004 nao suporta colecoes aninhadas).
Bool bodyContainsId(String body, String id) {
    if (id.length == 0) {
        return false
    }
    return body.indexOf("\"" + id + "\"") >= 0
}
