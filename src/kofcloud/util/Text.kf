package kofcloud.util

import kofcloud.util.Limits

// Helpers de texto e de mapa que o protocolo e a CLI compartilham.

Int parseIntSafe(String text, Int fallback) {
    if (text.length == 0) {
        return fallback
    }
    var negative = false
    var i = 0
    if (text.charAt(0) == 45) {
        negative = true
        i = 1
    }
    var acc = 0
    var digits = 0
    while (i < text.length) {
        var c = text.charAt(i) as Int
        if (c < 48 || c > 57) {
            return fallback
        }
        acc = acc * 10 + (c - 48)
        digits = digits + 1
        i = i + 1
    }
    if (digits == 0) {
        return fallback
    }
    if (negative) {
        return 0 - acc
    }
    return acc
}

String intToString(Int value) {
    return "" + value
}

String longToString(Long value) {
    return "" + value
}

String boolToString(Bool value) {
    if (value) {
        return "true"
    }
    return "false"
}

// Valor de uma chave em Map<String,String>; "" quando ausente.
String mapField(Map<String, String> map, String key) {
    var value = map.get(key)
    if (value == null) {
        return ""
    }
    return value
}

// O cliente HTTP do Kof devolve o corpo mesmo em 4xx (so lanca em >=500).
// Para o control plane, um erro vem como {"error":"..."} — este helper
// transforma isso numa excecao, em vez de deixar o campo ausente virar "".
String requireOk(String raw) {
    var trimmed = raw.trim()
    if (trimmed.startsWith("{")) {
        var map = json.decode<Map<String, String>>(trimmed)
        var error = mapField(map, "error")
        if (error.length > 0) {
            throw error
        }
    }
    return raw
}

// Corpo JSON e um id opaco (UUID/hex, sem aspas internas)? Presenca exata
// entre aspas — evita falso positivo de prefixo. Usado onde
// json.decode<List<...>> nao compila (JSN004 nao suporta colecoes aninhadas).
Bool bodyContainsId(String body, String id) {
    if (id.length == 0) {
        return false
    }
    return body.indexOf("\"" + id + "\"") >= 0
}

// Ultimas `n` linhas de um texto (para `logs --tail`). Puro e sem IO:
// o chamador le o arquivo uma vez e formata aqui. `n` <= 0 devolve tudo;
// texto sem trailing newline tambem funciona (a ultima linha parcial conta).
String tailLines(String text, Int n) {
    if (n <= 0) {
        return text
    }
    var lines = text.split("\n")
    // Desconto o "" apos o newline final: nao e uma linha de log.
    var count = lines.size
    if (count > 0 && lines[count - 1].length == 0) {
        count = count - 1
    }
    if (n >= count) {
        return text
    }
    var out = ""
    var i = count - n
    while (i < count) {
        out = out + lines[i] + "\n"
        i = i + 1
    }
    return out
}

// Corta o inicio de um log para caber no teto, mantendo o FIM (o recente)
// e so linhas inteiras: acha o primeiro "\n" a partir do excesso e corta
// ate depois dele. Sem newline no trecho util, devolve o fim cru.
String trimLogHead(String text, Int maxBytes) {
    if (maxBytes <= 0) {
        return text
    }
    if (text.length <= maxBytes) {
        return text
    }
    var cut = text.length - maxBytes
    var at = text.indexOf("\n", cut)
    if (at < 0) {
        return text.substring(cut)
    }
    return text.substring(at + 1)
}

// Extrai o token de um header `Authorization` (ou do valor ja isolado):
// com prefixo `Bearer ` (case-insensitive), devolve o resto aparado; sem
// prefixo, devolve o valor aparado como esta (compat: a CLI manda o token
// cru em `X-KofCloud-Token` e alguns clientes mandam sem esquema). Fonte
// unica para o control plane (`bearerToken`) e o Edge (`bearerFrom`), que
// tinham o mesmo corpo duplicado.
String bearerValue(String authorization) {
    if (authorization.length == 0) {
        return ""
    }
    var lower = authorization.toLowerCase()
    if (lower.startsWith("bearer ")) {
        return authorization.substring(7).trim()
    }
    return authorization.trim()
}

// Assinaturas WAF (Fase 10, slice 1 — modo detectar): inspecao pura de
// metodo + path (+query, que viaja no path). Devolve o nome do padrao que
// casou ou "" quando limpo. Regra de ouro: nunca recebe nem devolve corpo,
// credencial ou chave — so o nome do padrao (ex: "traversal"), que e o
// unico dado que chega a metrica/log. O Edge em modo detectar CONTA e
// segue com o relay; com enforce ligado (`EdgeState.setWafEnforce(true)`)
// casa vira `403 KCF109` antes do relay.
// Teto de inspecao do corpo pelo WAF. Acima disso o corpo NAO e inspecionado
// (o teto de corpo do Edge, `httpBodyBytes`, e outro limite: 1 MiB). 64 KiB
// cobre formularios e JSON de API sem varrer uploads grandes a cada request.
// Fonte unica: `limitWafBodyInspectBytes()` em `util.Limits` (configuravel,
// default 64 KiB); aqui so delega.
Int wafBodyInspectBytes() {
    return limitWafBodyInspectBytes()
}

// Casamento em fonte unica das assinaturas: path, corpo e headers passam
// pela MESMA lista (um padrao novo vale nos tres). `target` ja vem em
// minusculas — o chamador decide o que varrer. `rawBackslash` liga o
// casamento de `..\` (barra invertida crua), que so faz sentido onde o
// texto nao veio de JSON (path); corpo/header com JSON escapado usariam
// `..\\`, que nao e traversal para o servidor local. Ordem fixa
// (traversal, nullbyte, sqli-union, sqli-tautologia, xss) para o nome do
// padrao ser deterministico quando o texto casa mais de um.
String wafSignatureOf(String target, Bool rawBackslash) {
    if (target.indexOf("..%2f") >= 0 || target.indexOf("..%5c") >= 0 || target.indexOf("../") >= 0) {
        return "traversal"
    }
    if (rawBackslash && target.indexOf("..\\") >= 0) {
        return "traversal"
    }
    if (target.indexOf("%00") >= 0) {
        return "nullbyte"
    }
    if (target.indexOf("union select") >= 0 || target.indexOf("union%20select") >= 0) {
        return "sqli-union"
    }
    if (target.indexOf("or 1=1") >= 0 || target.indexOf("or%201%3d1") >= 0) {
        return "sqli-tautology"
    }
    if (target.indexOf("<script") >= 0 || target.indexOf("%3cscript") >= 0) {
        return "xss-script"
    }
    return ""
}

// Assinatura sobre o CORPO (slice 1, parte que faltava): o desenho prometia
// "corpo pequeno" e so metodo+path era inspecionado. Corpo acima de
// `wafBodyInspectBytes()` nao e inspecionado (devolve "").
String wafDetectBodySignature(String body) {
    if (body.length == 0 || body.length > wafBodyInspectBytes()) {
        return ""
    }
    return wafSignatureOf(body.toLowerCase(), false)
}

String wafDetectSignature(String method, String path) {
    return wafSignatureOf((method + " " + path).toLowerCase(), true)
}

// Headers do WAF NAO inspecionados: os que a plataforma possui (roteamento,
// tamanho, conexao, credencial). `Authorization` fica de fora de proposito —
// e credencial, nao entrada do servico local (o Edge ja a consome e nao a
// repassa em AUTHENTICATED), e varrer segredo nao e papel do detector.
// `X-KofCloud-Token` so existe no control plane, mas fica listado para a
// regra nao depender de onde roda. O nome e normalizado aqui: um chamador
// que passe "Authorization" nao pode furar a lista por caixa.
Bool wafHeaderIgnored(String name) {
    var lowerName = name.trim().toLowerCase()
    return lowerName == "authorization" || lowerName == "host" || lowerName == "content-length" || lowerName == "connection" || lowerName == "x-forwarded-for" || lowerName == "x-kofcloud-token"
}

// Assinatura sobre os VALORES dos headers (Fase 10 slice 1 — parte que
// faltava: `17-limitations` listava "assinaturas em headers"). Header com
// valor acima do teto de inspecao nao e varrido (mesma regra fail-open do
// corpo). So o nome do padrao sai daqui; valor nunca chega a metrica/log.
String wafDetectHeadersSignature(List<String> headers) {
    for (var line in headers) {
        var colon = line.indexOf(":")
        if (colon > 0) {
            var name = line.substring(0, colon).trim().toLowerCase()
            if (wafHeaderIgnored(name) == false) {
                var value = line.substring(colon + 1).trim()
                if (value.length > 0 && value.length <= wafBodyInspectBytes()) {
                    var hit = wafSignatureOf(value.toLowerCase(), false)
                    if (hit.length > 0) {
                        return hit
                    }
                }
            }
        }
    }
    return ""
}

// Allowlist WAF (Fase 10, slice 3 — fundacao do enforcement KCF111): decisao
// pura metodo+path contra as listas do servico. Listas vazias = sem restricao
// (servico legado ou sem allowMethods/allowPaths configurados passa tudo — o
// fail-closed so vale para servico QUE declarou a lista). NUNCA devolve corpo,
// path, hostname ou credencial — so Bool (o motivo KCF111 e fixo no emissor).
// Metodo casa exato em maiusculas (o parser HTTP entrega o verbo cru);
// path ignora query (`/api/x?y=2` casa `/api/x`) e aceita prefixo `/*`
// (`/api/*` casa `/api/users` mas nao `/api2`).
Bool wafAllowCheck(String method, String path, List<String> allowMethods, List<String> allowPaths) {
    if (allowMethods.size > 0) {
        var ok = false
        for (var allowed in allowMethods) {
            if (method == allowed) {
                ok = true
            }
        }
        if (ok == false) {
            return false
        }
    }
    if (allowPaths.size > 0) {
        var bare = path
        var cut = path.indexOf("?")
        if (cut >= 0) {
            bare = path.substring(0, cut)
        }
        var ok = false
        for (var pattern in allowPaths) {
            if (pattern.endsWith("/*")) {
                var prefix = pattern.substring(0, pattern.length - 1)
                if (bare.startsWith(prefix)) {
                    ok = true
                }
            } else if (bare == pattern) {
                ok = true
            }
        }
        if (ok == false) {
            return false
        }
    }
    return true
}

// Valida uma lista de metodos da allowlist (slice 3): so verbos HTTP
// conhecidos, em maiusculas, sem repeticao. Devolve a lista normalizada
// (separada por virgula, sem espacos) ou "" quando ha item invalido — o
// chamador rejeita com 400 em vez de publicar uma politica que nunca casaria
// (metodo e comparado exato, ver wafAllowCheck).
String normalizeAllowMethods(String raw, List<String> allowedVerbs) {
    var out = listOf<String>()
    for (var item in raw.split(",")) {
        var verb = item.trim()
        if (verb.length == 0) {
            return ""
        }
        var known = false
        for (var allowed in allowedVerbs) {
            if (verb == allowed) {
                known = true
            }
        }
        if (known == false) {
            return ""
        }
        if (out.contains(verb) == false) {
            out.add(verb)
        }
    }
    return joinCsv(out)
}

// Valida uma lista de caminhos da allowlist: cada item comeca com "/", sem
// espaco nem controle, unico. Devolve a lista normalizada ou "" (invalido).
String normalizeAllowPaths(String raw) {
    var out = listOf<String>()
    for (var item in raw.split(",")) {
        var p = item.trim()
        if (p.length == 0 || p.startsWith("/") == false) {
            return ""
        }
        var bad = false
        for (var i = 0; i < p.length; i++) {
            var c = p.charAt(i) as Int
            if (c <= 32 || c == 127) {
                bad = true
            }
        }
        if (bad) {
            return ""
        }
        if (out.contains(p) == false) {
            out.add(p)
        }
    }
    return joinCsv(out)
}

String joinCsv(List<String> items) {
    var out = ""
    var first = true
    for (var item in items) {
        if (first) {
            out = item
            first = false
        } else {
            out = out + "," + item
        }
    }
    return out
}

// Lista normalizada -> List<String> para wafAllowCheck ("" = sem restricao).
List<String> splitList(String csv) {
    var out = listOf<String>()
    if (csv.trim().length == 0) {
        return out
    }
    for (var item in csv.split(",")) {
        var v = item.trim()
        if (v.length > 0) {
            out.add(v)
        }
    }
    return out
}

// Verbos aceitos na allowlist (exatos, maiusculos — wafAllowCheck compara
// exato). Fora desta lista o publish devolve KCF113.
List<String> httpVerbs() {
    return listOf("GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS")
}
