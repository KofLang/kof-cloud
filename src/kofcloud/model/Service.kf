package kofcloud.model

// Servico publicado. `exposure` e `status` viajam como string (enum em JSON
// adiciona risco de decode sem ganho); a conversao para Exposure acontece
// nas bordas via exposureFrom/exposureName.
record Service(
    String id,
    String accountId,
    String deviceId,
    String name,
    String localAddress,
    Int localPort,
    String protocol,
    String hostname,
    String exposure,
    String status,
    Long createdAt,
    // Allowlist WAF (Fase 10 slice 3). Listas vazias = sem restricao.
    String allowMethods,
    String allowPaths
)

String statusOnline() {
    return "ONLINE"
}

String statusOffline() {
    return "OFFLINE"
}

String statusDegraded() {
    return "DEGRADED"
}

String statusUnknown() {
    return "UNKNOWN"
}

// Suspensao administrativa (abuse prevention): reversivel via unsuspend, ao
// contrario de OFFLINE (sinal do Agent). Nao roteia; health reports do Agent
// nao a sobrescrevem (senao o Agent reverteria a decisao do operador).
String statusSuspended() {
    return "SUSPENDED"
}

Bool statusIsSuspended(String status) {
    return status == statusSuspended()
}

Bool statusIsRoutable(String status) {
    return status == statusOnline() || status == statusDegraded() || status == statusUnknown()
}

// Vocabulario fechado de status. Fonte unica dos construtores acima: o health
// reportado pelo Agent e a API de status aceitam SO estes valores. Antes,
// `POST /v1/services/status` gravava qualquer string (medido: "BANANA" virava
// 200 e ficava no estado), e um status inventado quebrava a leitura do
// operador (`statusIsRoutable` falso, mas nao `OFFLINE` nem `SUSPENDED`).
Bool statusIsKnown(String status) {
    return status == statusOnline() || status == statusOffline() || status == statusDegraded() || status == statusUnknown() || status == statusSuspended()
}

// Mesma configuracao MUTAVEL? Republicar o mesmo nome no mesmo device com
// porta/address/protocol/exposure/allowlist iguais nao deve gerar escrita,
// auditoria nem metrica de atualizacao. Identidade (id, hostname, createdAt)
// e estado operacional (status) ficam de fora de proposito: nao sao
// configuracao do operador e nao mudam por republicacao.
Bool serviceConfigEquals(Service a, Service b) {
    return a.localAddress == b.localAddress && a.localPort == b.localPort && a.protocol == b.protocol && a.exposure == b.exposure && a.allowMethods == b.allowMethods && a.allowPaths == b.allowPaths
}
