package kofcloud.model

// Servico publicado. `exposure` e `status` viajam como string (enum em JSON
// adiciona risco de decode sem ganho); a conversao para Exposure acontece
// nas bordas via exposureFrom/exposureName.
record Service(
    String id,
    String accountId,
    String deviceId,
    String name,
    String localAddress,
    Int localPort,
    String protocol,
    String hostname,
    String exposure,
    String status,
    Long createdAt,
    // Allowlist WAF (Fase 10 slice 3). Listas vazias = sem restricao.
    String allowMethods,
    String allowPaths,
    // Teto de corpo POR SERVICO (Fase 10 s2, "limites por rota"), em bytes,
    // como texto decimal. "" (ou 0/invalido) = herda o teto global do Edge
    // (`kofcloud.limits.httpBodyBytes`). String de proposito — a mesma forma
    // de `localPort`: um campo numerico nulavel no record custou VerifyError
    // e decode quebrado (medido), e um campo de texto decodifica vazio num
    // estado antigo (JSN004: chave ausente vira "").
    String maxBodyBytes
)

String statusOnline() {
    return "ONLINE"
}

String statusOffline() {
    return "OFFLINE"
}

String statusDegraded() {
    return "DEGRADED"
}

String statusUnknown() {
    return "UNKNOWN"
}

// Suspensao administrativa (abuse prevention): reversivel via unsuspend, ao
// contrario de OFFLINE (sinal do Agent). Nao roteia; health reports do Agent
// nao a sobrescrevem (senao o Agent reverteria a decisao do operador).
String statusSuspended() {
    return "SUSPENDED"
}

Bool statusIsSuspended(String status) {
    return status == statusSuspended()
}

Bool statusIsRoutable(String status) {
    return status == statusOnline() || status == statusDegraded() || status == statusUnknown()
}

// Vocabulario fechado de status. Fonte unica dos construtores acima: o health
// reportado pelo Agent e a API de status aceitam SO estes valores. Antes,
// `POST /v1/services/status` gravava qualquer string (medido: "BANANA" virava
// 200 e ficava no estado), e um status inventado quebrava a leitura do
// operador (`statusIsRoutable` falso, mas nao `OFFLINE` nem `SUSPENDED`).
Bool statusIsKnown(String status) {
    return status == statusOnline() || status == statusOffline() || status == statusDegraded() || status == statusUnknown() || status == statusSuspended()
}

// Mesma configuracao MUTAVEL? Republicar o mesmo nome no mesmo device com
// porta/address/protocol/exposure/allowlist iguais nao deve gerar escrita,
// auditoria nem metrica de atualizacao. Identidade (id, hostname, createdAt)
// e estado operacional (status) ficam de fora de proposito: nao sao
// configuracao do operador e nao mudam por republicacao.
Bool serviceConfigEquals(Service a, Service b) {
    return a.localAddress == b.localAddress && a.localPort == b.localPort && a.protocol == b.protocol && a.exposure == b.exposure && a.allowMethods == b.allowMethods && a.allowPaths == b.allowPaths && serviceCapText(a.maxBodyBytes) == serviceCapText(b.maxBodyBytes)
}

// Texto do teto por servico para o fio e a comparacao de config: chave
// ausente decodifica `null` (medido) e sai como "" (herda o global) — a
// mesma forma que o publish grava.
String serviceCapText(String? cap) {
    if (cap == null) {
        return ""
    }
    var v = cap
    if (v == null) {
        return ""
    }
    return v.trim()
}

// Teto EFETIVO do corpo de um servico (bytes). Pura: o valor do servico
// quando e inteiro positivo dentro da faixa; qualquer outra coisa (vazio,
// 0, negativo, lixo) recai no teto global — nunca "sem teto" silencioso
// (a familia de recuos seguros de `util/Limits`). O global chega por
// parametro para a funcao ficar sem I/O.
Int serviceMaxBodyCap(String? serviceCap, Int globalLimit) {
    if (globalLimit <= 0) {
        globalLimit = 16777216
    }
    // Chave ausente no estado antigo decodifica `null` (medido) — trata
    // como "" (herda o global), nunca como erro.
    if (serviceCap == null) {
        return globalLimit
    }
    var capText = serviceCap
    if (capText == null) {
        return globalLimit
    }
    var parsed = parseIntBounded(capText.trim(), 0, 2147483647)
    if (parsed > 0) {
        return parsed
    }
    return globalLimit
}
