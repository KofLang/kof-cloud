package kofcloud.model

// Evento de auditoria operacional (abuse prevention, slice 2). Trilha
// append-only em anel (capado em 100 no Registry): quem fez o que, quando.
// O que NUNCA entra: senhas, tokens, chaves, conteudo de requisicao/resposta,
// corpos, headers. IDs e handles do DONO sao visiveis para a propria conta
// (o endpoint filtra por accountId); nada de terceiros vaza.
// `prevHash`/`hash`: cadeia de integridade (Fase 19 slice 4, WORM parcial).
// `hash = sha256(prevHash + "|" + at + "|" + actor + "|" + action + "|" + target)`
// — alterar qualquer campo de qualquer evento quebra a cadeia dali em diante,
// e remover um evento do meio tambem (o prevHash do seguinte nao fecha).
// Nao e WORM de verdade (o arquivo ainda pode ser reescrito por quem tem
// disco), mas torna a adulteracao DETECTAVEL por terceiro que tenha a cadeia.
record AuditEvent(String at, String actor, String action, String target, String prevHash, String hash)

// Hash de um evento a partir do anterior. Pura: mesma entrada, mesmo hash.
String auditEventHash(String prevHash, String at, String actor, String action, String target) {
    return crypto.sha256(prevHash + "|" + at + "|" + actor + "|" + action + "|" + target)
}

// Verifica a cadeia de uma lista de eventos na ordem em que foram gravados.
// Devolve "" quando integra, ou o indice do primeiro evento quebrado.
//
// A lista e POR CONTA (`auditForAccount`), mas o anel e GLOBAL: cada evento
// encadeia com o anterior do anel inteiro, que pode ser de outra conta. A
// verificacao por conta exige, entao, que o `prevHash` de cada evento seja o
// hash do evento ANTERIOR DA MESMA CONTA (ou vazio, no primeiro dela) —
// nunca "o evento imediatamente antes na lista". Comparar com a posicao na
// lista fazia duas contas ativas reportarem cadeia quebrada sem adulteracao
// nenhuma (medido: primeira conta quebrando no indice 1, a segunda no 0).
String auditChainError(List<AuditEvent> events) {
    var lastHashByAccount = mapOf()
    var index = 0
    for (var event in events) {
        var accountId = auditEventAccount(event)
        var prev = ""
        var saved = lastHashByAccount.get(accountId)
        if (saved != null) {
            prev = saved
        }
        if (event.prevHash != prev) {
            return intToString(index)
        }
        var expected = auditEventHash(event.prevHash, event.at, event.actor, event.action, event.target)
        if (event.hash != expected) {
            return intToString(index)
        }
        lastHashByAccount.put(accountId, event.hash)
        index = index + 1
    }
    return ""
}

// Conta dona de um evento a partir do `target`: `<accountId>` (eventos da
// propria conta) ou `<accountId>/<recurso>`. Puro.
String auditTargetAccount(String target) {
    var slash = target.indexOf("/")
    if (slash < 0) {
        return target
    }
    return target.substring(0, slash)
}

String auditEventAccount(AuditEvent event) {
    return auditTargetAccount(event.target)
}

String auditActorAccount(String handle) {
    return "account:" + handle
}

// Acoes registradas (vocabulario fechado do slice; cresce por adicao).
String auditAccountCreated() {
    return "account.created"
}

String auditLogin() {
    return "account.login"
}

String auditDeviceRegistered() {
    return "device.registered"
}

String auditDeviceRevoked() {
    return "device.revoked"
}

String auditDeviceSuspended() {
    return "device.suspended"
}

String auditDeviceUnsuspended() {
    return "device.unsuspended"
}

String auditServicePublished() {
    return "service.published"
}

// Republicar o mesmo nome no mesmo device com configuracao diferente
// (porta/address/protocol/exposure/allowlist). Identidade e status sao
// preservados; so a configuracao mutavel muda.
String auditServiceUpdated() {
    return "service.updated"
}

String auditServiceRemoved() {
    return "service.removed"
}

String auditServiceTokenRevoked() {
    return "service.token_revoked"
}

// Credencial da CONTA (kfc_) revogada — por `token revoke` ou pela rotacao
// que passou do prazo. Nunca registra o valor.
String auditAccountTokenRevoked() {
    return "account.token_revoked"
}

String auditServiceSuspended() {
    return "service.suspended"
}

String auditServiceUnsuspended() {
    return "service.unsuspended"
}

String auditDomainRegistered() {
    return "domain.registered"
}

String auditDomainVerified() {
    return "domain.verified"
}

String auditDomainRemoved() {
    return "domain.removed"
}

// Contencao (Fase 17 slice 2): freeze suspende e revoga credenciais do alvo;
// unfreeze reverte EXATAMENTE o que o freeze fez.
String auditServiceFrozen() {
    return "service.frozen"
}

String auditServiceUnfrozen() {
    return "service.unfrozen"
}

String auditDeviceFrozen() {
    return "device.frozen"
}

String auditDeviceUnfrozen() {
    return "device.unfrozen"
}

String auditAccountFrozen() {
    return "account.frozen"
}

String auditAccountUnfrozen() {
    return "account.unfrozen"
}
