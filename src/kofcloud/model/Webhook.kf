package kofcloud.model

import kofcloud.util.Hosts
import kofcloud.util.Text

// Webhook de incidentes (Fase 17 slice 3).
//
// A conta cadastra uma URL + segredo; quando um incidente dela abre, o
// control plane faz POST do evento com assinatura HMAC-SHA256.
//
// POR QUE HMAC E NAO Ed25519 (que o desenho pedia): medido no stdlib — o
// `crypto.sign` so tem a face Ed25519 e `keyExchange.privateKey("ed25519")`
// falha com SECN014 ("unknown signing algorithm ed25519"); nao ha geracao
// de par Ed25519 nem assinatura HMAC com chave ASCII exposta de outro jeito.
// HMAC-SHA256 e o padrao de fato de webhooks (Stripe/GitHub), verifica com
// o mesmo segredo compartilhado e existe em todos os alvos do Kof. A lacuna
// do Ed25519 fica registrada em docs/13-kof-apis.md.

// O segredo compartilhado e guardado em claro no estado (o receptor precisa
// compara-lo byte a byte); nunca e devolvido pela API nem pela CLI.
record WebhookConfig(String accountId, String url, String secret, Long createdAt)

// Limites: URL e segredo curtos o bastante para caber num header e numa
// linha de log sem inflar o estado.
Int webhookMaxUrlChars() {
    return 512
}

Int webhookSecretMinChars() {
    return 16
}

// URL aceitavel: https em qualquer lugar, http so em loopback (dev). Recusa
// esquemas perigosos (file:, ftp:, javascript:) e host vazio. Pura.
String webhookUrlError(String url) {
    var trimmed = url.trim()
    if (trimmed.length == 0) {
        return "url required"
    }
    if (trimmed.length > webhookMaxUrlChars()) {
        return "url too long"
    }
    var lower = trimmed.toLowerCase()
    var hostStart = 0
    var scheme = ""
    if (lower.startsWith("https://")) {
        scheme = "https"
        hostStart = 8
    } else if (lower.startsWith("http://")) {
        scheme = "http"
        hostStart = 7
    } else {
        return "url must start with https:// (or http:// on loopback)"
    }
    var rest = trimmed.substring(hostStart)
    var slash = rest.indexOf("/")
    var authority = rest
    if (slash >= 0) {
        authority = rest.substring(0, slash)
    }
    if (authority.length == 0) {
        return "url has no host"
    }
    // userinfo nao e aceito: daria credencial no estado.
    if (authority.indexOf("@") >= 0) {
        return "url must not carry credentials"
    }
    var host = authority
    var colon = authority.indexOf(":")
    if (colon >= 0) {
        host = authority.substring(0, colon)
        var portText = authority.substring(colon + 1)
        // `parseIntSafe` faria wrap (`:4294968080` vira 784 e passaria como
        // porta valida); `parsePortSafe` recusa de verdade.
        var port = parsePortSafe(portText, -1)
        if (port <= 0) {
            return "url port invalid"
        }
    }
    if (scheme == "http" && validLocalAddress(host) == false) {
        return "http:// only for loopback hosts (use https://)"
    }
    return ""
}

String webhookSecretError(String secret) {
    if (secret.length < webhookSecretMinChars()) {
        return "secret must have at least " + intToString(webhookSecretMinChars()) + " characters"
    }
    return ""
}

// Host da URL (sem porta), em minusculas. Puro; "" quando a forma nao e URL.
String webhookUrlHost(String url) {
    var lower = url.trim().toLowerCase()
    var hostStart = 0
    if (lower.startsWith("https://")) {
        hostStart = 8
    } else if (lower.startsWith("http://")) {
        hostStart = 7
    } else {
        return ""
    }
    var rest = lower.substring(hostStart)
    var slash = rest.indexOf("/")
    if (slash >= 0) {
        rest = rest.substring(0, slash)
    }
    var colon = rest.indexOf(":")
    if (colon >= 0) {
        rest = rest.substring(0, colon)
    }
    return rest
}

// Host literal de webhook que aponta para rede interna (nao-loopback)? O
// control plane faz o POST com o header de assinatura; um host que aponte
// para link-local (169.254.x — inclui o metadata service de nuvens), faixas
// privadas (10/8, 172.16/12, 192.168/16), 0/8 ou .local/.localhost deixa a
// conta apontar o disparo para dentro da rede do operador (SSRF).
//
// LOOPBACK fica FORA desta lista de proposito: `http://127.0.0.1` ja e
// confinado por outra regra (so loopback aceita http) e e o receptor de
// desenvolvimento documentado — recusa-lo quebraria o fluxo de teste do
// webhook sem fechar nenhum buraco real (o metadata service de nuvem nao
// escuta em loopback). Puro, sem DNS: vale para IP literal e para cada
// endereco resolvido.
Bool webhookHostIsInternal(String host) {
    var h = host.trim().toLowerCase()
    if (h == "localhost" || h.endsWith(".localhost")) {
        return false
    }
    if (h.endsWith(".local")) {
        return true
    }
    if (h.indexOf(":") >= 0) {
        // IPv6 literal (sem porta neste ponto): so link-local fe80::/10
        // e interno aqui (loopback ::1 fica fora, mesma razao do 127.0.0.1).
        if (h.startsWith("fe8") || h.startsWith("fe9") || h.startsWith("fea") || h.startsWith("feb")) {
            return true
        }
        return false
    }
    // IPv4 em octetos, parse manual (padrao do repo: split(".") do stdlib
    // trata "." como regex em outros contextos; aqui seria literal, mas o
    // parse por indexOf e o mesmo de CustomDomain).
    var parts = listOf<String>()
    var rest = h
    while (true) {
        var dot = rest.indexOf(".")
        if (dot < 0) {
            parts.add(rest)
            break
        }
        parts.add(rest.substring(0, dot))
        rest = rest.substring(dot + 1)
    }
    if (parts.size != 4) {
        return false
    }
    var a = parseIntSafe(parts.get(0), -1)
    var b = parseIntSafe(parts.get(1), -1)
    if (a < 0 || a > 255 || b < 0 || b > 255) {
        return false
    }
    if (a == 0 || a == 10) {
        return true
    }
    if (a == 169 && b == 254) {
        return true
    }
    if (a == 172 && b >= 16 && b <= 31) {
        return true
    }
    if (a == 192 && b == 168) {
        return true
    }
    return false
}

// Checagem com DNS: o host da URL nao pode apontar para rede interna.
// O resolve fica NO CHAMADOR (padrao do verifyCustomDomain — I/O fora do
// model). Resolve falhou = lista vazia = NAO recusa: DNS indisponivel nao
// pode bloquear webhook legitimo; IP literal interno ja cai no
// `webhookHostIsInternal` direto. Puro. Mensagem estavel (vai no 400).
String webhookDnsError(String host, List<String> resolved) {
    if (webhookHostIsInternal(host)) {
        return "url host is an internal address"
    }
    for (var address in resolved) {
        if (webhookHostIsInternal(address)) {
            return "url host resolves to an internal address"
        }
    }
    return ""
}

// Payload do evento: JSON estavel (chaves em ordem fixa por construcao).
// Nunca leva dado de conta alem do que a propria conta ja conhece.
String webhookPayload(String kind, String severity, String summary, Long atMs) {
    var out = mapOf()
    out.put("event", "incident.opened")
    out.put("kind", kind)
    out.put("severity", severity)
    out.put("summary", summary)
    out.put("at", longToString(atMs))
    return json.encode(out)
}

// Assinatura: hex(HMAC-SHA256(segredo, payload)). O receptor recalcula e
// compara em tempo constante.
String webhookSignature(String secret, String payload) {
    return crypto.hmacSha256(secret, payload)
}

// Header de assinatura (padrao `sha256=<hex>`, como o do GitHub).
String webhookSignatureHeader(String secret, String payload) {
    return "sha256=" + webhookSignature(secret, payload)
}

// Verificacao do lado do receptor (usada no teste e documentada no help).
Bool webhookSignatureValid(String secret, String payload, String header, String providedHeader) {
    return security.constantTimeEquals(header, providedHeader)
}
