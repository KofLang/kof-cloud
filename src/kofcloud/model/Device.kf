package kofcloud.model

// Dispositivo: uma instalacao do Agent, com identidade criptografica propria.
// `publicKey` e a chave publica X25519; a privada nunca sai da maquina.
record Device(String id, String accountId, String name, String publicKey, String status, Long lastSeenAt, Long createdAt)

String deviceActive() {
    return "ACTIVE"
}

String deviceRevoked() {
    return "REVOKED"
}

// Suspensao administrativa (abuse prevention): o tunel e recusado com
// DEVICE_SUSPENDED (fatal — o Agent nao reconecta), mas o dispositivo e os
// servicos continuam existindo; unsuspend libera. Ao contrario de REVOKED,
// que remove os servicos junto.
String deviceSuspended() {
    return "SUSPENDED"
}

Bool deviceIsActive(Device device) {
    return device.status == deviceActive()
}

Bool deviceIsSuspended(Device device) {
    return device.status == deviceSuspended()
}

// Revogado e TERMINAL: o dispositivo nao volta a ACTIVE/SUSPENDED por
// mudanca de status. Reverter exige registrar de novo (novo id, nova chave).
// Fonte unica do literal para a trava de estado (`setDeviceStatus`) e para
// os handlers que distinguem "revogado" (409) de "inexistente" (404).
Bool deviceIsRevoked(String status) {
    return status == deviceRevoked()
}
