package kofcloud.model

import kofcloud.util.Limits

// Incidentes (Fase 17 slice 1 — deteccao e severidade).
//
// Um incidente e um sinal operacional com nivel, aberto por um detector e
// fechado pelo operador depois de entendido. NUNCA carrega dado de cliente:
// so o nome do sinal, a severidade, o escopo (conta, quando for dado de
// conta) e um resumo curto e fixo por tipo de sinal.
record Incident(String id, String kind, String severity, String accountId, String summary, Long openedAt, Long resolvedAt)

String severityInfo() {
    return "INFO"
}

String severityWarn() {
    return "WARN"
}

String severityCrit() {
    return "CRIT"
}

Bool severityIsKnown(String severity) {
    return severity == severityInfo() || severity == severityWarn() || severity == severityCrit()
}

// Vocabulario fechado de sinais (cresce por adicao; nunca renomeia).
String incidentBulkTokenRevokes() {
    return "bulk_token_revokes"
}

String incidentBulkDeviceRevokes() {
    return "bulk_device_revokes"
}

String incidentEdgeRefusals() {
    return "edge_refusals"
}

// Abuse prevention: rajada de 401 em servico AUTHENTICATED. O rate limit por
// hostname ja segura o volume (100/min); o sinal e para o operador enxergar
// tentativa de forca bruta de `kfs_` que passaria despercebida no agregado.
String incidentEdgeAuthFailures() {
    return "edge_auth_failures"
}

// Edge sem heartbeat: sessao muda (so PING) e derrubada pelo sweeper de
// ociosidade. Uma sessao derrubada e rotina; varias na mesma janela
// significam Agent preso em loop de reconexao (rede, DNS, credencial) — o
// padrao e o sinal, nao a sessao isolada.
String incidentEdgeIdleTimeouts() {
    return "edge_idle_timeouts"
}

// Tunel caindo em massa: sessao perdida por EOF abrupto do Agent — sem
// GOAWAY de despedida e sem ter sido fechada pelo proprio Edge (ociosidade
// ou parada). Uma perda e rotina (processo morto, rede instavel); varias na
// janela significam agentes caindo em lote. O sinal e global e agregado:
// nunca carrega device nem hostname.
String incidentEdgeTunnelLosses() {
    return "edge_tunnel_losses"
}

// Expiracao em massa de `kfs_` (por conta): varias credenciais vencidas na
// mesma janela. Um vencimento isolado e rotina; varios juntos significam
// rotacao mal planejada (TTL curto sem re-emissao) ou relogio/estado
// adulterado — e o servico cai para cliente legitimo sem ninguem ter mexido.
// A varredura preguicosa ja poda a cada validacao; aqui ela alimenta a sonda.
String incidentMassTokenExpiry() {
    return "mass_token_expiry"
}

// Suspensao em lote (por conta): varios servicos/dispositivos suspensos na
// mesma janela. Suspensao isolada e operacao de rotina (manutencao); varias
// juntas — especialmente sem freeze em curso — sao o padrao de um token de
// conta comprometido tirando o site do ar (suspender nao revoga, entao
// nenhum detector de revoke dispara).
String incidentBulkSuspensions() {
    return "bulk_suspensions"
}

// Contencao (slice 2): o incidente registra o alvo congelado.
String incidentFreezeService() {
    return "freeze_service"
}

String incidentFreezeDevice() {
    return "freeze_device"
}

String incidentFreezeAccount() {
    return "freeze_account"
}

// Severidade por sinal. Pura: a mesma entrada sempre da o mesmo nivel.
String incidentSeverityFor(String kind) {
    if (kind == incidentBulkDeviceRevokes()) {
        return severityCrit()
    }
    if (kind == incidentBulkTokenRevokes() || kind == incidentEdgeRefusals() || kind == incidentEdgeAuthFailures()) {
        return severityWarn()
    }
    if (kind == incidentEdgeIdleTimeouts() || kind == incidentEdgeTunnelLosses()) {
        return severityWarn()
    }
    if (kind == incidentMassTokenExpiry() || kind == incidentBulkSuspensions()) {
        return severityWarn()
    }
    if (kind == incidentFreezeService() || kind == incidentFreezeDevice() || kind == incidentFreezeAccount()) {
        return severityWarn()
    }
    // Reincidencia: o mesmo sinal depois de resolvido e depois da janela do
    // plato nao e ruido novo — e o que voltou.
    if (incidentIsReopen(kind)) {
        return severityCrit()
    }
    return severityInfo()
}

// Resumo fixo por tipo (sem dado do cliente alem do que ja e do dono).
String incidentSummaryFor(String kind) {
    if (kind == incidentBulkDeviceRevokes()) {
        return "many devices revoked in a short window"
    }
    if (kind == incidentBulkTokenRevokes()) {
        return "many service credentials revoked in a short window"
    }
    if (kind == incidentEdgeRefusals()) {
        return "the edge refused many tunnels in a short window"
    }
    if (kind == incidentEdgeAuthFailures()) {
        return "many failed service-token authentications at the edge in a short window"
    }
    if (kind == incidentEdgeIdleTimeouts()) {
        return "many idle tunnel sessions dropped at the edge in a short window"
    }
    if (kind == incidentEdgeTunnelLosses()) {
        return "many tunnels lost abruptly at the edge in a short window"
    }
    if (kind == incidentMassTokenExpiry()) {
        return "many service credentials expired in a short window"
    }
    if (kind == incidentBulkSuspensions()) {
        return "many services or devices suspended in a short window"
    }
    if (kind == incidentFreezeService()) {
        return "service frozen for incident containment"
    }
    if (kind == incidentFreezeDevice()) {
        return "device frozen for incident containment"
    }
    if (kind == incidentFreezeAccount()) {
        return "account frozen for incident containment"
    }
    return kind
}

// Veredito do embasamento de um sinal (Fase 17 slice 1 — plato). Pura: o
// Registry so escreve o estado e chama `raiseIncident`. `kind` pode vir
// diferente do sinal que chegou (reincidencia vira `<kind>_reopened`).
record SignalOutcome(String open, String kind, String accountId, Int reopenCount, Long lastFiredAt)

// Sinal embasado: (sinal, conta) que ja disparou e ainda esta na janela,
// aberto ou fechado — persistido no estado, para o plato sobreviver ao
// restart (as sondas de janela, efemeras, decidem QUANDO o sinal dispara).
record IncidentPlateau(String kind, String accountId, String openedAt, String lastFiredAt, String reopenCount)

// Decisao do `Registry.raiseIncident`, sem IO. Duas entradas:
//  - `incidentOpen`: ha incidente ABERTO do mesmo (sinal, conta) agora?
//  - `plateau`: o embasamento gravado no estado (`null` = nunca disparou).
// Estados, do mais explicito ao mais silencioso:
//  - aberto e ainda disparando: nada (o incidente ja diz);
//  - aberto e fora da janela: volta a disparar e a guarda do embasamento
//    se atualiza (sinal vivo de novo, sem incidente novo);
//  - fechado dentro da janela: plato — nada, so contabiliza a reincidencia
//    (o operador resolveu e o sinal voltou; um incidente por evento
//    afogaria o anel e o webhook);
//  - fechado e fora da janela (ou nunca disparou): reabre; se ja disparou
//    antes, o incidente nasce CRIT (reincidencia, nao ruido novo).
// "Fechado" inclui incidente evicted do anel pelo teto: os dois levam ao
// mesmo veredito, e o operador nao perde o sinal.
SignalOutcome signalOutcomeWith(Bool incidentOpen, List<IncidentPlateau> saved, String kind, String accountId, Long nowMs, Long windowMs) {
    if (windowMs <= 0) {
        windowMs = 3600000
    }
    var lastFired = nowMs
    var reopened = 0
    var firedBefore = false
    for (var plateau in saved) {
        lastFired = incidentLongOr(plateau.lastFiredAt, nowMs)
        reopened = incidentIntOr(plateau.reopenCount, 0)
        firedBefore = true
    }
    var within = nowMs - lastFired < windowMs
    if (incidentOpen) {
        if (within) {
            return SignalOutcome("none", kind, accountId, reopened, lastFired)
        }
        return SignalOutcome("refire", kind, accountId, reopened, nowMs)
    }
    if (firedBefore && within) {
        return SignalOutcome("none", kind, accountId, reopened + 1, lastFired)
    }
    return SignalOutcome("open", incidentReopenKind(kind, firedBefore, accountId), accountId, reopened, nowMs)
}

// Sinal de reincidencia: `<kind>_reopened`. Fica fora do vocabulario do
// Edge (cada sinal e um construtor); a severidade e derivada do tipo-base
// e sobe para CRIT. O CLI mostra o tipo-base ao lado (a rota do sinal que
// voltou), e o prefixo `kind` e prefixo exato do sinal-base.
String incidentReopenKind(String kind, Bool firedBefore, String accountId) {
    if (firedBefore == false || kind.endsWith("_reopened")) {
        return kind
    }
    return kind + "_reopened"
}

String incidentBaseKind(String kind) {
    if (kind.endsWith("_reopened")) {
        return kind.substring(0, kind.length - 9)
    }
    return kind
}

Bool incidentIsReopen(String kind) {
    return incidentBaseKind(kind) != kind
}

// Inteiro de String vinda do estado (os campos do embasamento sao String,
// L11). Pura e local: o parse do Registry e de `Long` e nao serve aqui.
Int incidentIntOr(String text, Int fallback) {
    if (text.length == 0) {
        return fallback
    }
    var i = 0
    var acc = 0
    while (i < text.length) {
        var c = text.charAt(i) as Int
        if (c < 48 || c > 57) {
            return fallback
        }
        acc = acc * 10 + (c - 48)
        i = i + 1
    }
    return acc
}

// Instante de String vinda do estado (epoch ms, L11). Vazio/ilegivel =
// `fallback` (o plato de um campo adulterado vence, nunca trava o sinal).
Long incidentLongOr(String text, Long fallback) {
    if (text.length == 0) {
        return fallback
    }
    var i = 0
    var acc = 0L
    while (i < text.length) {
        var c = text.charAt(i) as Int
        if (c < 48 || c > 57) {
            return fallback
        }
        acc = acc * 10L + (c - 48)
        i = i + 1
    }
    return acc
}

// Limite do anel de incidentes (os mais antigos ja resolvidos saem primeiro).
// Delega na fonte unica (`util/Limits.kf`) — mesma regra dos detectores.
Int limitIncidents() {
    return limitIncidentRing()
}

// Janela e limiar do detector de revogacao em lote (por conta).
// `bulkRevokeWindowMs` / `bulkRevokeThreshold`: continua a mais que isso
// dentro da janela abre incidente. Delegam na fonte unica
// (`util/Limits.kf`) — mesma regra do detector do Edge.
Int bulkRevokeThreshold() {
    return limitBulkRevokeThreshold()
}

Long bulkRevokeWindowMs() {
    return limitBulkRevokeWindowMs()
}

// Consulta do embasamento exato (`<sinal>/<conta>`): tira a chave do map
// (nulavel por SEM049), valida a tripla e delega a decisao sem IO. Digitado
// aqui, justo porque o campo do registro e String (L11) e o Registry nao
// tem como chamar a pura com um valor nulavel.
SignalOutcome signalFromPlateaus(Map<String, String> plateaus, Bool incidentOpen, String key, String kind, String accountId, Long nowMs, Long windowMs) {
    var raw = plateaus.get(key)
    if (raw == null) {
        return signalOutcomeWith(incidentOpen, emptyPlateauList(), kind, accountId, nowMs, windowMs)
    }
    var parts = raw.split(";")
    var found = listOf<IncidentPlateau>()
    if (parts.length == 3) {
        found.add(IncidentPlateau(kind, accountId, parts[0], parts[1], parts[2]))
    }
    return signalOutcomeWith(incidentOpen, found, kind, accountId, nowMs, windowMs)
}

// Sem embasamento: lista vazia para o par de assinaturas com `found` acima.
// A pura decide "nunca disparou" pela LISTA vazia.
List<IncidentPlateau> emptyPlateauList() {
    return listOf<IncidentPlateau>()
}
