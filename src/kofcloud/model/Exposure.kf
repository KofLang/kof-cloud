package kofcloud.model

// Nivel de exposicao de um servico.
enum Exposure { PUBLIC, AUTHENTICATED, PRIVATE }

Exposure exposureFrom(String name) {
    if (name == "AUTHENTICATED") {
        return Exposure.AUTHENTICATED
    }
    if (name == "PRIVATE") {
        return Exposure.PRIVATE
    }
    return Exposure.PUBLIC
}

String exposureName(Exposure exposure) {
    return switch (exposure) {
        case Exposure.PUBLIC -> "PUBLIC"
        case Exposure.AUTHENTICATED -> "AUTHENTICATED"
        case Exposure.PRIVATE -> "PRIVATE"
    }
}

// PRIVATE nao tem rota publica: o Edge nem sabe que ele existe.
Bool exposureIsRoutable(Exposure exposure) {
    return exposure != Exposure.PRIVATE
}

// So AUTHENTICATED exige credencial kfs_ antes do tunel (o Edge valida e
// remove antes de repassar ao servico local). Recebe a string do modelo
// (Service.exposure viaja como string — ver Service.kf) para os pontos que
// so tem a string em maos (HttpFront); quem ja tem o enum usa o `switch`.
Bool exposureRequiresAuth(String name) {
    return exposureFrom(name) == Exposure.AUTHENTICATED
}
