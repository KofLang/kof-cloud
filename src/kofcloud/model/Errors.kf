package kofcloud.model

// Codigos de erro estaveis do KofCloud (padrao R6, como o kof-share).
//
// Regra: codigos nunca sao removidos nem renumerados — so adicionados. A CLI e
// os testes identificam falhas pelo codigo, e `errHint` traduz para linguagem
// humana. Formato fixo: "KCFnnn: texto curto em ingles".
//
// Familias:
//   KCF001-KCF019  conta / autenticacao
//   KCF020-KCF039  dispositivo
//   KCF040-KCF059  servico / publicacao
//   KCF060-KCF079  credenciais de servico (kfs_)
//   KCF080-KCF099  limites
//   KCF100-KCF119  Edge / roteamento / tunel
//   KCF120-KCF139  dominio proprio (Fase 6; KCF123 reservado, nunca emitido)

// ---- conta / autenticacao ----

String errInvalidHandle() {
    return "KCF001: invalid handle"
}

String errHandleTaken() {
    return "KCF002: handle taken"
}

String errInvalidCredentials() {
    return "KCF003: invalid credentials"
}

String errUnauthorized() {
    return "KCF004: missing or invalid account token"
}

// ---- dispositivo ----

String errDeviceFields() {
    return "KCF020: name and publicKey required"
}

String errDeviceNotFound() {
    return "KCF021: device not found"
}

String errDeviceNotYours() {
    return "KCF022: not the owner of device"
}

// ---- servico / publicacao ----

String errInvalidServiceName() {
    return "KCF040: invalid service name"
}

String errServiceNotFound() {
    return "KCF041: service not found"
}

String errServiceNotYours() {
    return "KCF042: not the owner of service"
}

String errLocalPort() {
    return "KCF043: localPort required"
}

String errServiceIdRequired() {
    return "KCF044: serviceId required"
}

String errInvalidExposure() {
    return "KCF045: exposure must be PUBLIC, AUTHENTICATED or PRIVATE"
}

String errInvalidProtocol() {
    return "KCF046: protocol must be http (MVP: so HTTP/1.1 pelo tunel)"
}

String errInvalidAddress() {
    return "KCF047: localAddress must be loopback (127.0.0.1, localhost ou ::1)"
}

// ---- credenciais de servico ----

String errServiceTokenForbidden() {
    return "KCF060: not the owner of service"
}

String errServiceTokenRequired() {
    return "KCF061: serviceId and token required"
}

String errInvalidTtl() {
    return "KCF062: ttlHours must be a positive number of hours"
}

String errAmbiguousToken() {
    return "KCF063: short id matches more than one credential; use the full kfs_ value"
}

// ---- limites ----

String errLimitDevices() {
    return "KCF080: too many active devices"
}

String errLimitServices() {
    return "KCF081: too many services on this device"
}

// ---- Edge / roteamento ----

String errNoRoute() {
    return "KCF100: no route for host"
}

String errAuthRequired() {
    return "KCF101: authentication required"
}

String errDeviceOffline() {
    return "KCF102: device not connected"
}

String errServiceDown(String name, String status) {
    return "KCF103: service " + name + " is " + status
}

String errTunnel(String detail) {
    return "KCF104: tunnel error: " + detail
}

String errEmptyUpstream() {
    return "KCF105: empty response from service"
}

String errTooManyStreams() {
    return "KCF106: too many concurrent streams"
}

String errRateLimited() {
    return "KCF107: too many requests"
}

String errServiceOverloaded() {
    return "KCF108: too many connections for this service"
}

// ---- dominio proprio (Fase 6) ----

String errInvalidCustomHostname() {
    return "KCF120: invalid custom hostname"
}

String errDomainTaken() {
    return "KCF121: hostname already registered"
}

String errDomainNotFound() {
    return "KCF122: domain not found"
}

String errDomainUnreachable() {
    return "KCF124: hostname does not resolve to this Edge"
}

// Dica humana para um erro da plataforma. Nunca revela segredos, conteudo de
// servico ou existencia de recurso alheio — so orienta o proximo passo.
String errHint(String raw) {
    if (raw.indexOf("KCF001") >= 0) {
        return "O identificador da conta usa letras minusculas, numeros e tracos (ex: mel)."
    }
    if (raw.indexOf("KCF002") >= 0) {
        return "Esse identificador ja esta em uso — entre com a senha da conta ou escolha outro."
    }
    if (raw.indexOf("KCF003") >= 0) {
        return "Conta ou senha nao conferem — rode `kof cloud login <handle> --password <senha>` de novo."
    }
    if (raw.indexOf("KCF004") >= 0) {
        return "O control plane precisa de credencial — rode `kof cloud login` primeiro."
    }
    if (raw.indexOf("KCF005") >= 0) {
        return "Senha muito curta — use ao menos 4 caracteres (`kof cloud login <handle> --password <senha>`)."
    }
    if (raw.indexOf("KCF020") >= 0) {
        return "O registro do dispositivo precisa de nome e chave publica — rode `kof cloud login` de novo."
    }
    if (raw.indexOf("KCF021") >= 0) {
        return "Esse dispositivo nao existe nesta conta — veja `kof cloud device list`."
    }
    if (raw.indexOf("KCF022") >= 0 || raw.indexOf("KCF042") >= 0 || raw.indexOf("KCF060") >= 0) {
        return "Esse recurso pertence a outra conta — confira `kof cloud status` e use a conta dona."
    }
    if (raw.indexOf("KCF061") >= 0) {
        return "Informe o servico e o token: `kof cloud service token revoke <nome> <kfs_...>`."
    }
    if (raw.indexOf("KCF062") >= 0) {
        return "O TTL precisa ser horas positivas (ex: `--ttl 24` para 1 dia); sem `--ttl`, sem expiracao."
    }
    if (raw.indexOf("KCF063") >= 0) {
        return "Esse id curto casa com mais de uma credencial — copie o `kfs_...` completo do `token-list` (ele so aparece na emissao) ou revogue por outro id."
    }
    if (raw.indexOf("KCF040") >= 0) {
        return "O nome do servico usa letras minusculas, numeros e tracos (ex: site)."
    }
    if (raw.indexOf("KCF041") >= 0 || raw.indexOf("KCF044") >= 0) {
        return "Esse servico nao existe nesta conta — veja `kof cloud service list`."
    }
    if (raw.indexOf("KCF043") >= 0) {
        return "Informe a porta local: `kof cloud publish <nome> --port <porta>`."
    }
    if (raw.indexOf("KCF045") >= 0) {
        return "Exposicao invalida — use PUBLIC, AUTHENTICATED ou PRIVATE (`kof cloud publish <nome> --port <porta> --exposure PRIVATE`)."
    }
    if (raw.indexOf("KCF046") >= 0) {
        return "O tunel do MVP so fala HTTP — revise o manifesto/API (protocol tem que ser http)."
    }
    if (raw.indexOf("KCF047") >= 0) {
        return "Endereco local invalido — o Agent so conecta em loopback (127.0.0.1, localhost ou ::1)."
    }
    if (raw.indexOf("KCF080") >= 0) {
        return "Limite de dispositivos ativos atingido — revogue um com `kof cloud device revoke <id>`."
    }
    if (raw.indexOf("KCF081") >= 0) {
        return "Limite de servicos neste dispositivo atingido — remova um com `kof cloud unpublish <nome>`."
    }
    if (raw.indexOf("KCF100") >= 0) {
        return "Nenhum servico publicado com esse hostname — confira `kof cloud domain list`."
    }
    if (raw.indexOf("KCF101") >= 0) {
        return "Esse servico exige credencial — emita uma com `kof cloud service token <nome>` e envie como `Authorization: Bearer <kfs_...>`."
    }
    if (raw.indexOf("KCF102") >= 0) {
        return "O dispositivo dono esta offline — rode `kof cloud connect` na maquina dele."
    }
    if (raw.indexOf("KCF103") >= 0) {
        return "O servico local nao esta respondendo — verifique a aplicacao na porta publicada e o `kof cloud logs`."
    }
    if (raw.indexOf("KCF104") >= 0) {
        return "Falha no tunel entre Edge e Agent — aguarde a reconexao e tente de novo."
    }
    if (raw.indexOf("KCF105") >= 0) {
        return "O servico local devolveu resposta vazia — verifique a aplicacao na porta publicada."
    }
    if (raw.indexOf("KCF106") >= 0) {
        return "Muitas conexoes simultaneas — tente de novo em instantes."
    }
    if (raw.indexOf("KCF107") >= 0) {
        return "Muitas requisicoes em pouco tempo — aguarde um instante e tente de novo."
    }
    if (raw.indexOf("KCF108") >= 0) {
        return "Servico ocupado agora — tente de novo em instantes."
    }
    if (raw.indexOf("KCF120") >= 0) {
        return "O dominio precisa ser um hostname externo valido (ex: api.example.com) — sem IP e fora de *.kofcloud.io."
    }
    if (raw.indexOf("KCF121") >= 0) {
        return "Esse hostname ja esta registrado — confira `kof cloud domain list`."
    }
    if (raw.indexOf("KCF122") >= 0) {
        return "Esse dominio nao existe nesta conta — veja `kof cloud domain list`."
    }
    if (raw.indexOf("KCF124") >= 0) {
        return "O DNS ainda nao aponta para este Edge — confira o CNAME e aguarde a propagacao; depois rode `kof cloud domain verify <hostname>`."
    }
    return ""
}
