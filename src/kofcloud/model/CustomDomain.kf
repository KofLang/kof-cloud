package kofcloud.model

// Dominio proprio (Fase 6): hostname externo que aponta para um servico da
// conta via CNAME. Ciclo de vida: o registro cria PENDING com a instrucao de
// DNS; a VERIFICACAO resolve o nome e confere que ele chega ao Edge
// (lista esperada de IPs/hosts vindos de config); so entao vira VERIFIED e a
// rota e ativada. Remover o dominio (ou revogar o dispositivo do servico)
// desativa a rota sem revelar nada a terceiros (404 opaco).
record CustomDomain(String hostname, String accountId, String serviceId, String status, String verifiedAt, Long createdAt)

String domainPending() {
    return "PENDING"
}

String domainVerified() {
    return "VERIFIED"
}

Bool domainIsVerified(CustomDomain domain) {
    return domain.status == domainVerified()
}

// Hostname externo valido: um ou mais rotulos DNS separados por ponto
// (letras/digitos/hifen, sem hifen nas pontas), com TLD de ao menos 2
// letras. Recusa: vazio, espaco, underscore, ponto final/duplo, IP literal
// (o CNAME precisa de nome, nao de endereco) e qualquer coisa dentro de
// *.kofcloud.io (esse espaco continua automatico e nao precisa de registro).
Bool validCustomHostname(String hostname) {
    if (hostname.length == 0 || hostname.length > 253) {
        return false
    }
    if (hostname.endsWith(".") || hostname.indexOf("..") >= 0) {
        return false
    }
    if (hostname.indexOf(" ") >= 0 || hostname.indexOf("_") >= 0) {
        return false
    }
    // Zona reservada da plataforma: qualquer subdominio (`x.kofcloud.io`)
    // e o proprio APEX (`kofcloud.io`). O sufixo tem o ponto na frente, entao
    // o apex — que nao tem — passava como dominio externo e uma conta podia
    // registrar o dominio da propria plataforma. Normaliza caixa e ponto
    // final (o ponto final ja foi recusado acima, mas o apex roda apos).
    var lower = hostname.trim().toLowerCase()
    if (lower == kofcloudDomain()) {
        return false
    }
    if (lower.endsWith(kofcloudDomainSuffix())) {
        return false
    }
    var labels = splitHostname(hostname)
    if (labels.size < 2) {
        return false
    }
    var i = 0
    while (i < labels.size) {
        if (validLabel(labels[i].toLowerCase(), 1, 63) == false) {
            return false
        }
        i = i + 1
    }
    var tld = labels[labels.size - 1].toLowerCase()
    if (tld.length < 2) {
        return false
    }
    for (var j = 0; j < tld.length; j++) {
        var c = tld.charAt(j) as Int
        if (c < 97 || c > 122) {
            return false
        }
    }
    // IP literal (v4) nao e dominio: quatro grupos so de digitos.
    if (labels.size == 4) {
        var numeric = true
        for (var k = 0; k < 4; k++) {
            var label = labels[k]
            if (label.length == 0) {
                numeric = false
            } else {
                for (var m = 0; m < label.length; m++) {
                    var d = label.charAt(m) as Int
                    if (d < 48 || d > 57) {
                        numeric = false
                    }
                }
            }
        }
        if (numeric) {
            return false
        }
    }
    return true
}

String kofcloudDomainSuffix() {
    return "." + kofcloudDomain()
}

// Um octeto IPv4 decimal 0-255 (sem sinal, sem zero a esquerda — "010" e
// ambigua entre decimal/octal e nunca e destino que a plataforma anuncie).
Bool validIPv4Octet(String text) {
    if (text.length == 0 || text.length > 3) {
        return false
    }
    if (text.length > 1 && text.startsWith("0")) {
        return false
    }
    var value = 0
    for (var i = 0; i < text.length; i++) {
        var c = text.charAt(i) as Int
        if (c < 48 || c > 57) {
            return false
        }
        value = value * 10 + (c - 48)
    }
    return value <= 255
}

// `1.2.3.4` literal (quatro octetos). Nome DNS pode ter quatro rotulos
// numericos (`1.2.3.4.com`, alias publico de DNS dinamico), por isso a
// checagem e sobre o texto inteiro.
Bool isIPv4Literal(String address) {
    var labels = splitHostname(address)
    if (labels.size != 4) {
        return false
    }
    for (var i = 0; i < labels.size; i++) {
        if (validIPv4Octet(labels[i]) == false) {
            return false
        }
    }
    return true
}

// --- IPv6 (Fase 6, fatia 2) -------------------------------------------------
//
// O AAAA e julgado pelo VALOR do endereco, nao pelo texto: "2001:db8::10" e
// "2001:db8:0:0:0:0:0:10" sao o mesmo host, e o IPv4 mapeado
// ("::ffff:203.0.113.10") chega no mesmo destino do IPv4 puro. Comparar
// texto rejects um destino legitimo por causa da grafia.

// Grupos numericos (8 x 16 bits) de um IPv6 literal, na ordem da rede.
// `::` vira zeros; a forma mista com IPv4 no fim vira 2 grupos. Devolve a
// lista VAZIA quando o texto nao e um IPv6 valido.
List<Int> ipv6Groups(String address) {
    var out = listOf<Int>()
    var text = address.trim().toLowerCase()
    if (text.length == 0) {
        return out
    }
    var at = text.indexOf("::")
    var head = text
    var tail = ""
    if (at >= 0) {
        if (text.indexOf("::", at + 2) >= 0) {
            // dois "::" — invalido
            return out
        }
        head = text.substring(0, at)
        tail = text.substring(at + 2)
        if (head.indexOf(".") >= 0) {
            // IPv4 so pode aparecer no FIM do endereco
            return out
        }
    }
    var headGroups = ipv6ChunkGroups(head)
    var tailGroups = ipv6ChunkGroups(tail)
    if (headGroups.size == 1 && headGroups.get(0) < 0) {
        return out
    }
    if (tailGroups.size == 1 && tailGroups.get(0) < 0) {
        return out
    }
    var total = headGroups.size + tailGroups.size
    if (at >= 0) {
        if (total > 7) {
            // o "::" precisa cobrir pelo menos um grupo
            return out
        }
    } else {
        if (total != 8) {
            return out
        }
    }
    for (var i = 0; i < headGroups.size; i++) {
        out.add(headGroups.get(i))
    }
    var zeros = 8 - total
    for (var j = 0; j < zeros; j++) {
        out.add(0)
    }
    for (var k = 0; k < tailGroups.size; k++) {
        out.add(tailGroups.get(k))
    }
    return out
}

// Grupos de um trecho separado por ':'. Trecho vazio (lado do `::`) nao e
// erro e devolve lista vazia; texto invalido devolve a lista [-1] — grupo
// impossivel, usado como sentinela.
List<Int> ipv6ChunkGroups(String text) {
    var out = listOf<Int>()
    if (text.length == 0) {
        return out
    }
    var parts = listOf<String>()
    var current = ""
    for (var i = 0; i < text.length; i++) {
        var c = text.charAt(i) as Int
        if (c == 58) {
            parts.add(current)
            current = ""
        } else {
            current = current + (text.charAt(i) as Char)
        }
    }
    parts.add(current)
    var last = parts.size - 1
    for (var p = 0; p < parts.size; p++) {
        var part = parts[p]
        if (part.length == 0) {
            return ipv6InvalidGroups()
        }
        if (part.indexOf(".") >= 0) {
            // forma mista: IPv4 no fim do endereco -> 2 grupos
            if (p != last) {
                return ipv6InvalidGroups()
            }
            var v4 = ipv4Octets(part)
            if (v4.size != 4) {
                return ipv6InvalidGroups()
            }
            out.add(v4.get(0) * 256 + v4.get(1))
            out.add(v4.get(2) * 256 + v4.get(3))
        } else {
            var g = hexGroupValue(part)
            if (g < 0) {
                return ipv6InvalidGroups()
            }
            out.add(g)
        }
    }
    return out
}

// Sentinela de "grupo invalido" (nenhum grupo real tem valor negativo).
List<Int> ipv6InvalidGroups() {
    var out = listOf<Int>()
    out.add(-1)
    return out
}

// Valor de um grupo hexadecimal (1 a 4 digitos). -1 quando nao e hex.
Int hexGroupValue(String text) {
    if (text.length == 0 || text.length > 4) {
        return -1
    }
    var value = 0
    for (var i = 0; i < text.length; i++) {
        var c = text.charAt(i) as Int
        var digit = 0
        if (c >= 48 && c <= 57) {
            digit = c - 48
        } else if (c >= 97 && c <= 102) {
            digit = c - 87
        } else if (c >= 65 && c <= 70) {
            digit = c - 55
        } else {
            return -1
        }
        value = value * 16 + digit
    }
    return value
}

// Os quatro octetos de um IPv4 literal; lista vazia quando nao e IPv4.
List<Int> ipv4Octets(String text) {
    var out = listOf<Int>()
    var labels = splitHostname(text)
    if (labels.size != 4) {
        return listOf<Int>()
    }
    for (var i = 0; i < labels.size; i++) {
        if (validIPv4Octet(labels[i]) == false) {
            return listOf<Int>()
        }
        var value = 0
        for (var j = 0; j < labels[i].length; j++) {
            var d = labels[i].charAt(j) as Int
            value = value * 10 + (d - 48)
        }
        out.add(value)
    }
    return out
}

// IPv6 literal valido (RFC 4291: 8 grupos, no maximo um "::", IPv4 misto
// so no fim).
Bool isIPv6Literal(String address) {
    var groups = ipv6Groups(address)
    if (groups.size != 8) {
        return false
    }
    for (var i = 0; i < groups.size; i++) {
        if (groups.get(i) < 0) {
            return false
        }
    }
    return true
}

// Mesmo endereco? Comparacao grupo a grupo (nao depende da grafia).
Bool ipv6SameGroups(List<Int> a, List<Int> b) {
    if (a.size != b.size) {
        return false
    }
    for (var i = 0; i < a.size; i++) {
        if (a.get(i) != b.get(i)) {
            return false
        }
    }
    return true
}

// Mesmos quatro octetos.
Bool ipv4SameOctets(List<Int> a, List<Int> b) {
    if (a.size != 4 || b.size != 4) {
        return false
    }
    for (var i = 0; i < a.size; i++) {
        if (a.get(i) != b.get(i)) {
            return false
        }
    }
    return true
}

// Octetos do IPv4 embutido num IPv6 mapeado ("::ffff:203.0.113.10" e a
// forma compativel "::203.0.113.10"); lista vazia quando nao ha IPv4
// embutido. O cliente que chega por essa forma chega no mesmo host do IPv4.
List<Int> ipv4MappedOctets(String address) {
    var out = listOf<Int>()
    var text = address.trim().toLowerCase()
    var rest = ""
    if (text.startsWith("::ffff:")) {
        rest = text.substring(7)
    } else if (text.startsWith("::")) {
        rest = text.substring(2)
    } else {
        return out
    }
    return ipv4Octets(rest)
}

// O endereco IPv6 e um destino esperado? Aceita o mesmo endereco escrito de
// outra forma (comparacao numerica) e o IPv4 mapeado do IPv4 esperado.
Bool ipv6IsExpected(String address, List<String> expected) {
    if (isIPv6Literal(address) == false) {
        return false
    }
    var groups = ipv6Groups(address)
    var mapped = ipv4MappedOctets(address)
    for (var candidate in expected) {
        if (isIPv6Literal(candidate)) {
            if (ipv6SameGroups(groups, ipv6Groups(candidate))) {
                return true
            }
        } else if (mapped.size == 4) {
            var candidateV4 = ipv4Octets(candidate)
            if (candidateV4.size == 4 && ipv4SameOctets(mapped, candidateV4)) {
                return true
            }
        }
    }
    return false
}

// Fase 6 — a resposta DNS pode CHEGAR ao Edge por um caminho que nao e o
// CNAME esperado. Medido (sonda): o hostname com CNAME para o Edge responde
// tambem com um registro de outro IP; a verificacao mirava so "algum
// endereco e o Edge" e dava VERIFIED — o cliente que cai no IP de terceiro
// (registro antigo, CDN/provedor no meio) para fora da plataforma. Nome que
// resolve para IPv4 alem dos esperados fica PENDING com `KCF164`; hostnames
// CNAME-only (sem endereco proprio) continuam OK.
//
// Guarda de sinal: o resolver pode devolver o TEXTO do CNAME visto no meio
// da cadeia (depende do resolver do SO). Um destino que e nome nao e
// "endereco de terceiro" e nao recusa a verificacao.
Bool domainResolvesOnlyToEdge(List<String> addresses, List<String> expected) {
    for (var address in addresses) {
        if (isIPv4Literal(address)) {
            if (customTargetIsExpected(address, expected) == false) {
                return false
            }
        } else if (isIPv6Literal(address)) {
            // AAAA: julgado pelo VALOR do endereco. Um AAAA que nao e o Edge
            // declarado em `kofcloud.edgeHosts` recusa (KCF164) — o cliente
            // que seguir o AAAA sairia da plataforma.
            if (ipv6IsExpected(address, expected) == false) {
                return false
            }
        } else if (address.indexOf(":") >= 0) {
            // Texto com ':' que nao e IPv6 valido: nao da para julgar, e
            // nao da para aceitar — recusa.
            return false
        }
        // Host por nome / texto de CNAME: nao desqualifica (o resolver pode
        // nao expor o endereco).
    }
    return true
}

// Mesma regra do Registry (`isExpectedEdgeHost`): exato ou wildcard
// `*.dominio` (o destino anunciado continua o Edge, ainda que por nome).
Bool customTargetIsExpected(String address, List<String> expected) {
    for (var candidate in expected) {
        if (candidate == address) {
            return true
        }
        if (candidate.startsWith("*.") && address.endsWith(candidate.substring(1))) {
            return true
        }
    }
    return false
}

// Divide por ponto LITERAL. `String.split` trata o padrao como regex (ponto
// casa tudo e o resultado vem vazio) — por isso o split manual.
List<String> splitHostname(String hostname) {
    var out = listOf<String>()
    var current = ""
    for (var i = 0; i < hostname.length; i++) {
        var c = hostname.charAt(i)
        if (c == 46) {
            out.add(current)
            current = ""
        } else {
            current = current + (c as Char)
        }
    }
    out.add(current)
    return out
}
