package kofcloud.edge

import kofcloud.protocol.Bytes
import kofcloud.util.Limits
import kofcloud.util.Text

// Parsing/serializacao minima de HTTP/1.1. O Edge precisa repassar bytes com
// controle fino (reescrever Connection, saber quando a requisicao/resposta
// terminou) — coisa que web.app() nao expoe. Ver docs/10-edge.md.

// `/.well-known/security.txt` (Fase 19 slice 1 parcial): politica de
// seguranca legivel por maquina, servida pelo proprio Edge sem conta,
// sem tunel e sem tocar em servico local. Conteudo estatico (sem dado de
// cliente, sem versao que vire fingerprint): so o contato e a politica.
String securityTxtBody() {
    return "Contact: security@kofcloud.local\nPolicy: https://kofcloud.local/.well-known/security.txt\n"
}

// Resposta do security.txt: 200 com Content-Type dedicado (RFC 9116 pede
// text/plain — aqui vai o sufixo +security para ferramenta reconhecer).
Byte[] securityTxtResponse() {
    var body = securityTxtBody()
    var out = "HTTP/1.1 200 OK\r\n"
    out = out + "Content-Type: text/plain; charset=utf-8\r\n"
    out = out + "Content-Length: " + intToString(body.length) + "\r\n"
    out = out + "Connection: close\r\n"
    out = out + "\r\n"
    out = out + body
    return bytesFromString(out)
}

record HttpRequest(String method, String path, String version, List<String> headers, Byte[] body)

// O Edge nunca faz parse de resposta: o relay repassa os bytes do Agent para
// o cliente sem inspecionar (sem status de resposta no Edge). Parsing de
// request/response vive aqui; o resto do Edge só usa request.

String headerValue(List<String> headers, String name) {
    var needle = name.toLowerCase() + ":"
    for (var line in headers) {
        var lower = line.toLowerCase()
        if (lower.startsWith(needle)) {
            return line.substring(needle.length).trim()
        }
    }
    return ""
}

// Enquadramento de corpo lido de `Content-Length` (RFC 9112 §6). O Edge nao
// implementa `Transfer-Encoding` (chunked) e nao tem keep-alive: cada pedido
// e uma conexao. Mesmo assim o valor declarado precisa ser confiavel, porque
// e ele que delimita o corpo que vai ao servico local.
//
// `invalid` cobre os casos em que a fronteira e ambigua:
//  * valor nao-numerico/vazio/negativo/com sinal (inclui "5 5", "+5", "0x10")
//  * dois `Content-Length` com valores DIFERENTES (request smuggling; dois
//    iguais sao aceitos, como o RFC permite)
//  * `Transfer-Encoding` presente (o Edge nao decodifica chunked; repassar o
//    header com corpo vazio faria o servico local esperar para sempre)
//  * nome fora da forma canonica (`Content-Length : 5`, ou o header sem
//    valor): alguns servidores aceitam, outros nao — a divergencia entre o
//    que o Edge via e o que o servico local ve e exatamente o smuggling.
// `value` e Long de proposito: parseIntSafe estoura acima de 2^31 e um
// `Content-Length: 999999999999` virava NEGATIVO (corpo descartado em
// silencio), enquanto `4294967306` voltava a 10 (wrap) e o Edge repassava
// 30 bytes com `Content-Length: 10` mentiroso — smuggling para o servico.
record ContentLength(Long value, Bool invalid, String detail)

ContentLength parseContentLength(List<String> headers) {
    var seen = -1L
    for (var line in headers) {
        var colon = line.indexOf(":")
        if (colon < 0) {
            var bare = line.trim().toLowerCase()
            if (bare == "content-length" || bare == "transfer-encoding") {
                return ContentLength(0L, true, "cabecalho de enquadramento sem valor")
            }
            continue
        }
        var name = line.substring(0, colon)
        var lower = name.trim().toLowerCase()
        var framing = lower == "transfer-encoding" || lower == "content-length"
        // `Content-Length : 5`: o Edge so reconhece o nome canonico, alguns
        // servidores locais aceitam o espaco. O servico veria um corpo que o
        // Edge nao leu — recusa em vez de escolher um dos dois.
        if (framing && name != name.trim()) {
            return ContentLength(0L, true, "espaco antes dos dois pontos")
        }
        if (lower == "transfer-encoding") {
            return ContentLength(0L, true, "transfer-encoding nao suportado")
        }
        if (lower != "content-length") {
            continue
        }
        var raw = line.substring(colon + 1).trim()
        if (raw.length == 0) {
            return ContentLength(0L, true, "content-length vazio")
        }
        var i = 0
        while (i < raw.length) {
            var c = raw.charAt(i) as Int
            if (c < 48 || c > 57) {
                return ContentLength(0L, true, "content-length nao numerico")
            }
            i = i + 1
        }
        var parsed = parseLongSafe(raw, -1L)
        if (parsed < 0L) {
            return ContentLength(0L, true, "content-length fora do alcance")
        }
        if (seen >= 0L && seen != parsed) {
            return ContentLength(0L, true, "content-length divergente")
        }
        seen = parsed
    }
    if (seen < 0L) {
        return ContentLength(0L, false, "")
    }
    return ContentLength(seen, false, "")
}

// Validacao do `Host` do pedido (RFC 9112 §3.2). O Edge roteia por ele e o
// repassa ao servico local; se o valor que roteou e o que a aplicacao le
// divergem, o roteamento vira sugestao. Medido: com dois `Host`, o Edge
// roteava pelo PRIMEIRO e repassava AMBOS — o servico local via o segundo
// (`Host: evil.example.com` chegava la), host-header injection classica.
// Regras: exatamente um `Host`, nao vazio, e sem caracteres de controle ou
// espaco (que quebrariam a linha ao reconstruir o pedido).
Bool hostIsUnambiguous(List<String> headers) {
    var count = 0
    for (var line in headers) {
        var colon = line.indexOf(":")
        if (colon < 0) {
            continue
        }
        if (line.substring(0, colon).trim().toLowerCase() != "host") {
            continue
        }
        count = count + 1
        if (count > 1) {
            return false
        }
        var value = line.substring(colon + 1).trim()
        if (value.length == 0) {
            return false
        }
        var i = 0
        while (i < value.length) {
            var c = value.charAt(i) as Int
            if (c < 33 || c == 127) {
                return false
            }
            i = i + 1
        }
    }
    return count == 1
}

// Resultado da leitura crua de um pedido: os bytes lidos, se o teto de
// leitura do Edge cortou o pedido antes do fim e se o enquadramento do corpo
// e invalido/ambiguo (nesse caso o chamador recusa com 400 KCF118).
record HttpRead(Byte[] bytes, Bool overflowed, Bool badLength)

// Le a requisicao inteira: headers ate \r\n\r\n + corpo por Content-Length.
//
// `maxBytes` e o teto ABSOLUTO de leitura e vale para o pedido inteiro
// (cabecalho + corpo). O laco do corpo respeitava so o `total` declarado,
// entao um `Content-Length` gigante fazia o Edge acumular tudo em memoria —
// o 413 de politica so chegava DEPOIS da leitura completa, e a promessa
// "maxBytes" valia apenas para o cabecalho. Quem para no teto sai marcado
// como `overflowed` e o chamador recusa (413 KCF110 / 431 KCF116); carregar
// mais nunca ajuda o cliente honesto, e relayar corpo cortado seria pior.
HttpRead readRequestBytes(Conn conn, Int maxBytes) {
    var acc = bytesEmpty()
    var headEnd = -1
    while (headEnd < 0) {
        var chunk = conn.receive(receiveChunkBytes())
        if (chunk.length == 0) {
            return HttpRead(acc, false, false)
        }
        acc = bytesConcat(acc, chunk)
        headEnd = bytesIndexOf(acc, "\r\n\r\n", 0)
        if (acc.length > maxBytes) {
            // Sem terminador de cabecalho dentro do teto: 431 no chamador
            // (o `overflowed` tambem vale, mas o terminador ausente e o
            // diagnostico mais preciso).
            return HttpRead(acc, true, false)
        }
    }
    var head = bytesToString(bytesSlice(acc, 0, headEnd))
    var headers = splitLines(head)
    // Fronteira de corpo ambigua (duplicado divergente, nao numerico,
    // Transfer-Encoding): recusa ANTES de ler/relayar. Repassar com o
    // Content-Length original daria ao servico local um corpo com tamanho
    // diferente do declarado — request smuggling.
    var declared = parseContentLength(headers)
    if (declared.invalid) {
        return HttpRead(acc, false, true)
    }
    // Tamanho declarado acima do teto: recusa ANTES de ler o corpo. Ler e
    // depois recusar deixaria um cliente hostil forcar `maxBytes` de
    // acumulacao por conexao.
    if (declared.value > (maxBytes as Long)) {
        return HttpRead(acc, true, false)
    }
    var total = ((headEnd + 4) as Long) + declared.value
    while ((acc.length as Long) < total) {
        var chunk = conn.receive(receiveChunkBytes())
        if (chunk.length == 0) {
            break
        }
        acc = bytesConcat(acc, chunk)
    }
    if (acc.length > maxBytes) {
        return HttpRead(acc, true, false)
    }
    // Bytes alem do declarado (pipelining ou smuggling) ficam fora do corpo:
    // o servico local recebe exatamente o que o Content-Length prometeu.
    if ((acc.length as Long) > total) {
        acc = bytesSlice(acc, 0, total as Int)
    }
    return HttpRead(acc, false, false)
}

List<String> splitLines(String text) {
    var out = listOf<String>()
    var current = ""
    for (var i = 0; i < text.length; i++) {
        var c = text.charAt(i) as Int
        if (c == 10) {
            if (current.endsWith("\r")) {
                current = current.substring(0, current.length - 1)
            }
            out.add(current)
            current = ""
        } else {
            current = current + (c as Char)
        }
    }
    if (current.length > 0) {
        out.add(current)
    }
    return out
}

// Linha de requisicao valida? `METODO SP PATH SP HTTP/<versao>` com exatamente
// tres partes nao vazias (RFC 9112 §3). Medido: `GE T / HTTP/1.1` virava
// metodo `GE` e path `T` (split(" ") aproveitando as partes), e uma linha de
// STATUS (`HTTP/1.1 200 OK`) era aceita como requisicao — o Edge respondia um
// pedido que ninguem fez. Pura.
Bool requestLineIsValid(String line) {
    var parts = line.split(" ")
    if (parts.length != 3) {
        return false
    }
    var method = parts[0]
    var path = parts[1]
    var version = parts[2]
    if (method.length == 0 || path.length == 0) {
        return false
    }
    // Metodo e `token` (RFC 9110 §5.6.2): sem separador, espaco nem controle.
    var i = 0
    while (i < method.length) {
        var c = method.charAt(i) as Int
        if (c <= 32 || c >= 127) {
            return false
        }
        i = i + 1
    }
    if (path.charAt(0) != '/') {
        return false
    }
    // Path: nada de espaco nem controle. `\r`/`\t` no path quebravam a linha
    // ao reconstruir o pedido para o servico local (header injection): medido,
    // `GET /a\rb` produzia uma linha partida e o resto virava header.
    var p = 0
    while (p < path.length) {
        var pc = path.charAt(p) as Int
        if (pc <= 32 || pc == 127) {
            return false
        }
        p = p + 1
    }
    return version == "HTTP/1.0" || version == "HTTP/1.1"
}

HttpRequest parseRequest(Byte[] raw) {
    var headEnd = bytesIndexOf(raw, "\r\n\r\n", 0)
    var head = ""
    var body = bytesEmpty()
    if (headEnd < 0) {
        head = bytesToString(raw)
    } else {
        head = bytesToString(bytesSlice(raw, 0, headEnd))
        body = bytesSlice(raw, headEnd + 4, raw.length)
    }
    var lines = splitLines(head)
    var method = ""
    var path = "/"
    var version = "HTTP/1.1"
    if (lines.size > 0) {
        var requestLine = lines.get(0)
        var parts = requestLine.split(" ")
        if (requestLineIsValid(requestLine)) {
            method = parts[0]
            path = parts[1]
            version = parts[2]
        }
    }
    // Linha invalida deixa `method` vazio de proposito: o chamador recusa com
    // 400 antes de rotear (ver HttpFront) em vez de inventar metodo/path.
    var headers = listOf<String>()
    var i = 1
    while (i < lines.size) {
        headers.add(lines.get(i))
        i = i + 1
    }
    return HttpRequest(method, path, version, headers, body)
}

// Cabecalho bem formado? `nome ":" OWS valor` com nome `token` (RFC 9110
// §5.6.2/§5.1) e sem CR/LF/NUL no valor. Medido: `X-A\rb: v` atravessava ate
// o servico local, onde a linha se partia (header injection), e a linha sem
// dois pontos era aceita na lista (so descartada no repasse).
Bool headerLineIsValid(String line) {
    var colon = line.indexOf(":")
    if (colon <= 0) {
        return false
    }
    var i = 0
    while (i < colon) {
        var c = line.charAt(i) as Int
        if (c <= 32 || c >= 127) {
            return false
        }
        i = i + 1
    }
    var v = colon + 1
    while (v < line.length) {
        var vc = line.charAt(v) as Int
        if (vc == 13 || vc == 10 || vc == 0 || vc == 127) {
            return false
        }
        v = v + 1
    }
    return true
}

// Algum cabecalho da lista e malformado? O chamador recusa o pedido inteiro
// com 400: repassar uma lista em que o Edge e o servico local discordam do
// enquadramento e a mesma classe do Host duplicado.
Bool headersAreValid(List<String> headers) {
    for (var line in headers) {
        if (headerLineIsValid(line) == false) {
            return false
        }
    }
    return true
}

// Nome do cabecalho (minusculo, sem espaco em volta) ou "" se a linha nao
// tem dois pontos. Fonte unica para as decisoes de repasse abaixo.
String headerNameOf(String line) {
    var colon = line.indexOf(":")
    if (colon < 0) {
        return ""
    }
    return line.substring(0, colon).trim().toLowerCase()
}

// Cabecalhos hop-by-hop (RFC 9110 §7.6.1): valem para UMA conexao e nao
// podem ser repassados por um intermediario. `proxy-connection` nao e
// padrao, mas e o que proxies reais emitem — tratar como hop-by-hop e o
// comportamento conservador. `transfer-encoding` ja foi recusado com 400
// KCF118 antes daqui; fica na lista por defesa em profundidade.
Bool isHopByHopHeader(String name) {
    if (name == "connection") {
        return true
    }
    if (name == "keep-alive") {
        return true
    }
    if (name == "proxy-authenticate") {
        return true
    }
    if (name == "proxy-authorization") {
        return true
    }
    if (name == "te") {
        return true
    }
    if (name == "trailer") {
        return true
    }
    if (name == "transfer-encoding") {
        return true
    }
    if (name == "upgrade") {
        return true
    }
    return name == "proxy-connection"
}

// Tokens nomeados na(s) linha(s) `Connection: close, X-Private`. Esses
// cabecalhos sao hop-by-hop por declaracao do cliente (RFC 9110 §7.6.1) e
// nao atravessam o Edge — sem isso um `Connection: X-Private` fazia o Edge
// repassar um header que ele nao entende mas o servico local trataria.
List<String> connectionTokens(List<String> headers) {
    var tokens = listOf<String>()
    for (var line in headers) {
        if (headerNameOf(line) != "connection") {
            continue
        }
        var value = line.substring(line.indexOf(":") + 1)
        for (var item in value.split(",")) {
            var token = item.trim().toLowerCase()
            if (token.length > 0 && tokens.contains(token) == false) {
                tokens.add(token)
            }
        }
    }
    return tokens
}

// Um header do cliente vai ao servico local? Pura de proposito: o teste
// trava cada regra sem subir o Edge.
Bool headerIsForwarded(String line, List<String> dropTokens, Bool dropCredential) {
    var name = headerNameOf(line)
    if (name.length == 0) {
        return false
    }
    if (isHopByHopHeader(name)) {
        return false
    }
    if (dropTokens.contains(name)) {
        return false
    }
    // `Host` vai (o servico local precisa dele e o pedido ja foi validado);
    // `X-Forwarded-For` do cliente e descartado — o Edge escreve o seu.
    if (name == "x-forwarded-for") {
        return false
    }
    if (dropCredential && name == "authorization") {
        return false
    }
    if (dropCredential && name == "x-kofcloud-token") {
        return false
    }
    return true
}

// Reconstroi a requisicao para o servico local, forçando Connection: close
// (determinismo: o servico fecha ao terminar, e o Agent le ate EOF) e
// anexando X-Forwarded-For.
// `dropCredential` = true em servico AUTHENTICATED: o Edge ja consumiu o
// `Authorization`, entao ele NAO vai ao servico local. Isso evita vazar a
// credencial da plataforma para a aplicacao e evita que um web.app() local
// (que reserva Authorization para JWT) recuse a requisicao.
Byte[] serializeRequest(HttpRequest request, String clientIp, Bool dropCredential) {
    var out = request.method + " " + request.path + " " + request.version + "\r\n"
    var dropTokens = connectionTokens(request.headers)
    for (var line in request.headers) {
        if (headerIsForwarded(line, dropTokens, dropCredential)) {
            out = out + line + "\r\n"
        }
    }
    out = out + "Connection: close\r\n"
    out = out + "X-Forwarded-For: " + clientIp + "\r\n"
    out = out + "\r\n"
    return bytesConcat(bytesFromString(out), request.body)
}

// 401 de servico AUTHENTICATED: anuncia o esquema para o cliente.
Byte[] unauthorizedResponse(String message) {
    var body = message + "\n"
    var out = "HTTP/1.1 401 Unauthorized\r\n"
    out = out + "WWW-Authenticate: Bearer\r\n"
    out = out + "Content-Type: text/plain; charset=utf-8\r\n"
    out = out + "Content-Length: " + intToString(body.length) + "\r\n"
    out = out + "Connection: close\r\n"
    out = out + "\r\n"
    out = out + body
    return bytesFromString(out)
}

// 429 de rate limit: anuncia em quanto tempo tentar de novo para o cliente
// honesto nao ficar martelando (e o abusivo saber que esta contido).
Byte[] rateLimitedResponse(String message, Int retryAfterSec) {
    var body = message + "\n"
    var out = "HTTP/1.1 429 Too Many Requests\r\n"
    out = out + "Retry-After: " + intToString(retryAfterSec) + "\r\n"
    out = out + "Content-Type: text/plain; charset=utf-8\r\n"
    out = out + "Content-Length: " + intToString(body.length) + "\r\n"
    out = out + "Connection: close\r\n"
    out = out + "\r\n"
    out = out + body
    return bytesFromString(out)
}

Byte[] errorResponse(Int status, String message) {
    var reason = statusReason(status)
    var body = message + "\n"
    var out = "HTTP/1.1 " + intToString(status) + " " + reason + "\r\n"
    out = out + "Content-Type: text/plain; charset=utf-8\r\n"
    out = out + "Content-Length: " + intToString(body.length) + "\r\n"
    out = out + "Connection: close\r\n"
    out = out + "\r\n"
    out = out + body
    return bytesFromString(out)
}

// Tamanho de chunk em hexadecimal; -1 fora do formato (digito invalido ou
// vazio). Reusa `wafHexValue` (util.Text) — a mesma tabela de digitos do
// decoder do WAF, sem uma segunda implementacao para divergir.
Long parseHexSafe(String text, Long fallback) {
    if (text.length == 0) {
        return fallback
    }
    var acc = 0L
    var i = 0
    while (i < text.length) {
        var digit = wafHexValue(text.charAt(i))
        if (digit < 0) {
            return fallback
        }
        acc = acc * 16L + (digit as Long)
        i = i + 1
    }
    return acc
}

// Decodifica um corpo `Transfer-Encoding: chunked` (RFC 9112 §7.1) para
// bytes simples. O Edge nao tem keep-alive e delimita a resposta pelo EOF,
// mas o header chunked e hop-by-hop e sai no `sanitizeResponse`: sem
// decodificar, o cliente recebia o enquadramento (`5\r\nhello\r\n0`) como se
// fosse o corpo — medido. Parser tolerante a proposito (chunk extensions
// `;x=y` ignoradas, CRLF final opcional) e com teto de iteracao: corpo
// malformado nao pode virar laco infinito no Edge.
record ChunkedBody(Byte[] body, Bool valid)

ChunkedBody decodeChunked(Byte[] data) {
    var out = bytesEmpty()
    var at = 0
    var guard = 0
    while (at < data.length) {
        guard = guard + 1
        if (guard > 100000) {
            return ChunkedBody(out, false)
        }
        var pad = -1
        var scan = at
        while (scan + 1 < data.length) {
            if (data[scan] == 13 && data[scan + 1] == 10) {
                pad = scan
                break
            }
            scan = scan + 1
        }
        if (pad < 0) {
            return ChunkedBody(out, false)
        }
        var sizeText = bytesToString(bytesSlice(data, at, pad)).trim()
        var semi = sizeText.indexOf(";")
        if (semi >= 0) {
            sizeText = sizeText.substring(0, semi).trim()
        }
        var size = parseHexSafe(sizeText, -1L)
        if (size < 0L) {
            return ChunkedBody(out, false)
        }
        var bodyStart = pad + 2
        if (size == 0L) {
            return ChunkedBody(out, true)
        }
        var bodyEnd = bodyStart + (size as Int)
        if (bodyEnd > data.length) {
            return ChunkedBody(out, false)
        }
        out = bytesConcat(out, bytesSlice(data, bodyStart, bodyEnd))
        at = bodyEnd
        if (at + 1 < data.length && data[at] == 13 && data[at + 1] == 10) {
            at = at + 2
        }
    }
    return ChunkedBody(out, false)
}

// A resposta do servico local e HTTP enquadravel? Exige linha de status no
// formato `HTTP/<versao> <codigo>` (3 digitos). Sem isso o Edge repassava ao
// cliente bytes que ele nao consegue interpretar como resposta (medido: linha
// "GARBAGE RESPONSE" chegava ao cliente como corpo). Pura.
Bool responseIsParseable(Byte[] response) {
    var end = bytesIndexOf(response, "\r\n\r\n", 0)
    if (end < 0) {
        return false
    }
    var lines = splitLines(bytesToString(bytesSlice(response, 0, end)))
    if (lines.size == 0) {
        return false
    }
    var statusLine = lines.get(0)
    if (statusLine.startsWith("HTTP/") == false) {
        return false
    }
    var code = statusCodeOf(statusLine)
    return code >= 100 && code <= 599
}

// Codigo numerico da linha de status (`HTTP/1.1 204 No Content` -> 204);
// -1 se ausente ou nao numerico. Puro.
Int statusCodeOf(String statusLine) {
    var firstSpace = statusLine.indexOf(" ")
    if (firstSpace < 0) {
        return -1
    }
    var rest = statusLine.substring(firstSpace + 1).trim()
    var end = rest.indexOf(" ")
    var digits = rest
    if (end >= 0) {
        digits = rest.substring(0, end)
    }
    if (digits.length != 3) {
        return -1
    }
    var value = 0
    var i = 0
    while (i < digits.length) {
        var c = digits.charAt(i) as Int
        if (c < 48 || c > 57) {
            return -1
        }
        value = value * 10 + (c - 48)
        i = i + 1
    }
    return value
}

// Status que NAO pode carregar corpo (RFC 9110 §6.4.1): 1xx, 204 e 304. O
// Edge repassava o corpo do upstream como veio; um 204/304 com bytes depois
// do header fazia o cliente ler como corpo da PROXIMA resposta (a conexao
// fecha, entao o efeito e bytes inventados no fim do stream). `HEAD` entra
// pela mesma razao: os headers descrevem o GET, o corpo nao existe.
Bool statusAllowsBody(Int code, String method) {
    if (method == "HEAD") {
        return false
    }
    if (code >= 100 && code < 200) {
        return false
    }
    return code != 204 && code != 304
}

// Sanitiza a resposta do servico local antes de entrega-la ao cliente
// (lado simetrico do `serializeRequest`). O Edge fecha a conexao publica
// sempre (`Connection: close`) e delimita o corpo pelo EOF, mas repassava os
// headers do upstream sem tocar: um `Connection: keep-alive` no servico local
// pedia ao cliente para REUSAR uma conexao que o Edge fecha (o cliente perde
// a proxima requisicao), e `Proxy-Authenticate`/`Trailer`/`Upgrade` vazavam
// semantica de outra conexao. Regras:
//  * hop-by-hop (mesma lista do request) saem;
//  * tokens nomeados no `Connection` do upstream saem;
//  * `Transfer-Encoding: chunked` e DECODIFICADO: o header e hop-by-hop e o
//    enquadramento nao pode chegar ao cliente como corpo;
//  * 1xx/204/304 e `HEAD` nao levam corpo (ver `statusAllowsBody`); 1xx/204
//    tambem perdem o `Content-Length`, que nao vale para eles;
//  * um unico `Connection: close` do Edge entra no lugar;
//  * sem `\r\n\r\n` (resposta crua/incompleta) a resposta volta intacta —
//    nao ha header para reescrever e inventariar um seria pior.
Byte[] sanitizeResponse(Byte[] response) {
    return sanitizeResponse(response, "")
}

Byte[] sanitizeResponse(Byte[] response, String method) {
    // Respostas intermediarias (1xx, ex. `100 Continue`) vem ANTES da final na
    // mesma conexao. Sem pular, o Edge entregava o bloco 1xx como resposta e o
    // cliente nunca via o status final — medido: 100 Continue + 200 OK virava
    // um 100 com corpo vazio. Pula-se cada bloco 1xx inteiro (headers + o
    // terminador); sem `\r\n\r\n` nao ha como pular, devolve como veio.
    var skipped = response
    var guard = 0
    while (guard < 8) {
        guard = guard + 1
        var e = bytesIndexOf(skipped, "\r\n\r\n", 0)
        if (e < 0 || skipped.length < e + 4) {
            break
        }
        var interimLines = splitLines(bytesToString(bytesSlice(skipped, 0, e)))
        var firstLine = ""
        if (interimLines.size > 0) {
            firstLine = interimLines[0]
        }
        var interim = statusCodeOf(firstLine)
        if (interim < 100 || interim >= 200) {
            break
        }
        skipped = bytesSlice(skipped, e + 4, skipped.length)
    }
    response = skipped
    var end = bytesIndexOf(response, "\r\n\r\n", 0)
    if (end < 0) {
        return response
    }
    var head = bytesToString(bytesSlice(response, 0, end))
    var lines = splitLines(head)
    var dropTokens = connectionTokens(lines)
    var code = -1
    if (lines.size > 0) {
        code = statusCodeOf(lines.get(0))
    }
    var bodiless = statusAllowsBody(code, method) == false
    var chunked = false
    for (var line in lines) {
        if (headerNameOf(line) == "transfer-encoding") {
            var value = line.substring(line.indexOf(":") + 1).trim().toLowerCase()
            if (value.indexOf("chunked") >= 0) {
                chunked = true
            }
        }
    }
    var body = bytesSlice(response, end + 4, response.length)
    if (chunked) {
        var decoded = decodeChunked(body)
        // Corpo chunked que nao fecha: entrega o que decodificou (o close do
        // Edge delimita) em vez de vazar o enquadramento cru.
        body = decoded.body
    }
    if (bodiless) {
        body = bytesEmpty()
    }
    // `Content-Length` do upstream x corpo real (RFC 9112 §6.3). Medido: um
    // `Content-Length: 2` com 7 bytes entregava os 7 (o excedente e lixo no
    // fim do stream) e um `Content-Length: 100` com 2 bytes mantinha o header
    // mentiroso. O declarado e reescrito para o tamanho REAL do corpo — o
    // cliente fecha por EOF de qualquer forma, mas parar de mentir e barato.
    // Chunked ja foi decodificado, entao a regra vale igual. 304 e HEAD
    // ficam de fora: ali o CL descreve a representacao do GET, nao o corpo.
    var declaredLength = -1L
    for (var line in lines) {
        if (headerNameOf(line) == "content-length") {
            declaredLength = parseLongSafe(line.substring(line.indexOf(":") + 1).trim(), -1L)
        }
    }
    var rewriteLength = statusAllowsBody(code, method)
    if (rewriteLength && declaredLength >= 0L) {
        if (declaredLength < body.length as Long) {
            body = bytesSlice(body, 0, declaredLength as Int)
        }
    }
    // 1xx e 204 nao tem `Content-Length` (RFC 9110 §8.6); 304 e HEAD mantem,
    // porque ali o valor descreve a representacao que o GET devolveria.
    var dropLength = code >= 100 && code < 200 || code == 204
    // A fatia do separador vem antes do corpo de proposito: `end` aponta o
    // primeiro `\r` de `\r\n\r\n` e manter os 4 bytes deixa a resposta
    // bem formada mesmo quando o corpo foi substituido pelo decodificado.
    var separator = bytesSlice(response, end, end + 4)
    var out = ""
    var first = true
    for (var line in lines) {
        if (first) {
            out = line
            first = false
            continue
        }
        var name = headerNameOf(line)
        if (name.length == 0 || isHopByHopHeader(name) || dropTokens.contains(name)) {
            continue
        }
        if (dropLength && name == "content-length") {
            continue
        }
        if (rewriteLength && name == "content-length") {
            out = out + "\r\nContent-Length: " + intToString(body.length)
            continue
        }
        out = out + "\r\n" + line
    }
    var rebuilt = bytesFromString(out + "\r\nConnection: close")
    return bytesConcat(bytesConcat(rebuilt, separator), body)
}

// Marca a resposta do relay no modo detectar: insere
// `X-KofCloud-WAF: would-block` no fim dos headers. So bytes: localiza o
// `\r\n\r\n`, cola o header, preserva o corpo intacto (o corpo nunca vira
// String — `bytesToString` e O(n2)). Sem terminador (resposta crua) ou com
// o header ja presente (servico local ecoando), devolve intacto.
Byte[] withWafWouldBlock(Byte[] response) {
    var end = bytesIndexOf(response, "\r\n\r\n", 0)
    if (end < 0) {
        return response
    }
    var head = bytesToString(bytesSlice(response, 0, end))
    if (head.toLowerCase().indexOf("x-kofcloud-waf:") >= 0) {
        return response
    }
    var marked = bytesFromString(head + "\r\nX-KofCloud-WAF: would-block")
    return bytesConcat(marked, bytesSlice(response, end, response.length))
}

// 403 do enforce WAF: mesmo corpo do errorResponse(403), mas o cliente
// precisa saber que o bloqueio veio do Edge (e nao do servico local).
// Header fixo, sem dado do pedido — so o fato de que bloqueou.
Byte[] wafDeniedResponse(String message) {
    var body = message + "\n"
    var out = "HTTP/1.1 403 Forbidden\r\n"
    out = out + "X-KofCloud-WAF: blocked\r\n"
    out = out + "Content-Type: text/plain; charset=utf-8\r\n"
    out = out + "Content-Length: " + intToString(body.length) + "\r\n"
    out = out + "Connection: close\r\n"
    out = out + "\r\n"
    out = out + body
    return bytesFromString(out)
}

String statusReason(Int status) {
    if (status == 400) {
        return "Bad Request"
    }
    if (status == 401) {
        return "Unauthorized"
    }
    if (status == 404) {
        return "Not Found"
    }
    if (status == 413) {
        return "Payload Too Large"
    }
    if (status == 429) {
        return "Too Many Requests"
    }
    if (status == 431) {
        return "Request Header Fields Too Large"
    }
    if (status == 502) {
        return "Bad Gateway"
    }
    if (status == 503) {
        return "Service Unavailable"
    }
    if (status == 504) {
        return "Gateway Timeout"
    }
    return "Error"
}
