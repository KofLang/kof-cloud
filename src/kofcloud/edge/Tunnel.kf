package kofcloud.edge

import kofcloud.control.Registry
import kofcloud.control.ControlPlane
import kofcloud.edge.Metrics
import kofcloud.identity.Keys
import kofcloud.model.Device
import kofcloud.protocol.Bytes
import kofcloud.protocol.Frame
import kofcloud.protocol.LineCodec
import kofcloud.protocol.Session
import kofcloud.protocol.Tunnel
import kofcloud.protocol.Version
import kofcloud.util.Limits
import kofcloud.util.Limits
import kofcloud.util.Text

// Listener de tuneis: aceita Agents. Cada conexao vira uma TunnelSession.
//
// O Conn nunca e guardado numa classe (L1): vive como parametro de funcao e
// captura de closure; o estado compartilhado fica na TunnelSession.

// O accept bloqueia; a unica forma de interromper e fechar o Listener. Com um
// arquivo-sentinela, um watcher fecha o listener e o accept lanca, encerrando
// o loop — parada limpa, sem depender de sinais (Kof nao os expoe).
void serveTunnel(EdgeState state, Int port, String tunnelSecret, String stopFile) {
    var listener = net.listen(port)
    if (stopFile.length > 0) {
        var watcher = spawn { listenerWatcher(listener, stopFile) }
    }
    var open = true
    while (open) {
        try {
            var conn = listener.accept()
            var worker = spawn { handleTunnelConnection(state, conn, tunnelSecret) }
        } catch (String e) {
            open = false
        }
    }
}

void listenerWatcher(Listener listener, String stopFile) {
    var open = true
    while (open) {
        time.sleep(stopFilePollMs())
        if (File(stopFile).exists()) {
            listener.close()
            open = false
        }
    }
}

void handleTunnelConnection(EdgeState state, Conn conn, String tunnelSecret) {
    var codec = LineCodec()
    var helloLine = ""
    var alive = true
    while (helloLine == "" && alive) {
        var chunk = conn.receive(receiveChunkBytes())
        if (chunk.length == 0) {
            alive = false
        } else {
            codec.feed(chunk)
            if (codec.overflowed()) {
                // HELLO gigante: fecha sem responder (fail-closed).
                conn.close()
                noteTunnelRefused("LINE_OVERFLOW")
                return
            }
            helloLine = codec.nextLine()
        }
    }
    if (alive == false) {
        conn.close()
        return
    }

    var hello = decodeFrame(helloLine)
    var deviceId = frameField(hello, "deviceId")
    var token = frameField(hello, "token")
    var clientPub = frameField(hello, "clientPub")

    if (frameInt(hello, "v") != protocolVersion()) {
        refuseTunnel(state, conn, "VERSION_UNSUPPORTED")
        return
    }
    var device = state.registry.deviceById(deviceId)
    if (device == null) {
        refuseTunnel(state, conn, "DEVICE_UNKNOWN")
        return
    }
    if (deviceIsActive(device) == false) {
        if (deviceIsSuspended(device)) {
            refuseTunnel(state, conn, "DEVICE_SUSPENDED")
        } else {
            refuseTunnel(state, conn, "DEVICE_REVOKED")
        }
        return
    }
    var account = state.registry.accountByToken(token)
    if (account == null) {
        refuseTunnel(state, conn, "AUTH_FAILED")
        return
    }
    if (account.id != device.accountId) {
        refuseTunnel(state, conn, "AUTH_FAILED")
        return
    }

    var sessionId = state.newSessionId()
    var sessionKey = ""
    var serverPub = ""
    if (tunnelSecret.length > 0 && clientPub.length > 0) {
        var pair = generateKeyPair()
        serverPub = pair.publicKey
        sessionKey = deriveSessionKey(pair.privateKey, clientPub, sessionId, tunnelInfo())
    }

    var session = TunnelSession(sessionId, deviceId, account.id, sessionKey)
    state.bind(deviceId, session)
    state.registry.touchDevice(deviceId)

    conn.send(bytesFromString(encodeFrame(welcomeFrame(true, "", sessionId, serverPub, limitHeartbeatMs()))))
    session.send(servicesFrame(serviceListJson(state.registry.servicesForDevice(deviceId))))
    noteTunnelAccepted(state.onlineCount())

    var writer = spawn { tunnelWriter(conn, session) }
    var idleSweeper = spawn { tunnelIdleSweeper(state, session, deviceId, sessionId) }

    var reader = LineCodec()
    var open = true
    while (open) {
        var chunk = conn.receive(receiveChunkBytes())
        if (chunk.length == 0) {
            open = false
        } else {
            reader.feed(chunk)
            if (reader.overflowed()) {
                open = false
            } else {
                            while (reader.hasLine()) {
                    var line = reader.nextLine()
                    if (line.length > 0) {
                        open = handleTunnelFrame(state, session, line)
                    }
                }
            }
        }
    }

    state.unbind(deviceId, sessionId)
    session.close()
    conn.close()
    noteTunnelClosed(state.onlineCount())
    await writer
    // Sem await no sweeper: fire-and-forget como as demais tasks auxiliares
    // (ele termina sozinho quando session.open cai).
}

// Varredura de ociosidade: a cada ~heartbeat, derruba a sessao se passar do
// idle SEM frames uteis (PING nao conta — ver session.touch) e encerra com
// RESET os streams presos sem END. Fail-closed sem thread exclusiva por
// sessao: polling curto na mesma task do tunel, sem relogio por stream.
// O Agent reconecta sozinho; o Edge limpa a rota via unbind.
void tunnelIdleSweeper(EdgeState state, TunnelSession session, String deviceId, String sessionId) {
    var open = true
    while (open) {
        time.sleep(limitIdleSweepMs())

        if (session.open == false) {
            open = false
        } else {
            if (session.idleMs() > state.tunnelIdleMs) {
                state.unbind(deviceId, sessionId)
                session.close()
                noteTunnelRefused("IDLE_TIMEOUT")
                noteEdgeIdleTimeoutIncident(state)
                open = false
            } else {
                for (var streamId in session.idleStreams(state.streamIdleMs)) {
                    session.send(resetFrame(streamId, "IDLE_TIMEOUT"))
                    session.closeStream(streamId)
                }
            }
        }
    }
}

Bool handleTunnelFrame(EdgeState state, TunnelSession session, String line) {
    // Enforcement continuo: se o device foi suspenso/revogado depois do
    // handshake, o proximo frame (inclusive PING de heartbeat) derruba a
    // sessao. O Agent reconecta, o HELLO e recusado (fatal) e ele para.
    // O PING vira assim o mecanismo de enforcement em ate um heartbeat.
    var device = state.registry.deviceById(session.deviceId)
    if (device == null) {
        return false
    }
    if (deviceIsActive(device) == false) {
        return false
    }
    var frame = decodeFrame(line)
    var kind = frameKind(frame)
    if (kind == "PING") {
        session.send(pongFrame())
        return true
    }
    if (kind == "GOAWAY") {
        return false
    }
    // Atividade util: qualquer frame nao-PING renova o idle da sessao.
    session.touch()
    if (kind == "STATUS") {
        state.registry.setServiceStatusByName(session.deviceId, frameField(frame, "service"), frameField(frame, "status"))
        return true
    }
    if (kind == "DATA") {
        session.deliver(frameField(frame, "s"), frameField(frame, "d"))
        return true
    }
    if (kind == "END") {
        session.deliver(frameField(frame, "s"), streamEndMarker())
        return true
    }
    if (kind == "RESET") {
        session.deliver(frameField(frame, "s"), streamResetMarker())
        return true
    }
    // OPENED nunca e ignorado: e o handshake por stream. O relay espera por
    // ele antes de enviar DATA; sem isso, um OPEN recusado (Agent sem o
    // servico, limite no Agent) deixaria o relay bloqueado para sempre
    // esperando resposta que nunca vem.
    if (kind == "OPENED") {
        session.deliver(frameField(frame, "s"), openedMarker(frame))
        return true
    }
    // Desconhecidos: ignorados (forward-compat).
    return true
}

void tunnelWriter(Conn conn, TunnelSession session) {
    var open = true
    while (open) {
        var item = session.outbox.receive()
        if (item == streamCloseMarker()) {
            open = false
        } else {
            conn.send(bytesFromString(item))
        }
    }
    conn.close()
}

void refuseTunnel(EdgeState state, Conn conn, String reason) {
    conn.send(bytesFromString(encodeFrame(welcomeFrame(false, reason, "", "", 0))))
    conn.close()
    noteTunnelRefused(reason)
    noteEdgeRefusalIncident(state)
}

// Detector de recusas no Edge (Fase 17 slice 1). Amostra por processo e so
// para ABRIR o incidente global (idempotente no Registry): um Edge sadio
// recusa poucas vezes; rajada (>= limite na janela) e sinal de problema.
// Estado local em vez de anel global: cada sonda tem sua janela.
Int edgeRefusalThreshold() {
    return limitEdgeRefusalThreshold()
}

Long edgeRefusalWindowMs() {
    return limitEdgeRefusalWindowMs()
}

// Abuse prevention: rajada de 401 no Edge (forca bruta de `kfs_`). Mesmas
// garantias da sonda de recusas. Limiar/janela proprios porque 401 honesto
// (token vencido, cliente em loop de configuracao) e mais comum que recusa
// de tunel.
Int edgeAuthFailureThreshold() {
    return limitEdgeAuthFailureThreshold()
}

Long edgeAuthFailureWindowMs() {
    return limitEdgeAuthFailureWindowMs()
}

// Edge sem heartbeat: quedas por ociosidade na janela. Limiar/janela
// proprios porque uma queda isolada e esperada (Agent parado).
Int edgeIdleTimeoutThreshold() {
    return limitEdgeIdleTimeoutThreshold()
}

Long edgeIdleTimeoutWindowMs() {
    return limitEdgeIdleTimeoutWindowMs()
}

// Sonda de janela deslizante simples (contador + inicio). Uma instancia por
// sinal: recusas de tunel e falhas de autenticacao nao dividem contador.
class RateProbe {
    Int count
    Long windowStart

    constructor() {
        this.count = 0
        this.windowStart = time.now()
    }
}

// Conta uma ocorrencia e diz se o limiar foi atingido DENTRO da janela.
// Fonte unica dos detectores do Edge: o reset e o incremento vivem aqui,
// entao um deles nao pode esquecer o reset e nunca abrir o incidente.
Bool probeHit(RateProbe probe, Int threshold, Long windowMs) {
    var now = time.now()
    if (now - probe.windowStart > windowMs) {
        probe.count = 0
        probe.windowStart = now
    }
    probe.count = probe.count + 1
    return probe.count == threshold
}

void noteEdgeRefusalIncident(EdgeState state) {
    if (probeHit(state.refusalProbe, edgeRefusalThreshold(), edgeRefusalWindowMs())) {
        state.registry.raiseIncident(incidentEdgeRefusals(), "")
    }
}

// Registrado so quando o Edge responde 401 (token ausente ou de outro
// servico). Nao carrega hostname, token nem caminho: o incidente e global.
void noteEdgeAuthFailureIncident(EdgeState state) {
    if (probeHit(state.authFailureProbe, edgeAuthFailureThreshold(), edgeAuthFailureWindowMs())) {
        state.registry.raiseIncident(incidentEdgeAuthFailures(), "")
    }
}

// "Edge sem heartbeat": o sweeper derruba a sessao que passou do idle so
// com PING. Uma queda isolada e rotina; quedas repetidas na janela sao um
// Agent preso em reconexao (cada reconexao volta muda e cai de novo).
// Mesmo mecanismo das outras sondas; sinal proprio e global (sem device).
void noteEdgeIdleTimeoutIncident(EdgeState state) {
    if (probeHit(state.idleTimeoutProbe, edgeIdleTimeoutThreshold(), edgeIdleTimeoutWindowMs())) {
        state.registry.raiseIncident(incidentEdgeIdleTimeouts(), "")
    }
}
