package kofcloud.edge

import kofcloud.control.Registry
import kofcloud.model.Service
import kofcloud.protocol.Session
import kofcloud.util.Limits
import kofcloud.util.Text

// Estado do Edge: registro de rotas (control plane) + sessoes de tunel vivas.

class EdgeState {
    Registry registry
    Map<String, TunnelSession> sessions
    Int sessionCounter
    Int httpLimit
    Int httpWindowMs
    Long tunnelIdleMs
    Long streamIdleMs
    Map<String, String> serviceConns
    Int serviceConnLimit
    Int bodyLimit
    Int responseLimit
    Int cancelledStreams
    // Conexoes publicas abertas agora (uma task por conexao). `Int` simples:
    // a contagem e do processo, sem chave — nao precisa de mapa.
    Int publicConns
    Int publicConnLimit
    Int upstreamWaitMs
    // Tres sondas independentes (Fase 17 slice 1 + abuse prevention): recusas
    // de tunel, falhas de autenticacao e quedas por ociosidade nao podem
    // dividir contador, senao uma rajada de 401 (ou um Agent em loop de
    // reconexao) disfarcaria as outras e vice-versa.
    RateProbe refusalProbe
    RateProbe authFailureProbe
    RateProbe idleTimeoutProbe
    Bool wafEnforce

    constructor(registry: Registry) {
        this.registry = registry
        this.sessions = mapOf()
        this.sessionCounter = 0
        this.httpLimit = limitHttpRequests()
        this.httpWindowMs = limitHttpWindowMs()
        this.tunnelIdleMs = limitTunnelIdleMs()
        this.streamIdleMs = limitStreamIdleMs()
        this.serviceConns = mapOf()
        this.serviceConnLimit = limitServiceConns()
        this.bodyLimit = limitHttpBodyBytes()
        this.responseLimit = limitMaxResponseBytes()
        this.cancelledStreams = 0
        this.publicConns = 0
        this.publicConnLimit = limitPublicConns()
        this.upstreamWaitMs = limitTunnelIdleMs()
        this.refusalProbe = RateProbe()
        this.authFailureProbe = RateProbe()
        this.idleTimeoutProbe = RateProbe()
        this.wafEnforce = false
    }

    // Permite ligar o enforce WAF sem config de processo (o default e
    // detectar: conta e segue). O `serve --waf=enforce` e outro incremento;
    // o nucleo (EdgeState + HttpFront) nao depende da flag.
    void setWafEnforce(Bool enforce) {
        this.wafEnforce = enforce
    }

    Bool wafEnforcing() {
        return this.wafEnforce
    }

    // Permite aos testes fixarem o timeout de upstream sem config de processo.
    void setUpstreamTimeoutMs(Int ms) {
        this.upstreamWaitMs = ms
    }

    Int upstreamTimeoutMs() {
        return this.upstreamWaitMs
    }

    // Permite aos testes fixarem o teto de corpo sem config de processo.
    void setBodyLimit(Int limit) {
        this.bodyLimit = limit
    }

    Int bodyLimitBytes() {
        return this.bodyLimit
    }

    // Permite aos testes fixarem o teto de resposta sem config de processo.
    void setResponseLimit(Int limit) {
        this.responseLimit = limit
    }

    Int responseLimitBytes() {
        return this.responseLimit
    }

    // Streams cancelados pelo Edge (resposta acima do teto). Contador de
    // eventos, nunca de conteudo: alimenta a metrica `_response_too_large`.
    void noteStreamCancelled() {
        this.cancelledStreams = this.cancelledStreams + 1
    }

    Int cancelledCount() {
        return this.cancelledStreams
    }

    // Permite aos testes fixarem o teto sem config de processo.
    void setPublicConnLimit(Int limit) {
        if (limit > 0) {
            this.publicConnLimit = limit
        }
    }

    Int publicConnLimitValue() {
        return this.publicConnLimit
    }

    Int publicConnCount() {
        return this.publicConns
    }

    // Reserva uma vaga de conexao publica. False = teto atingido: o chamador
    // responde 503 KCF117 e fecha, ANTES de ler o pedido (nao aloca buffer
    // nem stream). Sempre pareado com releasePublicConn no fim da task.
    Bool tryAcquirePublicConn() {
        if (this.publicConns >= this.publicConnLimit) {
            return false
        }
        this.publicConns = this.publicConns + 1
        return true
    }

    void releasePublicConn() {
        if (this.publicConns > 0) {
            this.publicConns = this.publicConns - 1
        }
    }

    // Permite aos testes fixarem o limite sem config de processo.
    void setServiceConnLimit(Int limit) {
        this.serviceConnLimit = limit
    }

    Int serviceConnOpen(String serviceId) {
        var current = this.serviceConns.get(serviceId)
        if (current == null) {
            return 0
        }
        return parseIntSafe(current, 0)
    }

    // Tenta reservar uma vaga de relay para o servico. False = cheio (429).
    Bool tryAcquireServiceConn(String serviceId) {
        if (this.serviceConnOpen(serviceId) >= this.serviceConnLimit) {
            return false
        }
        var opened = this.serviceConnOpen(serviceId)
        this.serviceConns.put(serviceId, intToString(opened + 1))
        return true
    }

    void releaseServiceConn(String serviceId) {
        var current = this.serviceConnOpen(serviceId)
        if (current > 1) {
            this.serviceConns.put(serviceId, intToString(current - 1))
        } else {
            this.serviceConns.remove(serviceId)
        }

    }

    // Permite aos testes fixarem o limite sem config de processo.
    void setHttpLimits(Int requests, Int windowMs) {
        this.httpLimit = requests
        this.httpWindowMs = windowMs
    }

    // Permite aos testes forcarem ociosidade curta sem esperar o default.
    void setIdleMs(Long tunnelMs, Long streamMs) {
        this.tunnelIdleMs = tunnelMs
        this.streamIdleMs = streamMs
    }

    // Conexoes em relay por servico (serviceId -> abertas). Contagem
    // aproximada sob corrida (ver Limits.limitServiceConns): o pior caso e
    // estourar em poucas unidades, nunca recusar a menos nem travar.

    // Rate limit por hostname solicitado (fixed-window do stdlib). Recusar
    // cedo: antes de rotear, autorizar ou tocar no tunel — o 429 nao revela
    // nada sobre o servico e nao consome recurso downstream.
    // A janela vai em SEGUNDOS (unidade do stdlib, fonte unica da conversao em
    // `httpWindowSeconds`): antes `httpWindowMs` ia direto, e o default de
    // 60 s virava 60.000 s de bloqueio por hostname.
    Bool checkHttpLimit(String host) {
        return security.rateLimit("kofcloud-edge-host:" + host, this.httpLimit, httpWindowSeconds(this.httpWindowMs))
    }

    // Segundos ate a janela expirar, arredondados PARA CIMA: o cliente que
    // volta em `Retry-After` nunca bate na mesma janela por arredondamento.
    // Janela zerada/invalida recai no default (mesma regra do
    // `httpWindowSeconds`), senao o 429 sairia sem recuo util.
    Int httpRetryAfterSec() {
        return httpWindowSeconds(this.httpWindowMs) + 1
    }

    String newSessionId() {
        this.sessionCounter = this.sessionCounter + 1
        return "sess-" + intToString(this.sessionCounter) + "-" + crypto.randomHex(4)
    }

    void bind(String deviceId, TunnelSession session) {
        this.sessions.put(deviceId, session)
        this.registry.noteEdgeOnline(deviceId, true)
    }

    void unbind(String deviceId, String sessionId) {
        var current = this.sessions.get(deviceId)
        if (current != null) {
            if (current.sessionId == sessionId) {
                this.sessions.remove(deviceId)
                this.registry.noteEdgeOnline(deviceId, false)
            }
        }
    }

    TunnelSession? sessionFor(String deviceId) {
        return this.sessions.get(deviceId)
    }

    Bool isOnline(String deviceId) {
        return this.sessions.get(deviceId) != null
    }

    Int onlineCount() {
        return this.sessions.size
    }

    // Resolve uma rota publica pelo hostname. Devolve null para host
    // desconhecido OU servico nao roteavel (PRIVATE nunca revela existencia).
    Service? route(String hostname) {
        return this.registry.resolveRoute(hostname)
    }

    // Autorizacao de servico AUTHENTICATED: o token apresentado e um token de
    // SERVICO (kfs_) e precisa pertencer exatamente a este servico. O token da
    // conta NAO vale aqui — ele autoriza administracao, nao acesso publico.
    Bool authorize(Service service, String token) {
        if (token.length == 0) {
            return false
        }
        var owner = this.registry.serviceByServiceToken(token)
        if (owner == null) {
            return false
        }
        return owner.id == service.id
    }
}
