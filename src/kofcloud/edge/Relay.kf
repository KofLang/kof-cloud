package kofcloud.edge

import kofcloud.protocol.Bytes
import kofcloud.protocol.Payload
import kofcloud.protocol.Session
import kofcloud.protocol.Tunnel
import kofcloud.util.Limits

// Relay de uma requisicao publica por um stream do tunel.
//
// O Edge abre um stream, espera o handshake (OPENED), envia DATA(req) + END,
// e acumula os DATA de volta ate END. A resposta e devolvida como bytes.
// Esperar o OPENED fecha um buraco real: antes, OPEN recusado (Agent sem o
// servico — ex. publicado apos o connect) deixava o relay bloqueado para
// sempre esperando resposta, prendendo a vaga de conexao junto.
//
// Timeout de upstream (WAF 2b): `receive` bloqueia e nao ha recv com prazo no
// Kof — um deadline checado antes do receive nunca dispara. Mesmo mecanismo
// do sweeper de idle: uma task watchdog entrega `RESET IDLE_TIMEOUT` na fila
// DO stream quando passa `timeoutMs` sem DATA; isso acorda o receive. O
// `open` compartilhado impede o watchdog de tocar a fila depois que o relay
// terminou (sessao anti-orphan, como no sweeper do tunel).
// `overflowed`: a resposta passou do teto do relay. O stream ja foi cancelado
// (RESET STREAM_TOO_LARGE) e `bytes` deve ser DESCARTAVEL — antes o Edge
// parava de acumular e devolvia o parcial como se fosse a resposta inteira.
record RelayResult(Byte[] bytes, Bool timedOut, Bool overflowed)

RelayResult relayThroughTunnel(TunnelSession session, String serviceName, Byte[] requestBytes, Int maxBytes, Int timeoutMs, Bool[] finished) {
    var streamId = session.openStream()
    if (streamId.length == 0) {
        throw "LIMIT_EXCEEDED"
    }
    session.send(openFrame(streamId, serviceName))
    if (timeoutMs > 0) {
        var watchdog = spawn { relayWatchdog(session, streamId, timeoutMs, finished) }
    }
    try {
        var handshake = session.nextFromStream(streamId)
        if (handshake == streamResetMarker()) {
            throw "stream reset by agent"
        }
        if (handshake == streamEndMarker() || openedAccepted(handshake) == false) {
            throw "OPEN_REJECTED:" + openedReason(handshake)
        }
        for (var chunk in encodeChunks(requestBytes, session.sessionKey)) {
            session.send(dataFrame(streamId, chunk))
        }
        session.send(endFrame(streamId))

        var acc = bytesEmpty()
        var open = true
        while (open) {
            var item = session.nextFromStream(streamId)
            if (item == streamEndMarker()) {
                open = false
            } else if (item == streamResetMarker()) {
                open = false
                throw "stream reset by agent"
            } else if (item == streamTimeoutMarker()) {
                finished[0] = true
                return RelayResult(acc, true, false)
            } else {
                acc = bytesConcat(acc, decodePayload(item, session.sessionKey))
                session.markStreamProgress(streamId)
                if (acc.length > maxBytes) {
                    // Teto estourado: cancela dos dois lados e para de ler.
                    // Os bytes parciais nao sao devolvidos (seriam um corpo
                    // cortado com status 200).
                    session.cancelStream(streamId, "STREAM_TOO_LARGE")
                    return RelayResult(bytesEmpty(), false, true)
                }
            }
        }
        return RelayResult(acc, false, false)
    } finally {
        finished[0] = true
        session.closeStream(streamId)
    }
}

// Entrega RESET no stream se ele ficar `timeoutMs` sem progresso. Polling
// curto (mesmo passo do sweeper): cada DATA renova o prazo. Sai quando o
// relay sinaliza `finished` (nada e entregue depois disso).
void relayWatchdog(TunnelSession session, String streamId, Int timeoutMs, Bool[] finished) {
    var running = true
    while (running) {
        time.sleep(limitIdleSweepMs())
        if (finished[0]) {
            running = false
        } else if (session.streamIdleFor(streamId) > timeoutMs) {
            session.deliver(streamId, streamTimeoutMarker())
            running = false
        }
    }
}
