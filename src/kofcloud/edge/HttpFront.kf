package kofcloud.edge

import kofcloud.edge.Http
import kofcloud.edge.Metrics
import kofcloud.edge.Relay
import kofcloud.model.Errors
import kofcloud.model.Service

import kofcloud.util.Hosts
import kofcloud.util.Text

// Listener publico HTTP/1.1 do Edge.
//
// Aceita a conexao, le a requisicao inteira, resolve a rota pelo Host,
// repassa pelo tunel e escreve a resposta. Sem keep-alive no MVP: cada
// requisicao e uma conexao (determinismo do "fim da resposta").

void serveHttp(EdgeState state, Int port, Int maxBytes, String stopFile) {
    var listener = net.listen(port)
    if (stopFile.length > 0) {
        var watcher = spawn { listenerWatcher(listener, stopFile) }
    }
    var open = true
    while (open) {
        try {
            var conn = listener.accept()
            var worker = spawn { handlePublicConnection(state, conn, maxBytes) }
        } catch (String e) {
            open = false
        }
    }
}

void handlePublicConnection(EdgeState state, Conn conn, Int maxBytes) {
    var started = time.now()
    var raw = readRequestBytes(conn, maxBytes)
    if (raw.length == 0) {
        conn.close()
        return
    }
    var request = parseRequest(raw)
    var host = hostOnly(headerValue(request.headers, "host"))
    // Rate limit ANTES de rotear/autorizar/tocar no tunel: o 429 nao revela
    // nada sobre o servico (existe? qual exposicao?) e nao consome recurso
    // downstream. Chave = hostname (o Edge TCP nao expoe IP de origem).
    if (state.checkHttpLimit(host) == false) {
        var limited = rateLimitedResponse(errRateLimited(), state.httpRetryAfterSec())
        conn.send(limited)
        conn.close()
        noteHttpFinished("denied", "KCF107", raw.length, limited.length, time.now() - started)
        return
    }
    var service = state.route(host)
    if (service == null) {
        // Opaco: host desconhecido e servico nao roteavel (PRIVATE) respondem
        // o mesmo 404 sem revelar qual dos dois aconteceu.
        var notFound = errorResponse(404, errNoRoute())
        conn.send(notFound)
        conn.close()
        noteHttpFinished("denied", "KCF100", raw.length, notFound.length, time.now() - started)
        return
    }
    if (service.exposure == "AUTHENTICATED") {
        var provided = bearerFrom(headerValue(request.headers, "authorization"))
        if (state.authorize(service, provided) == false) {
            var deny = unauthorizedResponse(errAuthRequired())
            conn.send(deny)
            conn.close()
            noteHttpFinished("denied", "KCF101", raw.length, deny.length, time.now() - started)
            return
        }
    }
    var session = state.sessionFor(service.deviceId)
    if (session == null) {
        var offline = errorResponse(503, errDeviceOffline())
        conn.send(offline)
        conn.close()
        noteHttpFinished("denied", "KCF102", raw.length, offline.length, time.now() - started)
        return
    }
    // Enforcement imediato: device suspenso/revogado depois do handshake nao
    // roteia mais — derruba a sessao aqui (o PING faria o mesmo em ate um
    // heartbeat). Resposta opaca: para o cliente, o device esta offline.
    var owner = state.registry.deviceById(service.deviceId)
    if (owner == null) {
        state.unbind(service.deviceId, session.sessionId)
        session.close()
        var gone = errorResponse(503, errDeviceOffline())
        conn.send(gone)
        conn.close()
        noteHttpFinished("denied", "KCF102", raw.length, gone.length, time.now() - started)
        return
    }
    var ownerStatus = owner.status
    if (ownerStatus != "ACTIVE") {
        state.unbind(service.deviceId, session.sessionId)
        session.close()
        var gone = errorResponse(503, errDeviceOffline())
        conn.send(gone)
        conn.close()
        noteHttpFinished("denied", "KCF102", raw.length, gone.length, time.now() - started)
        return
    }
    if (statusIsRoutable(service.status) == false) {
        var down = errorResponse(503, errServiceDown(service.name, service.status))
        conn.send(down)
        conn.close()
        noteHttpFinished("denied", "KCF103", raw.length, down.length, time.now() - started)
        return
    }
    var dropCredential = service.exposure == "AUTHENTICATED"
    var forwarded = serializeRequest(request, "edge", dropCredential)
    // Vaga de relay por servico: o recurso caro (tunel + servico local).
    // Recusar AQUI (antes do OPEN) nao consome stream nem toca no Agent.
    if (state.tryAcquireServiceConn(service.id) == false) {
        var busy = rateLimitedResponse(errServiceOverloaded(), state.httpRetryAfterSec())
        conn.send(busy)
        conn.close()
        noteHttpFinished("denied", "KCF108", raw.length, busy.length, time.now() - started)
        return
    }
    var responseBytes = bytesEmpty()
    try {
        noteStreamOpened()
        responseBytes = relayThroughTunnel(session, service.name, forwarded, maxBytes)
    } catch (String e) {
        state.releaseServiceConn(service.id)
        if (e == "LIMIT_EXCEEDED") {
            var limited = errorResponse(429, errTooManyStreams())
            conn.send(limited)
            conn.close()
            noteHttpFinished("denied", "KCF106", raw.length, limited.length, time.now() - started)
        } else {
            var failed = errorResponse(502, errTunnel(e))
            conn.send(failed)
            conn.close()
            noteHttpFinished("upstream_error", "", raw.length, failed.length, time.now() - started)
        }
        return
    }
    state.releaseServiceConn(service.id)
    if (responseBytes.length == 0) {
        var empty = errorResponse(502, errEmptyUpstream())
        conn.send(empty)
        conn.close()
        noteHttpFinished("upstream_error", "", raw.length, empty.length, time.now() - started)
        return
    }
    conn.send(responseBytes)
    conn.close()
    noteHttpFinished("ok", "", raw.length, responseBytes.length, time.now() - started)
}

String bearerFrom(String authorization) {
    if (authorization.length == 0) {
        return ""
    }
    var lower = authorization.toLowerCase()
    if (lower.startsWith("bearer ")) {
        return authorization.substring(7).trim()
    }
    return authorization.trim()
}
