package kofcloud.edge

import kofcloud.edge.Http
import kofcloud.edge.Metrics
import kofcloud.edge.Relay
import kofcloud.model.Device
import kofcloud.model.Errors
import kofcloud.model.Exposure
import kofcloud.model.Service
import kofcloud.protocol.Bytes

import kofcloud.util.Hosts
import kofcloud.util.Text

// Listener publico HTTP/1.1 do Edge.
//
// Aceita a conexao, le a requisicao inteira, resolve a rota pelo Host,
// repassa pelo tunel e escreve a resposta. Sem keep-alive no MVP: cada
// requisicao e uma conexao (determinismo do "fim da resposta").

void serveHttp(EdgeState state, Int port, Int maxBytes, String stopFile) {
    var listener = net.listen(port)
    if (stopFile.length > 0) {
        var watcher = spawn { listenerWatcher(listener, stopFile) }
    }
    var open = true
    while (open) {
        try {
            var conn = listener.accept()
            // Teto de conexoes simultaneas (docs/10-edge.md): recusa AQUI,
            // antes de spawnar a task e sem ler o pedido. Sem isso, uma
            // rajada de conexoes abertas e ociosas consome uma task e um
            // socket por conexao ate exaurir a maquina.
            if (state.tryAcquirePublicConn() == false) {
                refusePublicConnection(conn)
                notePublicConnRefused()
            } else {
                var worker = spawn { handlePublicConnection(state, conn, maxBytes) }
            }
        } catch (String e) {
            open = false
        }
    }
}

void handlePublicConnection(EdgeState state, Conn conn, Int maxBytes) {
    try {
        servePublicConnection(state, conn, maxBytes)
    } finally {
        // A vaga e liberada em TODOS os caminhos (resposta, erro, throw).
        // Sem finally, uma excecao no relay vazaria a vaga para sempre e o
        // Edge acabaria recusando todo mundo.
        state.releasePublicConn()
    }
}

// Recusa por teto de conexoes: 503 (o servico pode voltar) sem ler nada.
void refusePublicConnection(Conn conn) {
    try {
        conn.send(errorResponse(503, errTooManyPublicConns()))
    } catch (String e) {
        // Cliente ja saiu; nada a fazer.
    }
    conn.close()
}

void servePublicConnection(EdgeState state, Conn conn, Int maxBytes) {
    var started = time.now()
    var read = readRequestBytes(conn, maxBytes)
    var raw = read.bytes
    if (raw.length == 0) {
        conn.close()
        return
    }
    // Sem `\r\n\r\n` dentro do teto de cabecalhos: e lixo ou cabecalho
    // gigante. Antes, parseRequest recebia o bloco inteiro como "cabecalho"
    // e o relay repassava o excedente ao servico local — ou seja, o nome
    // `maxBytes` prometia um teto que nao existia.
    if (bytesIndexOf(raw, "\r\n\r\n", 0) < 0) {
        var tooBig = errorResponse(431, errHeaderTooLarge())
        conn.send(tooBig)
        conn.close()
        noteHttpFinished("denied", "KCF116", raw.length, tooBig.length, time.now() - started)
        return
    }
    var request = parseRequest(raw)
    // `/.well-known/security.txt` ANTES de tudo (rate limit, roteamento,
    // auth): politica de seguranca legivel por maquina, sem conta, sem
    // tunel, sem tocar em servico local. Sem rate limit de proposito —
    // scanner legitimo nao deve ser contido nem contar como ataque. O path
    // e canonico (ver securityTxtBody); query nao muda nada (parseRequest
    // separa path de query — ver Http.kf).
    if (request.method == "GET" && request.path == "/.well-known/security.txt") {
        var txt = securityTxtResponse()
        conn.send(txt)
        conn.close()
        noteHttpFinished("ok", "", raw.length, txt.length, time.now() - started)
        return
    }
    var host = hostOnly(headerValue(request.headers, "host"))
    // Rate limit ANTES de rotear/autorizar/tocar no tunel: o 429 nao revela
    // nada sobre o servico (existe? qual exposicao?) e nao consome recurso
    // downstream. Chave = hostname (o Edge TCP nao expoe IP de origem).
    if (state.checkHttpLimit(host) == false) {
        var limited = rateLimitedResponse(errRateLimited(), state.httpRetryAfterSec())
        conn.send(limited)
        conn.close()
        noteHttpFinished("denied", "KCF107", raw.length, limited.length, time.now() - started)
        return
    }
    // Corpo que estourou o teto ABSOLUTO de leitura: recusado antes do
    // parsing semantico e antes do relay. Sem isso o Edge acumulava o corpo
    // inteiro (o `Content-Length` declarado mandava) e o 413 de politica so
    // vinha DEPOIS — um limite de politica, nao de leitura. A ordem importa:
    // rate limit primeiro (flood de corpos enormes gasta a cota do hostname,
    // nao vira caminho barato de abuso) e o security.txt acima continua sem
    // rate limit e sem tocar no corpo.
    if (read.overflowed) {
        var bodyOverflow = errorResponse(413, errBodyTooLarge())
        conn.send(bodyOverflow)
        conn.close()
        noteHttpFinished("denied", "KCF110", raw.length, bodyOverflow.length, time.now() - started)
        return
    }
    // Fronteira de corpo ambigua/nao suportada (Content-Length duplicado
    // divergente, nao numerico, ou Transfer-Encoding): 400 antes de rotear.
    // Sem isso o Edge repassava ao servico local um Content-Length diferente
    // do corpo enviado (request smuggling) ou um header chunked que o servico
    // esperaria indefinidamente. A leitura ja parou no teto de bytes, entao
    // este 400 nao depende de consumir o corpo.
    if (read.badLength) {
        var badBoundary = errorResponse(400, errInvalidContentLength())
        conn.send(badBoundary)
        conn.close()
        noteHttpFinished("denied", "KCF118", raw.length, badBoundary.length, time.now() - started)
        return
    }
    // Host ambiguo (ausente, duplicado ou com caractere invalido): recusa
    // antes de rotear. O Edge repassa o pedido reconstruido ao servico local;
    // se roteia por um Host e entrega outro, o roteamento vira sugestao — um
    // `Host: evil.example.com` extra chegava a aplicacao. Mesma ordem do
    // enquadramento: rate limit antes (o flood paga a cota do hostname).
    if (hostIsUnambiguous(request.headers) == false) {
        var badHost = errorResponse(400, errInvalidHost())
        conn.send(badHost)
        conn.close()
        noteHttpFinished("denied", "KCF119", raw.length, badHost.length, time.now() - started)
        return
    }
    var service = state.route(host)
    if (service == null) {
        // Opaco: host desconhecido e servico nao roteavel (PRIVATE) respondem
        // o mesmo 404 sem revelar qual dos dois aconteceu.
        var notFound = errorResponse(404, errNoRoute())
        conn.send(notFound)
        conn.close()
        noteHttpFinished("denied", "KCF100", raw.length, notFound.length, time.now() - started)
        return
    }
    if (exposureRequiresAuth(service.exposure)) {
        var provided = bearerFrom(headerValue(request.headers, "authorization"))
        if (state.authorize(service, provided) == false) {
            // Sinal de abuse prevention: token ausente/errado e o que uma
            // forca bruta de `kfs_` produz. Conta o fato (nunca o token, o
            // host nem o path) e abre incidente global na rajada.
            noteEdgeAuthFailureIncident(state)
            var deny = unauthorizedResponse(errAuthRequired())
            conn.send(deny)
            conn.close()
            noteHttpFinished("denied", "KCF101", raw.length, deny.length, time.now() - started)
            return
        }
    }
    var session = state.sessionFor(service.deviceId)
    if (session == null) {
        var offline = errorResponse(503, errDeviceOffline())
        conn.send(offline)
        conn.close()
        noteHttpFinished("denied", "KCF102", raw.length, offline.length, time.now() - started)
        return
    }
    // Enforcement imediato: device suspenso/revogado depois do handshake nao
    // roteia mais — derruba a sessao aqui (o PING faria o mesmo em ate um
    // heartbeat). Resposta opaca: para o cliente, o device esta offline.
    var owner = state.registry.deviceById(service.deviceId)
    if (owner == null) {
        state.unbind(service.deviceId, session.sessionId)
        session.close()
        var gone = errorResponse(503, errDeviceOffline())
        conn.send(gone)
        conn.close()
        noteHttpFinished("denied", "KCF102", raw.length, gone.length, time.now() - started)
        return
    }
    if (deviceIsActive(owner) == false) {
        state.unbind(service.deviceId, session.sessionId)
        session.close()
        var gone = errorResponse(503, errDeviceOffline())
        conn.send(gone)
        conn.close()
        noteHttpFinished("denied", "KCF102", raw.length, gone.length, time.now() - started)
        return
    }
    if (statusIsRoutable(service.status) == false) {
        var down = errorResponse(503, errServiceDown(service.name, service.status))
        conn.send(down)
        conn.close()
        noteHttpFinished("denied", "KCF103", raw.length, down.length, time.now() - started)
        return
    }
    // WAF slice 2: teto de corpo por requisicao. Checado ANTES do relay (nao
    // consome stream, nao toca no Agent, nao le o corpo). Chaveado por
    // Content-Length DECLARADO — corpo sem Content-Length (transfer-encoding
    // de requisicao) ja foi recusado acima (400 KCF118), entao aqui o valor
    // declarado e a fronteira confiavel do corpo. Comparacao em Long: um
    // valor valido mas acima de 2^31 nao pode virar negativo.
    var declared = parseContentLength(request.headers).value
    if (declared > (state.bodyLimitBytes() as Long)) {
        var tooLarge = errorResponse(413, errBodyTooLarge())
        conn.send(tooLarge)
        conn.close()
        noteHttpFinished("denied", "KCF110", raw.length, tooLarge.length, time.now() - started)
        return
    }
    var dropCredential = exposureRequiresAuth(service.exposure)
    // WAF slice 1: inspeciona metodo+path e corpo pequeno. Default (detectar): CONTA e segue
    // com o relay (nenhum legitimo quebra por construcao). Enforce: casa ->
    // `403 KCF109` antes do relay (sem stream, sem Agent). So o nome do
    // padrao chega a metrica (nunca corpo, path ou hostname).
    var signature = wafDetectSignature(request.method, request.path)
    if (signature.length == 0) {
        // Corpo pequeno tambem e inspecionado (o desenho do slice 1 prometia
        // "corpo pequeno"; so metodo+path deixava POST de formulario passar).
        // Acima de wafBodyInspectBytes() o corpo nao e varrido.
        signature = wafDetectBodySignature(bytesToString(request.body))
    }
    if (signature.length == 0) {
        // Valores de header completam a cobertura (User-Agent/Referer/Cookie
        // carregam payload de scanner). Headers da plataforma ficam fora:
        // ver wafHeaderIgnored (Authorization e credencial, Host e rota).
        signature = wafDetectHeadersSignature(request.headers)
    }
    if (signature.length > 0) {
        noteWafDetected(signature)
        if (state.wafEnforcing()) {
            var denied = wafDeniedResponse(errWafDenied())
            conn.send(denied)
            conn.close()
            noteHttpFinished("denied", "KCF109", raw.length, denied.length, time.now() - started)
            return
        }
    }
    // WAF slice 3: allowlist do servico (fail-closed quando declarada). Listas
    // vazias = servico sem politica, passa tudo (servico legado). Metodo/path
    // nunca chegam ao servico nem ao Agent.
    if (wafAllowCheck(request.method, request.path, splitList(service.allowMethods), splitList(service.allowPaths)) == false) {
        var notAllowed = wafDeniedResponse(errWafAllowDenied())
        conn.send(notAllowed)
        conn.close()
        noteHttpFinished("denied", "KCF111", raw.length, notAllowed.length, time.now() - started)
        return
    }
    var forwarded = serializeRequest(request, "edge", dropCredential)
    // Vaga de relay por servico: o recurso caro (tunel + servico local).
    // Recusar AQUI (antes do OPEN) nao consome stream nem toca no Agent.
    if (state.tryAcquireServiceConn(service.id) == false) {
        var busy = rateLimitedResponse(errServiceOverloaded(), state.httpRetryAfterSec())
        conn.send(busy)
        conn.close()
        noteHttpFinished("denied", "KCF108", raw.length, busy.length, time.now() - started)
        return
    }
    // Teto da resposta: o mesmo numero que o Edge aceita para ler o pedido
    // enquanto o corpo nao foi declarado — assim a promessa "maxBytes" vale
    // nos dois sentidos.
    var responseCap = state.responseLimitBytes()
    if (responseCap <= 0 || responseCap > maxBytes) {
        responseCap = maxBytes
    }
    var responseBytes = bytesEmpty()
    var relayFinished = new Bool[1]
    relayFinished[0] = false
    try {
        noteStreamOpened()
        var relayed = relayThroughTunnel(session, service.name, forwarded, responseCap, state.upstreamTimeoutMs(), relayFinished)
        if (relayed.overflowed) {
            state.releaseServiceConn(service.id)
            state.noteStreamCancelled()
            var tooLarge = errorResponse(502, errResponseTooLarge())
            conn.send(tooLarge)
            conn.close()
            noteHttpFinished("upstream_error", "KCF115", raw.length, tooLarge.length, time.now() - started)
            return
        }
        if (relayed.timedOut) {
            state.releaseServiceConn(service.id)
            if (relayed.bytes.length > 0) {
                // Resposta parcial: entrega o que veio (o Connection: close do
                // Edge delimita o corpo) — corpo curto, nunca 502 com bytes de
                // resposta no meio. Os headers do upstream tambem passam pela
                // sanitizacao: keep-alive anunciado nao pode sobreviver a um
                // corpo que o Edge cortou.
                var partial = sanitizeResponse(relayed.bytes, request.method)
                conn.send(partial)
                conn.close()
                noteHttpFinished("upstream_error", "KCF105", raw.length, partial.length, time.now() - started)
                return
            }
            var timedOut = errorResponse(504, errUpstreamTimeout())
            conn.send(timedOut)
            conn.close()
            noteHttpFinished("upstream_error", "KCF112", raw.length, timedOut.length, time.now() - started)
            return
        }
        responseBytes = relayed.bytes
    } catch (String e) {
        state.releaseServiceConn(service.id)
        if (e == "LIMIT_EXCEEDED") {
            var limited = errorResponse(429, errTooManyStreams())
            conn.send(limited)
            conn.close()
            noteHttpFinished("denied", "KCF106", raw.length, limited.length, time.now() - started)
        } else if (e.indexOf("OPEN_REJECTED") == 0) {
            // Agent nao conhece o servico (ex. publicado apos o connect, antes
            // do refresh): 502 sem vazar nada alem do fato de que a rota existe
            // (o hostname ja resolveu — opacidade mantida para inexistentes).
            var rejected = errorResponse(502, errTunnel("agent does not serve this route yet"))
            conn.send(rejected)
            conn.close()
            noteHttpFinished("upstream_error", "", raw.length, rejected.length, time.now() - started)
        } else {
            var failed = errorResponse(502, errTunnel(e))
            conn.send(failed)
            conn.close()
            noteHttpFinished("upstream_error", "", raw.length, failed.length, time.now() - started)
        }
        return
    }
    state.releaseServiceConn(service.id)
    if (responseBytes.length == 0) {
        var empty = errorResponse(502, errEmptyUpstream())
        conn.send(empty)
        conn.close()
        noteHttpFinished("upstream_error", "", raw.length, empty.length, time.now() - started)
        return
    }
    // Hop-by-hop do upstream nao vale para a conexao publica: o Edge fecha
    // sempre. Sem isso um `Connection: keep-alive` do servico local pedia ao
    // cliente para reusar uma conexao que o Edge ja fecha.
    responseBytes = sanitizeResponse(responseBytes, request.method)
    // Modo detectar com assinatura casada: a resposta do relay segue, mas
    // marcada (`would-block`) — o operador ve o que o enforce bloquearia
    // sem quebrar nada hoje. Sem assinatura, bytes intactos.
    if (signature.length > 0) {
        responseBytes = withWafWouldBlock(responseBytes)
    }
    conn.send(responseBytes)
    conn.close()
    noteHttpFinished("ok", "", raw.length, responseBytes.length, time.now() - started)
}

// Parsing do `Authorization` no Edge: delega no bearerValue (fonte unica,
// em util.Text) — mesma regra do control plane (`bearerToken`).
String bearerFrom(String authorization) {
    return bearerValue(authorization)
}
