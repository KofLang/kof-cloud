package kofcloud.edge

// Metricas operacionais do Edge (observabilidade minima, Fase 8 parcial).
//
// O que conta: eventos de ciclo de vida do tunel e das requisicoes publicas —
// conexoes, recusas por motivo, bytes repassados, streams. O que NUNCA conta:
// conteudo de requisicao/resposta, credenciais, chaves, hostnames, caminhos,
// corpos. So metadados operacionais agregados, sem cardinalidade por cliente.
//
// Implementacao: `observability.*` do stdlib Kof (counters/gauges/histogramas
// com export Prometheus via `observability.metrics()`). Contadores sao
// monotonicos; gauges refletem o instante (sessoes e streams abertos).
// Histogramas guardam latencia fim-a-fim da requisicao publica em ms
// (sum + count, sem buckets por cliente).

String metricTunnelAccepted() {
    return "kofcloud_edge_tunnel_accepted_total"
}

String metricTunnelRefused() {
    return "kofcloud_edge_tunnel_refused_total"
}

String metricSessionsOpen() {
    return "kofcloud_edge_tunnel_sessions_open"
}

String metricHttpRequests() {
    return "kofcloud_edge_http_requests_total"
}

String metricHttpDenied() {
    return "kofcloud_edge_http_denied_total"
}

String metricHttpUpstreamErrors() {
    return "kofcloud_edge_http_upstream_errors_total"
}

String metricRequestBytes() {
    return "kofcloud_edge_http_request_bytes_total"
}

String metricResponseBytes() {
    return "kofcloud_edge_http_response_bytes_total"
}

String metricStreamsOpen() {
    return "kofcloud_edge_tunnel_streams_open"
}

String metricRequestLatencyMs() {
    return "kofcloud_edge_http_request_latency_ms"
}

// Latencia em faixas (Fase 14 slice 1 parcial): o histograma do stdlib so
// exporta sum+count, ou seja a MEDIA. Latencia de cauda (p99) e o que pesa
// numa cloud rapida, e media esconde cauda. Cada requisicao cai em uma
// faixa monotonica de contadores — `_le_50` significa "<= 50 ms", e a
// ultima (`_gt_2000`) e o excedente. Sem bucket por hostname/cliente,
// mesma regra de privacidade do resto do modulo.
List<Int> latencyBucketLimitsMs() {
    return listOf(50, 100, 250, 500, 1000, 2000)
}

// Sufixo Prometheus da faixa que contem `elapsedMs`. Puro e com fonte unica
// (os limites vem de `latencyBucketLimitsMs`; o rotulo e derivado deles, nao
// digitado a mao — mudar a lista muda o rotulo). `elapsedMs` negativo
// (relogio ajustado) cai na primeira faixa em vez de sumir da contagem.
String latencyBucketSuffix(Long elapsedMs) {
    var limits = latencyBucketLimitsMs()
    var i = 0
    while (i < limits.size) {
        var limit = limits.get(i)
        if (elapsedMs <= limit) {
            return "_le_" + intToString(limit)
        }
        i = i + 1
    }
    return "_gt_" + intToString(limits.get(limits.size - 1))
}

// Faixas de TAMANHO da resposta (Fase 14 slice 1: "tempo de relay por
// tamanho"). Sem isso nao ha como dizer se o custo esta no chunk ou na
// distancia: um p99 alto pode ser muita troca pequena ou poucas trocas
// grandes. Fonte unica; o rotulo e derivado da lista (mesma regra da
// latencia). Valores em KiB.
List<Int> responseSizeBucketLimitsKb() {
    return listOf(1, 4, 16, 64, 256, 1024)
}

String responseSizeBucketSuffix(Int responseBytes) {
    var limits = responseSizeBucketLimitsKb()
    var i = 0
    while (i < limits.size) {
        var limit = limits.get(i)
        if (responseBytes <= limit * 1024) {
            return "_kb_le_" + intToString(limit)
        }
        i = i + 1
    }
    return "_kb_gt_" + intToString(limits.get(limits.size - 1))
}

// Conta a resposta na faixa de tamanho (so respostas com bytes: recusa
// pequena de plataforma nao mede relay e viraria ruido na faixa menor).
void noteResponseSize(Int responseBytes) {
    if (responseBytes <= 0) {
        return
    }
    observability.counter(metricResponseBytes() + "_size" + responseSizeBucketSuffix(responseBytes))
}

// Acumula a amostra de latencia: histograma (sum+count, media) + a faixa
// correspondente. Fonte unica da classificacao — o chamador so passa ms.
void noteRequestLatency(Long elapsedMs) {
    observability.histogram(metricRequestLatencyMs(), elapsedMs as Int)
    observability.counter(metricRequestLatencyMs() + latencyBucketSuffix(elapsedMs))
}

// Recusas de tunel por motivo (motivos sao do protocolo, nunca de cliente).
void noteTunnelRefused(String reason) {
    observability.counter(metricTunnelRefused())
    if (reason == "VERSION_UNSUPPORTED") {
        observability.counter(metricTunnelRefused() + "_version")
    } else if (reason == "DEVICE_UNKNOWN") {
        observability.counter(metricTunnelRefused() + "_unknown_device")
    } else if (reason == "DEVICE_REVOKED") {
        observability.counter(metricTunnelRefused() + "_revoked_device")
    } else if (reason == "DEVICE_SUSPENDED") {
        observability.counter(metricTunnelRefused() + "_suspended_device")
    } else if (reason == "LINE_OVERFLOW") {
        observability.counter(metricTunnelRefused() + "_line_overflow")
    } else if (reason == "IDLE_TIMEOUT") {
        observability.counter(metricTunnelRefused() + "_idle_timeout")
    } else {
        observability.counter(metricTunnelRefused() + "_auth")
    }
}

void noteTunnelAccepted(Int openSessions) {
    observability.counter(metricTunnelAccepted())
    observability.gauge(metricSessionsOpen(), openSessions)
}

void noteTunnelClosed(Int openSessions) {
    observability.gauge(metricSessionsOpen(), openSessions)
}

// Uma requisicao publica terminou: conta por desfecho, soma bytes e latencia.
// `outcome`: "ok" | "denied" | "upstream_error". `deniedDetail` e o motivo da
// plataforma (KCF100/KCF101/...), nunca dado do cliente.
void noteHttpFinished(String outcome, String deniedDetail, Int requestBytes, Int responseBytes, Long elapsedMs) {
    observability.counter(metricHttpRequests())
    if (outcome == "denied") {
        observability.counter(metricHttpDenied())
        if (deniedDetail == "KCF100") {
            observability.counter(metricHttpDenied() + "_no_route")
        } else if (deniedDetail == "KCF101") {
            observability.counter(metricHttpDenied() + "_auth_required")
        } else if (deniedDetail == "KCF102") {
            observability.counter(metricHttpDenied() + "_device_offline")
        } else if (deniedDetail == "KCF103") {
            observability.counter(metricHttpDenied() + "_service_down")
        } else if (deniedDetail == "KCF107") {
            observability.counter(metricHttpDenied() + "_rate_limited")
        } else if (deniedDetail == "KCF108") {
            observability.counter(metricHttpDenied() + "_service_overloaded")
        } else if (deniedDetail == "KCF110") {
            observability.counter(metricHttpDenied() + "_body_too_large")
        } else if (deniedDetail == "KCF109") {
            observability.counter(metricHttpDenied() + "_waf_denied")
        } else if (deniedDetail == "KCF117") {
            observability.counter(metricHttpDenied() + "_too_many_public_conns")
        } else if (deniedDetail == "KCF111") {
            observability.counter(metricHttpDenied() + "_waf_allow_denied")
        } else {
            observability.counter(metricHttpDenied() + "_other")
        }
    } else if (outcome == "upstream_error") {
        observability.counter(metricHttpUpstreamErrors())
        if (deniedDetail == "KCF112") {
            observability.counter(metricHttpUpstreamErrors() + "_timeout")
        } else if (deniedDetail == "KCF115") {
            observability.counter(metricHttpUpstreamErrors() + "_response_too_large")
        }
    }
    observability.increment(metricRequestBytes(), requestBytes)
    observability.increment(metricResponseBytes(), responseBytes)
    noteResponseSize(responseBytes)
    noteRequestLatency(elapsedMs)
    observability.gauge(metricStreamsOpen(), 0)
}

// Streams abertos no relay: gauge pontual por requisicao (abre/fecha no mesmo
// fluxo; o valor global exato vive na sessao).
void noteStreamOpened() {
    observability.counter("kofcloud_edge_tunnel_streams_total")
}

// Conexao publica recusada pelo teto de simultaneas. Conta o evento, nunca
// o cliente (o Edge TCP nao expoe IP de origem).
void notePublicConnRefused() {
    observability.counter("kofcloud_edge_http_connections_refused_total")
}

// Fila de entrada do stream estourou (consumidor lento): o stream e recusado
// com RESET LIMIT_EXCEEDED e o tunel segue. Conta o evento, nunca o conteudo.
void noteStreamQueueOverflow() {
    observability.counter("kofcloud_edge_tunnel_stream_queue_overflow_total")
}

// Deteccao WAF (Fase 10, slice 1): conta por padrao nos dois modos
// (detectar conta e segue; enforce conta e bloqueia). `signature` e o nome
// do padrao que casou ("traversal", "sqli-union", ...) — nunca corpo, path,
// hostname ou credencial. Sem cardinalidade por cliente por desenho.
void noteWafDetected(String signature) {
    observability.counter("kofcloud_edge_waf_detected_total")
    if (signature == "traversal") {
        observability.counter("kofcloud_edge_waf_detected_total_traversal")
    } else if (signature == "nullbyte") {
        observability.counter("kofcloud_edge_waf_detected_total_nullbyte")
    } else if (signature == "sqli-union") {
        observability.counter("kofcloud_edge_waf_detected_total_sqli_union")
    } else if (signature == "sqli-tautology") {
        observability.counter("kofcloud_edge_waf_detected_total_sqli_tautology")
    } else if (signature == "xss-script") {
        observability.counter("kofcloud_edge_waf_detected_total_xss_script")
    } else {
        observability.counter("kofcloud_edge_waf_detected_total_other")
    }
}
