package kofcloud.agent

import kofcloud.agent.Backoff
import kofcloud.agent.Events
import kofcloud.agent.Health
import kofcloud.agent.Metrics
import kofcloud.agent.Relay
import kofcloud.identity.Keys
import kofcloud.model.Service
import kofcloud.protocol.Bytes
import kofcloud.protocol.Frame
import kofcloud.protocol.LineCodec
import kofcloud.protocol.Session
import kofcloud.protocol.Tunnel
import kofcloud.protocol.Version
import kofcloud.util.Hosts
import kofcloud.util.Limits
import kofcloud.util.Text

// Agent: mantem o tunel reverso com o Edge, faz health check e relay dos
// servicos publicados. O processo roda enquanto a maquina estiver disponivel.
//
// O Conn do tunel nunca e campo de classe (L1): vive como parametro e
// captura de closure nas tasks filhas.

record AgentConfig(String controlUrl, String deviceId, String accountId, String token, String privateKey, String stopFile, String edgeHost, Int edgePort, Int healthMs)

record EdgeEndpoint(String host, Int port, Int heartbeatMs, List<Service> services)

// Um Edge candidato e a latencia medida (ms; -1 = nao respondeu).
record EdgeProbe(String host, Int port, Long latencyMs)

// Escolhe o Edge de menor latencia entre os que responderam. Pura: recebe as
// sondas ja medidas (o IO fica em probeEdges). Sem nenhum respondendo,
// devolve o primeiro da lista (o principal) — o Agent tenta e o backoff
// cuida do resto, em vez de ficar sem destino.
EdgeProbe chooseFastestEdge(List<EdgeProbe> probes) {
    if (probes.size == 0) {
        return EdgeProbe("", 0, -1)
    }
    var best = probes.get(0)
    for (var probe in probes) {
        if (probe.latencyMs < 0) {
            continue
        }
        if (best.latencyMs < 0 || probe.latencyMs < best.latencyMs) {
            best = probe
        }
    }
    return best
}

// "host:porta" -> EdgeProbe (porta invalida = descarta). Pura.
EdgeProbe parseEdgeAddress(String address) {
    var trimmed = address.trim()
    var colon = trimmed.lastIndexOf(":")
    if (colon <= 0) {
        return EdgeProbe("", 0, -1)
    }
    var host = trimmed.substring(0, colon).trim()
    if (host.length == 0) {
        return EdgeProbe("", 0, -1)
    }
    // `parsePortSafe`, nao `parseIntSafe`: o acumulador de 32 bits fazia
    // wrap (medido: ":4294968080" virava porta 784 e o Agent conectava no
    // lugar errado). Mesma fonte unica do publish e das portas do serve.
    var port = parsePortSafe(trimmed.substring(colon + 1), -1)
    if (port <= 0) {
        return EdgeProbe("", 0, -1)
    }
    return EdgeProbe(host, port, -1)
}

// Mede cada Edge com um connect+close (o handshake do tunel e o proximo
// passo; aqui so a ida e volta TCP). Falha = -1, nunca lanca.
List<EdgeProbe> probeEdges(List<String> addresses) {
    var out = listOf<EdgeProbe>()
    for (var address in addresses) {
        var parsed = parseEdgeAddress(address)
        if (parsed.host.length == 0) {
            continue
        }
        var started = time.now()
        var latency = -1L
        try {
            var conn = net.connect(parsed.host, parsed.port)
            conn.close()
            latency = time.now() - started
        } catch (String e) {
            latency = -1L
        }
        out.add(EdgeProbe(parsed.host, parsed.port, latency))
    }
    return out
}

// Pede ao control plane o ponto de entrada do Edge e os servicos efetivos.
// `edgeHost`/`edgePort` na config sobrescrevem o retorno do control plane
// (usado pelos testes para rodar em portas arbitrarias).
EdgeEndpoint fetchEdge(AgentConfig config) {
    var body = mapOf()
    body.put("deviceId", config.deviceId)
    var headers = "Content-Type: application/json\nX-KofCloud-Token: " + config.token
    var raw = requireOk(http.post(config.controlUrl + "/v1/connect", json.encode(body), headers))
    var map = json.decode<Map<String, String>>(raw)
    var services = json.decode<List<Service>>(mapField(map, "services"))
    var host = mapField(map, "edgeHost")
    // Porta do Edge vinda da rede: mesma armadilha do `parseEdgeAddress` —
    // `parseIntSafe` faz wrap (`4294968080` vira 784) e o Agent conectaria
    // no lugar errado. Valor invalido recai no default (o Agent nao tem o
    // que corrigir aqui; quem valida a config e o `serve`).
    var port = parsePortSafe(mapField(map, "edgePort"), defaultTunnelPort())
    if (config.edgeHost.length > 0) {
        host = config.edgeHost
    }
    if (config.edgePort > 0) {
        port = config.edgePort
    }
    // Ranking por latencia (Fase 14 slice 2): o control plane publica a lista
    // e o Agent escolhe o mais proximo. Override explicito de host/porta
    // (testes e operador) vence a escolha automatica.
    if (config.edgeHost.length == 0 && config.edgePort <= 0) {
        var addresses = json.decode<List<String>>(mapField(map, "edges"))
        if (addresses.size > 1) {
            var chosen = chooseFastestEdge(probeEdges(addresses))
            if (chosen.host.length > 0) {
                host = chosen.host
                port = chosen.port
            }
        }
    }
    return EdgeEndpoint(
        host,
        port,
        // Heartbeat tambem vem da rede: teto explicito (`parseIntBounded`)
        // para um valor absurdo nao virar 200 ms ou negativo por wrap; zero
        // ou lixo recai no default e o loop abaixo ja corrige <= 0.
        parseIntBounded(mapField(map, "heartbeatMs"), limitHeartbeatMs(), 3600000),
        services
    )
}

// Loop de conexao com backoff. `once` = uma tentativa (usado em testes);
// senao reconecta indefinidamente, exceto em recusa definitiva.
void runAgent(AgentConfig config, Bool once) {
    var attempt = 0
    var running = true
    while (running) {
        try {
            noteAgentConnect()
            connectAndServe(config)
            running = false
        } catch (String e) {
            // Parada pedida vale em qualquer estado — inclusive dormindo em
            // backoff, onde o watchdog (que so atua dentro de connectAndServe)
            // nao alcanca. Sem isso, um disconnect durante o backoff
            // reconectaria, e o processo nunca terminaria.
            if (config.stopFile.length > 0 && File(config.stopFile).exists()) {
                running = false
            } else if (isFatal(e) || once) {
                if (isFatal(e)) {
                    noteAgentFatal(e)
                }
                agentEvent("error", e)
                running = false
            } else {
                noteAgentReconnect()
                var delay = backoffDelay(attempt, defaultBackoffBase(), defaultBackoffMax())
                agentEvent("warn", e + " — reconnecting in " + intToString(delay) + "ms")
                time.sleep(delay)
                attempt = attempt + 1
            }
        }
    }
}

// Recusa definitiva: nao adianta reconectar. DEVICE_SUSPENDED e fatal do
// mesmo jeito (o Agent nao reconecta sozinho; o operador libera e reconecta).
Bool isFatal(String reason) {
    return reason == "DEVICE_REVOKED" || reason == "DEVICE_SUSPENDED" || reason == "AUTH_FAILED" || reason == "DEVICE_UNKNOWN" || reason == "VERSION_UNSUPPORTED"
}

void connectAndServe(AgentConfig config) {
    var endpoint = fetchEdge(config)
    agentEvent("info", "edge " + endpoint.host + ":" + intToString(endpoint.port) + " with " + intToString(endpoint.services.size) + " service(s)")

    var conn = net.connect(endpoint.host, endpoint.port)
    var pair = generateKeyPair()

    var session = TunnelSession("agent", config.deviceId, config.accountId, "")
    session.setServices(endpoint.services)
    conn.send(bytesFromString(encodeFrame(helloFrame(config.deviceId, config.token, pair.publicKey))))

    var codec = LineCodec()
    var welcomeLine = ""
    while (welcomeLine == "") {
        var chunk = conn.receive(receiveChunkBytes())
        if (chunk.length == 0) {
            conn.close()
            throw "edge closed during handshake"
        }
        codec.feed(chunk)
        if (codec.overflowed()) {
            conn.close()
            throw "edge sent oversized line"
        }
        welcomeLine = codec.nextLine()
    }
    var welcome = decodeFrame(welcomeLine)
    if (frameBool(welcome, "ok") == false) {
        var reason = frameField(welcome, "reason")
        conn.close()
        throw reason
    }
    var serverPub = frameField(welcome, "serverPub")
    if (serverPub.length > 0) {
        session.sessionKey = deriveSessionKey(pair.privateKey, serverPub, frameField(welcome, "sessionId"), tunnelInfo())
    }
    var heartbeatMs = frameInt(welcome, "heartbeatMs")
    if (heartbeatMs <= 0) {
        heartbeatMs = limitHeartbeatMs()
    }

    var writer = spawn { agentWriter(conn, session) }
    var pinger = spawn { agentPinger(session, heartbeatMs) }
    var watchdog = spawn { agentWatchdog(session, config.stopFile) }
    var sweeper = spawn { agentIdleSweeper(session) }
    var healthMs = config.healthMs
    if (healthMs <= 0) {
        healthMs = limitHealthMs()
    }
    var health = spawn { agentHealth(session, healthMs) }
    var refresher = spawn { agentRefresher(session, config, limitRefreshMs(healthMs)) }

    reportAllStatuses(session, endpoint.services)

    var open = true
    var goaway = false
    while (open) {
        var chunk = conn.receive(receiveChunkBytes())
        if (chunk.length == 0) {
            open = false
        } else {
            codec.feed(chunk)
            if (codec.overflowed()) {
                open = false
            } else {
                while (codec.hasLine()) {
                    var line = codec.nextLine()
                    if (line.length > 0) {
                        var frame = decodeFrame(line)
                        if (frameKind(frame) == "GOAWAY") {
                            goaway = true
                            open = false
                        } else {
                            open = handleAgentFrame(session, line)
                        }
                    }
                }
            }
        }
    }

    session.close()
    conn.close()
    // EOF limpo NAO e saida normal: so o watchdog (stopFile) ou um GOAWAY do
    // Edge encerram sem reconectar. Queda no meio — inclusive a derrubada por
    // idle do sweeper do Edge — vira throw e o runAgent reconecta com backoff
    // (o HELLO seguinte decide: ACTIVE reconecta, SUSPENDED/REVOKED e fatal).
    if (goaway) {
        agentEvent("warn", "edge asked to go away")
        return
    }
    if (config.stopFile.length > 0 && File(config.stopFile).exists()) {
        agentEvent("info", "stopped by request")
        return
    }
    throw "edge closed connection"
}

Bool handleAgentFrame(TunnelSession session, String line) {
    var frame = decodeFrame(line)
    var kind = frameKind(frame)
    if (kind == "PING") {
        session.send(pongFrame())
        return true
    }
    // Mesma regra do Edge: so frame util renova o idle. PING nao conta, e
    // PONG tampouco (resposta ao heartbeat prova que o peer esta vivo, nao
    // que ha trabalho — senao o heartbeat renovaria o idle para sempre).
    if (kind != "PONG") {
        session.touch()
    }
    if (kind == "OPEN") {
        var streamId = frameField(frame, "s")
        var name = frameField(frame, "service")
        var service = session.serviceNamed(name)
        if (service == null) {
            session.send(openedFrame(streamId, false, "SERVICE_UNKNOWN"))
        } else if (session.atCapacity()) {
            session.send(openedFrame(streamId, false, "LIMIT_EXCEEDED"))
            session.send(resetFrame(streamId, "LIMIT_EXCEEDED"))
        } else {
            session.registerStream(streamId)
            var task = spawn { agentStream(session, service, streamId) }
            session.send(openedFrame(streamId, true, ""))
        }
        return true
    }
    if (kind == "DATA") {
        // Mesma regra do Edge (politica em Session.routeData): fila cheia
        // recusa o stream, nunca o tunel.
        session.routeData(frameField(frame, "s"), frameField(frame, "d"))
        return true
    }
    if (kind == "END") {
        session.deliver(frameField(frame, "s"), streamEndMarker())
        return true
    }
    if (kind == "RESET") {
        // Marca antes de entregar: o relay local consulta `isCancelled` a
        // cada bloco e para de produzir (o Edge cancelou por teto de
        // resposta ou timeout).
        session.markCancelled(frameField(frame, "s"))
        session.deliver(frameField(frame, "s"), streamResetMarker())
        return true
    }
    // PONG, SERVICES e desconhecidos: ignorados (PONG nem renovou o idle).
    // GOAWAY nunca chega aqui (tratado no reader, que encerra sem throw).
    return true
}

void agentWriter(Conn conn, TunnelSession session) {
    var open = true
    while (open) {
        var item = session.outbox.receive()
        if (item == streamCloseMarker()) {
            open = false
        } else {
            conn.send(bytesFromString(item))
        }
    }
    conn.close()
}

void agentPinger(TunnelSession session, Int heartbeatMs) {
    var open = true
    while (open) {
        time.sleep(heartbeatMs)
        if (session.open == false) {
            open = false
        } else {
            session.send(pingFrame())
        }
    }
}

// Parada pedida por `kof cloud disconnect` (arquivo-sentinela). O Kof nao
// expoe sinais nem watch de arquivo (docs/17-limitations.md L3), entao a
// parada e por polling curto — deterministica e independente do heartbeat.
void agentWatchdog(TunnelSession session, String stopFile) {
    if (stopFile.length == 0) {
        return
    }
    var open = true
    while (open) {
        time.sleep(agentStopPollMs())
        if (session.open == false) {
            open = false
        } else if (File(stopFile).exists()) {
            session.close()
            open = false
        }
    }
}

// Espelho do sweeper do Edge: derruba a sessao ociosa e reseta streams
// presos. Sem isso, um tunel zumbi (peer mudo que responde PING) viveria
// para sempre dos dois lados.
void agentIdleSweeper(TunnelSession session) {
    var open = true
    while (open) {
        time.sleep(limitIdleSweepMs())
        if (session.open == false) {
            open = false
        } else {
            if (session.idleMs() > limitTunnelIdleMs()) {
                session.close()
                open = false
            } else {
                for (var streamId in session.idleStreams(limitStreamIdleMs())) {
                    session.send(resetFrame(streamId, "IDLE_TIMEOUT"))
                    session.closeStream(streamId)
                }
            }
        }
    }
}

// Reavalia o health dos servicos periodicamente e reporta SO quando o estado
// muda. Sem isso, um servico que cai depois da conexao continuaria marcado
// ONLINE no Edge (docs/09-flows.md §6).
//
// Le a tabela DA SESSAO a cada ciclo — nunca uma lista capturada no spawn:
// o refresher troca a tabela via setServices (hot-reload) e o health precisa
// ver o mesmo mapa (o handler do OPEN ja le daqui). Com a lista antiga, um
// servico removido era sondado e reportado para sempre, e um servico novo
// nunca era sondado — STATUS preso no UNKNOWN e roteamento afirmando
// ONLINE ate a primeira queda. Lista do spawn nao atravessa por valor
// (Map seria copiado; ver o comentario em TunnelSession.servicesByName).
void agentHealth(TunnelSession session, Int healthMs) {
    var last = mapOf()
    var open = true
    while (open) {
        time.sleep(healthMs)
        if (session.open == false) {
            open = false
        } else {
            var probed = listOf<String>()
            for (var name in currentServiceNames(session)) {
                probed.add(name)
                var service = session.serviceNamed(name)
                if (service == null) {
                    continue
                }
                var status = checkService(service)
                var previous = last.get(service.name)
                var changed = false
                if (previous == null) {
                    changed = true
                } else {
                    changed = previous != status
                }
                if (changed) {
                    last.put(service.name, status)
                    session.send(statusFrame(service.name, status))
                    noteHealthReport()
                    agentEvent("info", "service " + service.name + " -> " + status)
                }
            }
            // Servico removido (saiu da tabela no hot-reload) nao deixa rastro:
            // o ciclo seguinte ja nao o sonda — e o Edge poda a rota na mesma
            // troca (resolveRoute deixaria de casar de qualquer jeito).
            pruneHealthMemory(last, probed)
        }
    }
}

// Foto dos nomes servidos nesta sessao (a tabela viva que o refresher troca
// no hot-reload). Pura sobre o mapa — facilita o teste sem tunel.
// Devolve List: o chamador itera sem tocar no mapa enquanto ele pode mudar.
List<String> currentServiceNames(TunnelSession session) {
    var out = listOf<String>()
    for (var name in session.servicesByName.keys()) {
        out.add(name)
    }
    return out
}

// Devolve a memoria do health ao tamanho da tabela: nomes que sumiram (servico
// removido no hot-reload) saem, e se um dia voltarem reportam de novo como
// mudanca no primeiro ciclo — em vez de carregar um status morto para sempre.
void pruneHealthMemory(Map<String, String> last, List<String> probed) {
    var gone = listOf<String>()
    for (var name in last.keys()) {
        if (probed.contains(name) == false) {
            gone.add(name)
        }
    }
    for (var name in gone) {
        last.remove(name)
    }
}

// Hot-reload de servicos (Fase 8 parcial): republica nao exige reconnect.
// A cada intervalo, busca a lista efetiva no control plane (`/v1/connect`,
// mesmo endpoint do inicio) e troca a tabela DA SESSAO — o objeto que o
// handler do OPEN ja consulta (argumento de task e copiado por valor, entao
// o mapa nao pode viajar por `spawn`). Streams em voo usam inboxes proprias
// e nao sao tocados. Servico removido sai (OPEN futuro = SERVICE_UNKNOWN);
// servico novo entra e o proximo OPEN ja roteia. Falha de rede = ignora e
// tenta no proximo ciclo (nunca derruba o tunel por causa do refresh).
void agentRefresher(TunnelSession session, AgentConfig config, Int refreshMs) {
    var gap = limitRefreshMs(refreshMs)
    var open = true
    while (open) {
        time.sleep(gap)
        if (session.open == false) {
            open = false
        } else {
            try {
                var endpoint = fetchEdge(config)
                session.setServices(endpoint.services)
            } catch (String e) {
                // rede falhou: mantem a lista atual, tenta de novo depois
            }
        }
    }
}
