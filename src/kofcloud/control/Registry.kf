package kofcloud.control

import kofcloud.control.Metrics
import kofcloud.model.Account
import kofcloud.model.Audit
import kofcloud.model.CustomDomain
import kofcloud.model.Device
import kofcloud.model.Errors
import kofcloud.model.Service
import kofcloud.model.Exposure

import kofcloud.identity.Tokens
import kofcloud.util.Hosts
import kofcloud.util.Limits
import kofcloud.util.Text
import kofcloud.store.Store

// Estado do control plane. Persistido como JSON unico; sem banco no MVP.
// Tokens sao guardados como hash (nunca em claro).
record TokenEntry(String accountId, String tokenHash, Long createdAt)

record ServiceToken(String serviceId, String accountId, String tokenHash, Long createdAt, Long expiresAt)

record ControlState(List<Account> accounts, List<Device> devices, List<Service> services, List<TokenEntry> tokens, List<ServiceToken> serviceTokens, List<CustomDomain> customDomains, List<AuditEvent> audit)

class Registry {
    List<Account> accounts
    List<Device> devices
    List<Service> services
    List<TokenEntry> tokens
    List<ServiceToken> serviceTokens
    List<CustomDomain> customDomains
    List<AuditEvent> audit
    String path
    Int maxDevices
    Int maxServices
    // Destinos que a verificacao de dominio proprio aceita: IPs e/ou hostnames
    // do Edge (config `kofcloud.edgeHosts`, separados por virgula). Comparacao
    // exata, sem sufixo: subdominios de um host esperado NAO valem.
    List<String> edgeHosts
    // Espelho das sessoes vivas do Edge NESTE processo (deviceId -> true).
    // Nao e persistido: presenca e efemera, some no restart. So o Edge
    // escreve aqui (via bind/unbind); o control plane so le, filtrado por
    // conta. Em deploy multi-processo cada Edge tem o seu mapa.
    Map<String, Bool> edgeOnline

    constructor(path: String) {
        this.path = path
        this.accounts = listOf<Account>()
        this.devices = listOf<Device>()
        this.services = listOf<Service>()
        this.tokens = listOf<TokenEntry>()
        this.serviceTokens = listOf<ServiceToken>()
        this.customDomains = listOf<CustomDomain>()
        this.audit = listOf<AuditEvent>()
        this.edgeOnline = mapOf()
        this.maxDevices = limitDevices()
        this.maxServices = limitServices()
        this.edgeHosts = parseEdgeHosts(config.str("kofcloud.edgeHosts", ""))
        this.load()
    }

    // Permite aos testes fixarem os destinos esperados sem config de processo.
    void setEdgeHosts(List<String> hosts) {
        this.edgeHosts = hosts
    }

    // Permite aos testes exercitarem o limite sem depender de env/config do
    // processo (config e lido uma vez, no start).
    void setLimits(Int devices, Int services) {
        this.maxDevices = devices
        this.maxServices = services
    }

    Int activeDeviceCount(String accountId) {
        var count = 0
        for (var device in this.devices) {
            if (device.accountId == accountId && device.status == "ACTIVE") {
                count = count + 1
            }
        }
        return count
    }

    void load() {
        var raw = readTextOr(this.path, "")
        if (raw.length == 0) {
            return
        }
        try {
            var state = json.decode<ControlState>(raw)
            this.accounts = state.accounts
            this.devices = state.devices
            this.services = state.services
            this.tokens = state.tokens
            this.serviceTokens = state.serviceTokens
            this.customDomains = state.customDomains
            this.audit = state.audit
        } catch (String e) {
            // Estado corrompido: recomeca vazio em vez de derrubar o control
            // plane. O operador ve os dados ausentes e decide.
        }
    }

    // Trilha de auditoria: anel capado (100 eventos). So metadados
    // operacionais; nunca senha, token, chave ou conteudo.
    void audit(String actor, String action, String target) {
        this.audit.add(AuditEvent(longToString(time.now()), actor, action, target))
        while (this.audit.size > 100) {
            this.audit = this.audit.subList(1, this.audit.size)
        }
    }

    List<AuditEvent> auditForAccount(String accountId) {
        var out = listOf<AuditEvent>()
        for (var event in this.audit) {
            if (event.target == accountId || event.target.startsWith(accountId + "/")) {
                out.add(event)
            }
        }
        return out
    }

    void save() {
        writeTextTo(this.path, json.encode(ControlState(this.accounts, this.devices, this.services, this.tokens, this.serviceTokens, this.customDomains, this.audit)))
    }

    // ---- contas ----

    Account createAccount(String handle, String email, String password) {
        if (validHandle(handle) == false) {
            throw errInvalidHandle()
        }
        if (this.accountByHandle(handle) != null) {
            throw errHandleTaken()
        }
        var account = Account(uuid.v4(), handle, email, passwords.hash(password), time.now())
        this.accounts.add(account)
        this.audit(auditActorAccount(handle), auditAccountCreated(), account.id)
        this.save()
        noteAccountCreated()
        return account
    }

    Account? accountByHandle(String handle) {
        for (var account in this.accounts) {
            if (account.handle == handle) {
                return account
            }
        }
        return null
    }

    Account? accountById(String id) {
        for (var account in this.accounts) {
            if (account.id == id) {
                return account
            }
        }
        return null
    }

    Account? accountByToken(String token) {
        if (token.length == 0) {
            return null
        }
        for (var entry in this.tokens) {
            if (tokenMatches(entry.tokenHash, token)) {
                return this.accountById(entry.accountId)
            }
        }
        return null
    }

    String issueToken(String accountId) {
        var token = newAccountToken()
        this.tokens.add(TokenEntry(accountId, tokenHash(token), time.now()))
        this.save()
        return token
    }

    String login(String handle, String password) {
        var account = this.accountByHandle(handle)
        if (account == null) {
            throw errInvalidCredentials()
        }
        if (passwords.verify(password, account.passwordHash) == false) {
            throw errInvalidCredentials()
        }
        return this.issueToken(account.id)
    }

    // ---- dispositivos ----

    Device registerDevice(Account account, String name, String publicKey) {
        var existing = this.deviceByName(account.id, name)
        if (existing != null) {
            return existing
        }
        if (this.activeDeviceCount(account.id) >= this.maxDevices) {
            throw errLimitDevices()
        }
        var device = Device(uuid.v4(), account.id, name, publicKey, deviceActive(), time.now(), time.now())
        this.devices.add(device)
        this.audit(auditActorAccount(account.handle), auditDeviceRegistered(), account.id + "/" + device.id)
        this.save()
        noteDeviceRegistered()
        return device
    }

    Device? deviceById(String id) {
        for (var device in this.devices) {
            if (device.id == id) {
                return device
            }
        }
        return null
    }

    Device? deviceByName(String accountId, String name) {
        for (var device in this.devices) {
            if (device.accountId == accountId && device.name == name) {
                return device
            }
        }
        return null
    }

    List<Device> devicesForAccount(String accountId) {
        var out = listOf<Device>()
        for (var device in this.devices) {
            if (device.accountId == accountId) {
                out.add(device)
            }
        }
        return out
    }

    Bool revokeDevice(String accountId, String deviceId) {
        var account = this.accountById(accountId)
        var actor = "account:?"
        if (account != null) {
            actor = auditActorAccount(account.handle)
        }
        var found = false
        var updated = listOf<Device>()
        for (var device in this.devices) {
            if (device.id == deviceId && device.accountId == accountId) {
                updated.add(Device(device.id, device.accountId, device.name, device.publicKey, deviceRevoked(), device.lastSeenAt, device.createdAt))
                found = true
            } else {
                updated.add(device)
            }
        }
        if (found) {
            this.devices = updated
            this.removeServicesOfDevice(deviceId)
            this.pruneServiceTokens()
            this.pruneCustomDomains()
            this.audit(actor, auditDeviceRevoked(), accountId + "/" + deviceId)
            this.save()
            noteDeviceRevoked()
        }
        return found
    }

    // Suspensao administrativa de dispositivo: recusa o tunel com
    // DEVICE_SUSPENDED, sem remover nada. Idempotente.
    Bool suspendDevice(String accountId, String deviceId) {
        return this.setDeviceStatus(accountId, deviceId, deviceSuspended(), auditDeviceSuspended())
    }

    Bool unsuspendDevice(String accountId, String deviceId) {
        return this.setDeviceStatus(accountId, deviceId, deviceActive(), auditDeviceUnsuspended())
    }

    Bool setDeviceStatus(String accountId, String deviceId, String status, String action) {
        var account = this.accountById(accountId)
        var actor = "account:?"
        if (account != null) {
            actor = auditActorAccount(account.handle)
        }
        var found = false
        var updated = listOf<Device>()
        for (var device in this.devices) {
            if (device.id == deviceId && device.accountId == accountId) {
                updated.add(Device(device.id, device.accountId, device.name, device.publicKey, status, device.lastSeenAt, device.createdAt))
                found = true
            } else {
                updated.add(device)
            }
        }
        if (found) {
            this.devices = updated
            if (action == auditDeviceSuspended()) {
                this.audit(actor, action, accountId + "/" + deviceId)
                this.save()
                noteDeviceSuspended()
            } else if (action == auditDeviceUnsuspended()) {
                this.audit(actor, action, accountId + "/" + deviceId)
                this.save()
                noteDeviceUnsuspended()
            } else {
                this.save()
            }
        }
        return found
    }

    void touchDevice(String deviceId) {
        var updated = listOf<Device>()
        for (var device in this.devices) {
            if (device.id == deviceId) {
                updated.add(Device(device.id, device.accountId, device.name, device.publicKey, device.status, time.now(), device.createdAt))
            } else {
                updated.add(device)
            }
        }
        this.devices = updated
        this.save()
    }

    // Espelho de presenca do Edge (mesmo processo): true ao ligar o tunel,
    // false ao desligar. Sem persistencia — restart limpa tudo, e a primeira
    // reconexao do Agent recria a entrada.
    void noteEdgeOnline(String deviceId, Bool online) {
        if (online) {
            this.edgeOnline.put(deviceId, true)
        } else {
            this.edgeOnline.remove(deviceId)
        }
    }

    Bool edgeIsOnline(String deviceId) {
        return this.edgeOnline.get(deviceId) == true
    }

    // Ids dos dispositivos DA CONTA com sessao viva neste Edge. Filtragem por
    // conta aqui (e nao no chamador): o endpoint responde so com o que e do
    // dono do token — nada de terceiros vaza, nem existencia.
    List<String> onlineDeviceIdsFor(String accountId) {
        var out = listOf<String>()
        for (var device in this.devicesForAccount(accountId)) {
            if (this.edgeIsOnline(device.id)) {
                out.add(device.id)
            }
        }
        return out
    }

    // ---- tokens de servico (AUTHENTICATED) ----

    // `expiresAt` em ms desde a epoca; 0 = sem expiracao (tokens antigos e o
    // default de emissao). Expirado nao autoriza nem aparece no inventario.
    Long serviceTokenExpiry(Long nowMs, Int ttlHours) {
        if (ttlHours <= 0) {
            return 0
        }
        return nowMs + ttlHours * 3600000
    }

    Bool serviceTokenExpired(ServiceToken entry, Long nowMs) {
        if (entry.expiresAt <= 0) {
            return false
        }
        return nowMs >= entry.expiresAt
    }

    // Atalho sem TTL (sem expiracao): mantem os chamadores antigos e os
    // tokens antigos validos para sempre, como antes.
    String issueServiceToken(String accountId, String serviceId) {
        return this.issueServiceToken(accountId, serviceId, 0)
    }

    // Emite uma credencial nova para o servico. Varias podem existir (rotacao
    // sem downtime); cada uma e guardada apenas como hash. `ttlHours` <= 0
    // significa sem expiracao (comportamento antigo); > 0 fixa `expiresAt`.
    String issueServiceToken(String accountId, String serviceId, Int ttlHours) {
        var service = this.serviceById(serviceId)
        if (service == null) {
            throw errServiceNotFound()
        }
        if (service.accountId != accountId) {
            throw errServiceTokenForbidden()
        }
        var token = newServiceToken()
        var expiresAt = serviceTokenExpiry(time.now(), ttlHours)
        this.serviceTokens.add(ServiceToken(serviceId, accountId, tokenHash(token), time.now(), expiresAt))
        var issuer = this.accountById(accountId)
        if (issuer != null) {
            this.audit(auditActorAccount(issuer.handle), "service.token_issued", accountId + "/" + serviceId)
        }
        this.save()
        noteServiceTokenIssued()
        return token
    }

    // Resolve o servico dono de um token de servico; null se invalido OU
    // expirado. Expirado e podado na hora (preguicoso): nao acumula lixo e o
    // proximo `list` ja nao mostra.
    Service? serviceByServiceToken(String token) {
        if (token.length == 0) {
            return null
        }
        var now = time.now()
        var kept = listOf<ServiceToken>()
        var expired = 0
        var matchedServiceId = ""
        for (var entry in this.serviceTokens) {
            if (serviceTokenExpired(entry, now)) {
                expired = expired + 1
                continue
            }
            kept.add(entry)
            if (matchedServiceId.length == 0 && tokenMatches(entry.tokenHash, token)) {
                matchedServiceId = entry.serviceId
            }
        }
        if (kept.size != this.serviceTokens.size) {
            this.serviceTokens = kept
            this.save()
        }
        var i = 0
        while (i < expired) {
            noteServiceTokenExpired()
            i = i + 1
        }
        if (matchedServiceId.length == 0) {
            return null
        }
        return this.serviceById(matchedServiceId)
    }

    // Inventario das credenciais de UM servico (para `service token list`).
    // Devolve os registros (hash + emissao), nunca o valor: o kfs_ em claro
    // so existe no instante da emissao. Filtra por conta dona aqui (e nao
    // no chamador): inexistente e alheio dao lista vazia, sem oraculo.
    // Expirados nao aparecem (mesma regra da validacao — coerencia: o que
    // nao autoriza nao e listado).
    List<ServiceToken> serviceTokensFor(String accountId, String serviceId) {
        var service = this.serviceById(serviceId)
        if (service == null) {
            return listOf<ServiceToken>()
        }
        if (service.accountId != accountId) {
            return listOf<ServiceToken>()
        }
        var now = time.now()
        var out = listOf<ServiceToken>()
        for (var entry in this.serviceTokens) {
            if (entry.serviceId == serviceId && serviceTokenExpired(entry, now) == false) {
                out.add(entry)
            }
        }
        return out
    }

    // Remove credenciais orfas (servico removido ou dispositivo revogado).
    void pruneServiceTokens() {
        var alive = listOf<ServiceToken>()
        for (var entry in this.serviceTokens) {
            if (this.serviceById(entry.serviceId) != null) {
                alive.add(entry)
            }
        }
        this.serviceTokens = alive
    }

    // Revoga UMA credencial de servico (ex.: vazou, rotacao forçada).
    // O token e identificado pelo proprio valor (o operador cola o kfs_ que
    // quer matar) OU pelo id curto do inventario (8 hex do hash, como mostra
    // o `token-list`) — desde que UNICO no servico. Id curto que casa com
    // mais de uma credencial: false (o chamador responde 409 KCF063, pedindo
    // o kfs_ completo). O que e comparado/guardado continua sendo so o hash —
    // nunca persistimos nem logamos o valor em claro. So a conta dona do
    // servico pode revogar. Inexistente (ou de outro servico/outra conta):
    // false, e o chamador responde o 404 opaco padrao.
    // Retorna "revoked" | "ambiguous" | "" (nao encontrado/sem dono).
    String revokeServiceTokenResult(String accountId, String serviceId, String token) {
        if (token.length == 0) {
            return ""
        }
        var service = this.serviceById(serviceId)
        if (service == null) {
            return ""
        }
        if (service.accountId != accountId) {
            return ""
        }
        // Valor completo primeiro (caminho exato, constant-time).
        var kept = listOf<ServiceToken>()
        var revoked = false
        for (var entry in this.serviceTokens) {
            if (entry.serviceId == serviceId && tokenMatches(entry.tokenHash, token)) {
                revoked = true
            } else {
                kept.add(entry)
            }
        }
        if (revoked) {
            this.finishRevoke(accountId, serviceId, kept)
            return "revoked"
        }
        // Senao, tenta como id curto (prefixo do hash, sem "kfs_").
        // Exige unicidade no servico: 0 = nao existe, 2+ = ambiguo.
        var matches = 0
        for (var entry in this.serviceTokens) {
            if (entry.serviceId == serviceId && entry.tokenHash.startsWith(token)) {
                matches = matches + 1
            }
        }
        if (matches == 0) {
            return ""
        }
        if (matches > 1) {
            return "ambiguous"
        }
        var keptShort = listOf<ServiceToken>()
        for (var entry in this.serviceTokens) {
            if (entry.serviceId == serviceId && entry.tokenHash.startsWith(token)) {
                continue
            }
            keptShort.add(entry)
        }
        this.finishRevoke(accountId, serviceId, keptShort)
        return "revoked"
    }

    void finishRevoke(String accountId, String serviceId, List<ServiceToken> kept) {
        this.serviceTokens = kept
        var issuer = this.accountById(accountId)
        if (issuer != null) {
            // Audita o servico, nunca o token (o valor nao e logado).
            this.audit(auditActorAccount(issuer.handle), auditServiceTokenRevoked(), accountId + "/" + serviceId)
        }
        this.save()
        noteServiceTokenRevoked()
    }

    Bool revokeServiceToken(String accountId, String serviceId, String token) {
        return this.revokeServiceTokenResult(accountId, serviceId, token) == "revoked"
    }

    // ---- servicos ----

    Service publishService(Account account, String deviceId, String name, String localAddress, Int localPort, String protocol, String exposure) {
        if (validServiceName(name) == false) {
            throw errInvalidServiceName()
        }
        var device = this.deviceById(deviceId)
        if (device == null) {
            throw errDeviceNotFound()
        }
        if (device.accountId != account.id) {
            throw errDeviceNotYours()
        }
        var existing = this.serviceByName(account.id, name)
        if (existing != null) {
            return existing
        }
        if (this.servicesForDevice(deviceId).size >= this.maxServices) {
            throw errLimitServices()
        }
        var service = Service(
            uuid.v4(), account.id, deviceId, name, localAddress, localPort, protocol,
            serviceHostname(name, account.handle), exposureName(exposureFrom(exposure)),
            statusUnknown(), time.now()
        )
        this.services.add(service)
        this.audit(auditActorAccount(account.handle), auditServicePublished(), account.id + "/" + service.id)
        this.save()
        noteServicePublished()
        return service
    }

    Service? serviceById(String id) {
        for (var service in this.services) {
            if (service.id == id) {
                return service
            }
        }
        return null
    }

    Service? serviceByName(String accountId, String name) {
        for (var service in this.services) {
            if (service.accountId == accountId && service.name == name) {
                return service
            }
        }
        return null
    }

    List<Service> servicesForAccount(String accountId) {
        var out = listOf<Service>()
        for (var service in this.services) {
            if (service.accountId == accountId) {
                out.add(service)
            }
        }
        return out
    }

    List<Service> servicesForDevice(String deviceId) {
        var out = listOf<Service>()
        for (var service in this.services) {
            if (service.deviceId == deviceId) {
                out.add(service)
            }
        }
        return out
    }

    Bool removeService(String accountId, String serviceId) {
        var out = listOf<Service>()
        var found = false
        for (var service in this.services) {
            if (service.id == serviceId && service.accountId == accountId) {
                found = true
            } else {
                out.add(service)
            }
        }
        if (found) {
            this.services = out
            this.pruneServiceTokens()
            this.pruneCustomDomains()
            var svcOwner = this.accountById(accountId)
            if (svcOwner != null) {
                this.audit(auditActorAccount(svcOwner.handle), auditServiceRemoved(), accountId + "/" + serviceId)
            }
            this.save()
            noteServiceRemoved()
        }
        return found
    }

    // Suspensao administrativa de servico: sai da rota (opaco, como PRIVATE),
    // sem remover nada. Idempotente. O dono ve SUSPENDED em `service status`.
    Bool suspendService(String accountId, String serviceId) {
        return this.setServiceStatusOwned(accountId, serviceId, statusSuspended(), auditServiceSuspended())
    }

    Bool unsuspendService(String accountId, String serviceId) {
        return this.setServiceStatusOwned(accountId, serviceId, statusUnknown(), auditServiceUnsuspended())
    }

    // Troca de status com dono + auditoria + metrica. Devolve false para
    // inexistente ou de outra conta (o handler responde o 404 opaco).
    Bool setServiceStatusOwned(String accountId, String serviceId, String status, String action) {
        var service = this.serviceById(serviceId)
        if (service == null) {
            return false
        }
        var owner = service.accountId
        if (owner != accountId) {
            return false
        }
        var account = this.accountById(accountId)
        var actor = "account:?"
        if (account != null) {
            actor = auditActorAccount(account.handle)
        }
        this.setServiceStatus(serviceId, status)
        this.audit(actor, action, accountId + "/" + serviceId)
        this.save()
        if (action == auditServiceSuspended()) {
            noteServiceSuspended()
        } else {
            noteServiceUnsuspended()
        }
        return true
    }

    void removeServicesOfDevice(String deviceId) {
        var out = listOf<Service>()
        for (var service in this.services) {
            if (service.deviceId != deviceId) {
                out.add(service)
            }
        }
        this.services = out
    }

    Bool setServiceStatus(String serviceId, String status) {
        var found = false
        var updated = listOf<Service>()
        for (var service in this.services) {
            if (service.id == serviceId) {
                updated.add(Service(
                    service.id, service.accountId, service.deviceId, service.name,
                    service.localAddress, service.localPort, service.protocol,
                    service.hostname, service.exposure, status, service.createdAt
                ))
                found = true
            } else {
                updated.add(service)
            }
        }
        if (found) {
            this.services = updated
            this.save()
        }
        return found
    }

    // Health report do Agent (por device+nome; o tunel ja autenticou). NUNCA
    // dessuspende: suspensao e decisao administrativa e so `unsuspendService`
    // libera — senao o Agent reverteria a suspensao a cada ciclo de health.
    Bool setServiceStatusByName(String deviceId, String name, String status) {
        var target = ""
        for (var service in this.services) {
            if (service.deviceId == deviceId && service.name == name) {
                if (statusIsSuspended(service.status)) {
                    return true
                }
                target = service.id
            }
        }
        if (target.length == 0) {
            return false
        }
        return this.setServiceStatus(target, status)
    }

    // Status reportado pelo Agent com verificacao de dono: so a conta dona do
    // servico pode alterar o status. Devolve "" em sucesso ou o codigo do erro.
    String reportServiceStatus(String accountId, String serviceId, String status) {
        var service = this.serviceById(serviceId)
        if (service == null) {
            return errServiceNotFound()
        }
        if (service.accountId != accountId) {
            return errServiceNotYours()
        }
        // O dono reporta health, mas nao administra suspensao por aqui: so
        // `unsuspendService` libera (mesma regra do health do Agent).
        if (statusIsSuspended(service.status)) {
            return ""
        }
        this.setServiceStatus(serviceId, status)
        return ""
    }

    // Rota publica: so servicos com exposicao roteavel. Dominios proprios
    // VERIFIED entram como apelidos do hostname do servico (mesma checagem de
    // exposicao/status do Edge; PENDING nunca roteia).
    Service? resolveRoute(String hostname) {
        for (var service in this.services) {
            if (service.hostname == hostname) {
                if (statusIsSuspended(service.status)) {
                    return null
                }
                if (exposureIsRoutable(exposureFrom(service.exposure))) {
                    return service
                }
            }
        }
        var custom = this.customByHostname(hostname)
        if (custom != null && custom.status == domainVerified()) {
            var service = this.serviceById(custom.serviceId)
            if (service != null && service.accountId == custom.accountId) {
                if (statusIsSuspended(service.status)) {
                    return null
                }
                if (exposureIsRoutable(exposureFrom(service.exposure))) {
                    return service
                }
            }
        }
        return null
    }

    // ---- dominios proprios (Fase 6) ----

    // Registra um hostname externo para um servico da conta. Devolve o registro
    // PENDING junto com a instrucao de DNS (CNAME para o hostname do servico).
    // Falhas viajam como codigo KCF12x. O registro e idempotente por hostname
    // dentro da conta: re-registrar o mesmo par (servico) devolve o existente.
    CustomDomain registerCustomDomain(String accountId, String hostname, String serviceId) {
        var clean = hostname.trim().toLowerCase()
        if (validCustomHostname(clean) == false) {
            throw errInvalidCustomHostname()
        }
        var service = this.serviceById(serviceId)
        if (service == null) {
            throw errServiceNotFound()
        }
        if (service.accountId != accountId) {
            throw errServiceNotYours()
        }
        var taken = this.customByHostname(clean)
        if (taken != null) {
            if (taken.accountId == accountId && taken.serviceId == serviceId) {
                return taken
            }
            throw errDomainTaken()
        }
        var domain = CustomDomain(clean, accountId, serviceId, domainPending(), "", time.now())
        this.customDomains.add(domain)
        var domOwner = this.accountById(accountId)
        if (domOwner != null) {
            this.audit(auditActorAccount(domOwner.handle), auditDomainRegistered(), accountId + "/" + clean)
        }
        this.save()
        noteDomainRegistered()
        return domain
    }

    CustomDomain? customByHostname(String hostname) {
        var clean = hostname.trim().toLowerCase()
        for (var domain in this.customDomains) {
            if (domain.hostname == clean) {
                return domain
            }
        }
        return null
    }

    List<CustomDomain> customDomainsForAccount(String accountId) {
        var out = listOf<CustomDomain>()
        for (var domain in this.customDomains) {
            if (domain.accountId == accountId) {
                out.add(domain)
            }
        }
        return out
    }

    // Remove o registro. Inexistente e alheio devolvem false (o handler
    // responde o mesmo 404 opaco nos dois casos).
    Bool removeCustomDomain(String accountId, String hostname) {
        var clean = hostname.trim().toLowerCase()
        var out = listOf<CustomDomain>()
        var found = false
        for (var domain in this.customDomains) {
            if (domain.hostname == clean && domain.accountId == accountId) {
                found = true
            } else {
                out.add(domain)
            }
        }
        if (found) {
            this.customDomains = out
            var domOwner = this.accountById(accountId)
            if (domOwner != null) {
                this.audit(auditActorAccount(domOwner.handle), auditDomainRemoved(), accountId + "/" + clean)
            }
            this.save()
            noteDomainRemoved()
        }
        return found
    }

    // Remove registros cujo servico sumiu ou saiu da conta (revogacao de
    // dispositivo remove os servicos; a poda fecha o ciclo).
    void pruneCustomDomains() {
        var alive = listOf<CustomDomain>()
        for (var domain in this.customDomains) {
            var service = this.serviceById(domain.serviceId)
            if (service == null) {
                // orfao: servico sumiu, poda
            } else if (service.accountId == domain.accountId) {
                alive.add(domain)
            }
        }
        this.customDomains = alive
    }

    // Verifica a delegacao DNS: resolve o hostname e confere se ALGUM endereco
    // responde coincide (exato, sem sufixo) com um destino esperado do Edge.
    // `addresses` e injetavel para testes sem rede.
    String verifyCustomDomainWith(String accountId, String hostname, List<String> addresses) {
        var domain = this.customByHostname(hostname)
        if (domain == null) {
            return errDomainNotFound()
        }
        var owner = domain.accountId
        var target = domain.serviceId
        var label = domain.hostname
        if (owner != accountId) {
            return errDomainNotFound()
        }
        if (this.serviceById(target) == null) {
            return errDomainNotFound()
        }
        for (var address in addresses) {
            if (isExpectedEdgeHost(address)) {
                this.markDomainVerified(label)
                return ""
            }
        }
        return errDomainUnreachable()
    }

    // Verifica contra o DNS real. A ordem importa: primeiro dono/existencia
    // (KCF122 opaco, sem tocar na rede), depois o DNS. Falha de resolucao
    // (NXDOMAIN, timeout, rede) vira KCF124 indistinguivel de "resolveu para
    // outro lugar": nos dois casos o hostname ainda nao aponta para este Edge.
    String verifyCustomDomain(String accountId, String hostname) {
        var domain = this.customByHostname(hostname)
        if (domain == null) {
            return errDomainNotFound()
        }
        var owner = domain.accountId
        var label = domain.hostname
        if (owner != accountId) {
            return errDomainNotFound()
        }
        var resolved = listOf<String>()
        try {
            resolved = net.resolve(label)
        } catch (String e) {
            return errDomainUnreachable()
        }
        return this.verifyCustomDomainWith(accountId, hostname, resolved)
    }

    Bool isExpectedEdgeHost(String address) {
        for (var expected in this.edgeHosts) {
            if (expected == address) {
                return true
            }
            if (expected.startsWith("*.") && address.endsWith(expected.substring(1))) {
                return true
            }
        }
        return false
    }

    void markDomainVerified(String hostname) {
        var clean = hostname.trim().toLowerCase()
        var updated = listOf<CustomDomain>()
        for (var domain in this.customDomains) {
            if (domain.hostname == clean) {
                updated.add(CustomDomain(domain.hostname, domain.accountId, domain.serviceId, domainVerified(), longToString(time.now()), domain.createdAt))
            } else {
                updated.add(domain)
            }
        }
        this.customDomains = updated
        var verified = this.customByHostname(clean)
        if (verified != null) {
            var verOwner = this.accountById(verified.accountId)
            if (verOwner != null) {
                this.audit(auditActorAccount(verOwner.handle), auditDomainVerified(), verified.accountId + "/" + clean)
            }
        }
        this.save()
        noteDomainVerified()
    }
}

// Destinos esperados do Edge vindos de config: "ip1,ip2,host" (virgula,
// espaco ou ponto-e-virgula separam). Vazio = nenhum (verificacao sempre
// recusa ate o operador configurar).
List<String> parseEdgeHosts(String raw) {
    var out = listOf<String>()
    var current = ""
    for (var i = 0; i < raw.length; i++) {
        var c = raw.charAt(i)
        if (c == "," || c == ";" || c == " ") {
            if (current.length > 0) {
                out.add(current.toLowerCase())
                current = ""
            }
        } else {
            current = current + (c as Char)
        }
    }
    if (current.length > 0) {
        out.add(current.toLowerCase())
    }
    return out
}
