package kofcloud.control

import kofcloud.control.Metrics
import kofcloud.model.Account
import kofcloud.model.Audit
import kofcloud.model.CustomDomain
import kofcloud.model.Device
import kofcloud.model.Incident
import kofcloud.model.Webhook
import kofcloud.model.Errors
import kofcloud.model.Service
import kofcloud.model.StateCopy
import kofcloud.model.Exposure

import kofcloud.identity.Tokens
import kofcloud.util.Hosts
import kofcloud.util.Limits
import kofcloud.util.Text
import kofcloud.store.Store

// Estado do control plane. Persistido como JSON unico; sem banco no MVP.
// Tokens sao guardados como hash (nunca em claro).
//
// `expiresAt` e NULAVEL de proposito: estados gravados antes da Fase 19 s3
// (credencial de conta com ciclo de vida) nao tem o campo, e `json.decode`
// exige todo campo nao-nulavel (JSN004 medido). Nulavel ausente decodifica
// como null — o token antigo continua valido para sempre, como era.
record TokenEntry(String accountId, String tokenHash, Long createdAt, Long? expiresAt)

record ServiceToken(String serviceId, String accountId, String tokenHash, Long createdAt, Long expiresAt)

// Resultado de congelar um alvo (Fase 17 slice 2).
record FreezeResult(Bool ok, String incidentId, Int revoked, String priorStatus)

// Resultado de descongelar: `ok` = alvo existe e e do dono (404 quando
// falso); `restored` = havia marca de congelamento e o status anterior
// voltou (409 quando falso). Sem essa distincao, um unfreeze de alvo nunca
// congelado gravava UNKNOWN/ACTIVE e apagava uma suspensao deliberada do
// operador — o CLI ainda dizia "status anterior restaurado".
record UnfreezeResult(Bool ok, Bool restored)

// Resultado da rotacao assistida (Fase 19 slice 3).
record RotateResult(String token, Int revoked, Int pending)

record ControlState(List<Account> accounts, List<Device> devices, List<Service> services, List<TokenEntry> tokens, List<ServiceToken> serviceTokens, List<CustomDomain> customDomains, List<AuditEvent> audit, List<Incident> incidents, List<WebhookConfig> webhooks)

class Registry {
    List<Account> accounts
    List<Device> devices
    List<Service> services
    List<TokenEntry> tokens
    List<ServiceToken> serviceTokens
    List<CustomDomain> customDomains
    List<AuditEvent> audit
    List<Incident> incidents
    List<WebhookConfig> webhooks
    // Resultado da carga: "ok" | "absent" (arquivo novo) | "corrupt" (ilegivel).
    // Antes a corrupcao virava estado vazio em silencio — o operador via a
    // conta sumida sem aviso. O serve agora anuncia "corrupt".
    String loadStatus
    String path
    Int maxDevices
    Int maxServices
    // Destinos que a verificacao de dominio proprio aceita: IPs e/ou hostnames
    // do Edge (config `kofcloud.edgeHosts`, separados por virgula). Comparacao
    // exata, sem sufixo: subdominios de um host esperado NAO valem.
    List<String> edgeHosts
    // Espelho das sessoes vivas do Edge NESTE processo (deviceId -> true).
    // Nao e persistido: presenca e efemera, some no restart. So o Edge
    // escreve aqui (via bind/unbind); o control plane so le, filtrado por
    // conta. Em deploy multi-processo cada Edge tem o seu mapa.
    Map<String, Bool> edgeOnline
    // Sonda de tentativas de login por handle (Fase 5): "<count>;<startMs>"
    // em String porque `Map<String, Int>` como campo quebra o verificador
    // JVM (L11). Nao persistida: e sinal de ataque em curso, efemero como
    // `edgeOnline`. A chave e o handle (o control plane nao ve o IP).
    Map<String, String> loginProbes
    // Sondas de expiracao em massa (por conta, Fase 17 slice 1): janela
    // deslizante em memoria, nao persistida (o padrao e efemero, como
    // `edgeOnline`). Valor `"<count>;<windowStartMs>"` porque
    // `Map<String, Int>` como campo de classe quebra o verificador JVM (L11).
    Map<String, String> expiryProbes

    constructor(path: String) {
        this.path = path
        this.accounts = listOf<Account>()
        this.devices = listOf<Device>()
        this.services = listOf<Service>()
        this.tokens = listOf<TokenEntry>()
        this.serviceTokens = listOf<ServiceToken>()
        this.customDomains = listOf<CustomDomain>()
        this.audit = listOf<AuditEvent>()
        this.incidents = listOf<Incident>()
        this.webhooks = listOf<WebhookConfig>()
        this.freezeMarks = mapOf()
        this.edgeOnline = mapOf()
        this.expiryProbes = mapOf()
        this.loginProbes = mapOf()
        this.maxDevices = limitDevices()
        this.maxServices = limitServices()
        this.edgeHosts = parseEdgeHosts(config.str("kofcloud.edgeHosts", ""))
        this.load()
    }

    // Permite aos testes fixarem os destinos esperados sem config de processo.
    void setEdgeHosts(List<String> hosts) {
        this.edgeHosts = hosts
    }

    // Permite aos testes exercitarem o limite sem depender de env/config do
    // processo (config e lido uma vez, no start).
    void setLimits(Int devices, Int services) {
        this.maxDevices = devices
        this.maxServices = services
    }

    Int activeDeviceCount(String accountId) {
        var count = 0
        for (var device in this.devices) {
            if (device.accountId == accountId && deviceIsActive(device)) {
                count = count + 1
            }
        }
        return count
    }

    void load() {
        this.loadStatus = "absent"
        var raw = readTextOr(this.path, "")
        if (raw.length == 0) {
            return
        }
        try {
            // `json.decode` aceita chaves extras e devolve listas vazias para
            // campos ausentes — um JSON qualquer "decodifica" como estado
            // vazio. A forma e validada explicitamente: o arquivo precisa ter
            // as chaves do ControlState (JSN004 so pega campo faltando em
            // record aninhado, nao no topo).
            if (looksLikeControlState(raw) == false) {
                this.loadStatus = "corrupt"
                return
            }
            var state = json.decode<ControlState>(raw)
            this.accounts = state.accounts
            this.devices = state.devices
            this.services = state.services
            this.tokens = state.tokens
            this.serviceTokens = state.serviceTokens
            this.customDomains = state.customDomains
            this.audit = state.audit
            this.incidents = state.incidents
            this.webhooks = state.webhooks
            this.loadStatus = "ok"
        } catch (String e) {
            this.loadStatus = "corrupt"
            // Estado corrompido: recomeca vazio em vez de derrubar o control
            // plane. O operador ve os dados ausentes e decide.
        }
    }

    // Trilha de auditoria: anel capado (fonte unica `limitAuditEvents()`).
    // So metadados operacionais; nunca senha, token, chave ou conteudo.
    void audit(String actor, String action, String target) {
        // Encadeia com o ultimo evento DA MESMA CONTA (cadeia de integridade,
        // Fase 19 s4). A cadeia do anel inteiro misturava as contas: a lista
        // verificada e por conta (`auditForAccount`), entao duas contas ativas
        // "quebravam" a cadeia uma da outra sem adulteracao nenhuma. Com a
        // cadeia por conta, a mesma funcao verifica o anel global e a lista
        // filtrada — e a remocao/adulteracao de um evento continua detectavel.
        var accountId = auditTargetAccount(target)
        var prev = ""
        var i = this.audit.size - 1
        while (i >= 0) {
            var previous = this.audit.get(i)
            if (auditTargetAccount(previous.target) == accountId) {
                prev = previous.hash
                i = -1
            } else {
                i = i - 1
            }
        }
        var at = longToString(time.now())
        var hash = auditEventHash(prev, at, actor, action, target)
        this.audit.add(AuditEvent(at, actor, action, target, prev, hash))
        var cap = limitAuditEvents()
        if (cap <= 0) {
            cap = 100
        }
        while (this.audit.size > cap) {
            this.audit = this.audit.subList(1, this.audit.size)
        }
    }

    List<AuditEvent> auditForAccount(String accountId) {
        var out = listOf<AuditEvent>()
        for (var event in this.audit) {
            if (event.target == accountId || event.target.startsWith(accountId + "/")) {
                out.add(event)
            }
        }
        return out
    }

    // ---- incidentes (Fase 17 slice 1) ----

    // Abre um incidente. Idempotente por (kind, accountId): se ja ha um
    // ABERTO do mesmo tipo para a mesma conta, devolve null (o operador ve
    // um incidente, nao um por ocorrencia). `accountId` "" = escopo global.
    // ---- webhook de incidentes (Fase 17 slice 3) ----

    // Cadastra/troca o webhook da conta. Valida URL e segredo (puros) e
    // barra host que aponte para rede interna (SSRF): o POST sai do processo
    // do control plane com o header de assinatura, entao um webhook apontado
    // para 169.254.169.254 (metadata de nuvem) ou para a rede privada do
    // operador seria um tunel de request forjado pela conta. O resolve roda
    // AQUI (I/O na borda do Registry, padrao do verifyCustomDomain); DNS
    // indisponivel nao bloqueia (fail-open com o IP literal ainda guardado).
    String setWebhook(String accountId, String url, String secret) {
        var urlError = webhookUrlError(url)
        if (urlError.length > 0) {
            throw urlError
        }
        var secretError = webhookSecretError(secret.trim())
        if (secretError.length > 0) {
            throw secretError
        }
        var host = webhookUrlHost(url)
        if (webhookHostIsInternal(host)) {
            throw "url host is an internal address"
        }
        var resolved = listOf<String>()
        try {
            resolved = net.resolve(host)
        } catch (String e) {
            // Sem DNS agora: segue (o erro de entrega aparece no POST real).
        }
        var dnsError = webhookDnsError(host, resolved)
        if (dnsError.length > 0) {
            throw dnsError
        }
        var out = listOf<WebhookConfig>()
        for (var existing in this.webhooks) {
            if (existing.accountId != accountId) {
                out.add(existing)
            }
        }
        out.add(WebhookConfig(accountId, url.trim(), secret.trim(), time.now()))
        this.webhooks = out
        this.save()
        return "ok"
    }

    Bool removeWebhook(String accountId) {
        var out = listOf<WebhookConfig>()
        var found = false
        for (var existing in this.webhooks) {
            if (existing.accountId == accountId) {
                found = true
            } else {
                out.add(existing)
            }
        }
        if (found) {
            this.webhooks = out
            this.save()
        }
        return found
    }

    // Config sem o segredo (o que a API/CLI pode devolver).
    WebhookConfig? webhookForAccount(String accountId) {
        for (var existing in this.webhooks) {
            if (existing.accountId == accountId) {
                return existing
            }
        }
        return null
    }

    // POST assinado ao webhook da conta. `deliver` injetavel nos testes.
    // Falha de rede NAO propaga: incidente sem entrega e melhor que incidente
    // nao registrado. Devolve o status HTTP (0 = nao tentou/falhou).
    Int deliverWebhook(String accountId, String kind, String severity, String summary, Long atMs) {
        var config = this.webhookForAccount(accountId)
        if (config == null) {
            return 0
        }
        var payload = webhookPayload(kind, severity, summary, atMs)
        var header = webhookSignatureHeader(config.secret, payload)
        return postWebhook(config.url, payload, header)
    }

    Incident? raiseIncident(String kind, String accountId) {
        for (var existing in this.incidents) {
            if (existing.kind == kind && existing.accountId == accountId && existing.resolvedAt == 0) {
                return null
            }
        }
        var incident = Incident(
            uuid.v4(), kind, incidentSeverityFor(kind), accountId,
            incidentSummaryFor(kind), time.now(), 0
        )
        this.incidents.add(incident)
        var cap = limitIncidents()
        while (this.incidents.size > cap) {
            this.incidents = this.incidents.subList(1, this.incidents.size)
        }
        this.save()
        if (accountId.length > 0) {
            this.deliverWebhook(accountId, kind, incident.severity, incident.summary, incident.openedAt)
        }
        return incident
    }

    Bool resolveIncident(String id) {
        var out = listOf<Incident>()
        var found = false
        for (var incident in this.incidents) {
            if (incident.id == id && incident.resolvedAt == 0) {
                out.add(Incident(incident.id, incident.kind, incident.severity, incident.accountId, incident.summary, incident.openedAt, time.now()))
                found = true
            } else {
                out.add(incident)
            }
        }
        if (found) {
            this.incidents = out
            this.save()
        }
        return found
    }

    // Incidentes de uma conta; `includeGlobal` inclui os de plataforma.
    List<Incident> incidentsForAccount(String accountId, Bool includeGlobal) {
        var out = listOf<Incident>()
        for (var incident in this.incidents) {
            if (incident.accountId == accountId) {
                out.add(incident)
            } else if (includeGlobal && incident.accountId.length == 0) {
                out.add(incident)
            }
        }
        return out
    }

    List<Incident> allIncidents() {
        return this.incidents
    }

    // Conta as ocorrencias de uma acao no audit da conta desde `sinceMs`.
    Int auditCountSince(String accountId, String action, Long sinceMs) {
        var count = 0
        for (var event in this.audit) {
            if (event.target == accountId || event.target.startsWith(accountId + "/")) {
                // `at` e epoch em MILISSEGUNDOS (Long): encurta para Int antes
                // de comparar — parseIntSafe corta em 32 bits e todo evento
                // parecia fora da janela (incidente de lote nunca abria).
                var atMs = parseLongSafe(event.at, 0)
                if (event.action == action && atMs >= sinceMs) {
                    count = count + 1
                }
            }
        }
        return count
    }

    // Detector de expiracao em massa de `kfs_` (por conta, Fase 17 slice 1).
    // Mesma ideia das sondas do Edge: conta quantas credenciais da conta
    // venceram DENTRO da janela e abre o incidente quando o limiar fecha.
    // Expiracao isolada e o fluxo normal da rotacao por TTL; varias juntas
    // significam planejamento quebrado (TTL curto sem re-emissao) ou estado
    // adulterado — nesse caso o servico cai para cliente legitimo sem acao
    // do operador. O incidente e da conta porque o dano e da conta; nao
    // carrega servico, token nem valor (regra de privacidade).
    // `expiredCount` e o lote vencido desta varredura (uma varredura pode
    // achar varias de uma vez, entao nao da para somar 1 por vez). O
    // incidente so abre quando o total na janela ALCANCA o limiar; aberto
    // ele fica idempotente (`raiseIncident` deduplica por sinal+conta).
    Incident? detectMassTokenExpiry(String accountId, Long nowMs, Int expiredCount) {
        if (accountId.length == 0 || expiredCount <= 0) {
            return null
        }
        var count = 0
        var windowStart = nowMs
        var saved = this.expiryProbes.get(accountId)
        if (saved != null) {
            // Separador `;`: `split` do stdlib trata o argumento como regex e
            // `|` seria alternancia vazia (sempre zero partes). `;` e literal.
            // So escrito aqui (`intToString(count)`, contador de memoria +
            // `expiredCount` desta varredura), nunca chega do fio/rede: mesmo
            // veredito dos contadores internos (semaforo e fila); se o parse
            // falhar, 0 soma so o lote atual (abre menos, nunca mais).
            var parts = saved.split(";")
            if (parts.length == 2) {
                count = parseIntSafe(parts[0], 0)
                windowStart = parseLongSafe(parts[1], nowMs)
            }
        }
        if (nowMs - windowStart > limitMassTokenExpiryWindowMs()) {
            count = 0
            windowStart = nowMs
        }
        count = count + expiredCount
        this.expiryProbes.put(accountId, intToString(count) + ";" + longToString(windowStart))
        if (count >= limitMassTokenExpiryThreshold()) {
            return this.raiseIncident(incidentMassTokenExpiry(), accountId)
        }
        return null
    }

    // Detector de revogacao em lote (por conta, idempotente). Devolve o
    // incidente aberto agora ou null.
    Incident? detectBulkRevokes(String accountId, Long windowMs) {
        var since = time.now() - windowMs
        if (this.auditCountSince(accountId, auditDeviceRevoked(), since) >= bulkRevokeThreshold()) {
            return this.raiseIncident(incidentBulkDeviceRevokes(), accountId)
        }
        if (this.auditCountSince(accountId, auditServiceTokenRevoked(), since) >= bulkRevokeThreshold()) {
            return this.raiseIncident(incidentBulkTokenRevokes(), accountId)
        }
        return null
    }

    // O arquivo tem a forma de um ControlState? Checa as chaves de topo que
    // o save() sempre grava. Pura sobre o texto.
    Bool looksLikeControlState(String raw) {
        var trimmed = raw.trim()
        if (trimmed.startsWith("{") == false) {
            return false
        }
        return trimmed.indexOf("\"accounts\"") >= 0
            && trimmed.indexOf("\"devices\"") >= 0
            && trimmed.indexOf("\"services\"") >= 0
    }

    // Copia de seguranca do estado em disco antes de trocar o processo de
    // banco (Fase 16 s1). Devolve o caminho do backup, "" quando nao ha
    // arquivo para preservar, ou "!" quando o arquivo existe mas a copia
    // falhou — aviso explicito, nunca silencio.
    String backupStateFile(String stamp) {
        if (fileExists(this.path) == false) {
            return ""
        }
        // Um arquivo ilegivel tambem e preservado: pode ser a unica copia.
        var target = this.path + ".bak-" + stamp
        if (File(this.path).copyTo(target) == false) {
            return "!"
        }
        return target
    }

    // Contagens do estado carregado (migracao --dry-run, Fase 16 s1).
    StateCounts stateCounts() {
        return StateCounts(
            this.accounts.size, this.devices.size, this.services.size,
            this.tokens.size, this.serviceTokens.size, this.customDomains.size,
            this.audit.size, this.incidents.size, this.webhooks.size
        )
    }

    void save() {
        writeTextTo(this.path, json.encode(ControlState(this.accounts, this.devices, this.services, this.tokens, this.serviceTokens, this.customDomains, this.audit, this.incidents, this.webhooks)))
    }

    // ---- contas ----

    Account createAccount(String handle, String email, String password) {
        if (validHandle(handle) == false) {
            throw errInvalidHandle()
        }
        if (this.accountByHandle(handle) != null) {
            throw errHandleTaken()
        }
        var account = Account(uuid.v4(), handle, email, passwords.hash(password), time.now())
        this.accounts.add(account)
        this.audit(auditActorAccount(handle), auditAccountCreated(), account.id)
        this.save()
        noteAccountCreated()
        return account
    }

    Account? accountByHandle(String handle) {
        for (var account in this.accounts) {
            if (account.handle == handle) {
                return account
            }
        }
        return null
    }

    Account? accountById(String id) {
        for (var account in this.accounts) {
            if (account.id == id) {
                return account
            }
        }
        return null
    }

    Account? accountByToken(String token) {
        if (token.length == 0) {
            return null
        }
        var now = time.now()
        var matched = ""
        var expired = 0
        for (var entry in this.tokens) {
            if (this.accountTokenExpired(entry, now)) {
                expired = expired + 1
                continue
            }
            if (matched.length == 0 && tokenMatches(entry.tokenHash, token)) {
                matched = entry.accountId
            }
        }
        // Poda preguicosa (mesmo padrao do kfs_): credencial vencida nao
        // acumula no estado e o proximo `token list` ja nao mostra.
        if (expired > 0) {
            this.pruneExpiredAccountTokens()
        }
        if (matched.length == 0) {
            return null
        }
        return this.accountById(matched)
    }

    // Conta uma tentativa de login para o handle. Devolve false quando a
    // conta ATINGIU o teto na janela (o chamador responde 429 antes de
    // verificar senha). Um ACERTO reseta a janela daquele handle: um
    // usuario legitimo que errou a senha nao fica travado pelo proprio
    // sucesso depois.
    Bool loginAttemptBlocked(String handle) {
        var trimmed = handle.trim().toLowerCase()
        if (trimmed.length == 0) {
            return false
        }
        var now = time.now()
        var saved = this.loginProbes.get(trimmed)
        var count = 0
        var start = now
        if (saved != null) {
            var parts = saved.split(";")
            if (parts.length == 2) {
                count = parseIntSafe(parts[0], 0)
                start = parseLongSafe(parts[1], now)
            }
        }
        if (now - start > limitLoginWindowMs()) {
            count = 0
            start = now
        }
        count = count + 1
        this.loginProbes.put(trimmed, intToString(count) + ";" + longToString(start))
        return count > limitLoginAttempts()
    }

    void loginAttemptReset(String handle) {
        this.loginProbes.remove(handle.trim().toLowerCase())
    }

    // ---- credenciais da conta (kfc_) ----
    //
    // O kfc_ e o token mais poderoso do sistema: autoriza publicar, revogar
    // dispositivo, congelar conta. Ate aqui ele nao tinha ciclo de vida —
    // `logout` so apagava o arquivo local e o valor seguia valido para
    // sempre no servidor. O desenho abaixo espelha o do kfs_ (que ja provou
    // o padrao): hash em repouso, TTL opcional, inventario sem valores,
    // revogacao por id curto e rotacao com overlap.

    Long accountTokenExpiry(Long nowMs, Int ttlHours) {
        return tokenExpiryAt(nowMs, ttlHours)
    }

    Bool accountTokenExpired(TokenEntry entry, Long nowMs) {
        var expiresAt = entry.expiresAt
        if (expiresAt == null) {
            return false
        }
        if (expiresAt <= 0) {
            return false
        }
        return nowMs >= expiresAt
    }

    String issueToken(String accountId) {
        return this.issueToken(accountId, 0)
    }

    // Emite uma credencial de conta. `ttlHours` <= 0 = sem expiracao (o
    // comportamento historico do login); > 0 fixa o prazo.
    String issueToken(String accountId, Int ttlHours) {
        var token = newAccountToken()
        var expiresAt = this.accountTokenExpiry(time.now(), ttlHours)
        this.tokens.add(TokenEntry(accountId, tokenHash(token), time.now(), expiresAt))
        this.save()
        return token
    }

    // Credenciais VALIDAS da conta (expiradas nao aparecem — mesma regra do
    // kfs_: o que nao autoriza nao e listado). Nunca devolve o valor.
    List<TokenEntry> accountTokensFor(String accountId) {
        var now = time.now()
        var out = listOf<TokenEntry>()
        for (var entry in this.tokens) {
            if (entry.accountId == accountId && this.accountTokenExpired(entry, now) == false) {
                out.add(entry)
            }
        }
        return out
    }

    // Poda preguicosa das credenciais de conta vencidas. Devolve quantas
    // sairam. Chamada pela validacao (accountByToken) e pelo inventario.
    Int pruneExpiredAccountTokens() {
        var now = time.now()
        var kept = listOf<TokenEntry>()
        var removed = 0
        for (var entry in this.tokens) {
            if (this.accountTokenExpired(entry, now)) {
                removed = removed + 1
            } else {
                kept.add(entry)
            }
        }
        if (removed > 0) {
            this.tokens = kept
            this.save()
        }
        return removed
    }

    // Revoga TODAS as credenciais da conta, menos a informada. Cada `login`
    // emite um token novo e nunca revoga o anterior (nao ha TTL por default),
    // entao o inventario cresce a cada entrada e um token vazado de um login
    // antigo continua valendo para sempre. A sessao atual e preservada: sem
    // isso o operador se trancaria fora no mesmo comando. Devolve quantas
    // sairam; nunca toca credencial de outra conta.
    Int pruneAccountTokensExcept(String accountId, String keepToken) {
        if (keepToken.length == 0) {
            return 0
        }
        var kept = listOf<TokenEntry>()
        var removed = 0
        for (var entry in this.tokens) {
            if (entry.accountId == accountId && tokenMatches(entry.tokenHash, keepToken) == false) {
                removed = removed + 1
            } else {
                kept.add(entry)
            }
        }
        if (removed > 0) {
            this.finishAccountTokenRevoke(accountId, kept)
        }
        return removed
    }

    // Revoga UMA credencial da conta pelo valor completo OU pelo id curto do
    // inventario (8 hex do hash), desde que unico na conta. Devolve
    // "revoked" | "ambiguous" | "" (nao encontrado). Nunca confirma nem nega
    // credencial de outra conta: o filtro e por accountId.
    String revokeAccountTokenResult(String accountId, String token) {
        if (token.length == 0) {
            return ""
        }
        var kept = listOf<TokenEntry>()
        var revoked = false
        for (var entry in this.tokens) {
            if (entry.accountId == accountId && tokenMatches(entry.tokenHash, token)) {
                revoked = true
            } else {
                kept.add(entry)
            }
        }
        if (revoked) {
            this.finishAccountTokenRevoke(accountId, kept)
            return "revoked"
        }
        var matches = 0
        for (var entry in this.tokens) {
            if (entry.accountId == accountId && entry.tokenHash.startsWith(token)) {
                matches = matches + 1
            }
        }
        if (matches == 0) {
            return ""
        }
        if (matches > 1) {
            return "ambiguous"
        }
        var keptShort = listOf<TokenEntry>()
        for (var entry in this.tokens) {
            if (entry.accountId == accountId && entry.tokenHash.startsWith(token)) {
                continue
            }
            keptShort.add(entry)
        }
        this.finishAccountTokenRevoke(accountId, keptShort)
        return "revoked"
    }

    void finishAccountTokenRevoke(String accountId, List<TokenEntry> kept) {
        this.tokens = kept
        var owner = this.accountById(accountId)
        if (owner != null) {
            // Audita a conta, nunca o token.
            this.audit(auditActorAccount(owner.handle), auditAccountTokenRevoked(), accountId)
        }
        this.save()
    }

    // Rotacao com overlap: emite a nova e revoga as antigas APENAS quando ja
    // passaram do prazo. Credencial sem expiracao nao e revogada em silencio
    // (o operador pode estar usando em CI) — fica contada como pendente.
    RotateResult rotateAccountTokens(String accountId, Int ttlHours) {
        var token = this.issueToken(accountId, ttlHours)
        var now = time.now()
        var kept = listOf<TokenEntry>()
        var revoked = 0
        var pending = 0
        for (var entry in this.tokens) {
            if (entry.accountId != accountId) {
                kept.add(entry)
                continue
            }
            if (tokenMatches(entry.tokenHash, token)) {
                kept.add(entry)
            } else if (this.accountTokenExpired(entry, now)) {
                revoked = revoked + 1
            } else {
                kept.add(entry)
                pending = pending + 1
            }
        }
        if (revoked > 0) {
            this.finishAccountTokenRevoke(accountId, kept)
        }
        return RotateResult(token, revoked, pending)
    }

    // Quantas credenciais da conta ainda valem (a nova incluida).
    Int pendingAccountRotationCount(String accountId) {
        return this.accountTokensFor(accountId).size
    }

    String login(String handle, String password) {
        var account = this.accountByHandle(handle)
        if (account == null) {
            throw errInvalidCredentials()
        }
        if (passwords.verify(password, account.passwordHash) == false) {
            throw errInvalidCredentials()
        }
        return this.issueToken(account.id)
    }

    // ---- dispositivos ----

    Device registerDevice(Account account, String name, String publicKey) {
        // Dedup por nome SOMENTE enquanto o device existente nao foi revogado.
        // Revogar e terminal e o `doctor` orienta "registre de novo" — mas
        // `deviceByName` casava qualquer status, entao o re-registro devolvia
        // o PROPRIO device revogado (mesmo id, ainda REVOKED, sem chave nova):
        // o caminho de recuperacao anunciado nao existia. Revogado nao conta
        // para o teto de ativos, entao um device novo cabe.
        //
        // A busca IGNORA os revogados (nao usa `deviceByName`, que devolve o
        // primeiro): apos um re-registro convivem o revogado e o novo com o
        // mesmo nome, e casar o primeiro devolveria o morto de novo — cada
        // login criaria mais um device.
        var existing = this.activeDeviceByName(account.id, name)
        if (existing != null) {
            return existing
        }
        if (this.activeDeviceCount(account.id) >= this.maxDevices) {
            throw errLimitDevices()
        }
        var device = Device(uuid.v4(), account.id, name, publicKey, deviceActive(), time.now(), time.now())
        this.devices.add(device)
        this.audit(auditActorAccount(account.handle), auditDeviceRegistered(), account.id + "/" + device.id)
        this.save()
        noteDeviceRegistered()
        return device
    }

    Device? deviceById(String id) {
        for (var device in this.devices) {
            if (device.id == id) {
                return device
            }
        }
        return null
    }

    Device? deviceByName(String accountId, String name) {
        for (var device in this.devices) {
            if (device.accountId == accountId && device.name == name) {
                return device
            }
        }
        return null
    }

    // Device com este nome que ainda VALE (nao revogado). Um nome revogado
    // pode conviver com o registro novo do mesmo nome; quem procura o "dono
    // do nome" quer o vivo. Mesma regra de status do `deviceIsRevoked`.
    Device? activeDeviceByName(String accountId, String name) {
        for (var device in this.devices) {
            if (device.accountId == accountId && device.name == name) {
                if (deviceIsRevoked(device.status) == false) {
                    return device
                }
            }
        }
        return null
    }

    List<Device> devicesForAccount(String accountId) {
        var out = listOf<Device>()
        for (var device in this.devices) {
            if (device.accountId == accountId) {
                out.add(device)
            }
        }
        return out
    }

    Bool revokeDevice(String accountId, String deviceId) {
        var revoked = this.revokeDeviceInner(accountId, deviceId)
        if (revoked) {
            this.detectBulkRevokes(accountId, bulkRevokeWindowMs())
        }
        return revoked
    }

    Bool revokeDeviceInner(String accountId, String deviceId) {
        var account = this.accountById(accountId)
        var actor = "account:?"
        if (account != null) {
            actor = auditActorAccount(account.handle)
        }
        var found = false
        var updated = listOf<Device>()
        for (var device in this.devices) {
            if (device.id == deviceId && device.accountId == accountId) {
                updated.add(Device(device.id, device.accountId, device.name, device.publicKey, deviceRevoked(), device.lastSeenAt, device.createdAt))
                found = true
            } else {
                updated.add(device)
            }
        }
        if (found) {
            this.devices = updated
            this.removeServicesOfDevice(deviceId)
            this.pruneServiceTokens()
            this.pruneCustomDomains()
            this.audit(actor, auditDeviceRevoked(), accountId + "/" + deviceId)
            this.save()
            noteDeviceRevoked()
        }
        return found
    }

    // Suspensao administrativa de dispositivo: recusa o tunel com
    // DEVICE_SUSPENDED, sem remover nada. Idempotente.
    Bool suspendDevice(String accountId, String deviceId) {
        return this.setDeviceStatus(accountId, deviceId, deviceSuspended(), auditDeviceSuspended())
    }

    Bool unsuspendDevice(String accountId, String deviceId) {
        return this.setDeviceStatus(accountId, deviceId, deviceActive(), auditDeviceUnsuspended())
    }

    Bool setDeviceStatus(String accountId, String deviceId, String status, String action) {
        var account = this.accountById(accountId)
        var actor = "account:?"
        if (account != null) {
            actor = auditActorAccount(account.handle)
        }
        var found = false
        var updated = listOf<Device>()
        for (var device in this.devices) {
            if (device.id == deviceId && device.accountId == accountId) {
                // REVOKED e terminal: revogar e a acao de contencao de uma
                // maquina comprometida (remove servicos e credenciais) e o
                // Agent trata DEVICE_REVOKED como fatal. Antes `unsuspend`
                // gravava ACTIVE em cima de um device revogado — a contencao
                // era desfeita por um comando de rotina, sem re-registro nem
                // nova chave. So a propria revogacao (no-op) pode reescrever
                // um REVOKED; qualquer outra transicao e recusada.
                if (device.status == deviceRevoked() && status != deviceRevoked()) {
                    return false
                }
                updated.add(Device(device.id, device.accountId, device.name, device.publicKey, status, device.lastSeenAt, device.createdAt))
                found = true
            } else {
                updated.add(device)
            }
        }
        if (found) {
            this.devices = updated
            if (action == auditDeviceSuspended()) {
                this.audit(actor, action, accountId + "/" + deviceId)
                this.save()
                noteDeviceSuspended()
            } else if (action == auditDeviceUnsuspended()) {
                this.audit(actor, action, accountId + "/" + deviceId)
                this.save()
                noteDeviceUnsuspended()
            } else {
                this.save()
            }
        }
        return found
    }

    void touchDevice(String deviceId) {
        var updated = listOf<Device>()
        for (var device in this.devices) {
            if (device.id == deviceId) {
                updated.add(Device(device.id, device.accountId, device.name, device.publicKey, device.status, time.now(), device.createdAt))
            } else {
                updated.add(device)
            }
        }
        this.devices = updated
        this.save()
    }

    // Espelho de presenca do Edge (mesmo processo): true ao ligar o tunel,
    // false ao desligar. Sem persistencia — restart limpa tudo, e a primeira
    // reconexao do Agent recria a entrada.
    void noteEdgeOnline(String deviceId, Bool online) {
        if (online) {
            this.edgeOnline.put(deviceId, true)
        } else {
            this.edgeOnline.remove(deviceId)
        }
    }

    Bool edgeIsOnline(String deviceId) {
        return this.edgeOnline.get(deviceId) == true
    }

    // Ids dos dispositivos DA CONTA com sessao viva neste Edge. Filtragem por
    // conta aqui (e nao no chamador): o endpoint responde so com o que e do
    // dono do token — nada de terceiros vaza, nem existencia.
    List<String> onlineDeviceIdsFor(String accountId) {
        var out = listOf<String>()
        for (var device in this.devicesForAccount(accountId)) {
            if (this.edgeIsOnline(device.id)) {
                out.add(device.id)
            }
        }
        return out
    }

    // ---- tokens de servico (AUTHENTICATED) ----

    // `expiresAt` em ms desde a epoca; 0 = sem expiracao (tokens antigos e o
    // default de emissao). Expirado nao autoriza nem aparece no inventario.
    Long serviceTokenExpiry(Long nowMs, Int ttlHours) {
        return tokenExpiryAt(nowMs, ttlHours)
    }

    Bool serviceTokenExpired(ServiceToken entry, Long nowMs) {
        if (entry.expiresAt <= 0) {
            return false
        }
        return nowMs >= entry.expiresAt
    }

    // Atalho sem TTL (sem expiracao): mantem os chamadores antigos e os
    // tokens antigos validos para sempre, como antes.
    String issueServiceToken(String accountId, String serviceId) {
        return this.issueServiceToken(accountId, serviceId, 0)
    }

    // Emite uma credencial nova para o servico. Varias podem existir (rotacao
    // sem downtime); cada uma e guardada apenas como hash. `ttlHours` <= 0
    // significa sem expiracao (comportamento antigo); > 0 fixa `expiresAt`.
    String issueServiceToken(String accountId, String serviceId, Int ttlHours) {
        var service = this.serviceById(serviceId)
        if (service == null) {
            throw errServiceNotFound()
        }
        if (service.accountId != accountId) {
            throw errServiceTokenForbidden()
        }
        var token = newServiceToken()
        var expiresAt = serviceTokenExpiry(time.now(), ttlHours)
        this.serviceTokens.add(ServiceToken(serviceId, accountId, tokenHash(token), time.now(), expiresAt))
        var issuer = this.accountById(accountId)
        if (issuer != null) {
            this.audit(auditActorAccount(issuer.handle), "service.token_issued", accountId + "/" + serviceId)
        }
        this.save()
        noteServiceTokenIssued()
        return token
    }

    // Resolve o servico dono de um token de servico; null se invalido OU
    // expirado. Expirado e podado na hora (preguicoso): nao acumula lixo e o
    // proximo `list` ja nao mostra.
    Service? serviceByServiceToken(String token) {
        if (token.length == 0) {
            return null
        }
        var now = time.now()
        var kept = listOf<ServiceToken>()
        // Guarda as vencidas (tipado) para atribuir por conta depois da poda.
        // Mapa local nao serve: `mapOf()` sem tipo devolve `Object` no `get` e
        // o verificador JVM recusa (VerifyError medido).
        var expiredEntries = listOf<ServiceToken>()
        var expiredAccounts = listOf<String>()
        var matchedServiceId = ""
        for (var entry in this.serviceTokens) {
            if (serviceTokenExpired(entry, now)) {
                expiredEntries.add(entry)
                if (expiredAccounts.contains(entry.accountId) == false) {
                    expiredAccounts.add(entry.accountId)
                }
                continue
            }
            kept.add(entry)
            if (matchedServiceId.length == 0 && tokenMatches(entry.tokenHash, token)) {
                matchedServiceId = entry.serviceId
            }
        }
        if (kept.size != this.serviceTokens.size) {
            this.serviceTokens = kept
            this.save()
        }
        var i = 0
        while (i < expiredEntries.size) {
            noteServiceTokenExpired()
            i = i + 1
        }
        // Sinal de expiracao em massa (Fase 17 slice 1): cada varredura que
        // podou credencial alimenta a sonda da CONTA dona — varias vencendo
        // na janela e rotacao quebrada, nao rotina. Roda depois da poda para
        // o incidente nunca atrasar a autenticacao que veio antes.
        for (var owner in expiredAccounts) {
            var tally = 0
            for (var gone in expiredEntries) {
                if (gone.accountId == owner) {
                    tally = tally + 1
                }
            }
            this.detectMassTokenExpiry(owner, now, tally)
        }
        if (matchedServiceId.length == 0) {
            return null
        }
        return this.serviceById(matchedServiceId)
    }

    // Inventario das credenciais de UM servico (para `service token list`).
    // Devolve os registros (hash + emissao), nunca o valor: o kfs_ em claro
    // so existe no instante da emissao. Filtra por conta dona aqui (e nao
    // no chamador): inexistente e alheio dao lista vazia, sem oraculo.
    // Expirados nao aparecem (mesma regra da validacao — coerencia: o que
    // nao autoriza nao e listado).
    List<ServiceToken> serviceTokensFor(String accountId, String serviceId) {
        var service = this.serviceById(serviceId)
        if (service == null) {
            return listOf<ServiceToken>()
        }
        if (service.accountId != accountId) {
            return listOf<ServiceToken>()
        }
        var now = time.now()
        var out = listOf<ServiceToken>()
        for (var entry in this.serviceTokens) {
            if (entry.serviceId == serviceId && serviceTokenExpired(entry, now) == false) {
                out.add(entry)
            }
        }
        return out
    }

    // Higiene de credenciais (Fase 19 slice 2): credenciais VALIDAS e SEM
    // expiracao da conta. Nao ha como revoga-las sozinho sem quebrar
    // consumidores — o relatorio aponta e a rotacao (service rotate --ttl)
    // e o passo recomendado.
    List<ServiceToken> tokensWithoutExpiry(String accountId) {
        var now = time.now()
        var out = listOf<ServiceToken>()
        for (var entry in this.serviceTokens) {
            if (entry.accountId == accountId) {
                if (entry.expiresAt <= 0 && this.serviceTokenExpired(entry, now) == false) {
                    out.add(entry)
                }
            }
        }
        return out
    }

    // Nomes dos servicos da conta que tem pelo menos uma credencial sem TTL.
    List<String> servicesWithUnrotatedTokens(String accountId) {
        var out = listOf<String>()
        for (var entry in this.tokensWithoutExpiry(accountId)) {
            var service = this.serviceById(entry.serviceId)
            if (service != null) {
                if (out.contains(service.name) == false) {
                    out.add(service.name)
                }
            }
        }
        return out
    }

    // Remove credenciais orfas (servico removido ou dispositivo revogado).
    void pruneServiceTokens() {
        var alive = listOf<ServiceToken>()
        for (var entry in this.serviceTokens) {
            if (this.serviceById(entry.serviceId) != null) {
                alive.add(entry)
            }
        }
        this.serviceTokens = alive
    }

    // Revoga UMA credencial de servico (ex.: vazou, rotacao forçada).
    // O token e identificado pelo proprio valor (o operador cola o kfs_ que
    // quer matar) OU pelo id curto do inventario (8 hex do hash, como mostra
    // o `token-list`) — desde que UNICO no servico. Id curto que casa com
    // mais de uma credencial: false (o chamador responde 409 KCF063, pedindo
    // o kfs_ completo). O que e comparado/guardado continua sendo so o hash —
    // nunca persistimos nem logamos o valor em claro. So a conta dona do
    // servico pode revogar. Inexistente (ou de outro servico/outra conta):
    // false, e o chamador responde o 404 opaco padrao.
    // Retorna "revoked" | "ambiguous" | "" (nao encontrado/sem dono).
    String revokeServiceTokenResult(String accountId, String serviceId, String token) {
        if (token.length == 0) {
            return ""
        }
        var service = this.serviceById(serviceId)
        if (service == null) {
            return ""
        }
        if (service.accountId != accountId) {
            return ""
        }
        // Valor completo primeiro (caminho exato, constant-time).
        var kept = listOf<ServiceToken>()
        var revoked = false
        for (var entry in this.serviceTokens) {
            if (entry.serviceId == serviceId && tokenMatches(entry.tokenHash, token)) {
                revoked = true
            } else {
                kept.add(entry)
            }
        }
        if (revoked) {
            this.finishRevoke(accountId, serviceId, kept)
            return "revoked"
        }
        // Senao, tenta como id curto (prefixo do hash, sem "kfs_").
        // Exige unicidade no servico: 0 = nao existe, 2+ = ambiguo.
        var matches = 0
        for (var entry in this.serviceTokens) {
            if (entry.serviceId == serviceId && entry.tokenHash.startsWith(token)) {
                matches = matches + 1
            }
        }
        if (matches == 0) {
            return ""
        }
        if (matches > 1) {
            return "ambiguous"
        }
        var keptShort = listOf<ServiceToken>()
        for (var entry in this.serviceTokens) {
            if (entry.serviceId == serviceId && entry.tokenHash.startsWith(token)) {
                continue
            }
            keptShort.add(entry)
        }
        this.finishRevoke(accountId, serviceId, keptShort)
        return "revoked"
    }

    void finishRevoke(String accountId, String serviceId, List<ServiceToken> kept) {
        this.serviceTokens = kept
        var issuer = this.accountById(accountId)
        if (issuer != null) {
            // Audita o servico, nunca o token (o valor nao e logado).
            this.audit(auditActorAccount(issuer.handle), auditServiceTokenRevoked(), accountId + "/" + serviceId)
        }
        this.save()
        noteServiceTokenRevoked()
    }

    // Rotacao assistida (Fase 19 slice 3 — "re-emite kfs_ com overlap,
    // revoga os antigos depois do TTL"): emite uma credencial nova e revoga as
    // anteriores APENAS quando ja passaram do prazo. Uma credencial sem
    // expiracao (expiresAt=0, comportamento antigo) nao e revogada em
    // silencio — fica contada como "pendente" e some com `pruneExpired`.
    RotateResult rotateServiceTokens(String accountId, String serviceId, Int ttlHours) {
        var token = this.issueServiceToken(accountId, serviceId, ttlHours)
        var now = time.now()
        var kept = listOf<ServiceToken>()
        var revoked = 0
        var pending = 0
        for (var entry in this.serviceTokens) {
            if (entry.serviceId != serviceId) {
                kept.add(entry)
                continue
            }
            if (tokenMatches(entry.tokenHash, token)) {
                kept.add(entry)
            } else if (this.serviceTokenExpired(entry, now)) {
                revoked = revoked + 1
            } else {
                kept.add(entry)
                pending = pending + 1
            }
        }
        if (revoked > 0) {
            this.finishRevoke(accountId, serviceId, kept)
        }
        return RotateResult(token, revoked, pending)
    }

    // Quantas credenciais antigas do servico ainda valem (a passos do TTL).
    Int pendingRotationCount(String serviceId) {
        var now = time.now()
        var count = 0
        for (var entry in this.serviceTokens) {
            if (entry.serviceId == serviceId && this.serviceTokenExpired(entry, now) == false) {
                count = count + 1
            }
        }
        return count
    }

    // Remove as credenciais ja expiradas do servico (housekeeping),
    // devolvendo quantas sairam. Nunca toca em credencial valida.
    Int pruneExpiredServiceTokens(String accountId, String serviceId) {
        var now = time.now()
        var kept = listOf<ServiceToken>()
        var removed = 0
        for (var entry in this.serviceTokens) {
            if (entry.serviceId == serviceId && this.serviceTokenExpired(entry, now)) {
                removed = removed + 1
            } else {
                kept.add(entry)
            }
        }
        if (removed > 0) {
            this.finishRevoke(accountId, serviceId, kept)
        }
        return removed
    }

    Bool revokeServiceToken(String accountId, String serviceId, String token) {
        return this.revokeServiceTokenResult(accountId, serviceId, token) == "revoked"
    }

    // ---- contencao (Fase 17 slice 2) ----
    //
    // Freeze e REVERSIVEL por desenho: suspende o alvo e revoga as
    // credenciais vivas, guardando o status anterior em `freezeMarks` (memoria
    // do processo: e acao de resposta a incidente, nao estado de produto).
    // Unfreeze restaura exatamente o status anterior. Configuracao (servicos,
    // dominios, allowlist) nunca e tocada.

    Map<String, String> freezeMarks

    Map<String, String> frozenMarks() {
        return this.freezeMarks
    }

    FreezeResult freezeService(String accountId, String serviceId) {
        var service = this.serviceById(serviceId)
        if (service == null) {
            return FreezeResult(false, "", 0, "")
        }
        if (service.accountId != accountId) {
            return FreezeResult(false, "", 0, "")
        }
        var prior = service.status
        var revoked = 0
        var kept = listOf<ServiceToken>()
        for (var entry in this.serviceTokens) {
            if (entry.serviceId == serviceId) {
                revoked = revoked + 1
            } else {
                kept.add(entry)
            }
        }
        if (revoked > 0) {
            this.serviceTokens = kept
        }
        this.suspendService(accountId, serviceId)
        // Marca original preservada (ver freezeDevice): um freeze repetido nao
        // pode gravar SUSPENDED como se fosse o estado de antes.
        if (this.freezeMarks.get("service/" + serviceId) == null) {
            this.freezeMarks.put("service/" + serviceId, prior)
        }
        var account = this.accountById(accountId)
        if (account != null) {
            this.audit(auditActorAccount(account.handle), auditServiceFrozen(), accountId + "/" + serviceId)
        }
        var incident = this.raiseIncident(incidentFreezeService(), accountId)
        var incidentId = ""
        if (incident != null) {
            incidentId = incident.id
        }
        this.save()
        return FreezeResult(true, incidentId, revoked, prior)
    }

    FreezeResult freezeDevice(String accountId, String deviceId) {
        var device = this.deviceById(deviceId)
        if (device == null) {
            return FreezeResult(false, "", 0, "")
        }
        if (device.accountId != accountId) {
            return FreezeResult(false, "", 0, "")
        }
        var prior = device.status
        // Revoga as credenciais de todos os servicos do dispositivo.
        var owned = this.servicesForDevice(deviceId)
        var ownedIds = listOf<String>()
        for (var service in owned) {
            ownedIds.add(service.id)
        }
        var kept = listOf<ServiceToken>()
        var revoked = 0
        for (var entry in this.serviceTokens) {
            if (ownedIds.contains(entry.serviceId)) {
                revoked = revoked + 1
            } else {
                kept.add(entry)
            }
        }
        if (revoked > 0) {
            this.serviceTokens = kept
        }
        this.suspendDevice(accountId, deviceId)
        // Marca original preservada: congelar de novo (ou congelar o device
        // depois de congelar o servico) nao pode trocar o status de antes por
        // SUSPENDED — o unfreeze deixaria de reverter.
        if (this.freezeMarks.get("device/" + deviceId) == null) {
            this.freezeMarks.put("device/" + deviceId, prior)
        }
        var account = this.accountById(accountId)
        if (account != null) {
            this.audit(auditActorAccount(account.handle), auditDeviceFrozen(), accountId + "/" + deviceId)
        }
        var incident = this.raiseIncident(incidentFreezeDevice(), accountId)
        var incidentId = ""
        if (incident != null) {
            incidentId = incident.id
        }
        this.save()
        return FreezeResult(true, incidentId, revoked, prior)
    }

    // Abrir um alvo SEM marca nao e "restaurar": nada foi congelado, entao
    // nao ha status anterior. Antes essa chamada gravava UNKNOWN (servico) e
    // ACTIVE (device) — apagando uma SUSPENSAO deliberada do operador e
    // dizendo "status anterior restaurado". Agora `restored` diz a verdade e
    // o alvo fica intocado.
    UnfreezeResult unfreezeService(String accountId, String serviceId) {
        var service = this.serviceById(serviceId)
        if (service == null) {
            return UnfreezeResult(false, false)
        }
        if (service.accountId != accountId) {
            return UnfreezeResult(false, false)
        }
        var mark = this.freezeMarks.get("service/" + serviceId)
        if (mark == null) {
            return UnfreezeResult(true, false)
        }
        this.setServiceStatus(serviceId, mark)
        this.freezeMarks.remove("service/" + serviceId)
        var account = this.accountById(accountId)
        if (account != null) {
            this.audit(auditActorAccount(account.handle), auditServiceUnfrozen(), accountId + "/" + serviceId)
        }
        this.save()
        return UnfreezeResult(true, true)
    }

    // Congelar a CONTA inteira: todo device e todo servico da conta, mais
    // todas as credenciais kfs_ dela. Mesmo desenho do alvo unico — cada alvo
    // guarda o proprio status anterior em `freezeMarks`, entao o unfreeze
    // devolve cada um exatamente como estava (um servico que ja estava
    // SUSPENDED continua SUSPENDED depois do ciclo).
    FreezeResult freezeAccount(String accountId) {
        var account = this.accountById(accountId)
        if (account == null) {
            return FreezeResult(false, "", 0, "")
        }
        var revoked = 0
        var kept = listOf<ServiceToken>()
        for (var entry in this.serviceTokens) {
            if (entry.accountId == accountId) {
                revoked = revoked + 1
            } else {
                kept.add(entry)
            }
        }
        if (revoked > 0) {
            this.serviceTokens = kept
        }
        // So grava a marca quando ainda nao ha uma: um segundo freeze do mesmo
        // alvo nao pode sobrescrever o status original com SUSPENDED, senao o
        // unfreeze nunca devolve o estado de antes (quebra a reversibilidade).
        for (var device in this.devicesForAccount(accountId)) {
            if (this.freezeMarks.get("device/" + device.id) == null) {
                this.freezeMarks.put("device/" + device.id, device.status)
            }
            this.suspendDevice(accountId, device.id)
        }
        for (var service in this.servicesForAccount(accountId)) {
            if (this.freezeMarks.get("service/" + service.id) == null) {
                this.freezeMarks.put("service/" + service.id, service.status)
            }
            this.suspendService(accountId, service.id)
        }
        this.audit(auditActorAccount(account.handle), auditAccountFrozen(), accountId)
        var incident = this.raiseIncident(incidentFreezeAccount(), accountId)
        var incidentId = ""
        if (incident != null) {
            incidentId = incident.id
        }
        this.save()
        return FreezeResult(true, incidentId, revoked, "")
    }

    // Conta: restaura o que ESTAVA congelado. `restored` e false quando nao
    // havia nenhuma marca (conta sem freeze em curso) — nada foi tocado.
    UnfreezeResult unfreezeAccount(String accountId) {
        var account = this.accountById(accountId)
        if (account == null) {
            return UnfreezeResult(false, false)
        }
        var restoredAny = false
        for (var device in this.devicesForAccount(accountId)) {
            var mark = this.freezeMarks.get("device/" + device.id)
            if (mark != null) {
                this.setDeviceStatus(accountId, device.id, mark, "")
                this.freezeMarks.remove("device/" + device.id)
                restoredAny = true
            }
        }
        for (var service in this.servicesForAccount(accountId)) {
            var mark = this.freezeMarks.get("service/" + service.id)
            if (mark != null) {
                this.setServiceStatus(service.id, mark)
                this.freezeMarks.remove("service/" + service.id)
                restoredAny = true
            }
        }
        if (restoredAny == false) {
            return UnfreezeResult(true, false)
        }
        this.audit(auditActorAccount(account.handle), auditAccountUnfrozen(), accountId)
        this.save()
        return UnfreezeResult(true, true)
    }

    UnfreezeResult unfreezeDevice(String accountId, String deviceId) {
        var device = this.deviceById(deviceId)
        if (device == null) {
            return UnfreezeResult(false, false)
        }
        if (device.accountId != accountId) {
            return UnfreezeResult(false, false)
        }
        var mark = this.freezeMarks.get("device/" + deviceId)
        if (mark == null) {
            return UnfreezeResult(true, false)
        }
        this.setDeviceStatus(accountId, deviceId, mark, "")
        this.freezeMarks.remove("device/" + deviceId)
        var account = this.accountById(accountId)
        if (account != null) {
            this.audit(auditActorAccount(account.handle), auditDeviceUnfrozen(), accountId + "/" + deviceId)
        }
        this.save()
        return UnfreezeResult(true, true)
    }

    // ---- servicos ----

    // `allowMethods`/`allowPaths`: politica WAF opcional (CSV). Ausentes =
    // sem restricao, que e o comportamento de quem nao declara allowlist.
    Service publishService(Account account, String deviceId, String name, String localAddress, Int localPort, String protocol, String exposure, String allowMethods, String allowPaths) {
        if (validServiceName(name) == false) {
            throw errInvalidServiceName()
        }
        var device = this.deviceById(deviceId)
        if (device == null) {
            throw errDeviceNotFound()
        }
        if (device.accountId != account.id) {
            throw errDeviceNotYours()
        }
        // Dispositivo revogado nunca mais abre tunel (HELLO recusado com
        // DEVICE_REVOKED, fatal) e `device revoke` ja removeu os servicos
        // dele: publicar ali criaria uma rota que nunca serve, com o CLI
        // dizendo "publicado". Medido — antes aceitava. SUSPENSO continua
        // publicavel: a suspensao e reversivel e o servico volta no
        // `unsuspend`.
        if (deviceIsActive(device) == false && deviceIsSuspended(device) == false) {
            throw errDeviceRevoked()
        }
        // Idempotencia por (conta, DEVICE, nome): republicar no mesmo device
        // ATUALIZA a configuracao mutavel; o mesmo nome noutro device e
        // conflito, nao "ja existe". Antes a busca ignorava o device: publicar
        // "site" no notebookB devolvia o "site" do notebookA (200, porta do
        // A), nada era publicado e o hostname — que e `<nome>.<handle>`,
        // igual para os dois — roteava sempre para o A. Medido.
        //
        // Antes tambem devolvia o existente SEM aplicar nada: `deploy` com
        // porta/exposure/allowlist mudada imprimia "publicado" e o servico
        // seguia com a config velha, enquanto `--plan` prometia "~ vai
        // atualizar" (medido; o proprio teste do plan registrava a mentira).
        // Agora a configuracao mutavel e reescrita; identidade (id, hostname,
        // createdAt) e estado operacional (status, suspensao) sao preservados
        // — republicar nao pode ressuscitar um servico suspenso nem zerar o
        // health que o Agent acabou de reportar.
        var existing = this.serviceByName(account.id, name)
        if (existing != null) {
            if (existing.deviceId != deviceId) {
                throw errServiceNameTaken()
            }
            var updated = Service(
                existing.id, existing.accountId, existing.deviceId, existing.name,
                localAddress, localPort, protocol, existing.hostname,
                exposureName(exposureFrom(exposure)), existing.status,
                existing.createdAt, allowMethods, allowPaths
            )
            if (serviceConfigEquals(existing, updated) == false) {
                this.replaceService(updated)
                this.audit(auditActorAccount(account.handle), auditServiceUpdated(), account.id + "/" + existing.id)
                this.save()
                noteServiceUpdated()
            }
            return updated
        }
        if (this.servicesForDevice(deviceId).size >= this.maxServices) {
            throw errLimitServices()
        }
        var service = Service(
            uuid.v4(), account.id, deviceId, name, localAddress, localPort, protocol,
            serviceHostname(name, account.handle), exposureName(exposureFrom(exposure)),
            statusUnknown(), time.now(), allowMethods, allowPaths
        )
        this.services.add(service)
        this.audit(auditActorAccount(account.handle), auditServicePublished(), account.id + "/" + service.id)
        this.save()
        noteServicePublished()
        return service
    }

    Service? serviceById(String id) {
        for (var service in this.services) {
            if (service.id == id) {
                return service
            }
        }
        return null
    }

    // Troca o servico de mesmo id pela versao nova (republicacao). Preserva a
    // posicao na lista (a ordem e a de publicacao, que o operador ve).
    void replaceService(Service updated) {
        var out = listOf<Service>()
        for (var service in this.services) {
            if (service.id == updated.id) {
                out.add(updated)
            } else {
                out.add(service)
            }
        }
        this.services = out
    }

    Service? serviceByName(String accountId, String name) {
        for (var service in this.services) {
            if (service.accountId == accountId && service.name == name) {
                return service
            }
        }
        return null
    }

    // Todos os servicos da conta com o nome dado. Estado legado (anterior ao
    // KCF139) pode ter homonimos em devices diferentes; quem age POR NOME
    // (ex.: `domain add --service`) precisa ver todos pra recusar ambiguidade
    // em vez de escolher o primeiro em silencio. A ordem e a de publicacao.
    List<Service> servicesByName(String accountId, String name) {
        var out = listOf<Service>()
        for (var service in this.services) {
            if (service.accountId == accountId && service.name == name) {
                out.add(service)
            }
        }
        return out
    }

    List<Service> servicesForAccount(String accountId) {
        var out = listOf<Service>()
        for (var service in this.services) {
            if (service.accountId == accountId) {
                out.add(service)
            }
        }
        return out
    }

    List<Service> servicesForDevice(String deviceId) {
        var out = listOf<Service>()
        for (var service in this.services) {
            if (service.deviceId == deviceId) {
                out.add(service)
            }
        }
        return out
    }

    Bool removeService(String accountId, String serviceId) {
        var out = listOf<Service>()
        var found = false
        for (var service in this.services) {
            if (service.id == serviceId && service.accountId == accountId) {
                found = true
            } else {
                out.add(service)
            }
        }
        if (found) {
            this.services = out
            this.pruneServiceTokens()
            this.pruneCustomDomains()
            var svcOwner = this.accountById(accountId)
            if (svcOwner != null) {
                this.audit(auditActorAccount(svcOwner.handle), auditServiceRemoved(), accountId + "/" + serviceId)
            }
            this.save()
            noteServiceRemoved()
        }
        return found
    }

    // Suspensao administrativa de servico: sai da rota (opaco, como PRIVATE),
    // sem remover nada. Idempotente. O dono ve SUSPENDED em `service status`.
    Bool suspendService(String accountId, String serviceId) {
        return this.setServiceStatusOwned(accountId, serviceId, statusSuspended(), auditServiceSuspended())
    }

    Bool unsuspendService(String accountId, String serviceId) {
        return this.setServiceStatusOwned(accountId, serviceId, statusUnknown(), auditServiceUnsuspended())
    }

    // Troca de status com dono + auditoria + metrica. Devolve false para
    // inexistente ou de outra conta (o handler responde o 404 opaco).
    Bool setServiceStatusOwned(String accountId, String serviceId, String status, String action) {
        var service = this.serviceById(serviceId)
        if (service == null) {
            return false
        }
        var owner = service.accountId
        if (owner != accountId) {
            return false
        }
        var account = this.accountById(accountId)
        var actor = "account:?"
        if (account != null) {
            actor = auditActorAccount(account.handle)
        }
        this.setServiceStatus(serviceId, status)
        this.audit(actor, action, accountId + "/" + serviceId)
        this.save()
        if (action == auditServiceSuspended()) {
            noteServiceSuspended()
        } else {
            noteServiceUnsuspended()
        }
        return true
    }

    void removeServicesOfDevice(String deviceId) {
        var out = listOf<Service>()
        for (var service in this.services) {
            if (service.deviceId != deviceId) {
                out.add(service)
            }
        }
        this.services = out
    }

    Bool setServiceStatus(String serviceId, String status) {
        var found = false
        var updated = listOf<Service>()
        for (var service in this.services) {
            if (service.id == serviceId) {
                updated.add(Service(
                    service.id, service.accountId, service.deviceId, service.name,
                    service.localAddress, service.localPort, service.protocol,
                    service.hostname, service.exposure, status, service.createdAt,
                    service.allowMethods, service.allowPaths
                ))
                found = true
            } else {
                updated.add(service)
            }
        }
        if (found) {
            this.services = updated
            this.save()
        }
        return found
    }

    // Health report do Agent (por device+nome; o tunel ja autenticou). NUNCA
    // dessuspende: suspensao e decisao administrativa e so `unsuspendService`
    // libera — senao o Agent reverteria a suspensao a cada ciclo de health.
    Bool setServiceStatusByName(String deviceId, String name, String status) {
        var target = ""
        for (var service in this.services) {
            if (service.deviceId == deviceId && service.name == name) {
                if (statusIsSuspended(service.status)) {
                    return true
                }
                target = service.id
            }
        }
        if (target.length == 0) {
            return false
        }
        return this.setServiceStatus(target, status)
    }

    // Status reportado pelo Agent com verificacao de dono: so a conta dona do
    // servico pode alterar o status. Devolve "" em sucesso ou o codigo do erro.
    String reportServiceStatus(String accountId, String serviceId, String status) {
        var service = this.serviceById(serviceId)
        if (service == null) {
            return errServiceNotFound()
        }
        if (service.accountId != accountId) {
            return errServiceNotYours()
        }
        // O dono reporta health, mas nao administra suspensao por aqui: so
        // `unsuspendService` libera (mesma regra do health do Agent). Status
        // fora do vocabulario e recusado na entrada (o handler devolve 400);
        // aqui a checagem repete como defesa em profundidade para chamadores
        // diretos (nao ha caminho que grave lixo).
        if (statusIsKnown(status) == false || statusIsSuspended(status)) {
            return errInvalidStatus()
        }
        if (statusIsSuspended(service.status)) {
            return ""
        }
        this.setServiceStatus(serviceId, status)
        return ""
    }

    // Rota publica: so servicos com exposicao roteavel. Dominios proprios
    // VERIFIED entram como apelidos do hostname do servico (mesma checagem de
    // exposicao/status do Edge; PENDING nunca roteia).
    Service? resolveRoute(String hostname) {
        for (var service in this.services) {
            if (service.hostname == hostname) {
                if (statusIsSuspended(service.status)) {
                    return null
                }
                if (exposureIsRoutable(exposureFrom(service.exposure))) {
                    return service
                }
            }
        }
        var custom = this.customByHostname(hostname)
        if (custom != null && domainIsVerified(custom)) {
            var service = this.serviceById(custom.serviceId)
            if (service != null && service.accountId == custom.accountId) {
                if (statusIsSuspended(service.status)) {
                    return null
                }
                if (exposureIsRoutable(exposureFrom(service.exposure))) {
                    return service
                }
            }
        }
        return null
    }

    // ---- dominios proprios (Fase 6) ----

    // Registra um hostname externo para um servico da conta. Devolve o registro
    // PENDING junto com a instrucao de DNS (CNAME para o hostname do servico).
    // Falhas viajam como codigo KCF12x. O registro e idempotente por hostname
    // dentro da conta: re-registrar o mesmo par (servico) devolve o existente.
    CustomDomain registerCustomDomain(String accountId, String hostname, String serviceId) {
        var clean = hostname.trim().toLowerCase()
        if (validCustomHostname(clean) == false) {
            throw errInvalidCustomHostname()
        }
        var service = this.serviceById(serviceId)
        if (service == null) {
            throw errServiceNotFound()
        }
        if (service.accountId != accountId) {
            throw errServiceNotYours()
        }
        var taken = this.customByHostname(clean)
        if (taken != null) {
            if (taken.accountId == accountId && taken.serviceId == serviceId) {
                return taken
            }
            throw errDomainTaken()
        }
        var domain = CustomDomain(clean, accountId, serviceId, domainPending(), "", time.now())
        this.customDomains.add(domain)
        var domOwner = this.accountById(accountId)
        if (domOwner != null) {
            this.audit(auditActorAccount(domOwner.handle), auditDomainRegistered(), accountId + "/" + clean)
        }
        this.save()
        noteDomainRegistered()
        return domain
    }

    CustomDomain? customByHostname(String hostname) {
        var clean = hostname.trim().toLowerCase()
        for (var domain in this.customDomains) {
            if (domain.hostname == clean) {
                return domain
            }
        }
        return null
    }

    List<CustomDomain> customDomainsForAccount(String accountId) {
        var out = listOf<CustomDomain>()
        for (var domain in this.customDomains) {
            if (domain.accountId == accountId) {
                out.add(domain)
            }
        }
        return out
    }

    // Remove o registro. Inexistente e alheio devolvem false (o handler
    // responde o mesmo 404 opaco nos dois casos).
    Bool removeCustomDomain(String accountId, String hostname) {
        var clean = hostname.trim().toLowerCase()
        var out = listOf<CustomDomain>()
        var found = false
        for (var domain in this.customDomains) {
            if (domain.hostname == clean && domain.accountId == accountId) {
                found = true
            } else {
                out.add(domain)
            }
        }
        if (found) {
            this.customDomains = out
            var domOwner = this.accountById(accountId)
            if (domOwner != null) {
                this.audit(auditActorAccount(domOwner.handle), auditDomainRemoved(), accountId + "/" + clean)
            }
            this.save()
            noteDomainRemoved()
        }
        return found
    }

    // Remove registros cujo servico sumiu ou saiu da conta (revogacao de
    // dispositivo remove os servicos; a poda fecha o ciclo).
    void pruneCustomDomains() {
        var alive = listOf<CustomDomain>()
        for (var domain in this.customDomains) {
            var service = this.serviceById(domain.serviceId)
            if (service == null) {
                // orfao: servico sumiu, poda
            } else if (service.accountId == domain.accountId) {
                alive.add(domain)
            }
        }
        this.customDomains = alive
    }

    // Verifica a delegacao DNS: resolve o hostname e confere se ALGUM endereco
    // responde coincide (exato, sem sufixo) com um destino esperado do Edge.
    // `addresses` e injetavel para testes sem rede.
    String verifyCustomDomainWith(String accountId, String hostname, List<String> addresses) {
        var domain = this.customByHostname(hostname)
        if (domain == null) {
            return errDomainNotFound()
        }
        var owner = domain.accountId
        var target = domain.serviceId
        var label = domain.hostname
        if (owner != accountId) {
            return errDomainNotFound()
        }
        if (this.serviceById(target) == null) {
            return errDomainNotFound()
        }
        for (var address in addresses) {
            if (isExpectedEdgeHost(address)) {
                this.markDomainVerified(label)
                return ""
            }
        }
        return errDomainUnreachable()
    }

    // Verifica contra o DNS real. A ordem importa: primeiro dono/existencia
    // (KCF122 opaco, sem tocar na rede), depois o DNS. Falha de resolucao
    // (NXDOMAIN, timeout, rede) vira KCF124 indistinguivel de "resolveu para
    // outro lugar": nos dois casos o hostname ainda nao aponta para este Edge.
    String verifyCustomDomain(String accountId, String hostname) {
        var domain = this.customByHostname(hostname)
        if (domain == null) {
            return errDomainNotFound()
        }
        var owner = domain.accountId
        var label = domain.hostname
        if (owner != accountId) {
            return errDomainNotFound()
        }
        var resolved = listOf<String>()
        try {
            resolved = net.resolve(label)
        } catch (String e) {
            return errDomainUnreachable()
        }
        return this.verifyCustomDomainWith(accountId, hostname, resolved)
    }

    Bool isExpectedEdgeHost(String address) {
        for (var expected in this.edgeHosts) {
            if (expected == address) {
                return true
            }
            if (expected.startsWith("*.") && address.endsWith(expected.substring(1))) {
                return true
            }
        }
        return false
    }

    void markDomainVerified(String hostname) {
        var clean = hostname.trim().toLowerCase()
        var updated = listOf<CustomDomain>()
        for (var domain in this.customDomains) {
            if (domain.hostname == clean) {
                updated.add(CustomDomain(domain.hostname, domain.accountId, domain.serviceId, domainVerified(), longToString(time.now()), domain.createdAt))
            } else {
                updated.add(domain)
            }
        }
        this.customDomains = updated
        var verified = this.customByHostname(clean)
        if (verified != null) {
            var verOwner = this.accountById(verified.accountId)
            if (verOwner != null) {
                this.audit(auditActorAccount(verOwner.handle), auditDomainVerified(), verified.accountId + "/" + clean)
            }
        }
        this.save()
        noteDomainVerified()
    }
}

// Destinos esperados do Edge vindos de config: "ip1,ip2,host" (virgula,
// espaco ou ponto-e-virgula separam). Vazio = nenhum (verificacao sempre
// recusa ate o operador configurar).
List<String> parseEdgeHosts(String raw) {
    var out = listOf<String>()
    var current = ""
    for (var i = 0; i < raw.length; i++) {
        var c = raw.charAt(i)
        if (c == "," || c == ";" || c == " ") {
            if (current.length > 0) {
                out.add(current.toLowerCase())
                current = ""
            }
        } else {
            current = current + (c as Char)
        }
    }
    if (current.length > 0) {
        out.add(current.toLowerCase())
    }
    return out
}

// Instante de expiracao de uma credencial (`kfc_` e `kfs_`) a partir de um TTL
// em horas; 0 = sem expiracao (comportamento historico). Fonte unica dos dois
// caminhos: eles tinham o corpo identico e o mesmo defeito — `ttlHours *
// 3600000` era aritmetica de Int (32 bits), que estoura acima de 596 horas
// (24,8 dias): `--ttl 720` (30 dias) virava `nowMs - 1702967296`, um instante
// no PASSADO, e a credencial nascia vencida (401 imediato, some do inventario).
// Medido com o CLI 0.6.3. Multiplicacao em Long de proposito.
Long tokenExpiryAt(Long nowMs, Int ttlHours) {
    if (ttlHours <= 0) {
        return 0
    }
    return nowMs + (ttlHours as Long) * 3600000L
}

// Epoch em MILISSEGUNDOS nao cabe em Int; parseLongSafe le Long (o projeto
// so tem parseIntSafe, que truncaria e faria todo evento parecer antigo).
Long parseLongSafe(String text, Long fallback) {
    if (text.length == 0) {
        return fallback
    }
    var i = 0
    var acc = 0L
    while (i < text.length) {
        var c = text.charAt(i) as Int
        if (c < 48 || c > 57) {
            return fallback
        }
        acc = acc * 10L + (c - 48)
        i = i + 1
    }
    return acc
}

// POST assinado (I/O na borda do Registry; o desenho aceita porque o Registry
// ja faz I/O de arquivo). Headers documentados no help/webhook: o receptor
// verifica `X-KofCloud-Signature: sha256=<hex>` e `X-KofCloud-Event`.
Int postWebhook(String url, String payload, String signature) {
    try {
        var headers = "Content-Type: application/json\nX-KofCloud-Event: incident.opened\nX-KofCloud-Signature: " + signature
        var response = http.post(url, payload, headers)
        return 200
    } catch (String e) {
        log.warn("webhook delivery failed: " + e)
        return 0
    }
}


