package kofcloud.control

import kofcloud.control.Metrics
import kofcloud.model.Account
import kofcloud.model.CustomDomain
import kofcloud.model.Device
import kofcloud.model.Errors
import kofcloud.model.Service
import kofcloud.model.Exposure

import kofcloud.identity.Tokens
import kofcloud.util.Hosts
import kofcloud.util.Limits
import kofcloud.util.Text
import kofcloud.store.Store

// Estado do control plane. Persistido como JSON unico; sem banco no MVP.
// Tokens sao guardados como hash (nunca em claro).
record TokenEntry(String accountId, String tokenHash, Long createdAt)

record ServiceToken(String serviceId, String accountId, String tokenHash, Long createdAt)

record ControlState(List<Account> accounts, List<Device> devices, List<Service> services, List<TokenEntry> tokens, List<ServiceToken> serviceTokens, List<CustomDomain> customDomains)

class Registry {
    List<Account> accounts
    List<Device> devices
    List<Service> services
    List<TokenEntry> tokens
    List<ServiceToken> serviceTokens
    List<CustomDomain> customDomains
    String path
    Int maxDevices
    Int maxServices
    // Destinos que a verificacao de dominio proprio aceita: IPs e/ou hostnames
    // do Edge (config `kofcloud.edgeHosts`, separados por virgula). Comparacao
    // exata, sem sufixo: subdominios de um host esperado NAO valem.
    List<String> edgeHosts

    constructor(path: String) {
        this.path = path
        this.accounts = listOf<Account>()
        this.devices = listOf<Device>()
        this.services = listOf<Service>()
        this.tokens = listOf<TokenEntry>()
        this.serviceTokens = listOf<ServiceToken>()
        this.customDomains = listOf<CustomDomain>()
        this.maxDevices = limitDevices()
        this.maxServices = limitServices()
        this.edgeHosts = parseEdgeHosts(config.str("kofcloud.edgeHosts", ""))
        this.load()
    }

    // Permite aos testes fixarem os destinos esperados sem config de processo.
    void setEdgeHosts(List<String> hosts) {
        this.edgeHosts = hosts
    }

    // Permite aos testes exercitarem o limite sem depender de env/config do
    // processo (config e lido uma vez, no start).
    void setLimits(Int devices, Int services) {
        this.maxDevices = devices
        this.maxServices = services
    }

    Int activeDeviceCount(String accountId) {
        var count = 0
        for (var device in this.devices) {
            if (device.accountId == accountId && device.status == "ACTIVE") {
                count = count + 1
            }
        }
        return count
    }

    void load() {
        var raw = readTextOr(this.path, "")
        if (raw.length == 0) {
            return
        }
        try {
            var state = json.decode<ControlState>(raw)
            this.accounts = state.accounts
            this.devices = state.devices
            this.services = state.services
            this.tokens = state.tokens
            this.serviceTokens = state.serviceTokens
            this.customDomains = state.customDomains
        } catch (String e) {
            // Estado corrompido: recomeca vazio em vez de derrubar o control
            // plane. O operador ve os dados ausentes e decide.
        }
    }

    void save() {
        writeTextTo(this.path, json.encode(ControlState(this.accounts, this.devices, this.services, this.tokens, this.serviceTokens, this.customDomains)))
    }

    // ---- contas ----

    Account createAccount(String handle, String email, String password) {
        if (validHandle(handle) == false) {
            throw errInvalidHandle()
        }
        if (this.accountByHandle(handle) != null) {
            throw errHandleTaken()
        }
        var account = Account(uuid.v4(), handle, email, passwords.hash(password), time.now())
        this.accounts.add(account)
        this.save()
        noteAccountCreated()
        return account
    }

    Account? accountByHandle(String handle) {
        for (var account in this.accounts) {
            if (account.handle == handle) {
                return account
            }
        }
        return null
    }

    Account? accountById(String id) {
        for (var account in this.accounts) {
            if (account.id == id) {
                return account
            }
        }
        return null
    }

    Account? accountByToken(String token) {
        if (token.length == 0) {
            return null
        }
        for (var entry in this.tokens) {
            if (tokenMatches(entry.tokenHash, token)) {
                return this.accountById(entry.accountId)
            }
        }
        return null
    }

    String issueToken(String accountId) {
        var token = newAccountToken()
        this.tokens.add(TokenEntry(accountId, tokenHash(token), time.now()))
        this.save()
        return token
    }

    String login(String handle, String password) {
        var account = this.accountByHandle(handle)
        if (account == null) {
            throw errInvalidCredentials()
        }
        if (passwords.verify(password, account.passwordHash) == false) {
            throw errInvalidCredentials()
        }
        return this.issueToken(account.id)
    }

    // ---- dispositivos ----

    Device registerDevice(Account account, String name, String publicKey) {
        var existing = this.deviceByName(account.id, name)
        if (existing != null) {
            return existing
        }
        if (this.activeDeviceCount(account.id) >= this.maxDevices) {
            throw errLimitDevices()
        }
        var device = Device(uuid.v4(), account.id, name, publicKey, deviceActive(), time.now(), time.now())
        this.devices.add(device)
        this.save()
        noteDeviceRegistered()
        return device
    }

    Device? deviceById(String id) {
        for (var device in this.devices) {
            if (device.id == id) {
                return device
            }
        }
        return null
    }

    Device? deviceByName(String accountId, String name) {
        for (var device in this.devices) {
            if (device.accountId == accountId && device.name == name) {
                return device
            }
        }
        return null
    }

    List<Device> devicesForAccount(String accountId) {
        var out = listOf<Device>()
        for (var device in this.devices) {
            if (device.accountId == accountId) {
                out.add(device)
            }
        }
        return out
    }

    Bool revokeDevice(String accountId, String deviceId) {
        var found = false
        var updated = listOf<Device>()
        for (var device in this.devices) {
            if (device.id == deviceId && device.accountId == accountId) {
                updated.add(Device(device.id, device.accountId, device.name, device.publicKey, deviceRevoked(), device.lastSeenAt, device.createdAt))
                found = true
            } else {
                updated.add(device)
            }
        }
        if (found) {
            this.devices = updated
            this.removeServicesOfDevice(deviceId)
            this.pruneServiceTokens()
            this.pruneCustomDomains()
            this.save()
            noteDeviceRevoked()
        }
        return found
    }

    void touchDevice(String deviceId) {
        var updated = listOf<Device>()
        for (var device in this.devices) {
            if (device.id == deviceId) {
                updated.add(Device(device.id, device.accountId, device.name, device.publicKey, device.status, time.now(), device.createdAt))
            } else {
                updated.add(device)
            }
        }
        this.devices = updated
        this.save()
    }

    // ---- tokens de servico (AUTHENTICATED) ----

    // Emite uma credencial nova para o servico. Varias podem existir (rotacao
    // sem downtime); cada uma e guardada apenas como hash.
    String issueServiceToken(String accountId, String serviceId) {
        var service = this.serviceById(serviceId)
        if (service == null) {
            throw errServiceNotFound()
        }
        if (service.accountId != accountId) {
            throw errServiceTokenForbidden()
        }
        var token = newServiceToken()
        this.serviceTokens.add(ServiceToken(serviceId, accountId, tokenHash(token), time.now()))
        this.save()
        noteServiceTokenIssued()
        return token
    }

    // Resolve o servico dono de um token de servico; null se invalido.
    Service? serviceByServiceToken(String token) {
        if (token.length == 0) {
            return null
        }
        for (var entry in this.serviceTokens) {
            if (tokenMatches(entry.tokenHash, token)) {
                return this.serviceById(entry.serviceId)
            }
        }
        return null
    }

    // Remove credenciais orfas (servico removido ou dispositivo revogado).
    void pruneServiceTokens() {
        var alive = listOf<ServiceToken>()
        for (var entry in this.serviceTokens) {
            if (this.serviceById(entry.serviceId) != null) {
                alive.add(entry)
            }
        }
        this.serviceTokens = alive
    }

    // ---- servicos ----

    Service publishService(Account account, String deviceId, String name, String localAddress, Int localPort, String protocol, String exposure) {
        if (validServiceName(name) == false) {
            throw errInvalidServiceName()
        }
        var device = this.deviceById(deviceId)
        if (device == null) {
            throw errDeviceNotFound()
        }
        if (device.accountId != account.id) {
            throw errDeviceNotYours()
        }
        var existing = this.serviceByName(account.id, name)
        if (existing != null) {
            return existing
        }
        if (this.servicesForDevice(deviceId).size >= this.maxServices) {
            throw errLimitServices()
        }
        var service = Service(
            uuid.v4(), account.id, deviceId, name, localAddress, localPort, protocol,
            serviceHostname(name, account.handle), exposureName(exposureFrom(exposure)),
            statusUnknown(), time.now()
        )
        this.services.add(service)
        this.save()
        noteServicePublished()
        return service
    }

    Service? serviceById(String id) {
        for (var service in this.services) {
            if (service.id == id) {
                return service
            }
        }
        return null
    }

    Service? serviceByName(String accountId, String name) {
        for (var service in this.services) {
            if (service.accountId == accountId && service.name == name) {
                return service
            }
        }
        return null
    }

    List<Service> servicesForAccount(String accountId) {
        var out = listOf<Service>()
        for (var service in this.services) {
            if (service.accountId == accountId) {
                out.add(service)
            }
        }
        return out
    }

    List<Service> servicesForDevice(String deviceId) {
        var out = listOf<Service>()
        for (var service in this.services) {
            if (service.deviceId == deviceId) {
                out.add(service)
            }
        }
        return out
    }

    Bool removeService(String accountId, String serviceId) {
        var out = listOf<Service>()
        var found = false
        for (var service in this.services) {
            if (service.id == serviceId && service.accountId == accountId) {
                found = true
            } else {
                out.add(service)
            }
        }
        if (found) {
            this.services = out
            this.pruneServiceTokens()
            this.pruneCustomDomains()
            this.save()
            noteServiceRemoved()
        }
        return found
    }

    void removeServicesOfDevice(String deviceId) {
        var out = listOf<Service>()
        for (var service in this.services) {
            if (service.deviceId != deviceId) {
                out.add(service)
            }
        }
        this.services = out
    }

    Bool setServiceStatus(String serviceId, String status) {
        var found = false
        var updated = listOf<Service>()
        for (var service in this.services) {
            if (service.id == serviceId) {
                updated.add(Service(
                    service.id, service.accountId, service.deviceId, service.name,
                    service.localAddress, service.localPort, service.protocol,
                    service.hostname, service.exposure, status, service.createdAt
                ))
                found = true
            } else {
                updated.add(service)
            }
        }
        if (found) {
            this.services = updated
            this.save()
        }
        return found
    }

    Bool setServiceStatusByName(String deviceId, String name, String status) {
        var target = ""
        for (var service in this.services) {
            if (service.deviceId == deviceId && service.name == name) {
                target = service.id
            }
        }
        if (target.length == 0) {
            return false
        }
        return this.setServiceStatus(target, status)
    }

    // Status reportado pelo Agent com verificacao de dono: so a conta dona do
    // servico pode alterar o status. Devolve "" em sucesso ou o codigo do erro.
    String reportServiceStatus(String accountId, String serviceId, String status) {
        var service = this.serviceById(serviceId)
        if (service == null) {
            return errServiceNotFound()
        }
        if (service.accountId != accountId) {
            return errServiceNotYours()
        }
        this.setServiceStatus(serviceId, status)
        return ""
    }

    // Rota publica: so servicos com exposicao roteavel. Dominios proprios
    // VERIFIED entram como apelidos do hostname do servico (mesma checagem de
    // exposicao/status do Edge; PENDING nunca roteia).
    Service? resolveRoute(String hostname) {
        for (var service in this.services) {
            if (service.hostname == hostname) {
                if (exposureIsRoutable(exposureFrom(service.exposure))) {
                    return service
                }
            }
        }
        var custom = this.customByHostname(hostname)
        if (custom != null && custom.status == domainVerified()) {
            var service = this.serviceById(custom.serviceId)
            if (service != null && service.accountId == custom.accountId) {
                if (exposureIsRoutable(exposureFrom(service.exposure))) {
                    return service
                }
            }
        }
        return null
    }

    // ---- dominios proprios (Fase 6) ----

    // Registra um hostname externo para um servico da conta. Devolve o registro
    // PENDING junto com a instrucao de DNS (CNAME para o hostname do servico).
    // Falhas viajam como codigo KCF12x. O registro e idempotente por hostname
    // dentro da conta: re-registrar o mesmo par (servico) devolve o existente.
    CustomDomain registerCustomDomain(String accountId, String hostname, String serviceId) {
        var clean = hostname.trim().toLowerCase()
        if (validCustomHostname(clean) == false) {
            throw errInvalidCustomHostname()
        }
        var service = this.serviceById(serviceId)
        if (service == null) {
            throw errServiceNotFound()
        }
        if (service.accountId != accountId) {
            throw errServiceNotYours()
        }
        var taken = this.customByHostname(clean)
        if (taken != null) {
            if (taken.accountId == accountId && taken.serviceId == serviceId) {
                return taken
            }
            throw errDomainTaken()
        }
        var domain = CustomDomain(clean, accountId, serviceId, domainPending(), "", time.now())
        this.customDomains.add(domain)
        this.save()
        noteDomainRegistered()
        return domain
    }

    CustomDomain? customByHostname(String hostname) {
        var clean = hostname.trim().toLowerCase()
        for (var domain in this.customDomains) {
            if (domain.hostname == clean) {
                return domain
            }
        }
        return null
    }

    List<CustomDomain> customDomainsForAccount(String accountId) {
        var out = listOf<CustomDomain>()
        for (var domain in this.customDomains) {
            if (domain.accountId == accountId) {
                out.add(domain)
            }
        }
        return out
    }

    // Remove o registro. Inexistente e alheio devolvem false (o handler
    // responde o mesmo 404 opaco nos dois casos).
    Bool removeCustomDomain(String accountId, String hostname) {
        var clean = hostname.trim().toLowerCase()
        var out = listOf<CustomDomain>()
        var found = false
        for (var domain in this.customDomains) {
            if (domain.hostname == clean && domain.accountId == accountId) {
                found = true
            } else {
                out.add(domain)
            }
        }
        if (found) {
            this.customDomains = out
            this.save()
            noteDomainRemoved()
        }
        return found
    }

    // Remove registros cujo servico sumiu ou saiu da conta (revogacao de
    // dispositivo remove os servicos; a poda fecha o ciclo).
    void pruneCustomDomains() {
        var alive = listOf<CustomDomain>()
        for (var domain in this.customDomains) {
            var service = this.serviceById(domain.serviceId)
            if (service == null) {
                // orfao: servico sumiu, poda
            } else if (service.accountId == domain.accountId) {
                alive.add(domain)
            }
        }
        this.customDomains = alive
    }

    // Verifica a delegacao DNS: resolve o hostname e confere se ALGUM endereco
    // responde coincide (exato, sem sufixo) com um destino esperado do Edge.
    // `addresses` e injetavel para testes sem rede.
    String verifyCustomDomainWith(String accountId, String hostname, List<String> addresses) {
        var domain = this.customByHostname(hostname)
        if (domain == null) {
            return errDomainNotFound()
        }
        var owner = domain.accountId
        var target = domain.serviceId
        var label = domain.hostname
        if (owner != accountId) {
            return errDomainNotFound()
        }
        if (this.serviceById(target) == null) {
            return errDomainNotFound()
        }
        for (var address in addresses) {
            if (isExpectedEdgeHost(address)) {
                this.markDomainVerified(label)
                return ""
            }
        }
        return errDomainUnreachable()
    }

    // Verifica contra o DNS real. A ordem importa: primeiro dono/existencia
    // (KCF122 opaco, sem tocar na rede), depois o DNS. Falha de resolucao
    // (NXDOMAIN, timeout, rede) vira KCF124 indistinguivel de "resolveu para
    // outro lugar": nos dois casos o hostname ainda nao aponta para este Edge.
    String verifyCustomDomain(String accountId, String hostname) {
        var domain = this.customByHostname(hostname)
        if (domain == null) {
            return errDomainNotFound()
        }
        var owner = domain.accountId
        var label = domain.hostname
        if (owner != accountId) {
            return errDomainNotFound()
        }
        var resolved = listOf<String>()
        try {
            resolved = net.resolve(label)
        } catch (String e) {
            return errDomainUnreachable()
        }
        return this.verifyCustomDomainWith(accountId, hostname, resolved)
    }

    Bool isExpectedEdgeHost(String address) {
        for (var expected in this.edgeHosts) {
            if (expected == address) {
                return true
            }
            if (expected.startsWith("*.") && address.endsWith(expected.substring(1))) {
                return true
            }
        }
        return false
    }

    void markDomainVerified(String hostname) {
        var clean = hostname.trim().toLowerCase()
        var updated = listOf<CustomDomain>()
        for (var domain in this.customDomains) {
            if (domain.hostname == clean) {
                updated.add(CustomDomain(domain.hostname, domain.accountId, domain.serviceId, domainVerified(), longToString(time.now()), domain.createdAt))
            } else {
                updated.add(domain)
            }
        }
        this.customDomains = updated
        this.save()
        noteDomainVerified()
    }
}

// Destinos esperados do Edge vindos de config: "ip1,ip2,host" (virgula,
// espaco ou ponto-e-virgula separam). Vazio = nenhum (verificacao sempre
// recusa ate o operador configurar).
List<String> parseEdgeHosts(String raw) {
    var out = listOf<String>()
    var current = ""
    for (var i = 0; i < raw.length; i++) {
        var c = raw.charAt(i)
        if (c == "," || c == ";" || c == " ") {
            if (current.length > 0) {
                out.add(current.toLowerCase())
                current = ""
            }
        } else {
            current = current + (c as Char)
        }
    }
    if (current.length > 0) {
        out.add(current.toLowerCase())
    }
    return out
}
