package kofcloud.control

import kofcloud.control.Metrics
import kofcloud.control.Panel
import kofcloud.control.Registry
import kofcloud.control.StatusPage
import kofcloud.model.Account
import kofcloud.model.Audit
import kofcloud.model.CustomDomain
import kofcloud.model.Device
import kofcloud.model.Errors
import kofcloud.model.Exposure
import kofcloud.model.Service
import kofcloud.util.Text
import kofcloud.util.Hosts
import kofcloud.util.Limits
import kofcloud.protocol.Version

// Control Plane: HTTP/JSON sobre web.app(). O handler-scoped `status()` so
// existe dentro do lambda de rota, entao os handlers devolvem HttpResult e o
// lambda aplica o codigo.

record HttpResult(Int code, String body)

String errorJson(String message) {
    var out = mapOf()
    out.put("error", message)
    return json.encode(out)
}

Map<String, String> decodeBody(String bodyText) {
    if (bodyText.length == 0) {
        return mapOf()
    }
    return json.decode<Map<String, String>>(bodyText)
}

// O Kof nao tem overload com default: os handlers chamam bearerToken com o
// header (nullable) e ele delega no bearerValue (fonte unica do parsing,
// em util.Text) — o null vira "" aqui, antes do parsing.
String bearerToken(String? authHeader) {
    if (authHeader == null) {
        return ""
    }
    return bearerValue(authHeader)
}

// As chaves precisam casar com os campos dos records `Device`/`Service`:
// json.decode exige TODO campo presente (JSN004) e o Agent/CLI decodificam
// essas respostas de volta para os tipos. Chaves extras sao ignoradas, entao
// `deviceId` viaja junto de `id` para conveniencia dos handlers.
String deviceJson(Device device) {
    var out = mapOf()
    out.put("id", device.id)
    out.put("deviceId", device.id)
    out.put("accountId", device.accountId)
    out.put("name", device.name)
    out.put("status", device.status)
    out.put("publicKey", device.publicKey)
    out.put("lastSeenAt", longToString(device.lastSeenAt))
    out.put("createdAt", longToString(device.createdAt))
    return json.encode(out)
}

String serviceJson(Service service) {
    var out = mapOf()
    out.put("id", service.id)
    out.put("accountId", service.accountId)
    out.put("deviceId", service.deviceId)
    out.put("name", service.name)
    out.put("localAddress", service.localAddress)
    out.put("localPort", intToString(service.localPort))
    out.put("protocol", service.protocol)
    out.put("hostname", service.hostname)
    out.put("exposure", service.exposure)
    out.put("status", service.status)
    out.put("createdAt", longToString(service.createdAt))
    out.put("allowMethods", service.allowMethods)
    out.put("allowPaths", service.allowPaths)
    return json.encode(out)
}

String serviceListJson(List<Service> services) {
    var parts = listOf<String>()
    for (var service in services) {
        parts.add(serviceJson(service))
    }
    return "[" + joinStrings(parts, ",") + "]"
}

String deviceListJson(List<Device> devices) {
    var parts = listOf<String>()
    for (var device in devices) {
        parts.add(deviceJson(device))
    }
    return "[" + joinStrings(parts, ",") + "]"
}

String domainJson(CustomDomain domain, String target) {
    var out = mapOf()
    out.put("hostname", domain.hostname)
    out.put("accountId", domain.accountId)
    out.put("serviceId", domain.serviceId)
    out.put("status", domain.status)
    out.put("verifiedAt", domain.verifiedAt)
    out.put("target", target)
    return json.encode(out)
}

String customTargetFor(CustomDomain domain, Registry registry) {
    var service = registry.serviceById(domain.serviceId)
    if (service == null) {
        return ""
    }
    return service.hostname
}

String domainListJson(List<CustomDomain> domains, Registry registry) {
    var parts = listOf<String>()
    for (var domain in domains) {
        parts.add(domainJson(domain, customTargetFor(domain, registry)))
    }
    return "[" + joinStrings(parts, ",") + "]"
}

// Uma entrada do inventario de credenciais: digito curto do hash (para o
// operador distinguir "qual revogar") + emissao. NUNCA o valor kfs_: ele so
// existe no instante da emissao e nao e recuperavel depois.
String serviceTokenJson(ServiceToken entry) {
    var out = mapOf()
    out.put("serviceId", entry.serviceId)
    out.put("id", shortTokenId(entry.tokenHash))
    out.put("createdAt", longToString(entry.createdAt))
    if (entry.expiresAt > 0) {
        out.put("expiresAt", longToString(entry.expiresAt))
    }
    return json.encode(out)
}

// Digito curto e nao sensivel: 8 primeiros hex do hash (o hash nao e
// reversivel ao kfs_). Suficiente para distinguir credenciais no `list`
// sem vazar nada que autorize acesso.
String shortTokenId(String tokenHash) {
    if (tokenHash.length <= 8) {
        return tokenHash
    }
    return tokenHash.substring(0, 8)
}

String serviceTokenListJson(List<ServiceToken> entries) {
    var parts = listOf<String>()
    for (var entry in entries) {
        parts.add(serviceTokenJson(entry))
    }
    return "[" + joinStrings(parts, ",") + "]"
}

// Instrucao de DNS devolvida no registro: CNAME do hostname externo para o
// hostname do servico na conta (o caminho feliz do wildcard continua
// automatico; isto e so para dominio proprio).
String domainInstruction(CustomDomain domain, Registry registry) {
    return "CNAME " + domain.hostname + " -> " + customTargetFor(domain, registry)
}

String joinStrings(List<String> parts, String separator) {
    var out = ""
    var first = true
    for (var part in parts) {
        if (first) {
            out = part
            first = false
        } else {
            out = out + separator + part
        }
    }
    return out
}

// ---- handlers ----

HttpResult handleHealth() {
    var out = mapOf()
    out.put("ok", "true")
    out.put("service", "kofcloud-control")
    out.put("version", intToString(protocolVersion()))
    return HttpResult(200, json.encode(out))
}

HttpResult handleCreateAccount(Registry registry, String bodyText) {
    var body = decodeBody(bodyText)
    var handle = mapField(body, "handle")
    var email = mapField(body, "email")
    var password = mapField(body, "password")
    if (validHandle(handle) == false) {
        return HttpResult(400, errorJson(errInvalidHandle()))
    }
    if (password.length < 4) {
        return HttpResult(400, errorJson(errPasswordTooShort()))
    }
    if (registry.accountByHandle(handle) != null) {
        return HttpResult(409, errorJson(errHandleTaken()))
    }
    var account = registry.createAccount(handle, email, password)
    var token = registry.issueToken(account.id)
    var out = mapOf()
    out.put("accountId", account.id)
    out.put("handle", account.handle)
    out.put("token", token)
    return HttpResult(200, json.encode(out))
}

HttpResult handleLogin(Registry registry, String bodyText) {
    var body = decodeBody(bodyText)
    var handle = mapField(body, "handle")
    var password = mapField(body, "password")
    var account = registry.accountByHandle(handle)
    if (account == null) {
        return HttpResult(401, errorJson(errInvalidCredentials()))
    }
    if (passwords.verify(password, account.passwordHash) == false) {
        return HttpResult(401, errorJson(errInvalidCredentials()))
    }
    var token = registry.issueToken(account.id)
    noteLogin()
    registry.audit(auditActorAccount(account.handle), auditLogin(), account.id)
    registry.save()
    var out = mapOf()
    out.put("accountId", account.id)
    out.put("handle", account.handle)
    out.put("token", token)
    return HttpResult(200, json.encode(out))
}

// Export Prometheus dos contadores do control plane + Edge (mesmo processo
// no `serve`; mesmo export quando separados). Sem autenticacao, igual ao
// `/v1/health`: so agregados monotonicos, nenhum dado de conta/servico.
HttpResult handleMetrics() {
    return HttpResult(200, observability.metrics())
}

HttpResult handleRegisterDevice(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var name = mapField(body, "name")
    var publicKey = mapField(body, "publicKey")
    if (name.length == 0 || publicKey.length == 0) {
        return HttpResult(400, errorJson(errDeviceFields()))
    }
    try {
        var device = registry.registerDevice(account, name, publicKey)
        return HttpResult(200, deviceJson(device))
    } catch (String e) {
        return HttpResult(429, errorJson(e))
    }
}

HttpResult handleListDevices(Registry registry, String? authHeader) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    return HttpResult(200, deviceListJson(registry.devicesForAccount(account.id)))
}

// Presenca real: quais devices DESTA CONTA tem tunel vivo no Edge deste
// processo. Autenticado e filtrado por conta (igual a /v1/devices): nada de
// terceiros vaza, nem existencia. Quando control e Edge rodam separados, o
// control responde lista vazia (sem dado errado — ausencia, nao mentira).
HttpResult handlePresence(Registry registry, String? authHeader) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var parts = listOf<String>()
    for (var deviceId in registry.onlineDeviceIdsFor(account.id)) {
        // Array de strings: evita decode aninhado no cliente (JSN004 nao
        // suporta List<Map<...>>). So ids — sem status, sem horario, sem nada
        // que permita inferir atividade de terceiros.
        parts.add(json.encode(deviceId))
    }
    return HttpResult(200, "[" + joinStrings(parts, ",") + "]")
}

HttpResult handleRevokeDevice(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var deviceId = mapField(body, "deviceId")
    if (registry.revokeDevice(account.id, deviceId) == false) {
        return HttpResult(404, errorJson(errDeviceNotFound()))
    }
    var out = mapOf()
    out.put("revoked", "true")
    return HttpResult(200, json.encode(out))
}

// Suspensao operacional (abuse prevention): reversivel, sem remover nada.
// Idempotente; inexistente/alheio = mesmo 404 opaco da revogacao.
HttpResult handleSuspendDevice(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var deviceId = mapField(body, "deviceId")
    if (registry.suspendDevice(account.id, deviceId) == false) {
        return HttpResult(404, errorJson(errDeviceNotFound()))
    }
    var out = mapOf()
    out.put("suspended", "true")
    return HttpResult(200, json.encode(out))
}

HttpResult handleUnsuspendDevice(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var deviceId = mapField(body, "deviceId")
    if (registry.unsuspendDevice(account.id, deviceId) == false) {
        return HttpResult(404, errorJson(errDeviceNotFound()))
    }
    var out = mapOf()
    out.put("suspended", "false")
    return HttpResult(200, json.encode(out))
}

HttpResult handlePublishService(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var name = mapField(body, "name")
    var deviceId = mapField(body, "deviceId")
    var localAddress = mapField(body, "localAddress")
    if (localAddress.length == 0) {
        localAddress = defaultLocalAddress()
    }
    if (validLocalAddress(localAddress) == false) {
        return HttpResult(400, errorJson(errInvalidAddress()))
    }
    var localPort = parsePortSafe(mapField(body, "localPort"), 0)
    var protocol = mapField(body, "protocol")
    if (protocol.length == 0) {
        protocol = defaultProtocol()
    }
    if (protocolIsSupported(protocol) == false) {
        return HttpResult(400, errorJson(errInvalidProtocol()))
    }
    var exposure = mapField(body, "exposure")
    if (exposure.length == 0) {
        exposure = defaultExposure()
    }
    if (exposureIsKnown(exposure) == false) {
        return HttpResult(400, errorJson(errInvalidExposure()))
    }
    if (localPort <= 0 || localPort > 65535) {
        return HttpResult(400, errorJson(errLocalPort()))
    }
    // Allowlist WAF opcional (CSV). Item invalido nao publica uma politica que
    // nunca casaria (metodo e comparado exato) — devolve 400.
    var allowMethods = normalizeAllowMethods(mapField(body, "allowMethods"), httpVerbs())
    if (allowMethods.length == 0 && mapField(body, "allowMethods").trim().length > 0) {
        return HttpResult(400, errorJson(errInvalidAllowMethod()))
    }
    var allowPaths = normalizeAllowPaths(mapField(body, "allowPaths"))
    if (allowPaths.length == 0 && mapField(body, "allowPaths").trim().length > 0) {
        return HttpResult(400, errorJson(errInvalidAllowPath()))
    }
    var device = registry.deviceById(deviceId)
    if (device == null) {
        return HttpResult(404, errorJson(errDeviceNotFound()))
    }
    if (device.accountId != account.id) {
        return HttpResult(404, errorJson(errDeviceNotFound()))
    }
    try {
        var service = registry.publishService(account, deviceId, name, localAddress, localPort, protocol, exposure, allowMethods, allowPaths)
        return HttpResult(200, serviceJson(service))
    } catch (String e) {
        return publishError(e)
    }
}

// HTTP do erro do publish por familia: limite -> 429, validacao -> 400,
// resto (dono/recurso) -> 404 opaco (nao revela recurso alheio). Pura para
// a trava testar sem rede; o publishError delega (fonte unica do mapeamento).
Int publishHttpStatus(String e) {
    if (e.indexOf("KCF080") >= 0 || e.indexOf("KCF081") >= 0) {
        return 429
    }
    if (e.indexOf("KCF040") >= 0 || e.indexOf("KCF043") >= 0) {
        return 400
    }
    return 404
}

// Erros do publish com o HTTP certo por familia (ver publishHttpStatus).
// No 404 o corpo e reescrito para KCF021 opaco: o registry lanca KCF022
// (device alheio) como defesa em profundidade, e a borda nunca revela dono.
HttpResult publishError(String e) {
    var status = publishHttpStatus(e)
    if (status == 404) {
        return HttpResult(404, errorJson(errDeviceNotFound()))
    }
    return HttpResult(status, errorJson(e))
}

HttpResult handleListServices(Registry registry, String? authHeader) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    return HttpResult(200, serviceListJson(registry.servicesForAccount(account.id)))
}

HttpResult handleRemoveService(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var serviceId = mapField(body, "serviceId")
    if (registry.removeService(account.id, serviceId) == false) {
        return HttpResult(404, errorJson(errServiceNotFound()))
    }
    var out = mapOf()
    out.put("removed", "true")
    return HttpResult(200, json.encode(out))
}

// Suspensao operacional de servico: sai da rota (opaco), sem remover.
// Idempotente; inexistente/alheio = mesmo 404 opaco da remocao.
HttpResult handleSuspendService(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var serviceId = mapField(body, "serviceId")
    if (registry.suspendService(account.id, serviceId) == false) {
        return HttpResult(404, errorJson(errServiceNotFound()))
    }
    var suspended = mapOf()
    suspended.put("suspended", "true")
    return HttpResult(200, json.encode(suspended))
}

HttpResult handleUnsuspendService(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var serviceId = mapField(body, "serviceId")
    if (registry.unsuspendService(account.id, serviceId) == false) {
        return HttpResult(404, errorJson(errServiceNotFound()))
    }
    var active = mapOf()
    active.put("suspended", "false")
    return HttpResult(200, json.encode(active))
}

// Trilha de auditoria da conta: ultimos eventos dos proprios recursos.
// Sem auth alem da conta; sem dado de terceiros (filtro por accountId).
HttpResult handleListAudit(Registry registry, String? authHeader) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var parts = listOf<String>()
    for (var event in registry.auditForAccount(account.id)) {
        var entry = mapOf()
        entry.put("at", event.at)
        entry.put("actor", event.actor)
        entry.put("action", event.action)
        entry.put("target", event.target)
        entry.put("prevHash", event.prevHash)
        entry.put("hash", event.hash)
        parts.add(json.encode(entry))
    }
    return HttpResult(200, "[" + joinStrings(parts, ",") + "]")
}

// Verificacao da cadeia de auditoria da conta (Fase 19 s4). Devolve
// `{ok, brokenAt}` — `brokenAt` e o indice do primeiro evento adulterado
// ("" quando integra). Nao corrige nada: so reporta.
HttpResult handleVerifyAudit(Registry registry, String? authHeader) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var events = registry.auditForAccount(account.id)
    var broken = auditChainError(events)
    var out = mapOf()
    out.put("ok", boolToString(broken.length == 0))
    out.put("brokenAt", broken)
    out.put("events", intToString(events.size))
    return HttpResult(200, json.encode(out))
}

// Emite uma credencial de acesso para um servico AUTHENTICATED. O token da
// conta autoriza a EMISSAO; o token emitido (kfs_) e o que vai ao cliente.
// `ttlHours` opcional (> 0): expiracao em horas desde a emissao; ausente ou
// <= 0 = sem expiracao (comportamento antigo). TTL invalido (lixo) = 400.
HttpResult handleIssueServiceToken(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var serviceId = mapField(body, "serviceId")
    if (serviceId.length == 0) {
        return HttpResult(400, errorJson(errServiceIdRequired()))
    }
    var ttlRaw = mapField(body, "ttlHours")
    var ttlHours = 0
    if (ttlRaw.length > 0) {
        ttlHours = parseIntSafe(ttlRaw, -1)
        if (ttlHours <= 0) {
            return HttpResult(400, errorJson(errInvalidTtl()))
        }
    }
    try {
        var token = registry.issueServiceToken(account.id, serviceId, ttlHours)
        var out = mapOf()
        out.put("token", token)
        out.put("serviceId", serviceId)
        if (ttlHours > 0) {
            out.put("ttlHours", intToString(ttlHours))
        }
        return HttpResult(200, json.encode(out))
    } catch (String e) {
        // Opaco: conta nao dona recebe o mesmo 404 de servico inexistente.
        return HttpResult(404, errorJson(errServiceNotFound()))
    }
}

// Inventario das credenciais de UM servico (para `service token list`).
// Autenticado e filtrado por conta dona: inexistente e alheio respondem o
// mesmo 404 opaco (sem oraculo). Cada entrada traz digito curto + emissao;
// o valor kfs_ nunca viaja aqui (so existe na emissao).
HttpResult handleListServiceTokens(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var serviceId = mapField(body, "serviceId")
    if (serviceId.length == 0) {
        return HttpResult(400, errorJson(errServiceIdRequired()))
    }
    var service = registry.serviceById(serviceId)
    if (service == null) {
        return HttpResult(404, errorJson(errServiceNotFound()))
    }
    if (service.accountId != account.id) {
        return HttpResult(404, errorJson(errServiceNotFound()))
    }
    return HttpResult(200, serviceTokenListJson(registry.serviceTokensFor(account.id, serviceId)))
}

// Higiene de credenciais (Fase 19 s2): devolve os servicos da conta com
// credenciais validas SEM expiracao. So leitura; a acao e `service rotate`.
HttpResult handleTokenHygiene(Registry registry, String? authHeader) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var names = registry.servicesWithUnrotatedTokens(account.id)
    var parts = listOf<String>()
    for (var name in names) {
        parts.add(json.encode(name))
    }
    var out = mapOf()
    out.put("services", "[" + joinStrings(parts, ",") + "]")
    out.put("count", intToString(registry.tokensWithoutExpiry(account.id).size))
    return HttpResult(200, json.encode(out))
}

// Rotacao assistida (Fase 19 s3): emite uma credencial nova e revoga as
// anteriores SO quando ja passaram do TTL (overlap sem downtime). Com
// `prune` tambem limpa as expiradas. O token novo e devolvido uma unica vez.
HttpResult handleRotateServiceTokens(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var serviceId = mapField(body, "serviceId")
    if (serviceId.length == 0) {
        return HttpResult(400, errorJson(errServiceIdRequired()))
    }
    var service = registry.serviceById(serviceId)
    if (service == null) {
        return HttpResult(404, errorJson(errServiceNotFound()))
    }
    if (service.accountId != account.id) {
        return HttpResult(404, errorJson(errServiceNotFound()))
    }
    var ttlHours = parseIntSafe(mapField(body, "ttlHours"), 0)
    if (ttlHours < 0) {
        return HttpResult(400, errorJson(errInvalidTtl()))
    }
    var rotated = registry.rotateServiceTokens(account.id, serviceId, ttlHours)
    if (mapField(body, "prune") == "true") {
        registry.pruneExpiredServiceTokens(account.id, serviceId)
    }
    var out = mapOf()
    out.put("token", rotated.token)
    out.put("revoked", intToString(rotated.revoked))
    out.put("pending", intToString(registry.pendingRotationCount(serviceId)))
    return HttpResult(200, json.encode(out))
}

// Progresso da rotacao: quantas credenciais antigas ainda valem (== 1 e
// so a atual). Zero escrita.
HttpResult handleRotationStatus(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var serviceId = mapField(body, "serviceId")
    if (serviceId.length == 0) {
        return HttpResult(400, errorJson(errServiceIdRequired()))
    }
    var service = registry.serviceById(serviceId)
    if (service == null) {
        return HttpResult(404, errorJson(errServiceNotFound()))
    }
    if (service.accountId != account.id) {
        return HttpResult(404, errorJson(errServiceNotFound()))
    }
    var out = mapOf()
    out.put("serviceId", serviceId)
    out.put("pending", intToString(registry.pendingRotationCount(serviceId)))
    return HttpResult(200, json.encode(out))
}

// Webhook de incidentes (Fase 17 s3). `action`: set | show | remove | test.
// O segredo NUNCA sai na resposta; `show` devolve so a URL e um prefixo.
HttpResult handleWebhook(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var action = mapField(body, "action")
    if (action == "set") {
        try {
            registry.setWebhook(account.id, mapField(body, "url"), mapField(body, "secret"))
        } catch (String e) {
            return HttpResult(400, errorJson(errInvalidWebhook() + " (" + e + ")"))
        }
        return HttpResult(200, webhookJson(registry.webhookForAccount(account.id)))
    }
    if (action == "remove") {
        if (registry.removeWebhook(account.id) == false) {
            return HttpResult(404, errorJson(errWebhookNotFound()))
        }
        return HttpResult(200, "{\"removed\":true}")
    }
    if (action == "test") {
        var config = registry.webhookForAccount(account.id)
        if (config == null) {
            return HttpResult(404, errorJson(errWebhookNotFound()))
        }
        var status = registry.deliverWebhook(account.id, "webhook_test", "INFO", "webhook test delivery", time.now())
        var out = mapOf()
        out.put("delivered", intToString(status))
        return HttpResult(200, json.encode(out))
    }
    var config = registry.webhookForAccount(account.id)
    if (config == null) {
        return HttpResult(404, errorJson(errWebhookNotFound()))
    }
    return HttpResult(200, webhookJson(config))
}

String webhookJson(WebhookConfig? config) {
    if (config == null) {
        return "{}"
    }
    var out = mapOf()
    out.put("url", config.url)
    // So o prefixo: o segredo inteiro nunca sai pela API.
    out.put("secretHint", config.secret.substring(0, 4) + "…")
    out.put("createdAt", longToString(config.createdAt))
    return json.encode(out)
}

// Contencao (Fase 17 slice 2): freeze suspende o alvo, revoga as credenciais
// vivas e registra o incidente; unfreeze restaura exatamente o status
// anterior. Alvo: `service`, `device` (id) ou `account` (a propria conta do
// token; nao aceita id de terceiro). Alvo alheio -> 404 opaco.
HttpResult handleFreeze(Registry registry, String? authHeader, String bodyText, Bool freezing) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var targetKind = mapField(body, "target")
    var targetId = mapField(body, "id")
    if (targetKind != "service" && targetKind != "device" && targetKind != "account") {
        return HttpResult(400, errorJson(errInvalidTarget()))
    }
    // `account` e sempre o dono do token: o id nao escolhe a conta.
    if (targetKind != "account" && targetId.length == 0) {
        return HttpResult(400, errorJson(errTargetRequired()))
    }
    var out = mapOf()
    if (freezing) {
        var result = FreezeResult(false, "", 0, "")
        if (targetKind == "service") {
            result = registry.freezeService(account.id, targetId)
        } else if (targetKind == "device") {
            result = registry.freezeDevice(account.id, targetId)
        } else {
            result = registry.freezeAccount(account.id)
        }
        if (result.ok == false) {
            return HttpResult(404, errorJson(errTargetNotFound()))
        }
        out.put("frozen", intToString(1))
        out.put("revoked", intToString(result.revoked))
        out.put("incidentId", result.incidentId)
        return HttpResult(200, json.encode(out))
    }
    var restored = false
    if (targetKind == "service") {
        restored = registry.unfreezeService(account.id, targetId)
    } else if (targetKind == "device") {
        restored = registry.unfreezeDevice(account.id, targetId)
    } else {
        restored = registry.unfreezeAccount(account.id)
    }
    if (restored == false) {
        return HttpResult(404, errorJson(errTargetNotFound()))
    }
    out.put("frozen", intToString(0))
    out.put("restored", intToString(1))
    return HttpResult(200, json.encode(out))
}

// Incidentes (Fase 17 slice 1). Lista os da conta + os globais; `all=true`
// mostra so os globais (plataforma). Nunca inclui dado de outra conta.
// `resolveId` fecha um incidente (o da propria conta ou um global).
HttpResult handleIncidents(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var resolveId = mapField(body, "resolveId")
    if (resolveId.length > 0) {
        var target = ""
        for (var incident in registry.incidentsForAccount(account.id, true)) {
            if (incident.id == resolveId) {
                target = incident.id
            }
        }
        if (target.length == 0) {
            return HttpResult(404, errorJson(errIncidentNotFound()))
        }
        registry.resolveIncident(target)
    }
    var onlyGlobal = mapField(body, "all") == "true"
    var list = registry.incidentsForAccount(account.id, true)
    if (onlyGlobal) {
        var globals = listOf<Incident>()
        for (var incident in list) {
            if (incident.accountId.length == 0) {
                globals.add(incident)
            }
        }
        list = globals
    }
    var parts = listOf<String>()
    for (var incident in list) {
        parts.add(incidentJson(incident))
    }
    return HttpResult(200, "[" + joinStrings(parts, ",") + "]")
}

String incidentJson(Incident incident) {
    var out = mapOf()
    out.put("id", incident.id)
    out.put("kind", incident.kind)
    out.put("severity", incident.severity)
    out.put("accountId", incident.accountId)
    out.put("summary", incident.summary)
    out.put("openedAt", longToString(incident.openedAt))
    out.put("resolvedAt", longToString(incident.resolvedAt))
    return json.encode(out)
}

// ---- credenciais da conta (kfc_) ----
//
// O kfc_ autoriza tudo na conta; ate aqui nao havia como listar, revogar nem
// rotacionar. Estes handlers espelham os do kfs_ (mesmo vocabulario de
// resposta, mesmo 404 opaco, mesmo id curto), com uma diferenca de escopo:
// o alvo e sempre a conta do token — nao existe id de conta no corpo.

// Inventario: id curto do hash + emissao (+ expiracao quando houver).
// NUNCA o valor: o kfc_ em claro so existe no instante da emissao.
String accountTokenJson(TokenEntry entry) {
    var out = mapOf()
    out.put("id", shortTokenId(entry.tokenHash))
    out.put("createdAt", longToString(entry.createdAt))
    var expiresAt = entry.expiresAt
    if (expiresAt != null) {
        if (expiresAt > 0) {
            out.put("expiresAt", longToString(expiresAt))
        }
    }
    return json.encode(out)
}

String accountTokenListJson(List<TokenEntry> entries) {
    var parts = listOf<String>()
    for (var entry in entries) {
        parts.add(accountTokenJson(entry))
    }
    return "[" + joinStrings(parts, ",") + "]"
}

HttpResult handleListAccountTokens(Registry registry, String? authHeader) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    return HttpResult(200, accountTokenListJson(registry.accountTokensFor(account.id)))
}

// Revoga uma credencial da conta (ex.: vazou). Corpo: `{"token": "<kfc_|id>"}`.
// Id curto ambiguo -> 409 KCF063; inexistente -> 404 KCF064 opaco.
HttpResult handleRevokeAccountToken(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var token = mapField(body, "token")
    if (token.length == 0) {
        return HttpResult(400, errorJson(errServiceTokenRequired()))
    }
    var outcome = registry.revokeAccountTokenResult(account.id, token)
    if (outcome == "revoked") {
        var out = mapOf()
        out.put("revoked", "true")
        return HttpResult(200, json.encode(out))
    }
    if (outcome == "ambiguous") {
        return HttpResult(409, errorJson(errAmbiguousToken()))
    }
    return HttpResult(404, errorJson(errAccountTokenNotFound()))
}

// Rotacao com overlap: emite a nova (devolvida UMA vez) e so revoga as
// antigas que ja passaram do TTL. Sem `ttlHours` a nova nao expira e nada e
// revogado em silencio — o operador ve `pending`.
HttpResult handleRotateAccountTokens(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var ttlRaw = mapField(body, "ttlHours")
    var ttl = 0
    if (ttlRaw.length > 0) {
        ttl = parseIntSafe(ttlRaw, 0)
        if (ttl <= 0) {
            return HttpResult(400, errorJson(errInvalidTtl()))
        }
    }
    var result = registry.rotateAccountTokens(account.id, ttl)
    var out = mapOf()
    out.put("token", result.token)
    out.put("revoked", intToString(result.revoked))
    out.put("pending", intToString(result.pending))
    return HttpResult(200, json.encode(out))
}

HttpResult handleAccountRotationStatus(Registry registry, String? authHeader) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var out = mapOf()
    out.put("pending", intToString(registry.pendingAccountRotationCount(account.id)))
    return HttpResult(200, json.encode(out))
}

// Erro do revoke de token por outcome: "revoked" nao e erro (o handler
// responde 200 direto); "ambiguous" -> 409 KCF063 (pede o kfs_ completo);
// resto ("", nao encontrado/sem dono) -> 404 com corpo reescrito para KCF041
// opaco (nunca confirma nem nega a existencia de token alheio). Pura para
// a trava testar sem rede; o handler delega (fonte unica do mapeamento).
HttpResult revokeTokenError(String outcome) {
    if (outcome == "ambiguous") {
        return HttpResult(409, errorJson(errAmbiguousToken()))
    }
    return HttpResult(404, errorJson(errServiceNotFound()))
}

// Revoga UMA credencial de servico (ex.: vazou). O corpo leva o serviceId
// (dono) + o proprio token kfs_ a revogar OU o id curto do inventario
// (quando unico no servico). Inexistente, de outro servico ou de outra
// conta: mesmo 404 opaco — nunca confirma nem nega a existencia de um
// token alheio. Id curto ambiguo: 409 KCF063 (pede o kfs_ completo).
HttpResult handleRevokeServiceToken(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var serviceId = mapField(body, "serviceId")
    var token = mapField(body, "token")
    if (serviceId.length == 0 || token.length == 0) {
        return HttpResult(400, errorJson(errServiceTokenRequired()))
    }
    var outcome = registry.revokeServiceTokenResult(account.id, serviceId, token)
    if (outcome == "revoked") {
        var out = mapOf()
        out.put("revoked", "true")
        return HttpResult(200, json.encode(out))
    }
    return revokeTokenError(outcome)
}

HttpResult handleReportStatus(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var serviceId = mapField(body, "serviceId")
    var status = mapField(body, "status")
    // Owner-gate: so a conta dona altera o status. Inexistente e alheio
    // respondem o mesmo 404 opaco.
    var failure = registry.reportServiceStatus(account.id, serviceId, status)
    if (failure.length > 0) {
        return HttpResult(404, errorJson(errServiceNotFound()))
    }
    var out = mapOf()
    out.put("ok", "true")
    return HttpResult(200, json.encode(out))
}

HttpResult handleHeartbeat(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var deviceId = mapField(body, "deviceId")
    var device = registry.deviceById(deviceId)
    if (device == null) {
        return HttpResult(404, errorJson(errDeviceNotFound()))
    }
    if (device.accountId != account.id) {
        return HttpResult(404, errorJson(errDeviceNotFound()))
    }
    registry.touchDevice(deviceId)
    var out = mapOf()
    out.put("ok", "true")
    out.put("serverTime", longToString(time.now()))
    return HttpResult(200, json.encode(out))
}

HttpResult handleConnect(Registry registry, String? authHeader, String bodyText, String edgeHost, Int edgePort) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var deviceId = mapField(body, "deviceId")
    var device = registry.deviceById(deviceId)
    if (device == null) {
        return HttpResult(404, errorJson(errDeviceNotFound()))
    }
    if (device.accountId != account.id) {
        return HttpResult(404, errorJson(errDeviceNotFound()))
    }
    var out = mapOf()
    out.put("edgeHost", edgeHost)
    out.put("edgePort", intToString(edgePort))
    out.put("heartbeatMs", intToString(limitHeartbeatMs()))
    out.put("services", serviceListJson(registry.servicesForDevice(deviceId)))
    // Lista de Edges para o Agent ranquear por latencia (Fase 14 slice 2).
    // `kofcloud.edgeHosts` = "host:porta,host:porta"; vazia = so o Edge
    // principal (comportamento anterior, sem mudanca de contrato).
    out.put("edges", edgeListJson(edgeHost, edgePort))
    return HttpResult(200, json.encode(out))
}

// Lista de Edges como JSON de strings "host:porta" (o Agent mede e escolhe).
// O Edge principal vem primeiro e sempre presente; os extras vem da config.
String edgeListJson(String primaryHost, Int primaryPort) {
    var parts = listOf<String>()
    parts.add(json.encode(primaryHost + ":" + intToString(primaryPort)))
    var configured = config.str("kofcloud.edgeHosts", "")
    for (var item in configured.split(",")) {
        var entry = item.trim()
        if (entry.length == 0) {
            continue
        }
        if (entry.indexOf(":") <= 0) {
            continue
        }
        var encoded = json.encode(entry)
        if (parts.contains(encoded) == false) {
            parts.add(encoded)
        }
    }
    return "[" + joinStrings(parts, ",") + "]"
}

HttpResult handleListDomains(Registry registry, String? authHeader) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var parts = listOf<String>()
    var zone = mapOf()
    zone.put("hostname", accountZone(account.handle))
    zone.put("kind", "wildcard")
    zone.put("service", "")
    zone.put("status", "")
    parts.add(json.encode(zone))
    for (var service in registry.servicesForAccount(account.id)) {
        var entry = mapOf()
        entry.put("hostname", service.hostname)
        entry.put("kind", "service")
        entry.put("service", service.name)
        entry.put("status", "")
        parts.add(json.encode(entry))
    }
    for (var domain in registry.customDomainsForAccount(account.id)) {
        var custom = mapOf()
        custom.put("hostname", domain.hostname)
        custom.put("kind", "custom")
        // Nome do servico vinculado (o registro guarda serviceId; a CLI
        // mostra por nome). Orfao (servico removido fora da poda) vira ""
        // em vez de quebrar a lista — a poda normal remove junto.
        var linked = registry.serviceById(domain.serviceId)
        if (linked == null) {
            custom.put("service", "")
        } else {
            custom.put("service", linked.name)
        }
        custom.put("status", domain.status)
        parts.add(json.encode(custom))
    }
    return HttpResult(200, "[" + joinStrings(parts, ",") + "]")
}

// ---- dominio proprio (Fase 6) ----

// HTTP do erro de dominio por familia: formato -> 400, conflito -> 409,
// resto (inexistente/alheio) -> 404 opaco. Pura para a trava testar sem
// rede; o domainError delega (fonte unica do mapeamento).
Int domainHttpStatus(String e) {
    if (e.indexOf("KCF120") >= 0) {
        return 400
    }
    if (e.indexOf("KCF121") >= 0) {
        return 409
    }
    return 404
}

// Mapeia excecao do Registry para HTTP mantendo a opacidade (ver
// domainHttpStatus). No 404 o corpo e reescrito para KCF122: o registry
// lanca KCF041/KCF042 (servico ausente/alheio) como defesa em profundidade,
// e a borda nunca revela recurso de outra conta.
HttpResult domainError(String e) {
    var status = domainHttpStatus(e)
    if (status == 404) {
        return HttpResult(404, errorJson(errDomainNotFound()))
    }
    return HttpResult(status, errorJson(e))
}

HttpResult handleRegisterDomain(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var hostname = mapField(body, "hostname")
    var serviceName = mapField(body, "service")
    if (hostname.length == 0) {
        return HttpResult(400, errorJson(errInvalidCustomHostname()))
    }
    var service = registry.serviceByName(account.id, serviceName)
    if (service == null) {
        return HttpResult(404, errorJson(errDomainNotFound()))
    }
    try {
        var domain = registry.registerCustomDomain(account.id, hostname, service.id)
        var out = mapOf()
        out.put("hostname", domain.hostname)
        out.put("status", domain.status)
        out.put("instruction", domainInstruction(domain, registry))
        out.put("verifiedAt", domain.verifiedAt)
        return HttpResult(200, json.encode(out))
    } catch (String e) {
        return domainError(e)
    }
}

// HTTP do erro do verify por familia: inexistente/alheio (KCF122) -> 404
// opaco, resto (KCF124, DNS nao aponta) -> 409. Pura para a trava testar
// sem rede; o handler delega (fonte unica do mapeamento).
// No 404 o corpo e reescrito para KCF122 opaco: a borda nunca revela se o
// hostname existe em outra conta.
HttpResult verifyDomainError(String failure) {
    if (failure.indexOf("KCF122") >= 0) {
        return HttpResult(404, errorJson(errDomainNotFound()))
    }
    return HttpResult(409, errorJson(failure))
}

HttpResult handleVerifyDomain(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var hostname = mapField(body, "hostname")
    if (hostname.length == 0) {
        return HttpResult(400, errorJson(errInvalidCustomHostname()))
    }
    var failure = registry.verifyCustomDomain(account.id, hostname)
    if (failure.length > 0) {
        return verifyDomainError(failure)
    }
    var domain = registry.customByHostname(hostname)
    var out = mapOf()
    out.put("hostname", hostname.trim().toLowerCase())
    out.put("status", domainVerified())
    if (domain != null) {
        out.put("instruction", domainInstruction(domain, registry))
        out.put("verifiedAt", domain.verifiedAt)
    } else {
        out.put("instruction", "")
        out.put("verifiedAt", "")
    }
    return HttpResult(200, json.encode(out))
}

HttpResult handleRemoveDomain(Registry registry, String? authHeader, String bodyText) {
    var account = registry.accountByToken(bearerToken(authHeader))
    if (account == null) {
        return HttpResult(401, errorJson(errUnauthorized()))
    }
    var body = decodeBody(bodyText)
    var hostname = mapField(body, "hostname")
    if (registry.removeCustomDomain(account.id, hostname) == false) {
        return HttpResult(404, errorJson(errDomainNotFound()))
    }
    var out = mapOf()
    out.put("removed", "true")
    return HttpResult(200, json.encode(out))
}

// ---- servidor ----

class ControlPlane {
    Registry registry
    Int port
    Bool panelEnabled
    Bool statusPageEnabled
    String edgeHost
    Int edgePort
    String tlsCertPem
    String tlsKeyPem

    constructor(registry: Registry, port: Int, edgeHost: String, edgePort: Int) {
        this.registry = registry
        this.port = port
        this.panelEnabled = false
        this.statusPageEnabled = false
        this.edgeHost = edgeHost
        this.edgePort = edgePort
        this.tlsCertPem = ""
        this.tlsKeyPem = ""
    }

    // TLS do control plane (Fase 9 slice 1 parcial): PEMs lidos pelo
    // `serve --tls-cert/--tls-key`; vazio = HTTP (comportamento atual).
    // O Edge publico segue HTTP — L16 (handler String corrompe binario).
    void enableTls(String certPem, String keyPem) {
        this.tlsCertPem = certPem
        this.tlsKeyPem = keyPem
    }

    // Liga o painel somente-leitura (Fase 12 slice 1). Chamado pelo `serve`
    // quando `--panel` esta presente; sem a flag a rota nem existe.
    void enablePanel() {
        this.panelEnabled = true
    }

    // Liga a status page publica (Fase 17 slice 3): GET /status (HTML) e
    // GET /status.json — sem login, sem token, SEMPRE so incidentes globais
    // de plataforma. Sem a flag as rotas nao existem.
    void enableStatusPage() {
        this.statusPageEnabled = true
    }

    void start() {
        var reg = this.registry
        var self = this
        var app = web.app()

        if (this.panelEnabled) {
            app.get("/panel") {
                return panelHtml()
            }
        }

        if (this.statusPageEnabled) {
            app.get("/status.json") {
                return statusPageJson(reg.allIncidents())
            }
            app.get("/status") {
                return statusPageHtml(reg.allIncidents())
            }
        }

        app.get("/v1/health") {
            var result = handleHealth()
            return result.body
        }
        app.get("/v1/metrics") {
            var result = handleMetrics()
            return result.body
        }
        app.post("/v1/accounts") {
            var result = handleCreateAccount(reg, body())
            if (result.code == 200) {
                return result.body
            }
            return status(result.code, result.body)
        }
        app.post("/v1/login") {
            var result = handleLogin(reg, body())
            if (result.code == 200) {
                return result.body
            }
            return status(result.code, result.body)
        }
        app.post("/v1/devices") {
            var result = handleRegisterDevice(reg, header("x-kofcloud-token"), body())
            if (result.code == 200) {
                return result.body
            }
            return status(result.code, result.body)
        }
        app.get("/v1/devices") {
            var result = handleListDevices(reg, header("x-kofcloud-token"))
            if (result.code == 200) {
                return result.body
            }
            return status(result.code, result.body)
        }
        app.get("/v1/presence") {
            var result = handlePresence(reg, header("x-kofcloud-token"))
            if (result.code == 200) {
                return result.body
            }
            return status(result.code, result.body)
        }
        app.post("/v1/devices/revoke") {
            var result = handleRevokeDevice(reg, header("x-kofcloud-token"), body())
            if (result.code == 200) {
                return result.body
            }
            return status(result.code, result.body)
        }
        app.post("/v1/devices/suspend") {
            var result = handleSuspendDevice(reg, header("x-kofcloud-token"), body())
            if (result.code == 200) {
                return result.body
            }
            return status(result.code, result.body)
        }
        app.post("/v1/devices/unsuspend") {
            var result = handleUnsuspendDevice(reg, header("x-kofcloud-token"), body())
            if (result.code == 200) {
                return result.body
            }
            return status(result.code, result.body)
        }
        app.post("/v1/services") {
            var result = handlePublishService(reg, header("x-kofcloud-token"), body())
            if (result.code == 200) {
                return result.body
            }
            return status(result.code, result.body)
        }
        app.get("/v1/services") {
            var result = handleListServices(reg, header("x-kofcloud-token"))
            if (result.code == 200) {
                return result.body
            }
            return status(result.code, result.body)
        }
        app.post("/v1/services/remove") {
