package kofcloud.control

// Painel somente-leitura (Fase 12, slice 1).
//
// Uma pagina estatica servida pelo proprio control plane em `/panel`. Ela NAO
// tem endpoint privilegiado: depois de colar o `kfc_` da conta, o JavaScript
// da propria pagina chama a API publica `/v1` (mesma auth `X-KofCloud-Token`
// da CLI) e so renderiza. Nenhuma escrita, nenhum login novo.
//
// Regras do desenho:
//  * o HTML nunca contem token — o `kfc_` e digitado e vive so na memoria da
//    pagina (variavel local, nunca em localStorage/URL/log);
//  * o painel nunca mostra `kfs_` (a lista de credenciais nem traz valores);
//  * sem framework: HTML + fetch, servido como String pelo `web.app()`.

// Versao do painel (aparece no rodape; ajuda a saber o que esta no ar).
String panelVersion() {
    return "1"
}

// O HTML e uma constante: um unico lugar para revisar. Nenhum dado de conta
// entra aqui — tudo vem de fetch no navegador.
String panelHtml() {
    return "<!doctype html>
<html lang=\"pt-BR\"><head><meta charset=\"utf-8\">
<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">
<title>KofCloud — painel</title>
<style>
body{font:14px system-ui,sans-serif;margin:0;background:#0f1115;color:#e6e6e6}
header{padding:18px 24px;border-bottom:1px solid #2a2d35;display:flex;gap:12px;align-items:center}
header h1{font-size:16px;margin:0;font-weight:600}
header .tag{color:#8a8f98;font-size:12px}
main{padding:24px;display:grid;gap:24px;max-width:1100px}
section{background:#161920;border:1px solid #2a2d35;border-radius:10px;padding:16px}
section h2{font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:#8a8f98;margin:0 0 12px}
input,select{background:#0f1115;border:1px solid #2a2d35;color:#e6e6e6;border-radius:6px;padding:8px 10px}
button{background:#2f6feb;border:0;color:#fff;border-radius:6px;padding:6px 12px;cursor:pointer;margin:2px}
button.danger{background:#8b2323}
table{border-collapse:collapse;width:100%}
th,td{text-align:left;padding:6px 8px;border-bottom:1px solid #22252c;font-family:ui-monospace,monospace;font-size:13px}
.on{color:#3fb950}.off{color:#8a8f98}.pend{color:#d29922}.err{color:#f85149}
.muted{color:#8a8f98}.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:10px}
.secret{word-break:break-all;background:#0f1115;padding:8px;border-radius:6px;margin-top:8px}
footer{padding:16px 24px;color:#5b606a;font-size:12px}
</style></head><body>
<header><h1>KofCloud</h1><span class=\"tag\">painel</span></header>
<main>
<section>
  <h2>Conta</h2>
  <input id=\"tok\" type=\"password\" placeholder=\"cole aqui o token da conta\" autocomplete=\"off\">
  <button onclick=\"carregar()\">Carregar</button>
  <span id=\"msg\" class=\"muted\"></span>
  <p class=\"muted\">O token (o mesmo do <code>kof cloud login</code>) fica so na memoria desta aba. Nada e gravado.</p>
</section>
<section><h2>Dispositivos</h2><div id=\"devs\"></div>
  <p class=\"muted\">Revogar e permanente — suspender e reversivel.</p>
  <div class=\"row\"><input id=\"devname\" placeholder=\"nome do dispositivo\">
  <button onclick=\"acao('device-suspend')\">Suspender</button>
  <button onclick=\"acao('device-unsuspend')\">Reativar</button>
  <button class=\"danger\" onclick=\"acao('device-revoke')\">Revogar</button></div></section>
<section><h2>Servicos</h2><div id=\"svcs\"></div>
  <div class=\"row\"><input id=\"svcname\" placeholder=\"nome\"><input id=\"svcport\" placeholder=\"porta\" size=\"6\">
  <select id=\"svcdev\"><option value=\"\">dispositivo…</option></select>
  <select id=\"svcexp\"><option>PUBLIC</option><option>AUTHENTICATED</option><option>PRIVATE</option></select>
  <button onclick=\"acao('publish')\">Publicar</button>
  <button class=\"danger\" onclick=\"acao('unpublish')\">Remover</button></div>
  <div class=\"row\"><input id=\"svctarget\" placeholder=\"nome\">
  <button onclick=\"acao('service-suspend')\">Suspender</button>
  <button onclick=\"acao('service-unsuspend')\">Reativar</button>
  <button onclick=\"acao('token')\">Emitir kfs_</button>
  <button class=\"danger\" onclick=\"acao('token-revoke-all')\">Revogar credenciais</button></div>
  <div id=\"secret\"></div></section>
<section><h2>Dominios</h2><div id=\"doms\"></div>
  <div class=\"row\"><input id=\"domhost\" placeholder=\"api.exemplo.com\"><input id=\"domsvc\" placeholder=\"servico\">
  <button onclick=\"acao('domain-add')\">Adicionar</button>
  <button onclick=\"acao('domain-verify')\">Verificar DNS</button>
  <button class=\"danger\" onclick=\"acao('domain-remove')\">Remover</button></div></section>
</main>
<footer>KofCloud painel v" + panelVersion() + " — usa /v1/devices, /v1/presence, /v1/services, /v1/domains, /v1/services/token, /v1/domains/{add,verify,remove}, /v1/devices/{revoke,suspend,unsuspend}, /v1/services/{suspend,unsuspend}</footer>
<script>
var TOKEN = '';  // so na memoria da aba; nunca persistido
var STATE = {svcs: [], devs: []};
function esc(s){ return String(s == null ? '' : s).replace(/[&<>\"']/g, function(c){
  return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]; }); }
function api(path, metodo, corpo){
  var opt = {method: metodo || 'GET', headers: {'X-KofCloud-Token': TOKEN}};
  if(corpo){ opt.headers['Content-Type'] = 'application/json'; opt.body = JSON.stringify(corpo); }
  return fetch(path, opt).then(function(r){
    return r.json().catch(function(){ return {}; }).then(function(j){
      if(!r.ok) throw new Error((j.error || ('HTTP ' + r.status)));
      return j;
    });
  });
}
function tabela(cabecalho, linhas){
  var h = '<table><tr>' + cabecalho.map(function(c){return '<th>'+esc(c)+'</th>';}).join('') + '</tr>';
  linhas.forEach(function(l){
    h += '<tr>' + l.map(function(c){return '<td>'+c+'</td>';}).join('') + '</tr>';
  });
  return h + '</table>';
}
function idPorNome(lista, nome){
  for(var i=0;i<lista.length;i++){ if(lista[i].name === nome) return lista[i].id || lista[i].deviceId; }
  return '';
}
function ok(m){ var el=document.getElementById('msg'); el.className='on'; el.textContent=m; }
function erro(m){ var el=document.getElementById('msg'); el.className='err'; el.textContent=m; }
function preencherDevices(devs){
  var sel = document.getElementById('svcdev');
  if(!sel) return;
  // Opcoes via DOM (value/textContent), nunca concatenando HTML: o nome do
  // dispositivo e dado do usuario e nao deve virar markup.
  var atual = sel.value;
  while(sel.firstChild){ sel.removeChild(sel.firstChild); }
  var vazio = document.createElement('option');
  vazio.value = '';
  vazio.textContent = 'dispositivo…';
  sel.appendChild(vazio);
  devs.forEach(function(d){
    var o = document.createElement('option');
    o.value = d.id || d.deviceId || '';
    o.textContent = d.name;
    sel.appendChild(o);
  });
  // Mantem a escolha se o device continua existindo; senao volta ao vazio
  // (nunca seleciona o primeiro por conta propria).
  var mantem = false;
  devs.forEach(function(d){ if((d.id || d.deviceId || '') === atual) mantem = true; });
  if(mantem) sel.value = atual;
}
function carregar(){
  TOKEN = document.getElementById('tok').value.trim();
  if(!TOKEN){ erro('informe o token'); return; }
  document.getElementById('msg').className='muted';
  document.getElementById('msg').textContent='carregando...';
  Promise.all([api('/v1/devices'), api('/v1/presence'), api('/v1/services'), api('/v1/domains')])
    .then(function(r){
      var devs = r[0], online = r[1], svcs = r[2], doms = r[3];
      STATE.devs = devs;
    preencherDevices(devs); STATE.svcs = svcs;
      preencherDevices(devs);
      document.getElementById('devs').innerHTML = tabela(['nome','id','status','tunel'], devs.map(function(d){
        var vivo = online.indexOf(d.id || d.deviceId) >= 0;
        return [esc(d.name), esc(d.id || d.deviceId), esc(d.status),
                vivo ? '<span class=\"on\">ONLINE</span>' : '<span class=\"off\">OFFLINE</span>'];
      }));
      document.getElementById('svcs').innerHTML = tabela(['nome','hostname','exposicao','status'], svcs.map(function(s){
        var st = s.status === 'ONLINE' ? '<span class=\"on\">' : (s.status === 'OFFLINE' ? '<span class=\"off\">' : '<span class=\"pend\">');
        return [esc(s.name), 'https://'+esc(s.hostname), esc(s.exposure), st + esc(s.status) + '</span>'];
      }));
      document.getElementById('doms').innerHTML = tabela(['hostname','tipo','servico','status'], doms.map(function(d){
        var st = d.status === 'ACTIVE' ? '<span class=\"on\">' : '<span class=\"pend\">';
        return [esc(d.hostname), esc(d.kind), esc(d.service), st + esc(d.status || '-') + '</span>'];
      }));
      document.getElementById('msg').textContent = '';
    })
    .catch(function(e){ TOKEN=''; erro('falha: ' + e.message); });
}
function acao(tipo){
  var p;
  if(tipo === 'publish'){
    var nome=document.getElementById('svcname').value.trim();
    var porta=document.getElementById('svcport').value.trim();
    if(!nome || !porta){ erro('informe nome e porta'); return; }
    // O dispositivo e ESCOLHIDO, nunca inferido do primeiro da lista: com
    // mais de uma maquina na conta, publicar sempre na primeira expunha o
    // servico na maquina errada (e o operador so descobria depois).
    var dev = document.getElementById('svcdev').value;
    if(!dev){ erro('escolha o dispositivo'); return; }
    p = api('/v1/services','POST',{deviceId: dev, name: nome, localPort: porta, localAddress: '127.0.0.1',
        protocol: 'http', exposure: document.getElementById('svcexp').value});
  } else if(tipo === 'unpublish'){
    var alvo=document.getElementById('svcname').value.trim();
    if(!alvo){ erro('informe o nome do servico'); return; }
    if(!confirm('Remover o servico \"' + alvo + '\"? A rota publica cai na hora.')) return;
    p = api('/v1/services/remove','POST',{serviceId: idPorNome(STATE.svcs, alvo)});
  } else if(tipo === 'service-suspend' || tipo === 'service-unsuspend'){
    var n=document.getElementById('svctarget').value.trim();
    var rota = tipo === 'service-suspend' ? '/v1/services/suspend' : '/v1/services/unsuspend';
    p = api(rota,'POST',{serviceId: idPorNome(STATE.svcs, n)});
  } else if(tipo === 'token'){
    var n2=document.getElementById('svctarget').value.trim();
    p = api('/v1/services/token','POST',{serviceId: idPorNome(STATE.svcs, n2)}).then(function(j){
      var el=document.getElementById('secret');
      el.innerHTML = '<p class=\"muted\">Credencial emitida — aparece UMA vez; copie agora:</p>' +
                     '<div class=\"secret\">' + esc(j.token) + '</div>';
      return {ok: 'credencial emitida'};
    });
  } else if(tipo === 'token-revoke-all'){
    var n3=document.getElementById('svctarget').value.trim();
    if(!confirm('Revogar TODAS as credenciais de \"' + n3 + '\"?')) return;
    p = api('/v1/services/tokens','POST',{serviceId: idPorNome(STATE.svcs, n3)}).then(function(j){
      var chain = Promise.resolve({ok: 'credenciais revogadas'});
      for(var i=0;i<(j.length||0);i++){
        (function(id){ chain = chain.then(function(){ return api('/v1/services/token/revoke','POST',{serviceId: idPorNome(STATE.svcs, n3), token: id}); }); })(j[i].id);
      }
      return chain;
    });
  } else if(tipo === 'device-suspend' || tipo === 'device-unsuspend' || tipo === 'device-revoke'){
    var dn=document.getElementById('devname').value.trim();
    var devId = idPorNome(STATE.devs, dn);
    if(tipo === 'device-revoke' && !confirm('Revogar \"' + dn + '\"? Permanente — o dispositivo precisa ser registrado de novo.')) return;
    var rotaD = tipo === 'device-revoke' ? '/v1/devices/revoke' : (tipo === 'device-suspend' ? '/v1/devices/suspend' : '/v1/devices/unsuspend');
    p = api(rotaD,'POST',{deviceId: devId});
  } else if(tipo === 'domain-add'){
    var h=document.getElementById('domhost').value.trim();
    var s=document.getElementById('domsvc').value.trim();
    // A API le `service` (NOME do servico), nao `serviceId`: mandar o id
    // devolvia 404 KCF122 e o botao nunca funcionava.
    p = api('/v1/domains','POST',{hostname: h, service: s});
  } else if(tipo === 'domain-verify'){
    p = api('/v1/domains/verify','POST',{hostname: document.getElementById('domhost').value.trim()});
  } else if(tipo === 'domain-remove'){
    var h2=document.getElementById('domhost').value.trim();
    if(!confirm('Remover o dominio \"' + h2 + '\"?')) return;
    p = api('/v1/domains/remove','POST',{hostname: h2});
  } else { return; }
  p.then(function(j){ ok(j.ok || 'feito'); carregarListas(); })
   .catch(function(e){ erro('falha: ' + e.message); });
}
function carregarListas(){
  Promise.all([api('/v1/services'), api('/v1/domains'), api('/v1/devices'), api('/v1/presence')]).then(function(r){
    var svcs=r[0], doms=r[1], devs=r[2], online=r[3];
    STATE.svcs = svcs;
    STATE.devs = devs;
    document.getElementById('devs').innerHTML = tabela(['nome','id','status','tunel'], devs.map(function(d){
      var vivo = online.indexOf(d.id || d.deviceId) >= 0;
      return [esc(d.name), esc(d.id || d.deviceId), esc(d.status),
              vivo ? '<span class=\"on\">ONLINE</span>' : '<span class=\"off\">OFFLINE</span>'];
    }));
    document.getElementById('svcs').innerHTML = tabela(['nome','hostname','exposicao','status'], svcs.map(function(s){
      var st = s.status === 'ONLINE' ? '<span class=\"on\">' : (s.status === 'OFFLINE' ? '<span class=\"off\">' : '<span class=\"pend\">');
      return [esc(s.name), 'https://'+esc(s.hostname), esc(s.exposure), st + esc(s.status) + '</span>'];
    }));
    document.getElementById('doms').innerHTML = tabela(['hostname','tipo','servico','status'], doms.map(function(d){
      var st = d.status === 'ACTIVE' ? '<span class=\"on\">' : '<span class=\"pend\">';
      return [esc(d.hostname), esc(d.kind), esc(d.service), st + esc(d.status || '-') + '</span>'];
    }));
  });
}
</script>
</body></html>"
}

// Handlers estaticos do painel: pagina + 404 para chamadas de API vindas da
// pagina (a pagina so chama /v1, entao isto e so preguica de rota).
String panelContentType() {
    return "text/html; charset=utf-8"
}
