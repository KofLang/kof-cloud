package kofcloud.control

// Painel somente-leitura (Fase 12, slice 1).
//
// Uma pagina estatica servida pelo proprio control plane em `/panel`. Ela NAO
// tem endpoint privilegiado: depois de colar o `kfc_` da conta, o JavaScript
// da propria pagina chama a API publica `/v1` (mesma auth `X-KofCloud-Token`
// da CLI) e so renderiza. Nenhuma escrita, nenhum login novo.
//
// Regras do desenho:
//  * o HTML nunca contem token — o `kfc_` e digitado e vive so na memoria da
//    pagina (variavel local, nunca em localStorage/URL/log);
//  * o painel nunca mostra `kfs_` (a lista de credenciais nem traz valores);
//  * sem framework: HTML + fetch, servido como String pelo `web.app()`.

// Versao do painel (aparece no rodape; ajuda a saber o que esta no ar).
String panelVersion() {
    return "11"
}

// As rotas /v1 que a pagina chama — UMA fonte so, para o rodape anunciar
// exatamente o que a pagina usa. O rodape escrito a mao ja estava em drift
// nos dois sentidos: 5 rotas reais nao constavam (services/remove,
// services/token/revoke, services/tokens, services/token-hygiene e o
// /v1/tokens da camada de credencial do diagnostico) e ele citava um
// fantasma /v1/domains/add (adicionar dominio e POST /v1/domains). A trava
// no teste percorre TODAS as ocorrencias de /v1 no HTML servido e exige cada
// uma nesta lista — e o contrario: cada entrada da lista tem de aparecer no
// HTML. Rota nova no painel sem entrar aqui quebra o teste.
String panelRoutes() {
    return "/v1/accounts, /v1/devices, /v1/devices/revoke, /v1/devices/suspend, /v1/devices/unsuspend, /v1/presence, /v1/services, /v1/services/remove, /v1/services/suspend, /v1/services/unsuspend, /v1/services/token, /v1/services/token/revoke, /v1/services/tokens, /v1/services/token-hygiene, /v1/domains, /v1/domains/verify, /v1/domains/remove, /v1/audit/verify, /v1/tokens, /v1/tokens/revoke, /v1/webhook, /v1/freeze, /v1/unfreeze"
}

// O HTML e uma constante: um unico lugar para revisar. Nenhum dado de conta
// entra aqui — tudo vem de fetch no navegador.
String panelHtml() {
    return "<!doctype html>
<html lang=\"pt-BR\"><head><meta charset=\"utf-8\">
<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">
<title>KofCloud — painel</title>
<style>
body{font:14px system-ui,sans-serif;margin:0;background:#0f1115;color:#e6e6e6}
header{padding:18px 24px;border-bottom:1px solid #2a2d35;display:flex;gap:12px;align-items:center}
header h1{font-size:16px;margin:0;font-weight:600}
header .tag{color:#8a8f98;font-size:12px}
main{padding:24px;display:grid;gap:24px;max-width:1100px}
section{background:#161920;border:1px solid #2a2d35;border-radius:10px;padding:16px}
section h2{font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:#8a8f98;margin:0 0 12px}
input,select{background:#0f1115;border:1px solid #2a2d35;color:#e6e6e6;border-radius:6px;padding:8px 10px}
button{background:#2f6feb;border:0;color:#fff;border-radius:6px;padding:6px 12px;cursor:pointer;margin:2px}
button.danger{background:#8b2323}
table{border-collapse:collapse;width:100%}
th,td{text-align:left;padding:6px 8px;border-bottom:1px solid #22252c;font-family:ui-monospace,monospace;font-size:13px}
.on{color:#3fb950}.off{color:#8a8f98}.pend{color:#d29922}.err{color:#f85149}
.muted{color:#8a8f98}.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:10px}
.passo{background:#161920;border:1px solid #2f6feb;border-radius:10px;padding:12px 16px}
.secret{word-break:break-all;background:#0f1115;padding:8px;border-radius:6px;margin-top:8px}
footer{padding:16px 24px;color:#5b606a;font-size:12px}
</style></head><body>
<header><h1>KofCloud</h1><span class=\"tag\">painel</span></header>
<main>
<div id=\"onboarding\"></div>
<section><h2>Comecar</h2>
  <div class=\"row\"><button onclick=\"iniciarFluxo()\">Iniciar o fluxo guiado</button><span class=\"muted\">3 telas: conta, maquina, primeiro servico</span></div>
  <div id=\"fluxo\"></div></section>
<section>
  <h2>Conta</h2>
  <input id=\"tok\" type=\"password\" placeholder=\"cole aqui o token da conta\" autocomplete=\"off\">
  <button onclick=\"carregar()\">Carregar</button>
  <button onclick=\"sair()\">Sair</button>
  <span id=\"msg\" class=\"muted\"></span>
  <p class=\"muted\">O token (o mesmo do <code>kof cloud login</code>) fica so na memoria desta aba. Nada e gravado.</p>
  <div class=\"row\"><input id=\"newhandle\" placeholder=\"novo usuario\"><input id=\"newemail\" placeholder=\"email\">
  <input id=\"newpass\" type=\"password\" placeholder=\"senha (4+ letras)\" autocomplete=\"new-password\">
  <button onclick=\"acao('signup')\">Criar conta</button></div>
  <div id=\"novaconta\"></div>
</section>
<section><h2>Dispositivos</h2><div id=\"devs\"></div>
  <p class=\"muted\">Revogar e permanente — suspender e reversivel.</p>
  <div class=\"row\"><input id=\"devnew\" placeholder=\"nome do novo dispositivo\">
  <button onclick=\"acao('device-add')\">Registrar</button></div>
  <p class=\"muted\">Registrar aqui reserva o nome: a maquina assume o dispositivo com <code>kof cloud login --device &lt;nome&gt;</code> — a chave verdadeira nasce na maquina, nunca na pagina.</p>
  <div class=\"row\"><input id=\"devname\" placeholder=\"nome do dispositivo\">
  <button onclick=\"acao('device-suspend')\">Suspender</button>
  <button onclick=\"acao('device-unsuspend')\">Reativar</button>
  <button class=\"danger\" onclick=\"acao('device-revoke')\">Revogar</button></div></section>
<section><h2>Servicos</h2><div id=\"svcs\"></div>
  <div class=\"row\"><input id=\"svcname\" placeholder=\"nome\"><input id=\"svcport\" placeholder=\"porta\" size=\"6\">
  <select id=\"svcdev\"><option value=\"\">dispositivo…</option></select>
  <select id=\"svcexp\"><option>PUBLIC</option><option>AUTHENTICATED</option><option>PRIVATE</option></select>
  <button onclick=\"acao('publish')\">Publicar</button>
  <button class=\"danger\" onclick=\"acao('unpublish')\">Remover</button></div>
  <div class=\"row\"><input id=\"svctarget\" placeholder=\"nome\">
  <button onclick=\"acao('service-suspend')\">Suspender</button>
  <button onclick=\"acao('service-unsuspend')\">Reativar</button>
  <button onclick=\"acao('token')\">Emitir kfs_</button>
  <button class=\"danger\" onclick=\"acao('token-revoke-all')\">Revogar credenciais</button></div>
  <div id=\"secret\"></div></section>
<section><h2>Dominios</h2><div id=\"doms\"></div>
  <div class=\"row\"><input id=\"domhost\" placeholder=\"api.exemplo.com\"><input id=\"domsvc\" placeholder=\"servico\">
  <button onclick=\"acao('domain-add')\">Adicionar</button>
  <button onclick=\"acao('domain-verify')\">Verificar DNS</button>
  <button class=\"danger\" onclick=\"acao('domain-remove')\">Remover</button></div></section>
<section><h2>Webhook</h2>
  <div id=\"wb\"></div>
  <div class=\"row\"><input id=\"wburl\" placeholder=\"https:// receptor do incidente\"><input id=\"wbsecret\" type=\"password\" placeholder=\"segredo (16+ caracteres)\" autocomplete=\"new-password\">
  <button onclick=\"webhookAcao('set')\">Configurar</button>
  <button onclick=\"webhookAcao('test')\">Testar entrega</button>
  <button class=\"danger\" onclick=\"webhookAcao('remove')\">Remover</button></div>
  <p class=\"muted\">Aviso de incidente da conta por POST assinado (<code>X-KofCloud-Signature: sha256=&lt;hex&gt;</code> do corpo com o segredo). O segredo fica so no servidor e nunca volta inteiro — a pagina mostra so o prefixo.</p></section>
<section><h2>Contencao</h2>
  <div class=\"row\"><select id=\"frztarget\"><option value=\"\">alvo…</option></select>
  <button class=\"danger\" onclick=\"acao('freeze')\">Congelar (contencao)</button>
  <button onclick=\"acao('unfreeze')\">Descongelar</button></div>
  <p class=\"muted\">Congelar suspende o alvo, REVOGA as credenciais vivas e abre incidente — reversivel pelo Descongelar, que restaura o status anterior (configuracao nunca e tocada). Servico e dispositivo aceitam nome; escolher \"conta\" congela a conta inteira (devices + servicos + kfs_). As credenciais revogadas nao voltam: emita novas com <code>service rotate</code>.</p>
  <div id=\"frz\"></div></section>
<section><h2>Diagnostico</h2>
  <div class=\"row\"><button onclick=\"diagnostico()\">Rodar</button><span class=\"muted\">mesmas camadas do <code>doctor</code> que a pagina enxerga pela API: credencial da conta, dispositivo, tunel, auditoria, higiene de kfs_</span></div>
  <p class=\"muted\">O que depende da sua maquina (portas locais, DNS da sua rede) segue no <code>kof cloud doctor</code>.</p>
  <div id=\"diag\"></div></section>
</main>
<footer>KofCloud painel v" + panelVersion() + " — usa " + panelRoutes() + "</footer>
<script>
var TOKEN = '';  // so na memoria da aba; nunca persistido
var STATE = {svcs: [], devs: [], pronto: false};
function esc(s){ return String(s == null ? '' : s).replace(/[&<>\"']/g, function(c){
  return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]; }); }
function api(path, metodo, corpo){
  var opt = {method: metodo || 'GET', headers: {'X-KofCloud-Token': TOKEN}};
  if(corpo){ opt.headers['Content-Type'] = 'application/json'; opt.body = JSON.stringify(corpo); }
  return fetch(path, opt).then(function(r){
    return r.json().catch(function(){ return {}; }).then(function(j){
      if(!r.ok) throw new Error((j.error || ('HTTP ' + r.status)));
      return j;
    });
  });
}
function tabela(cabecalho, linhas){
  var h = '<table><tr>' + cabecalho.map(function(c){return '<th>'+esc(c)+'</th>';}).join('') + '</tr>';
  linhas.forEach(function(l){
    h += '<tr>' + l.map(function(c){return '<td>'+c+'</td>';}).join('') + '</tr>';
  });
  return h + '</table>';
}
function parseIntSafeText(v){ var n = parseInt(v, 10); return isNaN(n) ? 0 : n; }
function idPorNome(lista, nome){
  for(var i=0;i<lista.length;i++){ if(lista[i].name === nome) return lista[i].id || lista[i].deviceId; }
  return '';
}
// Recusa local quando o nome digitado nao esta na lista que a pagina ja
// carregou: sem isto o botao mandava id vazio e o operador recebia um 404/500
// opaco sem saber qual campo estava errado.
function alvoAusente(label, acao){
  erro('alvo de ' + acao + ' nao encontrado: informe o ' + label + ' exato (veja a lista acima)');
  return true;
}
function ok(m){ var el=document.getElementById('msg'); el.className='on'; el.textContent=m; }
function erro(m){ var el=document.getElementById('msg'); el.className='err'; el.textContent=m; }
// Select da Contencao: servicos e dispositivos por NOME (as rotas /v1/freeze
// e /v1/unfreeze aceitam nome via resolucao do Registry? NAO — elas leem
// `id`; entao o value da opcao e o ID resolvido das listas que a pagina ja
// buscou, e o rotulo diz o tipo). Opcao extra de conta inteira (sem id: o
// alvo e sempre o dono do token). Via DOM, mesmo padrao do preencherDevices.
function preencherFreeze(devs, svcs){
  var sel = document.getElementById('frztarget');
  if(!sel) return;
  var atual = sel.value;
  while(sel.firstChild){ sel.removeChild(sel.firstChild); }
  var vazio = document.createElement('option');
  vazio.value = '';
  vazio.textContent = 'alvo…';
  sel.appendChild(vazio);
  svcs.forEach(function(svc){
    var o = document.createElement('option');
    o.value = 'service/' + (svc.id || '');
    o.textContent = 'servico: ' + svc.name;
    sel.appendChild(o);
  });
  devs.forEach(function(d){
    var o = document.createElement('option');
    o.value = 'device/' + (d.id || d.deviceId || '');
    o.textContent = 'device: ' + d.name;
    sel.appendChild(o);
  });
  var conta = document.createElement('option');
  conta.value = 'account/';
  conta.textContent = 'conta inteira';
  sel.appendChild(conta);
  var mantem = false;
  svcs.forEach(function(svc){ if('service/' + (svc.id || '') === atual) mantem = true; });
  devs.forEach(function(d){ if('device/' + (d.id || d.deviceId || '') === atual) mantem = true; });
  if(atual === 'account/') mantem = true;
  if(mantem) sel.value = atual;
}

function preencherDevices(devs){
  var sel = document.getElementById('svcdev');
  if(!sel) return;
  // Opcoes via DOM (value/textContent), nunca concatenando HTML: o nome do
  // dispositivo e dado do usuario e nao deve virar markup.
  var atual = sel.value;
  while(sel.firstChild){ sel.removeChild(sel.firstChild); }
  var vazio = document.createElement('option');
  vazio.value = '';
  vazio.textContent = 'dispositivo…';
  sel.appendChild(vazio);
  devs.forEach(function(d){
    var o = document.createElement('option');
    o.value = d.id || d.deviceId || '';
    o.textContent = d.name;
    sel.appendChild(o);
  });
  // Mantem a escolha se o device continua existindo; senao volta ao vazio
  // (nunca seleciona o primeiro por conta propria).
  var mantem = false;
  devs.forEach(function(d){ if((d.id || d.deviceId || '') === atual) mantem = true; });
  if(mantem) sel.value = atual;
}
function carregar(){
  TOKEN = document.getElementById('tok').value.trim();
  if(!TOKEN){ erro('informe o token'); return; }
  document.getElementById('msg').className='muted';
  document.getElementById('msg').textContent='carregando...';
  Promise.all([api('/v1/devices'), api('/v1/presence'), api('/v1/services'), api('/v1/domains')])
    .then(function(r){
      var devs = r[0], online = r[1], svcs = r[2], doms = r[3];
      STATE.devs = devs;
      STATE.svcs = svcs;
      STATE.pronto = true;
      preencherDevices(devs);
      preencherFreeze(devs, svcs);
      renderListas(devs, online, svcs, doms);
      document.getElementById('msg').textContent = '';
      onboarding(devs, svcs, online);
      fluxoPasso();
      webhookCarregar();
    })
    .catch(function(e){ TOKEN=''; erro('falha: ' + e.message); });
}
// Sair encerra a sessao da aba no SERVIDOR antes de limpar a memoria —
// a mesma regra do logout da CLI: um token colado que so saia da tela
// seguiria valido para sempre. Sucesso e token ja morto limpam a pagina;
// qualquer outra falha (control fora do ar) avisa e NAO limpa: limpar
// faria o operador achar que revogou quando nao revogou.
function sair(){
  if(!TOKEN) return;
  api('/v1/tokens/revoke','POST',{token: TOKEN}).then(function(){
    limparAba();
    ok('sessao encerrada — token revogado no servidor');
  }).catch(function(e){
    if(String(e.message || '').indexOf('KCF004') >= 0){
      limparAba();
      ok('sessao encerrada — o token ja nao era valido');
    } else {
      erro('falha ao revogar (o token segue valido) — use: kof cloud token revoke');
    }
  });
}
function limparAba(){
  TOKEN = '';
  document.getElementById('tok').value = '';
  STATE.svcs = [];
  STATE.devs = [];
  STATE.pronto = false;
  document.getElementById('devs').innerHTML = '';
  document.getElementById('svcs').innerHTML = '';
  document.getElementById('doms').innerHTML = '';
  preencherDevices([]);
  preencherFreeze([], []);
  document.getElementById('onboarding').innerHTML = '';
  document.getElementById('fluxo').innerHTML = '';
  document.getElementById('diag').innerHTML = '';
  document.getElementById('secret').innerHTML = '';
  document.getElementById('novaconta').innerHTML = '';
}
// As tres tabelas sao renderizadas por UM unico lugar. O carregamento
// inicial e o recarregar-apos-acao produziam o MESMO HTML por codigo
// duplicado — e ja divergiram uma vez (o vocabulario do dominio precisou
// ser corrigido nas DUAS copias, e o select era reconstruido duas vezes
// pelo mesmo motivo). Quem atualiza STATE, o select e o banner segue
// sendo cada chamada; so o HTML das tabelas tem fonte unica.
function renderListas(devs, online, svcs, doms){
  document.getElementById('devs').innerHTML = tabela(['nome','id','status','tunel'], devs.map(function(d){
    var vivo = online.indexOf(d.id || d.deviceId) >= 0;
    return [esc(d.name), esc(d.id || d.deviceId), esc(d.status),
            vivo ? '<span class=\"on\">ONLINE</span>' : '<span class=\"off\">OFFLINE</span>'];
  }));
  document.getElementById('svcs').innerHTML = tabela(['nome','hostname','exposicao','status'], svcs.map(function(s){
    var st = s.status === 'ONLINE' ? '<span class=\"on\">' : (s.status === 'OFFLINE' ? '<span class=\"off\">' : '<span class=\"pend\">');
    return [esc(s.name), 'https://'+esc(s.hostname), esc(s.exposure), st + esc(s.status) + '</span>'];
  }));
  document.getElementById('doms').innerHTML = tabela(['hostname','tipo','servico','status'], doms.map(function(d){
    // PENDING/VERIFIED da API, nunca o vocabulario antigo; sem status
    // (wildcard/servico) vira '-' sem cor.
    var st = d.status === 'VERIFIED' ? '<span class=\"on\">' : (d.status ? '<span class=\"pend\">' : '');
    return [esc(d.hostname), esc(d.kind), esc(d.service), d.status ? st + esc(d.status) + '</span>' : '<span class=\"muted\">-</span>'];
  }));
}
// Onboarding guiado (Fase 12 s3, segundo passo): o proximo passo da conta,
// derivado do que a pagina JA buscou — sem consulta nova e sem inventar
// estado. Sem dispositivo = passo 1; com dispositivo e NENHUM no ar (mesmo
// com servico publicado, a rota nao responde) = a maquina desconectada,
// aponta o connect; com dispositivo no ar e sem servico = passo 2; com
// servico e tunel vivo, a conta esta no ar e o banner some. As acoes citadas
// sao as que a propria pagina oferece (e o login da maquina, que nela fica).
function onboarding(devs, svcs, online){
  var el = document.getElementById('onboarding');
  if(!devs || devs.length == 0){
    el.innerHTML = '<div class=\"passo\"><b>Primeiro passo</b> — registre o dispositivo: botao <b>Registrar</b> na secao Dispositivos abaixo (ou <code>kof cloud login --device &lt;nome&gt;</code> na maquina).</div>';
  } else {
    var noAr = false;
    devs.forEach(function(d){ if(online && online.indexOf(d.id || d.deviceId) >= 0) noAr = true; });
    if(!noAr){
      el.innerHTML = '<div class=\"passo\"><b>Maquina desconectada</b> — o tunel nao esta no ar: rode <code>kof cloud connect</code> na maquina (ou adote o dispositivo com <code>kof cloud login --device &lt;nome&gt;</code> se ainda nao adotou).</div>';
    } else if(!svcs || svcs.length == 0){
      el.innerHTML = '<div class=\"passo\"><b>Quase la</b> — publique o primeiro servico na secao Servicos abaixo (nome, porta e o dispositivo): a rota publica aparece na tabela e responde quando o <code>kof cloud connect</code> estiver rodando na maquina.</div>';
    } else {
      el.innerHTML = '';
    }
  }
}
// Fluxo guiado (Fase 12 s3, terceiro passo): as 3 telas prometidas — conta,
// maquina, primeiro servico — costuradas num modo passo a passo opt-in. A
// tela atual e DERIVADA do estado real que a pagina ja tem (token validado
// pelo Carregar, devices e servicos buscados) — sem estado inventado e sem
// endpoint novo; cada tela reusa as secoes e funcoes que ja existem. O que
// o navegador nao pode fazer fica honesto no texto: o cliente (kof)
// instala-se e adota-se na maquina, nunca na pagina.
var FLUXO = false;
function iniciarFluxo(){
  FLUXO = true;
  fluxoPasso();
}
function encerrarFluxo(){
  FLUXO = false;
  document.getElementById('fluxo').innerHTML = '';
}
function fluxoPasso(){
  var el = document.getElementById('fluxo');
  if(!FLUXO){ el.innerHTML = ''; return; }
  if(!STATE.pronto){
    el.innerHTML = '<div class=\"passo\"><b>Tela 1 de 3 — Conta</b>: crie a conta no formulario abaixo (ou cole o token do <code>kof cloud login</code>) e clique <b>Carregar</b> — o fluxo acompanha sozinho.</div>';
  } else if(!STATE.devs || STATE.devs.length == 0){
    el.innerHTML = '<div class=\"passo\"><b>Tela 2 de 3 — Maquina</b>: registre o dispositivo com o botao <b>Registrar</b> (secao Dispositivos) e adote o nome na maquina — <code>kof cloud login --device &lt;nome&gt;</code> com o <code>kof cloud connect</code> rodando. O painel nao instala nada: o cliente e o proprio kof. <button onclick=\"carregarListas()\">Verificar</button> <button onclick=\"diagnostico()\">diagnostico</button></div>';
  } else if(!STATE.svcs || STATE.svcs.length == 0){
    el.innerHTML = '<div class=\"passo\"><b>Tela 3 de 3 — Primeiro servico</b>: publique na secao Servicos — nome, porta local e o dispositivo — com o servico rodando na maquina; a rota publica aparece na tabela e o diagnostico confirma o tunel. <button onclick=\"carregarListas()\">Verificar</button> <button onclick=\"diagnostico()\">diagnostico</button></div>';
  } else {
    el.innerHTML = '<div class=\"passo\"><b>Fluxo concluido</b> — conta no ar, rotas nas tabelas acima. <button onclick=\"encerrarFluxo()\">encerrar o fluxo</button></div>';
  }
}
function acao(tipo){
  var p;
  if(tipo === 'signup'){
    var nh=document.getElementById('newhandle').value.trim();
    var ne=document.getElementById('newemail').value.trim();
    var np=document.getElementById('newpass').value;
    if(!nh || !np){ erro('informe usuario e senha'); return; }
    // Conta nova: a rota devolve o token da conta — mesma regra da
    // credencial de servico: o token aparece UMA vez (para colar no campo
    // acima) e nunca e gravado na pagina (so vive na memoria da aba).
    p = api('/v1/accounts','POST',{handle: nh, email: ne, password: np}).then(function(j){
      var el=document.getElementById('novaconta');
      el.innerHTML = '<p class=\"muted\">Conta criada — o token aparece UMA vez; cole no campo acima:</p>' +
                     '<div class=\"secret\">' + esc(j.token) + '</div>';
      return {ok: 'conta criada'};
    });
  } else if(tipo === 'publish'){
    var nome=document.getElementById('svcname').value.trim();
    var porta=document.getElementById('svcport').value.trim();
    if(!nome || !porta){ erro('informe nome e porta'); return; }
    // O dispositivo e ESCOLHIDO, nunca inferido do primeiro da lista: com
    // mais de uma maquina na conta, publicar sempre na primeira expunha o
    // servico na maquina errada (e o operador so descobria depois).
    var dev = document.getElementById('svcdev').value;
    if(!dev){ erro('escolha o dispositivo'); return; }
    p = api('/v1/services','POST',{deviceId: dev, name: nome, localPort: porta, localAddress: '127.0.0.1',
        protocol: 'http', exposure: document.getElementById('svcexp').value});
  } else if(tipo === 'unpublish'){
    var alvo=document.getElementById('svcname').value.trim();
    if(!alvo){ erro('informe o nome do servico'); return; }
    var remSvc = idPorNome(STATE.svcs, alvo);
    if(!remSvc){ if(alvoAusente('nome do servico', 'remover')) return; }
    if(!confirm('Remover o servico \"' + alvo + '\"? A rota publica cai na hora.')) return;
    p = api('/v1/services/remove','POST',{serviceId: remSvc});
  } else if(tipo === 'service-suspend' || tipo === 'service-unsuspend'){
    var n=document.getElementById('svctarget').value.trim();
    var svcId = idPorNome(STATE.svcs, n);
    if(!svcId){ if(alvoAusente('nome do servico', tipo === 'service-suspend' ? 'suspender' : 'reativar')) return; }
    var rota = tipo === 'service-suspend' ? '/v1/services/suspend' : '/v1/services/unsuspend';
    p = api(rota,'POST',{serviceId: svcId});
  } else if(tipo === 'token'){
    var n2=document.getElementById('svctarget').value.trim();
    var tokSvc = idPorNome(STATE.svcs, n2);
    if(!tokSvc){ if(alvoAusente('nome do servico', 'emitir credencial')) return; }
    p = api('/v1/services/token','POST',{serviceId: tokSvc}).then(function(j){
      var el=document.getElementById('secret');
      el.innerHTML = '<p class=\"muted\">Credencial emitida — aparece UMA vez; copie agora:</p>' +
                     '<div class=\"secret\">' + esc(j.token) + '</div>';
      return {ok: 'credencial emitida'};
    });
  } else if(tipo === 'token-revoke-all'){
    var n3=document.getElementById('svctarget').value.trim();
    var revSvc = idPorNome(STATE.svcs, n3);
    if(!revSvc){ if(alvoAusente('nome do servico', 'revogar credenciais')) return; }
    if(!confirm('Revogar TODAS as credenciais de \"' + n3 + '\"?')) return;
    p = api('/v1/services/tokens','POST',{serviceId: idPorNome(STATE.svcs, n3)}).then(function(j){
      var chain = Promise.resolve({ok: 'credenciais revogadas'});
      for(var i=0;i<(j.length||0);i++){
        (function(id){ chain = chain.then(function(){ return api('/v1/services/token/revoke','POST',{serviceId: idPorNome(STATE.svcs, n3), token: id}); }); })(j[i].id);
      }
      return chain;
    });
  } else if(tipo === 'device-add'){
    var nn=document.getElementById('devnew').value.trim();
    if(!nn){ erro('informe o nome do dispositivo'); return; }
    // Registrar aqui reserva o NOME: a maquina assume esse mesmo dispositivo
    // com `login --device <nn>` (dedup por nome devolve o mesmo id, entao o
    // publish feito pelo painel ja espera a maquina certa). A chave
    // verdadeira nasce e vive na maquina — o fio exige uma no corpo, entao
    // vai o marcador abaixo; ele nunca e verificado no handshake e nem
    // painel nem CLI o exibem.
    p = api('/v1/devices','POST',{name: nn, publicKey: 'aguardando-maquina'});
  } else if(tipo === 'device-suspend' || tipo === 'device-unsuspend' || tipo === 'device-revoke'){
    var dn=document.getElementById('devname').value.trim();
    var devId = idPorNome(STATE.devs, dn);
    if(!devId){ if(alvoAusente('nome do dispositivo', tipo === 'device-revoke' ? 'revogar' : (tipo === 'device-suspend' ? 'suspender' : 'reativar'))) return; }
    if(tipo === 'device-revoke' && !confirm('Revogar \"' + dn + '\"? Permanente — o dispositivo precisa ser registrado de novo.')) return;
    var rotaD = tipo === 'device-revoke' ? '/v1/devices/revoke' : (tipo === 'device-suspend' ? '/v1/devices/suspend' : '/v1/devices/unsuspend');
    p = api(rotaD,'POST',{deviceId: devId});
  } else if(tipo === 'freeze' || tipo === 'unfreeze'){
    var alvoF = document.getElementById('frztarget').value;
    if(!alvoF){ erro('escolha o alvo da contencao'); return; }
    var barra = alvoF.indexOf('/');
    var tipoAlvo = alvoF.substring(0, barra);
    var idAlvo = alvoF.substring(barra + 1);
    if(tipo === 'freeze' && !confirm('Congelar ' + tipoAlvo + '? Suspende o alvo, REVOGA as credenciais vivas e abre incidente (reversivel pelo Descongelar).')) return;
    if(tipo === 'unfreeze' && tipoAlvo === 'account' && !confirm('Descongelar a conta inteira? Restaura devices e servicos ao status anterior.')) return;
    var corpo = {target: tipoAlvo};
    if(tipoAlvo !== 'account'){ corpo.id = idAlvo; }
    p = api(tipo === 'freeze' ? '/v1/freeze' : '/v1/unfreeze','POST',corpo);
  } else if(tipo === 'domain-add'){
    var h=document.getElementById('domhost').value.trim();
    var s=document.getElementById('domsvc').value.trim();
    // A API le `service` (NOME do servico), nao `serviceId`: mandar o id
    // devolvia 404 KCF122 e o botao nunca funcionava.
    p = api('/v1/domains','POST',{hostname: h, service: s});
  } else if(tipo === 'domain-verify'){
    p = api('/v1/domains/verify','POST',{hostname: document.getElementById('domhost').value.trim()});
  } else if(tipo === 'domain-remove'){
    var h2=document.getElementById('domhost').value.trim();
    if(!confirm('Remover o dominio \"' + h2 + '\"?')) return;
    p = api('/v1/domains/remove','POST',{hostname: h2});
  } else { return; }
  p.then(function(j){ ok(j.ok || 'feito'); carregarListas(); })
   .catch(function(e){ erro('falha: ' + e.message); });
}
// Webhook de incidentes (F12 s2): a mesma rota publica que o CLI (`POST
// /v1/webhook` com `action`), o mesmo vocabulario do `webhook show` (so a
// URL e o prefixo do segredo — `secretHint`, o valor nunca volta pela API)
// e as mesmas regras do painel (sem token embutido, nada gravado: o segredo
// digitado viaja no POST e e limpo do campo apos configurar). Carrega
// separado do Carregar: conta sem webhook recebe 404 na rota (por desenho),
// entao falha vira o placeholder de sem-webhook na secao — nunca erro que
// impediria as
// listas (a rota existe no control plane atual). Remover pede confirmacao
// (perde o aviso de incidente da conta); configurar e testar nao.
function webhookMostrar(w){
  var alvo = document.getElementById('wb');
  if(!w || !w.url){ alvo.innerHTML = '<p class=\"muted\">sem webhook configurado — incidentes da conta nao sao notificados.</p>'; return; }
  alvo.innerHTML = '<p class=\"on\">webhook: ' + esc(w.url) + ' — segredo ' + esc(w.secretHint || '(prefixo)') + '</p>';
}
function webhookCarregar(){
  return api('/v1/webhook','POST',{action: 'show'})
    .then(function(j){ webhookMostrar(j); })
    .catch(function(){ webhookMostrar(null); });
}
function webhookAcao(acao){
  if(acao === 'remove' && !confirm('Remover o webhook? Os incidentes da conta deixam de ser notificados.')) return;
  var corpo = {action: acao};
  if(acao === 'set'){
    corpo.url = document.getElementById('wburl').value.trim();
    corpo.secret = document.getElementById('wbsecret').value;
    if(!corpo.url || !corpo.secret){ erro('webhook: informe a URL e o segredo (16+ caracteres)'); return; }
    if(corpo.secret.length < 16){ erro('webhook: segredo curto demais (minimo 16 caracteres)'); return; }
  }
  api('/v1/webhook','POST',corpo).then(function(j){
    document.getElementById('wbsecret').value = '';
    if(acao === 'set'){ webhookMostrar(j); ok('Webhook configurado.'); }
    else if(acao === 'remove'){ webhookMostrar(null); ok('Webhook removido.'); }
    else { ok(j.delivered === '200' ? 'Entrega de teste OK.' : 'Entrega de teste falhou (o incidente fica registrado de qualquer forma).'); }
  }).catch(function(e){ erro('webhook: ' + e.message); });
}
function carregarListas(){
  Promise.all([api('/v1/services'), api('/v1/domains'), api('/v1/devices'), api('/v1/presence')]).then(function(r){
    var svcs=r[0], doms=r[1], devs=r[2], online=r[3];
    STATE.svcs = svcs;
    STATE.devs = devs;
    renderListas(devs, online, svcs, doms);
    onboarding(STATE.devs, STATE.svcs, online);
    fluxoPasso();
  });
}
// Diagnostico da conta (primeiro passo do onboarding, Fase 12 s3): as
// camadas do doctor que a pagina enxerga pela API publica — credencial da
// conta, ciclo de vida do dispositivo, tunel confirmado pelo Edge e cadeia
// de auditoria — com o mesmo vocabulario ok/FALHA do CLI. Busca sozinha (nao
// depende de Carregar) e nao inventa camada de maquina local: isso segue no
// kof cloud doctor. A credencial julga o MESMO sinal do fio que o doctor e o
// token list (campo aditivo expiring do /v1/tokens; inventario sem valores,
// so contagem) — FALHA com o rotate, igual ao doctor.
function diagnostico(){
  Promise.all([api('/v1/devices'), api('/v1/presence'), api('/v1/audit/verify'), api('/v1/tokens'), api('/v1/services/token-hygiene','POST',{})]).then(function(r){
    var devs=r[0], online=r[1], aud=r[2], toks=r[3], hig=r[4];
    var higCount = parseIntSafeText(hig.count);
    STATE.devs = devs;
    var linhas = [];
    var expirando = 0;
    toks.forEach(function(t){ if(t.expiring === 'true'){ expirando = expirando + 1; } });
    if(expirando > 0){ linhas.push(['FALHA', 'credencial da conta: ' + expirando + ' expira(m) dentro da janela — rode: kof cloud token rotate --ttl <horas>']); }
    else { linhas.push(['ok', 'credencial da conta (sem expiracao proxima)']); }
    devs.forEach(function(d){
      var st = d.status || '';
      if(st === 'REVOKED'){ linhas.push(['FALHA', 'dispositivo ' + d.name + ': revogado — registre de novo: kof cloud login --device ' + d.name]); }
      else if(st === 'SUSPENDED'){ linhas.push(['FALHA', 'dispositivo ' + d.name + ': suspenso — libere com: kof cloud device unsuspend ' + d.name]); }
      else { linhas.push(['ok', 'dispositivo ' + d.name + ' registrado (' + st + ')']); }
    });
    if(devs.length == 0){ linhas.push(['FALHA', 'nenhum dispositivo — registre acima ou com: kof cloud login --device <nome>']); }
    devs.forEach(function(d){
      if(online.indexOf(d.id || d.deviceId) >= 0){ linhas.push(['ok', 'tunel ativo no Edge (' + d.name + ')']); }
      else { linhas.push(['FALHA', 'tunel de ' + d.name + ': sem sessao no Edge — rode: kof cloud connect']); }
    });
    if(aud.ok === 'true'){
      if(aud.mirrorOk === 'false'){ linhas.push(['FALHA', 'auditoria: espelho comprometido (quebra em ' + aud.mirrorBrokenAt + ') — investigue: kof cloud audit --verify']); }
      else { linhas.push(['ok', 'auditoria integra (' + aud.events + ' eventos na cadeia)']); }
    } else {
      linhas.push(['FALHA', 'auditoria: cadeia quebrada no evento ' + aud.brokenAt + ' de ' + aud.events + ' — investigue: kof cloud audit --verify']);
    }
    // Higiene de kfs_ (Fase 19 s2): credenciais validas SEM expiracao.
    // So leitura; a acao recomendada e a rotacao com TTL. Sem isso o painel
    // nao enxerga o unico tipo de credencial sem prazo — o mesmo sinal que
    // o `service tokens` da CLI acusa.
    if(higCount > 0){ linhas.push(['FALHA', 'higiene: ' + higCount + ' credencial(is) de servico SEM expiracao — rode: kof cloud service rotate <nome> --ttl <horas>']); }
    else { linhas.push(['ok', 'higiene de kfs_ (nenhuma credencial valida sem expiracao)']); }
    STATE.svcs.forEach(function(s){
      if(s.status === 'SUSPENDED'){ linhas.push(['FALHA', 'servico ' + s.name + ' suspenso — libere com: kof cloud service unsuspend ' + s.name]); }
    });
    document.getElementById('diag').innerHTML = linhas.map(function(l){
      return '<p class=\"' + (l[0] === 'ok' ? 'on' : 'err') + '\">' + l[0] + ' — ' + esc(l[1]) + '</p>';
    }).join('');
  }).catch(function(e){ erro('falha no diagnostico: ' + e.message); });
}
</script>
</body></html>"
}

// Handlers estaticos do painel: pagina + 404 para chamadas de API vindas da
// pagina (a pagina so chama /v1, entao isto e so preguica de rota).
String panelContentType() {
    return "text/html; charset=utf-8"
}

// Nome/indicador que a acao do painel vai alcançar, ou "" quando o alvo nao
// existe nas listas que a pagina ja carregou. Puro (mesma forma de
// `idPorNome`, mas sem DOM): o e2e da trava `panel-gate` usa esta funcao
// para cobrir as duas pontas — o HTML consulta antes de chamar a API e o
// teste prova que a mesma lista devolve o mesmo veredito.
String panelTargetName(List<String> names, String wanted) {
    var alvo = wanted.trim()
    if (alvo.length == 0) {
        return ""
    }
    for (var name in names) {
        if (name == alvo) {
            return name
        }
    }
    return ""
}

// Mensagem de recusa quando o alvo do painel nao existe. Nomeia o campo e a
// lista onde o operador confere — sem isso o JS mandava `id:''` e o
// control plane respondia 404/500 com corpo opaco, que o painel mostrava
// como um erro cru (o operador nao sabia qual campo estava errado).
String panelTargetRefusal(String label, String acao) {
    return "alvo de " + acao + " nao encontrado: informe o " + label + " exato (veja a lista acima)"
}
